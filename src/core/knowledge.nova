// Nova Core: Knowledge Graph
// Entities with embedding vectors and weighted relations.
// Supports nearest-neighbor search, path finding, and relation queries.

let KG_TAG = 270
let KG_ENTITIES = 1
let KG_RELATIONS = 2
let KG_COUNT = 3

let KG_ENT_NAME = 0
let KG_ENT_EMBED = 1
let KG_ENT_ATTRS = 2

let KG_REL_SUBJ = 0
let KG_REL_TYPE = 1
let KG_REL_OBJ = 2
let KG_REL_WEIGHT = 3

fn kg_new() {
    let g = list_new()
    push(g, KG_TAG)
    push(g, list_new())
    push(g, list_new())
    push(g, 0)
    return g
}

fn _kg_find_entity(kg, name) {
    let ents = kg[KG_ENTITIES]
    let i = 0
    while i < len(ents) {
        if ents[i][KG_ENT_NAME] == name { return i }
        i = i + 1
    }
    return -1
}

fn kg_add_entity(kg, name, embedding) {
    let idx = _kg_find_entity(kg, name)
    if idx != -1 {
        kg[KG_ENTITIES][idx][KG_ENT_EMBED] = embedding
        return idx
    }
    let ent = list_new()
    push(ent, name)
    push(ent, embedding)
    push(ent, map_new())
    push(kg[KG_ENTITIES], ent)
    kg[KG_COUNT] = kg[KG_COUNT] + 1
    return len(kg[KG_ENTITIES]) - 1
}

fn kg_get_entity(kg, name) {
    let idx = _kg_find_entity(kg, name)
    if idx == -1 { return 0 }
    return kg[KG_ENTITIES][idx]
}

fn kg_get_embedding(kg, name) {
    let ent = kg_get_entity(kg, name)
    if ent == 0 { return 0 }
    return ent[KG_ENT_EMBED]
}

fn kg_set_attr(kg, name, key, value) {
    let ent = kg_get_entity(kg, name)
    if ent == 0 { return 0 }
    map_set(ent[KG_ENT_ATTRS], key, value)
    return 1
}

fn kg_get_attr(kg, name, key) {
    let ent = kg_get_entity(kg, name)
    if ent == 0 { return 0 }
    if map_has(ent[KG_ENT_ATTRS], key) == 0 { return 0 }
    return map_get(ent[KG_ENT_ATTRS], key)
}

fn kg_entity_count(kg) {
    return kg[KG_COUNT]
}

fn kg_add_relation(kg, subj, rel, obj, weight) {
    let r = list_new()
    push(r, subj)
    push(r, rel)
    push(r, obj)
    push(r, weight)
    push(kg[KG_RELATIONS], r)
}

fn kg_get_relations(kg, name) {
    let result = list_new()
    let rels = kg[KG_RELATIONS]
    let i = 0
    while i < len(rels) {
        if rels[i][KG_REL_SUBJ] == name {
            push(result, rels[i])
        }
        i = i + 1
    }
    return result
}

fn kg_get_reverse(kg, name) {
    let result = list_new()
    let rels = kg[KG_RELATIONS]
    let i = 0
    while i < len(rels) {
        if rels[i][KG_REL_OBJ] == name {
            push(result, rels[i])
        }
        i = i + 1
    }
    return result
}

fn kg_has_relation(kg, subj, rel, obj) {
    let rels = kg[KG_RELATIONS]
    let i = 0
    while i < len(rels) {
        let r = rels[i]
        if r[KG_REL_SUBJ] == subj {
            if r[KG_REL_TYPE] == rel {
                if r[KG_REL_OBJ] == obj {
                    return 1
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn kg_query(kg, subj, rel) {
    let result = list_new()
    let rels = kg[KG_RELATIONS]
    let i = 0
    while i < len(rels) {
        let r = rels[i]
        if r[KG_REL_SUBJ] == subj {
            if r[KG_REL_TYPE] == rel {
                push(result, r[KG_REL_OBJ])
            }
        }
        i = i + 1
    }
    return result
}

fn kg_query_weighted(kg, subj, rel) {
    let result = list_new()
    let rels = kg[KG_RELATIONS]
    let i = 0
    while i < len(rels) {
        let r = rels[i]
        if r[KG_REL_SUBJ] == subj {
            if r[KG_REL_TYPE] == rel {
                let pair = list_new()
                push(pair, r[KG_REL_OBJ])
                push(pair, r[KG_REL_WEIGHT])
                push(result, pair)
            }
        }
        i = i + 1
    }
    return result
}

fn kg_remove_relation(kg, subj, rel, obj) {
    let rels = kg[KG_RELATIONS]
    let i = 0
    while i < len(rels) {
        let r = rels[i]
        if r[KG_REL_SUBJ] == subj {
            if r[KG_REL_TYPE] == rel {
                if r[KG_REL_OBJ] == obj {
                    let last = len(rels) - 1
                    rels[i] = rels[last]
                    pop(rels)
                    return 1
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn kg_nearest(kg, query_embed, k) {
    let ents = kg[KG_ENTITIES]
    let scores = list_new()
    let i = 0
    while i < len(ents) {
        let ent = ents[i]
        if ent[KG_ENT_EMBED] != 0 {
            let sim = embed_cosine(query_embed, ent[KG_ENT_EMBED])
            let entry = list_new()
            push(entry, ent[KG_ENT_NAME])
            push(entry, sim)
            push(scores, entry)
        }
        i = i + 1
    }
    let si = 0
    while si < len(scores) {
        let sj = si + 1
        while sj < len(scores) {
            if scores[sj][1] > scores[si][1] {
                let tmp = scores[si]
                scores[si] = scores[sj]
                scores[sj] = tmp
            }
            sj = sj + 1
        }
        si = si + 1
    }
    let result = list_new()
    let ri = 0
    while ri < k {
        if ri < len(scores) {
            push(result, scores[ri])
        }
        ri = ri + 1
    }
    return result
}

fn kg_similarity(kg, name1, name2) {
    let e1 = kg_get_embedding(kg, name1)
    let e2 = kg_get_embedding(kg, name2)
    if e1 == 0 { return 0 }
    if e2 == 0 { return 0 }
    return embed_cosine(e1, e2)
}

fn kg_neighbors(kg, name) {
    let result = list_new()
    let rels = kg[KG_RELATIONS]
    let i = 0
    while i < len(rels) {
        let r = rels[i]
        if r[KG_REL_SUBJ] == name {
            let found = 0
            let j = 0
            while j < len(result) {
                if result[j] == r[KG_REL_OBJ] { found = 1 }
                j = j + 1
            }
            if found == 0 { push(result, r[KG_REL_OBJ]) }
        }
        if r[KG_REL_OBJ] == name {
            let found = 0
            let j = 0
            while j < len(result) {
                if result[j] == r[KG_REL_SUBJ] { found = 1 }
                j = j + 1
            }
            if found == 0 { push(result, r[KG_REL_SUBJ]) }
        }
        i = i + 1
    }
    return result
}

fn kg_path(kg, from, to) {
    let queue = list_new()
    let visited = list_new()
    let parents = list_new()
    let start = list_new()
    push(start, from)
    push(start, -1)
    push(queue, start)
    push(visited, from)

    let found = 0
    let found_idx = -1
    let qi = 0
    while qi < len(queue) {
        let current = queue[qi][0]
        if current == to {
            found = 1
            found_idx = qi
            qi = len(queue)
        } else {
            let nbrs = kg_neighbors(kg, current)
            let ni = 0
            while ni < len(nbrs) {
                let nbr = nbrs[ni]
                let seen = 0
                let vi = 0
                while vi < len(visited) {
                    if visited[vi] == nbr { seen = 1 }
                    vi = vi + 1
                }
                if seen == 0 {
                    push(visited, nbr)
                    let entry = list_new()
                    push(entry, nbr)
                    push(entry, qi)
                    push(queue, entry)
                }
                ni = ni + 1
            }
            qi = qi + 1
        }
    }

    if found == 0 { return list_new() }

    let path = list_new()
    let ci = found_idx
    while ci != -1 {
        push(path, queue[ci][0])
        ci = queue[ci][1]
    }

    let reversed = list_new()
    let pi = len(path) - 1
    while pi >= 0 {
        push(reversed, path[pi])
        pi = pi - 1
    }
    return reversed
}

fn kg_relation_count(kg) {
    return len(kg[KG_RELATIONS])
}

fn kg_save(kg, d) {
    let ents = kg[KG_ENTITIES]
    db_put_int(d, "_kg_ent_count", len(ents))
    let i = 0
    while i < len(ents) {
        let ent = ents[i]
        let prefix = "_kg_ent_" + int_to_str(i)
        db_put(d, prefix + "_name", ent[KG_ENT_NAME])
        if ent[KG_ENT_EMBED] != 0 {
            db_put(d, prefix + "_embed", embed_serialize(ent[KG_ENT_EMBED]))
        }
        i = i + 1
    }
    let rels = kg[KG_RELATIONS]
    db_put_int(d, "_kg_rel_count", len(rels))
    let ri = 0
    while ri < len(rels) {
        let r = rels[ri]
        let rp = "_kg_rel_" + int_to_str(ri)
        db_put(d, rp + "_s", r[KG_REL_SUBJ])
        db_put(d, rp + "_t", r[KG_REL_TYPE])
        db_put(d, rp + "_o", r[KG_REL_OBJ])
        db_put_int(d, rp + "_w", r[KG_REL_WEIGHT])
        ri = ri + 1
    }
}

fn kg_load(kg, d) {
    let ec = db_get_int(d, "_kg_ent_count")
    let i = 0
    while i < ec {
        let prefix = "_kg_ent_" + int_to_str(i)
        let name = db_get(d, prefix + "_name")
        let embed_str = db_get(d, prefix + "_embed")
        let embedding = 0
        if embed_str != 0 {
            embedding = embed_deserialize(embed_str)
        }
        kg_add_entity(kg, name, embedding)
        i = i + 1
    }
    let rc = db_get_int(d, "_kg_rel_count")
    let ri = 0
    while ri < rc {
        let rp = "_kg_rel_" + int_to_str(ri)
        let subj = db_get(d, rp + "_s")
        let rel_type = db_get(d, rp + "_t")
        let obj = db_get(d, rp + "_o")
        let weight = db_get_int(d, rp + "_w")
        kg_add_relation(kg, subj, rel_type, obj, weight)
        ri = ri + 1
    }
}

fn kg_describe(kg) {
    print("KnowledgeGraph(entities=")
    print_int(kg_entity_count(kg))
    print(", relations=")
    print_int(kg_relation_count(kg))
    println(")")
}

// KG Registry - manages multiple knowledge graphs by domain
let _kg_registry_domains = 0
let _kg_registry_kgs = 0
let _kg_registry_count = 0

fn kg_registry_init() {
    _kg_registry_domains = list_new()
    _kg_registry_kgs = list_new()
    _kg_registry_count = 0
}

fn _kg_registry_find(domain_name) {
    let i = 0
    while i < _kg_registry_count {
        if _kg_registry_domains[i] == domain_name { return i }
        i = i + 1
    }
    return -1
}

fn kg_spawn(domain_name) {
    let existing = _kg_registry_find(domain_name)
    if existing != -1 { return _kg_registry_kgs[existing] }
    let kg = kg_new()
    push(_kg_registry_domains, domain_name)
    push(_kg_registry_kgs, kg)
    _kg_registry_count = _kg_registry_count + 1
    return kg
}

fn kg_get_domain(domain_name) {
    let idx = _kg_registry_find(domain_name)
    if idx == -1 { return 0 }
    return _kg_registry_kgs[idx]
}

fn kg_list_domains() {
    let result = list_new()
    let i = 0
    while i < _kg_registry_count {
        push(result, _kg_registry_domains[i])
        i = i + 1
    }
    return result
}

fn kg_domain_count() {
    return _kg_registry_count
}

fn kg_remove_domain(domain_name) {
    let idx = _kg_registry_find(domain_name)
    if idx == -1 { return 0 }
    list_remove(_kg_registry_domains, idx)
    list_remove(_kg_registry_kgs, idx)
    _kg_registry_count = _kg_registry_count - 1
    return 1
}

fn kg_cross_ref(source_kg, source_entity, target_domain, target_entity) {
    let obj = target_domain + ":" + target_entity
    kg_add_relation(source_kg, source_entity, "xref", obj, 1)
}

fn kg_resolve_ref(ref_string) {
    let slen = len(ref_string)
    let colon_pos = -1
    let i = 0
    while i < slen {
        if substr(ref_string, i, 1) == ":" {
            colon_pos = i
            i = slen
        }
        i = i + 1
    }
    let result = list_new()
    if colon_pos == -1 {
        push(result, ref_string)
        push(result, "")
        return result
    }
    push(result, substr(ref_string, 0, colon_pos))
    push(result, substr(ref_string, colon_pos + 1, slen - colon_pos - 1))
    return result
}

fn kg_cross_query(source_domain, entity_name, rel_type) {
    let result = list_new()
    let source_kg = kg_get_domain(source_domain)
    if source_kg == 0 { return result }
    let rels = source_kg[KG_RELATIONS]
    let i = 0
    while i < len(rels) {
        let r = rels[i]
        if r[KG_REL_SUBJ] == entity_name {
            if r[KG_REL_TYPE] == rel_type {
                let triple = list_new()
                push(triple, source_domain)
                push(triple, r[KG_REL_OBJ])
                push(triple, r[KG_REL_WEIGHT])
                push(result, triple)
            }
            if r[KG_REL_TYPE] == "xref" {
                let ref_parts = kg_resolve_ref(r[KG_REL_OBJ])
                let target_domain = ref_parts[0]
                let target_entity = ref_parts[1]
                let target_kg = kg_get_domain(target_domain)
                if target_kg != 0 {
                    let target_rels = target_kg[KG_RELATIONS]
                    let j = 0
                    while j < len(target_rels) {
                        let tr = target_rels[j]
                        if tr[KG_REL_SUBJ] == target_entity {
                            if tr[KG_REL_TYPE] == rel_type {
                                let triple = list_new()
                                push(triple, target_domain)
                                push(triple, tr[KG_REL_OBJ])
                                push(triple, tr[KG_REL_WEIGHT])
                                push(result, triple)
                            }
                        }
                        j = j + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

fn kg_merge_domains(domain_a, domain_b, target_domain) {
    let kg_a = kg_get_domain(domain_a)
    let kg_b = kg_get_domain(domain_b)
    let merged = kg_spawn(target_domain)

    let i = 0
    if kg_a != 0 {
        let ents_a = kg_a[KG_ENTITIES]
        i = 0
        while i < len(ents_a) {
            kg_add_entity(merged, ents_a[i][KG_ENT_NAME], ents_a[i][KG_ENT_EMBED])
            i = i + 1
        }
        let rels_a = kg_a[KG_RELATIONS]
        i = 0
        while i < len(rels_a) {
            let r = rels_a[i]
            kg_add_relation(merged, r[KG_REL_SUBJ], r[KG_REL_TYPE], r[KG_REL_OBJ], r[KG_REL_WEIGHT])
            i = i + 1
        }
    }

    if kg_b != 0 {
        let ents_b = kg_b[KG_ENTITIES]
        i = 0
        while i < len(ents_b) {
            kg_add_entity(merged, ents_b[i][KG_ENT_NAME], ents_b[i][KG_ENT_EMBED])
            i = i + 1
        }
        let rels_b = kg_b[KG_RELATIONS]
        i = 0
        while i < len(rels_b) {
            let r = rels_b[i]
            kg_add_relation(merged, r[KG_REL_SUBJ], r[KG_REL_TYPE], r[KG_REL_OBJ], r[KG_REL_WEIGHT])
            i = i + 1
        }
    }

    return merged
}
