// Nova Core: Safety & Audit Layer
// Provides permission tiers, reversibility classification, decision logging,
// override mechanism, content filters, and rate limiting for Nova's
// cognitive architecture.
//
// All state is held in module-level lists initialized by safety_init().

let SAFETY_TAG = 270

// ============================================================
// Permission tiers
// ============================================================
let PERM_OBSERVE = 1
let PERM_RESPOND = 2
let PERM_FULL = 3

let _safety_permission = 1

fn safety_set_permission(tier) {
    _safety_permission = tier
}

fn safety_get_permission() {
    return _safety_permission
}

fn safety_check(required_tier) {
    if _safety_permission >= required_tier { return 1 }
    return 0
}

// ============================================================
// Reversibility classifier
// ============================================================
let REVERSIBLE = 1
let PARTIALLY_REVERSIBLE = 2
let IRREVERSIBLE = 3

// Action type strings mapped to reversibility.
// We use a flat list of [action_type, level] pairs (max 16).
let _safety_action_classes = 0

fn _safety_init_action_classes() {
    _safety_action_classes = list_new()
    let e = list_new()
    push(e, "query")
    push(e, REVERSIBLE)
    push(_safety_action_classes, e)
    e = list_new()
    push(e, "generate")
    push(e, REVERSIBLE)
    push(_safety_action_classes, e)
    e = list_new()
    push(e, "remember")
    push(e, PARTIALLY_REVERSIBLE)
    push(_safety_action_classes, e)
    e = list_new()
    push(e, "learn")
    push(e, PARTIALLY_REVERSIBLE)
    push(_safety_action_classes, e)
    e = list_new()
    push(e, "modify")
    push(e, PARTIALLY_REVERSIBLE)
    push(_safety_action_classes, e)
    e = list_new()
    push(e, "send")
    push(e, IRREVERSIBLE)
    push(_safety_action_classes, e)
    e = list_new()
    push(e, "delete")
    push(e, IRREVERSIBLE)
    push(_safety_action_classes, e)
    e = list_new()
    push(e, "execute")
    push(e, IRREVERSIBLE)
    push(_safety_action_classes, e)
}

fn safety_classify_action(action_type) {
    let lower = str_lower(action_type)
    let i = 0
    while i < len(_safety_action_classes) {
        let pair = _safety_action_classes[i]
        if contains(lower, pair[0]) { return pair[1] }
        i = i + 1
    }
    return IRREVERSIBLE
}

fn safety_require_confirmation(action_type) {
    let level = safety_classify_action(action_type)
    if level == IRREVERSIBLE { return 1 }
    return 0
}

// ============================================================
// Decision log — circular buffer, max 500 entries
// ============================================================
let DLOG_MAX = 500
let _safety_log = 0
let _safety_log_start = 0
let _safety_log_size = 0

fn _safety_init_log() {
    _safety_log = list_new()
    _safety_log_start = 0
    _safety_log_size = 0
    let i = 0
    while i < DLOG_MAX {
        push(_safety_log, 0)
        i = i + 1
    }
}

fn safety_log_decision(action, reason, confidence, reversibility) {
    let entry = list_new()
    push(entry, time())
    push(entry, action)
    push(entry, reason)
    push(entry, confidence)
    push(entry, reversibility)
    let idx = (_safety_log_start + _safety_log_size) % DLOG_MAX
    if _safety_log_size < DLOG_MAX {
        _safety_log_size = _safety_log_size + 1
    } else {
        _safety_log_start = (_safety_log_start + 1) % DLOG_MAX
    }
    list_set(_safety_log, idx, entry)
}

fn safety_log_count() {
    return _safety_log_size
}

fn safety_log_get(index) {
    if index < 0 { return 0 }
    if index >= _safety_log_size { return 0 }
    let real = (_safety_log_start + index) % DLOG_MAX
    return _safety_log[real]
}

fn safety_log_recent(n) {
    let result = list_new()
    let count = n
    if count > _safety_log_size { count = _safety_log_size }
    let start = _safety_log_size - count
    let i = start
    while i < _safety_log_size {
        push(result, safety_log_get(i))
        i = i + 1
    }
    return result
}

// ============================================================
// Override mechanism — list of [action, reason, granted] (max 16)
// ============================================================
let OVERRIDE_MAX = 16
let _safety_overrides = 0

fn _safety_init_overrides() {
    _safety_overrides = list_new()
}

fn _safety_find_override(action) {
    let i = 0
    while i < len(_safety_overrides) {
        let ov = _safety_overrides[i]
        if ov[0] == action { return i }
        i = i + 1
    }
    return -1
}

fn safety_request_override(action, reason) {
    let idx = _safety_find_override(action)
    if idx != -1 {
        _safety_overrides[idx][1] = reason
        _safety_overrides[idx][2] = 0
        return 1
    }
    if len(_safety_overrides) >= OVERRIDE_MAX { return 0 }
    let entry = list_new()
    push(entry, action)
    push(entry, reason)
    push(entry, 0)
    push(_safety_overrides, entry)
    return 1
}

fn safety_grant_override(action) {
    let idx = _safety_find_override(action)
    if idx == -1 { return 0 }
    _safety_overrides[idx][2] = 1
    return 1
}

fn safety_has_override(action) {
    let idx = _safety_find_override(action)
    if idx == -1 { return 0 }
    if _safety_overrides[idx][2] == 0 { return 0 }
    // Consume: remove the entry (swap with last and pop)
    let last = len(_safety_overrides) - 1
    _safety_overrides[idx] = _safety_overrides[last]
    pop(_safety_overrides)
    return 1
}

// ============================================================
// Content filters
// ============================================================

fn safety_check_content(text) {
    if len(text) == 0 { return 0 }
    if len(text) > 10000 { return 0 }
    return 1
}

fn safety_sanitize_output(text) {
    let result = ""
    let i = 0
    let n = len(text)
    while i < n {
        let c = text[i]
        let code = char_code(c)
        // Allow printable ASCII (32-126), newline (10), tab (9)
        if code >= 32 {
            result = result + c
        } else {
            if code == 10 {
                result = result + c
            } else {
                if code == 9 {
                    result = result + c
                }
            }
        }
        i = i + 1
    }
    return result
}

// ============================================================
// Rate limiting — flat list of [action_type, timestamp] pairs (max 100)
// ============================================================
let RATE_MAX = 100
let _safety_rate_log = 0

fn _safety_init_rate() {
    _safety_rate_log = list_new()
}

fn safety_rate_check(action_type, window_seconds, max_count) {
    let now = time()
    let cutoff = now - window_seconds
    // Prune expired entries and count matching ones
    let kept = list_new()
    let count = 0
    let i = 0
    while i < len(_safety_rate_log) {
        let entry = _safety_rate_log[i]
        if entry[1] >= cutoff {
            push(kept, entry)
            if entry[0] == action_type {
                count = count + 1
            }
        }
        i = i + 1
    }
    // Replace the rate log with pruned version
    _safety_rate_log = kept
    // Check limit before recording
    if count >= max_count { return 0 }
    // Record this action if space allows
    if len(_safety_rate_log) < RATE_MAX {
        let rec = list_new()
        push(rec, action_type)
        push(rec, now)
        push(_safety_rate_log, rec)
    }
    return 1
}

// ============================================================
// Initialization
// ============================================================

fn safety_init() {
    _safety_permission = PERM_OBSERVE
    _safety_init_action_classes()
    _safety_init_log()
    _safety_init_overrides()
    _safety_init_rate()
}
