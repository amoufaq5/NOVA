// Nova Core: Signal
// Signals carry Moments between Nodes through Channels.
// Each signal has a type, payload (moment), origin, priority, trace,
// and metadata for context enrichment.
//
// Layout: [TAG, type, moment, origin, destination, priority, trace, metadata]

let SIGNAL_TAG = 110
let SIG_TYPE = 1
let SIG_MOMENT = 2
let SIG_ORIGIN = 3
let SIG_DEST = 4
let SIG_PRIORITY = 5
let SIG_TRACE = 6
let SIG_META = 7

// Signal types
let SIG_EVENT = 1
let SIG_QUESTION = 2
let SIG_ORDER = 3
let SIG_COMMAND = 4
let SIG_REQUEST = 5
let SIG_RESPONSE = 6
let SIG_CORRECTION = 7
let SIG_REFLECTION = 8
let SIG_PREDICTIVE = 9
let SIG_ERROR = 10
let SIG_CAUSAL = 11
let SIG_IMPLICATIVE = 12
let SIG_ANALOGICAL = 13
let SIG_EVIDENTIAL = 14
let SIG_ATTENTIVE = 15
let SIG_BINDING = 16
let SIG_VALENCE = 17
let SIG_AROUSAL = 18
let SIG_CURIOSITY = 19
let SIG_GOAL_DRIVE = 20
let SIG_REWARD = 21
let SIG_RECALL = 22

// ---------------------------------------------------------------------------
// Constructors
// ---------------------------------------------------------------------------

fn signal_new(sig_type, moment, origin, dest, priority) {
    let s = list_new()
    push(s, SIGNAL_TAG)
    push(s, sig_type)
    push(s, moment)
    push(s, origin)
    push(s, dest)
    push(s, priority)
    push(s, list_new())
    push(s, map_new())
    return s
}

fn signal_event(moment, origin, dest) {
    return signal_new(SIG_EVENT, moment, origin, dest, 50)
}

fn signal_question(moment, origin, dest) {
    return signal_new(SIG_QUESTION, moment, origin, dest, 70)
}

fn signal_command(moment, origin, dest) {
    return signal_new(SIG_COMMAND, moment, origin, dest, 90)
}

fn signal_response(moment, origin, dest) {
    return signal_new(SIG_RESPONSE, moment, origin, dest, 60)
}

fn signal_reflection(moment, origin, dest) {
    return signal_new(SIG_REFLECTION, moment, origin, dest, 40)
}

fn signal_correction(moment, origin, dest) {
    return signal_new(SIG_CORRECTION, moment, origin, dest, 80)
}

fn signal_predictive(moment, origin, dest) {
    return signal_new(SIG_PREDICTIVE, moment, origin, dest, 55)
}

fn signal_error(moment, origin, dest) {
    return signal_new(SIG_ERROR, moment, origin, dest, 85)
}

fn signal_causal(moment, origin, dest) {
    return signal_new(SIG_CAUSAL, moment, origin, dest, 65)
}

fn signal_implicative(moment, origin, dest) {
    return signal_new(SIG_IMPLICATIVE, moment, origin, dest, 60)
}

fn signal_analogical(moment, origin, dest) {
    return signal_new(SIG_ANALOGICAL, moment, origin, dest, 55)
}

fn signal_evidential(moment, origin, dest) {
    return signal_new(SIG_EVIDENTIAL, moment, origin, dest, 70)
}

fn signal_attentive(moment, origin, dest) {
    return signal_new(SIG_ATTENTIVE, moment, origin, dest, 95)
}

fn signal_binding(moment, origin, dest) {
    return signal_new(SIG_BINDING, moment, origin, dest, 50)
}

fn signal_valence(moment, origin, dest) {
    return signal_new(SIG_VALENCE, moment, origin, dest, 45)
}

fn signal_arousal(moment, origin, dest) {
    return signal_new(SIG_AROUSAL, moment, origin, dest, 45)
}

fn signal_curiosity(moment, origin, dest) {
    return signal_new(SIG_CURIOSITY, moment, origin, dest, 55)
}

fn signal_goal_drive(moment, origin, dest) {
    return signal_new(SIG_GOAL_DRIVE, moment, origin, dest, 75)
}

fn signal_reward(moment, origin, dest) {
    return signal_new(SIG_REWARD, moment, origin, dest, 80)
}

fn signal_recall(moment, origin, dest) {
    return signal_new(SIG_RECALL, moment, origin, dest, 65)
}

// ---------------------------------------------------------------------------
// Accessors
// ---------------------------------------------------------------------------

fn signal_type(s) { return s[SIG_TYPE] }
fn signal_moment(s) { return s[SIG_MOMENT] }
fn signal_origin(s) { return s[SIG_ORIGIN] }
fn signal_dest(s) { return s[SIG_DEST] }
fn signal_priority(s) { return s[SIG_PRIORITY] }
fn signal_trace(s) { return s[SIG_TRACE] }

// ---------------------------------------------------------------------------
// Trace management
// ---------------------------------------------------------------------------

fn signal_add_trace(s, nname) {
    let trace = signal_trace(s)
    push(trace, nname)
}

fn signal_has_visited(s, nname) {
    let trace = signal_trace(s)
    let i = 0
    while i < len(trace) {
        if trace[i] == nname {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn signal_trace_depth(s) {
    let trace = signal_trace(s)
    return len(trace)
}

// ---------------------------------------------------------------------------
// Transformation
// ---------------------------------------------------------------------------

// Create a new signal carrying a different moment but preserving the
// origin, destination, priority, and metadata of the original.
fn signal_transform(s, new_moment) {
    let ns = signal_new(
        signal_type(s),
        new_moment,
        signal_origin(s),
        signal_dest(s),
        signal_priority(s)
    )
    // Copy metadata from original
    ns[SIG_META] = s[SIG_META]
    return ns
}

// Return a copy of the signal aimed at a different destination.
fn signal_redirect(s, new_dest) {
    let ns = signal_new(
        signal_type(s),
        signal_moment(s),
        signal_origin(s),
        new_dest,
        signal_priority(s)
    )
    ns[SIG_META] = s[SIG_META]
    // Carry forward the existing trace
    let old_trace = signal_trace(s)
    let i = 0
    while i < len(old_trace) {
        signal_add_trace(ns, old_trace[i])
        i = i + 1
    }
    return ns
}

// Return a copy of the signal with an updated priority level.
fn signal_elevate(s, new_priority) {
    let ns = signal_new(
        signal_type(s),
        signal_moment(s),
        signal_origin(s),
        signal_dest(s),
        new_priority
    )
    ns[SIG_META] = s[SIG_META]
    let old_trace = signal_trace(s)
    let i = 0
    while i < len(old_trace) {
        signal_add_trace(ns, old_trace[i])
        i = i + 1
    }
    return ns
}

// ---------------------------------------------------------------------------
// Enrichment (metadata)
// ---------------------------------------------------------------------------

fn signal_enrich(s, context_key, context_val) {
    let meta = s[SIG_META]
    map_set(meta, context_key, context_val)
}

fn signal_get_context(s, key) {
    let meta = s[SIG_META]
    if map_has(meta, key) {
        return map_get(meta, key)
    }
    return 0
}

// ---------------------------------------------------------------------------
// Comparison
// ---------------------------------------------------------------------------

// Returns 1 if signal a has strictly higher priority than signal b.
fn signal_higher_priority(a, b) {
    if signal_priority(a) > signal_priority(b) {
        return 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Cloning
// ---------------------------------------------------------------------------

// Deep copy a signal with a fresh (empty) trace.
fn signal_clone(s) {
    let ns = signal_new(
        signal_type(s),
        signal_moment(s),
        signal_origin(s),
        signal_dest(s),
        signal_priority(s)
    )
    // Deep-copy metadata: iterate is not available, so share the map.
    // Metadata is a map — copy it by reference, which is the standard
    // Nova behaviour for map values.
    ns[SIG_META] = s[SIG_META]
    return ns
}

// ---------------------------------------------------------------------------
// Type checking
// ---------------------------------------------------------------------------

fn signal_type_name(s) {
    let t = signal_type(s)
    if t == SIG_EVENT { return "event" }
    if t == SIG_QUESTION { return "question" }
    if t == SIG_ORDER { return "order" }
    if t == SIG_COMMAND { return "command" }
    if t == SIG_REQUEST { return "request" }
    if t == SIG_RESPONSE { return "response" }
    if t == SIG_CORRECTION { return "correction" }
    if t == SIG_REFLECTION { return "reflection" }
    if t == SIG_PREDICTIVE { return "predictive" }
    if t == SIG_ERROR { return "error" }
    if t == SIG_CAUSAL { return "causal" }
    if t == SIG_IMPLICATIVE { return "implicative" }
    if t == SIG_ANALOGICAL { return "analogical" }
    if t == SIG_EVIDENTIAL { return "evidential" }
    if t == SIG_ATTENTIVE { return "attentive" }
    if t == SIG_BINDING { return "binding" }
    if t == SIG_VALENCE { return "valence" }
    if t == SIG_AROUSAL { return "arousal" }
    if t == SIG_CURIOSITY { return "curiosity" }
    if t == SIG_GOAL_DRIVE { return "goal_drive" }
    if t == SIG_REWARD { return "reward" }
    if t == SIG_RECALL { return "recall" }
    return "unknown"
}

// ---------------------------------------------------------------------------
// Priority queue helpers
// ---------------------------------------------------------------------------

// A signal queue is simply a list kept sorted by descending priority
// so that the highest-priority signal is always at the front.

fn signal_queue_new() {
    return list_new()
}

// Insert a signal into the queue at the correct position (sorted insertion,
// highest priority first).
fn signal_queue_push(q, sig) {
    let p = signal_priority(sig)
    let i = 0
    let placed = 0
    // Walk the queue to find the insertion point
    let new_q = list_new()
    while i < len(q) {
        if placed == 0 {
            if p > signal_priority(q[i]) {
                push(new_q, sig)
                placed = 1
            }
        }
        push(new_q, q[i])
        i = i + 1
    }
    if placed == 0 {
        push(new_q, sig)
    }
    // Copy back into the original queue (mutate in place)
    // Reset q by overwriting its contents
    let j = 0
    while j < len(q) {
        q[j] = new_q[j]
        j = j + 1
    }
    // If new_q is longer (it always is by exactly one), push the tail
    while j < len(new_q) {
        push(q, new_q[j])
        j = j + 1
    }
}

// Remove and return the highest-priority signal from the front of the queue.
// Returns 0 if the queue is empty.
fn signal_queue_pop(q) {
    if len(q) == 0 {
        return 0
    }
    let top = q[0]
    // Shift all elements left by one
    let i = 1
    while i < len(q) {
        q[i - 1] = q[i]
        i = i + 1
    }
    pop(q)
    return top
}

// ---------------------------------------------------------------------------
// Signal Streams: lazy, potentially infinite signal sources
// ---------------------------------------------------------------------------
// A stream wraps a generator function that produces signals on demand.
// Layout: [TAG, generator_fn, buffer, exhausted, count]

let STREAM_TAG = 115
let STREAM_GEN = 1
let STREAM_BUF = 2
let STREAM_DONE = 3
let STREAM_COUNT = 4

fn signal_stream_new(generator_fn) {
    let s = list_new()
    push(s, STREAM_TAG)
    push(s, generator_fn)
    push(s, list_new())
    push(s, 0)
    push(s, 0)
    return s
}

fn signal_stream_from(signals) {
    let s = list_new()
    push(s, STREAM_TAG)
    push(s, 0)
    let buf = list_new()
    let i = 0
    while i < len(signals) {
        push(buf, signals[i])
        i = i + 1
    }
    push(s, buf)
    push(s, 0)
    push(s, 0)
    return s
}

fn signal_stream_has_next(stream) {
    if len(stream[STREAM_BUF]) > 0 { return 1 }
    if stream[STREAM_DONE] == 1 { return 0 }
    if stream[STREAM_GEN] == 0 {
        stream[STREAM_DONE] = 1
        return 0
    }
    let gen = stream[STREAM_GEN]
    let sig = gen()
    if sig == 0 {
        stream[STREAM_DONE] = 1
        return 0
    }
    push(stream[STREAM_BUF], sig)
    return 1
}

fn signal_stream_next(stream) {
    if signal_stream_has_next(stream) == 0 { return 0 }
    let buf = stream[STREAM_BUF]
    let sig = buf[0]
    let i = 1
    while i < len(buf) {
        buf[i - 1] = buf[i]
        i = i + 1
    }
    pop(buf)
    stream[STREAM_COUNT] = stream[STREAM_COUNT] + 1
    return sig
}

fn signal_stream_peek(stream) {
    if signal_stream_has_next(stream) == 0 { return 0 }
    return stream[STREAM_BUF][0]
}

fn signal_stream_count(stream) {
    return stream[STREAM_COUNT]
}

fn signal_stream_is_done(stream) {
    return stream[STREAM_DONE]
}

fn signal_stream_close(stream) {
    stream[STREAM_DONE] = 1
    stream[STREAM_GEN] = 0
    stream[STREAM_BUF] = list_new()
}

fn signal_stream_take(stream, n) {
    let result = list_new()
    let i = 0
    while i < n {
        if signal_stream_has_next(stream) == 0 {
            i = n
        } else {
            push(result, signal_stream_next(stream))
            i = i + 1
        }
    }
    return result
}

fn signal_stream_filter(stream, min_priority) {
    let filtered = list_new()
    push(filtered, STREAM_TAG)
    push(filtered, 0)
    let buf = list_new()
    while signal_stream_has_next(stream) == 1 {
        let sig = signal_stream_next(stream)
        if signal_priority(sig) >= min_priority {
            push(buf, sig)
        }
    }
    push(filtered, buf)
    push(filtered, 1)
    push(filtered, 0)
    return filtered
}
