// Nova Package Manager
// Handles nova.pkg manifests, dependency resolution, and package commands.
//
// Package manifest format (nova.pkg):
//   name = "my-project"
//   version = "1.0.0"
//   description = "A Nova project"
//   [dependencies]
//   json = "std"
//   math = "std"
//   mylib = "github.com/user/mylib"
//
// Standard library packages (import "std/json"):
//   std/json, std/math, std/set, std/path, std/chan, std/coroutine,
//   std/taskpool, std/io, std/string, std/list, std/map

let PKG_FILE = "nova.pkg"
let PKG_DIR = "nova_packages"

let STD_PACKAGES = list_new()
let _std_pkg_ht = 0
let _std_initialized = 0

fn _pkg_reg(name) {
    push(STD_PACKAGES, name)
    _cg_ht_add(_std_pkg_ht, name)
}

fn pkg_init_std() {
    if _std_initialized == 1 { return 0 }
    _std_initialized = 1
    _std_pkg_ht = _cg_ht_new()
    _pkg_reg("json")
    _pkg_reg("math")
    _pkg_reg("set")
    _pkg_reg("path")
    _pkg_reg("chan")
    _pkg_reg("coroutine")
    _pkg_reg("taskpool")
    _pkg_reg("io")
    _pkg_reg("string")
    _pkg_reg("list")
    _pkg_reg("map")
    _pkg_reg("alloc")
    _pkg_reg("syscall")
    _pkg_reg("scheduler")
    _pkg_reg("tensor")
    _pkg_reg("csv")
    _pkg_reg("confidence")
    _pkg_reg("ffi")
    _pkg_reg("gpu")
    _pkg_reg("simd")
    _pkg_reg("crypto")
    _pkg_reg("db")
    _pkg_reg("embed")
    _pkg_reg("validate")
    _pkg_reg("secure_mem")
    _pkg_reg("python")
    _pkg_reg("llm")
    _pkg_reg("mem")
    _pkg_reg("rag")
    _pkg_reg("blas")
    _pkg_reg("embedding")
    _pkg_reg("cognitive_llm")
    _pkg_reg("persistent_alloc")
    _pkg_reg("float")
    _pkg_reg("ffi_syscall")
    _pkg_reg("lower_arm64")
    _pkg_reg("synapse")
    _pkg_reg("gates")
    _pkg_reg("parts")
    _pkg_reg("reader")
    _pkg_reg("effects")
    _pkg_reg("http")
    _pkg_reg("signal")
    _pkg_reg("knowledge")
    _pkg_reg("signal_flow")
    _pkg_reg("associative")
    _pkg_reg("hdc")
    _pkg_reg("sdr")
    _pkg_reg("active_inference")
    _pkg_reg("timeseries")
    _pkg_reg("audio")
    _pkg_reg("node_pool")
    _pkg_reg("resonance")
    _pkg_reg("atom_lifecycle")
    _pkg_reg("visualizer")
    _pkg_reg("time_machine")
    _pkg_reg("kg_visualizer")
    _pkg_reg("profiler")
    _pkg_reg("causal_library")
    _pkg_reg("predictive_coding")
    _pkg_reg("skill")
