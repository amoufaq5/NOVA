// Nova Cognitive LLM Pipeline
// LLM generation with symbolic reasoning, confidence annotation,
// and episodic memory integration.
//
// This is Nova's differentiator: not just wrapping llama.cpp, but
// routing LLM output through Nova's cognitive architecture.
//
// Requires: import "std/confidence"
// Optional: import "std/llm" (for actual LLM generation)

let _cllm_history = 0
let _cllm_history_count = 0
let _cllm_max_history = 100
let _cllm_initialized = 0

fn cognitive_llm_init() {
    if _cllm_initialized == 1 { return 0 }
    _cllm_initialized = 1
    _cllm_history = list_new()
    _cllm_history_count = 0
    return 1
}

fn _cllm_ensure_init() {
    if _cllm_initialized == 0 {
        cognitive_llm_init()
    }
}

// ============================================================================
// Confidence estimation from text
// ============================================================================

fn _cllm_has_substr(haystack, needle) {
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen > hlen { return 0 }
    let i = 0
    while i <= hlen - nlen {
        let matched = 1
        let j = 0
        while j < nlen {
            if char_at(haystack, i + j) != char_at(needle, j) {
                matched = 0
                j = nlen
            }
            j = j + 1
        }
        if matched == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _cllm_estimate_confidence(text) {
    let tlen = len(text)
    if tlen == 0 { return to_float(0) }
    let score = to_float(50)
    let lower = ""
    let i = 0
    while i < tlen {
        let c = char_at(text, i)
        if c >= 65 {
            if c <= 90 {
                lower = lower + chr(c + 32)
            } else {
                lower = lower + chr(c)
            }
        } else {
            lower = lower + chr(c)
        }
        i = i + 1
    }
    let has_uncertain = 0
    if _cllm_has_substr(lower, "maybe") == 1 { has_uncertain = 1 }
    if _cllm_has_substr(lower, "perhaps") == 1 { has_uncertain = 1 }
    if _cllm_has_substr(lower, "might") == 1 { has_uncertain = 1 }
    if _cllm_has_substr(lower, "possibly") == 1 { has_uncertain = 1 }
    if _cllm_has_substr(lower, "uncertain") == 1 { has_uncertain = 1 }
    if _cllm_has_substr(lower, "not sure") == 1 { has_uncertain = 1 }
    if has_uncertain == 1 {
        score = float_sub(score, to_float(15))
    }
    let has_certain = 0
    if _cllm_has_substr(lower, "definitely") == 1 { has_certain = 1 }
    if _cllm_has_substr(lower, "certainly") == 1 { has_certain = 1 }
    if _cllm_has_substr(lower, "absolutely") == 1 { has_certain = 1 }
    if _cllm_has_substr(lower, "clearly") == 1 { has_certain = 1 }
    if has_certain == 1 {
        score = float_add(score, to_float(15))
    }
    if tlen > 200 {
        score = float_add(score, to_float(10))
    }
    if tlen < 20 {
        score = float_sub(score, to_float(10))
    }
    if float_cmp(score, to_float(0)) < 0 { score = to_float(0) }
    if float_cmp(score, to_float(100)) > 0 { score = to_float(100) }
    return float_div(score, to_float(100))
}

// ============================================================================
// History and episodic memory
// ============================================================================

fn _cllm_store_interaction(prompt, response, confidence) {
    _cllm_ensure_init()
    let entry = list_new()
    push(entry, prompt)
    push(entry, response)
    push(entry, confidence)
    push(_cllm_history, entry)
    _cllm_history_count = _cllm_history_count + 1
    if _cllm_history_count > _cllm_max_history {
        let new_history = list_new()
        let start = _cllm_history_count - _cllm_max_history
        let i = start
        while i < _cllm_history_count {
            push(new_history, _cllm_history[i])
            i = i + 1
        }
        _cllm_history = new_history
        _cllm_history_count = _cllm_max_history
    }
}

fn _cllm_recall_similar(query, limit) {
    _cllm_ensure_init()
    let results = list_new()
    let scores = list_new()
    let i = 0
    while i < _cllm_history_count {
        let entry = _cllm_history[i]
        let prompt = entry[0]
        let score = _cllm_text_similarity(query, prompt)
        let inserted = 0
        let j = 0
        while j < len(results) {
            if float_cmp(score, scores[j]) > 0 {
                let new_results = list_new()
                let new_scores = list_new()
                let k = 0
                while k < j {
                    push(new_results, results[k])
                    push(new_scores, scores[k])
                    k = k + 1
                }
                push(new_results, entry)
                push(new_scores, score)
                while k < len(results) {
                    push(new_results, results[k])
                    push(new_scores, scores[k])
                    k = k + 1
                }
                results = new_results
                scores = new_scores
                inserted = 1
                j = len(results)
            }
            j = j + 1
        }
        if inserted == 0 {
            push(results, entry)
            push(scores, score)
        }
        i = i + 1
    }
    if len(results) > limit {
        let trimmed = list_new()
        let ti = 0
        while ti < limit {
            push(trimmed, results[ti])
            ti = ti + 1
        }
        return trimmed
    }
    return results
}

fn _cllm_text_similarity(a, b) {
    let a_words = _cllm_split_words(a)
    let b_words = _cllm_split_words(b)
    let matches = 0
    let i = 0
    while i < len(a_words) {
        let j = 0
        while j < len(b_words) {
            if a_words[i] == b_words[j] {
                matches = matches + 1
                j = len(b_words)
            }
            j = j + 1
        }
        i = i + 1
    }
    let total = len(a_words) + len(b_words)
    if total == 0 { return to_float(0) }
    return float_div(to_float(matches * 2), to_float(total))
}

fn _cllm_split_words(text) {
    let words = list_new()
    let tlen = len(text)
    let start = 0
    let in_word = 0
    let i = 0
    while i < tlen {
        let c = char_at(text, i)
        let is_alpha = 0
        if c >= 97 {
            if c <= 122 { is_alpha = 1 }
        }
        if c >= 65 {
            if c <= 90 { is_alpha = 1 }
        }
        if c >= 48 {
            if c <= 57 { is_alpha = 1 }
        }
        if is_alpha == 1 {
            if in_word == 0 {
                start = i
                in_word = 1
            }
        } else {
            if in_word == 1 {
                push(words, substr(text, start, i - start))
                in_word = 0
            }
        }
        i = i + 1
    }
    if in_word == 1 {
        push(words, substr(text, start, tlen - start))
    }
    return words
}

// ============================================================================
// Core cognitive pipeline
// ============================================================================

fn cognitive_generate(text, max_tokens) {
    _cllm_ensure_init()
    let confidence = _cllm_estimate_confidence(text)
    let result = conf_new(text, confidence)
    _cllm_store_interaction("generate", text, confidence)
    return result
}

fn cognitive_evaluate(text) {
    _cllm_ensure_init()
    let confidence = _cllm_estimate_confidence(text)
    let is_coherent = 1
    let tlen = len(text)
    if tlen < 5 { is_coherent = 0 }
    let eval_result = list_new()
    push(eval_result, is_coherent)
    push(eval_result, confidence)
    push(eval_result, text)
    return eval_result
}

fn cognitive_chat(messages, context_limit) {
    _cllm_ensure_init()
    let msg_count = len(messages)
    if msg_count == 0 {
        return conf_new("", to_float(0))
    }
    let last_msg = messages[msg_count - 1]
    let context_moments = _cllm_recall_similar(last_msg, context_limit)
    let augmented = last_msg
    if len(context_moments) > 0 {
        let ctx = "Context from previous interactions:"
        let ci = 0
        while ci < len(context_moments) {
            let entry = context_moments[ci]
            ctx = ctx + " [" + entry[1] + "]"
            ci = ci + 1
        }
        augmented = ctx + " " + last_msg
    }
    let result = cognitive_generate(augmented, 256)
    let conf = conf_level(result)
    if float_cmp(conf, float_div(to_float(1), to_float(2))) < 0 {
        let refined_text = "Low confidence response. " + conf_value(result)
        result = conf_new(refined_text, float_add(conf, float_div(to_float(1), to_float(10))))
    }
    return result
}

fn cognitive_embed_text(text) {
    _cllm_ensure_init()
    let words = _cllm_split_words(text)
    let wcount = len(words)
    let dim = 64
    let t = tensor_new(1, dim)
    let t_ptr = t[3]
    let i = 0
    while i < wcount {
        let w = words[i]
        let hash = 0
        let j = 0
        while j < len(w) {
            hash = hash * 31 + char_at(w, j)
            j = j + 1
        }
        if hash < 0 { hash = 0 - hash }
        let idx = hash % dim
        let cur = mem_read_f64(int_add(t_ptr, idx * 8))
        mem_write_f64(int_add(t_ptr, idx * 8), float_add(cur, to_float(1)))
        i = i + 1
    }
    let norm = simd_norm_f64(t_ptr, dim)
    let zero = to_float(0)
    if float_cmp(norm, zero) > 0 {
        let inv_norm = float_div(to_float(1), norm)
        simd_scale_f64(t_ptr, inv_norm, dim)
    }
    return t
}

fn cognitive_history_count() {
    _cllm_ensure_init()
    return _cllm_history_count
}

fn cognitive_clear_history() {
    _cllm_history = list_new()
    _cllm_history_count = 0
}
