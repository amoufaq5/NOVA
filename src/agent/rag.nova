// Nova Agent: Retrieval-Augmented Generation (RAG) Pipeline
// Stores documents as moments, retrieves by similarity, builds augmented prompts.

let rag_documents = 0
let rag_doc_count = 0

fn rag_init() {
    rag_documents = list_new()
    rag_doc_count = 0
}

fn rag_add_document(text, tags) {
    let doc = list_new()
    push(doc, text)
    push(doc, tags)
    push(doc, global_time)
    push(rag_documents, doc)
    rag_doc_count = rag_doc_count + 1
}

fn rag_doc_text(doc) { return doc[0] }
fn rag_doc_tags(doc) { return doc[1] }
fn rag_doc_time(doc) { return doc[2] }

fn rag_score_doc(doc, query) {
    let text = rag_doc_text(doc)
    let tags = rag_doc_tags(doc)
    let score = 0
    // Exact match
    if text == query { return 100 }
    // Substring containment
    if contains(text, query) == 1 { score = score + 50 }
    if contains(query, text) == 1 { score = score + 30 }
    // Word-level matching
    let words = split(query, " ")
    let wi = 0
    let word_hits = 0
    while wi < len(words) {
        if len(words[wi]) > 2 {
            if contains(text, words[wi]) == 1 {
                word_hits = word_hits + 1
            }
        }
        wi = wi + 1
    }
    if len(words) > 0 {
        score = score + word_hits * 40 / len(words)
    }
    // Tag matching
    let ti = 0
    while ti < len(tags) {
        if contains(query, tags[ti]) == 1 {
            score = score + 15
        }
        ti = ti + 1
    }
    if score > 100 { score = 100 }
    return score
}

fn rag_retrieve(query, top_k) {
    let results = list_new()
    let scores = list_new()
    let i = 0
    while i < rag_doc_count {
        let doc = rag_documents[i]
        let score = rag_score_doc(doc, query)
        if score > 0 {
            // Insert into sorted results list, maintaining at most top_k entries
            let pos = len(results)
            let pi = 0
            while pi < len(results) {
                if score > scores[pi] {
                    pos = pi
                    pi = len(results)
                }
                pi = pi + 1
            }
            // Insert at pos
            let new_results = list_new()
            let new_scores = list_new()
            let ni = 0
            while ni < len(results) {
                if ni == pos {
                    push(new_results, doc)
                    push(new_scores, score)
                }
                push(new_results, results[ni])
                push(new_scores, scores[ni])
                ni = ni + 1
            }
            if pos == len(results) {
                push(new_results, doc)
                push(new_scores, score)
            }
            // Truncate to top_k
            results = list_new()
            scores = list_new()
            let ti = 0
            while ti < len(new_results) {
                if ti < top_k {
                    push(results, new_results[ti])
                    push(scores, new_scores[ti])
                }
                ti = ti + 1
            }
        }
        i = i + 1
    }
    return results
}

fn rag_build_prompt(query, contexts) {
    let prompt = "Context:\n"
    let i = 0
    while i < len(contexts) {
        let doc = contexts[i]
        prompt = prompt + "- " + rag_doc_text(doc) + "\n"
        i = i + 1
    }
    prompt = prompt + "\nQuery: " + query
    return prompt
}

fn rag_query(query, top_k) {
    let contexts = rag_retrieve(query, top_k)
    return rag_build_prompt(query, contexts)
}

fn rag_remove(index) {
    if index < 0 { return 0 }
    if index >= rag_doc_count { return 0 }
    let new_docs = list_new()
    let i = 0
    while i < rag_doc_count {
        if i != index {
            push(new_docs, rag_documents[i])
        }
        i = i + 1
    }
    rag_documents = new_docs
    rag_doc_count = rag_doc_count - 1
    return 1
}

fn rag_clear() {
    rag_documents = list_new()
    rag_doc_count = 0
}

fn rag_count() {
    return rag_doc_count
}
