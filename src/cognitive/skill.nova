// N27 Skill-as-Procedural-Rule Type: rich skill metadata with trigger patterns,
// action sequences, preconditions, and performance tracking.
// Uses fixed-point scale-1000 arithmetic for rates and scores.

let SKILL_TAG = 560
let SKILL_NAME = 1
let SKILL_DESCRIPTION = 2
let SKILL_TRIGGERS = 3
let SKILL_ACTIONS = 4
let SKILL_PRECONDITIONS = 5
let SKILL_ATTEMPTS = 6
let SKILL_SUCCESSES = 7
let SKILL_FAILURES = 8
let SKILL_CONTEXT_HISTORY = 9
let SKILL_ACTIVE = 10

let SKILL_MAX_HISTORY = 100

fn _skill_contains(haystack, needle) {
    let hay_len = len(haystack)
    let needle_len = len(needle)
    if needle_len > hay_len {
        return 0
    }
    if needle_len == 0 {
        return 1
    }
    let limit = hay_len - needle_len
    let pos = 0
    while pos <= limit {
        let chunk = substr(haystack, pos, needle_len)
        if chunk == needle {
            return 1
        }
        pos = pos + 1
    }
    return 0
}

fn skill_new(name, description) {
    let skill = list_new()
    push(skill, SKILL_TAG)
    push(skill, name)
    push(skill, description)
    push(skill, list_new())
    push(skill, list_new())
    push(skill, list_new())
    push(skill, 0)
    push(skill, 0)
    push(skill, 0)
    push(skill, list_new())
    push(skill, 1)
    return skill
}

fn skill_add_trigger(skill, trigger_pattern) {
    let triggers = skill[SKILL_TRIGGERS]
    push(triggers, trigger_pattern)
}

fn skill_add_action(skill, action) {
    let actions = skill[SKILL_ACTIONS]
    push(actions, action)
}

fn skill_add_precondition(skill, condition) {
    let preconditions = skill[SKILL_PRECONDITIONS]
    push(preconditions, condition)
}

fn skill_name(skill) {
    return skill[SKILL_NAME]
}

fn skill_description(skill) {
    return skill[SKILL_DESCRIPTION]
}

fn skill_triggers(skill) {
    return skill[SKILL_TRIGGERS]
}

fn skill_actions(skill) {
    return skill[SKILL_ACTIONS]
}

fn skill_preconditions(skill) {
    return skill[SKILL_PRECONDITIONS]
}

fn skill_record_outcome(skill, success, context) {
    skill[SKILL_ATTEMPTS] = skill[SKILL_ATTEMPTS] + 1
    if success == 1 {
        skill[SKILL_SUCCESSES] = skill[SKILL_SUCCESSES] + 1
    } else {
        skill[SKILL_FAILURES] = skill[SKILL_FAILURES] + 1
    }
    let history = skill[SKILL_CONTEXT_HISTORY]
    let entry = list_new()
    push(entry, context)
    push(entry, success)
    push(history, entry)
    if len(history) > SKILL_MAX_HISTORY {
        let trimmed = list_new()
        let start = len(history) - SKILL_MAX_HISTORY
        let i = start
        while i < len(history) {
            push(trimmed, history[i])
            i = i + 1
        }
        skill[SKILL_CONTEXT_HISTORY] = trimmed
    }
}

fn skill_success_rate(skill) {
    let attempts = skill[SKILL_ATTEMPTS]
    if attempts == 0 {
        return 500
    }
    let successes = skill[SKILL_SUCCESSES]
    return successes * 1000 / attempts
}

fn skill_attempt_count(skill) {
    return skill[SKILL_ATTEMPTS]
}

fn skill_applicability(skill, current_context) {
    let score = 0
    let triggers = skill[SKILL_TRIGGERS]
    let num_triggers = len(triggers)
    let ti = 0
    let trigger_matched = 0
    while ti < num_triggers {
        if _skill_contains(current_context, triggers[ti]) == 1 {
            trigger_matched = 1
            ti = num_triggers
        }
        ti = ti + 1
    }
    if trigger_matched == 1 {
        score = score + 300
    }
    let history = skill[SKILL_CONTEXT_HISTORY]
    let num_history = len(history)
    let similar_total = 0
    let similar_success = 0
    let hi = 0
    while hi < num_history {
        let entry = history[hi]
        let past_context = entry[0]
        let past_outcome = entry[1]
        if _skill_contains(past_context, current_context) == 1 {
            similar_total = similar_total + 1
            if past_outcome == 1 {
                similar_success = similar_success + 1
            }
        } else {
            if _skill_contains(current_context, past_context) == 1 {
                similar_total = similar_total + 1
                if past_outcome == 1 {
                    similar_success = similar_success + 1
                }
            }
        }
        hi = hi + 1
    }
    if similar_total > 0 {
        let context_score = similar_success * 700 / similar_total
        score = score + context_score
    }
    if score > 1000 {
        score = 1000
    }
    if score < 0 {
        score = 0
    }
    return score
}

fn skill_matches_trigger(skill, input) {
    let triggers = skill[SKILL_TRIGGERS]
    let num_triggers = len(triggers)
    let ti = 0
    while ti < num_triggers {
        if _skill_contains(input, triggers[ti]) == 1 {
            return 1
        }
        ti = ti + 1
    }
    return 0
}

fn skill_check_preconditions(skill, state) {
    let preconditions = skill[SKILL_PRECONDITIONS]
    let num_preconditions = len(preconditions)
    let pi = 0
    while pi < num_preconditions {
        if _skill_contains(state, preconditions[pi]) == 0 {
            return 0
        }
        pi = pi + 1
    }
    return 1
}

fn skill_enable(skill) {
    skill[SKILL_ACTIVE] = 1
}

fn skill_disable(skill) {
    skill[SKILL_ACTIVE] = 0
}

fn skill_is_active(skill) {
    return skill[SKILL_ACTIVE]
}

fn skill_reset_stats(skill) {
    skill[SKILL_ATTEMPTS] = 0
    skill[SKILL_SUCCESSES] = 0
    skill[SKILL_FAILURES] = 0
    skill[SKILL_CONTEXT_HISTORY] = list_new()
}

fn skill_describe(skill) {
    let name = skill[SKILL_NAME]
    let description = skill[SKILL_DESCRIPTION]
    let triggers = skill[SKILL_TRIGGERS]
    let actions = skill[SKILL_ACTIONS]
    let rate = skill_success_rate(skill)
    print("Skill: ")
    println(name)
    print("  description: ")
    println(description)
    print("  triggers: ")
    print_int(len(triggers))
    println("")
    print("  actions: ")
    print_int(len(actions))
    println("")
    print("  success_rate: ")
    print_int(rate)
    println("/1000")
}
