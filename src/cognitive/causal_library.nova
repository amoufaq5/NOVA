fn _causal_modifier_list() {
    let mods = list_new()
    push(mods, "rapidly")
    push(mods, "slowly")
    push(mods, "partially")
    push(mods, "completely")
    push(mods, "under_stress")
    push(mods, "when_combined")
    push(mods, "repeatedly")
    push(mods, "intermittently")
    push(mods, "at_scale")
    push(mods, "with_delay")
    push(mods, "in_isolation")
    push(mods, "cascading")
    push(mods, "reversible")
    push(mods, "irreversible")
    push(mods, "probabilistic")
    push(mods, "threshold")
    push(mods, "gradual")
    push(mods, "sudden")
    push(mods, "conditional")
    return mods
}

fn _causal_strength_offset(mod_idx) {
    if mod_idx == 0 {
        return 50
    }
    if mod_idx == 1 {
        return -50
    }
    if mod_idx == 2 {
        return -80
    }
    if mod_idx == 3 {
        return 70
    }
    if mod_idx == 4 {
        return -60
    }
    if mod_idx == 5 {
        return 30
    }
    if mod_idx == 6 {
        return 40
    }
    if mod_idx == 7 {
        return -70
    }
    if mod_idx == 8 {
        return 60
    }
    if mod_idx == 9 {
        return -90
    }
    if mod_idx == 10 {
        return -40
    }
    if mod_idx == 11 {
        return 80
    }
    if mod_idx == 12 {
        return -30
    }
    if mod_idx == 13 {
        return 90
    }
    if mod_idx == 14 {
        return -100
    }
    if mod_idx == 15 {
        return 50
    }
    if mod_idx == 16 {
        return -50
    }
    if mod_idx == 17 {
        return 70
    }
    if mod_idx == 18 {
        return -60
    }
    return 0
}

fn _causal_generate_variations(lib) {
    let old_patterns = lib[1]
    let seed_count = lib[2]
    let mods = _causal_modifier_list()
    let mod_count = len(mods)
    let total = seed_count + seed_count * mod_count
    let all = list_new()
    let i = 0
    while i < total {
        push(all, 0)
        i = i + 1
    }
    let si = 0
    while si < seed_count {
        all[si] = old_patterns[si]
        si = si + 1
    }
    let next_id = seed_count
    si = 0
    while si < seed_count {
        let seed = old_patterns[si]
        let seed_cat = seed[2]
        let seed_pre = seed[3]
        let seed_act = seed[4]
        let seed_eff = seed[5]
        let seed_str = seed[6]
        let seed_kw = seed[7]
        let mi = 0
        while mi < mod_count {
            let modifier = mods[mi]
            let offset = _causal_strength_offset(mi)
            let new_str = seed_str + offset
            if new_str > 1000 {
                new_str = 1000
            }
            if new_str < 0 {
                new_str = 0
            }
            let var_pat = causal_pattern_new(next_id, seed_cat, seed_pre, seed_act, seed_eff, new_str)
            push(var_pat, seed_kw)
            all[next_id] = var_pat
            next_id = next_id + 1
            mi = mi + 1
        }
        si = si + 1
    }
    lib[1] = all
    lib[2] = next_id
}

fn causal_lib_load(lib) {
    if lib[4] == 1 {
        return lib
    }
    _causal_load_physical(lib)
    _causal_load_biological(lib)
    _causal_load_social(lib)
    _causal_load_computational(lib)
    _causal_load_causal(lib)
    _causal_load_domain(lib)
    _causal_generate_variations(lib)
    lib[4] = 1
    return lib
}

fn causal_lib_count(lib) {
    return lib[2]
}

fn causal_lib_get(lib, pattern_id) {
    let patterns = lib[1]
    let count = lib[2]
    let i = 0
    while i < count {
        let pat = patterns[i]
        if pat[1] == pattern_id {
            return pat
        }
        i = i + 1
    }
    return 0
}

fn causal_lib_search(lib, keyword) {
    let patterns = lib[1]
    let count = lib[2]
    let results = list_new()
    let i = 0
    while i < count {
        let pat = patterns[i]
        let kws = pat[7]
        let kw_count = len(kws)
        let ki = 0
        let found = 0
        while ki < kw_count {
            if kws[ki] == keyword {
                found = 1
                ki = kw_count
            }
            ki = ki + 1
        }
        if found == 1 {
            push(results, pat[1])
        }
        i = i + 1
    }
    return results
}

fn causal_lib_search_category(lib, category) {
    let patterns = lib[1]
    let count = lib[2]
    let results = list_new()
    let i = 0
    while i < count {
        let pat = patterns[i]
        if pat[2] == category {
            push(results, pat[1])
        }
        i = i + 1
    }
    return results
}

fn causal_lib_apply(lib, pattern_id, entity, context) {
    let pat = causal_lib_get(lib, pattern_id)
    if pat == 0 {
        let r = list_new()
        push(r, "unknown")
        push(r, 0)
        push(r, 0)
        return r
    }
    let precondition = pat[3]
    let effect = pat[5]
    let strength = pat[6]
    let applicable = _causal_contains(context, precondition)
    let effect_str = concat(entity, concat(": ", effect))
    let result = list_new()
    push(result, effect_str)
    push(result, strength)
    push(result, applicable)
    return result
}

fn causal_lib_categories(lib) {
    return lib[3]
}

fn causal_lib_describe(lib) {
    let cats = lib[3]
    let cat_count = len(cats)
    let patterns = lib[1]
    let total = lib[2]
    println("CausalLibrary Summary")
    print("  total patterns: ")
    print_int(total)
    println("")
    let ci = 0
    while ci < cat_count {
        let cat_name = cats[ci]
        let cat_total = 0
        let pi = 0
        while pi < total {
            let pat = patterns[pi]
            if pat[2] == cat_name {
                cat_total = cat_total + 1
            }
            pi = pi + 1
        }
        print("  ")
        print(cat_name)
        print(": ")
        print_int(cat_total)
        println("")
        ci = ci + 1
    }
}
