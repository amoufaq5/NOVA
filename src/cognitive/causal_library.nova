// N25 Standard Library of Causal Patterns: extends imagination with 1000+
// common causal patterns across physical, biological, social, computational,
// causal, and domain categories. Seed patterns are expanded via modifier
// variations to exceed 1000 total patterns.

let CAUSAL_LIB_TAG = 540
let CAUSAL_PAT_TAG = 545

fn _causal_contains(haystack, needle) {
    let hay_len = len(haystack)
    let needle_len = len(needle)
    if needle_len > hay_len {
        return 0
    }
    if needle_len == 0 {
        return 1
    }
    let limit = hay_len - needle_len
    let pos = 0
    while pos <= limit {
        let chunk = substr(haystack, pos, needle_len)
        if chunk == needle {
            return 1
        }
        pos = pos + 1
    }
    return 0
}

fn causal_pattern_new(id, category, precondition, action, effect, strength) {
    let pat = list_new()
    push(pat, CAUSAL_PAT_TAG)
    push(pat, id)
    push(pat, category)
    push(pat, precondition)
    push(pat, action)
    push(pat, effect)
    push(pat, strength)
    return pat
}

fn causal_lib_new() {
    let lib = list_new()
    push(lib, CAUSAL_LIB_TAG)
    push(lib, list_new())
    push(lib, 0)
    let cats = list_new()
    push(cats, "physical")
    push(cats, "biological")
    push(cats, "social")
    push(cats, "computational")
    push(cats, "causal")
    push(cats, "domain")
    push(lib, cats)
    push(lib, 0)
    return lib
}

fn _causal_add_seed(lib, category, precondition, action, effect, strength) {
    let patterns = lib[1]
    let count = lib[2]
    let pat = causal_pattern_new(count, category, precondition, action, effect, strength)
    push(patterns, pat)
    lib[2] = count + 1
    return pat
}

