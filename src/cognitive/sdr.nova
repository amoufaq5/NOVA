// N14 SDR (Sparse Distributed Representation): Numenta-style binary sparse vectors.
// Represents SDRs as sorted lists of active indices rather than bit arrays,
// which is more memory efficient for sparse representations.

let SDR_TAG = 420
let SDR_DIMENSIONS = 1
let SDR_SPARSITY = 2
let SDR_ACTIVE = 3

fn sdr_new(dimensions, sparsity) {
    let sdr = list_new()
    push(sdr, SDR_TAG)
    push(sdr, dimensions)
    push(sdr, sparsity)
    push(sdr, list_new())
    return sdr
}

fn _sdr_insertion_sort(lst) {
    let n = len(lst)
    let i = 1
    while i < n {
        let key = lst[i]
        let j = i - 1
        let done = 0
        while done == 0 {
            if j < 0 {
                done = 1
            } else {
                if lst[j] > key {
                    lst[j + 1] = lst[j]
                    j = j - 1
                } else {
                    done = 1
                }
            }
        }
        lst[j + 1] = key
        i = i + 1
    }
}

fn sdr_set(sdr, indices_list) {
    let sorted = list_new()
    let i = 0
    while i < len(indices_list) {
        push(sorted, indices_list[i])
        i = i + 1
    }
    _sdr_insertion_sort(sorted)
    sdr[SDR_ACTIVE] = sorted
}

fn sdr_get_active(sdr) {
    return sdr[SDR_ACTIVE]
}

fn sdr_active_count(sdr) {
    return len(sdr[SDR_ACTIVE])
}

fn sdr_overlap(a, b) {
    let list_a = a[SDR_ACTIVE]
    let list_b = b[SDR_ACTIVE]
    let len_a = len(list_a)
    let len_b = len(list_b)
    let ia = 0
    let ib = 0
    let count = 0
    while ia < len_a {
        if ib >= len_b {
            ia = len_a
        } else {
            let va = list_a[ia]
            let vb = list_b[ib]
            if va == vb {
                count = count + 1
                ia = ia + 1
                ib = ib + 1
            } else {
                if va < vb {
                    ia = ia + 1
                } else {
                    ib = ib + 1
                }
            }
        }
    }
    return count
}

fn sdr_union(sdr_list) {
    let merged = list_new()
    let s = 0
    while s < len(sdr_list) {
        let active = sdr_list[s][SDR_ACTIVE]
        let i = 0
        while i < len(active) {
            push(merged, active[i])
            i = i + 1
        }
        s = s + 1
    }
    _sdr_insertion_sort(merged)
    let deduped = list_new()
    let i = 0
    while i < len(merged) {
        if i == 0 {
            push(deduped, merged[i])
        } else {
            if merged[i] != merged[i - 1] {
                push(deduped, merged[i])
            }
        }
        i = i + 1
    }
    let dims = 0
    let sparsity = 0
    if len(sdr_list) > 0 {
        dims = sdr_list[0][SDR_DIMENSIONS]
        sparsity = sdr_list[0][SDR_SPARSITY]
    }
    let result = sdr_new(dims, sparsity)
    result[SDR_ACTIVE] = deduped
    return result
}

fn sdr_intersection(a, b) {
    let list_a = a[SDR_ACTIVE]
    let list_b = b[SDR_ACTIVE]
    let len_a = len(list_a)
    let len_b = len(list_b)
    let ia = 0
    let ib = 0
    let common = list_new()
    while ia < len_a {
        if ib >= len_b {
            ia = len_a
        } else {
            let va = list_a[ia]
            let vb = list_b[ib]
            if va == vb {
                push(common, va)
                ia = ia + 1
                ib = ib + 1
            } else {
                if va < vb {
                    ia = ia + 1
                } else {
                    ib = ib + 1
                }
            }
        }
    }
    let result = sdr_new(a[SDR_DIMENSIONS], a[SDR_SPARSITY])
    result[SDR_ACTIVE] = common
    return result
}

fn sdr_subsample(sdr, target_count) {
    let active = sdr[SDR_ACTIVE]
    let count = len(active)
    let kept = list_new()
    let limit = target_count
    if count < limit {
        limit = count
    }
    let i = 0
    while i < limit {
        push(kept, active[i])
        i = i + 1
    }
    let result = sdr_new(sdr[SDR_DIMENSIONS], sdr[SDR_SPARSITY])
    result[SDR_ACTIVE] = kept
    return result
}

fn sdr_random(dimensions, sparsity, seed) {
    let num_active = dimensions * sparsity / 100
    let s = seed
    let indices = list_new()
    let generated = 0
    while generated < num_active {
        s = int_mod(int_add(int_mul(s, 1103), 13849), 65536)
        let idx = int_mod(s, dimensions)
        let found = 0
        let k = 0
        while k < len(indices) {
            if indices[k] == idx {
                found = 1
                k = len(indices)
            }
            k = k + 1
        }
        if found == 0 {
            push(indices, idx)
            generated = generated + 1
        }
    }
    _sdr_insertion_sort(indices)
    let result = sdr_new(dimensions, sparsity)
    result[SDR_ACTIVE] = indices
    return result
}

fn sdr_similarity(a, b) {
    let overlap = sdr_overlap(a, b)
    let count_a = sdr_active_count(a)
    let count_b = sdr_active_count(b)
    let min_count = count_a
    if count_b < min_count {
        min_count = count_b
    }
    if min_count == 0 {
        return 0
    }
    return overlap * 1000 / min_count
}

fn sdr_encode_scalar(value, min_val, max_val, dimensions, num_active) {
    let range = max_val - min_val
    let clamped = value
    if clamped < min_val {
        clamped = min_val
    }
    if clamped > max_val {
        clamped = max_val
    }
    let num_positions = dimensions - num_active
    let offset = 0
    if range > 0 {
        offset = (clamped - min_val) * num_positions / range
    }
    if offset > num_positions {
        offset = num_positions
    }
    let indices = list_new()
    let i = 0
    while i < num_active {
        push(indices, offset + i)
        i = i + 1
    }
    let result = sdr_new(dimensions, 0)
    result[SDR_ACTIVE] = indices
    return result
}

fn sdr_describe(sdr) {
    print("SDR[dims=")
    print_int(sdr[SDR_DIMENSIONS])
    print(" sparsity=")
    print_int(sdr[SDR_SPARSITY])
    print("% active=")
    print_int(len(sdr[SDR_ACTIVE]))
    print(" indices=(")
    let active = sdr[SDR_ACTIVE]
    let i = 0
    while i < len(active) {
        if i > 0 {
            print(",")
        }
        print_int(active[i])
        i = i + 1
    }
    println(")]")
}
