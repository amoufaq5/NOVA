// Nova Standard Library: GPU Compute
// Unified GPU API with automatic backend selection (CUDA → OpenCL → CPU SIMD).
// Requires: --link-libc flag.
//
// Usage:
//   compute_init()
//   let backend = compute_backend()
//   let dev_buf = gpu_alloc(1024)
//   gpu_copy_to(dev_buf, host_ptr, 1024)
//   gpu_launch(kernel, grid, block, args)
//   gpu_copy_from(host_ptr, dev_buf, 1024)
//   gpu_free(dev_buf)

let _gpu_backend = 0
let _cuda_lib = 0
let _opencl_lib = 0

// CUDA function pointers
let _cu_init = 0
let _cu_device_get = 0
let _cu_ctx_create = 0
let _cu_malloc = 0
let _cu_free = 0
let _cu_memcpy_htod = 0
let _cu_memcpy_dtoh = 0
let _cu_module_load = 0
let _cu_module_get_fn = 0
let _cu_launch_kernel = 0
let _cu_ctx_sync = 0

// OpenCL function pointers
let _cl_get_platforms = 0
let _cl_get_devices = 0
let _cl_create_context = 0
let _cl_create_queue = 0
let _cl_create_buffer = 0
let _cl_write_buffer = 0
let _cl_read_buffer = 0
let _cl_create_program = 0
let _cl_build_program = 0
let _cl_create_kernel = 0
let _cl_set_kernel_arg = 0
let _cl_enqueue_kernel = 0
let _cl_finish = 0
let _cl_release_mem = 0

let _cl_context = 0
let _cl_queue = 0

fn _try_cuda_init() {
    _cuda_lib = ffi_open("libcuda.so")
    if _cuda_lib == 0 {
        _cuda_lib = ffi_open("libcuda.so.1")
    }
    if _cuda_lib == 0 { return 0 }
    _cu_init = ffi_sym(_cuda_lib, "cuInit")
    if _cu_init == 0 {
        ffi_close(_cuda_lib)
        _cuda_lib = 0
        return 0
    }
    let result = ffi_call1(_cu_init, 0)
    if result != 0 {
        ffi_close(_cuda_lib)
        _cuda_lib = 0
        return 0
    }
    _cu_device_get = ffi_sym(_cuda_lib, "cuDeviceGet")
    _cu_ctx_create = ffi_sym(_cuda_lib, "cuCtxCreate_v2")
    _cu_malloc = ffi_sym(_cuda_lib, "cuMemAlloc_v2")
    _cu_free = ffi_sym(_cuda_lib, "cuMemFree_v2")
    _cu_memcpy_htod = ffi_sym(_cuda_lib, "cuMemcpyHtoD_v2")
    _cu_memcpy_dtoh = ffi_sym(_cuda_lib, "cuMemcpyDtoH_v2")
    _cu_module_load = ffi_sym(_cuda_lib, "cuModuleLoadData")
    _cu_module_get_fn = ffi_sym(_cuda_lib, "cuModuleGetFunction")
    _cu_launch_kernel = ffi_sym(_cuda_lib, "cuLaunchKernel")
    _cu_ctx_sync = ffi_sym(_cuda_lib, "cuCtxSynchronize")
    return 1
}

fn _try_opencl_init() {
    _opencl_lib = ffi_open("libOpenCL.so")
    if _opencl_lib == 0 {
        _opencl_lib = ffi_open("libOpenCL.so.1")
    }
    if _opencl_lib == 0 { return 0 }
    _cl_get_platforms = ffi_sym(_opencl_lib, "clGetPlatformIDs")
    if _cl_get_platforms == 0 {
        ffi_close(_opencl_lib)
        _opencl_lib = 0
        return 0
    }
    _cl_get_devices = ffi_sym(_opencl_lib, "clGetDeviceIDs")
    _cl_create_context = ffi_sym(_opencl_lib, "clCreateContext")
    _cl_create_queue = ffi_sym(_opencl_lib, "clCreateCommandQueue")
    _cl_create_buffer = ffi_sym(_opencl_lib, "clCreateBuffer")
    _cl_write_buffer = ffi_sym(_opencl_lib, "clEnqueueWriteBuffer")
    _cl_read_buffer = ffi_sym(_opencl_lib, "clEnqueueReadBuffer")
    _cl_create_program = ffi_sym(_opencl_lib, "clCreateProgramWithSource")
    _cl_build_program = ffi_sym(_opencl_lib, "clBuildProgram")
    _cl_create_kernel = ffi_sym(_opencl_lib, "clCreateKernel")
    _cl_set_kernel_arg = ffi_sym(_opencl_lib, "clSetKernelArg")
    _cl_enqueue_kernel = ffi_sym(_opencl_lib, "clEnqueueNDRangeKernel")
    _cl_finish = ffi_sym(_opencl_lib, "clFinish")
    _cl_release_mem = ffi_sym(_opencl_lib, "clReleaseMemObject")
    // Create context and command queue
    let platform = mem_alloc(8)
    ffi_call3(_cl_get_platforms, 1, platform, 0)
    let plat = mem_read_i64(platform)
    let device = mem_alloc(8)
    ffi_call5(_cl_get_devices, plat, 1, 1, device, 0)
    let dev = mem_read_i64(device)
    _cl_context = ffi_call5(_cl_create_context, 0, 1, device, 0, 0)
    _cl_queue = ffi_call3(_cl_create_queue, _cl_context, dev, 0)
    mem_free(platform)
    mem_free(device)
    return 1
}

fn compute_init() {
    if _try_cuda_init() == 1 {
        _gpu_backend = 1
        return 1
    }
    if _try_opencl_init() == 1 {
        _gpu_backend = 2
        return 1
    }
    _gpu_backend = 3
    return 1
}

fn compute_backend() {
    if _gpu_backend == 1 { return "cuda" }
    if _gpu_backend == 2 { return "opencl" }
    return "cpu"
}

fn gpu_available() {
    if _gpu_backend == 1 { return 1 }
    if _gpu_backend == 2 { return 1 }
    return 0
}

fn gpu_alloc(size) {
    if _gpu_backend == 1 {
        let dev_ptr = alloc(8)
        ffi_call2(_cu_malloc, dev_ptr, size)
        return mem_read_i64(dev_ptr)
    }
    return alloc(size)
}

fn gpu_free(dev_ptr) {
    if _gpu_backend == 1 {
        ffi_call1(_cu_free, dev_ptr)
    }
}

fn gpu_copy_to(dev_ptr, host_ptr, size) {
    if _gpu_backend == 1 {
        ffi_call3(_cu_memcpy_htod, dev_ptr, host_ptr, size)
        return 0
    }
    // CPU fallback: memcpy
    let i = 0
    while i < size {
        let byte_val = mem_read_i8(int_add(host_ptr, i))
        mem_write_i8(int_add(dev_ptr, i), byte_val)
        i = i + 1
    }
    return 0
}

fn gpu_copy_from(host_ptr, dev_ptr, size) {
    if _gpu_backend == 1 {
        ffi_call3(_cu_memcpy_dtoh, host_ptr, dev_ptr, size)
        return 0
    }
    let i = 0
    while i < size {
        let byte_val = mem_read_i8(int_add(dev_ptr, i))
        mem_write_i8(int_add(host_ptr, i), byte_val)
        i = i + 1
    }
    return 0
}

fn gpu_sync() {
    if _gpu_backend == 1 {
        ffi_call0(_cu_ctx_sync)
    }
    if _gpu_backend == 2 {
        if _cl_finish != 0 {
            ffi_call1(_cl_finish, _cl_queue)
        }
    }
}

fn gpu_load_module(ptx_source) {
    if _gpu_backend != 1 { return 0 }
    let module_ptr = alloc(8)
    ffi_calln(_cu_module_load, [module_ptr, ptx_source])
    return mem_read_i64(module_ptr)
}

fn gpu_get_function(module, name) {
    if _gpu_backend != 1 { return 0 }
    let fn_ptr = alloc(8)
    ffi_calln(_cu_module_get_fn, [fn_ptr, module, name])
    return mem_read_i64(fn_ptr)
}

fn gpu_launch(kernel_fn, grid_x, block_x, params_ptr) {
    if _gpu_backend != 1 { return 0 }
    let args = [kernel_fn, grid_x, 1, 1, block_x, 1, 1, 0, 0, params_ptr, 0]
    return ffi_calln(_cu_launch_kernel, args)
}

fn gpu_create_program(source) {
    if _gpu_backend == 2 {
        let src_len = len(source)
        return ffi_call5(_cl_create_program, _cl_context, 1, source, src_len, 0)
    }
    return 0
}

fn gpu_build_program(program) {
    if _gpu_backend == 2 {
        return ffi_call5(_cl_build_program, program, 0, 0, 0, 0)
    }
    return 0
}

fn gpu_create_kernel(program, name) {
    if _gpu_backend == 2 {
        return ffi_call3(_cl_create_kernel, program, name, 0)
    }
    return 0
}

fn compute_close() {
    if _gpu_backend == 1 {
        if _cuda_lib != 0 { ffi_close(_cuda_lib) }
    }
    if _gpu_backend == 2 {
        if _opencl_lib != 0 { ffi_close(_opencl_lib) }
    }
    _gpu_backend = 0
}

// ================================================================
// Tensor-GPU integration
// Upload tensors to GPU, perform operations, download results.
// Falls back to CPU SIMD when no GPU is available.
// ================================================================

fn gpu_tensor_alloc(rows, cols) {
    return gpu_alloc(rows * cols * 8)
}

fn gpu_tensor_upload(tensor_t) {
    let rows = tensor_t[1]
    let cols = tensor_t[2]
    let host_ptr = tensor_t[3]
    let size = rows * cols * 8
    let dev_ptr = gpu_alloc(size)
    gpu_copy_to(dev_ptr, host_ptr, size)
    return dev_ptr
}

fn gpu_tensor_download(dev_ptr, rows, cols) {
    let t = tensor_new(rows, cols)
    let host_ptr = t[3]
    let size = rows * cols * 8
    gpu_copy_from(host_ptr, dev_ptr, size)
    return t
}

fn gpu_tensor_free(dev_ptr) {
    gpu_free(dev_ptr)
}

fn gpu_tensor_add(a, b) {
    if _gpu_backend == 3 {
        return tensor_add(a, b)
    }
    let rows = a[1]
    let cols = a[2]
    let n = rows * cols
    let dev_a = gpu_tensor_upload(a)
    let dev_b = gpu_tensor_upload(b)
    let dev_c = gpu_tensor_alloc(rows, cols)
    if _gpu_backend == 2 {
        let src = "__kernel void vadd(__global double* a, __global double* b, __global double* c, int n) { int i = get_global_id(0); if (i < n) c[i] = a[i] + b[i]; }"
        let prog = gpu_create_program(src)
        gpu_build_program(prog)
        let kern = gpu_create_kernel(prog, "vadd")
        let arg_a = alloc(8)
        mem_write_i64(arg_a, dev_a)
        let arg_b = alloc(8)
        mem_write_i64(arg_b, dev_b)
        let arg_c = alloc(8)
        mem_write_i64(arg_c, dev_c)
        let arg_n = alloc(4)
        mem_write_i32(arg_n, n)
        ffi_call3(_cl_set_kernel_arg, kern, 0, 8)
        ffi_call3(_cl_set_kernel_arg, kern, 1, 8)
        ffi_call3(_cl_set_kernel_arg, kern, 2, 8)
        ffi_call3(_cl_set_kernel_arg, kern, 3, 4)
        let global_size = alloc(8)
        mem_write_i64(global_size, n)
        ffi_calln(_cl_enqueue_kernel, [_cl_queue, kern, 1, 0, global_size, 0, 0, 0, 0])
        gpu_sync()
    }
    let result = gpu_tensor_download(dev_c, rows, cols)
    gpu_free(dev_a)
    gpu_free(dev_b)
    gpu_free(dev_c)
    return result
}

fn gpu_tensor_matmul(a, b) {
    if _gpu_backend == 3 {
        return tensor_matmul(a, b)
    }
    let ar = a[1]
    let ac = a[2]
    let bc = b[2]
    let dev_a = gpu_tensor_upload(a)
    let dev_b = gpu_tensor_upload(b)
    let dev_c = gpu_tensor_alloc(ar, bc)
    if _gpu_backend == 2 {
        let src = "__kernel void matmul(__global double* A, __global double* B, __global double* C, int M, int N, int K) { int row = get_global_id(0); int col = get_global_id(1); if (row < M && col < N) { double sum = 0.0; for (int k = 0; k < K; k++) sum += A[row*K+k] * B[k*N+col]; C[row*N+col] = sum; } }"
        let prog = gpu_create_program(src)
        gpu_build_program(prog)
        let kern = gpu_create_kernel(prog, "matmul")
        let global_size = alloc(16)
        mem_write_i64(global_size, ar)
        mem_write_i64(int_add(global_size, 8), bc)
        ffi_calln(_cl_enqueue_kernel, [_cl_queue, kern, 2, 0, global_size, 0, 0, 0, 0])
        gpu_sync()
    }
    let result = gpu_tensor_download(dev_c, ar, bc)
    gpu_free(dev_a)
    gpu_free(dev_b)
    gpu_free(dev_c)
    return result
}
