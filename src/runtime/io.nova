// Nova Runtime: File I/O
// Buffered read/write operations built on syscall wrappers.

let IO_BUF_SIZE = 4096

// File handle structure:
// [fd: 8][read_buf: ptr][read_pos: 8][read_len: 8]
// [write_buf: ptr][write_pos: 8][mode: 8]
let FILE_FD = 0
let FILE_RBUF = 8
let FILE_RPOS = 16
let FILE_RLEN = 24
let FILE_WBUF = 32
let FILE_WPOS = 40
let FILE_MODE = 48
let FILE_SIZE = 56

let MODE_READ = 0
let MODE_WRITE = 1
let MODE_APPEND = 2

fn file_open(path, mode) {
    let flags = 0
    if mode == MODE_READ {
        flags = O_RDONLY
    }
    if mode == MODE_WRITE {
        flags = O_WRONLY + O_CREAT + O_TRUNC
    }
    if mode == MODE_APPEND {
        flags = O_WRONLY + O_CREAT + O_APPEND
    }

    let fd = sys_open(str_data(path), flags, 438)  // 0o666
    if fd < 0 {
        return 0
    }

    let f = alloc(FILE_SIZE)
    __intrinsic("store64", f + FILE_FD, fd)
    __intrinsic("store64", f + FILE_MODE, mode)
    __intrinsic("store64", f + FILE_RPOS, 0)
    __intrinsic("store64", f + FILE_RLEN, 0)
    __intrinsic("store64", f + FILE_WPOS, 0)

    if mode == MODE_READ {
        let rbuf = alloc(IO_BUF_SIZE)
        __intrinsic("store64", f + FILE_RBUF, rbuf)
        __intrinsic("store64", f + FILE_WBUF, 0)
    } else {
        let wbuf = alloc(IO_BUF_SIZE)
        __intrinsic("store64", f + FILE_WBUF, wbuf)
        __intrinsic("store64", f + FILE_RBUF, 0)
    }

    return f
}

fn file_close(f) {
    if f == 0 { return }
    let mode = __intrinsic("load64", f + FILE_MODE)
    if mode != MODE_READ {
        file_flush(f)
    }
    let fd = __intrinsic("load64", f + FILE_FD)
    sys_close(fd)
    let rbuf = __intrinsic("load64", f + FILE_RBUF)
    if rbuf != 0 { free(rbuf) }
    let wbuf = __intrinsic("load64", f + FILE_WBUF)
    if wbuf != 0 { free(wbuf) }
    free(f)
}

fn file_read_byte(f) {
    let pos = __intrinsic("load64", f + FILE_RPOS)
    let len = __intrinsic("load64", f + FILE_RLEN)
    if pos >= len {
        // Refill buffer
        let fd = __intrinsic("load64", f + FILE_FD)
        let rbuf = __intrinsic("load64", f + FILE_RBUF)
        let n = sys_read(fd, rbuf, IO_BUF_SIZE)
        if n <= 0 {
            return -1  // EOF or error
        }
        __intrinsic("store64", f + FILE_RLEN, n)
        __intrinsic("store64", f + FILE_RPOS, 0)
        pos = 0
    }
    let rbuf = __intrinsic("load64", f + FILE_RBUF)
    let byte = __intrinsic("load8", rbuf + pos)
    __intrinsic("store64", f + FILE_RPOS, pos + 1)
    return byte
}

fn file_read(f, count) {
    let buf = alloc(count)
    let i = 0
    while i < count {
        let b = file_read_byte(f)
        if b < 0 {
            // Return what we have so far
            return str_new(buf, i)
        }
        __intrinsic("store8", buf + i, b)
        i = i + 1
    }
    let result = str_new(buf, count)
    free(buf)
    return result
}

fn file_read_line(f) {
    let buf = alloc(1024)
    let cap = 1024
    let i = 0
    while true {
        let b = file_read_byte(f)
        if b < 0 {
            if i == 0 { free(buf); return none }
            let result = str_new(buf, i)
            free(buf)
            return result
        }
        if b == 10 {  // newline
            let result = str_new(buf, i)
            free(buf)
            return result
        }
        if i >= cap {
            cap = cap * 2
            buf = realloc(buf, cap)
        }
        __intrinsic("store8", buf + i, b)
        i = i + 1
    }
}

fn file_read_all(f) {
    let buf = alloc(4096)
    let cap = 4096
    let total = 0
    while true {
        let b = file_read_byte(f)
        if b < 0 {
            let result = str_new(buf, total)
            free(buf)
            return result
        }
        if total >= cap {
            cap = cap * 2
            buf = realloc(buf, cap)
        }
        __intrinsic("store8", buf + total, b)
        total = total + 1
    }
}

fn file_write_byte(f, byte) {
    let pos = __intrinsic("load64", f + FILE_WPOS)
    let wbuf = __intrinsic("load64", f + FILE_WBUF)
    __intrinsic("store8", wbuf + pos, byte)
    pos = pos + 1
    __intrinsic("store64", f + FILE_WPOS, pos)
    if pos >= IO_BUF_SIZE {
        file_flush(f)
    }
}

fn file_write(f, s) {
    let length = str_len(s)
    let i = 0
    while i < length {
        file_write_byte(f, __intrinsic("load8", str_data(s) + i))
        i = i + 1
    }
}

fn file_write_line(f, s) {
    file_write(f, s)
    file_write_byte(f, 10)
}

fn file_flush(f) {
    let pos = __intrinsic("load64", f + FILE_WPOS)
    if pos > 0 {
        let fd = __intrinsic("load64", f + FILE_FD)
        let wbuf = __intrinsic("load64", f + FILE_WBUF)
        sys_write(fd, wbuf, pos)
        __intrinsic("store64", f + FILE_WPOS, 0)
    }
}

// Convenience: read entire file by path
fn read_file(path) {
    let f = file_open(path, MODE_READ)
    if f == 0 { return none }
    let content = file_read_all(f)
    file_close(f)
    return content
}

// Convenience: write string to file by path
fn write_file(path, content) {
    let f = file_open(path, MODE_WRITE)
    if f == 0 { return false }
    file_write(f, content)
    file_close(f)
    return true
}

// Standard I/O wrappers
fn print(s) {
    sys_write(STDOUT, str_data(s), str_len(s))
}

fn println(s) {
    print(s)
    sys_write(STDOUT, "\n", 1)
}

fn eprint(s) {
    sys_write(STDERR, str_data(s), str_len(s))
}

fn eprintln(s) {
    eprint(s)
    sys_write(STDERR, "\n", 1)
}

fn input() {
    let buf = alloc(1024)
    let n = sys_read(STDIN, buf, 1024)
    if n <= 0 {
        free(buf)
        return str_new(0, 0)
    }
    // Strip trailing newline
    if n > 0 {
        if __intrinsic("load8", buf + n - 1) == 10 {
            n = n - 1
        }
    }
    let result = str_new(buf, n)
    free(buf)
    return result
}
