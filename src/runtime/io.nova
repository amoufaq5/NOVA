// Nova Runtime: File I/O
// Buffered read/write operations built on syscall wrappers.

let IO_BUF_SIZE = 4096

// File handle layout:
// [fd: 8][read_buf: ptr][read_pos: 8][read_len: 8]
// [write_buf: ptr][write_pos: 8][mode: 8]
let FILE_FD = 0
let FILE_RBUF = 8
let FILE_RPOS = 16
let FILE_RLEN = 24
let FILE_WBUF = 32
let FILE_WPOS = 40
let FILE_MODE = 48
let FILE_SIZE = 56

let MODE_READ = 0
let MODE_WRITE = 1
let MODE_APPEND = 2

fn file_open(path, mode) {
    let flags = 0
    if mode == MODE_READ {
        flags = O_RDONLY
    }
    if mode == MODE_WRITE {
        flags = O_WRONLY + O_CREAT + O_TRUNC
    }
    if mode == MODE_APPEND {
        flags = O_WRONLY + O_CREAT + O_APPEND
    }

    let fd = sys_open(str_data(path), flags, 438)
    if fd < 0 {
        return 0
    }

    let f = alloc(FILE_SIZE)
    store64(f + FILE_FD, fd)
    store64(f + FILE_MODE, mode)
    store64(f + FILE_RPOS, 0)
    store64(f + FILE_RLEN, 0)
    store64(f + FILE_WPOS, 0)

    if mode == MODE_READ {
        let rbuf = alloc(IO_BUF_SIZE)
        store64(f + FILE_RBUF, rbuf)
        store64(f + FILE_WBUF, 0)
    } else {
        let wbuf = alloc(IO_BUF_SIZE)
        store64(f + FILE_WBUF, wbuf)
        store64(f + FILE_RBUF, 0)
    }

    return f
}

fn file_close(f) {
    if f == 0 { return }
    let mode = load64(f + FILE_MODE)
    if mode != MODE_READ {
        file_flush(f)
    }
    let fd = load64(f + FILE_FD)
    sys_close(fd)
}

fn file_read_byte(f) {
    let pos = load64(f + FILE_RPOS)
    let rlen = load64(f + FILE_RLEN)
    if pos >= rlen {
        let fd = load64(f + FILE_FD)
        let rbuf = load64(f + FILE_RBUF)
        let n = sys_read(fd, rbuf, IO_BUF_SIZE)
        if n <= 0 {
            return -1
        }
        store64(f + FILE_RLEN, n)
        store64(f + FILE_RPOS, 0)
        pos = 0
    }
    let rbuf = load64(f + FILE_RBUF)
    let byte = load8(rbuf + pos)
    store64(f + FILE_RPOS, pos + 1)
    return byte
}

fn file_read(f, count) {
    let buf = alloc(count)
    let i = 0
    while i < count {
        let b = file_read_byte(f)
        if b < 0 {
            return str_new(buf, i)
        }
        store8(buf + i, b)
        i = i + 1
    }
    return str_new(buf, count)
}

fn file_read_line(f) {
    let buf = alloc(1024)
    let cap = 1024
    let i = 0
    while 1 {
        let b = file_read_byte(f)
        if b < 0 {
            if i == 0 { return 0 }
            return str_new(buf, i)
        }
        if b == 10 {
            return str_new(buf, i)
        }
        if i >= cap {
            cap = cap * 2
            let new_buf = alloc(cap)
            memcpy_raw(new_buf, buf, i)
            buf = new_buf
        }
        store8(buf + i, b)
        i = i + 1
    }
}

fn file_read_all(f) {
    let buf = alloc(4096)
    let cap = 4096
    let total = 0
    while 1 {
        let b = file_read_byte(f)
        if b < 0 {
            return str_new(buf, total)
        }
        if total >= cap {
            cap = cap * 2
            let new_buf = alloc(cap)
            memcpy_raw(new_buf, buf, total)
            buf = new_buf
        }
        store8(buf + total, b)
        total = total + 1
    }
}

fn file_write_byte(f, byte) {
    let pos = load64(f + FILE_WPOS)
    let wbuf = load64(f + FILE_WBUF)
    store8(wbuf + pos, byte)
    pos = pos + 1
    store64(f + FILE_WPOS, pos)
    if pos >= IO_BUF_SIZE {
        file_flush(f)
    }
}

fn file_write(f, s) {
    let length = str_len(s)
    let i = 0
    while i < length {
        file_write_byte(f, load8(str_data(s) + i))
        i = i + 1
    }
}

fn file_write_line(f, s) {
    file_write(f, s)
    file_write_byte(f, 10)
}

fn file_flush(f) {
    let pos = load64(f + FILE_WPOS)
    if pos > 0 {
        let fd = load64(f + FILE_FD)
        let wbuf = load64(f + FILE_WBUF)
        sys_write(fd, wbuf, pos)
        store64(f + FILE_WPOS, 0)
    }
}

fn io_read_file(path) {
    let f = file_open(path, MODE_READ)
    if f == 0 { return 0 }
    let content = file_read_all(f)
    file_close(f)
    return content
}

fn io_write_file(path, content) {
    let f = file_open(path, MODE_WRITE)
    if f == 0 { return 0 }
    file_write(f, content)
    file_close(f)
    return 1
}

// Delegate stdout to the `print`/`println` builtins (codegen emits
// NUL-scan + raw syscall write). The old body passed `str_len(s)` —
// which returns tagged `(len<<1)|1` — into sys_write's rdx, so the
// kernel wrote ~2*len+1 bytes starting at the raw literal address and
// overran the rodata page (SEGV on anything over ~128 bytes). See
// Crossengin docs/UPSTREAM_NOVA_BUGS.md §5.
fn io_print(s) { print(s) }
fn io_println(s) { println(s) }

// No `eprintln` builtin exists, so emit the stderr write(2) syscall
// inline. We can't delegate to the sys_write wrapper because it
// never untags its register inputs, and three of the involved values
// are tagged in NOVA:
//   - the STDERR global is stored as 5 (tagged int 2);
//   - `str_len` returns tagged `(len<<1)|1` — this is the overrun
//     that triggered the SEGV on the stdout path (NOVA Bug #5);
//   - the integer literal `1` for the newline count is tagged 3.
// Frame layout for io_eprint(s): params are pushed into cg_locals
// before body-locals (codegen.nova:6890-6895), so s=[rbp-8],
// data=[rbp-16], n=[rbp-24]. See Crossengin
// docs/UPSTREAM_NOVA_BUGS.md §5.
fn io_eprint(s) {
    let data = str_data(s)
    let n = str_len(s)
    asm {
        "mov rsi, [rbp - 16]"
        "test rsi, 1"
        "jz 1f"
        "sar rsi, 1"
        "1:"
        "mov rdx, [rbp - 24]"
        "test rdx, 1"
        "jz 2f"
        "sar rdx, 1"
        "2:"
        "mov rax, 1"
        "mov rdi, 2"
        "syscall"
    }
}

fn io_eprintln(s) {
    io_eprint(s)
    // write(STDERR_FILENO, "\n", 1) via inline asm. Stage the newline
    // byte on the stack so no .rodata symbol is needed.
    asm {
        "mov rax, 10"
        "push rax"
        "mov rax, 1"
        "mov rdi, 2"
        "mov rsi, rsp"
        "mov rdx, 1"
        "syscall"
        "pop rax"
    }
}

fn io_input() {
    let buf = alloc(1024)
    let n = sys_read(STDIN, buf, 1024)
    if n <= 0 {
        return str_new(0, 0)
    }
    if n > 0 {
        if load8(buf + n - 1) == 10 {
            n = n - 1
        }
    }
    return str_new(buf, n)
}

// Monotonic nanosecond clock via clock_gettime(CLOCK_MONOTONIC, &ts)
// timespec layout: [int64 tv_sec, int64 tv_nsec] (16 bytes)
fn _sys_clock_gettime_monotonic(ts) {
    asm {
        "mov rax, 228"
        "mov rdi, 1"
        "mov rsi, [rbp-8]"
        "syscall"
    }
}

// Raw integer multiply-add (bypasses _nova_mul / _nova_add pointer-threshold
// dispatch so we can compose values above 0x100000 without triggering
// str_repeat / str_concat). Computes a * b + c.
fn _raw_imul_add(a, b, c) {
    asm {
        "mov rax, [rbp-8]"
        "imul rax, [rbp-16]"
        "add rax, [rbp-24]"
    }
}

fn nanotime() {
    let ts = alloc(16)
    _sys_clock_gettime_monotonic(ts)
    let sec = load64(ts)
    let nsec = load64(ts + 8)
    let r = _raw_imul_add(sec, 1000000000, nsec)
    // _raw_imul_add returns a RAW rax (its asm block bypasses the
    // tagging-return convention so sec*1e9+nsec can exceed the pointer
    // threshold without dispatching to str_repeat). Tag it here before
    // the implicit return hands rax back to the caller. See Crossengin
    // docs/UPSTREAM_NOVA_BUGS.md §7. Slot layout: ts=-8, sec=-16,
    // nsec=-24, r=-32 (linear local assignment, mirrors
    // ffi_syscall.nova:ffi_syscall_call2).
    asm {
        "mov rax, [rbp - 32]"
        "lea rax, [rax + rax + 1]"
    }
}
