// Nova Standard Library: File Path Utilities

fn path_join(a, b) {
    if len(a) == 0 { return b }
    if len(b) == 0 { return a }
    let last = char_at(a, len(a) - 1)
    if last == 47 {
        return a + b
    }
    return a + "/" + b
}

fn path_basename(fpath) {
    let last_slash = 0 - 1
    let i = 0
    while i < len(fpath) {
        if char_at(fpath, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return fpath
    }
    return substr(fpath, last_slash + 1, len(fpath) - last_slash - 1)
}

fn path_dirname(fpath) {
    let last_slash = 0 - 1
    let i = 0
    while i < len(fpath) {
        if char_at(fpath, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    if last_slash == 0 {
        return "/"
    }
    return substr(fpath, 0, last_slash)
}

fn path_extension(fpath) {
    let base = path_basename(fpath)
    let last_dot = 0 - 1
    let i = 0
    while i < len(base) {
        if char_at(base, i) == 46 {
            last_dot = i
        }
        i = i + 1
    }
    if last_dot < 0 {
        return ""
    }
    if last_dot == 0 {
        return ""
    }
    return substr(base, last_dot, len(base) - last_dot)
}

fn path_stem(fpath) {
    let base = path_basename(fpath)
    let last_dot = 0 - 1
    let i = 0
    while i < len(base) {
        if char_at(base, i) == 46 {
            last_dot = i
        }
        i = i + 1
    }
    if last_dot <= 0 {
        return base
    }
    return substr(base, 0, last_dot)
}

fn path_is_absolute(fpath) {
    if len(fpath) == 0 { return 0 }
    if char_at(fpath, 0) == 47 { return 1 }
    return 0
}

fn path_normalize(fpath) {
    let parts = split(fpath, "/")
    let result = list_new()
    let i = 0
    while i < len(parts) {
        let p = parts[i]
        if p == "." {
            // skip
        } else {
            if p == ".." {
                if len(result) > 0 {
                    pop(result)
                }
            } else {
                if len(p) > 0 {
                    push(result, p)
                }
            }
        }
        i = i + 1
    }
    let joined = join(result, "/")
    if path_is_absolute(fpath) == 1 {
        return "/" + joined
    }
    if len(joined) == 0 { return "." }
    return joined
}

fn path_change_ext(fpath, new_ext) {
    let dir = path_dirname(fpath)
    let stem = path_stem(fpath)
    if dir == "." {
        return stem + new_ext
    }
    return dir + "/" + stem + new_ext
}
