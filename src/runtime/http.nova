let HTTP_TAG = 340
let HTTP_SOCK = 1
let HTTP_HOST = 2
let HTTP_PORT = 3
let HTTP_CONNECTED = 4
let HTTP_RESPONSE = 5
let HTTP_STATUS = 6
let HTTP_HEADERS = 7

let _http_whitelist = 0
let _http_whitelist_count = 0
let _http_rate_limits = 0
let _http_rate_counts = 0
let _http_rate_timestamps = 0
let _http_rate_max = 10
let _http_rate_window = 60

fn http_init() {
    _http_whitelist = list_new()
    _http_whitelist_count = 0
    _http_rate_limits = list_new()
    _http_rate_counts = list_new()
    _http_rate_timestamps = list_new()
    return 1
}

fn http_whitelist_add(domain) {
    push(_http_whitelist, domain)
    _http_whitelist_count = _http_whitelist_count + 1
    return 1
}

fn http_whitelist_check(domain) {
    if _http_whitelist_count == 0 { return 1 }
    let i = 0
    while i < _http_whitelist_count {
        if _http_whitelist[i] == domain { return 1 }
        i = i + 1
    }
    return 0
}

fn http_rate_check(domain) {
    let i = 0
    let count = len(_http_rate_limits)
    while i < count {
        if _http_rate_limits[i] == domain {
            let c = _http_rate_counts[i]
            if c >= _http_rate_max { return 0 }
            _http_rate_counts[i] = c + 1
            return 1
        }
        i = i + 1
    }
    push(_http_rate_limits, domain)
    push(_http_rate_counts, 1)
    push(_http_rate_timestamps, 0)
    return 1
}

fn http_rate_reset(domain) {
    let i = 0
    let count = len(_http_rate_limits)
    while i < count {
        if _http_rate_limits[i] == domain {
            _http_rate_counts[i] = 0
            _http_rate_timestamps[i] = 0
            return 1
        }
        i = i + 1
    }
    return 0
}

fn http_connect(host_ip, port) {
    let fd = sys_socket(AF_INET, SOCK_STREAM, 0)
    if fd < 0 { return 0 }
    let ip_int = ip_to_int(host_ip)
    let addr = make_sockaddr_in_raw(port, ip_int)
    let rc = sys_connect(fd, addr, 16)
    if rc < 0 {
        sys_close(fd)
        return 0
    }
    let conn = list_new()
    push(conn, HTTP_TAG)
    push(conn, fd)
    push(conn, host_ip)
    push(conn, port)
    push(conn, 1)
    push(conn, "")
    push(conn, 0)
    push(conn, list_new())
    return conn
}

fn http_close(conn) {
    if conn == 0 { return 0 }
    let fd = conn[HTTP_SOCK]
    sys_close(fd)
    conn[HTTP_CONNECTED] = 0
    return 1
}

fn _http_str_to_buf(s) {
    let slen = len(s)
    let buf = alloc(slen)
    let i = 0
    while i < slen {
        store8(int_add(buf, i), char_code(substr(s, i, 1)))
        i = i + 1
    }
    return buf
}

fn _http_buf_to_str(buf, blen) {
    let s = ""
    let i = 0
    while i < blen {
        let b = load8(int_add(buf, i))
        s = s + chr(b)
        i = i + 1
    }
    return s
}

fn http_build_request(method, path, host, headers, body) {
    let crlf = chr(13) + chr(10)
    let req = method + " " + path + " HTTP/1.1" + crlf
    req = req + "Host: " + host + crlf
    if headers != 0 {
        let i = 0
        let hcount = len(headers)
        while i < hcount {
            let pair = headers[i]
            req = req + pair[0] + ": " + pair[1] + crlf
            i = i + 1
        }
    }
    if body != "" {
        if len(body) > 0 {
            req = req + "Content-Length: " + int_to_str(len(body)) + crlf
        }
    }
    req = req + "Connection: close" + crlf
    req = req + crlf
    if body != "" {
        if len(body) > 0 {
            req = req + body
        }
    }
    return req
}

fn http_build_get(path, host) {
    let hdrs = list_new()
    let accept_pair = list_new()
    push(accept_pair, "Accept")
    push(accept_pair, "*/*")
    push(hdrs, accept_pair)
    let ua_pair = list_new()
    push(ua_pair, "User-Agent")
    push(ua_pair, "Nova/1.0")
    push(hdrs, ua_pair)
    return http_build_request("GET", path, host, hdrs, "")
}

fn http_build_post(path, host, body, content_type) {
    let hdrs = list_new()
    let ct_pair = list_new()
    push(ct_pair, "Content-Type")
    push(ct_pair, content_type)
    push(hdrs, ct_pair)
    let accept_pair = list_new()
    push(accept_pair, "Accept")
    push(accept_pair, "*/*")
    push(hdrs, accept_pair)
    let ua_pair = list_new()
    push(ua_pair, "User-Agent")
    push(ua_pair, "Nova/1.0")
    push(hdrs, ua_pair)
    return http_build_request("POST", path, host, hdrs, body)
}

fn http_send_request(conn, request_str) {
    if conn == 0 { return -1 }
    if conn[HTTP_CONNECTED] != 1 { return -1 }
    let fd = conn[HTTP_SOCK]
    let buf = _http_str_to_buf(request_str)
    let slen = len(request_str)
    let sent = sys_send(fd, buf, slen, 0)
    return sent
}

fn http_recv_response(conn, max_bytes) {
    if conn == 0 { return "" }
    if conn[HTTP_CONNECTED] != 1 { return "" }
    let fd = conn[HTTP_SOCK]
    let buf = alloc(max_bytes)
    let total = 0
    let done = 0
    while done == 0 {
        let remaining = max_bytes - total
        if remaining <= 0 {
            done = 1
        } else {
            let n = sys_recv(fd, int_add(buf, total), remaining, 0)
            if n <= 0 {
                done = 1
            } else {
                total = total + n
            }
        }
    }
    let response = _http_buf_to_str(buf, total)
    conn[HTTP_RESPONSE] = response
    return response
}

fn http_request(conn, method, path, host, body) {
    let req = http_build_request(method, path, host, 0, body)
    let sent = http_send_request(conn, req)
    if sent < 0 { return "" }
    let resp = http_recv_response(conn, 65536)
    return resp
}

fn http_parse_status(response) {
    let slen = len(response)
    if slen < 12 { return 0 }
    let i = 0
    let space_count = 0
    let status_start = 0
    while i < slen {
        let ch = substr(response, i, 1)
        if ch == " " {
            space_count = space_count + 1
            if space_count == 1 {
                status_start = i + 1
            }
            if space_count == 2 {
                let status_str = substr(response, status_start, i - status_start)
                let code = 0
                let j = 0
                let sslen = len(status_str)
                while j < sslen {
                    let d = char_code(substr(status_str, j, 1)) - 48
                    code = code * 10 + d
                    j = j + 1
                }
                return code
            }
        }
        let cc = char_code(ch)
        if cc == 13 { return 0 }
        if cc == 10 { return 0 }
        i = i + 1
    }
    return 0
}

fn _http_find_header_end(response) {
    let slen = len(response)
    let i = 0
    while i < slen - 3 {
        if char_code(substr(response, i, 1)) == 13 {
            if char_code(substr(response, i + 1, 1)) == 10 {
                if char_code(substr(response, i + 2, 1)) == 13 {
                    if char_code(substr(response, i + 3, 1)) == 10 {
                        return i
                    }
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn _http_find_first_line_end(response) {
    let slen = len(response)
    let i = 0
    while i < slen - 1 {
        if char_code(substr(response, i, 1)) == 13 {
            if char_code(substr(response, i + 1, 1)) == 10 {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn http_parse_headers(response) {
    let headers = list_new()
    let first_end = _http_find_first_line_end(response)
    if first_end < 0 { return headers }
    let hdr_end = _http_find_header_end(response)
    if hdr_end < 0 { hdr_end = len(response) }
    let pos = first_end + 2
    while pos < hdr_end {
        let line_end = pos
        let slen = len(response)
        let found_end = 0
        while line_end < slen - 1 {
            if char_code(substr(response, line_end, 1)) == 13 {
                if char_code(substr(response, line_end + 1, 1)) == 10 {
                    found_end = 1
                    let line = substr(response, pos, line_end - pos)
                    let colon_pos = -1
                    let ci = 0
                    let llen = len(line)
                    while ci < llen {
                        if substr(line, ci, 1) == ":" {
                            if colon_pos == -1 {
                                colon_pos = ci
                            }
                        }
                        ci = ci + 1
                    }
                    if colon_pos > 0 {
                        let key = substr(line, 0, colon_pos)
                        let val_start = colon_pos + 1
                        if val_start < llen {
                            if substr(line, val_start, 1) == " " {
                                val_start = val_start + 1
                            }
                        }
                        let val = substr(line, val_start, llen - val_start)
                        let pair = list_new()
                        push(pair, key)
                        push(pair, val)
                        push(headers, pair)
                    }
                    pos = line_end + 2
                    line_end = slen
                }
            }
            line_end = line_end + 1
        }
        if found_end == 0 {
            pos = hdr_end
        }
    }
    return headers
}

fn http_parse_body(response) {
    let sep = _http_find_header_end(response)
    if sep < 0 { return "" }
    let body_start = sep + 4
    let slen = len(response)
    if body_start >= slen { return "" }
    return substr(response, body_start, slen - body_start)
}

fn http_get_header(headers, name) {
    let i = 0
    let count = len(headers)
    while i < count {
        let pair = headers[i]
        if pair[0] == name { return pair[1] }
        i = i + 1
    }
    return ""
}

fn http_content_type(headers) {
    return http_get_header(headers, "Content-Type")
}

fn _http_str_contains(haystack, needle) {
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen == 0 { return 1 }
    if nlen > hlen { return 0 }
    let limit = hlen - nlen
    let i = 0
    while i <= limit {
        let matched = 1
        let j = 0
        while j < nlen {
            if substr(haystack, i + j, 1) != substr(needle, j, 1) {
                matched = 0
                j = nlen
            } else {
                j = j + 1
            }
        }
        if matched == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn http_is_json(headers) {
    let ct = http_content_type(headers)
    return _http_str_contains(ct, "json")
}

fn http_is_html(headers) {
    let ct = http_content_type(headers)
    return _http_str_contains(ct, "html")
}

fn http_is_text(headers) {
    let ct = http_content_type(headers)
    return _http_str_contains(ct, "text")
}

fn http_get(host_ip, port, path, host_header) {
    if http_whitelist_check(host_header) == 0 { return 0 }
    if http_rate_check(host_header) == 0 { return 0 }
    let conn = http_connect(host_ip, port)
    if conn == 0 { return 0 }
    let req = http_build_get(path, host_header)
    let sent = http_send_request(conn, req)
    if sent < 0 {
        http_close(conn)
        return 0
    }
    let resp = http_recv_response(conn, 65536)
    http_close(conn)
    if len(resp) == 0 { return 0 }
    let status = http_parse_status(resp)
    let headers = http_parse_headers(resp)
    let body = http_parse_body(resp)
    let result = list_new()
    push(result, status)
    push(result, headers)
    push(result, body)
    return result
}

fn http_post(host_ip, port, path, host_header, body, content_type) {
    if http_whitelist_check(host_header) == 0 { return 0 }
    if http_rate_check(host_header) == 0 { return 0 }
    let conn = http_connect(host_ip, port)
    if conn == 0 { return 0 }
    let req = http_build_post(path, host_header, body, content_type)
    let sent = http_send_request(conn, req)
    if sent < 0 {
        http_close(conn)
        return 0
    }
    let resp = http_recv_response(conn, 65536)
    http_close(conn)
    if len(resp) == 0 { return 0 }
    let status = http_parse_status(resp)
    let headers = http_parse_headers(resp)
    let rbody = http_parse_body(resp)
    let result = list_new()
    push(result, status)
    push(result, headers)
    push(result, rbody)
    return result
}
