// Nova Runtime: Secure Memory
// Allocation with zeroing, secure deallocation, and bounded buffers.
// Uses heap allocator (alloc) for memory regions.

// ================================================================
// Secure Allocation (heap-based, zeroed)
// ================================================================

fn secure_alloc(size) {
    let ptr = alloc(size)
    if ptr == 0 { return 0 }
    let i = 0
    while i < size {
        store8(int_add(ptr, i), 0)
        i = i + 1
    }
    return ptr
}

fn secure_free(ptr, size) {
    let i = 0
    while i < size {
        store8(int_add(ptr, i), 0)
        i = i + 1
    }
}

fn secure_zero(ptr, size) {
    let i = 0
    while i < size {
        store8(int_add(ptr, i), 0)
        i = i + 1
    }
}

fn secure_copy(dst, src, size) {
    memcpy_raw(dst, src, size)
}

fn secure_compare(ptr1, ptr2, size) {
    let diff = 0
    let i = 0
    while i < size {
        diff = diff | (load8(int_add(ptr1, i)) ^ load8(int_add(ptr2, i)))
        i = i + 1
    }
    if diff == 0 { return 1 }
    return 0
}

// ================================================================
// Bounded Buffer (prevents overflow)
// ================================================================

let SBUF_TAG = 285
let SBUF_PTR = 1
let SBUF_SIZE = 2
let SBUF_USED = 3

fn sbuf_new(max_size) {
    let ptr = secure_alloc(max_size)
    if ptr == 0 { return 0 }
    let b = list_new()
    push(b, SBUF_TAG)
    push(b, ptr)
    push(b, max_size)
    push(b, 0)
    return b
}

fn sbuf_write(buf, byte) {
    if buf[SBUF_USED] >= buf[SBUF_SIZE] { return 0 }
    store8(int_add(buf[SBUF_PTR], buf[SBUF_USED]), byte)
    buf[SBUF_USED] = buf[SBUF_USED] + 1
    return 1
}

fn sbuf_write_str(buf, s) {
    let i = 0
    while i < len(s) {
        if sbuf_write(buf, char_at(s, i)) == 0 { return i }
        i = i + 1
    }
    return i
}

fn sbuf_read(buf, idx) {
    if idx >= buf[SBUF_USED] { return -1 }
    return load8(int_add(buf[SBUF_PTR], idx))
}

fn sbuf_used(buf) {
    return buf[SBUF_USED]
}

fn sbuf_remaining(buf) {
    return buf[SBUF_SIZE] - buf[SBUF_USED]
}

fn sbuf_clear(buf) {
    secure_zero(buf[SBUF_PTR], buf[SBUF_SIZE])
    buf[SBUF_USED] = 0
}

fn sbuf_free(buf) {
    secure_free(buf[SBUF_PTR], buf[SBUF_SIZE])
    buf[SBUF_PTR] = 0
    buf[SBUF_USED] = 0
}

fn sbuf_to_str(buf) {
    let result = ""
    let i = 0
    while i < buf[SBUF_USED] {
        let ch = load8(int_add(buf[SBUF_PTR], i))
        result = result + chr(ch)
        i = i + 1
    }
    return result
}

// ================================================================
// Secure Token Generation (simple PRNG-based)
// ================================================================

let _sec_seed = 0
let _sec_seeded = 0

fn secure_seed(s) {
    _sec_seed = s
}

fn _sec_auto_seed() {
    if _sec_seeded == 0 {
        _sec_seed = global_time ^ 48271
        _sec_seeded = 1
    }
}

fn _sec_next() {
    _sec_auto_seed()
    _sec_seed = int_add(int_mul(_sec_seed, 1103515245), 12345) & 2147483647
    return _sec_seed
}

fn secure_random_int(lo, hi) {
    let range = hi - lo + 1
    if range <= 0 { return lo }
    let r = _sec_next() % range
    return lo + r
}

fn secure_token(length) {
    let chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    let result = ""
    let i = 0
    while i < length {
        let idx = secure_random_int(0, 35)
        result = result + substr(chars, idx, 1)
        i = i + 1
    }
    return result
}
