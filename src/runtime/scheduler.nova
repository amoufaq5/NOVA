// Nova Runtime: Signal Scheduler
// Dispatches signals to nodes by priority, manages processing cycles.
// Uses standard Nova lists and the signal priority queue from signal.nova.
// Integrates with node_receive/node_process/node_drain_outbox for dispatch.
// Cycle detection: signals that have already visited their destination are dropped.
// Channel routing: outputs can be routed via channel network to next-hop nodes.
// Signal batching: groups signals by destination for cache-friendly dispatch.

// Scheduler state (module-level globals)
let sched_queue = 0
let sched_nodes = 0
let sched_channels = 0
let sched_cycle = 0
let sched_running = 0
let sched_processed = 0
let sched_dropped = 0
let sched_max_per_cycle = 10000
let sched_batched = 0
let sched_soul = 0

// ================================================================
// Initialization
// ================================================================

fn scheduler_init() {
    sched_queue = signal_queue_new()
    sched_nodes = list_new()
    sched_channels = list_new()
    sched_cycle = 0
    sched_running = 0
    sched_processed = 0
    sched_dropped = 0
    sched_batched = 0
    sched_soul = 0
}

fn scheduler_register_soul(s) {
    sched_soul = s
}

fn scheduler_get_soul() {
    return sched_soul
}

fn scheduler_ensure_init() {
    if sched_nodes == 0 {
        scheduler_init()
    }
}

// ================================================================
// Node registry
// ================================================================

fn scheduler_register(node) {
    push(sched_nodes, node)
}

fn scheduler_find_node(name) {
    let i = 0
    while i < len(sched_nodes) {
        if node_name(sched_nodes[i]) == name {
            return sched_nodes[i]
        }
        i = i + 1
    }
    return 0
}

fn scheduler_node_count() {
    return len(sched_nodes)
}

// ================================================================
// Channel integration
// ================================================================

fn scheduler_add_channel(ch) {
    push(sched_channels, ch)
}

fn scheduler_route_output(source_name, sig) {
    let routed = 0
    let i = 0
    while i < len(sched_channels) {
        let ch = sched_channels[i]
        if channel_source(ch) == source_name {
            let dests = channel_dests(ch)
            let j = 0
            while j < len(dests) {
                let dest_node = dests[j]
                let redirected = signal_redirect(sig, node_name(dest_node))
                signal_queue_push(sched_queue, redirected)
                routed = routed + 1
                j = j + 1
            }
        }
        i = i + 1
    }
    if routed == 0 {
        signal_queue_push(sched_queue, sig)
    }
    return routed
}

// ================================================================
// Signal submission
// ================================================================

fn scheduler_emit(signal) {
    signal_queue_push(sched_queue, signal)
}

fn scheduler_broadcast(signal) {
    let i = 0
    while i < len(sched_nodes) {
        let dest_name = node_name(sched_nodes[i])
        let redirected = signal_redirect(signal, dest_name)
        signal_queue_push(sched_queue, redirected)
        i = i + 1
    }
}

// ================================================================
// Dispatch
// ================================================================

fn scheduler_dispatch_one() {
    let sig = signal_queue_pop(sched_queue)
    if sig == 0 { return 0 }

    let dest_name = signal_dest(sig)
    let dest_node = scheduler_find_node(dest_name)

    if dest_node == 0 {
        sched_dropped = sched_dropped + 1
        sched_processed = sched_processed + 1
        return 1
    }

    if signal_has_visited(sig, dest_name) == 1 {
        sched_dropped = sched_dropped + 1
        sched_processed = sched_processed + 1
        return 1
    }

    node_receive(dest_node, sig)
    node_process(dest_node)

    let outputs = node_drain_outbox(dest_node)
    let i = 0
    while i < len(outputs) {
        scheduler_route_output(node_name(dest_node), outputs[i])
        i = i + 1
    }

    if sched_soul != 0 {
        soul_tick(sched_soul, sig)
        let soul_signals = soul_check_drives(sched_soul)
        let si = 0
        while si < len(soul_signals) {
            signal_queue_push(sched_queue, soul_signals[si])
            si = si + 1
        }
    }

    sched_processed = sched_processed + 1
    return 1
}

// ================================================================
// Signal batching
// ================================================================

fn scheduler_collect_batch(dest_name) {
    let batch = list_new()
    let remaining = list_new()
    let qlen = len(sched_queue)
    let i = 0
    while i < qlen {
        let sig = signal_queue_pop(sched_queue)
        if sig == 0 {
            i = qlen
        } else {
            if signal_dest(sig) == dest_name {
                push(batch, sig)
            } else {
                push(remaining, sig)
            }
            i = i + 1
        }
    }
    let ri = 0
    while ri < len(remaining) {
        signal_queue_push(sched_queue, remaining[ri])
        ri = ri + 1
    }
    return batch
}

fn scheduler_dispatch_batch(dest_name) {
    let dest_node = scheduler_find_node(dest_name)
    if dest_node == 0 {
        return 0
    }

    let batch = scheduler_collect_batch(dest_name)
    let count = 0
    let bi = 0
    while bi < len(batch) {
        let sig = batch[bi]

        if signal_has_visited(sig, dest_name) == 1 {
            sched_dropped = sched_dropped + 1
            sched_processed = sched_processed + 1
        } else {
            node_receive(dest_node, sig)
            count = count + 1
        }
        bi = bi + 1
    }

    if count > 0 {
        node_process(dest_node)
        let outputs = node_drain_outbox(dest_node)
        let oi = 0
        while oi < len(outputs) {
            scheduler_route_output(node_name(dest_node), outputs[oi])
            oi = oi + 1
        }
    }

    sched_processed = sched_processed + count
    sched_batched = sched_batched + count
    return count
}

fn scheduler_run_batched_cycle() {
    sched_cycle = sched_cycle + 1
    let count = 0
    while len(sched_queue) > 0 {
        let sig = signal_queue_pop(sched_queue)
        if sig == 0 { return count }

        let dest_name = signal_dest(sig)
        signal_queue_push(sched_queue, sig)
        count = count + scheduler_dispatch_batch(dest_name)

        if count >= sched_max_per_cycle {
            println("WARNING: cycle signal limit reached")
            return count
        }
    }
    return count
}

// ================================================================
// Cycle execution
// ================================================================

fn scheduler_run_cycle() {
    sched_cycle = sched_cycle + 1
    let count = 0
    while len(sched_queue) > 0 {
        scheduler_dispatch_one()
        count = count + 1
        if count >= sched_max_per_cycle {
            println("WARNING: cycle signal limit reached")
            return count
        }
    }
    return count
}

// ================================================================
// Main loop
// ================================================================

fn scheduler_run() {
    sched_running = 1
    while sched_running == 1 {
        if len(sched_queue) == 0 {
            sched_running = 0
        } else {
            scheduler_run_cycle()
        }
    }
}

fn scheduler_run_batched() {
    sched_running = 1
    while sched_running == 1 {
        if len(sched_queue) == 0 {
            sched_running = 0
        } else {
            scheduler_run_batched_cycle()
        }
    }
}

fn scheduler_stop() {
    sched_running = 0
}

// ================================================================
// Queries
// ================================================================

fn scheduler_queue_size() {
    return len(sched_queue)
}

fn scheduler_cycle_count() {
    return sched_cycle
}

fn scheduler_total_processed() {
    return sched_processed
}

fn scheduler_total_dropped() {
    return sched_dropped
}

fn scheduler_total_batched() {
    return sched_batched
}

fn scheduler_status() {
    print("Cycle: ")
    print_int(sched_cycle)
    println("")
    print("Queued signals: ")
    print_int(len(sched_queue))
    println("")
    print("Registered nodes: ")
    print_int(len(sched_nodes))
    println("")
    print("Total processed: ")
    print_int(sched_processed)
    println("")
    print("Total dropped: ")
    print_int(sched_dropped)
    println("")
    print("Total batched: ")
    print_int(sched_batched)
    println("")
}
