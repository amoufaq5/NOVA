// Nova Standard Library: SIMD Vector Operations
// CPU-based vectorized math using SSE2/AVX instructions.
// Falls back gracefully on all x86-64 processors (SSE2 is mandatory).
//
// All functions operate on arrays of IEEE 754 doubles stored in memory.
// Use alloc(n * 8) to create float arrays, mem_write_f64/mem_read_f64 to access.

fn simd_vec_new(count) {
    return alloc(count * 8)
}

fn simd_vec_set(vec, idx, val) {
    mem_write_f64(int_add(vec, idx * 8), val)
}

fn simd_vec_get(vec, idx) {
    return mem_read_f64(int_add(vec, idx * 8))
}

fn simd_add_f64(a_ptr, b_ptr, c_ptr, n) {
    // Process 2 doubles at a time with SSE2 (addpd)
    let pairs = n / 2
    let remainder = n % 2
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rsi, [rbp - 16]"
        "sar rsi, 1"
        "mov rdx, [rbp - 24]"
        "sar rdx, 1"
        "mov rcx, [rbp - 32]"
        "sar rcx, 1"
        "shr rcx, 1"
        ".simd_add_loop:"
        "test rcx, rcx"
        "jz .simd_add_tail"
        "movupd xmm0, [rdi]"
        "movupd xmm1, [rsi]"
        "addpd xmm0, xmm1"
        "movupd [rdx], xmm0"
        "add rdi, 16"
        "add rsi, 16"
        "add rdx, 16"
        "dec rcx"
        "jmp .simd_add_loop"
        ".simd_add_tail:"
    }
    // Handle remaining element
    if remainder == 1 {
        let last_idx = n - 1
        let a_val = mem_read_f64(int_add(a_ptr, last_idx * 8))
        let b_val = mem_read_f64(int_add(b_ptr, last_idx * 8))
        mem_write_f64(int_add(c_ptr, last_idx * 8), float_add(a_val, b_val))
    }
}

fn simd_mul_f64(a_ptr, b_ptr, c_ptr, n) {
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rsi, [rbp - 16]"
        "sar rsi, 1"
        "mov rdx, [rbp - 24]"
        "sar rdx, 1"
        "mov rcx, [rbp - 32]"
        "sar rcx, 1"
        "shr rcx, 1"
        ".simd_mul_loop:"
        "test rcx, rcx"
        "jz .simd_mul_tail"
        "movupd xmm0, [rdi]"
        "movupd xmm1, [rsi]"
        "mulpd xmm0, xmm1"
        "movupd [rdx], xmm0"
        "add rdi, 16"
        "add rsi, 16"
        "add rdx, 16"
        "dec rcx"
        "jmp .simd_mul_loop"
        ".simd_mul_tail:"
    }
    let remainder = n % 2
    if remainder == 1 {
        let last_idx = n - 1
        let a_val = mem_read_f64(int_add(a_ptr, last_idx * 8))
        let b_val = mem_read_f64(int_add(b_ptr, last_idx * 8))
        mem_write_f64(int_add(c_ptr, last_idx * 8), float_mul(a_val, b_val))
    }
}

fn simd_sub_f64(a_ptr, b_ptr, c_ptr, n) {
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rsi, [rbp - 16]"
        "sar rsi, 1"
        "mov rdx, [rbp - 24]"
        "sar rdx, 1"
        "mov rcx, [rbp - 32]"
        "sar rcx, 1"
        "shr rcx, 1"
        ".simd_sub_loop:"
        "test rcx, rcx"
        "jz .simd_sub_tail"
        "movupd xmm0, [rdi]"
        "movupd xmm1, [rsi]"
        "subpd xmm0, xmm1"
        "movupd [rdx], xmm0"
        "add rdi, 16"
        "add rsi, 16"
        "add rdx, 16"
        "dec rcx"
        "jmp .simd_sub_loop"
        ".simd_sub_tail:"
    }
    let remainder = n % 2
    if remainder == 1 {
        let last_idx = n - 1
        let a_val = mem_read_f64(int_add(a_ptr, last_idx * 8))
        let b_val = mem_read_f64(int_add(b_ptr, last_idx * 8))
        mem_write_f64(int_add(c_ptr, last_idx * 8), float_sub(a_val, b_val))
    }
}

fn simd_dot_f64(a_ptr, b_ptr, n) {
    let result = to_float(0)
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rsi, [rbp - 16]"
        "sar rsi, 1"
        "mov rcx, [rbp - 24]"
        "sar rcx, 1"
        "xorpd xmm0, xmm0"
        "xorpd xmm2, xmm2"
        "shr rcx, 2"
        ".simd_dot4_loop:"
        "test rcx, rcx"
        "jz .simd_dot4_done"
        "movupd xmm1, [rdi]"
        "movupd xmm4, [rsi]"
        "mulpd xmm1, xmm4"
        "movupd xmm3, [rdi+16]"
        "movupd xmm5, [rsi+16]"
        "mulpd xmm3, xmm5"
        "addpd xmm0, xmm1"
        "addpd xmm2, xmm3"
        "add rdi, 32"
        "add rsi, 32"
        "dec rcx"
        "jmp .simd_dot4_loop"
        ".simd_dot4_done:"
        "addpd xmm0, xmm2"
        "movapd xmm1, xmm0"
        "shufpd xmm1, xmm1, 1"
        "addsd xmm0, xmm1"
        "movq rax, xmm0"
        "mov [rbp - 32], rax"
    }
    let processed = (n / 4) * 4
    while processed < n {
        let a_val = mem_read_f64(int_add(a_ptr, processed * 8))
        let b_val = mem_read_f64(int_add(b_ptr, processed * 8))
        result = float_add(result, float_mul(a_val, b_val))
        processed = processed + 1
    }
    return result
}

fn simd_scale_f64(ptr, scalar, n) {
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "movq xmm1, [rbp - 16]"
        "unpcklpd xmm1, xmm1"
        "mov rcx, [rbp - 24]"
        "sar rcx, 1"
        "shr rcx, 1"
        ".simd_scale_loop:"
        "test rcx, rcx"
        "jz .simd_scale_tail"
        "movupd xmm0, [rdi]"
        "mulpd xmm0, xmm1"
        "movupd [rdi], xmm0"
        "add rdi, 16"
        "dec rcx"
        "jmp .simd_scale_loop"
        ".simd_scale_tail:"
    }
    let remainder = n % 2
    if remainder == 1 {
        let last_idx = n - 1
        let val = mem_read_f64(int_add(ptr, last_idx * 8))
        mem_write_f64(int_add(ptr, last_idx * 8), float_mul(val, scalar))
    }
}

fn simd_sum_f64(ptr, n) {
    let result = to_float(0)
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rcx, [rbp - 16]"
        "sar rcx, 1"
        "xorpd xmm0, xmm0"
        "shr rcx, 1"
        ".simd_sum2_loop:"
        "test rcx, rcx"
        "jz .simd_sum2_done"
        "movupd xmm1, [rdi]"
        "addpd xmm0, xmm1"
        "add rdi, 16"
        "dec rcx"
        "jmp .simd_sum2_loop"
        ".simd_sum2_done:"
        "movapd xmm1, xmm0"
        "shufpd xmm1, xmm1, 1"
        "addsd xmm0, xmm1"
        "movq rax, xmm0"
        "mov [rbp - 24], rax"
    }
    let remainder = n % 2
    if remainder == 1 {
        let last_idx = n - 1
        result = float_add(result, mem_read_f64(int_add(ptr, last_idx * 8)))
    }
    return result
}

fn simd_norm_f64(ptr, n) {
    let dot = simd_dot_f64(ptr, ptr, n)
    return fsqrt(dot)
}

fn simd_div_f64(a_ptr, b_ptr, c_ptr, n) {
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rsi, [rbp - 16]"
        "sar rsi, 1"
        "mov rdx, [rbp - 24]"
        "sar rdx, 1"
        "mov rcx, [rbp - 32]"
        "sar rcx, 1"
        "shr rcx, 1"
        ".simd_div_loop:"
        "test rcx, rcx"
        "jz .simd_div_tail"
        "movupd xmm0, [rdi]"
        "movupd xmm1, [rsi]"
        "divpd xmm0, xmm1"
        "movupd [rdx], xmm0"
        "add rdi, 16"
        "add rsi, 16"
        "add rdx, 16"
        "dec rcx"
        "jmp .simd_div_loop"
        ".simd_div_tail:"
    }
    let remainder = n % 2
    if remainder == 1 {
        let last_idx = n - 1
        let a_val = mem_read_f64(int_add(a_ptr, last_idx * 8))
        let b_val = mem_read_f64(int_add(b_ptr, last_idx * 8))
        mem_write_f64(int_add(c_ptr, last_idx * 8), float_div(a_val, b_val))
    }
}

fn simd_fma_f64(a_ptr, b_ptr, c_ptr, out_ptr, n) {
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rsi, [rbp - 16]"
        "sar rsi, 1"
        "mov rdx, [rbp - 24]"
        "sar rdx, 1"
        "mov rcx, [rbp - 32]"
        "sar rcx, 1"
        "mov r8, [rbp - 40]"
        "sar r8, 1"
        "shr r8, 1"
        ".simd_fma_loop:"
        "test r8, r8"
        "jz .simd_fma_tail"
        "movupd xmm0, [rdi]"
        "movupd xmm1, [rsi]"
        "mulpd xmm0, xmm1"
        "movupd xmm1, [rdx]"
        "addpd xmm0, xmm1"
        "movupd [rcx], xmm0"
        "add rdi, 16"
        "add rsi, 16"
        "add rdx, 16"
        "add rcx, 16"
        "dec r8"
        "jmp .simd_fma_loop"
        ".simd_fma_tail:"
    }
    let remainder = n % 2
    if remainder == 1 {
        let last_idx = n - 1
        let a_val = mem_read_f64(int_add(a_ptr, last_idx * 8))
        let b_val = mem_read_f64(int_add(b_ptr, last_idx * 8))
        let c_val = mem_read_f64(int_add(c_ptr, last_idx * 8))
        mem_write_f64(int_add(out_ptr, last_idx * 8), float_add(float_mul(a_val, b_val), c_val))
    }
}

fn simd_relu_f64(ptr, n) {
    let zero = to_float(0)
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rcx, [rbp - 16]"
        "sar rcx, 1"
        "shr rcx, 1"
        "pxor xmm1, xmm1"
        ".simd_relu_loop:"
        "test rcx, rcx"
        "jz .simd_relu_tail"
        "movupd xmm0, [rdi]"
        "maxpd xmm0, xmm1"
        "movupd [rdi], xmm0"
        "add rdi, 16"
        "dec rcx"
        "jmp .simd_relu_loop"
        ".simd_relu_tail:"
    }
    let remainder = n % 2
    if remainder == 1 {
        let last_idx = n - 1
        let val = mem_read_f64(int_add(ptr, last_idx * 8))
        if float_cmp(val, zero) < 0 {
            mem_write_f64(int_add(ptr, last_idx * 8), zero)
        }
    }
}

fn simd_max_f64(a_ptr, b_ptr, c_ptr, n) {
    asm {
        "mov rdi, [rbp - 8]"
        "sar rdi, 1"
        "mov rsi, [rbp - 16]"
        "sar rsi, 1"
        "mov rdx, [rbp - 24]"
        "sar rdx, 1"
        "mov rcx, [rbp - 32]"
        "sar rcx, 1"
        "shr rcx, 1"
        ".simd_max_loop:"
        "test rcx, rcx"
        "jz .simd_max_tail"
        "movupd xmm0, [rdi]"
        "movupd xmm1, [rsi]"
        "maxpd xmm0, xmm1"
        "movupd [rdx], xmm0"
        "add rdi, 16"
        "add rsi, 16"
        "add rdx, 16"
        "dec rcx"
        "jmp .simd_max_loop"
        ".simd_max_tail:"
    }
    let remainder = n % 2
    if remainder == 1 {
        let last_idx = n - 1
        let a_val = mem_read_f64(int_add(a_ptr, last_idx * 8))
        let b_val = mem_read_f64(int_add(b_ptr, last_idx * 8))
        if float_cmp(a_val, b_val) >= 0 {
            mem_write_f64(int_add(c_ptr, last_idx * 8), a_val)
        } else {
            mem_write_f64(int_add(c_ptr, last_idx * 8), b_val)
        }
    }
}
