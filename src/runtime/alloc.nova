// Nova Runtime: Memory Allocator
// Arena-based bump allocator for fast cycle allocation,
// plus a general-purpose allocator for persistent data.
// Pointers here are tagged NOVA values (sys_mmap / sys_brk return tagged
// pointers, like alloc()), so plain + / - is the right arithmetic and
// load64/store64 accept them directly.

// --- Arena Allocator (per-cycle, ultra-fast) ---
let arena_base = 0
let arena_ptr = 0
let arena_end = 0
let arena_size = 1048576

fn arena_init() {
    arena_base = sys_mmap(0, arena_size, 3, 34, -1, 0)
    if arena_base < 0 {
        arena_base = 0
        arena_ptr = 0
        arena_end = 0
        return 0
    }
    arena_ptr = arena_base
    arena_end = (arena_base + arena_size)
}

fn arena_alloc(size) {
    let aligned = (size + 7) & (~7)
    if (arena_ptr + aligned) > arena_end {
        let new_size = arena_size
        if aligned > new_size {
            new_size = aligned
        }
        let chunk = sys_mmap(0, new_size, 3, 34, -1, 0)
        if chunk < 0 { return 0 }
        arena_base = chunk
        arena_ptr = chunk
        arena_end = (chunk + new_size)
    }
    let ptr = arena_ptr
    arena_ptr = (arena_ptr + aligned)
    return ptr
}

fn arena_reset() {
    arena_ptr = arena_base
}

fn arena_used() {
    return (arena_ptr - arena_base)
}

// --- General Allocator (persistent, longer-lived) ---
let heap_start = 0
let heap_end = 0
let heap_lim = 0
let HEAP_CHUNK = 1048576
let free_list = 0
let BLOCK_HDR_SIZE = 16
let MMAP_THRESHOLD = 131072

fn heap_init() {
    heap_start = 0
    heap_end = 0
    heap_lim = 0
    free_list = 0
}

fn rt_alloc(size) {
    if size <= 0 {
        return 0
    }
    let aligned = (size + 7) & (~7)

    if aligned >= MMAP_THRESHOLD {
        let total = aligned + BLOCK_HDR_SIZE
        let ptr = sys_mmap(0, total, 3, 34, -1, 0)
        if ptr < 0 { return 0 }
        store64(ptr, total)
        store64(ptr + 8, 0)
        return ptr + BLOCK_HDR_SIZE
    }

    let prev = 0
    let curr = free_list
    while curr != 0 {
        let block_size = load64(curr)
        if block_size >= aligned + BLOCK_HDR_SIZE {
            let next = load64(curr + 8)
            if prev == 0 {
                free_list = next
            } else {
                store64(prev + 8, next)
            }
            return curr + BLOCK_HDR_SIZE
        }
        prev = curr
        curr = load64(curr + 8)
    }

    // Bump-allocate from mmap'd chunks. (This used brk, which the
    // compiler's own alloc() also moves: either side could shrink the break
    // under the other or hand out overlapping memory.)
    let total = aligned + BLOCK_HDR_SIZE
    if heap_end == 0 || heap_end + total > heap_lim {
        let csize = HEAP_CHUNK
        if total > csize { csize = total }
        let c = sys_mmap(0, csize, 3, 34, -1, 0)
        if c < 0 { return 0 }
        heap_end = c
        heap_lim = c + csize
    }
    let block = heap_end
    heap_end = heap_end + total
    store64(block, total)
    store64(block + 8, 0)
    return block + BLOCK_HDR_SIZE
}

fn rt_free(ptr) {
    if ptr == 0 {
        return
    }
    let block = (ptr - BLOCK_HDR_SIZE)
    let size = load64(block)

    if size >= MMAP_THRESHOLD + BLOCK_HDR_SIZE {
        sys_munmap(block, size)
        return
    }

    store64(block + 8, free_list)
    free_list = block
}

fn rt_realloc(ptr, new_size) {
    if ptr == 0 {
        return rt_alloc(new_size)
    }
    if new_size == 0 {
        rt_free(ptr)
        return 0
    }
    let block = (ptr - BLOCK_HDR_SIZE)
    let old_size = (load64(block) - BLOCK_HDR_SIZE)
    if new_size <= old_size {
        return ptr
    }
    let new_ptr = rt_alloc(new_size)
    if new_ptr == 0 { return 0 }          // allocation failed: ptr stays valid
    memcpy_raw(new_ptr, ptr, old_size)
    rt_free(ptr)
    return new_ptr
}
