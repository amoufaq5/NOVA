// Nova Runtime: Memory Allocator
// Arena-based bump allocator for fast cycle allocation,
// plus a general-purpose allocator for persistent data.
// Uses int_add/int_sub for pointer arithmetic to avoid value discrimination.

// --- Arena Allocator (per-cycle, ultra-fast) ---
let arena_base = 0
let arena_ptr = 0
let arena_end = 0
let arena_size = 1048576

fn arena_init() {
    arena_base = sys_mmap(0, arena_size, 3, 34, -1, 0)
    arena_ptr = arena_base
    arena_end = int_add(arena_base, arena_size)
}

fn arena_alloc(size) {
    let aligned = (size + 7) & (~7)
    if int_add(arena_ptr, aligned) > arena_end {
        let new_size = arena_size
        if aligned > new_size {
            new_size = aligned
        }
        let chunk = sys_mmap(0, new_size, 3, 34, -1, 0)
        arena_base = chunk
        arena_ptr = chunk
        arena_end = int_add(chunk, new_size)
    }
    let ptr = arena_ptr
    arena_ptr = int_add(arena_ptr, aligned)
    return ptr
}

fn arena_reset() {
    arena_ptr = arena_base
}

fn arena_used() {
    return int_sub(arena_ptr, arena_base)
}

// --- General Allocator (persistent, longer-lived) ---
let heap_start = 0
let heap_end = 0
let free_list = 0
let BLOCK_HDR_SIZE = 16
let MMAP_THRESHOLD = 131072

fn heap_init() {
    heap_start = sys_brk(0)
    heap_end = heap_start
    free_list = 0
}

fn rt_alloc(size) {
    if size <= 0 {
        return 0
    }
    let aligned = (size + 7) & (~7)

    if aligned >= MMAP_THRESHOLD {
        let total = aligned + BLOCK_HDR_SIZE
        let ptr = sys_mmap(0, total, 3, 34, -1, 0)
        store64(ptr, total)
        store64(ptr + 8, 0)
        return ptr + BLOCK_HDR_SIZE
    }

    let prev = 0
    let curr = free_list
    while curr != 0 {
        let block_size = load64(curr)
        if block_size >= aligned + BLOCK_HDR_SIZE {
            let next = load64(curr + 8)
            if prev == 0 {
                free_list = next
            } else {
                store64(prev + 8, next)
            }
            return curr + BLOCK_HDR_SIZE
        }
        prev = curr
        curr = load64(curr + 8)
    }

    let total = aligned + BLOCK_HDR_SIZE
    let block = heap_end
    heap_end = sys_brk(int_add(heap_end, total))
    if heap_end < int_add(block, total) {
        let ptr = sys_mmap(0, total, 3, 34, -1, 0)
        store64(ptr, total)
        store64(ptr + 8, 0)
        return ptr + BLOCK_HDR_SIZE
    }
    store64(block, total)
    store64(block + 8, 0)
    return block + BLOCK_HDR_SIZE
}

fn rt_free(ptr) {
    if ptr == 0 {
        return
    }
    let block = int_sub(ptr, BLOCK_HDR_SIZE)
    let size = load64(block)

    if size >= MMAP_THRESHOLD + BLOCK_HDR_SIZE {
        sys_munmap(block, size)
        return
    }

    store64(block + 8, free_list)
    free_list = block
}

fn rt_realloc(ptr, new_size) {
    if ptr == 0 {
        return rt_alloc(new_size)
    }
    if new_size == 0 {
        rt_free(ptr)
        return 0
    }
    let block = int_sub(ptr, BLOCK_HDR_SIZE)
    let old_size = int_sub(load64(block), BLOCK_HDR_SIZE)
    if new_size <= old_size {
        return ptr
    }
    let new_ptr = rt_alloc(new_size)
    memcpy_raw(new_ptr, ptr, old_size)
    rt_free(ptr)
    return new_ptr
}
