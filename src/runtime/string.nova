// Nova Runtime: String Operations
// Strings are length-prefixed byte sequences: [len: 8 bytes][...chars...]
// Immutable once created. Operations return new strings.

let STR_LEN_OFFSET = 0
let STR_DATA_OFFSET = 8

fn str_new(data_ptr, length) {
    let s = alloc(8 + length + 1)
    store64(s, length)
    if data_ptr != 0 {
        memcpy_raw(s + 8, data_ptr, length)
    }
    store8(s + 8 + length, 0)
    return s
}

fn str_len(s) {
    return load64(s)
}

fn str_data(s) {
    return s + 8
}

fn str_char_at(s, index) {
    let length = str_len(s)
    if index < 0 {
        index = length + index
    }
    if index < 0 {
        return -1
    }
    if index >= length {
        return -1
    }
    return load8(s + 8 + index)
}

fn str_concat(a, b) {
    let len_a = str_len(a)
    let len_b = str_len(b)
    let total = len_a + len_b
    let s = alloc(8 + total + 1)
    store64(s, total)
    memcpy_raw(s + 8, str_data(a), len_a)
    memcpy_raw(s + 8 + len_a, str_data(b), len_b)
    store8(s + 8 + total, 0)
    return s
}

fn str_slice(s, start, end) {
    let length = str_len(s)
    if start < 0 {
        start = length + start
    }
    if end < 0 {
        end = length + end
    }
    if start < 0 { start = 0 }
    if end > length { end = length }
    if start >= end {
        return str_new(0, 0)
    }
    let slice_len = end - start
    return str_new(str_data(s) + start, slice_len)
}

fn rt_str_eq(a, b) {
    let len_a = str_len(a)
    let len_b = str_len(b)
    if len_a != len_b {
        return 0
    }
    let i = 0
    while i < len_a {
        if load8(str_data(a) + i) != load8(str_data(b) + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn str_cmp(a, b) {
    let len_a = str_len(a)
    let len_b = str_len(b)
    let min_len = len_a
    if len_b < min_len { min_len = len_b }
    let i = 0
    while i < min_len {
        let ca = load8(str_data(a) + i)
        let cb = load8(str_data(b) + i)
        if ca < cb { return -1 }
        if ca > cb { return 1 }
        i = i + 1
    }
    if len_a < len_b { return -1 }
    if len_a > len_b { return 1 }
    return 0
}

fn rt_str_find(haystack, needle) {
    let h_len = str_len(haystack)
    let n_len = str_len(needle)
    if n_len == 0 { return 0 }
    if n_len > h_len { return -1 }
    let limit = h_len - n_len
    let i = 0
    while i <= limit {
        let matched = 1
        let j = 0
        while j < n_len {
            if load8(str_data(haystack) + i + j) != load8(str_data(needle) + j) {
                matched = 0
                j = n_len
            } else {
                j = j + 1
            }
        }
        if matched == 1 {
            return i
        }
        i = i + 1
    }
    return -1
}

fn str_contains(haystack, needle) {
    return rt_str_find(haystack, needle) >= 0
}

fn str_starts_with(s, prefix) {
    let s_len = str_len(s)
    let p_len = str_len(prefix)
    if p_len > s_len { return 0 }
    let i = 0
    while i < p_len {
        if load8(str_data(s) + i) != load8(str_data(prefix) + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn str_ends_with(s, suffix) {
    let s_len = str_len(s)
    let sf_len = str_len(suffix)
    if sf_len > s_len { return 0 }
    let offset = s_len - sf_len
    let i = 0
    while i < sf_len {
        if load8(str_data(s) + offset + i) != load8(str_data(suffix) + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn str_split(s, delim) {
    let parts = list_new()
    let s_len = str_len(s)
    let d_len = str_len(delim)
    let start = 0
    let i = 0
    while i <= s_len - d_len {
        let matched = 1
        let j = 0
        while j < d_len {
            if load8(str_data(s) + i + j) != load8(str_data(delim) + j) {
                matched = 0
                j = d_len
            } else {
                j = j + 1
            }
        }
        if matched == 1 {
            push(parts, str_slice(s, start, i))
            start = i + d_len
            i = start
        } else {
            i = i + 1
        }
    }
    push(parts, str_slice(s, start, s_len))
    return parts
}

fn rt_str_trim(s) {
    let length = str_len(s)
    let start = 0
    while start < length {
        let c = load8(str_data(s) + start)
        if c == 32 | c == 9 | c == 10 | c == 13 {
            start = start + 1
        } else {
            let end = length
            while end > start {
                let c2 = load8(str_data(s) + end - 1)
                if c2 == 32 | c2 == 9 | c2 == 10 | c2 == 13 {
                    end = end - 1
                } else {
                    return str_slice(s, start, end)
                }
            }
            return str_slice(s, start, end)
        }
    }
    return str_new(0, 0)
}

fn rt_str_to_int(s) {
    let length = str_len(s)
    let result = 0
    let negative = 0
    let i = 0
    if length > 0 {
        let first = load8(str_data(s))
        if first == 45 {
            negative = 1
            i = 1
        }
    }
    while i < length {
        let c = load8(str_data(s) + i)
        if c >= 48 {
            if c <= 57 {
                result = result * 10 + (c - 48)
            } else {
                i = length
            }
        } else {
            i = length
        }
        i = i + 1
    }
    if negative == 1 {
        return 0 - result
    }
    return result
}

fn rt_int_to_str(n) {
    if n == 0 {
        return str_new("0", 1)
    }
    let buf = alloc(21)
    let pos = 20
    let negative = 0
    if n < 0 {
        negative = 1
        n = 0 - n
    }
    while n > 0 {
        pos = pos - 1
        store8(buf + pos, 48 + (n % 10))
        n = n / 10
    }
    if negative == 1 {
        pos = pos - 1
        store8(buf + pos, 45)
    }
    return str_new(buf + pos, 20 - pos)
}
