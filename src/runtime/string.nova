// Nova Runtime: String Operations
// Strings are length-prefixed byte sequences: [len: 8 bytes][...chars...]
// They are immutable once created. Operations return new strings.

let STR_LEN_OFFSET = 0
let STR_DATA_OFFSET = 8

fn str_new(data_ptr, length) {
    let s = alloc(8 + length + 1)
    __intrinsic("store64", s, length)
    __intrinsic("memcpy", s + 8, data_ptr, length)
    __intrinsic("store8", s + 8 + length, 0)  // null terminator for C compat
    return s
}

fn str_len(s) {
    return __intrinsic("load64", s)
}

fn str_data(s) {
    return s + 8
}

fn str_char_at(s, index) {
    let length = str_len(s)
    if index < 0 {
        index = length + index
    }
    if index < 0 {
        return -1
    }
    if index >= length {
        return -1
    }
    return __intrinsic("load8", s + 8 + index)
}

fn str_concat(a, b) {
    let len_a = str_len(a)
    let len_b = str_len(b)
    let total = len_a + len_b
    let s = alloc(8 + total + 1)
    __intrinsic("store64", s, total)
    __intrinsic("memcpy", s + 8, str_data(a), len_a)
    __intrinsic("memcpy", s + 8 + len_a, str_data(b), len_b)
    __intrinsic("store8", s + 8 + total, 0)
    return s
}

fn str_slice(s, start, end) {
    let length = str_len(s)
    if start < 0 {
        start = length + start
    }
    if end < 0 {
        end = length + end
    }
    if start < 0 { start = 0 }
    if end > length { end = length }
    if start >= end {
        return str_new(0, 0)
    }
    let slice_len = end - start
    return str_new(str_data(s) + start, slice_len)
}

fn str_eq(a, b) {
    let len_a = str_len(a)
    let len_b = str_len(b)
    if len_a != len_b {
        return false
    }
    let i = 0
    while i < len_a {
        if __intrinsic("load8", str_data(a) + i) != __intrinsic("load8", str_data(b) + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn str_cmp(a, b) {
    let len_a = str_len(a)
    let len_b = str_len(b)
    let min_len = len_a
    if len_b < min_len { min_len = len_b }
    let i = 0
    while i < min_len {
        let ca = __intrinsic("load8", str_data(a) + i)
        let cb = __intrinsic("load8", str_data(b) + i)
        if ca < cb { return -1 }
        if ca > cb { return 1 }
        i = i + 1
    }
    if len_a < len_b { return -1 }
    if len_a > len_b { return 1 }
    return 0
}

fn str_find(haystack, needle) {
    let h_len = str_len(haystack)
    let n_len = str_len(needle)
    if n_len == 0 { return 0 }
    if n_len > h_len { return -1 }
    let limit = h_len - n_len
    let i = 0
    while i <= limit {
        let match = true
        let j = 0
        while j < n_len {
            if __intrinsic("load8", str_data(haystack) + i + j) != __intrinsic("load8", str_data(needle) + j) {
                match = false
                j = n_len  // break
            } else {
                j = j + 1
            }
        }
        if match {
            return i
        }
        i = i + 1
    }
    return -1
}

fn str_contains(haystack, needle) {
    return str_find(haystack, needle) >= 0
}

fn str_starts_with(s, prefix) {
    let s_len = str_len(s)
    let p_len = str_len(prefix)
    if p_len > s_len { return false }
    let i = 0
    while i < p_len {
        if __intrinsic("load8", str_data(s) + i) != __intrinsic("load8", str_data(prefix) + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn str_ends_with(s, suffix) {
    let s_len = str_len(s)
    let sf_len = str_len(suffix)
    if sf_len > s_len { return false }
    let offset = s_len - sf_len
    let i = 0
    while i < sf_len {
        if __intrinsic("load8", str_data(s) + offset + i) != __intrinsic("load8", str_data(suffix) + i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn str_split(s, delim) {
    let parts = list_new()
    let s_len = str_len(s)
    let d_len = str_len(delim)
    let start = 0
    let i = 0
    while i <= s_len - d_len {
        let match = true
        let j = 0
        while j < d_len {
            if __intrinsic("load8", str_data(s) + i + j) != __intrinsic("load8", str_data(delim) + j) {
                match = false
                j = d_len
            } else {
                j = j + 1
            }
        }
        if match {
            list_push(parts, str_slice(s, start, i))
            start = i + d_len
            i = start
        } else {
            i = i + 1
        }
    }
    list_push(parts, str_slice(s, start, s_len))
    return parts
}

fn str_trim(s) {
    let length = str_len(s)
    let start = 0
    while start < length {
        let c = __intrinsic("load8", str_data(s) + start)
        if c != 32 & c != 9 & c != 10 & c != 13 {
            start = length  // break
        } else {
            start = start + 1
        }
    }
    // Re-check start after loop
    start = 0
    while start < length {
        let c = __intrinsic("load8", str_data(s) + start)
        if c == 32 { start = start + 1 }
        else { if c == 9 { start = start + 1 }
        else { if c == 10 { start = start + 1 }
        else { if c == 13 { start = start + 1 }
        else { length = -1 } } } }  // break hack
    }
    // Find actual start
    start = 0
    while start < str_len(s) {
        let c = __intrinsic("load8", str_data(s) + start)
        if c == 32 | c == 9 | c == 10 | c == 13 {
            start = start + 1
        } else {
            // done
            let end = str_len(s)
            while end > start {
                let c2 = __intrinsic("load8", str_data(s) + end - 1)
                if c2 == 32 | c2 == 9 | c2 == 10 | c2 == 13 {
                    end = end - 1
                } else {
                    return str_slice(s, start, end)
                }
            }
            return str_slice(s, start, end)
        }
    }
    return str_new(0, 0)
}

fn str_to_int(s) {
    let length = str_len(s)
    let result = 0
    let negative = false
    let i = 0
    if length > 0 {
        let first = __intrinsic("load8", str_data(s))
        if first == 45 {  // '-'
            negative = true
            i = 1
        }
    }
    while i < length {
        let c = __intrinsic("load8", str_data(s) + i)
        if c >= 48 & c <= 57 {
            result = result * 10 + (c - 48)
        } else {
            i = length  // break
        }
        i = i + 1
    }
    if negative {
        return 0 - result
    }
    return result
}

fn int_to_str(n) {
    if n == 0 {
        return str_new("0", 1)
    }
    let buf = alloc(21)  // max 20 digits + sign
    let pos = 20
    let negative = false
    if n < 0 {
        negative = true
        n = 0 - n
    }
    while n > 0 {
        pos = pos - 1
        __intrinsic("store8", buf + pos, 48 + (n % 10))
        n = n / 10
    }
    if negative {
        pos = pos - 1
        __intrinsic("store8", buf + pos, 45)  // '-'
    }
    let result = str_new(buf + pos, 20 - pos)
    free(buf)
    return result
}
