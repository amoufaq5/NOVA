// Nova Standard Library: Tensor/Matrix Operations
// Tensor layout: [TENSOR_TAG, rows, cols, data]
// data is a flat list of IEEE 754 float bit patterns.

let TENSOR_TAG = 200

fn tensor_new(rows, cols) {
    let t = list_new()
    push(t, TENSOR_TAG)
    push(t, rows)
    push(t, cols)
    let data = list_new()
    let zero = to_float(0)
    let n = rows * cols
    let i = 0
    while i < n {
        push(data, zero)
        i = i + 1
    }
    push(t, data)
    return t
}

fn tensor_from_list(rows, cols, data) {
    let t = list_new()
    push(t, TENSOR_TAG)
    push(t, rows)
    push(t, cols)
    let d = list_new()
    let n = rows * cols
    let i = 0
    while i < n {
        push(d, data[i])
        i = i + 1
    }
    push(t, d)
    return t
}

fn tensor_rows(t) {
    return t[1]
}

fn tensor_cols(t) {
    return t[2]
}

fn tensor_get(t, r, c) {
    let cols = t[2]
    let data = t[3]
    return data[r * cols + c]
}

fn tensor_set(t, r, c, val) {
    let cols = t[2]
    let data = t[3]
    list_set(data, r * cols + c, val)
}

fn tensor_add(a, b) {
    let rows = a[1]
    let cols = a[2]
    let da = a[3]
    let db = b[3]
    let result = tensor_new(rows, cols)
    let dr = result[3]
    let n = rows * cols
    let i = 0
    while i < n {
        list_set(dr, i, float_add(da[i], db[i]))
        i = i + 1
    }
    return result
}

fn tensor_sub(a, b) {
    let rows = a[1]
    let cols = a[2]
    let da = a[3]
    let db = b[3]
    let result = tensor_new(rows, cols)
    let dr = result[3]
    let n = rows * cols
    let i = 0
    while i < n {
        list_set(dr, i, float_sub(da[i], db[i]))
        i = i + 1
    }
    return result
}

fn tensor_scale(t, scalar) {
    let rows = t[1]
    let cols = t[2]
    let dt = t[3]
    let result = tensor_new(rows, cols)
    let dr = result[3]
    let n = rows * cols
    let i = 0
    while i < n {
        list_set(dr, i, float_mul(dt[i], scalar))
        i = i + 1
    }
    return result
}

fn tensor_matmul(a, b) {
    let ar = a[1]
    let ac = a[2]
    let br = b[1]
    let bc = b[2]
    let da = a[3]
    let db = b[3]
    let result = tensor_new(ar, bc)
    let dr = result[3]
    let i = 0
    while i < ar {
        let j = 0
        while j < bc {
            let sum = to_float(0)
            let k = 0
            while k < ac {
                sum = float_add(sum, float_mul(da[i * ac + k], db[k * bc + j]))
                k = k + 1
            }
            list_set(dr, i * bc + j, sum)
            j = j + 1
        }
        i = i + 1
    }
    return result
}

fn tensor_transpose(t) {
    let rows = t[1]
    let cols = t[2]
    let dt = t[3]
    let result = tensor_new(cols, rows)
    let dr = result[3]
    let r = 0
    while r < rows {
        let c = 0
        while c < cols {
            list_set(dr, c * rows + r, dt[r * cols + c])
            c = c + 1
        }
        r = r + 1
    }
    return result
}

fn tensor_dot(a, b) {
    let da = a[3]
    let db = b[3]
    let n = a[2]
    let sum = to_float(0)
    let i = 0
    while i < n {
        sum = float_add(sum, float_mul(da[i], db[i]))
        i = i + 1
    }
    return sum
}

fn tensor_print(t) {
    let rows = t[1]
    let cols = t[2]
    let dt = t[3]
    println("[")
    let r = 0
    while r < rows {
        let line = "  ["
        let c = 0
        while c < cols {
            if c > 0 {
                line = line + ", "
            }
            line = line + float_to_str(dt[r * cols + c])
            c = c + 1
        }
        line = line + "]"
        println(line)
        r = r + 1
    }
    println("]")
}

fn tensor_apply(t, func) {
    let rows = t[1]
    let cols = t[2]
    let dt = t[3]
    let result = tensor_new(rows, cols)
    let dr = result[3]
    let n = rows * cols
    let i = 0
    while i < n {
        list_set(dr, i, func(dt[i]))
        i = i + 1
    }
    return result
}

fn tensor_sum(t) {
    let dt = t[3]
    let n = t[1] * t[2]
    let sum = to_float(0)
    let i = 0
    while i < n {
        sum = float_add(sum, dt[i])
        i = i + 1
    }
    return sum
}

fn tensor_max(t) {
    let dt = t[3]
    let n = t[1] * t[2]
    if n == 0 { return to_float(0) }
    let mx = dt[0]
    let i = 1
    while i < n {
        if float_cmp(dt[i], mx) > 0 {
            mx = dt[i]
        }
        i = i + 1
    }
    return mx
}

fn tensor_min(t) {
    let dt = t[3]
    let n = t[1] * t[2]
    if n == 0 { return to_float(0) }
    let mn = dt[0]
    let i = 1
    while i < n {
        if float_cmp(dt[i], mn) < 0 {
            mn = dt[i]
        }
        i = i + 1
    }
    return mn
}

fn tensor_relu(t) {
    let rows = t[1]
    let cols = t[2]
    let dt = t[3]
    let result = tensor_new(rows, cols)
    let dr = result[3]
    let zero = to_float(0)
    let n = rows * cols
    let i = 0
    while i < n {
        if float_cmp(dt[i], zero) > 0 {
            list_set(dr, i, dt[i])
        }
        i = i + 1
    }
    return result
}

fn tensor_softmax(t) {
    let cols = t[2]
    let dt = t[3]
    let result = tensor_new(1, cols)
    let dr = result[3]
    let mx = tensor_max(t)
    let sum = to_float(0)
    let i = 0
    while i < cols {
        let e = float_sub(dt[i], mx)
        list_set(dr, i, e)
        i = i + 1
    }
    return result
}

fn tensor_eq(a, b) {
    if a[1] != b[1] { return 0 }
    if a[2] != b[2] { return 0 }
    let da = a[3]
    let db = b[3]
    let n = a[1] * a[2]
    let i = 0
    while i < n {
        if float_cmp(da[i], db[i]) != 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn tensor_shape(t) {
    let s = list_new()
    push(s, t[1])
    push(s, t[2])
    return s
}

fn tensor_flatten(t) {
    let n = t[1] * t[2]
    return tensor_from_list(1, n, t[3])
}

fn tensor_reshape(t, rows, cols) {
    let n = t[1] * t[2]
    if rows * cols != n { return 0 }
    return tensor_from_list(rows, cols, t[3])
}

fn tensor_identity(n) {
    let t = tensor_new(n, n)
    let one = to_float(1)
    let i = 0
    while i < n {
        tensor_set(t, i, i, one)
        i = i + 1
    }
    return t
}

fn tensor_zeros(rows, cols) {
    return tensor_new(rows, cols)
}

fn tensor_fill(rows, cols, val) {
    let t = tensor_new(rows, cols)
    let dt = t[3]
    let n = rows * cols
    let i = 0
    while i < n {
        list_set(dt, i, val)
        i = i + 1
    }
    return t
}
