// Nova Standard Library: High-Performance Tensor Operations
// SIMD-accelerated matrix math with raw memory backing.
// Data stored as contiguous IEEE 754 doubles in alloc'd memory.
// Uses SSE2 vectorized ops from simd.nova for bulk operations.

let TENSOR_TAG = 200

// ============================================================================
// Internal helpers
// ============================================================================

fn _tensor_raw_copy(src_ptr, dst_ptr, n) {
    let i = 0
    while i < n {
        let off = i * 8
        mem_write_f64(int_add(dst_ptr, off), mem_read_f64(int_add(src_ptr, off)))
        i = i + 1
    }
}

fn _tensor_exp_approx(x) {
    // Clamp to [-20, 20] to avoid overflow
    let twenty = to_float(20)
    let neg_twenty = float_sub(to_float(0), twenty)
    if float_cmp(x, twenty) > 0 {
        // exp(20) ~ 485165195. Build via float_mul to avoid large integer.
        let big = float_mul(to_float(485165), to_float(1000))
        return float_add(big, to_float(195))
    }
    if float_cmp(x, neg_twenty) < 0 {
        return to_float(0)
    }
    // exp(x) ~ 1 + x + x^2/2 + x^3/6 + x^4/24 + x^5/120 + x^6/720
    let one = to_float(1)
    let x2 = float_mul(x, x)
    let x3 = float_mul(x2, x)
    let x4 = float_mul(x3, x)
    let x5 = float_mul(x4, x)
    let x6 = float_mul(x5, x)
    let half = float_div(one, to_float(2))
    let sixth = float_div(one, to_float(6))
    let twentyfourth = float_div(one, to_float(24))
    let one_over_120 = float_div(one, to_float(120))
    let one_over_720 = float_div(one, to_float(720))
    let result = float_add(one, x)
    result = float_add(result, float_mul(x2, half))
    result = float_add(result, float_mul(x3, sixth))
    result = float_add(result, float_mul(x4, twentyfourth))
    result = float_add(result, float_mul(x5, one_over_120))
    result = float_add(result, float_mul(x6, one_over_720))
    // Clamp result to be non-negative (exp is always > 0)
    let zero = to_float(0)
    if float_cmp(result, zero) < 0 {
        return zero
    }
    return result
}

// ============================================================================
// Core tensor creation and access
// ============================================================================

fn tensor_new(rows, cols) {
    let t = list_new()
    push(t, TENSOR_TAG)
    push(t, rows)
    push(t, cols)
    let n = rows * cols
    let data_ptr = alloc(n * 8)
    // Zero-fill the allocated memory
    let zero = to_float(0)
    let i = 0
    while i < n {
        mem_write_f64(int_add(data_ptr, i * 8), zero)
        i = i + 1
    }
    push(t, data_ptr)
    return t
}

fn tensor_from_list(rows, cols, data_list) {
    let t = list_new()
    push(t, TENSOR_TAG)
    push(t, rows)
    push(t, cols)
    let n = rows * cols
    let data_ptr = alloc(n * 8)
    let i = 0
    while i < n {
        mem_write_f64(int_add(data_ptr, i * 8), data_list[i])
        i = i + 1
    }
    push(t, data_ptr)
    return t
}

fn tensor_rows(t) {
    return t[1]
}

fn tensor_cols(t) {
    return t[2]
}

fn tensor_get(t, r, c) {
    let cols = t[2]
    let idx = r * cols + c
    return mem_read_f64(int_add(t[3], idx * 8))
}

fn tensor_set(t, r, c, val) {
    let cols = t[2]
    let idx = r * cols + c
    mem_write_f64(int_add(t[3], idx * 8), val)
}

fn tensor_data(t) {
    return t[3]
}

fn tensor_free(t) {
    mem_free(t[3])
}

// ============================================================================
// SIMD-accelerated element-wise operations
// ============================================================================

fn tensor_add(a, b) {
    let rows = a[1]
    let cols = a[2]
    let n = rows * cols
    let result = tensor_new(rows, cols)
    simd_add_f64(a[3], b[3], result[3], n)
    return result
}

fn tensor_sub(a, b) {
    let rows = a[1]
    let cols = a[2]
    let n = rows * cols
    let result = tensor_new(rows, cols)
    simd_sub_f64(a[3], b[3], result[3], n)
    return result
}

fn tensor_scale(t, scalar) {
    let rows = t[1]
    let cols = t[2]
    let n = rows * cols
    let result = tensor_new(rows, cols)
    let result_ptr = result[3]
    _tensor_raw_copy(t[3], result_ptr, n)
    simd_scale_f64(result_ptr, scalar, n)
    return result
}

fn tensor_mul_elementwise(a, b) {
    let rows = a[1]
    let cols = a[2]
    let n = rows * cols
    let result = tensor_new(rows, cols)
    simd_mul_f64(a[3], b[3], result[3], n)
    return result
}

fn tensor_div_elementwise(a, b) {
    let rows = a[1]
    let cols = a[2]
    let n = rows * cols
    let result = tensor_new(rows, cols)
    simd_div_f64(a[3], b[3], result[3], n)
    return result
}

// ============================================================================
// Matrix multiplication with SIMD dot product and transposed B
// ============================================================================

fn _tensor_matmul_tiled(a, b, tile) {
    let ar = a[1]
    let ac = a[2]
    let bc = b[2]
    let result = tensor_new(ar, bc)
    let r_ptr = result[3]
    let a_ptr = a[3]
    let b_ptr = b[3]
    let ii = 0
    while ii < ar {
        let ii_end = ii + tile
        if ii_end > ar { ii_end = ar }
        let jj = 0
        while jj < bc {
            let jj_end = jj + tile
            if jj_end > bc { jj_end = bc }
            let kk = 0
            while kk < ac {
                let kk_end = kk + tile
                if kk_end > ac { kk_end = ac }
                let i = ii
                while i < ii_end {
                    let k = kk
                    while k < kk_end {
                        let a_off = int_add(i * ac, k) * 8
                        let a_val = mem_read_f64(int_add(a_ptr, a_off))
                        let j = jj
                        while j < jj_end {
                            let b_off = int_add(k * bc, j) * 8
                            let c_idx = int_add(i * bc, j)
                            let c_off = c_idx * 8
                            let c_addr = int_add(r_ptr, c_off)
                            let c_val = mem_read_f64(c_addr)
                            let b_val = mem_read_f64(int_add(b_ptr, b_off))
                            mem_write_f64(c_addr, float_add(c_val, float_mul(a_val, b_val)))
                            j = j + 1
                        }
                        k = k + 1
                    }
                    i = i + 1
                }
                kk = kk + tile
            }
            jj = jj + tile
        }
        ii = ii + tile
    }
    return result
}

fn tensor_matmul(a, b) {
    let ar = a[1]
    let ac = a[2]
    let bc = b[2]
    if ac >= 64 {
        return _tensor_matmul_tiled(a, b, 32)
    }
    let result = tensor_new(ar, bc)
    let result_ptr = result[3]
    let a_ptr = a[3]
    let bt = tensor_transpose(b)
    let bt_ptr = bt[3]
    let i = 0
    while i < ar {
        let a_row_ptr = int_add(a_ptr, i * ac * 8)
        let j = 0
        while j < bc {
            let bt_row_ptr = int_add(bt_ptr, j * ac * 8)
            let dot = simd_dot_f64(a_row_ptr, bt_row_ptr, ac)
            mem_write_f64(int_add(result_ptr, int_add(i * bc, j) * 8), dot)
            j = j + 1
        }
        i = i + 1
    }
    return result
}

// ============================================================================
// Linear algebra operations
// ============================================================================

fn tensor_transpose(t) {
    let rows = t[1]
    let cols = t[2]
    let t_ptr = t[3]
    let result = tensor_new(cols, rows)
    let r_ptr = result[3]
    let r = 0
    while r < rows {
        let c = 0
        while c < cols {
            let src_off = (r * cols + c) * 8
            let dst_off = (c * rows + r) * 8
            mem_write_f64(int_add(r_ptr, dst_off), mem_read_f64(int_add(t_ptr, src_off)))
            c = c + 1
        }
        r = r + 1
    }
    return result
}

fn tensor_dot(a, b) {
    let n = a[1] * a[2]
    return simd_dot_f64(a[3], b[3], n)
}

// ============================================================================
// Printing
// ============================================================================

fn tensor_print(t) {
    let rows = t[1]
    let cols = t[2]
    let t_ptr = t[3]
    println("[")
    let r = 0
    while r < rows {
        let line = "  ["
        let c = 0
        while c < cols {
            if c > 0 {
                line = line + ", "
            }
            let off = (r * cols + c) * 8
            line = line + float_to_str(mem_read_f64(int_add(t_ptr, off)))
            c = c + 1
        }
        line = line + "]"
        println(line)
        r = r + 1
    }
    println("]")
}

// ============================================================================
// Neural network activation functions
// ============================================================================

fn tensor_relu(t) {
    let rows = t[1]
    let cols = t[2]
    let n = rows * cols
    let result = tensor_new(rows, cols)
    let result_ptr = result[3]
    _tensor_raw_copy(t[3], result_ptr, n)
    simd_relu_f64(result_ptr, n)
    return result
}

fn tensor_softmax(t) {
    let rows = t[1]
    let cols = t[2]
    let n = rows * cols
    let t_ptr = t[3]
    let result = tensor_new(rows, cols)
    let r_ptr = result[3]
    // Find max for numerical stability
    let mx = mem_read_f64(t_ptr)
    let i = 1
    while i < n {
        let val = mem_read_f64(int_add(t_ptr, i * 8))
        if float_cmp(val, mx) > 0 {
            mx = val
        }
        i = i + 1
    }
    // Subtract max and exponentiate
    let sum = to_float(0)
    i = 0
    while i < n {
        let val = mem_read_f64(int_add(t_ptr, i * 8))
        let shifted = float_sub(val, mx)
        let e = _tensor_exp_approx(shifted)
        mem_write_f64(int_add(r_ptr, i * 8), e)
        sum = float_add(sum, e)
        i = i + 1
    }
    // Normalize by sum
    i = 0
    while i < n {
        let val = mem_read_f64(int_add(r_ptr, i * 8))
        mem_write_f64(int_add(r_ptr, i * 8), float_div(val, sum))
        i = i + 1
    }
    return result
}

fn tensor_sigmoid(t) {
    let rows = t[1]
    let cols = t[2]
    let n = rows * cols
    let t_ptr = t[3]
    let result = tensor_new(rows, cols)
    let r_ptr = result[3]
    let one = to_float(1)
    let i = 0
    while i < n {
        let val = mem_read_f64(int_add(t_ptr, i * 8))
        // sigmoid(x) = 1 / (1 + exp(-x))
        let neg_val = float_sub(to_float(0), val)
        let e = _tensor_exp_approx(neg_val)
        let denom = float_add(one, e)
        mem_write_f64(int_add(r_ptr, i * 8), float_div(one, denom))
        i = i + 1
    }
    return result
}

fn tensor_tanh_approx(t) {
    let rows = t[1]
    let cols = t[2]
    let n = rows * cols
    let t_ptr = t[3]
    let result = tensor_new(rows, cols)
    let r_ptr = result[3]
    let one = to_float(1)
    let two = to_float(2)
    let i = 0
    while i < n {
        let val = mem_read_f64(int_add(t_ptr, i * 8))
        // tanh(x) = (exp(2x) - 1) / (exp(2x) + 1)
        let two_x = float_mul(two, val)
        let e2x = _tensor_exp_approx(two_x)
        let num = float_sub(e2x, one)
        let den = float_add(e2x, one)
        mem_write_f64(int_add(r_ptr, i * 8), float_div(num, den))
        i = i + 1
    }
    return result
}

// ============================================================================
// Reduction and statistical operations
// ============================================================================

fn tensor_sum(t) {
    let n = t[1] * t[2]
    return simd_sum_f64(t[3], n)
}

fn tensor_max(t) {
    let t_ptr = t[3]
    let n = t[1] * t[2]
    if n == 0 {
        return to_float(0)
    }
    let mx = mem_read_f64(t_ptr)
    let i = 1
    while i < n {
        let val = mem_read_f64(int_add(t_ptr, i * 8))
        if float_cmp(val, mx) > 0 {
            mx = val
        }
        i = i + 1
    }
    return mx
}

fn tensor_min(t) {
    let t_ptr = t[3]
    let n = t[1] * t[2]
    if n == 0 {
        return to_float(0)
    }
    let mn = mem_read_f64(t_ptr)
    let i = 1
    while i < n {
        let val = mem_read_f64(int_add(t_ptr, i * 8))
        if float_cmp(val, mn) < 0 {
            mn = val
        }
        i = i + 1
    }
    return mn
}

fn tensor_norm(t) {
    let n = t[1] * t[2]
    return simd_norm_f64(t[3], n)
}

// ============================================================================
// Comparison
// ============================================================================

fn tensor_eq(a, b) {
    if a[1] != b[1] {
        return 0
    }
    if a[2] != b[2] {
        return 0
    }
    let a_ptr = a[3]
    let b_ptr = b[3]
    let n = a[1] * a[2]
    let i = 0
    while i < n {
        let off = i * 8
        if float_cmp(mem_read_f64(int_add(a_ptr, off)), mem_read_f64(int_add(b_ptr, off))) != 0 {
            return 0
        }
        i = i + 1
    }
    return 1
}

// ============================================================================
// Shape and restructuring operations
// ============================================================================

fn tensor_shape(t) {
    let s = list_new()
    push(s, t[1])
    push(s, t[2])
    return s
}

fn tensor_flatten(t) {
    let rows = t[1]
    let cols = t[2]
    let n = rows * cols
    let result = tensor_new(1, n)
    _tensor_raw_copy(t[3], result[3], n)
    return result
}

fn tensor_reshape(t, rows, cols) {
    let n = t[1] * t[2]
    if rows * cols != n {
        return 0
    }
    // Reuse data pointer directly (no copy needed, same flat layout)
    let result = list_new()
    push(result, TENSOR_TAG)
    push(result, rows)
    push(result, cols)
    push(result, t[3])
    return result
}

fn tensor_identity(n) {
    let t = tensor_new(n, n)
    let t_ptr = t[3]
    let one = to_float(1)
    let i = 0
    while i < n {
        let off = (i * n + i) * 8
        mem_write_f64(int_add(t_ptr, off), one)
        i = i + 1
    }
    return t
}

fn tensor_zeros(rows, cols) {
    return tensor_new(rows, cols)
}

fn tensor_fill(rows, cols, val) {
    let t = tensor_new(rows, cols)
    let t_ptr = t[3]
    let n = rows * cols
    let i = 0
    while i < n {
        mem_write_f64(int_add(t_ptr, i * 8), val)
        i = i + 1
    }
    return t
}

fn tensor_apply(t, func) {
    let rows = t[1]
    let cols = t[2]
    let t_ptr = t[3]
    let n = rows * cols
    let result = tensor_new(rows, cols)
    let r_ptr = result[3]
    let i = 0
    while i < n {
        let val = mem_read_f64(int_add(t_ptr, i * 8))
        mem_write_f64(int_add(r_ptr, i * 8), func(val))
        i = i + 1
    }
    return result
}

// ============================================================================
// Similarity and distance
// ============================================================================

fn tensor_cosine_sim(a, b) {
    let n = a[1] * a[2]
    let dot = simd_dot_f64(a[3], b[3], n)
    let norm_a = simd_norm_f64(a[3], n)
    let norm_b = simd_norm_f64(b[3], n)
    let denom = float_mul(norm_a, norm_b)
    // Guard against division by zero
    let zero = to_float(0)
    if float_cmp(denom, zero) == 0 {
        return zero
    }
    return float_div(dot, denom)
}

// ============================================================================
// Slicing operations
// ============================================================================

fn tensor_row_slice(t, row) {
    let cols = t[2]
    let t_ptr = t[3]
    // Share data via pointer arithmetic (no copy)
    let row_ptr = int_add(t_ptr, row * cols * 8)
    let result = list_new()
    push(result, TENSOR_TAG)
    push(result, 1)
    push(result, cols)
    push(result, row_ptr)
    return result
}

fn tensor_col_slice(t, col) {
    let rows = t[1]
    let cols = t[2]
    let t_ptr = t[3]
    // Column data is not contiguous, so we must copy
    let result = tensor_new(rows, 1)
    let r_ptr = result[3]
    let r = 0
    while r < rows {
        let src_off = (r * cols + col) * 8
        let dst_off = r * 8
        mem_write_f64(int_add(r_ptr, dst_off), mem_read_f64(int_add(t_ptr, src_off)))
        r = r + 1
    }
    return result
}

// ============================================================================
// Concatenation
// ============================================================================

fn tensor_concat_rows(a, b) {
    let a_rows = a[1]
    let b_rows = b[1]
    let cols = a[2]
    let total_rows = a_rows + b_rows
    let result = tensor_new(total_rows, cols)
    let r_ptr = result[3]
    let a_n = a_rows * cols
    let b_n = b_rows * cols
    // Copy a's data
    _tensor_raw_copy(a[3], r_ptr, a_n)
    // Copy b's data after a's
    _tensor_raw_copy(b[3], int_add(r_ptr, a_n * 8), b_n)
    return result
}

fn tensor_concat_cols(a, b) {
    let rows = a[1]
    let a_cols = a[2]
    let b_cols = b[2]
    let total_cols = a_cols + b_cols
    let result = tensor_new(rows, total_cols)
    let r_ptr = result[3]
    let a_ptr = a[3]
    let b_ptr = b[3]
    let r = 0
    while r < rows {
        // Copy row r from a
        let c = 0
        while c < a_cols {
            let src_off = (r * a_cols + c) * 8
            let dst_off = (r * total_cols + c) * 8
            mem_write_f64(int_add(r_ptr, dst_off), mem_read_f64(int_add(a_ptr, src_off)))
            c = c + 1
        }
        // Copy row r from b
        c = 0
        while c < b_cols {
            let src_off = (r * b_cols + c) * 8
            let dst_off = (r * total_cols + a_cols + c) * 8
            mem_write_f64(int_add(r_ptr, dst_off), mem_read_f64(int_add(b_ptr, src_off)))
            c = c + 1
        }
        r = r + 1
    }
    return result
}

// ============================================================================
// Batch operations
// ============================================================================

fn tensor_batch_matmul(tensors, b) {
    let count = len(tensors)
    let results = list_new()
    let i = 0
    while i < count {
        push(results, tensor_matmul(tensors[i], b))
        i = i + 1
    }
    return results
}
