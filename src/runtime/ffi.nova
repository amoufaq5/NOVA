// Nova Standard Library: Foreign Function Interface (FFI)
// Requires compilation with --link-libc flag.
//
// Usage:
//   let lib = ffi_open("libfoo.so")
//   let fn_ptr = ffi_sym(lib, "function_name")
//   let result = ffi_call1(fn_ptr, arg1)
//   ffi_close(lib)
//
// Functions ffi_open, ffi_sym, ffi_close, ffi_call0-5 are builtins
// when compiled with --link-libc.

// Memory access helpers for C struct interop

fn mem_read_i8(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "movsx rax, byte ptr [rdi]"
    }
    return val
}

fn mem_write_i8(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "mov byte ptr [rdi], al"
    }
}

fn mem_read_i16(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "movsx rax, word ptr [rdi]"
    }
    return val
}

fn mem_write_i16(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "mov word ptr [rdi], ax"
    }
}

fn mem_read_i32(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "movsxd rax, dword ptr [rdi]"
    }
    return val
}

fn mem_write_i32(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "mov dword ptr [rdi], eax"
    }
}

fn mem_read_i64(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rdi]"
    }
    return val
}

fn mem_write_i64(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "mov [rdi], rax"
    }
}

fn mem_read_ptr(ptr) {
    return mem_read_i64(ptr)
}

fn mem_write_ptr(ptr, val) {
    mem_write_i64(ptr, val)
}

fn mem_read_f64(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "movsd xmm0, [rdi]"
        "movq rax, xmm0"
    }
    return val
}

fn mem_write_f64(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "movq xmm0, rax"
        "movsd [rdi], xmm0"
    }
}

fn mem_offset(ptr, offset) {
    return int_add(ptr, offset)
}
