// Nova Standard Library: Foreign Function Interface (FFI)
// Requires compilation with --link-libc flag.
//
// Usage:
//   let lib = ffi_open("libfoo.so")
//   let fn_ptr = ffi_sym(lib, "function_name")
//   let result = ffi_call1(fn_ptr, arg1)
//   ffi_close(lib)
//
// Functions ffi_open, ffi_sym, ffi_close, ffi_call0-5 are builtins
// when compiled with --link-libc.

// Memory access helpers for C struct interop

fn mem_read_i8(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "movsx rax, byte ptr [rdi]"
        "mov [rbp - 16], rax"
    }
    return val
}

fn mem_write_i8(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "mov byte ptr [rdi], al"
    }
}

fn mem_read_i16(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "movsx rax, word ptr [rdi]"
        "mov [rbp - 16], rax"
    }
    return val
}

fn mem_write_i16(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "mov word ptr [rdi], ax"
    }
}

fn mem_read_i32(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "movsxd rax, dword ptr [rdi]"
        "mov [rbp - 16], rax"
    }
    return val
}

fn mem_write_i32(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "mov dword ptr [rdi], eax"
    }
}

fn mem_read_i64(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rdi]"
        "mov [rbp - 16], rax"
    }
    return val
}

fn mem_write_i64(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "mov [rdi], rax"
    }
}

fn mem_read_ptr(ptr) {
    return mem_read_i64(ptr)
}

fn mem_write_ptr(ptr, val) {
    mem_write_i64(ptr, val)
}

fn mem_read_f64(ptr) {
    let val = 0
    asm {
        "mov rdi, [rbp - 8]"
        "movsd xmm0, [rdi]"
        "movq rax, xmm0"
        "mov [rbp - 16], rax"
    }
    return val
}

fn mem_write_f64(ptr, val) {
    asm {
        "mov rdi, [rbp - 8]"
        "mov rax, [rbp - 16]"
        "movq xmm0, rax"
        "movsd [rdi], xmm0"
    }
}

fn mem_offset(ptr, offset) {
    return int_add(ptr, offset)
}

// Higher-level FFI wrappers

fn ffi_call_float(fn_ptr, arg) {
    return ffi_callf1(fn_ptr, arg)
}

fn ffi_call_float2(fn_ptr, a, b) {
    return ffi_callf2(fn_ptr, a, b)
}

let _ffi_libc = 0
let _ffi_malloc_fn = 0
let _ffi_free_fn = 0
let _ffi_calloc_fn = 0

fn _ffi_ensure_libc() {
    if _ffi_libc == 0 {
        _ffi_libc = ffi_open(0)
        _ffi_malloc_fn = ffi_sym(_ffi_libc, "malloc")
        _ffi_free_fn = ffi_sym(_ffi_libc, "free")
        _ffi_calloc_fn = ffi_sym(_ffi_libc, "calloc")
    }
}

fn mem_alloc(size) {
    _ffi_ensure_libc()
    return ffi_call1(_ffi_malloc_fn, size)
}

fn mem_free(ptr) {
    _ffi_ensure_libc()
    ffi_call1(_ffi_free_fn, ptr)
}

fn mem_alloc_zeroed(size) {
    _ffi_ensure_libc()
    return ffi_call2(_ffi_calloc_fn, size, 1)
}
