// Nova Runtime: N17 Real-Time Audio Pipeline
// STFT, MFCC, and voice activity detection for audio signal processing.
// All amplitudes use scale-1000 integer representation (500 = 0.5).
// Raw samples stored as IEEE 754 doubles in alloc'd memory.

let AUDIO_TAG = 450

fn _audio_pi_s1000() {
    return 3141
}

fn _audio_two_pi_s1000() {
    return 6283
}

fn _audio_cos_approx(x) {
    let pi_s = _audio_pi_s1000()
    let two_pi_s = _audio_two_pi_s1000()
    while x > pi_s {
        x = int_sub(x, two_pi_s)
    }
    while x < int_sub(0, pi_s) {
        x = int_add(x, two_pi_s)
    }
    let x2 = int_div(int_mul(x, x), 1000)
    let x4 = int_div(int_mul(x2, x2), 1000)
    let term1 = int_div(x2, 2)
    let term2 = int_div(x4, 24)
    let result = int_sub(int_add(1000, term2), term1)
    return result
}

fn _audio_sin_approx(x) {
    let pi_s = _audio_pi_s1000()
    let two_pi_s = _audio_two_pi_s1000()
    while x > pi_s {
        x = int_sub(x, two_pi_s)
    }
    while x < int_sub(0, pi_s) {
        x = int_add(x, two_pi_s)
    }
    let x2 = int_div(int_mul(x, x), 1000)
    let x3 = int_div(int_mul(x2, x), 1000)
    let x5 = int_div(int_mul(x3, x2), 1000)
    let term1 = int_div(x3, 6)
    let term2 = int_div(x5, 120)
    let result = int_add(int_sub(x, term1), term2)
    return result
}

fn _audio_sqrt_approx(x) {
    if x <= 0 {
        return 0
    }
    if x < 4 {
        return int_div(int_mul(x, 1000), 2000)
    }
    let guess = int_div(x, 2)
    if guess <= 0 {
        guess = 1
    }
    let i = 0
    while i < 10 {
        if guess <= 0 {
            guess = 1
        }
        let division = int_div(int_mul(x, 1000), guess)
        guess = int_div(int_add(guess, division), 2)
        i = int_add(i, 1)
    }
    return guess
}

fn _audio_abs(x) {
    if x < 0 {
        return int_sub(0, x)
    }
    return x
}

fn _audio_log_approx_s1000(x) {
    if x <= 0 {
        return 0
    }
    if x <= 1 {
        return int_sub(0, 6908)
    }
    let result = 0
    let v = x
    while v > 2718 {
        result = int_add(result, 1000)
        v = int_div(int_mul(v, 1000), 2718)
    }
    while v < 368 {
        result = int_sub(result, 1000)
        v = int_div(int_mul(v, 2718), 1000)
    }
    let num = int_sub(v, 1000)
    let den = int_add(v, 1000)
    if den == 0 {
        return result
    }
    let z = int_div(int_mul(num, 1000), den)
    let z2 = int_div(int_mul(z, z), 1000)
    let z3 = int_div(int_mul(z2, z), 1000)
    let z5 = int_div(int_mul(z3, z2), 1000)
    let series = int_add(z, int_add(int_div(z3, 3), int_div(z5, 5)))
    result = int_add(result, int_mul(2, series))
    return result
}

fn _audio_log10_approx_s1000(x) {
    let ln_val = _audio_log_approx_s1000(x)
    return int_div(int_mul(ln_val, 434), 1000)
}

fn audio_new(sample_rate) {
    let buf = list_new()
    push(buf, AUDIO_TAG)
    push(buf, sample_rate)
    push(buf, 0)
    let data_ptr = alloc(8)
    push(buf, data_ptr)
    return buf
}

fn audio_from_samples(sample_rate, samples_list) {
    let count = len(samples_list)
    let buf = list_new()
    push(buf, AUDIO_TAG)
    push(buf, sample_rate)
    push(buf, count)
    let data_ptr = alloc(int_mul(count, 8))
    let i = 0
    while i < count {
        let s = samples_list[i]
        let f = float_div(to_float(s), to_float(1000))
        mem_write_f64(int_add(data_ptr, int_mul(i, 8)), f)
        i = int_add(i, 1)
    }
    push(buf, data_ptr)
    return buf
}

fn audio_sample_count(buf) {
    return buf[2]
}

fn audio_get_sample(buf, index) {
    let data_ptr = buf[3]
    return mem_read_f64(int_add(data_ptr, int_mul(index, 8)))
}

fn audio_set_sample(buf, index, value) {
    let data_ptr = buf[3]
    mem_write_f64(int_add(data_ptr, int_mul(index, 8)), value)
}

fn audio_append_samples(buf, samples_list) {
    let old_count = buf[2]
    let add_count = len(samples_list)
    let new_count = int_add(old_count, add_count)
    let new_ptr = alloc(int_mul(new_count, 8))
    let old_ptr = buf[3]
    let i = 0
    while i < old_count {
        let off_old = int_mul(i, 8)
        let off_new = int_mul(i, 8)
        mem_write_f64(int_add(new_ptr, off_new), mem_read_f64(int_add(old_ptr, off_old)))
        i = int_add(i, 1)
    }
    let j = 0
    while j < add_count {
        let s = samples_list[j]
        let f = float_div(to_float(s), to_float(1000))
        let off = int_mul(int_add(old_count, j), 8)
        mem_write_f64(int_add(new_ptr, off), f)
        j = int_add(j, 1)
    }
    buf[2] = new_count
    buf[3] = new_ptr
}

fn audio_stft(buf, window_size, hop_size) {
    let sample_count = buf[2]
    let data_ptr = buf[3]
    let frames = list_new()
    let frame_start = 0
    while int_add(frame_start, window_size) <= sample_count {
        let frame = list_new()
        let windowed = list_new()
        let wi = 0
        while wi < window_size {
            let sample_off = int_mul(int_add(frame_start, wi), 8)
            let sample_f = mem_read_f64(int_add(data_ptr, sample_off))
            let sample_s = from_float(float_mul(sample_f, to_float(1000)))
            let hann_arg = int_div(int_mul(int_mul(2, _audio_pi_s1000()), wi), window_size)
            let hann_cos = _audio_cos_approx(hann_arg)
            let hann_val = int_div(int_sub(1000, hann_cos), 2)
            let windowed_val = int_div(int_mul(sample_s, hann_val), 1000)
            push(windowed, windowed_val)
            wi = int_add(wi, 1)
        }
        let k = 0
        while k < window_size {
            let real_acc = 0
            let imag_acc = 0
            let n = 0
            while n < window_size {
                let angle = int_div(int_mul(int_mul(2, _audio_pi_s1000()), int_mul(k, n)), window_size)
                let cos_val = _audio_cos_approx(angle)
                let sin_val = _audio_sin_approx(angle)
                let xn = windowed[n]
                real_acc = int_add(real_acc, int_div(int_mul(xn, cos_val), 1000))
                imag_acc = int_sub(imag_acc, int_div(int_mul(xn, sin_val), 1000))
                n = int_add(n, 1)
            }
            let pair = list_new()
            push(pair, real_acc)
            push(pair, imag_acc)
            push(frame, pair)
            k = int_add(k, 1)
        }
        push(frames, frame)
        frame_start = int_add(frame_start, hop_size)
    }
    return frames
}

fn audio_magnitude_spectrum(frame) {
    let count = len(frame)
    let magnitudes = list_new()
    let i = 0
    while i < count {
        let pair = frame[i]
        let r = pair[0]
        let im = pair[1]
        let r2 = int_div(int_mul(r, r), 1000)
        let im2 = int_div(int_mul(im, im), 1000)
        let sum_sq = int_add(r2, im2)
        let mag = _audio_sqrt_approx(sum_sq)
        push(magnitudes, mag)
        i = int_add(i, 1)
    }
    return magnitudes
}

fn _audio_mel(f_s1000) {
    let ratio = int_add(1000, int_div(int_mul(f_s1000, 1000), 700000))
    let log_val = _audio_log10_approx_s1000(ratio)
    return int_div(int_mul(2595, log_val), 1000)
}

fn _audio_mel_inv(m_s1000) {
    let exponent = int_div(int_mul(m_s1000, 1000), 2595)
    let pow_val = 1000
    let term = exponent
    let term2 = int_div(int_mul(term, exponent), int_mul(1000, 2))
    let term3 = int_div(int_mul(term2, exponent), int_mul(1000, 3))
    let log10_e = 2302
    let x = int_div(int_mul(exponent, log10_e), 1000)
    let x2 = int_div(int_mul(x, x), 1000)
    let x3 = int_div(int_mul(x2, x), 1000)
    let x4 = int_div(int_mul(x3, x), 1000)
    pow_val = int_add(1000, int_add(x, int_add(int_div(x2, 2), int_add(int_div(x3, 6), int_div(x4, 24)))))
    return int_mul(700, int_sub(pow_val, 1000))
}

fn audio_mfcc(buf, num_coefficients) {
    let stft_window = 512
    let stft_hop = 256
    let num_filters = 26
    let sample_rate = buf[1]
    let stft_frames = audio_stft(buf, stft_window, stft_hop)
    let num_frames = len(stft_frames)
    let mfcc_result = list_new()
    let half_window = int_div(stft_window, 2)
    let nyquist = int_div(int_mul(sample_rate, 1000), 2)
    let mel_low = _audio_mel(0)
    let mel_high = _audio_mel(nyquist)
    let mel_points = list_new()
    let mi = 0
    while mi <= int_add(num_filters, 1) {
        let mel_val = int_add(mel_low, int_div(int_mul(int_sub(mel_high, mel_low), mi), int_add(num_filters, 1)))
        push(mel_points, mel_val)
        mi = int_add(mi, 1)
    }
    let bin_indices = list_new()
    let bi = 0
    while bi < len(mel_points) {
        let freq = _audio_mel_inv(mel_points[bi])
        let bin_val = int_div(int_mul(freq, stft_window), int_mul(sample_rate, 1000))
        if bin_val < 0 {
            bin_val = 0
        }
        if bin_val >= half_window {
            bin_val = int_sub(half_window, 1)
        }
        push(bin_indices, bin_val)
        bi = int_add(bi, 1)
    }
    let fi = 0
    while fi < num_frames {
        let frame = stft_frames[fi]
        let mag = audio_magnitude_spectrum(frame)
        let filter_energies = list_new()
        let filt = 0
        while filt < num_filters {
            let lo = bin_indices[filt]
            let center = bin_indices[int_add(filt, 1)]
            let hi = bin_indices[int_add(filt, 2)]
            let energy = 0
            let b = lo
            while b < center {
                if b < len(mag) {
                    let weight = 0
                    if center > lo {
                        weight = int_div(int_mul(int_sub(b, lo), 1000), int_sub(center, lo))
                    }
                    energy = int_add(energy, int_div(int_mul(mag[b], weight), 1000))
                }
                b = int_add(b, 1)
            }
            while b <= hi {
                if b < len(mag) {
                    let weight = 0
                    if hi > center {
                        weight = int_div(int_mul(int_sub(hi, b), 1000), int_sub(hi, center))
                    }
                    energy = int_add(energy, int_div(int_mul(mag[b], weight), 1000))
                }
                b = int_add(b, 1)
            }
            if energy < 1 {
                energy = 1
            }
            push(filter_energies, energy)
            filt = int_add(filt, 1)
        }
        let log_energies = list_new()
        let le = 0
        while le < num_filters {
            let log_val = _audio_log_approx_s1000(filter_energies[le])
            push(log_energies, log_val)
            le = int_add(le, 1)
        }
        let mfcc_vec = list_new()
        let ci = 0
        while ci < num_coefficients {
            let dct_val = 0
            let di = 0
            while di < num_filters {
                let angle = int_div(int_mul(_audio_pi_s1000(), int_mul(ci, int_add(int_mul(2, di), 1))), int_mul(2, num_filters))
                let cos_val = _audio_cos_approx(angle)
                dct_val = int_add(dct_val, int_div(int_mul(log_energies[di], cos_val), 1000))
                di = int_add(di, 1)
            }
            push(mfcc_vec, dct_val)
            ci = int_add(ci, 1)
        }
        push(mfcc_result, mfcc_vec)
        fi = int_add(fi, 1)
    }
    return mfcc_result
}

fn audio_voice_activity(buf, threshold) {
    let sample_count = buf[2]
    let data_ptr = buf[3]
    let frame_size = 320
    let num_frames = int_div(sample_count, frame_size)
    let frame_flags = list_new()
    let fi = 0
    while fi < num_frames {
        let energy = 0
        let si = 0
        while si < frame_size {
            let idx = int_add(int_mul(fi, frame_size), si)
            let sample_f = mem_read_f64(int_add(data_ptr, int_mul(idx, 8)))
            let sample_s = from_float(float_mul(sample_f, to_float(1000)))
            let sq = int_div(int_mul(sample_s, sample_s), 1000)
            energy = int_add(energy, sq)
            si = int_add(si, 1)
        }
        energy = int_div(energy, frame_size)
        if energy > threshold {
            push(frame_flags, 1)
        } else {
            push(frame_flags, 0)
        }
        fi = int_add(fi, 1)
    }
    let segments = list_new()
    let in_segment = 0
    let seg_start = 0
    let last_end_frame = 0 - 100
    let gi = 0
    while gi < num_frames {
        if frame_flags[gi] == 1 {
            if in_segment == 0 {
                if int_sub(gi, last_end_frame) < 5 {
                    let seg_count = len(segments)
                    if seg_count > 0 {
                        let prev_seg = segments[int_sub(seg_count, 1)]
                        seg_start = prev_seg[0]
                        let new_seg_count = int_sub(seg_count, 1)
                        let new_segments = list_new()
                        let ri = 0
                        while ri < new_seg_count {
                            push(new_segments, segments[ri])
                            ri = int_add(ri, 1)
                        }
                        segments = new_segments
                    } else {
                        seg_start = int_mul(gi, frame_size)
                    }
                } else {
                    seg_start = int_mul(gi, frame_size)
                }
                in_segment = 1
            }
        } else {
            if in_segment == 1 {
                let seg_end = int_mul(gi, frame_size)
                let seg = list_new()
                push(seg, seg_start)
                push(seg, seg_end)
                push(segments, seg)
                last_end_frame = gi
                in_segment = 0
            }
        }
        gi = int_add(gi, 1)
    }
    if in_segment == 1 {
        let seg_end = int_mul(num_frames, frame_size)
        let seg = list_new()
        push(seg, seg_start)
        push(seg, seg_end)
        push(segments, seg)
    }
    return segments
}

fn audio_normalize(buf) {
    let sample_count = buf[2]
    let data_ptr = buf[3]
    let sample_rate = buf[1]
    let max_abs = 0
    let i = 0
    while i < sample_count {
        let sample_f = mem_read_f64(int_add(data_ptr, int_mul(i, 8)))
        let sample_s = from_float(float_mul(sample_f, to_float(1000)))
        let abs_s = _audio_abs(sample_s)
        if abs_s > max_abs {
            max_abs = abs_s
        }
        i = int_add(i, 1)
    }
    if max_abs == 0 {
        max_abs = 1
    }
    let new_buf = list_new()
    push(new_buf, AUDIO_TAG)
    push(new_buf, sample_rate)
    push(new_buf, sample_count)
    let new_ptr = alloc(int_mul(sample_count, 8))
    let j = 0
    while j < sample_count {
        let sample_f = mem_read_f64(int_add(data_ptr, int_mul(j, 8)))
        let sample_s = from_float(float_mul(sample_f, to_float(1000)))
        let scaled = int_div(int_mul(sample_s, 1000), max_abs)
        let new_f = float_div(to_float(scaled), to_float(1000))
        mem_write_f64(int_add(new_ptr, int_mul(j, 8)), new_f)
        j = int_add(j, 1)
    }
    push(new_buf, new_ptr)
    return new_buf
}

fn audio_energy(buf, start, length) {
    let data_ptr = buf[3]
    if length <= 0 {
        return 0
    }
    let sum = 0
    let i = 0
    while i < length {
        let idx = int_add(start, i)
        let sample_f = mem_read_f64(int_add(data_ptr, int_mul(idx, 8)))
        let sample_s = from_float(float_mul(sample_f, to_float(1000)))
        let sq = int_div(int_mul(sample_s, sample_s), 1000)
        sum = int_add(sum, sq)
        i = int_add(i, 1)
    }
    return int_div(sum, length)
}
