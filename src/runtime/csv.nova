// Nova Standard Library: CSV Parser
// Parses CSV text into a list of rows (each row is a list of strings).
// Simple format: comma-delimited, newline-separated, no quoted fields.

fn csv_parse(text) {
    let rows = list_new()
    let row = list_new()
    let field = ""
    let i = 0
    let tlen = len(text)

    while i < tlen {
        let c = char_at(text, i)
        if c == 44 {
            // comma: end current field, start next
            push(row, field)
            field = ""
        } else {
            if c == 10 {
                // newline: end field and row
                push(row, field)
                push(rows, row)
                row = list_new()
                field = ""
            } else {
                if c == 13 {
                    // carriage return: end field and row, skip following LF
                    push(row, field)
                    push(rows, row)
                    row = list_new()
                    field = ""
                    if i + 1 < tlen {
                        if char_at(text, i + 1) == 10 {
                            i = i + 1
                        }
                    }
                } else {
                    field = field + chr(c)
                }
            }
        }
        i = i + 1
    }

    // flush last field/row if text doesn't end with newline
    if len(field) > 0 {
        push(row, field)
    }
    if len(row) > 0 {
        push(rows, row)
    }

    return rows
}

fn csv_get(data, row, col) {
    return data[row][col]
}

fn csv_row_count(data) {
    return len(data)
}

fn csv_col_count(data, row) {
    return len(data[row])
}

fn csv_to_string(data) {
    let result = ""
    let r = 0
    let nrows = len(data)
    while r < nrows {
        let row = data[r]
        let c = 0
        let ncols = len(row)
        while c < ncols {
            if c > 0 {
                result = result + ","
            }
            result = result + row[c]
            c = c + 1
        }
        result = result + chr(10)
        r = r + 1
    }
    return result
}
