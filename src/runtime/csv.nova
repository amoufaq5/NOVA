// Nova Standard Library: CSV Parser
// csv_parse: simple comma-delimited, newline-separated
// csv_parse_quoted: handles RFC 4180 quoted fields ("hello, world")

fn csv_parse(text) {
    let rows = list_new()
    let row = list_new()
    let field = ""
    let i = 0
    let tlen = len(text)

    while i < tlen {
        let c = char_at(text, i)
        if c == 44 {
            // comma: end current field, start next
            push(row, field)
            field = ""
        } else {
            if c == 10 {
                // newline: end field and row
                push(row, field)
                push(rows, row)
                row = list_new()
                field = ""
            } else {
                if c == 13 {
                    // carriage return: end field and row, skip following LF
                    push(row, field)
                    push(rows, row)
                    row = list_new()
                    field = ""
                    if i + 1 < tlen {
                        if char_at(text, i + 1) == 10 {
                            i = i + 1
                        }
                    }
                } else {
                    field = field + chr(c)
                }
            }
        }
        i = i + 1
    }

    // flush last field/row if text doesn't end with newline
    if len(field) > 0 {
        push(row, field)
    }
    if len(row) > 0 {
        push(rows, row)
    }

    return rows
}

fn csv_get(data, row, col) {
    return data[row][col]
}

fn csv_row_count(data) {
    return len(data)
}

fn csv_col_count(data, row) {
    return len(data[row])
}

fn csv_to_string(data) {
    let result = ""
    let r = 0
    let nrows = len(data)
    while r < nrows {
        let row = data[r]
        let c = 0
        let ncols = len(row)
        while c < ncols {
            if c > 0 {
                result = result + ","
            }
            result = result + row[c]
            c = c + 1
        }
        result = result + chr(10)
        r = r + 1
    }
    return result
}

fn csv_parse_quoted(text) {
    let rows = list_new()
    let row = list_new()
    let field = ""
    let in_quotes = 0
    let i = 0
    let tlen = len(text)
    while i < tlen {
        let c = char_at(text, i)
        if in_quotes == 1 {
            if c == 34 {
                if i + 1 < tlen {
                    if char_at(text, i + 1) == 34 {
                        field = field + chr(34)
                        i = i + 1
                    } else {
                        in_quotes = 0
                    }
                } else {
                    in_quotes = 0
                }
            } else {
                field = field + chr(c)
            }
        } else {
            if c == 34 {
                in_quotes = 1
            } else {
                if c == 44 {
                    push(row, field)
                    field = ""
                } else {
                    if c == 10 {
                        push(row, field)
                        push(rows, row)
                        row = list_new()
                        field = ""
                    } else {
                        if c == 13 {
                            push(row, field)
                            push(rows, row)
                            row = list_new()
                            field = ""
                            if i + 1 < tlen {
                                if char_at(text, i + 1) == 10 {
                                    i = i + 1
                                }
                            }
                        } else {
                            field = field + chr(c)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if len(field) > 0 {
        push(row, field)
    }
    if len(row) > 0 {
        push(rows, row)
    }
    return rows
}
