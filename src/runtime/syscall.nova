// Nova Runtime: Linux x86-64 syscall wrappers
// Each function uses inline assembly to execute the syscall instruction.
// Parameters are at [rbp-8], [rbp-16], [rbp-24], [rbp-32], [rbp-40], [rbp-48].

fn sys_read(fd, buf, count) {
    asm {
        "mov rax, 0"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "mov rdx, [rbp-24]"
        "syscall"
    }
}

fn sys_write(fd, buf, count) {
    asm {
        "mov rax, 1"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "mov rdx, [rbp-24]"
        "syscall"
    }
}

fn sys_open(path, flags, mode) {
    asm {
        "mov rax, 2"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "mov rdx, [rbp-24]"
        "syscall"
    }
}

fn sys_close(fd) {
    asm {
        "mov rax, 3"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

fn sys_lseek(fd, offset, whence) {
    asm {
        "mov rax, 8"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "mov rdx, [rbp-24]"
        "syscall"
    }
}

fn sys_mmap(addr, length, prot, flags, fd, offset) {
    asm {
        "mov rax, 9"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "mov rdx, [rbp-24]"
        "mov r10, [rbp-32]"
        "mov r8, [rbp-40]"
        "mov r9, [rbp-48]"
        "syscall"
    }
}

fn sys_munmap(addr, length) {
    asm {
        "mov rax, 11"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "syscall"
    }
}

fn sys_brk(addr) {
    asm {
        "mov rax, 12"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

fn sys_exit(code) {
    asm {
        "mov rax, 60"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

fn sys_getcwd(buf, size) {
    asm {
        "mov rax, 79"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "syscall"
    }
}

fn sys_mkdir(path, mode) {
    asm {
        "mov rax, 83"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "syscall"
    }
}

fn sys_unlink(path) {
    asm {
        "mov rax, 87"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

fn sys_fstat(fd, statbuf) {
    asm {
        "mov rax, 5"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "syscall"
    }
}

fn sys_fsync(fd) {
    asm {
        "mov rax, 74"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

fn sys_rename(oldpath, newpath) {
    asm {
        "mov rax, 82"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "syscall"
    }
}

// Constants
let O_RDONLY = 0
let O_WRONLY = 1
let O_RDWR = 2
let O_CREAT = 64
let O_TRUNC = 512
let O_APPEND = 1024

let SEEK_SET = 0
let SEEK_CUR = 1
let SEEK_END = 2

let PROT_READ = 1
let PROT_WRITE = 2
let PROT_EXEC = 4

let MAP_PRIVATE = 2
let MAP_ANONYMOUS = 32

let STDIN = 0
let STDOUT = 1
let STDERR = 2
