// Nova Runtime: Linux x86-64 syscall wrappers
//
// Tagging convention (ADR 0010: shims untag, the kernel sees raw values):
//   - fd arguments are passed through raw: sys_open returns a raw fd and
//     every caller threads it straight back in.
//   - path / buffer arguments are tag-polymorphic: a string literal arrives
//     raw, a NOVA string variable or alloc() buffer arrives tagged; untag
//     only when the low bit is set.
//   - integer arguments (count, mode, offset, whence, size, length) are
//     always tagged NOVA ints and are untagged unconditionally.
//   - results of read / write / lseek / pread / pwrite / getcwd / mkdir /
//     unlink / fstat / ftruncate are tagged when >= 0 (so `n == len(x)`,
//     `n == 0` and arithmetic work) and left raw when negative (-errno),
//     which keeps `n < 0` checks working. sys_open / sys_close stay raw.
// Before this, sys_read / sys_write returned raw byte counts (22 read as
// 11), and mkdir / unlink / lseek / pread / pwrite / ftruncate / getcwd /
// fstat passed tagged arguments straight to the kernel.
// Each function uses inline assembly to execute the syscall instruction.
// Parameters are at [rbp-8], [rbp-16], [rbp-24], [rbp-32], [rbp-40], [rbp-48].

// nova#10: `buf` is tag-polymorphic and `count` is untagged (see the
// convention at the top). The byte count returned is tagged when >= 0.
fn sys_read(fd, buf, count) {
    asm {
        "mov rax, 0"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .ntr_u1"
        "sar rsi, 1"
        ".ntr_u1:"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "syscall"
        "test rax, rax"
        "js .ntr_ret"
        "lea rax, [rax + rax + 1]"
        ".ntr_ret:"
    }
}

// nova#10: same untag discipline for sys_write — tagged `buf` from
// alloc walks to a bogus address and short-writes; tagged `count`
// writes 2*n+1 bytes starting at a raw literal address (NOVA Bug #5
// documented in io.nova's io_eprint comment).
fn sys_write(fd, buf, count) {
    asm {
        "mov rax, 1"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .ntw_u1"
        "sar rsi, 1"
        ".ntw_u1:"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "syscall"
        "test rax, rax"
        "js .ntw_ret"
        "lea rax, [rax + rax + 1]"
        ".ntw_ret:"
    }
}

// Bug #12 R11-a: untag flags + mode so the kernel sees raw bitmasks.
// `O_WRONLY|O_CREAT|O_TRUNC = 0x241` was arriving tagged as `0x483 =
// (0x241<<1)|1`, which the kernel decoded as `O_ACCMODE|O_EXCL|O_APPEND`
// (no O_CREAT) -> ENOENT and silent snap_write failures. See Crossengin
// docs/UPSTREAM_NOVA_BUGS.md §12. `path` is tag-polymorphic (handles
// raw string literals + tagged alloc buffers). Return left raw: all
// callers use `fd < 0` which works for both raw fd and raw -errno.
fn sys_open(path, flags, mode) {
    asm {
        "mov rax, 2"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .so_u"
        "sar rdi, 1"
        ".so_u:"
        "mov rsi, [rbp-16]"
        "sar rsi, 1"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "syscall"
    }
}

fn sys_close(fd) {
    asm {
        "mov rax, 3"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

fn sys_lseek(fd, offset, whence) {
    asm {
        "mov rax, 8"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "sar rsi, 1"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "syscall"
        "test rax, rax"
        "js .ntl_ret"
        "lea rax, [rax + rax + 1]"
        ".ntl_ret:"
    }
}

fn sys_mmap(addr, length, prot, flags, fd, offset) {
    asm {
        "mov rax, 9"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "mov rdx, [rbp-24]"
        "mov r10, [rbp-32]"
        "mov r8, [rbp-40]"
        "mov r9, [rbp-48]"
        "syscall"
    }
}

fn sys_munmap(addr, length) {
    asm {
        "mov rax, 11"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "syscall"
    }
}

fn sys_brk(addr) {
    asm {
        "mov rax, 12"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

fn sys_exit(code) {
    asm {
        "mov rax, 60"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

fn sys_getcwd(buf, size) {
    asm {
        "mov rax, 79"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .ntg_u0"
        "sar rdi, 1"
        ".ntg_u0:"
        "mov rsi, [rbp-16]"
        "sar rsi, 1"
        "syscall"
        "test rax, rax"
        "js .ntg_ret"
        "lea rax, [rax + rax + 1]"
        ".ntg_ret:"
    }
}

fn sys_mkdir(path, mode) {
    asm {
        "mov rax, 83"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .ntm_u0"
        "sar rdi, 1"
        ".ntm_u0:"
        "mov rsi, [rbp-16]"
        "sar rsi, 1"
        "syscall"
        "test rax, rax"
        "js .ntm_ret"
        "lea rax, [rax + rax + 1]"
        ".ntm_ret:"
    }
}

fn sys_unlink(path) {
    asm {
        "mov rax, 87"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .ntu_u0"
        "sar rdi, 1"
        ".ntu_u0:"
        "syscall"
        "test rax, rax"
        "js .ntu_ret"
        "lea rax, [rax + rax + 1]"
        ".ntu_ret:"
    }
}

fn sys_fstat(fd, statbuf) {
    asm {
        "mov rax, 5"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .ntf_u1"
        "sar rsi, 1"
        ".ntf_u1:"
        "syscall"
        "test rax, rax"
        "js .ntf_ret"
        "lea rax, [rax + rax + 1]"
        ".ntf_ret:"
    }
}

fn sys_fsync(fd) {
    asm {
        "mov rax, 74"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

// Bug #12 R11-c: untag path args + sign-aware return tag so callers'
// `if rr != 0` compares vs tagged literal 0 (in-memory 1) correctly
// detect kernel success (raw 0 -> tagged 1 match) vs failure (raw
// -errno stays raw negative, caller's < 0 branch catches it). Single
// CE caller is snap_write_durable (snapshot_disk.nova:2745).
fn sys_rename(oldpath, newpath) {
    asm {
        "mov rax, 82"
        "mov rdi, [rbp-8]"
        "test rdi, 1"
        "jz .srn_u1"
        "sar rdi, 1"
        ".srn_u1:"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .srn_u2"
        "sar rsi, 1"
        ".srn_u2:"
        "syscall"
        "test rax, rax"
        "js .srn_ret"
        "lea rax, [rax + rax + 1]"
        ".srn_ret:"
    }
}

// Positioned read: pread(fd, buf, count, offset) -- read at an absolute file
// offset without moving the file's read/write cursor (syscall 17). The 4th
// syscall argument is passed in r10, not rcx. Returns bytes read, or < 0.
fn sys_pread(fd, buf, count, offset) {
    asm {
        "mov rax, 17"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .ntpr_u1"
        "sar rsi, 1"
        ".ntpr_u1:"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "mov r10, [rbp-32]"
        "sar r10, 1"
        "syscall"
        "test rax, rax"
        "js .ntpr_ret"
        "lea rax, [rax + rax + 1]"
        ".ntpr_ret:"
    }
}

// Positioned write: pwrite(fd, buf, count, offset) -- write at an absolute file
// offset without moving the cursor (syscall 18). Returns bytes written, or < 0.
fn sys_pwrite(fd, buf, count, offset) {
    asm {
        "mov rax, 18"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "test rsi, 1"
        "jz .ntpw_u1"
        "sar rsi, 1"
        ".ntpw_u1:"
        "mov rdx, [rbp-24]"
        "sar rdx, 1"
        "mov r10, [rbp-32]"
        "sar r10, 1"
        "syscall"
        "test rax, rax"
        "js .ntpw_ret"
        "lea rax, [rax + rax + 1]"
        ".ntpw_ret:"
    }
}

// fdatasync(fd) -- flush file DATA to stable storage, skipping non-essential
// metadata (syscall 75). Cheaper than fsync for the append-only WAL hot path,
// while still guaranteeing the written bytes survive a crash. Returns 0, or < 0.
fn sys_fdatasync(fd) {
    asm {
        "mov rax, 75"
        "mov rdi, [rbp-8]"
        "syscall"
    }
}

// ftruncate(fd, length) -- set the file size to `length` (syscall 77). Used by
// recovery to drop a torn trailing record. Returns 0, or < 0.
fn sys_ftruncate(fd, length) {
    asm {
        "mov rax, 77"
        "mov rdi, [rbp-8]"
        "mov rsi, [rbp-16]"
        "sar rsi, 1"
        "syscall"
        "test rax, rax"
        "js .ntt_ret"
        "lea rax, [rax + rax + 1]"
        ".ntt_ret:"
    }
}

// Constants
let O_RDONLY = 0
let O_WRONLY = 1
let O_RDWR = 2
let O_CREAT = 64
let O_TRUNC = 512
let O_APPEND = 1024

let SEEK_SET = 0
let SEEK_CUR = 1
let SEEK_END = 2

let PROT_READ = 1
let PROT_WRITE = 2
let PROT_EXEC = 4

let MAP_PRIVATE = 2
let MAP_ANONYMOUS = 32

let STDIN = 0
let STDOUT = 1
let STDERR = 2
