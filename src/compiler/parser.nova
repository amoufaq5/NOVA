// Nova Compiler: Parser
// Transforms a token list into an AST.
// Uses recursive descent with precedence climbing.

let par_tokens = 0
let par_pos = 0
let par_count = 0
let par_lambda_count = 0
let par_lambdas = 0
let par_consts = 0

fn par_init(tokens) {
    par_tokens = tokens
    par_pos = 0
    par_count = len(tokens)
    par_lambda_count = 0
    par_lambdas = list_new()
    par_consts = list_new()
}

fn par_peek() {
    if par_pos >= par_count {
        return 0
    }
    return par_tokens[par_pos]
}

fn par_peek_type() {
    let tok = par_peek()
    if tok == 0 { return TOK_EOF }
    return tok[0]
}

fn par_peek_val() {
    let tok = par_peek()
    if tok == 0 { return 0 }
    return tok[1]
}

fn par_advance() {
    let tok = par_peek()
    par_pos = par_pos + 1
    return tok
}

fn token_type_name(t) {
    if t == 0 { return "EOF" }
    if t == 1 { return "integer" }
    if t == 2 { return "float" }
    if t == 3 { return "string" }
    if t == 4 { return "identifier" }
    if t == 10 { return "+" }
    if t == 11 { return "-" }
    if t == 12 { return "*" }
    if t == 13 { return "/" }
    if t == 15 { return "=" }
    if t == 16 { return "!" }
    if t == 20 { return "==" }
    if t == 21 { return "!=" }
    if t == 22 { return "<=" }
    if t == 23 { return ">=" }
    if t == 30 { return "(" }
    if t == 31 { return ")" }
    if t == 32 { return "{" }
    if t == 33 { return "}" }
    if t == 34 { return "[" }
    if t == 35 { return "]" }
    if t == 36 { return "," }
    if t == 37 { return ":" }
    if t == 38 { return ";" }
    if t == 50 { return "let" }
    if t == 51 { return "fn" }
    if t == 52 { return "if" }
    if t == 53 { return "else" }
    if t == 54 { return "while" }
    if t == 55 { return "for" }
    if t == 56 { return "in" }
    if t == 57 { return "return" }
    if t == 58 { return "true" }
    if t == 59 { return "false" }
    if t == 60 { return "none" }
    if t == 61 { return "struct" }
    if t == 62 { return "break" }
    if t == 63 { return "continue" }
    if t == 64 { return "import" }
    if t == 65 { return "const" }
    if t == 66 { return "match" }
    if t == 67 { return "=>" }
    if t == 68 { return "_" }
    if t == 69 { return "try" }
    if t == 70 { return "catch" }
    if t == 71 { return "throw" }
    if t == 77 { return "enum" }
    if t == 78 { return "+=" }
    if t == 79 { return "-=" }
    if t == 80 { return "*=" }
    if t == 81 { return "/=" }
    if t == 82 { return "%=" }
    if t == 83 { return "?" }
    if t == 84 { return "do" }
    return concat("token(", concat(int_to_str(t), ")"))
}

fn par_expect(typ) {
    let t = par_peek_type()
    if t == typ {
    } else {
        let tok = par_peek()
        let line = 0
        let col = 0
        if tok == 0 {
        } else {
            line = tok[2]
            col = tok[3]
        }
        print("Error at line ")
        print_int(line)
        print(", col ")
        print_int(col)
        print(": expected ")
        print(token_type_name(typ))
        print(" but got ")
        println(token_type_name(t))
        exit(1)
    }
    return par_advance()
}

fn par_match(typ) {
    if par_peek_type() == typ {
        par_advance()
        return 1
    }
    return 0
}

fn par_skip_type() {
    par_expect(TOK_IDENT)
    if par_peek_type() == TOK_LT {
        par_advance()
        let depth = 1
        let tdone = 0
        while tdone == 0 {
            let tt = par_peek_type()
            if tt == TOK_LT { depth = depth + 1 }
            if tt == TOK_GT { depth = depth - 1 }
            if tt == TOK_EOF {
                println("Error: unexpected EOF in type annotation")
                exit(1)
            }
            if depth == 0 { tdone = 1 }
            par_advance()
        }
    }
}

// --- String Interpolation ---

fn parse_interpolated_string(s) {
    let parts = list_new()
    let i = 0
    let start = 0
    let slen = len(s)

    while i < slen {
        if i + 1 < slen {
            if char_at(s, i) == 36 {
                if char_at(s, i + 1) == 123 {
                    // Found ${
                    // Add literal part before this
                    if i > start {
                        push(parts, ast_str(substr(s, start, i - start)))
                    }
                    // Find matching }
                    let j = i + 2
                    let depth = 1
                    while j < slen {
                        if char_at(s, j) == 125 {
                            depth = depth - 1
                            if depth == 0 {
                                // Extract expression string
                                let expr_str = substr(s, i + 2, j - i - 2)
                                // Tokenize and parse the expression
                                let expr_tokens = tokenize(expr_str)
                                let saved_tokens = par_tokens
                                let saved_pos = par_pos
                                let saved_count = par_count
                                par_init(expr_tokens)
                                let expr = parse_expr()
                                par_tokens = saved_tokens
                                par_pos = saved_pos
                                par_count = saved_count
                                // Wrap in to_str() call for safe conversion
                                let to_str_args = list_new()
                                push(to_str_args, expr)
                                let wrapped = ast_call(ast_ident("to_str"), to_str_args)
                                push(parts, wrapped)
                                start = j + 1
                                i = j + 1
                                j = slen
                            } else {
                                j = j + 1
                            }
                        } else {
                            if char_at(s, j) == 123 {
                                depth = depth + 1
                            }
                            j = j + 1
                        }
                    }
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }

    // Add remaining literal
    if start < slen {
        push(parts, ast_str(substr(s, start, slen - start)))
    }

    // Build concatenation chain
    if len(parts) == 0 {
        return ast_str("")
    }
    let result = parts[0]
    let pi = 1
    while pi < len(parts) {
        result = ast_binop("+", result, parts[pi])
        pi = pi + 1
    }
    return result
}

// --- Expression Parsing (precedence climbing) ---

fn parse_primary() {
    let t = par_peek_type()

    if t == TOK_INT {
        let tok = par_advance()
        return ast_int(tok[1])
    }
    if t == TOK_FLOAT {
        let tok = par_advance()
        return ast_float(tok[1])
    }
    if t == TOK_STRING {
        let tok = par_advance()
        let s = tok[1]
        // Check for interpolation: scan for ${ pattern
        let has_interp = 0
        let si = 0
        let slen = len(s)
        while si + 1 < slen {
            if char_at(s, si) == 36 {
                if char_at(s, si + 1) == 123 {
                    has_interp = 1
                    si = slen
                } else {
                    si = si + 1
                }
            } else {
                si = si + 1
            }
        }
        if has_interp == 0 {
            return ast_str(s)
        }
        return parse_interpolated_string(s)
    }
    if t == TOK_TRUE {
        par_advance()
        return ast_bool(1)
    }
    if t == TOK_FALSE {
        par_advance()
        return ast_bool(0)
    }
    if t == TOK_NONE {
        par_advance()
        return ast_none()
    }
    if t == TOK_IDENT {
        let tok = par_advance()
        return ast_ident(tok[1])
    }
    if t == TOK_LPAREN {
        par_advance()
        let expr = parse_expr()
        par_expect(TOK_RPAREN)
        return expr
    }
    if t == TOK_LBRACKET {
        par_advance()
        let elems = list_new()
        if par_peek_type() == TOK_RBRACKET {
        } else {
            push(elems, parse_expr())
            while par_peek_type() == TOK_COMMA {
                par_advance()
                push(elems, parse_expr())
            }
        }
        par_expect(TOK_RBRACKET)
        return ast_list(elems)
    }
    if t == TOK_MINUS {
        par_advance()
        let operand = parse_unary()
        return ast_unary("-", operand)
    }
    if t == TOK_BANG {
        par_advance()
        let operand = parse_unary()
        return ast_unary("!", operand)
    }
    if t == TOK_FN {
        // Check if this is a lambda: fn( without identifier
        let next_pos = par_pos + 1
        if next_pos < par_count {
            let next_tok = par_tokens[next_pos]
            if next_tok[0] == TOK_LPAREN {
                // Lambda expression
                par_advance()
                par_expect(TOK_LPAREN)
                let params = list_new()
                if par_peek_type() == TOK_RPAREN {
                } else {
                    let p = par_expect(TOK_IDENT)
                    push(params, p[1])
                    if par_peek_type() == TOK_COLON {
                        par_advance()
                        par_skip_type()
                    }
                    while par_peek_type() == TOK_COMMA {
                        par_advance()
                        let p2 = par_expect(TOK_IDENT)
                        push(params, p2[1])
                        if par_peek_type() == TOK_COLON {
                            par_advance()
                            par_skip_type()
                        }
                    }
                }
                par_expect(TOK_RPAREN)
                if par_peek_type() == TOK_COLON {
                    par_advance()
                    par_skip_type()
                }
                let body = parse_block()
                let lname = "_lambda_" + int_to_str(par_lambda_count)
                par_lambda_count = par_lambda_count + 1
                let fn_node = ast_fn_decl(lname, params, body)
                push(par_lambdas, fn_node)
                return ast_lambda(lname, params, body)
            }
        }
    }
    // Unexpected token
    print("Error at line ")
    let err_tok = par_peek()
    if err_tok == 0 {
        print_int(0)
    } else {
        print_int(err_tok[2])
    }
    print(": unexpected ")
    println(token_type_name(t))
    exit(1)
    return ast_none()
}

fn parse_unary() {
    return parse_primary()
}

fn parse_postfix() {
    let expr = parse_unary()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_LPAREN {
            // Function call
            par_advance()
            let args = list_new()
            if par_peek_type() == TOK_RPAREN {
            } else {
                push(args, parse_expr())
                while par_peek_type() == TOK_COMMA {
                    par_advance()
                    push(args, parse_expr())
                }
            }
            par_expect(TOK_RPAREN)
            expr = ast_call(expr, args)
        } else {
            if t == TOK_LBRACKET {
                par_advance()
                let idx = parse_expr()
                par_expect(TOK_RBRACKET)
                expr = ast_index(expr, idx)
            } else {
                if t == TOK_DOT {
                    par_advance()
                    let field_tok = par_expect(TOK_IDENT)
                    expr = ast_field_access(expr, field_tok[1])
                } else {
                    return expr
                }
            }
        }
    }
    return expr
}

fn parse_mul() {
    let left = parse_postfix()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_STAR {
            par_advance()
            let right = parse_postfix()
            left = ast_binop("*", left, right)
        } else {
            if t == TOK_SLASH {
                par_advance()
                let right = parse_postfix()
                left = ast_binop("/", left, right)
            } else {
                if t == TOK_PERCENT {
                    par_advance()
                    let right = parse_postfix()
                    left = ast_binop("%", left, right)
                } else {
                    return left
                }
            }
        }
    }
    return left
}

fn parse_add() {
    let left = parse_mul()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_PLUS {
            par_advance()
            let right = parse_mul()
            left = ast_binop("+", left, right)
        } else {
            if t == TOK_MINUS {
                par_advance()
                let right = parse_mul()
                left = ast_binop("-", left, right)
            } else {
                return left
            }
        }
    }
    return left
}

fn parse_bitwise() {
    let left = parse_add()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_AMP {
            par_advance()
            let right = parse_add()
            left = ast_binop("&", left, right)
        } else { if t == TOK_PIPE {
            par_advance()
            let right = parse_add()
            left = ast_binop("|", left, right)
        } else { if t == TOK_CARET {
            par_advance()
            let right = parse_add()
            left = ast_binop("^", left, right)
        } else { if t == TOK_SHL {
            par_advance()
            let right = parse_add()
            left = ast_binop("<<", left, right)
        } else { if t == TOK_SHR {
            par_advance()
            let right = parse_add()
            left = ast_binop(">>", left, right)
        } else {
            return left
        } } } } }
    }
    return left
}

fn parse_cmp() {
    let left = parse_bitwise()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_LT {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop("<", left, right)
        } else { if t == TOK_GT {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop(">", left, right)
        } else { if t == TOK_LTEQ {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop("<=", left, right)
        } else { if t == TOK_GTEQ {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop(">=", left, right)
        } else { if t == TOK_EQEQ {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop("==", left, right)
        } else { if t == TOK_BANGEQ {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop("!=", left, right)
        } else {
            return left
        } } } } } }
    }
    return left
}

fn parse_and() {
    let left = parse_cmp()
    while par_peek_type() == TOK_AND {
        par_advance()
        let right = parse_cmp()
        left = ast_and(left, right)
    }
    return left
}

fn parse_or() {
    let left = parse_and()
    while par_peek_type() == TOK_OR {
        par_advance()
        let right = parse_and()
        left = ast_or(left, right)
    }
    return left
}

fn parse_expr() {
    let left = parse_or()
    if par_peek_type() == TOK_QUESTION {
        par_advance()
        let then_val = parse_expr()
        par_expect(TOK_COLON)
        let else_val = parse_expr()
        return ast_ternary(left, then_val, else_val)
    }
    return left
}

// --- Statement Parsing ---

fn parse_block() {
    par_expect(TOK_LBRACE)
    let stmts = list_new()
    let block_done = 0
    while block_done == 0 {
        if par_peek_type() == TOK_RBRACE {
            block_done = 1
        } else {
            if par_peek_type() == TOK_EOF {
                println("Error: unexpected end of file inside block (missing closing '}')")
                exit(1)
            } else {
                if par_peek_type() == TOK_SEMI {
                    par_advance()
                } else {
                    push(stmts, parse_stmt())
                }
            }
        }
    }
    par_expect(TOK_RBRACE)
    return ast_block(stmts)
}

fn parse_if() {
    par_expect(TOK_IF)
    let cond = parse_expr()
    let then_body = parse_block()
    let else_body = 0
    if par_peek_type() == TOK_ELSE {
        par_advance()
        if par_peek_type() == TOK_IF {
            else_body = parse_if()
        } else {
            else_body = parse_block()
        }
    }
    return ast_if(cond, then_body, else_body)
}

fn parse_while() {
    par_expect(TOK_WHILE)
    let cond = parse_expr()
    let body = parse_block()
    return ast_while(cond, body)
}

fn parse_for() {
    par_expect(TOK_FOR)
    let var_tok = par_expect(TOK_IDENT)
    let var_name = var_tok[1]
    par_expect(TOK_IN)
    let iter = parse_expr()
    let body = parse_block()
    return ast_for(var_name, iter, body)
}

fn parse_let() {
    let t = par_peek_type()
    let is_const_decl = 0
    if t == TOK_CONST {
        is_const_decl = 1
        par_advance()
    } else {
        par_expect(TOK_LET)
    }
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    if par_peek_type() == TOK_COLON {
        par_advance()
        par_skip_type()
    }
    par_expect(TOK_EQ)
    let value = parse_expr()
    if is_const_decl == 1 {
        push(par_consts, name)
    }
    return ast_let(name, value)
}

fn parse_fn() {
    par_expect(TOK_FN)
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    par_expect(TOK_LPAREN)
    let params = list_new()
    if par_peek_type() == TOK_RPAREN {
    } else {
        let p = par_expect(TOK_IDENT)
        push(params, p[1])
        if par_peek_type() == TOK_COLON {
            par_advance()
            par_skip_type()
        }
        while par_peek_type() == TOK_COMMA {
            par_advance()
            let p2 = par_expect(TOK_IDENT)
            push(params, p2[1])
            if par_peek_type() == TOK_COLON {
                par_advance()
                par_skip_type()
            }
        }
    }
    par_expect(TOK_RPAREN)
    if par_peek_type() == TOK_COLON {
        par_advance()
        par_skip_type()
    }
    let body = parse_block()
    return ast_fn_decl(name, params, body)
}

fn parse_return() {
    par_expect(TOK_RETURN)
    let t = par_peek_type()
    if t == TOK_RBRACE {
        return ast_return(0)
    }
    if t == TOK_EOF {
        return ast_return(0)
    }
    let value = parse_expr()
    return ast_return(value)
}

fn parse_struct_decl() {
    par_expect(TOK_STRUCT)
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    par_expect(TOK_LBRACE)
    let fields = list_new()
    let struct_done = 0
    while struct_done == 0 {
        if par_peek_type() == TOK_RBRACE {
            struct_done = 1
        } else {
            if par_peek_type() == TOK_COMMA {
                par_advance()
            } else {
                let f = par_expect(TOK_IDENT)
                push(fields, f[1])
            }
        }
    }
    par_expect(TOK_RBRACE)
    return ast_struct_decl(name, fields)
}

fn parse_match() {
    par_expect(TOK_MATCH)
    let expr = parse_expr()
    par_expect(TOK_LBRACE)
    let arms = list_new()
    while par_peek_type() != TOK_RBRACE {
        if par_peek_type() == TOK_EOF {
            println("Error: unexpected EOF in match")
            exit(1)
        }
        // Parse pattern
        let pattern = 0
        if par_peek_type() == TOK_UNDERSCORE {
            par_advance()
            pattern = ast_wildcard()
        } else {
            pattern = parse_expr()
        }
        par_expect(TOK_ARROW)
        // Parse body - either a block or a single expression
        let body = 0
        if par_peek_type() == TOK_LBRACE {
            body = parse_block()
        } else {
            body = ast_expr_stmt(parse_expr())
        }
        push(arms, ast_match_arm(pattern, body))
    }
    par_expect(TOK_RBRACE)
    return ast_match(expr, arms)
}

fn parse_try() {
    par_expect(TOK_TRY)
    let try_body = parse_block()
    par_expect(TOK_CATCH)
    let catch_body = parse_block()
    return ast_try_catch(try_body, catch_body)
}

fn parse_throw() {
    par_expect(TOK_THROW)
    let value = parse_expr()
    return ast_throw(value)
}

fn parse_stmt() {
    let t = par_peek_type()
    if t == TOK_LET { return parse_let() }
    if t == TOK_CONST { return parse_let() }
    if t == TOK_FN { return parse_fn() }
    if t == TOK_IF { return parse_if() }
    if t == TOK_WHILE { return parse_while() }
    if t == TOK_FOR { return parse_for() }
    if t == TOK_RETURN { return parse_return() }
    if t == TOK_BREAK { par_advance(); return ast_break() }
    if t == TOK_CONTINUE { par_advance(); return ast_continue() }
    if t == TOK_STRUCT { return parse_struct_decl() }
    if t == TOK_MATCH { return parse_match() }
    if t == TOK_TRY { return parse_try() }
    if t == TOK_THROW { return parse_throw() }
    if t == TOK_ENUM { return parse_enum() }
    if t == TOK_DO { return parse_do_while() }

    // Assignment or expression statement
    let expr = parse_expr()
    if par_peek_type() == TOK_EQ {
        par_advance()
        let value = parse_expr()
        if ast_tag(expr) == AST_INDEX_EXPR {
            return ast_index_assign(expr[1], expr[2], value)
        }
        if ast_tag(expr) == AST_FIELD_ACCESS {
            return ast_field_assign(expr[1], expr[2], value)
        }
        let name = expr[1]
        let ci = 0
        while ci < len(par_consts) {
            if par_consts[ci] == name {
                print("Error: cannot reassign const variable: ")
                println(name)
                exit(1)
            }
            ci = ci + 1
        }
        return ast_assign(name, value)
    }
    // Compound assignment: +=, -=, *=, /=, %=
    let pt = par_peek_type()
    let compound_op = ""
    if pt == TOK_PLUS_EQ { compound_op = "+" }
    if pt == TOK_MINUS_EQ { compound_op = "-" }
    if pt == TOK_STAR_EQ { compound_op = "*" }
    if pt == TOK_SLASH_EQ { compound_op = "/" }
    if pt == TOK_PERCENT_EQ { compound_op = "%" }
    if compound_op == "" {
    } else {
        par_advance()
        let rhs = parse_expr()
        if ast_tag(expr) == AST_INDEX_EXPR {
            let base = expr[1]
            let idx = expr[2]
            return ast_index_assign(base, idx, ast_binop(compound_op, ast_index(base, idx), rhs))
        }
        if ast_tag(expr) == AST_FIELD_ACCESS {
            let fbase = expr[1]
            let fname = expr[2]
            return ast_field_assign(fbase, fname, ast_binop(compound_op, ast_field_access(fbase, fname), rhs))
        }
        let name = expr[1]
        let ci = 0
        while ci < len(par_consts) {
            if par_consts[ci] == name {
                print("Error: cannot reassign const variable: ")
                println(name)
                exit(1)
            }
            ci = ci + 1
        }
        return ast_assign(name, ast_binop(compound_op, ast_ident(name), rhs))
    }
    return ast_expr_stmt(expr)
}

fn parse_do_while() {
    par_expect(TOK_DO)
    let body = parse_block()
    par_expect(TOK_WHILE)
    let cond = parse_expr()
    return ast_do_while(body, cond)
}

fn parse_enum() {
    par_expect(TOK_ENUM)
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    par_expect(TOK_LBRACE)
    let variants = list_new()
    let enum_done = 0
    while enum_done == 0 {
        if par_peek_type() == TOK_RBRACE {
            enum_done = 1
        } else {
            if par_peek_type() == TOK_COMMA {
                par_advance()
            } else {
                let v = par_expect(TOK_IDENT)
                push(variants, v[1])
            }
        }
    }
    par_expect(TOK_RBRACE)
    return ast_enum_decl(name, variants)
}

fn parse_program(tokens) {
    par_init(tokens)
    let decls = list_new()
    let done = 0
    while done == 0 {
        if par_peek_type() == TOK_EOF {
            done = 1
        } else {
            if par_peek_type() == TOK_SEMI {
                par_advance()
            } else {
                push(decls, parse_stmt())
            }
        }
    }
    return ast_program(decls)
}
