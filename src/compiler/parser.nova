// Nova Compiler: Parser
// Transforms a token list into an AST.
// Uses recursive descent with precedence climbing.

let par_tokens = 0
let par_pos = 0
let par_count = 0
let par_lambda_count = 0
let par_lambdas = 0
let par_consts = 0

fn par_init(tokens) {
    par_tokens = tokens
    par_pos = 0
    par_count = len(tokens)
    par_lambda_count = 0
    par_lambdas = list_new()
    par_consts = list_new()
}

fn par_peek() {
    if par_pos >= par_count {
        return 0
    }
    return par_tokens[par_pos]
}

fn par_peek_type() {
    let tok = par_peek()
    if tok == 0 { return TOK_EOF }
    return tok[0]
}

fn par_peek_val() {
    let tok = par_peek()
    if tok == 0 { return 0 }
    return tok[1]
}

fn par_advance() {
    let tok = par_peek()
    par_pos = par_pos + 1
    return tok
}

fn token_type_name(t) {
    if t == 0 { return "EOF" }
    if t == 1 { return "integer" }
    if t == 2 { return "float" }
    if t == 3 { return "string" }
    if t == 4 { return "identifier" }
    if t == 10 { return "+" }
    if t == 11 { return "-" }
    if t == 12 { return "*" }
    if t == 13 { return "/" }
    if t == 15 { return "=" }
    if t == 16 { return "!" }
    if t == 20 { return "==" }
    if t == 21 { return "!=" }
    if t == 22 { return "<=" }
    if t == 23 { return ">=" }
    if t == 30 { return "(" }
    if t == 31 { return ")" }
    if t == 32 { return "{" }
    if t == 33 { return "}" }
    if t == 34 { return "[" }
    if t == 35 { return "]" }
    if t == 36 { return "," }
    if t == 37 { return ":" }
    if t == 38 { return ";" }
    if t == 50 { return "let" }
    if t == 51 { return "fn" }
    if t == 52 { return "if" }
    if t == 53 { return "else" }
    if t == 54 { return "while" }
    if t == 55 { return "for" }
    if t == 56 { return "in" }
    if t == 57 { return "return" }
    if t == 58 { return "true" }
    if t == 59 { return "false" }
    if t == 60 { return "none" }
    if t == 61 { return "struct" }
    if t == 62 { return "break" }
    if t == 63 { return "continue" }
    if t == 64 { return "import" }
    if t == 65 { return "const" }
    if t == 66 { return "match" }
    if t == 67 { return "=>" }
    if t == 68 { return "_" }
    if t == 69 { return "try" }
    if t == 70 { return "catch" }
    if t == 71 { return "throw" }
    if t == 77 { return "enum" }
    if t == 78 { return "+=" }
    if t == 79 { return "-=" }
    if t == 80 { return "*=" }
    if t == 81 { return "/=" }
    if t == 82 { return "%=" }
    if t == 83 { return "?" }
    if t == 84 { return "do" }
    return concat("token(", concat(int_to_str(t), ")"))
}

fn par_expect(typ) {
    let t = par_peek_type()
    if t == typ {
    } else {
        let tok = par_peek()
        let line = 0
        let col = 0
        if tok == 0 {
        } else {
            line = tok[2]
            col = tok[3]
        }
        print("Error at line ")
        print_int(line)
        print(", col ")
        print_int(col)
        print(": expected ")
        print(token_type_name(typ))
        print(" but got ")
        println(token_type_name(t))
        exit(1)
    }
    return par_advance()
}

fn par_match(typ) {
    if par_peek_type() == typ {
        par_advance()
        return 1
    }
    return 0
}

fn par_skip_type() {
    par_expect(TOK_IDENT)
    if par_peek_type() == TOK_LT {
        par_advance()
        let depth = 1
        let tdone = 0
        while tdone == 0 {
            let tt = par_peek_type()
            if tt == TOK_LT { depth = depth + 1 }
            if tt == TOK_GT { depth = depth - 1 }
            if tt == TOK_EOF {
                println("Error: unexpected EOF in type annotation")
                exit(1)
            }
            if depth == 0 { tdone = 1 }
            par_advance()
        }
    }
}

// --- String Interpolation ---

fn parse_interpolated_string(s) {
    let parts = list_new()
    let i = 0
    let start = 0
    let slen = len(s)

    while i < slen {
        if i + 1 < slen {
            if char_at(s, i) == 36 {
                if char_at(s, i + 1) == 123 {
                    // Found ${
                    // Add literal part before this
                    if i > start {
                        push(parts, ast_str(substr(s, start, i - start)))
                    }
                    // Find matching }
                    let j = i + 2
                    let depth = 1
                    while j < slen {
                        if char_at(s, j) == 125 {
                            depth = depth - 1
                            if depth == 0 {
                                // Extract expression string
                                let expr_str = substr(s, i + 2, j - i - 2)
                                // Tokenize and parse the expression
                                let expr_tokens = tokenize(expr_str)
                                let saved_tokens = par_tokens
                                let saved_pos = par_pos
                                let saved_count = par_count
                                par_init(expr_tokens)
                                let expr = parse_expr()
                                par_tokens = saved_tokens
                                par_pos = saved_pos
                                par_count = saved_count
                                // Wrap in to_str() call for safe conversion
                                let to_str_args = list_new()
                                push(to_str_args, expr)
                                let wrapped = ast_call(ast_ident("to_str"), to_str_args)
                                push(parts, wrapped)
                                start = j + 1
                                i = j + 1
                                j = slen
                            } else {
                                j = j + 1
                            }
                        } else {
                            if char_at(s, j) == 123 {
                                depth = depth + 1
                            }
                            j = j + 1
                        }
                    }
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }

    // Add remaining literal
    if start < slen {
        push(parts, ast_str(substr(s, start, slen - start)))
    }

    // Build concatenation chain
    if len(parts) == 0 {
        return ast_str("")
    }
    let result = parts[0]
    let pi = 1
    while pi < len(parts) {
        result = ast_binop("+", result, parts[pi])
        pi = pi + 1
    }
    return result
}

// --- Expression Parsing (precedence climbing) ---

fn parse_primary() {
    let t = par_peek_type()

    if t == TOK_INT {
        let tok = par_advance()
        return ast_int(tok[1])
    }
    if t == TOK_FLOAT {
        let tok = par_advance()
        return ast_float(tok[1])
    }
    if t == TOK_STRING {
        let tok = par_advance()
        let s = tok[1]
        // Check for interpolation: scan for ${ pattern
        let has_interp = 0
        let si = 0
        let slen = len(s)
        while si + 1 < slen {
            if char_at(s, si) == 36 {
                if char_at(s, si + 1) == 123 {
                    has_interp = 1
                    si = slen
                } else {
                    si = si + 1
                }
            } else {
                si = si + 1
            }
        }
        if has_interp == 0 {
            return ast_str(s)
        }
        return parse_interpolated_string(s)
    }
    if t == TOK_TRUE {
        par_advance()
        return ast_bool(1)
    }
    if t == TOK_FALSE {
        par_advance()
        return ast_bool(0)
    }
    if t == TOK_NONE {
        par_advance()
        return ast_none()
    }
    if t == TOK_IDENT {
        let tok = par_advance()
        return ast_ident(tok[1])
    }
    if t == TOK_LPAREN {
        par_advance()
        let expr = parse_expr()
        par_expect(TOK_RPAREN)
        return expr
    }
    if t == TOK_LBRACKET {
        par_advance()
        if par_peek_type() == TOK_RBRACKET {
            par_advance()
            return ast_list(list_new())
        }
        let first = parse_expr()
        if par_peek_type() == TOK_FOR {
            par_advance()
            let cv = par_expect(TOK_IDENT)
            par_expect(TOK_IN)
            let citer = parse_expr()
            let ccond = 0
            if par_peek_type() == TOK_IF {
                par_advance()
                ccond = parse_expr()
            }
            par_expect(TOK_RBRACKET)
            return ast_list_comp(first, cv[1], citer, ccond)
        }
        let elems = list_new()
        push(elems, first)
        while par_peek_type() == TOK_COMMA {
            par_advance()
            push(elems, parse_expr())
        }
        par_expect(TOK_RBRACKET)
        return ast_list(elems)
    }
    if t == TOK_LBRACE {
        par_advance()
        let mkeys = list_new()
        let mvals = list_new()
        if par_peek_type() == TOK_RBRACE {
            par_advance()
            return ast_map_lit(mkeys, mvals)
        }
        let mk = parse_expr()
        par_expect(TOK_COLON)
        let mv = parse_expr()
        push(mkeys, mk)
        push(mvals, mv)
        while par_peek_type() == TOK_COMMA {
            par_advance()
            if par_peek_type() == TOK_RBRACE {
                // trailing comma
            } else {
                let mk2 = parse_expr()
                par_expect(TOK_COLON)
                let mv2 = parse_expr()
                push(mkeys, mk2)
                push(mvals, mv2)
            }
        }
        par_expect(TOK_RBRACE)
        return ast_map_lit(mkeys, mvals)
    }
    if t == TOK_MINUS {
        par_advance()
        let operand = parse_unary()
        return ast_unary("-", operand)
    }
    if t == TOK_BANG {
        par_advance()
        let operand = parse_unary()
        return ast_unary("!", operand)
    }
    if t == TOK_TILDE {
        par_advance()
        let operand = parse_unary()
        return ast_unary("~", operand)
    }
    if t == TOK_FN {
        // Check if this is a lambda: fn( without identifier
        let next_pos = par_pos + 1
        if next_pos < par_count {
            let next_tok = par_tokens[next_pos]
            if next_tok[0] == TOK_LPAREN {
                par_advance()
                par_expect(TOK_LPAREN)
                let pinfo = parse_param_list()
                let params = pinfo[0]
                let defaults = pinfo[1]
                par_expect(TOK_RPAREN)
                if par_peek_type() == TOK_COLON {
                    par_advance()
                    par_skip_type()
                }
                let body = parse_block()
                body = inject_defaults(body, defaults)
                let lname = "_lambda_" + int_to_str(par_lambda_count)
                par_lambda_count = par_lambda_count + 1
                let fn_node = ast_fn_decl(lname, params, body)
                push(par_lambdas, fn_node)
                return ast_lambda(lname, params, body)
            }
        }
    }
    // Unexpected token
    print("Error at line ")
    let err_tok = par_peek()
    if err_tok == 0 {
        print_int(0)
    } else {
        print_int(err_tok[2])
    }
    print(": unexpected ")
    println(token_type_name(t))
    exit(1)
    return ast_none()
}

fn parse_unary() {
    return parse_primary()
}

fn parse_postfix() {
    let expr = parse_unary()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_LPAREN {
            par_advance()
            let args = list_new()
            if par_peek_type() == TOK_RPAREN {
            } else {
                if par_peek_type() == TOK_ELLIPSIS {
                    par_advance()
                    push(args, ast_spread(parse_expr()))
                } else {
                    push(args, parse_expr())
                }
                while par_peek_type() == TOK_COMMA {
                    par_advance()
                    if par_peek_type() == TOK_ELLIPSIS {
                        par_advance()
                        push(args, ast_spread(parse_expr()))
                    } else {
                        push(args, parse_expr())
                    }
                }
            }
            par_expect(TOK_RPAREN)
            expr = ast_call(expr, args)
        } else {
            if t == TOK_LBRACKET {
                par_advance()
                let idx = parse_expr()
                if par_peek_type() == TOK_COLON {
                    par_advance()
                    let end_idx = parse_expr()
                    par_expect(TOK_RBRACKET)
                    expr = ast_slice(expr, idx, end_idx)
                } else {
                    par_expect(TOK_RBRACKET)
                    expr = ast_index(expr, idx)
                }
            } else {
                if t == TOK_QUESTION {
                    let next_pos2 = par_pos + 1
                    if next_pos2 < par_count {
                        let next_tok2 = par_tokens[next_pos2]
                        if next_tok2[0] == TOK_DOT {
                            par_advance()
                            par_advance()
                            let nf_tok = par_expect(TOK_IDENT)
                            expr = ast_null_access(expr, nf_tok[1])
                        } else {
                            return expr
                        }
                    } else {
                        return expr
                    }
                } else {
                    if t == TOK_DOT {
                        par_advance()
                        let field_tok = par_expect(TOK_IDENT)
                        expr = ast_field_access(expr, field_tok[1])
                    } else {
                        return expr
                    }
                }
            }
        }
    }
    return expr
}

fn parse_pow() {
    let base = parse_postfix()
    if par_peek_type() == TOK_STAR_STAR {
        par_advance()
        let exp = parse_pow()
        return ast_binop("**", base, exp)
    }
    return base
}

fn parse_mul() {
    let left = parse_pow()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_STAR {
            par_advance()
            let right = parse_pow()
            left = ast_binop("*", left, right)
        } else {
            if t == TOK_SLASH {
                par_advance()
                let right = parse_pow()
                left = ast_binop("/", left, right)
            } else {
                if t == TOK_PERCENT {
                    par_advance()
                    let right = parse_pow()
                    left = ast_binop("%", left, right)
                } else {
                    return left
                }
            }
        }
    }
    return left
}

fn parse_add() {
    let left = parse_mul()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_PLUS {
            par_advance()
            let right = parse_mul()
            left = ast_binop("+", left, right)
        } else {
            if t == TOK_MINUS {
                par_advance()
                let right = parse_mul()
                left = ast_binop("-", left, right)
            } else {
                if t == TOK_DOTDOT {
                    par_advance()
                    let right = parse_mul()
                    let rng_args = list_new()
                    push(rng_args, left)
                    push(rng_args, right)
                    left = ast_call(ast_ident("range_list"), rng_args)
                } else {
                    return left
                }
            }
        }
    }
    return left
}

fn parse_bitwise() {
    let left = parse_add()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_AMP {
            par_advance()
            let right = parse_add()
            left = ast_binop("&", left, right)
        } else { if t == TOK_PIPE {
            par_advance()
            let right = parse_add()
            left = ast_binop("|", left, right)
        } else { if t == TOK_CARET {
            par_advance()
            let right = parse_add()
            left = ast_binop("^", left, right)
        } else { if t == TOK_SHL {
            par_advance()
            let right = parse_add()
            left = ast_binop("<<", left, right)
        } else { if t == TOK_SHR {
            par_advance()
            let right = parse_add()
            left = ast_binop(">>", left, right)
        } else {
            return left
        } } } } }
    }
    return left
}

fn parse_cmp() {
    let left = parse_bitwise()
    while 1 == 1 {
        let t = par_peek_type()
        if t == TOK_LT {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop("<", left, right)
        } else { if t == TOK_GT {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop(">", left, right)
        } else { if t == TOK_LTEQ {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop("<=", left, right)
        } else { if t == TOK_GTEQ {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop(">=", left, right)
        } else { if t == TOK_EQEQ {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop("==", left, right)
        } else { if t == TOK_BANGEQ {
            par_advance()
            let right = parse_bitwise()
            left = ast_binop("!=", left, right)
        } else { if t == TOK_IN {
            par_advance()
            let right = parse_bitwise()
            let args = list_new()
            push(args, right)
            push(args, left)
            left = ast_call(ast_ident("contains"), args)
        } else { if t == TOK_IS {
            par_advance()
            let type_id = 0
            let pt2 = par_peek_type()
            if pt2 == TOK_NONE {
                par_advance()
                type_id = 0
            } else {
                let type_name = par_expect(TOK_IDENT)
                let tn = type_name[1]
                if tn == "null" { type_id = 0 }
                if tn == "int" { type_id = 1 }
                if tn == "str" { type_id = 2 }
                if tn == "string" { type_id = 2 }
                if tn == "list" { type_id = 3 }
                if tn == "map" { type_id = 4 }
            }
            let to_args = list_new()
            push(to_args, left)
            left = ast_binop("==", ast_call(ast_ident("type_of"), to_args), ast_int(type_id))
        } else {
            return left
        } } } } } } } }
    }
    return left
}

fn parse_and() {
    let left = parse_cmp()
    while par_peek_type() == TOK_AND {
        par_advance()
        let right = parse_cmp()
        left = ast_and(left, right)
    }
    return left
}

fn parse_or() {
    let left = parse_and()
    while par_peek_type() == TOK_OR {
        par_advance()
        let right = parse_and()
        left = ast_or(left, right)
    }
    return left
}

fn parse_pipe() {
    let left = parse_or()
    while par_peek_type() == TOK_PIPE_GT {
        par_advance()
        let right = parse_or()
        if ast_tag(right) == AST_CALL {
            let new_args = list_new()
            push(new_args, left)
            let old_args = right[2]
            let pai = 0
            while pai < len(old_args) {
                push(new_args, old_args[pai])
                pai = pai + 1
            }
            left = ast_call(right[1], new_args)
        } else {
            let pipe_args = list_new()
            push(pipe_args, left)
            left = ast_call(right, pipe_args)
        }
    }
    return left
}

fn parse_expr() {
    let left = parse_pipe()
    if par_peek_type() == TOK_QUESTION {
        par_advance()
        let then_val = parse_expr()
        par_expect(TOK_COLON)
        let else_val = parse_expr()
        return ast_ternary(left, then_val, else_val)
    }
    return left
}

// --- Statement Parsing ---

fn parse_block() {
    par_expect(TOK_LBRACE)
    let stmts = list_new()
    let block_done = 0
    while block_done == 0 {
        if par_peek_type() == TOK_RBRACE {
            block_done = 1
        } else {
            if par_peek_type() == TOK_EOF {
                println("Error: unexpected end of file inside block (missing closing '}')")
                exit(1)
            } else {
                if par_peek_type() == TOK_SEMI {
                    par_advance()
                } else {
                    push(stmts, parse_stmt())
                }
            }
        }
    }
    par_expect(TOK_RBRACE)
    return ast_block(stmts)
}

fn parse_if() {
    let if_line = 0
    let if_tok = par_peek()
    if if_tok == 0 {
    } else {
        if_line = if_tok[2]
    }
    let pt = par_peek_type()
    if pt == TOK_ELIF {
        par_advance()
    } else {
        par_expect(TOK_IF)
    }
    let cond = parse_expr()
    let then_body = parse_block()
    let else_body = 0
    if par_peek_type() == TOK_ELSE {
        par_advance()
        if par_peek_type() == TOK_IF {
            else_body = parse_if()
        } else {
            else_body = parse_block()
        }
    }
    if else_body == 0 {
        if par_peek_type() == TOK_ELIF {
            else_body = parse_if()
        }
    }
    let nd = ast_if(cond, then_body, else_body)
    push(nd, if_line)
    return nd
}

fn parse_while_labeled(lbl) {
    par_expect(TOK_WHILE)
    let cond = parse_expr()
    let body = parse_block()
    let nd = ast_while(cond, body)
    push(nd, lbl)
    let nxt = par_peek_type()
    if nxt == 53 {
        par_advance()
        let else_body = parse_block()
        push(nd, else_body)
    } else {
        push(nd, 0)
    }
    return nd
}

fn parse_while() {
    return parse_while_labeled("")
}

fn parse_for_labeled(lbl) {
    par_expect(TOK_FOR)
    let var_tok = par_expect(TOK_IDENT)
    let var_name = var_tok[1]
    if par_peek_type() == TOK_COMMA {
        par_advance()
        let val_tok = par_expect(TOK_IDENT)
        let val_name = val_tok[1]
        par_expect(TOK_IN)
        let iter = parse_expr()
        let body = parse_block()
        let nd = ast_for_indexed(var_name, val_name, iter, body)
        if lbl == "" {
        } else {
            push(nd, lbl)
        }
        return nd
    }
    par_expect(TOK_IN)
    let iter = parse_expr()
    let body = parse_block()
    let nd = ast_for(var_name, iter, body)
    push(nd, lbl)
    let fnxt = par_peek_type()
    if fnxt == 53 {
        par_advance()
        let else_body = parse_block()
        push(nd, else_body)
    } else {
        push(nd, 0)
    }
    return nd
}

fn parse_for() {
    return parse_for_labeled("")
}

fn parse_let() {
    let t = par_peek_type()
    let is_const_decl = 0
    if t == TOK_CONST {
        is_const_decl = 1
        par_advance()
    } else {
        par_expect(TOK_LET)
    }
    if par_peek_type() == TOK_LBRACKET {
        par_advance()
        let dnames = list_new()
        if par_peek_type() == TOK_RBRACKET {
        } else {
            let dtok = par_expect(TOK_IDENT)
            push(dnames, dtok[1])
            while par_peek_type() == TOK_COMMA {
                par_advance()
                let dtok2 = par_expect(TOK_IDENT)
                push(dnames, dtok2[1])
            }
        }
        par_expect(TOK_RBRACKET)
        par_expect(TOK_EQ)
        let dvalue = parse_expr()
        return ast_destructure(dnames, dvalue)
    }
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    if par_peek_type() == TOK_COLON {
        par_advance()
        par_skip_type()
    }
    if par_peek_type() == TOK_COMMA {
        let names = list_new()
        push(names, name)
        while par_peek_type() == TOK_COMMA {
            par_advance()
            let ntok = par_expect(TOK_IDENT)
            push(names, ntok[1])
        }
        par_expect(TOK_EQ)
        let vals = list_new()
        push(vals, parse_expr())
        while par_peek_type() == TOK_COMMA {
            par_advance()
            push(vals, parse_expr())
        }
        let stmts = list_new()
        let mi = 0
        while mi < len(names) {
            if mi < len(vals) {
                push(stmts, ast_let(names[mi], vals[mi]))
            } else {
                push(stmts, ast_let(names[mi], ast_none()))
            }
            mi = mi + 1
        }
        return ast_block(stmts)
    }
    par_expect(TOK_EQ)
    let value = parse_expr()
    if is_const_decl == 1 {
        push(par_consts, name)
    }
    return ast_let(name, value)
}

fn parse_param_list() {
    let params = list_new()
    let defaults = list_new()
    let has_rest = 0
    let rest_name = ""
    if par_peek_type() == TOK_RPAREN {
        let result = list_new()
        push(result, params)
        push(result, defaults)
        push(result, rest_name)
        return result
    }
    if par_peek_type() == TOK_ELLIPSIS {
        par_advance()
        let rt = par_expect(TOK_IDENT)
        rest_name = rt[1]
        push(params, rest_name)
        let result = list_new()
        push(result, params)
        push(result, defaults)
        push(result, rest_name)
        return result
    }
    let p = par_expect(TOK_IDENT)
    push(params, p[1])
    if par_peek_type() == TOK_COLON {
        par_advance()
        par_skip_type()
    }
    if par_peek_type() == TOK_EQ {
        par_advance()
        let dv = parse_expr()
        let dp = list_new()
        push(dp, p[1])
        push(dp, dv)
        push(defaults, dp)
    }
    while par_peek_type() == TOK_COMMA {
        par_advance()
        if par_peek_type() == TOK_ELLIPSIS {
            par_advance()
            let rt = par_expect(TOK_IDENT)
            rest_name = rt[1]
            push(params, rest_name)
            let result = list_new()
            push(result, params)
            push(result, defaults)
            push(result, rest_name)
            return result
        }
        let p2 = par_expect(TOK_IDENT)
        push(params, p2[1])
        if par_peek_type() == TOK_COLON {
            par_advance()
            par_skip_type()
        }
        if par_peek_type() == TOK_EQ {
            par_advance()
            let dv2 = parse_expr()
            let dp2 = list_new()
            push(dp2, p2[1])
            push(dp2, dv2)
            push(defaults, dp2)
        }
    }
    let result = list_new()
    push(result, params)
    push(result, defaults)
    push(result, rest_name)
    return result
}

fn inject_defaults(body, defaults) {
    if len(defaults) == 0 { return body }
    let stmts = body[1]
    let new_stmts = list_new()
    let di = 0
    while di < len(defaults) {
        let dp = defaults[di]
        let pname = dp[0]
        let pval = dp[1]
        let check = ast_if(
            ast_binop("==", ast_ident(pname), ast_int(0)),
            ast_block(list_new()),
            0
        )
        let assign_stmts = list_new()
        push(assign_stmts, ast_assign(pname, pval))
        check[2] = ast_block(assign_stmts)
        push(new_stmts, check)
        di = di + 1
    }
    let si = 0
    while si < len(stmts) {
        push(new_stmts, stmts[si])
        si = si + 1
    }
    return ast_block(new_stmts)
}

fn parse_fn() {
    par_expect(TOK_FN)
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    if par_peek_type() == TOK_DOT {
        par_advance()
        let mtok = par_expect(TOK_IDENT)
        let meth = mtok[1]
        par_expect(TOK_LPAREN)
        let pinfo = parse_param_list()
        let params = pinfo[0]
        let defaults = pinfo[1]
        par_expect(TOK_RPAREN)
        if par_peek_type() == TOK_COLON {
            par_advance()
            par_skip_type()
        }
        let body = parse_block()
        body = inject_defaults(body, defaults)
        return ast_method_decl(name, meth, params, body)
    }
    par_expect(TOK_LPAREN)
    let pinfo = parse_param_list()
    let params = pinfo[0]
    let defaults = pinfo[1]
    let rest_name = pinfo[2]
    par_expect(TOK_RPAREN)
    if par_peek_type() == TOK_COLON {
        par_advance()
        par_skip_type()
    }
    let body = parse_block()
    body = inject_defaults(body, defaults)
    return ast_fn_decl(name, params, body)
}

fn parse_return() {
    par_expect(TOK_RETURN)
    let t = par_peek_type()
    if t == TOK_RBRACE {
        return ast_return(0)
    }
    if t == TOK_EOF {
        return ast_return(0)
    }
    let value = parse_expr()
    return ast_return(value)
}

fn parse_struct_decl() {
    par_expect(TOK_STRUCT)
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    par_expect(TOK_LBRACE)
    let fields = list_new()
    let struct_done = 0
    while struct_done == 0 {
        if par_peek_type() == TOK_RBRACE {
            struct_done = 1
        } else {
            if par_peek_type() == TOK_COMMA {
                par_advance()
            } else {
                let f = par_expect(TOK_IDENT)
                push(fields, f[1])
            }
        }
    }
    par_expect(TOK_RBRACE)
    return ast_struct_decl(name, fields)
}

fn parse_match() {
    par_expect(TOK_MATCH)
    let expr = parse_expr()
    par_expect(TOK_LBRACE)
    let arms = list_new()
    while par_peek_type() != TOK_RBRACE {
        if par_peek_type() == TOK_EOF {
            println("Error: unexpected EOF in match")
            exit(1)
        }
        // Parse pattern
        let pattern = 0
        if par_peek_type() == TOK_UNDERSCORE {
            par_advance()
            pattern = ast_wildcard()
        } else {
            pattern = parse_expr()
        }
        let guard = 0
        if par_peek_type() == TOK_IF {
            par_advance()
            guard = parse_expr()
        }
        par_expect(TOK_ARROW)
        // Parse body - either a block or a single expression
        let body = 0
        if par_peek_type() == TOK_LBRACE {
            body = parse_block()
        } else {
            body = ast_expr_stmt(parse_expr())
        }
        let arm = ast_match_arm(pattern, body)
        if guard == 0 {
        } else {
            push(arm, guard)
        }
        push(arms, arm)
    }
    par_expect(TOK_RBRACE)
    return ast_match(expr, arms)
}

fn parse_try() {
    par_expect(TOK_TRY)
    let try_body = parse_block()
    par_expect(TOK_CATCH)
    let err_var = ""
    if par_peek_type() == TOK_IDENT {
        let etok = par_advance()
        err_var = etok[1]
    }
    let catch_body = parse_block()
    let nd = ast_try_catch(try_body, catch_body)
    push(nd, err_var)
    if par_peek_type() == TOK_FINALLY {
        par_advance()
        let finally_body = parse_block()
        push(nd, finally_body)
    }
    return nd
}

fn parse_throw() {
    par_expect(TOK_THROW)
    let value = parse_expr()
    return ast_throw(value)
}

fn parse_stmt_inner() {
    let t = par_peek_type()
    if t == TOK_AT {
        par_advance()
        let ltok = par_expect(TOK_IDENT)
        let loop_lbl = ltok[1]
        if par_peek_type() == TOK_WHILE {
            return parse_while_labeled(loop_lbl)
        }
        if par_peek_type() == TOK_FOR {
            return parse_for_labeled(loop_lbl)
        }
        print("Error: @label must be followed by while or for")
        exit(1)
    }
    if t == TOK_LET { return parse_let() }
    if t == TOK_CONST { return parse_let() }
    if t == TOK_FN { return parse_fn() }
    if t == TOK_EXTERN { return parse_extern_fn() }
    if t == TOK_IF { return parse_if() }
    if t == TOK_UNLESS {
        par_advance()
        let cond = parse_expr()
        let body = parse_block()
        let neg_cond = ast_unary("!", cond)
        return ast_if(neg_cond, body, 0)
    }
    if t == TOK_WHILE { return parse_while() }
    if t == TOK_UNTIL {
        par_advance()
        let cond = parse_expr()
        let body = parse_block()
        let neg_cond = ast_unary("!", cond)
        return ast_while(neg_cond, body)
    }
    if t == TOK_FOR { return parse_for() }
    if t == TOK_REPEAT {
        par_advance()
        let count_expr = parse_expr()
        let body = parse_block()
        let rng_args = list_new()
        push(rng_args, count_expr)
        let iter_expr = ast_call(ast_ident("range"), rng_args)
        return ast_for("_rep_", iter_expr, body)
    }
    if t == TOK_RETURN { return parse_return() }
    if t == TOK_BREAK {
        par_advance()
        let brk = ast_break()
        if par_peek_type() == TOK_AT {
            par_advance()
            let blbl = par_expect(TOK_IDENT)
            push(brk, blbl[1])
        }
        return brk
    }
    if t == TOK_CONTINUE {
        par_advance()
        let cnt = ast_continue()
        if par_peek_type() == TOK_AT {
            par_advance()
            let clbl = par_expect(TOK_IDENT)
            push(cnt, clbl[1])
        }
        return cnt
    }
    if t == TOK_STRUCT { return parse_struct_decl() }
    if t == TOK_MATCH { return parse_match() }
    if t == TOK_TRY { return parse_try() }
    if t == TOK_THROW { return parse_throw() }
    if t == TOK_ENUM { return parse_enum() }
    if t == TOK_DO { return parse_do_while() }
    if t == TOK_ASM { return parse_asm() }
    if t == TOK_DEFER {
        par_advance()
        let defer_body = parse_block()
        return ast_defer(defer_body)
    }

    // Assignment or expression statement
    let expr = parse_expr()
    if ast_tag(expr) == AST_IDENT {
        if par_peek_type() == TOK_COMMA {
            let anames = list_new()
            push(anames, expr[1])
            while par_peek_type() == TOK_COMMA {
                par_advance()
                let atk = par_expect(TOK_IDENT)
                push(anames, atk[1])
            }
            par_expect(TOK_EQ)
            let avals = list_new()
            push(avals, parse_expr())
            while par_peek_type() == TOK_COMMA {
                par_advance()
                push(avals, parse_expr())
            }
            let astmts = list_new()
            let ai = 0
            while ai < len(anames) {
                if ai < len(avals) {
                    push(astmts, ast_assign(anames[ai], avals[ai]))
                }
                ai = ai + 1
            }
            return ast_block(astmts)
        }
    }
    if par_peek_type() == TOK_EQ {
        par_advance()
        let value = parse_expr()
        if ast_tag(expr) == AST_INDEX_EXPR {
            return ast_index_assign(expr[1], expr[2], value)
        }
        if ast_tag(expr) == AST_FIELD_ACCESS {
            return ast_field_assign(expr[1], expr[2], value)
        }
        let name = expr[1]
        let ci = 0
        while ci < len(par_consts) {
            if par_consts[ci] == name {
                print("Error: cannot reassign const variable: ")
                println(name)
                exit(1)
            }
            ci = ci + 1
        }
        return ast_assign(name, value)
    }
    // Compound assignment: +=, -=, *=, /=, %=, **=, &=, |=, ^=, <<=, >>=
    let pt = par_peek_type()
    let compound_op = ""
    if pt == TOK_PLUS_EQ { compound_op = "+" }
    if pt == TOK_MINUS_EQ { compound_op = "-" }
    if pt == TOK_STAR_EQ { compound_op = "*" }
    if pt == TOK_SLASH_EQ { compound_op = "/" }
    if pt == TOK_PERCENT_EQ { compound_op = "%" }
    if pt == TOK_STAR_STAR_EQ { compound_op = "**" }
    if pt == TOK_AMP_EQ { compound_op = "&" }
    if pt == TOK_PIPE_EQ { compound_op = "|" }
    if pt == TOK_CARET_EQ { compound_op = "^" }
    if pt == TOK_SHL_EQ { compound_op = "<<" }
    if pt == TOK_SHR_EQ { compound_op = ">>" }
    if compound_op == "" {
    } else {
        par_advance()
        let rhs = parse_expr()
        if ast_tag(expr) == AST_INDEX_EXPR {
            let base = expr[1]
            let idx = expr[2]
            return ast_index_assign(base, idx, ast_binop(compound_op, ast_index(base, idx), rhs))
        }
        if ast_tag(expr) == AST_FIELD_ACCESS {
            let fbase = expr[1]
            let fname = expr[2]
            return ast_field_assign(fbase, fname, ast_binop(compound_op, ast_field_access(fbase, fname), rhs))
        }
        let name = expr[1]
        let ci = 0
        while ci < len(par_consts) {
            if par_consts[ci] == name {
                print("Error: cannot reassign const variable: ")
                println(name)
                exit(1)
            }
            ci = ci + 1
        }
        return ast_assign(name, ast_binop(compound_op, ast_ident(name), rhs))
    }
    return ast_expr_stmt(expr)
}

fn parse_stmt() {
    // Capture source line from current token before parsing
    let stmt_line = 0
    let stmt_tok = par_peek()
    if stmt_tok == 0 {
    } else {
        stmt_line = stmt_tok[2]
    }
    let result = parse_stmt_inner()
    // Append source line number as the last element for debug info
    push(result, stmt_line)
    return result
}

fn parse_extern_fn() {
    par_expect(TOK_EXTERN)
    par_expect(TOK_FN)
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    par_expect(TOK_LPAREN)
    let pc = 0
    if par_peek_type() != TOK_RPAREN {
        par_expect(TOK_IDENT)
        pc = 1
        while par_peek_type() == TOK_COMMA {
            par_advance()
            par_expect(TOK_IDENT)
            pc = pc + 1
        }
    }
    par_expect(TOK_RPAREN)
    return ast_extern_fn(name, pc)
}

fn parse_asm() {
    par_expect(TOK_ASM)
    par_expect(TOK_LBRACE)
    let lines = list_new()
    while par_peek_type() != TOK_RBRACE {
        let t = par_advance()
        if t[0] == TOK_STRING {
            push(lines, t[1])
        } else {
            println("Error: asm block expects string literals")
            exit(1)
        }
    }
    par_expect(TOK_RBRACE)
    return ast_asm(lines)
}

fn parse_do_while() {
    par_expect(TOK_DO)
    let body = parse_block()
    par_expect(TOK_WHILE)
    let cond = parse_expr()
    return ast_do_while(body, cond)
}

fn parse_enum() {
    par_expect(TOK_ENUM)
    let name_tok = par_expect(TOK_IDENT)
    let name = name_tok[1]
    par_expect(TOK_LBRACE)
    let variants = list_new()
    let enum_done = 0
    while enum_done == 0 {
        if par_peek_type() == TOK_RBRACE {
            enum_done = 1
        } else {
            if par_peek_type() == TOK_COMMA {
                par_advance()
            } else {
                let v = par_expect(TOK_IDENT)
                push(variants, v[1])
            }
        }
    }
    par_expect(TOK_RBRACE)
    return ast_enum_decl(name, variants)
}

fn parse_program(tokens) {
    par_init(tokens)
    let decls = list_new()
    let done = 0
    while done == 0 {
        if par_peek_type() == TOK_EOF {
            done = 1
        } else {
            if par_peek_type() == TOK_SEMI {
                par_advance()
            } else {
                push(decls, parse_stmt())
            }
        }
    }
    return ast_program(decls)
}
