// Nova Compiler: Lexer
// Tokenizes Nova source into a list of tokens.
// Each token is [type, value, line, col]

// --- Token Types ---
let TOK_EOF = 0
let TOK_INT = 1
let TOK_FLOAT = 2
let TOK_STRING = 3
let TOK_IDENT = 4
let TOK_PLUS = 10
let TOK_MINUS = 11
let TOK_STAR = 12
let TOK_SLASH = 13
let TOK_PERCENT = 14
let TOK_EQ = 15
let TOK_BANG = 16
let TOK_LT = 17
let TOK_GT = 18
let TOK_DOT = 19
let TOK_EQEQ = 20
let TOK_BANGEQ = 21
let TOK_LTEQ = 22
let TOK_GTEQ = 23
let TOK_LPAREN = 30
let TOK_RPAREN = 31
let TOK_LBRACE = 32
let TOK_RBRACE = 33
let TOK_LBRACKET = 34
let TOK_RBRACKET = 35
let TOK_COMMA = 36
let TOK_COLON = 37
let TOK_SEMI = 38
let TOK_AMP = 39
let TOK_PIPE = 40
let TOK_TILDE = 41
let TOK_AT = 42
let TOK_HASH = 43
let TOK_AND = 44
let TOK_OR = 45
let TOK_CARET = 46
let TOK_SHL = 47
let TOK_SHR = 48
// Keywords
let TOK_LET = 50
let TOK_FN = 51
let TOK_IF = 52
let TOK_ELSE = 53
let TOK_WHILE = 54
let TOK_FOR = 55
let TOK_IN = 56
let TOK_RETURN = 57
let TOK_TRUE = 58
let TOK_FALSE = 59
let TOK_NONE = 60
let TOK_STRUCT = 61
let TOK_BREAK = 62
let TOK_CONTINUE = 63
let TOK_IMPORT = 64
let TOK_CONST = 65
let TOK_MATCH = 66
let TOK_ARROW = 67
let TOK_UNDERSCORE = 68
// Error handling
let TOK_TRY = 69
let TOK_CATCH = 70
let TOK_THROW = 71
// Flow operators
let TOK_FLOW_FWD = 73
let TOK_FLOW_BWD = 74
let TOK_BROADCAST = 75
let TOK_ENRICH = 76
// Enum
let TOK_ENUM = 77
// Compound assignment
let TOK_PLUS_EQ = 78
let TOK_MINUS_EQ = 79
let TOK_STAR_EQ = 80
let TOK_SLASH_EQ = 81
let TOK_PERCENT_EQ = 82
// Ternary and do-while
let TOK_QUESTION = 83
let TOK_DO = 84
let TOK_DOTDOT = 85
let TOK_ELLIPSIS = 86
let TOK_PIPE_GT = 87
let TOK_STAR_STAR = 88
let TOK_FINALLY = 89
let TOK_STAR_STAR_EQ = 90
let TOK_ASM = 91
let TOK_EXTERN = 92

// --- Lexer State ---
let lex_src = ""
let lex_pos = 0
let lex_len = 0
let lex_line = 1
let lex_col = 1
let lex_tokens = 0

fn lex_init(source) {
    lex_src = source
    lex_pos = 0
    lex_len = len(source)
    lex_line = 1
    lex_col = 1
    lex_tokens = list_new()
}

fn lex_peek() {
    if lex_pos >= lex_len {
        return 0
    }
    return char_at(lex_src, lex_pos)
}

fn lex_advance() {
    let ch = lex_peek()
    lex_pos = lex_pos + 1
    if ch == 10 {
        lex_line = lex_line + 1
        lex_col = 1
    } else {
        lex_col = lex_col + 1
    }
    return ch
}

fn lex_peek_at(offset) {
    let p = lex_pos + offset
    if p >= lex_len {
        return 0
    }
    return char_at(lex_src, p)
}

fn is_alpha(c) {
    if c >= 65 {
        if c <= 90 { return 1 }
    }
    if c >= 97 {
        if c <= 122 { return 1 }
    }
    if c == 95 { return 1 }
    return 0
}

fn is_digit(c) {
    if c >= 48 {
        if c <= 57 { return 1 }
    }
    return 0
}

fn is_alnum(c) {
    if is_alpha(c) == 1 { return 1 }
    if is_digit(c) == 1 { return 1 }
    return 0
}

fn is_whitespace(c) {
    if c == 32 { return 1 }
    if c == 9 { return 1 }
    if c == 10 { return 1 }
    if c == 13 { return 1 }
    return 0
}

fn emit_tok(typ, val) {
    let tok = list_new()
    push(tok, typ)
    push(tok, val)
    push(tok, lex_line)
    push(tok, lex_col)
    push(lex_tokens, tok)
}

fn skip_whitespace() {
    while lex_pos < lex_len {
        let c = lex_peek()
        if is_whitespace(c) == 1 {
            lex_advance()
        } else {
            if c == 47 {
                if lex_peek_at(1) == 47 {
                    // Line comment
                    while lex_pos < lex_len {
                        let ch = lex_advance()
                        if ch == 10 {
                            return skip_whitespace()
                        }
                    }
                } else {
                    if lex_peek_at(1) == 42 {
                        // Block comment /* ... */
                        lex_advance()
                        lex_advance()
                        while lex_pos < lex_len {
                            if lex_peek() == 42 {
                                if lex_peek_at(1) == 47 {
                                    lex_advance()
                                    lex_advance()
                                    return skip_whitespace()
                                }
                            }
                            lex_advance()
                        }
                    } else {
                        return 0
                    }
                }
            } else {
                return 0
            }
        }
    }
}

fn lex_number() {
    let start = lex_pos
    let c = lex_peek()

    // Check for 0x (hex) or 0o (octal) or 0b (binary)
    if c == 48 {
        let next = lex_peek_at(1)
        if next == 120 {
            // Hex literal: 0x...
            lex_advance()
            lex_advance()
            let val = 0
            while lex_pos < lex_len {
                let h = lex_peek()
                if is_digit(h) == 1 {
                    val = val * 16 + (h - 48)
                    lex_advance()
                } else {
                    if h >= 97 {
                        if h <= 102 {
                            val = val * 16 + (h - 97 + 10)
                            lex_advance()
                        } else {
                            emit_tok(TOK_INT, val)
                            return 0
                        }
                    } else {
                        if h >= 65 {
                            if h <= 70 {
                                val = val * 16 + (h - 65 + 10)
                                lex_advance()
                            } else {
                                emit_tok(TOK_INT, val)
                                return 0
                            }
                        } else {
                            emit_tok(TOK_INT, val)
                            return 0
                        }
                    }
                }
            }
            emit_tok(TOK_INT, val)
            return 0
        }
        if next == 111 {
            // Octal literal: 0o...
            lex_advance()
            lex_advance()
            let val = 0
            while lex_pos < lex_len {
                let h = lex_peek()
                if h >= 48 {
                    if h <= 55 {
                        val = val * 8 + (h - 48)
                        lex_advance()
                    } else {
                        emit_tok(TOK_INT, val)
                        return 0
                    }
                } else {
                    emit_tok(TOK_INT, val)
                    return 0
                }
            }
            emit_tok(TOK_INT, val)
            return 0
        }
        if next == 98 {
            // Binary literal: 0b...
            lex_advance()
            lex_advance()
            let val = 0
            while lex_pos < lex_len {
                let h = lex_peek()
                if h == 48 {
                    val = val * 2
                    lex_advance()
                } else {
                    if h == 49 {
                        val = val * 2 + 1
                        lex_advance()
                    } else {
                        emit_tok(TOK_INT, val)
                        return 0
                    }
                }
            }
            emit_tok(TOK_INT, val)
            return 0
        }
    }

    // Normal decimal number
    while lex_pos < lex_len {
        let c2 = lex_peek()
        if is_digit(c2) == 1 {
            lex_advance()
        } else {
            // Check for decimal point: '.' followed by digit means float
            if c2 == 46 {
                if lex_pos + 1 < lex_len {
                    let after_dot = lex_peek_at(1)
                    if is_digit(after_dot) == 1 {
                        // Parse as fixed-point float (scaled by 1000)
                        let int_str = substr(lex_src, start, lex_pos - start)
                        let int_v = str_to_int(int_str)
                        lex_advance()  // consume '.'
                        let frac_start = lex_pos
                        // Scan fractional digits
                        while lex_pos < lex_len {
                            if is_digit(lex_peek()) == 1 {
                                lex_advance()
                            } else {
                                // End of fractional part (non-digit found)
                                let frac_str = substr(lex_src, frac_start, lex_pos - frac_start)
                                let frac_len = lex_pos - frac_start
                                let frac_v = str_to_int(frac_str)
                                // Scale fractional part to 3 decimal places
                                if frac_len == 1 { frac_v = frac_v * 100 }
                                if frac_len == 2 { frac_v = frac_v * 10 }
                                // frac_len == 3: keep as-is
                                if frac_len > 3 {
                                    let extra = frac_len - 3
                                    let d = 1
                                    let ei = 0
                                    while ei < extra {
                                        d = d * 10
                                        ei = ei + 1
                                    }
                                    frac_v = frac_v / d
                                }
                                emit_tok(TOK_FLOAT, int_v * 1000 + frac_v)
                                return 0
                            }
                        }
                        // Reached end of source during fractional part
                        let frac_str = substr(lex_src, frac_start, lex_pos - frac_start)
                        let frac_len = lex_pos - frac_start
                        let frac_v = str_to_int(frac_str)
                        if frac_len == 1 { frac_v = frac_v * 100 }
                        if frac_len == 2 { frac_v = frac_v * 10 }
                        if frac_len > 3 {
                            let extra = frac_len - 3
                            let d = 1
                            let ei = 0
                            while ei < extra {
                                d = d * 10
                                ei = ei + 1
                            }
                            frac_v = frac_v / d
                        }
                        emit_tok(TOK_FLOAT, int_v * 1000 + frac_v)
                        return 0
                    }
                }
            }
            // Not a float, emit as integer
            let val = substr(lex_src, start, lex_pos - start)
            emit_tok(TOK_INT, str_to_int(val))
            return 0
        }
    }
    let val = substr(lex_src, start, lex_pos - start)
    emit_tok(TOK_INT, str_to_int(val))
}

fn lex_string() {
    lex_advance()
    // Check for triple-quote
    if lex_pos + 1 < lex_len {
        if lex_peek() == 34 {
            if char_at(lex_src, lex_pos + 1) == 34 {
                lex_advance()
                lex_advance()
                let ml_result = ""
                while lex_pos < lex_len {
                    let mc = lex_peek()
                    if mc == 34 {
                        if lex_pos + 2 < lex_len {
                            if char_at(lex_src, lex_pos + 1) == 34 {
                                if char_at(lex_src, lex_pos + 2) == 34 {
                                    lex_advance()
                                    lex_advance()
                                    lex_advance()
                                    emit_tok(TOK_STRING, ml_result)
                                    return 0
                                }
                            }
                        }
                        ml_result = ml_result + chr(mc)
                        lex_advance()
                    } else {
                        if mc == 10 { lex_line = lex_line + 1 }
                        ml_result = ml_result + chr(mc)
                        lex_advance()
                    }
                }
                emit_tok(TOK_STRING, ml_result)
                return 0
            }
        }
    }
    let result = ""
    while lex_pos < lex_len {
        let c = lex_peek()
        if c == 34 {
            lex_advance()
            emit_tok(TOK_STRING, result)
            return 0
        }
        if c == 92 {
            lex_advance()
            let next = lex_peek()
            let esc_handled = 0
            if next == 110 { result = result + chr(10); esc_handled = 1 }
            if next == 116 { if esc_handled == 0 { result = result + chr(9); esc_handled = 1 } }
            if next == 114 { if esc_handled == 0 { result = result + chr(13); esc_handled = 1 } }
            if next == 92 { if esc_handled == 0 { result = result + chr(92); esc_handled = 1 } }
            if next == 34 { if esc_handled == 0 { result = result + chr(34); esc_handled = 1 } }
            if next == 48 { if esc_handled == 0 { result = result + chr(0); esc_handled = 1 } }
            if next == 120 {
                if esc_handled == 0 {
                    esc_handled = 1
                    lex_advance()
                    let h1 = lex_peek()
                    let v1 = 0
                    let hex_ok = 0
                    if h1 >= 48 { if h1 <= 57 { v1 = h1 - 48; hex_ok = 1 } }
                    if h1 >= 65 { if h1 <= 70 { v1 = h1 - 55; hex_ok = 1 } }
                    if h1 >= 97 { if h1 <= 102 { v1 = h1 - 87; hex_ok = 1 } }
                    if hex_ok == 1 {
                        lex_advance()
                        let h2 = lex_peek()
                        let v2 = 0
                        let hex_ok2 = 0
                        if h2 >= 48 { if h2 <= 57 { v2 = h2 - 48; hex_ok2 = 1 } }
                        if h2 >= 65 { if h2 <= 70 { v2 = h2 - 55; hex_ok2 = 1 } }
                        if h2 >= 97 { if h2 <= 102 { v2 = h2 - 87; hex_ok2 = 1 } }
                        if hex_ok2 == 1 {
                            result = result + chr(v1 * 16 + v2)
                            lex_advance()
                        } else {
                            result = result + chr(v1)
                        }
                    } else {
                        result = result + "x"
                    }
                }
            }
            if esc_handled == 0 { result = result + chr(next) }
            if next == 120 { } else {
                lex_advance()
            }
        } else {
            result = result + chr(c)
            lex_advance()
        }
    }
    emit_tok(TOK_STRING, result)
}

fn keyword_type(word) {
    if word == "let" { return TOK_LET }
    if word == "fn" { return TOK_FN }
    if word == "if" { return TOK_IF }
    if word == "else" { return TOK_ELSE }
    if word == "while" { return TOK_WHILE }
    if word == "for" { return TOK_FOR }
    if word == "in" { return TOK_IN }
    if word == "return" { return TOK_RETURN }
    if word == "true" { return TOK_TRUE }
    if word == "false" { return TOK_FALSE }
    if word == "none" { return TOK_NONE }
    if word == "struct" { return TOK_STRUCT }
    if word == "break" { return TOK_BREAK }
    if word == "continue" { return TOK_CONTINUE }
    if word == "import" { return TOK_IMPORT }
    if word == "const" { return TOK_CONST }
    if word == "match" { return TOK_MATCH }
    if word == "try" { return TOK_TRY }
    if word == "catch" { return TOK_CATCH }
    if word == "throw" { return TOK_THROW }
    if word == "enum" { return TOK_ENUM }
    if word == "do" { return TOK_DO }
    if word == "finally" { return TOK_FINALLY }
    if word == "asm" { return TOK_ASM }
    if word == "extern" { return TOK_EXTERN }
    return 0
}

fn lex_ident() {
    let start = lex_pos
    while lex_pos < lex_len {
        let c = lex_peek()
        if is_alnum(c) == 0 {
            let word = substr(lex_src, start, lex_pos - start)
            if word == "_" {
                emit_tok(TOK_UNDERSCORE, "_")
                return 0
            }
            let kw = keyword_type(word)
            if kw == 0 {
                emit_tok(TOK_IDENT, word)
            } else {
                if kw == TOK_TRUE {
                    emit_tok(TOK_TRUE, 1)
                } else {
                    if kw == TOK_FALSE {
                        emit_tok(TOK_FALSE, 0)
                    } else {
                        emit_tok(kw, word)
                    }
                }
            }
            return 0
        }
        lex_advance()
    }
    let word = substr(lex_src, start, lex_pos - start)
    if word == "_" {
        emit_tok(TOK_UNDERSCORE, "_")
        return 0
    }
    let kw = keyword_type(word)
    if kw == 0 {
        emit_tok(TOK_IDENT, word)
    } else {
        emit_tok(kw, word)
    }
}

fn lex_pipe_char() {
    lex_advance()
    let pn = lex_peek()
    if pn == 124 {
        lex_advance()
        emit_tok(TOK_OR, "||")
        return 0
    }
    if pn == 62 {
        lex_advance()
        emit_tok(TOK_PIPE_GT, "|>")
        return 0
    }
    emit_tok(TOK_PIPE, "|")
}

fn lex_all() {
    while lex_pos < lex_len {
        skip_whitespace()
        if lex_pos >= lex_len {
            emit_tok(TOK_EOF, 0)
            return lex_tokens
        }
        let c = lex_peek()

        if is_digit(c) == 1 {
            lex_number()
        } else {
            if is_alpha(c) == 1 {
                lex_ident()
            } else {
                if c == 34 {
                    lex_string()
                } else {
                    if c == 43 {
                        lex_advance()
                        if lex_peek() == 61 {
                            lex_advance()
                            emit_tok(TOK_PLUS_EQ, "+=")
                        } else {
                            emit_tok(TOK_PLUS, "+")
                        }
                    }
                    else { if c == 45 {
                        lex_advance()
                        if lex_peek() == 61 {
                            lex_advance()
                            emit_tok(TOK_MINUS_EQ, "-=")
                        } else {
                            emit_tok(TOK_MINUS, "-")
                        }
                    }
                    else { if c == 42 {
                        lex_advance()
                        if lex_peek() == 61 {
                            lex_advance()
                            emit_tok(TOK_STAR_EQ, "*=")
                        } else { if lex_peek() == 42 {
                            lex_advance()
                            if lex_peek() == 61 {
                                lex_advance()
                                emit_tok(TOK_STAR_STAR_EQ, "**=")
                            } else {
                                emit_tok(TOK_STAR_STAR, "**")
                            }
                        } else {
                            emit_tok(TOK_STAR, "*")
                        } }
                    }
                    else { if c == 47 {
                        lex_advance()
                        if lex_peek() == 61 {
                            lex_advance()
                            emit_tok(TOK_SLASH_EQ, "/=")
                        } else {
                            emit_tok(TOK_SLASH, "/")
                        }
                    }
                    else { if c == 37 {
                        lex_advance()
                        if lex_peek() == 61 {
                            lex_advance()
                            emit_tok(TOK_PERCENT_EQ, "%=")
                        } else {
                            emit_tok(TOK_PERCENT, "%")
                        }
                    }
                    else { if c == 40 { lex_advance(); emit_tok(TOK_LPAREN, "(") }
                    else { if c == 41 { lex_advance(); emit_tok(TOK_RPAREN, ")") }
                    else { if c == 123 { lex_advance(); emit_tok(TOK_LBRACE, "{") }
                    else { if c == 125 { lex_advance(); emit_tok(TOK_RBRACE, "}") }
                    else { if c == 91 { lex_advance(); emit_tok(TOK_LBRACKET, "[") }
                    else { if c == 93 { lex_advance(); emit_tok(TOK_RBRACKET, "]") }
                    else { if c == 44 { lex_advance(); emit_tok(TOK_COMMA, ",") }
                    else { if c == 58 { lex_advance(); emit_tok(TOK_COLON, ":") }
                    else { if c == 59 { lex_advance(); emit_tok(TOK_SEMI, ";") }
                    else { if c == 38 {
                        lex_advance()
                        if lex_peek() == 38 {
                            lex_advance()
                            emit_tok(TOK_AND, "&&")
                        } else {
                            emit_tok(TOK_AMP, "&")
                        }
                    }
                    else { if c == 124 {
                        lex_pipe_char()
                    }
                    else { if c == 64 { lex_advance(); emit_tok(TOK_AT, "@") }
                    else { if c == 35 { lex_advance(); emit_tok(TOK_HASH, "#") }
                    else { if c == 61 {
                        lex_advance()
                        if lex_peek() == 61 {
                            lex_advance()
                            emit_tok(TOK_EQEQ, "==")
                        } else {
                            if lex_peek() == 62 {
                                lex_advance()
                                emit_tok(TOK_ARROW, "=>")
                            } else {
                                emit_tok(TOK_EQ, "=")
                            }
                        }
                    }
                    else { if c == 33 {
                        lex_advance()
                        if lex_peek() == 61 {
                            lex_advance()
                            emit_tok(TOK_BANGEQ, "!=")
                        } else {
                            emit_tok(TOK_BANG, "!")
                        }
                    }
                    else { if c == 60 {
                        lex_advance()
                        if lex_peek() == 60 {
                            lex_advance()
                            emit_tok(TOK_SHL, "<<")
                        } else {
                            if lex_peek() == 61 {
                                lex_advance()
                                emit_tok(TOK_LTEQ, "<=")
                            } else {
                                emit_tok(TOK_LT, "<")
                            }
                        }
                    }
                    else { if c == 62 {
                        lex_advance()
                        if lex_peek() == 62 {
                            lex_advance()
                            emit_tok(TOK_SHR, ">>")
                        } else {
                            if lex_peek() == 61 {
                                lex_advance()
                                emit_tok(TOK_GTEQ, ">=")
                            } else {
                                emit_tok(TOK_GT, ">")
                            }
                        }
                    }
                    else { if c == 94 {
                        lex_advance()
                        emit_tok(TOK_CARET, "^")
                    }
                    else { if c == 46 {
                        lex_advance()
                        if lex_peek() == 46 {
                            lex_advance()
                            if lex_peek() == 46 {
                                lex_advance()
                                emit_tok(TOK_ELLIPSIS, "...")
                            } else {
                                emit_tok(TOK_DOTDOT, "..")
                            }
                        } else {
                            emit_tok(TOK_DOT, ".")
                        }
                    }
                    else { if c == 63 { lex_advance(); emit_tok(TOK_QUESTION, "?") }
                    else {
                        // Unknown character, skip
                        lex_advance()
                    }
                    } } } } } } } } } } } } } } } } } } } } } } } }
                }
            }
        }
    }
    emit_tok(TOK_EOF, 0)
    return lex_tokens
}

fn tokenize(source) {
    lex_init(source)
    return lex_all()
}
