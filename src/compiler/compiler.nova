// Nova Compiler: Main Entry Point
// Reads a .nova source file, compiles it to x86-64 assembly,
// and writes the output to a .s file.
//
// Usage: nova_boot src/compiler/compiler.nova <input.nova> -o <output.s>
// Or when self-compiled: ./nova <input.nova> -o <output.s>

fn extract_dir(fpath) {
    let last_slash = 0 - 1
    let i = 0
    while i < len(fpath) {
        if char_at(fpath, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    return substr(fpath, 0, last_slash)
}

fn starts_with_str(s, prefix) {
    let plen = len(prefix)
    if len(s) < plen { return 0 }
    let sub = substr(s, 0, plen)
    if sub == prefix { return 1 }
    return 0
}

fn process_line(line, base_dir) {
    if len(line) < 9 {
        return line
    }
    if starts_with_str(line, "import ") == 0 {
        return line
    }
    // Find the first double quote
    let q1 = 0 - 1
    let i = 7
    while i < len(line) {
        if char_at(line, i) == 34 {
            q1 = i
            i = len(line)  // break
        } else {
            i = i + 1
        }
    }
    if q1 < 0 { return line }
    // Find the closing double quote
    let q2 = 0 - 1
    let j = q1 + 1
    while j < len(line) {
        if char_at(line, j) == 34 {
            q2 = j
            j = len(line)  // break
        } else {
            j = j + 1
        }
    }
    if q2 < 0 { return line }
    let imp_path = substr(line, q1 + 1, q2 - q1 - 1)
    let imp_full = concat(base_dir, concat("/", imp_path))
    let content = read_file(imp_full)
    if content == 0 {
        print("Error: cannot import '")
        print(imp_full)
        println("'")
        exit(1)
    }
    return content
}

fn preprocess_imports(source, base_dir) {
    let result = ""
    let i = 0
    let line_start = 0
    let src_len = len(source)

    while i <= src_len {
        let at_end = 0
        if i == src_len { at_end = 1 }
        let is_newline = 0
        if at_end == 0 {
            if char_at(source, i) == 10 { is_newline = 1 }
        }

        if is_newline == 1 {
            let line = substr(source, line_start, i - line_start)
            let processed = process_line(line, base_dir)
            result = concat(result, concat(processed, chr(10)))
            line_start = i + 1
            i = i + 1
        } else {
            if at_end == 1 {
                if i > line_start {
                    let line = substr(source, line_start, i - line_start)
                    let processed = process_line(line, base_dir)
                    result = concat(result, processed)
                }
                i = i + 1
            } else {
                i = i + 1
            }
        }
    }
    return result
}

fn compile(source) {
    let tokens = tokenize(source)
    let ast = parse_program(tokens)
    cg_init()
    let asm_code = gen_program(ast)
    return asm_code
}

fn main() {
    // For bootstrap: source is passed as first argument
    // The bootstrap interpreter receives the file to compile
    // via a special __args builtin or we read it from a known path.
    //
    // For now, read from the file specified on command line.
    // The bootstrap passes argv[2] as the target file (argv[1] is this compiler).

    let input_file = __arg(0)
    let output_file = ""

    if input_file == "" {
        println("Usage: nova <input.nova> [-o output.s]")
        exit(1)
    }

    // Check for -o flag
    let arg1 = __arg(1)
    if arg1 == "-o" {
        output_file = __arg(2)
    } else {
        // Default output name
        output_file = "output.s"
    }

    // Read source
    let source = read_file(input_file)
    if source == 0 {
        println(concat("Error: cannot read file: ", input_file))
        exit(1)
    }

    // Preprocess imports
    let base_dir = extract_dir(input_file)
    source = preprocess_imports(source, base_dir)

    // Compile
    let asm_code = compile(source)

    // Write output
    let ok = write_file(output_file, asm_code)
    if ok == 0 {
        println(concat("Error: cannot write file: ", output_file))
        exit(1)
    }

    println(concat("Compiled: ", concat(input_file, concat(" -> ", output_file))))
}

// Run main
println("=== Nova Compiler Starting ===")
main()
