// Nova Compiler: Main Entry Point
// Reads a .nova source file, compiles it to x86-64 assembly,
// and writes the output to a .s file.
//
// Usage: nova_boot src/compiler/compiler.nova <input.nova> -o <output.s>
// Or when self-compiled: ./nova <input.nova> -o <output.s>

fn extract_dir(fpath) {
    let last_slash = 0 - 1
    let i = 0
    while i < len(fpath) {
        if char_at(fpath, i) == 47 {
            last_slash = i
        }
        i = i + 1
    }
    if last_slash < 0 {
        return "."
    }
    return substr(fpath, 0, last_slash)
}

fn starts_with_str(s, prefix) {
    let plen = len(prefix)
    if len(s) < plen { return 0 }
    let sub = substr(s, 0, plen)
    if sub == prefix { return 1 }
    return 0
}

let nova_root_dir = ""
let imported_files = 0
let _dep_map_keys = 0
let _dep_map_vals = 0
let _dep_map_count = 0
let _import_depth = 0

fn init_import_tracker() {
    imported_files = list_new()
    _import_depth = 0
    _dep_map_keys = list_new()
    _dep_map_vals = list_new()
    _dep_map_count = 0
    _dep_add("tensor", "mem,simd")
    _dep_add("gpu", "ffi")
    _dep_add("llm", "ffi")
    _dep_add("python", "ffi")
    _dep_add("simd", "mem")
    _dep_add("rag", "mem,simd,tensor")
    _dep_add("crypto", "ffi")
    _dep_add("db", "ffi")
    _dep_add("secure_mem", "ffi")
    _dep_add("embed", "ffi")
    _dep_add("taskpool", "ffi")
    _dep_add("ffi", "mem")
    _dep_add("blas", "ffi,mem,simd,tensor")
    _dep_add("embedding", "mem,simd,tensor")
    _dep_add("cognitive_llm", "ffi,mem,simd,tensor,confidence")
}

fn _dep_add(pkg, deps) {
    push(_dep_map_keys, pkg)
    push(_dep_map_vals, deps)
    _dep_map_count = _dep_map_count + 1
}

fn _dep_get(pkg) {
    let i = 0
    while i < _dep_map_count {
        if _dep_map_keys[i] == pkg { return _dep_map_vals[i] }
        i = i + 1
    }
    return ""
}

fn _split_deps(deps_str) {
    let result = list_new()
    let start = 0
    let i = 0
    let slen = len(deps_str)
    while i < slen {
        if char_at(deps_str, i) == 44 {
            if i > start {
                push(result, substr(deps_str, start, i - start))
            }
            start = i + 1
        }
        i = i + 1
    }
    if slen > start {
        push(result, substr(deps_str, start, slen - start))
    }
    return result
}

fn _resolve_deps(pkg_name) {
    let deps_str = _dep_get(pkg_name)
    if len(deps_str) == 0 { return "" }
    let deps = _split_deps(deps_str)
    let result = list_new()
    let di = 0
    while di < len(deps) {
        let dep = deps[di]
        let dep_content = resolve_import("std/" + dep, ".")
        if len(dep_content) > 0 {
            push(result, dep_content)
        }
        di = di + 1
    }
    if len(result) == 0 { return "" }
    return join(result, chr(10))
}

fn already_imported(fpath) {
    let i = 0
    while i < len(imported_files) {
        if imported_files[i] == fpath { return 1 }
        i = i + 1
    }
    return 0
}

fn _is_std_already_imported(pkg_name) {
    let path1 = "nova_packages/" + pkg_name + ".nova"
    if already_imported(path1) == 1 { return 1 }
    let path2 = "src/runtime/" + pkg_name + ".nova"
    if already_imported(path2) == 1 { return 1 }
    if len(nova_root_dir) > 0 {
        let path3 = nova_root_dir + "/src/runtime/" + pkg_name + ".nova"
        if already_imported(path3) == 1 { return 1 }
    }
    return 0
}

fn extract_import_path(line) {
    let q1 = 0 - 1
    let i = 7
    while i < len(line) {
        if char_at(line, i) == 34 {
            q1 = i
            i = len(line)
        } else {
            i = i + 1
        }
    }
    if q1 < 0 { return "" }
    let q2 = 0 - 1
    let j = q1 + 1
    while j < len(line) {
        if char_at(line, j) == 34 {
            q2 = j
            j = len(line)
        } else {
            j = j + 1
        }
    }
    if q2 < 0 { return "" }
    return substr(line, q1 + 1, q2 - q1 - 1)
}

fn resolve_import(imp_path, base_dir) {
    if _import_depth > 20 {
        print("Error: import depth exceeded for '")
        print(imp_path)
        println("' (circular dependency?)")
        exit(1)
    }
    _import_depth = _import_depth + 1
    let result = _resolve_import_inner(imp_path, base_dir)
    _import_depth = _import_depth - 1
    return result
}

fn _resolve_import_inner(imp_path, base_dir) {
    if len(imp_path) > 4 {
        if substr(imp_path, 0, 4) == "std/" {
            let pkg_name = substr(imp_path, 4, len(imp_path) - 4)
            pkg_init_std()
            if is_std_package(pkg_name) == 1 {
                if _is_std_already_imported(pkg_name) == 1 {
                    return ""
                }
                let dep_content = _resolve_deps(pkg_name)
                let file_content = _find_std_file(pkg_name)
                if len(file_content) == 0 {
                    print("Error: std package '")
                    print(pkg_name)
                    println("' not found")
                    exit(1)
                }
                if len(dep_content) > 0 {
                    return dep_content + chr(10) + file_content
                }
                return file_content
            }
        }
    }
    let pkg_path = "nova_packages/" + imp_path
    if len(imp_path) < 6 {
        pkg_path = "nova_packages/" + imp_path + ".nova"
    } else {
        let ext = substr(imp_path, len(imp_path) - 5, 5)
        if ext == ".nova" {
            pkg_path = "nova_packages/" + imp_path
        } else {
            pkg_path = "nova_packages/" + imp_path + ".nova"
        }
    }
    let pkg_content = read_file(pkg_path)
    if pkg_content == 0 {
    } else {
        if already_imported(pkg_path) == 0 {
            push(imported_files, pkg_path)
            let processed = _recursive_import(pkg_content, extract_dir(pkg_path))
            return processed
        }
        return ""
    }
    let imp_full = concat(base_dir, concat("/", imp_path))
    if already_imported(imp_full) == 0 {
        let content = read_file(imp_full)
        if content == 0 {
            print("Error: cannot import '")
            print(imp_path)
            println("'")
            println("  Searched:")
            println("    " + pkg_path)
            println("    " + imp_full)
            exit(1)
        }
        push(imported_files, imp_full)
        let processed = _recursive_import(content, extract_dir(imp_full))
        return processed
    }
    return ""
}

fn _find_std_file(pkg_name) {
    let local_path = "nova_packages/" + pkg_name + ".nova"
    let local_content = read_file(local_path)
    if local_content == 0 {
    } else {
        if already_imported(local_path) == 0 {
            push(imported_files, local_path)
            return local_content
        }
        return ""
    }
    if len(nova_root_dir) > 0 {
        let std_path = nova_root_dir + "/src/runtime/" + pkg_name + ".nova"
        let std_content = read_file(std_path)
        if std_content == 0 {
        } else {
            if already_imported(std_path) == 0 {
                push(imported_files, std_path)
                return std_content
            }
            return ""
        }
    }
    let fallback = "src/runtime/" + pkg_name + ".nova"
    let fb_content = read_file(fallback)
    if fb_content == 0 {
    } else {
        if already_imported(fallback) == 0 {
            push(imported_files, fallback)
            return fb_content
        }
        return ""
    }
    return ""
}

fn _recursive_import(content, content_dir) {
    if has_imports(content) == 0 { return content }
    return preprocess_imports(content, content_dir)
}

fn process_line(line, base_dir) {
    if len(line) < 9 {
        return line
    }
    if starts_with_str(line, "import ") == 0 {
        return line
    }
    let imp_path = extract_import_path(line)
    if len(imp_path) == 0 { return line }
    return resolve_import(imp_path, base_dir)
}

fn has_imports(source) {
    // Quick check: does the source contain "import " at line start?
    // "import " = chars 105, 109, 112, 111, 114, 116, 32
    let src_len = len(source)
    let i = 0
    while i < src_len {
        let at_start = 0
        if i == 0 { at_start = 1 }
        if i > 0 {
            if char_at(source, i - 1) == 10 { at_start = 1 }
        }
        if at_start == 1 {
            if i + 6 < src_len {
                if char_at(source, i) == 105 {
                    if char_at(source, i + 1) == 109 {
                        if char_at(source, i + 2) == 112 {
                            if char_at(source, i + 3) == 111 {
                                if char_at(source, i + 4) == 114 {
                                    if char_at(source, i + 5) == 116 {
                                        if char_at(source, i + 6) == 32 {
                                            return 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn preprocess_imports(source, base_dir) {
    if has_imports(source) == 0 {
        return source
    }
    let imports = list_new()
    let rest_start = 0
    let i = 0
    let line_start = 0
    let src_len = len(source)
    let found_non_import = 0

    while i <= src_len {
        let at_end = 0
        if i == src_len { at_end = 1 }
        let is_newline = 0
        if at_end == 0 {
            if char_at(source, i) == 10 { is_newline = 1 }
        }

        if is_newline == 1 {
            if found_non_import == 0 {
                let line = substr(source, line_start, i - line_start)
                if starts_with_str(line, "import ") == 1 {
                    let imp_path = extract_import_path(line)
                    if len(imp_path) > 0 {
                        let content = resolve_import(imp_path, base_dir)
                        if len(content) > 0 {
                            push(imports, content)
                        }
                    }
                } else {
                    if len(line) > 0 {
                        if starts_with_str(line, "//") == 0 {
                            found_non_import = 1
                            rest_start = line_start
                        }
                    }
                }
            }
            line_start = i + 1
            i = i + 1
        } else {
            if at_end == 1 {
                i = i + 1
            } else {
                i = i + 1
            }
        }
    }
    let rest = ""
    if found_non_import == 1 {
        rest = substr(source, rest_start, src_len - rest_start)
    }
    push(imports, rest)
    return join(imports, chr(10))
}

let cg_show_stats = 0
let cg_check_only = 0

fn compile(source) {
    let tokens = tokenize(source)
    par_set_source(source)
    let ast = parse_program(tokens)
    if cg_check_only == 1 {
        println("OK: syntax check passed")
        exit(0)
    }
    cg_init()
    let asm_code = gen_program(ast)
    if cg_show_stats == 1 {
        println("--- Compilation Stats ---")
        print("  Source size:   ")
        print(int_to_str(len(source)))
        println(" bytes")
        print("  Tokens:       ")
        println(int_to_str(len(tokens)))
        print("  Functions:    ")
        println(int_to_str(len(cg_fns)))
        print("  Globals:      ")
        println(int_to_str(cg_global_count))
        print("  Strings:      ")
        println(int_to_str(cg_str_count))
        print("  Labels:       ")
        println(int_to_str(cg_label_count))
        print("  Output size:  ")
        print(int_to_str(len(asm_code)))
        println(" bytes")
    }
    return asm_code
}

fn main() {
    let input_file = ""
    let output_file = "output.s"
    let ai = 0
    let cur = __arg(ai)

    // Check for pkg subcommand
    if cur == "pkg" {
        let pkg_args = list_new()
        ai = ai + 1
        cur = __arg(ai)
        while len(cur) > 0 {
            push(pkg_args, cur)
            ai = ai + 1
            cur = __arg(ai)
        }
        pkg_run(pkg_args)
        return 0
    }

    while len(cur) > 0 {
        if cur == "-o" {
            ai = ai + 1
            output_file = __arg(ai)
        } else {
            if starts_with_str(cur, "--target=") == 1 {
                let tname = substr(cur, 9, len(cur) - 9)
                if tname == "macos" {
                    cg_target = 1
                    println("Target: macOS (x86-64)")
                } else {
                    if tname == "linux" {
                        cg_target = 0
                    } else {
                        if tname == "wasm" {
                            cg_target = 2
                            println("Target: WebAssembly (WASI)")
                        } else {
                            if tname == "windows" {
                                cg_target = 3
                                println("Target: Windows (x86-64)")
                            } else {
                                println(concat("Unknown target: ", tname))
                                println("Supported targets: linux, macos, wasm, windows")
                                exit(1)
                            }
                        }
                    }
                }
            } else {
                if starts_with_str(cur, "--nova-root=") == 1 {
                    nova_root_dir = substr(cur, 12, len(cur) - 12)
                } else {
                    if cur == "--no-debug" {
                        cg_debug = 0
                    } else {
                        if cur == "--debug" {
                            cg_debug = 1
                        } else {
                            if cur == "--stats" {
                                cg_show_stats = 1
                            } else {
                                if cur == "--check" {
                                    cg_check_only = 1
                                } else {
                                    if cur == "--link-libc" {
                                        cg_link_libc = 1
                                        println("Mode: linking with libc (FFI enabled)")
                                    } else {
                                        if cur == "--version" {
                                            println("Nova compiler v4.0.0 (self-hosting, x86-64, SSE2 SIMD, FFI, BLAS, cognitive LLM)")
                                            println("Target: Linux/macOS/WASM/Windows")
                                            exit(0)
                                        } else {
                                            input_file = cur
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ai = ai + 1
        cur = __arg(ai)
    }

    if input_file == "" {
        println("Usage: nova <input.nova> [-o output.s] [options]")
        println("")
        println("Options:")
        println("  -o <file>              Output assembly file (default: output.s)")
        println("  --target=<t>           Target: linux, macos, wasm")
        println("  --check                Syntax check only (no codegen)")
        println("  --stats                Show compilation statistics")
        println("  --debug / --no-debug   Enable/disable debug info")
        println("  --version              Show compiler version")
        println("")
        println("Subcommands:")
        println("  nova pkg <init|add|remove|list|install>")
        exit(1)
    }

    init_import_tracker()
    cg_source_file = input_file

    let source = read_file(input_file)
    if source == 0 {
        println(concat("Error: cannot read file: ", input_file))
        exit(1)
    }

    let base_dir = extract_dir(input_file)
    source = preprocess_imports(source, base_dir)

    let asm_code = compile(source)

    let ok = write_file(output_file, asm_code)
    if ok == 0 {
        println(concat("Error: cannot write file: ", output_file))
        exit(1)
    }

    println(concat("Compiled: ", concat(input_file, concat(" -> ", output_file))))
}

// Run main
println("=== Nova Compiler Starting ===")
main()
