    // str_to_int — parse integer from string
    wi("(func $str_to_int (param $s i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i32)")
    wi("(local $result i64)")
    wi("(local $c i32)")
    wi("(local $neg i32)")
    wi("local.get $s")
    wi("i32.wrap_i64")
    wi("local.set $ptr")
    wi("local.get $ptr")
    wi("i32.load8_u")
    wi("i32.const 45")
    wi("i32.eq")
    wi("if")
    wi("  i32.const 1")
    wi("  local.set $neg")
    wi("  local.get $ptr")
    wi("  i32.const 1")
    wi("  i32.add")
    wi("  local.set $ptr")
    wi("end")
    wi("block $done")
    wi("loop $parse")
    wasm_indent = wasm_indent + 1
