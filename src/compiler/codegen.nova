    // --- get_error() -> returns error value from last throw ---
    out("")
    out_label("_nova_get_error")
    out("    mov rax, [rip + _nova_error_value]")
    out("    ret")
    out_label("get_error")
    out("    jmp _nova_get_error")
    out_label("map_list")
    out("    jmp _nova_map_list")
