        gen_block(catch_body)
        out("    mov qword ptr [rip + _nova_error_flag], 0")
        out_label(tend_lbl)
        cg_catch_label = old_catch
        return 0
    }

    out("    # unknown expr tag " + int_to_str(tag))
}

fn gen_stmt(nd) {
    cg_emit_loc(nd)
    let tag = ast_tag(nd)

    if tag == AST_LET_STMT {
        let name = nd[1]
        let value = nd[2]
        if is_float_expr(value) == 1 {
            mark_float_var(name)
        }
        gen_expr(value)
        if is_global(name) == 1 {
            out("    mov [rip + _g_" + name + "], rax")
        } else {
            // R37A: if this local is captured by a nested lambda, allocate
            // a 1-element box list and store [value] in it. The box pointer
            // is the slot's value; reads/writes go through box[0].
            if is_boxed_local(name) == 1 {
                cg_emit_alloc_box()
            }
            let off = local_offset(name)
            out("    mov [rbp - " + int_to_str(off) + "], rax")
        }
        return 0
    }

    if tag == AST_ASSIGN_STMT {
        let name = nd[1]
        let value = nd[2]
        // R38A: keep is_float_expr here (vs is_float_typed at let-stmt).
        // Self-host stage1-from-source segfaults when the assign site
        // uses is_float_typed; root-cause TBD (the let-stmt path with
        // the same predicate works). Tracked as R38A.2 — for now, a
        // float-reassignment-from-comparison-result will be silently
        // mis-tracked as float, but no production code in self-host
        // hits that pattern.
        if is_float_expr(value) == 1 {
            mark_float_var(name)
        }
        gen_expr(value)
        if has_local(name) == 1 {
            // R37A: boxed locals write through the box.
            if is_boxed_local(name) == 1 {
                let off2 = local_offset(name)
                out("    mov rcx, [rbp - " + int_to_str(off2) + "]")
                out("    mov rdx, [rcx + 24]")
                out("    mov [rdx], rax")
            } else {
                let off = local_offset(name)
                out("    mov [rbp - " + int_to_str(off) + "], rax")
            }
        } else {
            if is_capture_var(name) == 1 {
                // R37A: write through captures_list[idx] -> box[0].
                let cidx = capture_index(name)
                cg_emit_capture_store(cidx)
            } else {
                if is_global(name) == 1 {
                    out("    mov [rip + _g_" + name + "], rax")
                } else {
                    let off = local_offset(name)
                    out("    mov [rbp - " + int_to_str(off) + "], rax")
                }
            }
        }
        return 0
    }

    if tag == AST_RETURN_STMT {
        let value = nd[1]
        if value == 0 {
            gen_defers()
            out("    xor eax, eax")
            out("    mov rsp, rbp")
            out("    pop rbp")
            out("    ret")
            return 0
        }
        if cg_defer_count == 0 {
            if len(cg_current_fn) > 0 {
                if ast_tag(value) == AST_CALL {
                    let tc_callee = value[1]
                    if ast_tag(tc_callee) == AST_IDENT {
                        if tc_callee[1] == cg_current_fn {
                            let tc_args = value[2]
                            let tc_argc = len(tc_args)
                            if tc_argc <= 6 {
                                gen_tco_call(tc_args, tc_argc)
                                return 0
                            }
                        }
                    }
                }
            }
        }
        gen_expr(value)
        if cg_defer_count > 0 {
            out("    push rax")
            gen_defers()
            out("    pop rax")
        }
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
        return 0
    }

    if tag == AST_IF_STMT {
        let cond = nd[1]
        let then_body = nd[2]
        let else_body = nd[3]

        // --- Optimization: Dead Code Elimination for constant conditions ---
        let cond_val = try_fold(cond)
        if is_foldable(cond_val) == 1 {
            if cond_val == 0 {
                // Condition is always false: only emit else branch (if any)
                if else_body == 0 {
                    // No else branch, entire if is dead code
                } else {
                    if ast_tag(else_body) == AST_IF_STMT {
                        gen_stmt(else_body)
                    } else {
                        gen_block(else_body)
                    }
                }
                return 0
            } else {
                // Condition is always true: only emit then branch
                gen_block(then_body)
                return 0
            }
        }

        // Non-constant condition: generate normal if/else
        let else_lbl = new_label()
        let end_lbl = new_label()
        gen_expr(cond)
        out("    cmp rax, 2")
        out("    jb " + else_lbl)
        gen_block(then_body)
        out("    jmp " + end_lbl)
        out_label(else_lbl)
        if else_body == 0 {
        } else {
            if ast_tag(else_body) == AST_IF_STMT {
                gen_stmt(else_body)
            } else {
                gen_block(else_body)
            }
        }
        out_label(end_lbl)
        return 0
    }

    if tag == AST_WHILE_STMT {
        let cond = nd[1]
        let body = nd[2]
        let wlabel = ""
        let while_else = 0
        if len(nd) > 3 { wlabel = nd[3] }
        if len(nd) > 4 { while_else = nd[4] }

        let cond_val = try_fold(cond)
        if is_foldable(cond_val) == 1 {
            if cond_val == 0 {
                if while_else != 0 {
                    gen_block(while_else)
                }
                return 0
            }
        }

        let loop_lbl = new_label()
        let end_lbl = new_label()
        let nobreak_lbl = end_lbl
        if while_else != 0 {
            nobreak_lbl = new_label()
        }
        let prev_break = cg_break_label
        let prev_continue = cg_continue_label
        cg_break_label = end_lbl
        cg_continue_label = loop_lbl
        if wlabel == "" {
        } else {
            push(cg_lbl_names, wlabel)
            push(cg_lbl_breaks, end_lbl)
            push(cg_lbl_continues, loop_lbl)
            cg_lbl_count = cg_lbl_count + 1
        }
        out_label(loop_lbl)
        gen_expr(cond)
        out("    cmp rax, 2")
        out("    jb " + nobreak_lbl)
        gen_block(body)
        out("    jmp " + loop_lbl)
        if while_else != 0 {
            out_label(nobreak_lbl)
            gen_block(while_else)
        }
        out_label(end_lbl)
        cg_break_label = prev_break
        cg_continue_label = prev_continue
        if wlabel == "" {
        } else {
            cg_lbl_count = cg_lbl_count - 1
        }
        return 0
    }

    if tag == AST_FOR_STMT {
        let var_name = nd[1]
        let iter_expr = nd[2]
        let body = nd[3]
        let flabel = ""
        let for_else = 0
        if len(nd) > 4 { flabel = nd[4] }
        if len(nd) > 5 { for_else = nd[5] }
        let var_off = local_offset(var_name)

        let is_range = 0
        if ast_tag(iter_expr) == AST_CALL {
            let callee = iter_expr[1]
            if ast_tag(callee) == AST_IDENT {
                if callee[1] == "range" {
                    is_range = 1
                }
            }
        }

        if is_range == 1 {
            let args = iter_expr[2]
            let argc = len(args)
            let has_step = 0
            if argc == 1 {
                out("    mov qword ptr [rbp - " + int_to_str(var_off) + "], 1")  // tagged 0
                gen_expr(args[0])
                out("    push rax")
            } else {
                gen_expr(args[0])
                out("    mov [rbp - " + int_to_str(var_off) + "], rax")
                gen_expr(args[1])
                out("    push rax")
            }
            if argc >= 3 {
                gen_expr(args[2])
                out("    push rax")
                has_step = 1
            }
            let loop_lbl = new_label()
            let end_lbl = new_label()
            let cont_lbl = new_label()
            let break_lbl = end_lbl
            if for_else != 0 { break_lbl = new_label() }
            let prev_break = cg_break_label
            let prev_continue = cg_continue_label
            cg_break_label = break_lbl
            cg_continue_label = cont_lbl
            if flabel == "" {
            } else {
                push(cg_lbl_names, flabel)
                push(cg_lbl_breaks, break_lbl)
                push(cg_lbl_continues, cont_lbl)
                cg_lbl_count = cg_lbl_count + 1
            }
            out_label(loop_lbl)
            out("    mov rax, [rbp - " + int_to_str(var_off) + "]")
            if has_step == 1 {
                out("    mov rcx, [rsp]")
                out("    test rcx, rcx")
                let neg_lbl = new_label()
                let check_done = new_label()
                out("    js " + neg_lbl)
                out("    cmp rax, [rsp+8]")
                out("    jge " + end_lbl)
                out("    jmp " + check_done)
                out_label(neg_lbl)
                out("    cmp rax, [rsp+8]")
                out("    jle " + end_lbl)
                out_label(check_done)
            } else {
                out("    cmp rax, [rsp]")
                out("    jge " + end_lbl)
            }
            gen_block(body)
            out_label(cont_lbl)
            if has_step == 1 {
                out("    mov rax, [rsp]")
                out("    add [rbp - " + int_to_str(var_off) + "], rax")
                out("    dec qword ptr [rbp - " + int_to_str(var_off) + "]")   // tagged step
            } else {
                out("    add qword ptr [rbp - " + int_to_str(var_off) + "], 2")  // tagged +1
            }
            out("    jmp " + loop_lbl)
            if for_else != 0 {
                out_label(break_lbl)
                if has_step == 1 {
                    out("    add rsp, 16")
                } else {
                    out("    add rsp, 8")
                }
                let skip_lbl = new_label()
                out("    jmp " + skip_lbl)
                out_label(end_lbl)
                if has_step == 1 {
                    out("    add rsp, 16")
                } else {
                    out("    add rsp, 8")
                }
                gen_block(for_else)
                out_label(skip_lbl)
            } else {
                out_label(end_lbl)
                if has_step == 1 {
                    out("    add rsp, 16")
                } else {
                    out("    add rsp, 8")
                }
            }
            cg_break_label = prev_break
            cg_continue_label = prev_continue
            if flabel == "" {
            } else {
                cg_lbl_count = cg_lbl_count - 1
            }
            return 0
        } else {
            gen_expr(iter_expr)
            out("    push rax")
            out("    push 0")
            let loop_lbl = new_label()
            let end_lbl = new_label()
            let cont_lbl = new_label()
            let break_lbl = end_lbl
            if for_else != 0 { break_lbl = new_label() }
            let prev_break = cg_break_label
            let prev_continue = cg_continue_label
            cg_break_label = break_lbl
            cg_continue_label = cont_lbl
            if flabel == "" {
            } else {
                push(cg_lbl_names, flabel)
                push(cg_lbl_breaks, break_lbl)
                push(cg_lbl_continues, cont_lbl)
                cg_lbl_count = cg_lbl_count + 1
            }
            // Convert strings to char code lists for iteration
            out("    mov rdi, [rsp+8]")
            out("    cmp qword ptr [rdi], -1")
            out("    je " + loop_lbl)
            out("    mov rdi, [rsp+8]")
            out("    call _nova_str_to_chars")
            out("    mov [rsp+8], rax")
            // List iteration
            out_label(loop_lbl)
            out("    mov rcx, [rsp]")
            out("    mov rdi, [rsp+8]")
            out("    cmp rcx, [rdi+8]")
            out("    jge " + end_lbl)
            out("    mov rdi, [rdi+24]")
            out("    mov rax, [rdi+rcx*8]")
            out("    mov [rbp - " + int_to_str(var_off) + "], rax")
            gen_block(body)
            out_label(cont_lbl)
            out("    inc qword ptr [rsp]")
            out("    jmp " + loop_lbl)
            if for_else != 0 {
                out_label(break_lbl)
                out("    add rsp, 16")
                let skip_lbl = new_label()
                out("    jmp " + skip_lbl)
                out_label(end_lbl)
                out("    add rsp, 16")
                gen_block(for_else)
                out_label(skip_lbl)
            } else {
                out_label(end_lbl)
                out("    add rsp, 16")
            }
            cg_break_label = prev_break
            cg_continue_label = prev_continue
            if flabel == "" {
            } else {
                cg_lbl_count = cg_lbl_count - 1
            }
            return 0
        }
    }

    if tag == AST_DO_WHILE {
        let body = nd[1]
        let cond = nd[2]
        let loop_lbl = new_label()
        let end_lbl = new_label()
        let cont_lbl = new_label()
        let prev_break = cg_break_label
        let prev_continue = cg_continue_label
        cg_break_label = end_lbl
        cg_continue_label = cont_lbl
        out_label(loop_lbl)
        gen_block(body)
        out_label(cont_lbl)
        gen_expr(cond)
        out("    cmp rax, 2")
        out("    jae " + loop_lbl)
        out_label(end_lbl)
        cg_break_label = prev_break
        cg_continue_label = prev_continue
        return 0
    }

    if tag == AST_EXPR_STMT {
        gen_expr(nd[1])
        return 0
    }

    if tag == AST_DEFER_STMT {
        push(cg_defers, nd[1])
        cg_defer_count = cg_defer_count + 1
        return 0
    }

    if tag == AST_BREAK_STMT {
        if len(nd) > 1 {
            let blbl = nd[1]
            let bi = 0
            while bi < cg_lbl_count {
                if cg_lbl_names[bi] == blbl {
                    out("    jmp " + cg_lbl_breaks[bi])
                    return 0
                }
                bi = bi + 1
            }
        }
        out("    jmp " + cg_break_label)
        return 0
    }

    if tag == AST_CONTINUE_STMT {
        if len(nd) > 1 {
            let clbl = nd[1]
            let ci = 0
            while ci < cg_lbl_count {
                if cg_lbl_names[ci] == clbl {
                    out("    jmp " + cg_lbl_continues[ci])
                    return 0
                }
                ci = ci + 1
            }
        }
        out("    jmp " + cg_continue_label)
        return 0
    }

    if tag == AST_INDEX_ASSIGN {
        let base = nd[1]
        let idx = nd[2]
        let value = nd[3]
        gen_expr(value)
        out("    push rax")
        gen_expr(idx)
        out("    push rax")
        gen_expr(base)
        out("    mov rcx, [rax + 24]")
        out("    pop rsi")
        out("    sar rsi, 1")               // untag index
        out("    pop rdx")
        out("    mov [rcx + rsi*8], rdx")
        return 0
    }

    if tag == AST_FIELD_ASSIGN {
        let base = nd[1]
        let field_name = nd[2]
        let value = nd[3]
        let idx = find_field_index(field_name)
        gen_expr(value)
        out("    push rax")
        gen_expr(base)
        out("    mov rcx, [rax + 24]")
        out("    pop rdx")
        out("    mov [rcx + " + int_to_str(idx * 8) + "], rdx")
        return 0
    }

    if tag == AST_STRUCT_DECL {
        return 0
    }

    if tag == AST_ENUM_DECL {
        return 0
    }

    if tag == AST_BLOCK {
        gen_block(nd)
        return 0
    }

    if tag == AST_MATCH_STMT {
        let expr = nd[1]
        let arms = nd[2]
        let end_lbl = new_label()

        cg_check_exhaustive(nd)
        // Evaluate the match expression once, save on stack
        gen_expr(expr)
        out("    push rax")

        let i = 0
        while i < len(arms) {
            let arm = arms[i]
            let pattern = arm[1]
            let body = arm[2]
            let pat_tag = ast_tag(pattern)

            let has_guard = 0
            if len(arm) > 3 { has_guard = 1 }
            if pat_tag == AST_WILDCARD {
                let next_arm_w = new_label()
                if has_guard == 1 {
                    gen_expr(arm[3])
                    out("    cmp rax, 2")
                    out("    jb " + next_arm_w)
                }
                out("    add rsp, 8")
                if ast_tag(body) == AST_BLOCK {
                    gen_block(body)
                } else {
                    gen_stmt(body)
                }
                out("    jmp " + end_lbl)
                if has_guard == 1 {
                    out_label(next_arm_w)
                }
            } else { if pat_tag == AST_TYPE_PATTERN {
                let next_arm_t = new_label()
                let tp_id = pattern[1]
                out("    mov rdi, [rsp]")
                out("    call _nova_type_of")
                out("    cmp rax, " + int_to_str(tp_id))
                out("    jne " + next_arm_t)
                if has_guard == 1 {
                    gen_expr(arm[3])
                    out("    cmp rax, 2")
                    out("    jb " + next_arm_t)
                }
                out("    add rsp, 8")
                if ast_tag(body) == AST_BLOCK {
                    gen_block(body)
                } else {
                    gen_stmt(body)
                }
                out("    jmp " + end_lbl)
                out_label(next_arm_t)
            } else { if pat_tag == AST_ENUM_PATTERN {
                // R17A: sum-type pattern (statement-position match).
                // Same shape as the expression-position arm in gen_expr.
                let next_arm_e = new_label()
                let ep2_enum = pattern[1]
                let ep2_variant = pattern[2]
                let ep2_binders = pattern[3]
                let ep2_tag = enum_variant_index(ep2_enum, ep2_variant)
                out("    mov rax, [rsp]")
                out("    mov rdi, rax")
                out("    mov rsi, 0")
                out("    call _nova_index")
                out("    cmp rax, " + int_to_str(ep2_tag))
                out("    jne " + next_arm_e)
                let ebi2 = 0
                while ebi2 < len(ep2_binders) {
                    let bname2 = ep2_binders[ebi2]
                    if bname2 == "_" {
                    } else {
                        out("    mov rax, [rsp]")
                        out("    mov rdi, rax")
                        out("    mov rsi, " + int_to_str(ebi2 + 1))
                        out("    call _nova_index")
                        if is_global(bname2) == 1 {
                            out("    mov [rip + _g_" + bname2 + "], rax")
                        } else {
                            let boff2 = local_offset(bname2)
                            out("    mov [rbp - " + int_to_str(boff2) + "], rax")
                        }
                    }
                    ebi2 = ebi2 + 1
                }
                if has_guard == 1 {
                    gen_expr(arm[3])
                    out("    cmp rax, 2")
                    out("    jb " + next_arm_e)
                }
                out("    add rsp, 8")
                if ast_tag(body) == AST_BLOCK {
                    gen_block(body)
                } else {
                    gen_stmt(body)
                }
                out("    jmp " + end_lbl)
                out_label(next_arm_e)
            } else {
                // Compare match value with pattern
                let next_arm = new_label()
                gen_expr(pattern)
                out("    mov rcx, rax")
                out("    mov rax, [rsp]")
                out("    mov rdi, rax")
                out("    mov rsi, rcx")
                out("    call _nova_eq")
                out("    cmp rax, 2")
                out("    jb " + next_arm)
                if has_guard == 1 {
                    gen_expr(arm[3])
                    out("    cmp rax, 2")
                    out("    jb " + next_arm)
                }
                // Match! Execute body
                out("    add rsp, 8")
                if ast_tag(body) == AST_BLOCK {
                    gen_block(body)
                } else {
                    gen_stmt(body)
                }
                out("    jmp " + end_lbl)
                out_label(next_arm)
            } } }
            i = i + 1
        }

        // If no arm matched, clean up stack
        out("    add rsp, 8")
        out_label(end_lbl)
        return 0
    }

    if tag == AST_TRY_CATCH {
        let try_body = nd[1]
        let catch_body = nd[2]
        let catch_err_var = nd[3]
        let catch_lbl = new_label()
        let end_lbl = new_label()

        let old_catch = cg_catch_label
        cg_catch_label = catch_lbl

        out("    mov rdi, 32")
        out("    call _nova_alloc")
        out("    mov rcx, [rip + _nova_catch_stack]")
        out("    mov [rax], rcx")
        out("    mov [rax + 8], rbp")
        out("    mov [rax + 16], rsp")
        out("    lea rcx, [rip + " + catch_lbl + "]")
        out("    mov [rax + 24], rcx")
        out("    mov [rip + _nova_catch_stack], rax")
        out("    mov qword ptr [rip + _nova_error_flag], 0")

        gen_block(try_body)

        out("    mov rcx, [rip + _nova_catch_stack]")
        out("    mov rcx, [rcx]")
        out("    mov [rip + _nova_catch_stack], rcx")
        out("    jmp " + end_lbl)

        out_label(catch_lbl)
        if catch_err_var == "" {
        } else {
            out("    mov rax, [rip + _nova_error_value]")
            if is_global(catch_err_var) == 1 {
                out("    mov [rip + _g_" + catch_err_var + "], rax")
            } else {
                let eoff = local_offset(catch_err_var)
                out("    mov [rbp - " + int_to_str(eoff) + "], rax")
            }
        }
        gen_block(catch_body)
        out("    mov qword ptr [rip + _nova_error_flag], 0")

        out_label(end_lbl)
        if len(nd) > 5 {
            gen_block(nd[4])
        }

        cg_catch_label = old_catch
        return 0
    }

    if tag == AST_THROW {
        let value = nd[1]
        gen_expr(value)
        out("    mov rdi, rax")
        out("    call _nova_throw_impl")
        return 0
    }

    if tag == AST_DESTRUCTURE {
        let dnames = nd[1]
        let dvalue = nd[2]
        gen_expr(dvalue)
        out("    push rax")
        let di = 0
        while di < len(dnames) {
            let dname = dnames[di]
            out("    mov rax, [rsp]")
            out("    mov rdi, rax")
            out("    mov rsi, " + int_to_str(di))
            out("    call _nova_index")
            if is_global(dname) == 1 {
                out("    mov [rip + _g_" + dname + "], rax")
            } else {
                let doff = local_offset(dname)
                out("    mov [rbp - " + int_to_str(doff) + "], rax")
            }
            di = di + 1
        }
        // See collect_locals comment: rest node has length 5 (tag,
        // dnames, dvalue, rest_name, line), non-rest has length 4.
        if len(nd) > 4 {
            let drname = nd[3]
            out("    mov rdi, [rsp]")
            out("    call _nova_len")
            out("    mov rdx, rax")
            out("    mov rdi, [rsp]")
            out("    mov rsi, " + int_to_str(len(dnames)))
            out("    call _nova_list_slice")
            if is_global(drname) == 1 {
                out("    mov [rip + _g_" + drname + "], rax")
            } else {
                let droff = local_offset(drname)
                out("    mov [rbp - " + int_to_str(droff) + "], rax")
            }
        }
        out("    add rsp, 8")
        return 0
    }

    if tag == AST_ASM {
        let asm_lines = nd[1]
        let ai = 0
        while ai < len(asm_lines) {
            out("    " + asm_lines[ai])
            ai = ai + 1
        }
        return 0
    }

    if tag == AST_FOR_INDEXED {
        let idx_name = nd[1]
        let val_name = nd[2]
        let iter_expr = nd[3]
        let body = nd[4]
        let filabel = ""
        if len(nd) > 6 { filabel = nd[5] }
        let idx_off = local_offset(idx_name)
        let val_off = local_offset(val_name)
        gen_expr(iter_expr)
        let fi_notmap = new_label()
        let fi_ready = new_label()
        out("    cmp qword ptr [rax], -2")
        out("    jne " + fi_notmap)
        out("    mov rdi, rax")
        out("    call _nova_map_entries")
        out("    push rax")
        out("    push 1")
        out("    jmp " + fi_ready)
        out_label(fi_notmap)
        out("    push rax")
        out("    push 0")
        out_label(fi_ready)
        out("    push 0")
        let fi_loop = new_label()
        let fi_end = new_label()
        let fi_cont = new_label()
        let prev_break = cg_break_label
        let prev_continue = cg_continue_label
        cg_break_label = fi_end
        cg_continue_label = fi_cont
        if filabel == "" {
        } else {
            push(cg_lbl_names, filabel)
            push(cg_lbl_breaks, fi_end)
            push(cg_lbl_continues, fi_cont)
            cg_lbl_count = cg_lbl_count + 1
        }
        let fi_map_path = new_label()
        let fi_body = new_label()
        out_label(fi_loop)
        out("    mov rcx, [rsp]")
        out("    mov rdi, [rsp+16]")
        out("    cmp qword ptr [rsp+8], 1")
        out("    je " + fi_map_path)
        out("    cmp rcx, [rdi+8]")
        out("    jge " + fi_end)
        out("    lea rdx, [rcx + rcx + 1]")     // tag index
        out("    mov [rbp - " + int_to_str(idx_off) + "], rdx")
        out("    mov rdi, [rdi+24]")
        out("    mov rax, [rdi+rcx*8]")
        out("    mov [rbp - " + int_to_str(val_off) + "], rax")
        out("    jmp " + fi_body)
        out_label(fi_map_path)
        out("    mov rax, [rdi+8]")
        out("    shr rax, 1")
        out("    cmp rcx, rax")
        out("    jge " + fi_end)
        out("    mov rdi, [rdi+24]")
        out("    mov rax, rcx")
        out("    shl rax, 1")
        out("    mov rdx, [rdi+rax*8]")
        out("    mov [rbp - " + int_to_str(idx_off) + "], rdx")
        out("    inc rax")
        out("    mov rdx, [rdi+rax*8]")
        out("    mov [rbp - " + int_to_str(val_off) + "], rdx")
        out_label(fi_body)
        gen_block(body)
        out_label(fi_cont)
        out("    inc qword ptr [rsp]")
        out("    jmp " + fi_loop)
        out_label(fi_end)
        out("    add rsp, 24")
        cg_break_label = prev_break
        cg_continue_label = prev_continue
        if filabel == "" {
        } else {
            cg_lbl_count = cg_lbl_count - 1
        }
        return 0
    }

    // R33C: AST_DO_EXPR can land in statement position when the parser
    // R25A / R32D matchee-cache rewrite fires for an `if let` whose
    // pattern is a struct or nested variant pattern. Run the init
    // statements (the cache_let `let _struct_match_N = scrutinee`),
    // then dispatch the final expression (always a match) to gen_expr
    // so it emits the per-arm code and discard the result — same
    // shape as AST_EXPR_STMT wrapping a do-expr in the match-arm
    // rewrite path R25A introduced. Without this branch, statement-
    // position if-let on nested patterns would silently emit no code
    // (gen_stmt's unknown-tag catch-all) and the arm bodies would
    // never run.
    if tag == AST_DO_EXPR {
        let do_stmts = nd[1]
        let do_final = nd[2]
        let di = 0
        while di < len(do_stmts) {
            gen_stmt(do_stmts[di])
            di = di + 1
        }
        gen_expr(do_final)
        return 0
    }

    out("    # unknown stmt tag " + int_to_str(tag))
}

fn escape_for_asm(s) {
    let bs = chr(92)
    let result = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        let esc_done = 0
        if c == 10 { result = result + bs + "n"; esc_done = 1 }
        if c == 9 { if esc_done == 0 { result = result + bs + "t"; esc_done = 1 } }
        if c == 13 { if esc_done == 0 { result = result + bs + "r"; esc_done = 1 } }
        if c == 92 { if esc_done == 0 { result = result + bs + bs; esc_done = 1 } }
        if c == 34 { if esc_done == 0 { result = result + bs + chr(34); esc_done = 1 } }
        if c == 0 { if esc_done == 0 { result = result + bs + "0"; esc_done = 1 } }
        if esc_done == 0 { result = result + chr(c) }
        i = i + 1
    }
    return result
}

fn gen_block(nd) {
    let stmts = nd[1]
    let i = 0
    while i < len(stmts) {
        let s = stmts[i]
        gen_stmt(s)
        if ast_tag(s) == AST_RETURN_STMT {
            return 0
        }
        if ast_tag(s) == AST_THROW {
            return 0
        }
        i = i + 1
    }
}

fn gen_tco_call(tc_args, tc_argc) {
    let ti = 0
    while ti < tc_argc {
        gen_expr(tc_args[ti])
        out("    push rax")
        ti = ti + 1
    }
    ti = tc_argc - 1
    while ti >= 0 {
        out("    pop rax")
        let toff = (ti + 1) * 8
        out("    mov [rbp - " + int_to_str(toff) + "], rax")
        ti = ti - 1
    }
    out("    jmp " + cg_tco_label)
}

fn gen_defers() {
    let di = cg_defer_count - 1
    while di >= 0 {
        gen_block(cg_defers[di])
        di = di - 1
    }
}

fn gen_function(nd) {
    let name = nd[1]
    let params = nd[2]
    let body = nd[3]

    // R37A: every lambda fn (synthesized via `_lambda_N`) gets a synthetic
    // captures_list as its FIRST parameter. The caller passes captures_list
    // as rdi; the lambda body reads captures via captures_list[i][0]. The
    // synthetic param is named `__captures__` and stored at [rbp - 8].
    let is_lambda_fn = 0
    if starts_with(name, "_lambda_") == 1 {
        is_lambda_fn = 1
    }
    let effective_params = params
    if is_lambda_fn == 1 {
        effective_params = list_new()
        push(effective_params, "__captures__")
        let pcp = 0
        while pcp < len(params) {
            push(effective_params, params[pcp])
            pcp = pcp + 1
        }
    }

    let fn_caps = get_lambda_caps(name)
    if len(fn_caps) > 0 {
        cg_current_caps = fn_caps
        cg_current_cap_name = name
    } else {
        cg_current_caps = 0
        cg_current_cap_name = ""
    }

    cg_locals = list_new()
    cg_local_count = 0
    cg_params = effective_params
    cg_param_count = len(effective_params)
    cg_defers = list_new()
    cg_defer_count = 0
    cg_float_vars = list_new()
    cg_float_var_count = 0

    // R37A: load the boxed-locals set for THIS function so let-stmt /
    // ident / assign codegen knows to indirect through the box.
    cg_boxed_locals = cg_get_boxed_locals_for_fn(name)
    cg_boxed_locals_count = len(cg_boxed_locals)

    let pi = 0
    while pi < cg_param_count {
        push(cg_locals, effective_params[pi])
        cg_local_count = cg_local_count + 1
        pi = pi + 1
    }

    // R38A: float-typed param detection moved to cg_mark_float_params.
    // (Temporarily disabled while debugging a self-host crash; will
    // re-enable once the AST-shape probing is verified safe.)
    // cg_mark_float_params(nd, effective_params, is_lambda_fn)

    collect_locals(body)

    out("")
    let emit_name = name
    if cg_link_libc == 1 {
        if name == "main" {
            emit_name = "_user_main"
        }
    }
    out_globl(emit_name)
    cg_emit_loc(nd)
    out_label(emit_name)
    // DWARF .debug_info: emit a per-function start label that the
    // subprogram DIE's low_pc points to. (high_pc points to the end label
    // emitted after `ret`.) Only on Linux ELF; Mach-O/PE DWARF is deferred.
    let dbg_fn_idx = 0 - 1
    if cg_target == 0 {
        if cg_debug == 1 {
            dbg_fn_idx = cg_dbg_fn_seq
            cg_dbg_fn_seq = cg_dbg_fn_seq + 1
            out(".Lnova_fn_" + int_to_str(dbg_fn_idx) + "_start:")
        }
    }
    out("    push rbp")
    out("    mov rbp, rsp")
    let frame_size = cg_local_count * 8
    let frame_rem = frame_size % 16
    if frame_rem == 0 {
    } else {
        frame_size = frame_size + (16 - frame_rem)
    }
    if frame_size > 0 {
        out("    sub rsp, " + int_to_str(frame_size))
    }

    if cg_param_count > 0 { out("    mov [rbp - 8], rdi") }
    if cg_param_count > 1 { out("    mov [rbp - 16], rsi") }
    if cg_param_count > 2 { out("    mov [rbp - 24], rdx") }
    if cg_param_count > 3 { out("    mov [rbp - 32], rcx") }
    if cg_param_count > 4 { out("    mov [rbp - 40], r8") }
    if cg_param_count > 5 { out("    mov [rbp - 48], r9") }
    if cg_param_count > 6 {
        let sp_i = 6
        while sp_i < cg_param_count {
            let stk_off = (sp_i - 6) * 8 + 16
            let lcl_off = (sp_i + 1) * 8
            out("    mov rax, [rbp + " + int_to_str(stk_off) + "]")
            out("    mov [rbp - " + int_to_str(lcl_off) + "], rax")
            sp_i = sp_i + 1
        }
    }

    // R37A: for each PARAM that's also in the boxed-locals set, replace
    // its stack-slot value with a freshly-allocated 1-element box list
    // [param_value]. Subsequent reads/writes to the param name go through
    // the box (see is_boxed_local handling in gen_expr/gen_stmt). Note:
    // skip the synthetic `__captures__` param itself (it's already a list,
    // never boxed). We don't box the captures_list slot.
    if cg_boxed_locals_count > 0 {
        let bp_i = 0
        while bp_i < cg_param_count {
            let pname = effective_params[bp_i]
            let do_box = 0
            let bb = 0
            while bb < cg_boxed_locals_count {
                if cg_boxed_locals[bb] == pname { do_box = 1 }
                bb = bb + 1
            }
            if do_box == 1 {
                let p_off = (bp_i + 1) * 8
                out("    mov rax, [rbp - " + int_to_str(p_off) + "]")
                cg_emit_alloc_box()
                out("    mov [rbp - " + int_to_str(p_off) + "], rax")
            }
            bp_i = bp_i + 1
        }
    }

    let tco_lbl = new_label()
    cg_current_fn = name
    cg_tco_label = tco_lbl
    out_label(tco_lbl)

    gen_block(body)

    cg_current_fn = ""
    cg_tco_label = ""
    gen_defers()
    let stmts = body[1]
    let has_implicit = 0
    if len(stmts) > 0 {
        let last = stmts[len(stmts) - 1]
        let lt = ast_tag(last)
        if lt == AST_EXPR_STMT { has_implicit = 1 }
        if lt == AST_RETURN_STMT { has_implicit = 1 }
        if lt == AST_ASM { has_implicit = 1 }
    }
    if has_implicit == 0 {
        out("    xor eax, eax")
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // DWARF .debug_info: snapshot the function's locals + parameters now
    // that all stack assignments are finalized. cg_locals already contains
    // [params..., body_locals...] with offsets `(i+1)*8` from rbp. Capture
    // *names* + a parallel param-flag list; the DIE emitter walks these
    // later to lay out subprogram + variable DIEs.
    if dbg_fn_idx >= 0 {
        out(".Lnova_fn_" + int_to_str(dbg_fn_idx) + "_end:")
        let dbg_entry = list_new()
        push(dbg_entry, name)
        push(dbg_entry, ".Lnova_fn_" + int_to_str(dbg_fn_idx) + "_start")
        push(dbg_entry, ".Lnova_fn_" + int_to_str(dbg_fn_idx) + "_end")
        let dbg_line = 0
        let nd_len = len(nd)
        if nd_len > 2 {
            dbg_line = nd[nd_len - 1]
        }
        push(dbg_entry, dbg_line)
        // Snapshot locals list (names + offsets + is_param flag). We copy
        // the names defensively in case later codegen mutates cg_locals.
        let dbg_names = list_new()
        let dbg_offs = list_new()
        let dbg_isparam = list_new()
        let dli = 0
        while dli < cg_local_count {
            push(dbg_names, cg_locals[dli])
            push(dbg_offs, (dli + 1) * 8)
            let pflag = 0
            if dli < cg_param_count { pflag = 1 }
            push(dbg_isparam, pflag)
            dli = dli + 1
        }
        push(dbg_entry, dbg_names)
        push(dbg_entry, dbg_offs)
        push(dbg_entry, dbg_isparam)
        push(cg_dbg_fns, dbg_entry)
        cg_dbg_count = cg_dbg_count + 1
    }
}

// =====================================================================
// ARM64 (AArch64) backend - standalone AST-walking codegen
//
// Emits GNU-as / clang-MC compatible ARM64 assembly for Linux/Android.
// Stack-based evaluation: every expression leaves its result in x0.
// Function parameters x0-x7 are spilled to locals on entry (so local
// access is uniform). Locals live below x29 (the frame pointer).
//
// Calling convention (AAPCS64):
//   x0-x7  : integer args / return
//   x29    : frame pointer
//   x30    : link register
//   sp     : stack pointer (16-byte aligned at function boundaries)
//
// Syscalls (Linux/Android ARM64):
//   svc #0 with x8=syscall_num, args in x0-x5
//   write = 64, exit = 93
//
// NOTE: this path is intentionally INDEPENDENT of `lower_arm64.nova`
// (the IR-based la_* pass). That module is shipped as an importable
// package but is NOT in COMPILER_SRC, so calling la_init/la_out from
// here used to segfault on any input. The codegen below walks the AST
// directly and emits enough ARM64 assembly to build the mobile smoke
// programs (hello_arm64.nova) via:
//   clang -target aarch64-linux-android30 -c <output.s>
//
// Supported subset: fn declarations + return; let bindings (locals on
// stack via x29-offset); if/while; integer +/-/*/// and comparisons;
// function calls (AAPCS64 reg shuffle); println(string). Builtins
// list_new/push/len/read_file/write_file are stubbed to exit(1) with a
// printable error so the codegen never falls through to undefined
// behaviour; asm blocks are skipped.
// =====================================================================

let arm_locals = 0
let arm_local_count = 0
let arm_params = 0
let arm_param_count = 0
let arm_strings = 0
let arm_str_count = 0
let arm_label_count = 0
let arm_fns = 0
let arm_output = 0
let arm_break_label = ""
let arm_continue_label = ""
let arm_current_fn_name = ""

fn arm_out(s) {
    push(arm_output, s)
}

fn arm_label(name) {
    push(arm_output, name + ":")
}

fn arm_new_label() {
    arm_label_count = arm_label_count + 1
    return ".LA" + int_to_str(arm_label_count)
}

fn arm_add_string(s) {
    let i = 0
    while i < arm_str_count {
        if arm_strings[i] == s { return i }
        i = i + 1
    }
    let idx = arm_str_count
    push(arm_strings, s)
    arm_str_count = arm_str_count + 1
    return idx
}

fn arm_has_local(name) {
    let i = 0
    while i < arm_local_count {
        if arm_locals[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

fn arm_local_off(name) {
    let i = 0
    while i < arm_local_count {
        if arm_locals[i] == name {
            return (i + 1) * 8
        }
        i = i + 1
    }
    push(arm_locals, name)
    arm_local_count = arm_local_count + 1
    return arm_local_count * 8
}

fn arm_current_fn() { return arm_current_fn_name }

// Collect names introduced by `let` inside an arbitrary AST subtree so
// the function prologue can reserve a fixed-size stack frame.
fn arm_collect_locals(nd) {
    if nd == 0 { return 0 }
    let t = ast_tag(nd)
    if t == AST_LET_STMT {
        let nm = nd[1]
        if arm_has_local(nm) == 0 {
            push(arm_locals, nm)
            arm_local_count = arm_local_count + 1
        }
        arm_collect_locals(nd[2])
        return 0
    }
    if t == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            arm_collect_locals(stmts[i])
            i = i + 1
        }
        return 0
    }
    if t == AST_IF_STMT {
        arm_collect_locals(nd[1])
        arm_collect_locals(nd[2])
        arm_collect_locals(nd[3])
        return 0
    }
    if t == AST_WHILE_STMT {
        arm_collect_locals(nd[1])
        arm_collect_locals(nd[2])
        return 0
    }
    if t == AST_MATCH_STMT {
        // Walk the discriminant and each arm body so let-bindings inside
        // match arms (including match-as-expression) get a stack slot in
        // the enclosing function frame. Without this, AArch64 codegen
        // emits offsets that fall outside `sub sp, sp, #N`.
        arm_collect_locals(nd[1])
        let arms = nd[2]
        let ai = 0
        while ai < len(arms) {
            let arm = arms[ai]
            arm_collect_locals(arm[2])
            ai = ai + 1
        }
        return 0
    }
    if t == AST_TRY_CATCH {
        arm_collect_locals(nd[1])
        arm_collect_locals(nd[2])
        return 0
    }
    if t == AST_DO_WHILE {
        arm_collect_locals(nd[1])
        arm_collect_locals(nd[2])
        return 0
    }
    if t == AST_RETURN_STMT { arm_collect_locals(nd[1]); return 0 }
    if t == AST_EXPR_STMT { arm_collect_locals(nd[1]); return 0 }
    if t == AST_ASSIGN_STMT { arm_collect_locals(nd[2]); return 0 }
    if t == AST_BIN_OP { arm_collect_locals(nd[2]); arm_collect_locals(nd[3]); return 0 }
    if t == AST_UNARY_OP { arm_collect_locals(nd[2]); return 0 }
    if t == AST_AND_EXPR { arm_collect_locals(nd[1]); arm_collect_locals(nd[2]); return 0 }
    if t == AST_OR_EXPR { arm_collect_locals(nd[1]); arm_collect_locals(nd[2]); return 0 }
    if t == AST_CALL {
        let args = nd[2]
        let i = 0
        while i < len(args) {
            arm_collect_locals(args[i])
            i = i + 1
        }
        return 0
    }
    if t == AST_TRY_PROPAGATE { arm_collect_locals(nd[1]); return 0 }
    return 0
}

// Materialise a 64-bit signed integer into the given xN register, using
// the AArch64 movz/movk sequence (movn for negatives).
fn arm_emit_load_imm(reg, val) {
    if val == 0 {
        arm_out("    mov " + reg + ", #0")
        return 0
    }
    if val > 0 {
        if val < 65536 {
            arm_out("    mov " + reg + ", #" + int_to_str(val))
            return 0
        }
        arm_out("    movz " + reg + ", #" + int_to_str(val % 65536))
        let shift = val / 65536
        if shift > 0 {
            arm_out("    movk " + reg + ", #" + int_to_str(shift % 65536) + ", lsl #16")
            shift = shift / 65536
            if shift > 0 {
                arm_out("    movk " + reg + ", #" + int_to_str(shift % 65536) + ", lsl #32")
                shift = shift / 65536
                if shift > 0 {
                    arm_out("    movk " + reg + ", #" + int_to_str(shift % 65536) + ", lsl #48")
                }
            }
        }
        return 0
    }
    // Negative: encode as ~(-val-1) bits using movn / movk sequence.
    let inv = 0 - val - 1
    arm_out("    movn " + reg + ", #" + int_to_str(inv % 65536))
    let upper = inv / 65536
    if upper > 0 {
        arm_out("    movk " + reg + ", #" + int_to_str(upper % 65536) + ", lsl #16")
    }
    return 0
}

fn arm_push_x0() {
    arm_out("    str x0, [sp, #-16]!")
}

fn arm_pop_to(reg) {
    arm_out("    ldr " + reg + ", [sp], #16")
}

fn arm_gen_call(nd) {
    let callee = nd[1]
    let args = nd[2]
    let name = ""
    if ast_tag(callee) == AST_IDENT { name = callee[1] }

    if name == "println" {
        if len(args) >= 1 {
            arm_gen_expr(args[0])
        } else {
            arm_out("    mov x0, #0")
        }
        arm_out("    bl _nova_arm_println")
        return 0
    }
    if name == "print" {
        if len(args) >= 1 {
            arm_gen_expr(args[0])
        } else {
            arm_out("    mov x0, #0")
        }
        arm_out("    bl _nova_arm_print")
        return 0
    }
    if name == "exit" {
        if len(args) >= 1 { arm_gen_expr(args[0]) } else { arm_out("    mov x0, #0") }
        arm_out("    mov x8, #93")
        arm_out("    svc #0")
        return 0
    }
    if name == "list_new" {
        arm_out("    bl _nova_arm_stub_list_new")
        return 0
    }
    if name == "push" {
        arm_out("    bl _nova_arm_stub_push")
        return 0
    }
    if name == "len" {
        arm_out("    bl _nova_arm_stub_len")
        return 0
    }
    if name == "read_file" {
        arm_out("    bl _nova_arm_stub_read_file")
        return 0
    }
    if name == "write_file" {
        arm_out("    bl _nova_arm_stub_write_file")
        return 0
    }
    if name == "secure_random" {
        // secure_random(buf, n) -> bytes_written, or -1 on error.
        // ARM64 Linux: getrandom syscall #278; flags=0 in x2.
        let argc_sr = len(args)
        if argc_sr >= 2 {
            arm_gen_expr(args[0])
            arm_push_x0()
            arm_gen_expr(args[1])
            arm_out("    mov x1, x0")
            arm_pop_to("x0")
        } else {
            arm_out("    mov x0, #0")
            arm_out("    mov x1, #0")
        }
        arm_out("    mov x2, #0")              // flags
        arm_out("    mov x8, #278")            // SYS_getrandom on ARM64 Linux
        arm_out("    svc #0")
        return 0
    }
    // R8A: wasi_* low-level builtins. On ARM64 Linux we stub these to
    // -1 / empty-list -- the primary contract is the WASM target, and
    // ARM64 has its own native POSIX (read/write/etc.) once needed.
    if name == "wasi_open" {
        arm_out("    mov x0, #-1")
        return 0
    }
    if name == "wasi_read" {
        arm_out("    mov x0, #-1")
        return 0
    }
    if name == "wasi_write" {
        arm_out("    mov x0, #-1")
        return 0
    }
    if name == "wasi_close" {
        arm_out("    mov x0, #-1")
        return 0
    }
    if name == "wasi_seek" {
        arm_out("    mov x0, #-1")
        return 0
    }
    if name == "wasi_filestat" {
        arm_out("    mov x0, #0")
        return 0
    }
    if name == "wasi_args_get" {
        arm_out("    bl _nova_arm_stub_list_new")
        return 0
    }
    if name == "wasi_environ_get" {
        arm_out("    bl _nova_arm_stub_list_new")
        return 0
    }
    // R28C: UDP syscalls for NAT hole-punching on ARM64 Linux.
    //   sys_socket_udp   -> syscall 198 (socket)
    //   sys_sendto       -> syscall 206
    //   sys_recvfrom     -> syscall 207
    //   sys_setsockopt_* -> syscall 208
    // ARM64 calling convention: x0..x7 args, syscall number in x8, svc.
    if name == "sys_socket_udp" {
        // socket(AF_INET=2, SOCK_DGRAM=2, 0).
        arm_out("    mov x0, #2")
        arm_out("    mov x1, #2")
        arm_out("    mov x2, #0")
        arm_out("    mov x8, #198")
        arm_out("    svc #0")
        return 0
    }
    if name == "sys_sendto" {
        // sys_sendto(fd, buf, len, ip, port). Build sockaddr_in on stack.
        // We need 5 args; evaluate left-to-right and push, then materialise.
        let argc_st = len(args)
        let sti = 0
        while sti < argc_st {
            arm_gen_expr(args[sti])
            arm_push_x0()
            sti = sti + 1
        }
        // Pop into x4=port, x3=ip, x2=len, x1=buf, x0=fd (reverse order).
        sti = argc_st - 1
        while sti >= 0 {
            arm_pop_to("x" + int_to_str(sti))
            sti = sti - 1
        }
        // Reserve 16 bytes for sockaddr_in: family=2, port (htons), ip, zero.
        arm_out("    sub sp, sp, #32")
        arm_out("    mov w9, #2")
        arm_out("    strh w9, [sp, #0]")            // sin_family = AF_INET
        // htons(port): reverse low 16 bits.
        arm_out("    rev16 w9, w4")
        arm_out("    strh w9, [sp, #2]")
        arm_out("    str w3, [sp, #4]")             // sin_addr
        arm_out("    str xzr, [sp, #8]")            // sin_zero
        arm_out("    mov x3, #0")                    // flags = 0
        arm_out("    mov x4, sp")                    // &sockaddr_in
        arm_out("    mov x5, #16")                   // addrlen
        arm_out("    mov x8, #206")
        arm_out("    svc #0")
        arm_out("    add sp, sp, #32")
        return 0
    }
    if name == "sys_recvfrom" {
        // sys_recvfrom(fd, buf, max_len, timeout_ms).
        let argc_rf = len(args)
        let rfi = 0
        while rfi < argc_rf {
            arm_gen_expr(args[rfi])
            arm_push_x0()
            rfi = rfi + 1
        }
        rfi = argc_rf - 1
        while rfi >= 0 {
            arm_pop_to("x" + int_to_str(rfi))
            rfi = rfi - 1
        }
        // Reserve scratch: sockaddr_in (16) + addrlen (4 padded to 8) +
        // pollfd (8) + saved (fd, buf, len, list) = 64 bytes aligned.
        arm_out("    sub sp, sp, #80")
        // Save args
        arm_out("    str x0, [sp, #32]")             // fd
        arm_out("    str x1, [sp, #40]")             // buf
        arm_out("    str x2, [sp, #48]")             // len
        arm_out("    str x3, [sp, #56]")             // timeout_ms
        // pollfd at sp+16: { fd:i32, events:i16, revents:i16 }
        arm_out("    str w0, [sp, #16]")
        arm_out("    mov w9, #1")                    // POLLIN
        arm_out("    strh w9, [sp, #20]")
        arm_out("    strh wzr, [sp, #22]")
        // ppoll(&pollfd, 1, NULL_timespec_OR_use_poll, NULL_sigmask, 8)
        // Linux removed `poll` on arm64; use `ppoll` (syscall 73) with
        // a tiny timespec when timeout > 0, or NULL for no-wait.
        // For simplicity we synthesise a timespec from timeout_ms into
        // the second-to-last 16 bytes of the frame [sp + 64..80].
        arm_out("    mov x9, x3")                    // timeout_ms
        // tv_sec = timeout_ms / 1000; tv_nsec = (timeout_ms % 1000) * 1000000
        // 1000000 doesn't fit ARM64's mov-immediate window (16 bits),
        // so we synthesise it as 1000 * 1000.
        arm_out("    mov x10, #1000")
        arm_out("    udiv x11, x9, x10")
        arm_out("    msub x12, x11, x10, x9")
        arm_out("    mul x12, x12, x10")             // x12 *= 1000
        arm_out("    mul x12, x12, x10")             // x12 *= 1000 -> *1_000_000
        arm_out("    str x11, [sp, #64]")
        arm_out("    str x12, [sp, #72]")
        arm_out("    add x0, sp, #16")               // &pollfd
        arm_out("    mov x1, #1")                    // nfds
        arm_out("    add x2, sp, #64")               // &timespec
        arm_out("    mov x3, #0")                    // sigmask = NULL
        arm_out("    mov x4, #8")                    // sigsetsize
        arm_out("    mov x8, #73")                   // ppoll
        arm_out("    svc #0")
        arm_out("    cmp x0, #0")
        // bl _nova_list_new uses x30 (link); we re-use list pointer in x19.
        // Simpler: branch over success path to a fail tail that returns a [-1,0,0] list.
        let okl = arm_new_label()
        let endl = arm_new_label()
        arm_out("    b.le " + okl + "_fail")        // <=0 means timeout/error
        // Build sockaddr scratch at sp+0
        arm_out("    strh wzr, [sp, #0]")
        arm_out("    strh wzr, [sp, #2]")
        arm_out("    str wzr, [sp, #4]")
        arm_out("    str xzr, [sp, #8]")
        arm_out("    mov w9, #16")
        arm_out("    str w9, [sp, #24]")             // addrlen
        arm_out("    ldr x0, [sp, #32]")             // fd
        arm_out("    ldr x1, [sp, #40]")             // buf
        arm_out("    ldr x2, [sp, #48]")             // len
        arm_out("    mov x3, #0")                    // flags
        arm_out("    mov x4, sp")                    // &sockaddr
        arm_out("    add x5, sp, #24")               // &addrlen
        arm_out("    mov x8, #207")
        arm_out("    svc #0")
        arm_out("    cmp x0, #0")
        arm_out("    b.lt " + okl + "_fail")
        // Save bytes_read; allocate result list.
        arm_out("    mov x19, x0")                   // bytes_read (x19 callee-saved)
        arm_out("    bl _nova_arm_stub_list_new")
        arm_out("    mov x20, x0")                   // list
        arm_out("    mov x0, x20")
        arm_out("    mov x1, x19")
        arm_out("    bl _nova_arm_stub_push")
        arm_out("    mov x0, x20")
        arm_out("    ldr w1, [sp, #4]")              // ip (native order)
        arm_out("    bl _nova_arm_stub_push")
        arm_out("    mov x0, x20")
        arm_out("    ldrh w1, [sp, #2]")             // port (big-endian)
        arm_out("    rev16 w1, w1")                  // ntohs
        arm_out("    and x1, x1, #0xFFFF")
        arm_out("    bl _nova_arm_stub_push")
        arm_out("    mov x0, x20")
        arm_out("    b " + endl + "_done")
        arm_out(okl + "_fail:")
        arm_out("    bl _nova_arm_stub_list_new")
        arm_out("    mov x20, x0")
        arm_out("    mov x0, x20")
        arm_out("    mov x1, #-1")
        arm_out("    bl _nova_arm_stub_push")
        arm_out("    mov x0, x20")
        arm_out("    mov x1, #0")
        arm_out("    bl _nova_arm_stub_push")
        arm_out("    mov x0, x20")
        arm_out("    mov x1, #0")
        arm_out("    bl _nova_arm_stub_push")
        arm_out("    mov x0, x20")
        arm_out(endl + "_done:")
        arm_out("    add sp, sp, #80")
        return 0
    }
    if name == "sys_setsockopt_so_reuseaddr" {
        // sys_setsockopt_so_reuseaddr(fd) -> setsockopt(fd, SOL_SOCKET=1,
        //   SO_REUSEADDR=2, &one, 4).
        if len(args) >= 1 { arm_gen_expr(args[0]) } else { arm_out("    mov x0, #0") }
        arm_out("    sub sp, sp, #16")
        arm_out("    mov w9, #1")
        arm_out("    str w9, [sp, #0]")
        // x0=fd already.
        arm_out("    mov x1, #1")                    // SOL_SOCKET
        arm_out("    mov x2, #2")                    // SO_REUSEADDR
        arm_out("    mov x3, sp")                    // &optval
        arm_out("    mov x4, #4")                    // optlen
        arm_out("    mov x8, #208")
        arm_out("    svc #0")
        arm_out("    add sp, sp, #16")
        return 0
    }
    // R29A: sys_poll(fds, nfds, timeout_ms) on ARM64-Linux. The plain
    // `poll` syscall (kernel #168 elsewhere) was retired on aarch64 in
    // favor of `ppoll` (#73), which wants a {sec,nsec} timespec plus a
    // sigmask. We synthesize the timespec from timeout_ms on the stack
    // when timeout >= 0 and pass NULL when timeout < 0 (POSIX
    // "wait forever"). NULL sigmask matches the no-signal-mask semantics
    // of the plain poll on other targets.
    //
    // 1000000 doesn't fit ARM64's 16-bit mov-immediate window, so we
    // synthesise tv_nsec as `(timeout_ms % 1000) * 1000 * 1000`.
    if name == "sys_poll" {
        let argc_pl = len(args)
        let pli = 0
        while pli < argc_pl {
            arm_gen_expr(args[pli])
            arm_push_x0()
            pli = pli + 1
        }
        pli = argc_pl - 1
        while pli >= 0 {
            arm_pop_to("x" + int_to_str(pli))
            pli = pli - 1
        }
        // x0=&fds, x1=nfds, x2=timeout_ms.
        // Reserve 16 bytes for a timespec at sp+0.
        arm_out("    sub sp, sp, #16")
        let neg = arm_new_label()
        let after = arm_new_label()
        // If timeout_ms < 0, branch to the NULL-timespec path.
        arm_out("    cmp x2, #0")
        arm_out("    b.lt " + neg)
        // tv_sec = timeout_ms / 1000, tv_nsec = (timeout_ms % 1000) * 1_000_000.
        arm_out("    mov x9, #1000")
        arm_out("    udiv x10, x2, x9")
        arm_out("    msub x11, x10, x9, x2")
        arm_out("    mul x11, x11, x9")             // x11 *= 1000
        arm_out("    mul x11, x11, x9")             // x11 *= 1000 -> *1_000_000
        arm_out("    str x10, [sp, #0]")            // tv_sec
        arm_out("    str x11, [sp, #8]")            // tv_nsec
        arm_out("    mov x2, sp")                    // &timespec
        arm_out("    b " + after)
        arm_out(neg + ":")
        arm_out("    mov x2, #0")                    // NULL == wait forever
        arm_out(after + ":")
        arm_out("    mov x3, #0")                    // sigmask = NULL
        arm_out("    mov x4, #8")                    // sigsetsize
        arm_out("    mov x8, #73")                   // ppoll
        arm_out("    svc #0")
        arm_out("    add sp, sp, #16")
        return 0
    }
    // R31A: sys_fcntl_setfl_nonblock(fd) -> 0 | -1 on ARM64-Linux.
    // fcntl is syscall 25 on aarch64. x0=fd, x1=F_SETFL=4,
    // x2=O_NONBLOCK=2048, x8=25, svc #0.
    if name == "sys_fcntl_setfl_nonblock" {
        if len(args) >= 1 { arm_gen_expr(args[0]) } else { arm_out("    mov x0, #0") }
        arm_out("    mov x1, #4")                    // F_SETFL
        arm_out("    mov x2, #2048")                 // O_NONBLOCK
        arm_out("    mov x8, #25")                   // fcntl
        arm_out("    svc #0")
        return 0
    }
    // R31A: sys_getsockopt_so_error(fd) -> int on ARM64-Linux.
    // getsockopt is syscall 209 on aarch64. Reads SO_ERROR into the
    // 4-byte slot at [sp,#0]; we return the slot's value (the saved
    // connect errno) on success and -1 on syscall failure. Linux args:
    // x0=fd, x1=SOL_SOCKET=1, x2=SO_ERROR=4, x3=&val, x4=&vlen with
    // *vlen=4 on entry.
    if name == "sys_getsockopt_so_error" {
        if len(args) >= 1 { arm_gen_expr(args[0]) } else { arm_out("    mov x0, #0") }
        arm_out("    sub sp, sp, #16")
        arm_out("    str wzr, [sp, #0]")             // val out = 0
        arm_out("    mov w9, #4")
        arm_out("    str w9, [sp, #8]")              // vlen = 4
        arm_out("    mov x1, #1")                    // SOL_SOCKET
        arm_out("    mov x2, #4")                    // SO_ERROR
        arm_out("    mov x3, sp")                    // &val
        arm_out("    add x4, sp, #8")                // &vlen
        arm_out("    mov x8, #209")                  // getsockopt
        arm_out("    svc #0")
        let okg = arm_new_label()
        let endg = arm_new_label()
        arm_out("    cmp x0, #0")
        arm_out("    b.ge " + okg)
        arm_out("    mov x0, #-1")
        arm_out("    b " + endg)
        arm_out(okg + ":")
        arm_out("    ldrsw x0, [sp, #0]")            // sign-extended SO_ERROR
        arm_out(endg + ":")
        arm_out("    add sp, sp, #16")
        return 0
    }
    // R11D SIMD intrinsics on ARM64 NEON. The NEON quad-word width is
    // 128 bits == 4x i32, so an 8-lane op is exactly 2 NEON ops.
    // Helpers `_nova_arm_simd_*` emitted in arm_emit_runtime().
    if name == "simd_add_i32x8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            arm_gen_expr(args[s_i])
            arm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            arm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        arm_out("    bl _nova_arm_simd_add_i32x8")
        return 0
    }
    if name == "simd_sub_i32x8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            arm_gen_expr(args[s_i])
            arm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            arm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        arm_out("    bl _nova_arm_simd_sub_i32x8")
        return 0
    }
    if name == "simd_load_i32x8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            arm_gen_expr(args[s_i])
            arm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            arm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        arm_out("    bl _nova_arm_simd_load_i32x8")
        return 0
    }
    if name == "simd_store_i32x8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            arm_gen_expr(args[s_i])
            arm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            arm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        arm_out("    bl _nova_arm_simd_store_i32x8")
        return 0
    }
    if name == "simd_sum_abs_diff" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            arm_gen_expr(args[s_i])
            arm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            arm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        arm_out("    bl _nova_arm_simd_sum_abs_diff")
        return 0
    }
    // R14B: byte-level SAD via NEON `uabd v0.16b, v1.16b, v2.16b` +
    // `uaddlv h0, v0.16b`. 16-byte vector iter (vs the x86 32-byte
    // AVX2 iter); the helper handles tails scalar.
    if name == "simd_sad_u8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            arm_gen_expr(args[s_i])
            arm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            arm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        arm_out("    bl _nova_arm_simd_sad_u8")
        return 0
    }
    // R18A: byte-level multiply-accumulate primitives on ARM64 NEON.
    // Lowering uses `ldr d0,[x3],#8` (load 8 bytes), `ushll v0.8h,
    // v0.8b,#0` / `sshll v0.8h, v0.8b, #0` (widen u8/i8 to i16x8),
    // then `smlal v_acc.4s, v0.4h, v1.4h` etc. (signed multiply-
    // accumulate long: i16x4 * i16x4 -> i32x4 sums accumulated).
    if name == "simd_mul_acc_byte_signed_byte" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            arm_gen_expr(args[s_i])
            arm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            arm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        arm_out("    bl _nova_arm_simd_mul_acc_byte_signed_byte")
        return 0
    }
    if name == "simd_mul_acc_signed_signed_byte" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            arm_gen_expr(args[s_i])
            arm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            arm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        arm_out("    bl _nova_arm_simd_mul_acc_signed_signed_byte")
        return 0
    }

    // Generic user-function call.
    let argc = len(args)
    if argc > 8 {
        arm_out("    // ERROR: arm64 codegen supports at most 8 args")
        argc = 8
    }
    let i = 0
    while i < argc {
        arm_gen_expr(args[i])
        arm_push_x0()
        i = i + 1
    }
    i = argc - 1
    while i >= 0 {
        arm_pop_to("x" + int_to_str(i))
        i = i - 1
    }
    arm_out("    bl " + name)
    return 0
}

fn arm_gen_expr(nd) {
    let t = ast_tag(nd)
    if t == AST_INT_LIT {
        arm_emit_load_imm("x0", nd[1])
        return 0
    }
    if t == AST_BOOL_LIT {
        if nd[1] == 1 {
            arm_out("    mov x0, #1")
        } else {
            arm_out("    mov x0, #0")
        }
        return 0
    }
    if t == AST_NONE_LIT {
        arm_out("    mov x0, #0")
        return 0
    }
    if t == AST_STR_LIT {
        let idx = arm_add_string(nd[1])
        arm_out("    adrp x0, _str_" + int_to_str(idx))
        arm_out("    add x0, x0, :lo12:_str_" + int_to_str(idx))
        return 0
    }
    if t == AST_IDENT {
        let nm = nd[1]
        if arm_has_local(nm) == 1 {
            let off = arm_local_off(nm)
            arm_out("    ldr x0, [x29, #-" + int_to_str(off) + "]")
            return 0
        }
        // Treat unknown ident as a function address.
        arm_out("    adrp x0, " + nm)
        arm_out("    add x0, x0, :lo12:" + nm)
        return 0
    }
    if t == AST_BIN_OP {
        let op = nd[1]
        arm_gen_expr(nd[2])
        arm_push_x0()
        arm_gen_expr(nd[3])
        arm_out("    mov x1, x0")
        arm_pop_to("x0")
        if op == "+" { arm_out("    add x0, x0, x1"); return 0 }
        if op == "-" { arm_out("    sub x0, x0, x1"); return 0 }
        if op == "*" { arm_out("    mul x0, x0, x1"); return 0 }
        if op == "/" { arm_out("    sdiv x0, x0, x1"); return 0 }
        if op == "%" {
            arm_out("    sdiv x2, x0, x1")
            arm_out("    msub x0, x2, x1, x0")
            return 0
        }
        if op == "==" { arm_out("    cmp x0, x1"); arm_out("    cset x0, eq"); return 0 }
        if op == "!=" { arm_out("    cmp x0, x1"); arm_out("    cset x0, ne"); return 0 }
        if op == "<" { arm_out("    cmp x0, x1"); arm_out("    cset x0, lt"); return 0 }
        if op == ">" { arm_out("    cmp x0, x1"); arm_out("    cset x0, gt"); return 0 }
        if op == "<=" { arm_out("    cmp x0, x1"); arm_out("    cset x0, le"); return 0 }
        if op == ">=" { arm_out("    cmp x0, x1"); arm_out("    cset x0, ge"); return 0 }
        arm_out("    // unsupported arm64 binop: " + op)
        return 0
    }
    if t == AST_UNARY_OP {
        let op = nd[1]
        arm_gen_expr(nd[2])
        if op == "-" { arm_out("    neg x0, x0"); return 0 }
        if op == "!" { arm_out("    cmp x0, #0"); arm_out("    cset x0, eq"); return 0 }
        arm_out("    // unsupported arm64 unary: " + op)
        return 0
    }
    if t == AST_AND_EXPR {
        let end = arm_new_label()
        arm_gen_expr(nd[1])
        arm_out("    cbz x0, " + end)
        arm_gen_expr(nd[2])
        arm_label(end)
        return 0
    }
    if t == AST_OR_EXPR {
        let end = arm_new_label()
        arm_gen_expr(nd[1])
        arm_out("    cbnz x0, " + end)
        arm_gen_expr(nd[2])
        arm_label(end)
        return 0
    }
    if t == AST_CALL {
        arm_gen_call(nd)
        return 0
    }
    if t == AST_STRUCT_INIT {
        // R25A: brace-init `Foo { field: val, ... }`. ARM64 list-runtime
        // helpers are stubbed (see _nova_arm_stub_list_new) so we mirror
        // the positional struct ctor: evaluate each value in declaration
        // order for side effects, then return the stub list. Keeps the
        // cross-target build green; full struct value semantics on ARM64
        // native await a real list runtime.
        // R26A: optional spread base on nd[4] — when set, missing fields
        // are filled from `base.field`.
        let s_name_a = nd[1]
        let s_vals_a = nd[2]
        let s_names_a = nd[3]
        let s_base_a = 0
        if len(nd) > 4 { s_base_a = nd[4] }
        let ordered_a = cg_reorder_struct_init_b(s_name_a, s_names_a, s_vals_a, s_base_a)
        let ai = 0
        while ai < len(ordered_a) {
            arm_gen_expr(ordered_a[ai])
            ai = ai + 1
        }
        arm_out("    bl _nova_arm_stub_list_new")
        return 0
    }
    // R20A: postfix `?` on ARM64 Linux. The arm runtime helpers for
    // list operations are still stubs (see _nova_arm_stub_list_new) so
    // sum-types don't fully execute here, but we emit a structurally-
    // valid sequence so the test_enum_cross_target.sh build succeeds.
    if t == AST_TRY_PROPAGATE {
        arm_gen_expr(nd[1])
        // x0 holds the tagged tuple (or 0 if stub). Treat tag check as
        // a no-op on this target — the existing stubs already short-
        // circuit list ops, so we just pass the value through.
        arm_out("    // R20A: try-propagate (arm64 stub passes value through)")
        return 0
    }
    arm_out("    // unsupported arm64 expression tag " + int_to_str(t))
    arm_out("    mov x0, #0")
    return 0
}

fn arm_gen_stmt(nd) {
    let t = ast_tag(nd)
    if t == AST_LET_STMT {
        let nm = nd[1]
        let val = nd[2]
        arm_gen_expr(val)
        let off = arm_local_off(nm)
        arm_out("    str x0, [x29, #-" + int_to_str(off) + "]")
        return 0
    }
    if t == AST_ASSIGN_STMT {
        let nm = nd[1]
        arm_gen_expr(nd[2])
        let off = arm_local_off(nm)
        arm_out("    str x0, [x29, #-" + int_to_str(off) + "]")
        return 0
    }
    if t == AST_EXPR_STMT {
        arm_gen_expr(nd[1])
        return 0
    }
    if t == AST_RETURN_STMT {
        let val = nd[1]
        if val == 0 {
            arm_out("    mov x0, #0")
        } else {
            arm_gen_expr(val)
        }
        arm_out("    b _arm_fn_epilogue_" + arm_current_fn())
        return 0
    }
    if t == AST_IF_STMT {
        let cond = nd[1]
        let then_b = nd[2]
        let else_b = nd[3]
        let else_lbl = arm_new_label()
        let end_lbl = arm_new_label()
        arm_gen_expr(cond)
        arm_out("    cbz x0, " + else_lbl)
        arm_gen_stmt(then_b)
        arm_out("    b " + end_lbl)
        arm_label(else_lbl)
        if else_b != 0 {
            arm_gen_stmt(else_b)
        }
        arm_label(end_lbl)
        return 0
    }
    if t == AST_WHILE_STMT {
        let head_lbl = arm_new_label()
        let end_lbl = arm_new_label()
        let saved_break = arm_break_label
        let saved_cont = arm_continue_label
        arm_break_label = end_lbl
        arm_continue_label = head_lbl
        arm_label(head_lbl)
        arm_gen_expr(nd[1])
        arm_out("    cbz x0, " + end_lbl)
        arm_gen_stmt(nd[2])
        arm_out("    b " + head_lbl)
        arm_label(end_lbl)
        arm_break_label = saved_break
        arm_continue_label = saved_cont
        return 0
    }
    if t == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            arm_gen_stmt(stmts[i])
            i = i + 1
        }
        return 0
    }
    if t == AST_BREAK_STMT {
        if len(arm_break_label) > 0 {
            arm_out("    b " + arm_break_label)
        }
        return 0
    }
    if t == AST_CONTINUE_STMT {
        if len(arm_continue_label) > 0 {
            arm_out("    b " + arm_continue_label)
        }
        return 0
    }
    arm_out("    // unsupported arm64 stmt tag " + int_to_str(t))
    return 0
}

fn arm_gen_function(nd) {
    let name = nd[1]
    let params = nd[2]
    let body = nd[3]

    arm_locals = list_new()
    arm_local_count = 0
    arm_params = params
    arm_param_count = len(params)
    arm_current_fn_name = name

    let pi = 0
    while pi < arm_param_count {
        push(arm_locals, params[pi])
        arm_local_count = arm_local_count + 1
        pi = pi + 1
    }
    arm_collect_locals(body)

    let frame_bytes = arm_local_count * 8
    let rem = frame_bytes % 16
    if rem > 0 { frame_bytes = frame_bytes + (16 - rem) }
    if frame_bytes < 16 { frame_bytes = 16 }

    arm_out("")
    arm_out(".globl " + name)
    arm_out(".p2align 2")
    arm_label(name)
    arm_out("    stp x29, x30, [sp, #-16]!")
    arm_out("    mov x29, sp")
    arm_out("    sub sp, sp, #" + int_to_str(frame_bytes))

    let ai = 0
    while ai < arm_param_count {
        if ai < 8 {
            let off = (ai + 1) * 8
            arm_out("    str x" + int_to_str(ai) + ", [x29, #-" + int_to_str(off) + "]")
        }
        ai = ai + 1
    }

    arm_gen_stmt(body)

    arm_out("    mov x0, #0")
    arm_label("_arm_fn_epilogue_" + name)
    arm_out("    add sp, sp, #" + int_to_str(frame_bytes))
    arm_out("    ldp x29, x30, [sp], #16")
    arm_out("    ret")
}

fn arm_emit_stub(label, msg) {
    let idx = arm_add_string(msg)
    arm_out("")
    arm_out(".p2align 2")
    arm_label(label)
    arm_out("    adrp x0, _str_" + int_to_str(idx))
    arm_out("    add x0, x0, :lo12:_str_" + int_to_str(idx))
    arm_out("    bl _nova_arm_println")
    arm_out("    mov x0, #1")
    arm_out("    mov x8, #93")
    arm_out("    svc #0")
}

// Tiny ARM64 runtime: just enough to make println(string) work and to
// give a clear error when an unsupported builtin (list_new, etc.) is
// invoked. All routines preserve the AAPCS64 frame discipline.
fn arm_emit_runtime() {
    // ---- _nova_arm_strlen: count bytes of NUL-terminated string in x0 ----
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_strlen")
    arm_out("    mov x1, x0")
    arm_out("    mov x2, #0")
    arm_label(".Larm_strlen_loop")
    arm_out("    ldrb w3, [x1, x2]")
    arm_out("    cbz w3, .Larm_strlen_done")
    arm_out("    add x2, x2, #1")
    arm_out("    b .Larm_strlen_loop")
    arm_label(".Larm_strlen_done")
    arm_out("    mov x0, x2")
    arm_out("    ret")

    // ---- _nova_arm_print: write(1, x0=ptr, strlen(x0)) ----
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_print")
    arm_out("    stp x29, x30, [sp, #-16]!")
    arm_out("    mov x29, sp")
    arm_out("    mov x19, x0")
    arm_out("    str x19, [sp, #-16]!")
    arm_out("    bl _nova_arm_strlen")
    arm_out("    mov x2, x0")
    arm_out("    ldr x19, [sp], #16")
    arm_out("    mov x1, x19")
    arm_out("    mov x0, #1")
    arm_out("    mov x8, #64")
    arm_out("    svc #0")
    arm_out("    ldp x29, x30, [sp], #16")
    arm_out("    ret")

    // ---- _nova_arm_println: print + newline ----
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_println")
    arm_out("    stp x29, x30, [sp, #-16]!")
    arm_out("    mov x29, sp")
    arm_out("    bl _nova_arm_print")
    arm_out("    sub sp, sp, #16")
    arm_out("    mov w0, #10")
    arm_out("    strb w0, [sp]")
    arm_out("    mov x0, #1")
    arm_out("    mov x1, sp")
    arm_out("    mov x2, #1")
    arm_out("    mov x8, #64")
    arm_out("    svc #0")
    arm_out("    add sp, sp, #16")
    arm_out("    ldp x29, x30, [sp], #16")
    arm_out("    ret")

    arm_emit_stub("_nova_arm_stub_list_new", "ARM64: list_new not yet supported")
    arm_emit_stub("_nova_arm_stub_push", "ARM64: push not yet supported")
    arm_emit_stub("_nova_arm_stub_len", "ARM64: len not yet supported")
    arm_emit_stub("_nova_arm_stub_read_file", "ARM64: read_file not yet supported")
    arm_emit_stub("_nova_arm_stub_write_file", "ARM64: write_file not yet supported")

    // R11D NEON SIMD i32x8 intrinsics (ARM64 Linux).
    //
    // ABI mirror of the x86-64 helpers: x0=a_ptr, x1=b_ptr, x2=dst_ptr.
    // 8 lanes of int32 == 32 bytes, the NEON quad register width is 128
    // bits (4 lanes), so each builtin is two NEON ops.

    // ---- _nova_arm_simd_add_i32x8: dst = a + b ----
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_simd_add_i32x8")
    arm_out("    ldr q0, [x0]")
    arm_out("    ldr q1, [x1]")
    arm_out("    add v0.4s, v0.4s, v1.4s")
    arm_out("    str q0, [x2]")
    arm_out("    ldr q0, [x0, #16]")
    arm_out("    ldr q1, [x1, #16]")
    arm_out("    add v0.4s, v0.4s, v1.4s")
    arm_out("    str q0, [x2, #16]")
    arm_out("    mov x0, x2")
    arm_out("    ret")

    // ---- _nova_arm_simd_sub_i32x8: dst = a - b ----
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_simd_sub_i32x8")
    arm_out("    ldr q0, [x0]")
    arm_out("    ldr q1, [x1]")
    arm_out("    sub v0.4s, v0.4s, v1.4s")
    arm_out("    str q0, [x2]")
    arm_out("    ldr q0, [x0, #16]")
    arm_out("    ldr q1, [x1, #16]")
    arm_out("    sub v0.4s, v0.4s, v1.4s")
    arm_out("    str q0, [x2, #16]")
    arm_out("    mov x0, x2")
    arm_out("    ret")

    // ---- _nova_arm_simd_load_i32x8: dst = src (32-byte copy) ----
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_simd_load_i32x8")
    arm_out("    ldr q0, [x0]")
    arm_out("    ldr q1, [x0, #16]")
    arm_out("    str q0, [x1]")
    arm_out("    str q1, [x1, #16]")
    arm_out("    mov x0, x1")
    arm_out("    ret")

    // ---- _nova_arm_simd_store_i32x8: dst = src (arg-swap of load) ----
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_simd_store_i32x8")
    arm_out("    ldr q0, [x1]")
    arm_out("    ldr q1, [x1, #16]")
    arm_out("    str q0, [x0]")
    arm_out("    str q1, [x0, #16]")
    arm_out("    ret")

    // ---- _nova_arm_simd_sum_abs_diff: rax = sum(abs(a[i]-b[i]), i in [0,n)) ----
    // x0=a_ptr, x1=b_ptr, x2=n. 4 int32 lanes per loop iter; tail is scalar.
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_simd_sum_abs_diff")
    arm_out("    mov x3, x0")                  // a iter
    arm_out("    mov x4, x1")                  // b iter
    arm_out("    mov x5, x2")                  // remaining n
    arm_out("    movi v2.4s, #0")              // accumulator
    arm_out("    lsr x6, x5, #2")              // x6 = n / 4
    arm_out("    cbz x6, .arm_sad_tail")
    arm_label(".arm_sad_loop")
    arm_out("    ldr q0, [x3], #16")
    arm_out("    ldr q1, [x4], #16")
    arm_out("    sub v3.4s, v0.4s, v1.4s")
    arm_out("    abs v3.4s, v3.4s")
    arm_out("    add v2.4s, v2.4s, v3.4s")
    arm_out("    subs x6, x6, #1")
    arm_out("    b.ne .arm_sad_loop")
    arm_label(".arm_sad_tail")
    arm_out("    and x5, x5, #3")              // tail count = n & 3
    arm_out("    addv s2, v2.4s")              // horizontal add 4 i32 lanes
    arm_out("    fmov w0, s2")                 // scalar acc in w0
    arm_out("    sxtw x0, w0")
    arm_out("    cbz x5, .arm_sad_done")
    arm_label(".arm_sad_tail_loop")
    arm_out("    ldr w7, [x3], #4")
    arm_out("    ldr w8, [x4], #4")
    arm_out("    sub w7, w7, w8")
    arm_out("    cmp w7, #0")
    arm_out("    cneg w7, w7, lt")             // w7 = abs(w7)
    arm_out("    sxtw x7, w7")
    arm_out("    add x0, x0, x7")
    arm_out("    subs x5, x5, #1")
    arm_out("    b.ne .arm_sad_tail_loop")
    arm_label(".arm_sad_done")
    arm_out("    ret")

    // ---- _nova_arm_simd_sad_u8: x0 = sum(abs(a[i]-b[i]), i in [0,n_bytes)) ----
    // R14B byte-level SAD on raw u8 lanes. x0=a_ptr, x1=b_ptr, x2=n_bytes.
    // Vector loop: 16 bytes / iter via `uabd v3.16b, v0.16b, v1.16b`
    // (per-byte unsigned absolute diff) + `uaddlp v3.8h, v3.16b`
    // (sum adjacent byte pairs to halfwords) accumulated into a 4x i32
    // running sum. Tail (n_bytes % 16) is scalar.
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_simd_sad_u8")
    arm_out("    mov x3, x0")
    arm_out("    mov x4, x1")
    arm_out("    mov x5, x2")
    arm_out("    movi v2.4s, #0")
    arm_out("    lsr x6, x5, #4")
    arm_out("    cbz x6, .arm_sad8_tail")
    arm_label(".arm_sad8_loop")
    arm_out("    ldr q0, [x3], #16")
    arm_out("    ldr q1, [x4], #16")
    arm_out("    uabd v3.16b, v0.16b, v1.16b")
    arm_out("    uaddlp v3.8h, v3.16b")
    arm_out("    uaddlp v3.4s, v3.8h")
    arm_out("    add v2.4s, v2.4s, v3.4s")
    arm_out("    subs x6, x6, #1")
    arm_out("    b.ne .arm_sad8_loop")
    arm_label(".arm_sad8_tail")
    arm_out("    and x5, x5, #15")
    arm_out("    addv s2, v2.4s")
    arm_out("    fmov w0, s2")
    arm_out("    sxtw x0, w0")
    arm_out("    cbz x5, .arm_sad8_done")
    arm_label(".arm_sad8_tail_loop")
    arm_out("    ldrb w7, [x3], #1")
    arm_out("    ldrb w8, [x4], #1")
    arm_out("    sub w7, w7, w8")
    arm_out("    cmp w7, #0")
    arm_out("    cneg w7, w7, lt")
    arm_out("    sxtw x7, w7")
    arm_out("    add x0, x0, x7")
    arm_out("    subs x5, x5, #1")
    arm_out("    b.ne .arm_sad8_tail_loop")
    arm_label(".arm_sad8_done")
    arm_out("    ret")

    // ---- _nova_arm_simd_mul_acc_byte_signed_byte ----
    // R18A: byte-level mul-acc primitive. x0=a_u8_ptr, x1=b_i8_ptr,
    // x2=n_bytes -> x0=Sum a[i]*b[i] (i64 scalar).
    //
    // Vector loop: 8 bytes per iter. Load 8 u8 a-bytes via `ldr d0`,
    // widen to 8 u16 via `ushll v0.8h, v0.8b, #0`. Load 8 i8 b-bytes
    // via `ldr d1`, widen to 8 i16 via `sshll v1.8h, v1.8b, #0`.
    // Then `smull v3.4s, v0.4h, v1.4h` and `smull2 v4.4s, v0.8h,
    // v1.8h` produce 4 i32 lanes each from the low/high halves;
    // both accumulated into v2.4s. Tail (n % 8) is scalar.
    //
    // NB: the multiply is treated as signed by NEON (smull), but a
    // is zero-extended to a non-negative i16 first, so the product
    // correctly equals (u8)a * (i8)b.
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_simd_mul_acc_byte_signed_byte")
    arm_out("    mov x3, x0")                  // a iter
    arm_out("    mov x4, x1")                  // b iter
    arm_out("    mov x5, x2")                  // remaining n
    arm_out("    movi v2.4s, #0")              // accumulator (4 i32 lanes)
    arm_out("    lsr x6, x5, #3")              // x6 = n / 8
    arm_out("    cbz x6, .arm_mac_us_tail")
    arm_label(".arm_mac_us_loop")
    arm_out("    ldr d0, [x3], #8")             // 8 u8 a-bytes
    arm_out("    ldr d1, [x4], #8")             // 8 i8 b-bytes
    arm_out("    ushll v0.8h, v0.8b, #0")       // u8 -> u16 (8 lanes)
    arm_out("    sshll v1.8h, v1.8b, #0")       // i8 -> i16 (8 lanes)
    arm_out("    smull v3.4s, v0.4h, v1.4h")    // 4 i32 from low halves
    arm_out("    smull2 v4.4s, v0.8h, v1.8h")   // 4 i32 from high halves
    arm_out("    add v2.4s, v2.4s, v3.4s")
    arm_out("    add v2.4s, v2.4s, v4.4s")
    arm_out("    subs x6, x6, #1")
    arm_out("    b.ne .arm_mac_us_loop")
    arm_label(".arm_mac_us_tail")
    arm_out("    and x5, x5, #7")
    arm_out("    addv s2, v2.4s")              // horizontal sum 4 i32 lanes
    arm_out("    fmov w0, s2")
    arm_out("    sxtw x0, w0")
    arm_out("    cbz x5, .arm_mac_us_done")
    arm_label(".arm_mac_us_tail_loop")
    arm_out("    ldrb w7, [x3], #1")           // unsigned-byte load
    arm_out("    ldrsb w8, [x4], #1")          // signed-byte load
    arm_out("    mul w7, w7, w8")
    arm_out("    sxtw x7, w7")
    arm_out("    add x0, x0, x7")
    arm_out("    subs x5, x5, #1")
    arm_out("    b.ne .arm_mac_us_tail_loop")
    arm_label(".arm_mac_us_done")
    arm_out("    ret")

    // ---- _nova_arm_simd_mul_acc_signed_signed_byte ----
    // R18A: same as byte_signed_byte but BOTH operands are signed i8.
    // Used by all 5 LK accumulators (Sum Ix*Ix, Sum Iy*Iy, Sum Ix*Iy,
    // Sum Ix*It, Sum Iy*It) since Ix/Iy/It are signed gradients.
    //
    // The only difference vs the unsigned/signed variant is `sshll`
    // (sign-extend) instead of `ushll` (zero-extend) on the a-byte
    // widen, and `ldrsb` (signed-byte load) instead of `ldrb` in the
    // tail.
    arm_out("")
    arm_out(".p2align 2")
    arm_label("_nova_arm_simd_mul_acc_signed_signed_byte")
    arm_out("    mov x3, x0")
    arm_out("    mov x4, x1")
    arm_out("    mov x5, x2")
    arm_out("    movi v2.4s, #0")
    arm_out("    lsr x6, x5, #3")
    arm_out("    cbz x6, .arm_mac_ss_tail")
    arm_label(".arm_mac_ss_loop")
    arm_out("    ldr d0, [x3], #8")
    arm_out("    ldr d1, [x4], #8")
    arm_out("    sshll v0.8h, v0.8b, #0")       // i8 -> i16
    arm_out("    sshll v1.8h, v1.8b, #0")       // i8 -> i16
    arm_out("    smull v3.4s, v0.4h, v1.4h")
    arm_out("    smull2 v4.4s, v0.8h, v1.8h")
    arm_out("    add v2.4s, v2.4s, v3.4s")
    arm_out("    add v2.4s, v2.4s, v4.4s")
    arm_out("    subs x6, x6, #1")
    arm_out("    b.ne .arm_mac_ss_loop")
    arm_label(".arm_mac_ss_tail")
    arm_out("    and x5, x5, #7")
    arm_out("    addv s2, v2.4s")
    arm_out("    fmov w0, s2")
    arm_out("    sxtw x0, w0")
    arm_out("    cbz x5, .arm_mac_ss_done")
    arm_label(".arm_mac_ss_tail_loop")
    arm_out("    ldrsb w7, [x3], #1")
    arm_out("    ldrsb w8, [x4], #1")
    arm_out("    mul w7, w7, w8")
    arm_out("    sxtw x7, w7")
    arm_out("    add x0, x0, x7")
    arm_out("    subs x5, x5, #1")
    arm_out("    b.ne .arm_mac_ss_tail_loop")
    arm_label(".arm_mac_ss_done")
    arm_out("    ret")
}

fn arm64_gen_program(program) {
    arm_locals = list_new()
    arm_local_count = 0
    arm_params = list_new()
    arm_param_count = 0
    arm_strings = list_new()
    arm_str_count = 0
    arm_label_count = 0
    arm_fns = list_new()
    arm_output = list_new()
    arm_break_label = ""
    arm_continue_label = ""

    let decls = program[1]

    // R19B: collect enum / struct / global tables so the R17A enum
    // codegen helpers (`is_enum_name`, `enum_variant_index`, etc.) can
    // resolve declarations. The main x86-64 `gen_program` does this
    // inline; the ARM64 / winARM64 / WASM paths previously skipped it
    // because they didn't support sum-types.
    // R25A: also register struct decls so cg_reorder_struct_init can
    // find field-declaration order for AST_STRUCT_INIT codegen.
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_ENUM_DECL {
            let entry = list_new()
            push(entry, d[1])
            push(entry, d[2])
            push(cg_enums, entry)
            cg_enum_count = cg_enum_count + 1
        }
        if ast_tag(d) == AST_STRUCT_DECL {
            let s_entry = list_new()
            push(s_entry, d[1])
            push(s_entry, d[2])
            push(cg_structs, s_entry)
            cg_struct_count = cg_struct_count + 1
        }
        if ast_tag(d) == AST_LET_STMT {
            add_global(d[1])
        }
        // R32D: top-level AST_BLOCK from parse_let's struct / enum
        // destructure lowering also registers its inner-let names.
        if ast_tag(d) == AST_BLOCK {
            cg_collect_block_globals(d)
        }
        i = i + 1
    }

    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            push(arm_fns, d[1])
        }
        i = i + 1
    }

    arm_out(".text")

    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            arm_gen_function(d)
        }
        i = i + 1
    }

    // Emit `_start` for top-level statements.
    arm_locals = list_new()
    arm_local_count = 0
    arm_params = list_new()
    arm_param_count = 0
    arm_current_fn_name = "_start"

    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dt = ast_tag(d)
        let count_this = 1
        if dt == AST_FN_DECL { count_this = 0 }
        if dt == AST_STRUCT_DECL { count_this = 0 }
        if dt == AST_ENUM_DECL { count_this = 0 }
        if dt == AST_METHOD_DECL { count_this = 0 }
        if dt == AST_EXTERN_FN { count_this = 0 }
        if dt == AST_ASM { count_this = 0 }
        if count_this == 1 {
            arm_collect_locals(d)
        }
        i = i + 1
    }
    let start_frame = arm_local_count * 8
    let srem = start_frame % 16
    if srem > 0 { start_frame = start_frame + (16 - srem) }
    if start_frame < 16 { start_frame = 16 }

    arm_out("")
    arm_out(".globl _start")
    arm_label("_start")
    arm_out("    stp x29, x30, [sp, #-16]!")
    arm_out("    mov x29, sp")
    arm_out("    sub sp, sp, #" + int_to_str(start_frame))

    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dt = ast_tag(d)
        let skip = 0
        if dt == AST_FN_DECL { skip = 1 }
        if dt == AST_STRUCT_DECL { skip = 1 }
        if dt == AST_ENUM_DECL { skip = 1 }
        if dt == AST_METHOD_DECL { skip = 1 }
        if dt == AST_EXTERN_FN { skip = 1 }
        if dt == AST_ASM { skip = 1 }
        if skip == 0 {
            arm_gen_stmt(d)
        }
        i = i + 1
    }

    arm_out("    add sp, sp, #" + int_to_str(start_frame))
    arm_out("    ldp x29, x30, [sp], #16")
    arm_out("    mov x0, #0")
    arm_out("    mov x8, #93")
    arm_out("    svc #0")

    arm_emit_runtime()

    if arm_str_count > 0 {
        arm_out("")
        arm_out(".data")
        let si = 0
        while si < arm_str_count {
            arm_label("_str_" + int_to_str(si))
            arm_out("    .asciz " + DQ + escape_for_asm(arm_strings[si]) + DQ)
            si = si + 1
        }
    }

    return join(arm_output, chr(10))
}

// =====================================================================
// Windows ARM64 (PE32+ AArch64) backend - standalone AST-walking codegen
//
// Emits GNU-as / clang-MC compatible ARM64 assembly using PE/COFF section
// conventions and Win32 API calls (no syscalls — PE is API-only). The
// resulting .s assembles with `clang -target aarch64-windows-gnu -c` and
// links with `lld-link /machine:arm64` against ARM64 import libs that the
// Makefile fabricates from .def files via `llvm-dlltool -m arm64`.
//
// Calling convention (Windows AArch64, identical to AAPCS64 for our use):
//   x0-x7  : integer args / return
//   x8     : indirect result location (we don't use it)
//   x9-x15 : caller-saved temporaries
//   x18    : platform reserved (TEB on Windows) — must NOT be clobbered
//   x19-x28: callee-saved
//   x29    : frame pointer
//   x30    : link register
//   sp     : 16-byte aligned at call boundaries (Windows ABI enforces this)
//
// Imports: PE indirect-via-IAT. Each imported API has an `__imp_<name>`
// 64-bit pointer in the .idata IAT that the loader populates with the
// resolved address. To call an import we load that pointer into a temp
// register and BLR through it:
//   adrp x16, __imp_ExitProcess
//   ldr  x16, [x16, :lo12:__imp_ExitProcess]
//   blr  x16
//
// Imports used:
//   KERNEL32.DLL: GetStdHandle, WriteFile, ExitProcess
//   BCRYPT.DLL  : BCryptGenRandom
//
// Entry point: `mainCRTStartup` (matches lld-link's default entry for
// console subsystems when no CRT is present). The entry sets up a stack
// frame, runs top-level statements, then calls ExitProcess(0).
//
// Supported subset (intentionally the SAME surface as the Linux ARM64
// standalone path): fn declarations + return; let bindings; if/while;
// integer +/-/*/// and comparisons; function calls; println/print of a
// string; secure_random(buf, n) via BCryptGenRandom. Builtins outside
// this set are stubbed to a printable error + ExitProcess(1).
//
// This is a SEPARATE generator from the x86-64 Windows path (cg_target ==
// 3) because the latter is the full IR-based GAS pipeline; the ARM64
// path is the standalone AST-walking pipeline mirroring cg_target == 4
// (ARM64 Linux). Both ARM64 paths share the same instruction encoding
// helpers below.
// =====================================================================

let warm_locals = 0
let warm_local_count = 0
let warm_params = 0
let warm_param_count = 0
let warm_strings = 0
let warm_str_count = 0
let warm_label_count = 0
let warm_fns = 0
let warm_output = 0
let warm_break_label = ""
let warm_continue_label = ""
let warm_current_fn_name = ""

fn warm_out(s) {
    push(warm_output, s)
}

fn warm_label(name) {
    push(warm_output, name + ":")
}

fn warm_new_label() {
    warm_label_count = warm_label_count + 1
    return ".LW" + int_to_str(warm_label_count)
}

fn warm_add_string(s) {
    let i = 0
    while i < warm_str_count {
        if warm_strings[i] == s { return i }
        i = i + 1
    }
    let idx = warm_str_count
    push(warm_strings, s)
    warm_str_count = warm_str_count + 1
    return idx
}

fn warm_has_local(name) {
    let i = 0
    while i < warm_local_count {
        if warm_locals[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

fn warm_local_off(name) {
    let i = 0
    while i < warm_local_count {
        if warm_locals[i] == name {
            return (i + 1) * 8
        }
        i = i + 1
    }
    push(warm_locals, name)
    warm_local_count = warm_local_count + 1
    return warm_local_count * 8
}

fn warm_current_fn() { return warm_current_fn_name }

// Collect locals introduced by `let` inside an arbitrary AST subtree so
// the function prologue can reserve a fixed-size stack frame. Same shape
// as arm_collect_locals — the AST is target-independent.
fn warm_collect_locals(nd) {
    if nd == 0 { return 0 }
    let t = ast_tag(nd)
    if t == AST_LET_STMT {
        let nm = nd[1]
        if warm_has_local(nm) == 0 {
            push(warm_locals, nm)
            warm_local_count = warm_local_count + 1
        }
        warm_collect_locals(nd[2])
        return 0
    }
    if t == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            warm_collect_locals(stmts[i])
            i = i + 1
        }
        return 0
    }
    if t == AST_IF_STMT {
        warm_collect_locals(nd[1])
        warm_collect_locals(nd[2])
        warm_collect_locals(nd[3])
        return 0
    }
    if t == AST_WHILE_STMT {
        warm_collect_locals(nd[1])
        warm_collect_locals(nd[2])
        return 0
    }
    if t == AST_MATCH_STMT {
        // Same shape as arm_collect_locals — walk arms so let-bindings
        // inside match-as-expression arm bodies get reserved stack space.
        warm_collect_locals(nd[1])
        let arms = nd[2]
        let ai = 0
        while ai < len(arms) {
            let arm = arms[ai]
            warm_collect_locals(arm[2])
            ai = ai + 1
        }
        return 0
    }
    if t == AST_TRY_CATCH {
        warm_collect_locals(nd[1])
        warm_collect_locals(nd[2])
        return 0
    }
    if t == AST_DO_WHILE {
        warm_collect_locals(nd[1])
        warm_collect_locals(nd[2])
        return 0
    }
    if t == AST_RETURN_STMT { warm_collect_locals(nd[1]); return 0 }
    if t == AST_EXPR_STMT { warm_collect_locals(nd[1]); return 0 }
    if t == AST_ASSIGN_STMT { warm_collect_locals(nd[2]); return 0 }
    if t == AST_BIN_OP { warm_collect_locals(nd[2]); warm_collect_locals(nd[3]); return 0 }
    if t == AST_UNARY_OP { warm_collect_locals(nd[2]); return 0 }
    if t == AST_AND_EXPR { warm_collect_locals(nd[1]); warm_collect_locals(nd[2]); return 0 }
    if t == AST_OR_EXPR { warm_collect_locals(nd[1]); warm_collect_locals(nd[2]); return 0 }
    if t == AST_CALL {
        let args = nd[2]
        let i = 0
        while i < len(args) {
            warm_collect_locals(args[i])
            i = i + 1
        }
        return 0
    }
    if t == AST_TRY_PROPAGATE { warm_collect_locals(nd[1]); return 0 }
    return 0
}

// Materialise a 64-bit signed integer into the given xN register, using
// the AArch64 movz/movk sequence (movn for negatives). Identical to the
// Linux ARM64 path's arm_emit_load_imm — kept separate so the two output
// list pointers don't collide.
fn warm_emit_load_imm(reg, val) {
    if val == 0 {
        warm_out("    mov " + reg + ", #0")
        return 0
    }
    if val > 0 {
        if val < 65536 {
            warm_out("    mov " + reg + ", #" + int_to_str(val))
            return 0
        }
        warm_out("    movz " + reg + ", #" + int_to_str(val % 65536))
        let shift = val / 65536
        if shift > 0 {
            warm_out("    movk " + reg + ", #" + int_to_str(shift % 65536) + ", lsl #16")
            shift = shift / 65536
            if shift > 0 {
                warm_out("    movk " + reg + ", #" + int_to_str(shift % 65536) + ", lsl #32")
                shift = shift / 65536
                if shift > 0 {
                    warm_out("    movk " + reg + ", #" + int_to_str(shift % 65536) + ", lsl #48")
                }
            }
        }
        return 0
    }
    let inv = 0 - val - 1
    warm_out("    movn " + reg + ", #" + int_to_str(inv % 65536))
    let upper = inv / 65536
    if upper > 0 {
        warm_out("    movk " + reg + ", #" + int_to_str(upper % 65536) + ", lsl #16")
    }
    return 0
}

fn warm_push_x0() {
    warm_out("    str x0, [sp, #-16]!")
}

fn warm_pop_to(reg) {
    warm_out("    ldr " + reg + ", [sp], #16")
}

// Call a PE-imported function via the IAT. The Windows loader rewrites
// __imp_<name> at load time with the resolved API address; we just need
// to load that pointer and BLR through it. x16 is a safe scratch
// (caller-saved, not used as an arg).
fn warm_call_import(impname) {
    warm_out("    adrp x16, " + impname)
    warm_out("    ldr  x16, [x16, :lo12:" + impname + "]")
    warm_out("    blr  x16")
}

fn warm_gen_call(nd) {
    let callee = nd[1]
    let args = nd[2]
    let name = ""
    if ast_tag(callee) == AST_IDENT { name = callee[1] }

    if name == "println" {
        if len(args) >= 1 {
            warm_gen_expr(args[0])
        } else {
            warm_out("    mov x0, #0")
        }
        warm_out("    bl _nova_warm_println")
        return 0
    }
    if name == "print" {
        if len(args) >= 1 {
            warm_gen_expr(args[0])
        } else {
            warm_out("    mov x0, #0")
        }
        warm_out("    bl _nova_warm_print")
        return 0
    }
    if name == "exit" {
        if len(args) >= 1 { warm_gen_expr(args[0]) } else { warm_out("    mov x0, #0") }
        // ExitProcess(uExitCode) — x0 already holds the code, but Win32
        // wants a 32-bit UINT in w0. The truncation is implicit when
        // the import reads w0.
        warm_call_import("__imp_ExitProcess")
        return 0
    }
    if name == "secure_random" {
        // secure_random(buf, n) -> bytes_written, or -1 on error.
        // Windows: BCryptGenRandom(NULL, buf, n,
        //   BCRYPT_USE_SYSTEM_PREFERRED_RNG=2). Returns NTSTATUS; 0 == OK.
        let argc_sr = len(args)
        if argc_sr >= 2 {
            warm_gen_expr(args[0])
            warm_push_x0()
            warm_gen_expr(args[1])
            // Move n into x2 (cbBuffer), buf into x1 (pbBuffer).
            warm_out("    mov x2, x0")
            warm_pop_to("x1")
        } else {
            warm_out("    mov x1, #0")
            warm_out("    mov x2, #0")
        }
        warm_out("    mov x0, #0")              // hAlgorithm = NULL
        warm_out("    mov w3, #2")              // BCRYPT_USE_SYSTEM_PREFERRED_RNG
        // Save n_bytes so we can return it on success.
        warm_out("    str x2, [sp, #-16]!")
        warm_call_import("__imp_BCryptGenRandom")
        warm_out("    ldr x2, [sp], #16")        // restore n_bytes
        // NTSTATUS in w0; 0 == STATUS_SUCCESS.
        warm_out("    cmp w0, #0")
        let okl = warm_new_label()
        let endl = warm_new_label()
        warm_out("    b.eq " + okl)
        warm_emit_load_imm("x0", 0 - 1)         // failure: -1
        warm_out("    b " + endl)
        warm_label(okl)
        warm_out("    mov x0, x2")              // success: return n_bytes
        warm_label(endl)
        return 0
    }
    if name == "list_new" {
        warm_out("    bl _nova_warm_stub_list_new")
        return 0
    }
    if name == "push" {
        warm_out("    bl _nova_warm_stub_push")
        return 0
    }
    if name == "len" {
        warm_out("    bl _nova_warm_stub_len")
        return 0
    }
    if name == "read_file" {
        warm_out("    bl _nova_warm_stub_read_file")
        return 0
    }
    if name == "write_file" {
        warm_out("    bl _nova_warm_stub_write_file")
        return 0
    }
    // R8A: low-level WASI primitives -- stubbed on winARM64. Returns
    // -1 / empty list. The WASM target is the real surface.
    if name == "wasi_open" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    if name == "wasi_read" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    if name == "wasi_write" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    if name == "wasi_close" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    if name == "wasi_seek" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    if name == "wasi_filestat" {
        warm_out("    mov x0, #0")
        return 0
    }
    if name == "wasi_args_get" {
        warm_out("    bl _nova_warm_stub_list_new")
        return 0
    }
    if name == "wasi_environ_get" {
        warm_out("    bl _nova_warm_stub_list_new")
        return 0
    }
    // R28C: UDP syscalls. winARM64 stubs to -1 / [-1,0,0]. The full
    // Win32 ws2_32.dll wiring is x86-64 Windows territory; the winARM64
    // contract here is "links and returns sentinels" until a downstream
    // user actually needs UDP from a Windows ARM laptop.
    if name == "sys_socket_udp" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    if name == "sys_sendto" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    if name == "sys_recvfrom" {
        warm_out("    bl _nova_warm_stub_list_new")
        warm_out("    mov x19, x0")
        warm_out("    mov x0, x19")
        warm_emit_load_imm("x1", 0 - 1)
        warm_out("    bl _nova_warm_stub_push")
        warm_out("    mov x0, x19")
        warm_out("    mov x1, #0")
        warm_out("    bl _nova_warm_stub_push")
        warm_out("    mov x0, x19")
        warm_out("    mov x1, #0")
        warm_out("    bl _nova_warm_stub_push")
        warm_out("    mov x0, x19")
        return 0
    }
    if name == "sys_setsockopt_so_reuseaddr" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    // R29A: poll(2) — winARM64 stub returning -1. Real WSAPoll lowering
    // can land here in a follow-up; for now the contract matches the
    // rest of the socket family on this target.
    if name == "sys_poll" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    // R31A: non-blocking I/O knobs — winARM64 stubs returning -1, same
    // contract as the rest of the socket family on this target.
    if name == "sys_fcntl_setfl_nonblock" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    if name == "sys_getsockopt_so_error" {
        warm_emit_load_imm("x0", 0 - 1)
        return 0
    }
    // R11D SIMD intrinsics on ARM64 Windows (NEON). Helpers emitted in
    // warm_emit_runtime(); same NEON sequences as Linux ARM64 above.
    if name == "simd_add_i32x8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            warm_gen_expr(args[s_i])
            warm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            warm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        warm_out("    bl _nova_warm_simd_add_i32x8")
        return 0
    }
    if name == "simd_sub_i32x8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            warm_gen_expr(args[s_i])
            warm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            warm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        warm_out("    bl _nova_warm_simd_sub_i32x8")
        return 0
    }
    if name == "simd_load_i32x8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            warm_gen_expr(args[s_i])
            warm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            warm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        warm_out("    bl _nova_warm_simd_load_i32x8")
        return 0
    }
    if name == "simd_store_i32x8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            warm_gen_expr(args[s_i])
            warm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            warm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        warm_out("    bl _nova_warm_simd_store_i32x8")
        return 0
    }
    if name == "simd_sum_abs_diff" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            warm_gen_expr(args[s_i])
            warm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            warm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        warm_out("    bl _nova_warm_simd_sum_abs_diff")
        return 0
    }
    // R14B: byte-level SAD primitive on ARM64 Windows (NEON).
    if name == "simd_sad_u8" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            warm_gen_expr(args[s_i])
            warm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            warm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        warm_out("    bl _nova_warm_simd_sad_u8")
        return 0
    }
    // R18A: byte-level mul-acc primitives on ARM64 Windows (NEON).
    if name == "simd_mul_acc_byte_signed_byte" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            warm_gen_expr(args[s_i])
            warm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            warm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        warm_out("    bl _nova_warm_simd_mul_acc_byte_signed_byte")
        return 0
    }
    if name == "simd_mul_acc_signed_signed_byte" {
        let s_argc = len(args)
        let s_i = 0
        while s_i < s_argc {
            warm_gen_expr(args[s_i])
            warm_push_x0()
            s_i = s_i + 1
        }
        s_i = s_argc - 1
        while s_i >= 0 {
            warm_pop_to("x" + int_to_str(s_i))
            s_i = s_i - 1
        }
        warm_out("    bl _nova_warm_simd_mul_acc_signed_signed_byte")
        return 0
    }

    // Generic user-function call.
    let argc = len(args)
    if argc > 8 {
        warm_out("    // ERROR: winarm64 codegen supports at most 8 args")
        argc = 8
    }
    let i = 0
    while i < argc {
        warm_gen_expr(args[i])
        warm_push_x0()
        i = i + 1
    }
    i = argc - 1
    while i >= 0 {
        warm_pop_to("x" + int_to_str(i))
        i = i - 1
    }
    warm_out("    bl " + name)
    return 0
}

fn warm_gen_expr(nd) {
    let t = ast_tag(nd)
    if t == AST_INT_LIT {
        warm_emit_load_imm("x0", nd[1])
        return 0
    }
    if t == AST_BOOL_LIT {
        if nd[1] == 1 {
            warm_out("    mov x0, #1")
        } else {
            warm_out("    mov x0, #0")
        }
        return 0
    }
    if t == AST_NONE_LIT {
        warm_out("    mov x0, #0")
        return 0
    }
    if t == AST_STR_LIT {
        let idx = warm_add_string(nd[1])
        warm_out("    adrp x0, _wstr_" + int_to_str(idx))
        warm_out("    add x0, x0, :lo12:_wstr_" + int_to_str(idx))
        return 0
    }
    if t == AST_IDENT {
        let nm = nd[1]
        if warm_has_local(nm) == 1 {
            let off = warm_local_off(nm)
            warm_out("    ldr x0, [x29, #-" + int_to_str(off) + "]")
            return 0
        }
        warm_out("    adrp x0, " + nm)
        warm_out("    add x0, x0, :lo12:" + nm)
        return 0
    }
    if t == AST_BIN_OP {
        let op = nd[1]
        warm_gen_expr(nd[2])
        warm_push_x0()
        warm_gen_expr(nd[3])
        warm_out("    mov x1, x0")
        warm_pop_to("x0")
        if op == "+" { warm_out("    add x0, x0, x1"); return 0 }
        if op == "-" { warm_out("    sub x0, x0, x1"); return 0 }
        if op == "*" { warm_out("    mul x0, x0, x1"); return 0 }
        if op == "/" { warm_out("    sdiv x0, x0, x1"); return 0 }
        if op == "%" {
            warm_out("    sdiv x2, x0, x1")
            warm_out("    msub x0, x2, x1, x0")
            return 0
        }
        if op == "==" { warm_out("    cmp x0, x1"); warm_out("    cset x0, eq"); return 0 }
        if op == "!=" { warm_out("    cmp x0, x1"); warm_out("    cset x0, ne"); return 0 }
        if op == "<" { warm_out("    cmp x0, x1"); warm_out("    cset x0, lt"); return 0 }
        if op == ">" { warm_out("    cmp x0, x1"); warm_out("    cset x0, gt"); return 0 }
        if op == "<=" { warm_out("    cmp x0, x1"); warm_out("    cset x0, le"); return 0 }
        if op == ">=" { warm_out("    cmp x0, x1"); warm_out("    cset x0, ge"); return 0 }
        warm_out("    // unsupported winarm64 binop: " + op)
        return 0
    }
    if t == AST_UNARY_OP {
        let op = nd[1]
        warm_gen_expr(nd[2])
        if op == "-" { warm_out("    neg x0, x0"); return 0 }
        if op == "!" { warm_out("    cmp x0, #0"); warm_out("    cset x0, eq"); return 0 }
        warm_out("    // unsupported winarm64 unary: " + op)
        return 0
    }
    if t == AST_AND_EXPR {
        let end = warm_new_label()
        warm_gen_expr(nd[1])
        warm_out("    cbz x0, " + end)
        warm_gen_expr(nd[2])
        warm_label(end)
        return 0
    }
    if t == AST_OR_EXPR {
        let end = warm_new_label()
        warm_gen_expr(nd[1])
        warm_out("    cbnz x0, " + end)
        warm_gen_expr(nd[2])
        warm_label(end)
        return 0
    }
    if t == AST_CALL {
        warm_gen_call(nd)
        return 0
    }
    if t == AST_STRUCT_INIT {
        // R25A: brace-init `Foo { field: val, ... }`. Mirror AST_LIST_LIT
        // — values pushed in declaration order. Reorder source-order
        // values to decl order via cg_reorder_struct_init.
        // R26A: optional spread base on nd[4] — missing fields filled
        // from `base.field` via cg_reorder_struct_init_b.
        let s_name_wm = nd[1]
        let s_vals_wm = nd[2]
        let s_names_wm = nd[3]
        let s_base_wm = 0
        if len(nd) > 4 { s_base_wm = nd[4] }
        let ordered_wm = cg_reorder_struct_init_b(s_name_wm, s_names_wm, s_vals_wm, s_base_wm)
        warm_out("    bl _nova_warm_list_new")
        warm_push_x0()
        let wmi = 0
        while wmi < len(ordered_wm) {
            warm_gen_expr(ordered_wm[wmi])
            warm_out("    mov x1, x0")
            warm_out("    ldr x0, [sp]")
            warm_out("    bl _nova_warm_push")
            wmi = wmi + 1
        }
        warm_pop_to("x0")
        return 0
    }
    // R19B: cross-target sum-type lowering for Windows ARM64. Mirrors
    // the ARM64 Linux path exactly — the enum wire representation
    // (heap list `[tag, ...fields]`) and the AArch64 instruction set
    // are unchanged; only the runtime helper prefix differs
    // (`_nova_warm_*` vs `_nova_arm_*`).
    if t == AST_LIST_LIT {
        let llelems = nd[1]
        warm_out("    bl _nova_warm_list_new")
        warm_push_x0()
        let llei = 0
        while llei < len(llelems) {
            warm_gen_expr(llelems[llei])
            warm_out("    mov x1, x0")
            warm_out("    ldr x0, [sp]")
            warm_out("    bl _nova_warm_push")
            llei = llei + 1
        }
        warm_pop_to("x0")
        return 0
    }
    if t == AST_INDEX_EXPR {
        warm_gen_expr(nd[1])
        warm_push_x0()
        warm_gen_expr(nd[2])
        warm_out("    mov x1, x0")
        warm_pop_to("x0")
        warm_out("    bl _nova_warm_index")
        return 0
    }
    if t == AST_FIELD_ACCESS {
        let fa_base = nd[1]
        let fa_field = nd[2]
        if ast_tag(fa_base) == AST_IDENT {
            let fa_base_name = fa_base[1]
            if is_enum_name(fa_base_name) == 1 {
                let fa_vidx = enum_variant_index(fa_base_name, fa_field)
                warm_emit_load_imm("x0", fa_vidx)
                return 0
            }
        }
        warm_out("    // winarm64: AST_FIELD_ACCESS on non-enum not supported")
        warm_out("    mov x0, #0")
        return 0
    }
    if t == AST_ENUM_CTOR {
        let ec_enum = nd[1]
        let ec_variant = nd[2]
        let ec_args = nd[3]
        let ec_tag = enum_variant_index(ec_enum, ec_variant)
        warm_out("    bl _nova_warm_list_new")
        warm_push_x0()
        warm_emit_load_imm("x1", ec_tag)
        warm_out("    ldr x0, [sp]")
        warm_out("    bl _nova_warm_push")
        let eci = 0
        while eci < len(ec_args) {
            warm_gen_expr(ec_args[eci])
            warm_out("    mov x1, x0")
            warm_out("    ldr x0, [sp]")
            warm_out("    bl _nova_warm_push")
            eci = eci + 1
        }
        warm_pop_to("x0")
        return 0
    }
    // R20A: winARM64 lowering of postfix `?` Result propagation.
    // Evaluate the inner expression to a tagged tuple; if tag == 0
    // unwrap to the payload (`value[1]`), otherwise branch to the
    // function epilogue with x0 already holding the whole Err tuple.
    if t == AST_TRY_PROPAGATE {
        let q_ok = warm_new_label()
        warm_gen_expr(nd[1])
        warm_push_x0()
        warm_out("    mov x1, #0")
        warm_out("    bl _nova_warm_index")
        warm_out("    cbz x0, " + q_ok)
        // Err path: pop the saved tagged tuple back into x0 and jump
        // to the enclosing function's epilogue label.
        warm_pop_to("x0")
        warm_out("    b _warm_fn_epilogue_" + warm_current_fn())
        warm_label(q_ok)
        warm_pop_to("x0")
        warm_out("    mov x1, #1")
        warm_out("    bl _nova_warm_index")
        return 0
    }
    if t == AST_MATCH_STMT {
        let m_disc = nd[1]
        let m_arms = nd[2]
        let m_end = warm_new_label()
        warm_gen_expr(m_disc)
        warm_push_x0()
        let mi = 0
        while mi < len(m_arms) {
            let m_arm = m_arms[mi]
            let m_pat = m_arm[1]
            let m_body = m_arm[2]
            let m_pt = ast_tag(m_pat)
            if m_pt == AST_WILDCARD {
                warm_out("    add sp, sp, #16")
                if ast_tag(m_body) == AST_EXPR_STMT {
                    warm_gen_expr(m_body[1])
                } else { if ast_tag(m_body) == AST_BLOCK {
                    warm_gen_stmt(m_body)
                } else {
                    warm_gen_expr(m_body)
                } }
                warm_out("    b " + m_end)
            } else { if m_pt == AST_ENUM_PATTERN {
                let m_next = warm_new_label()
                let m_ep_enum = m_pat[1]
                let m_ep_variant = m_pat[2]
                let m_ep_binders = m_pat[3]
                let m_ep_tag = enum_variant_index(m_ep_enum, m_ep_variant)
                warm_out("    ldr x0, [sp]")
                warm_out("    mov x1, #0")
                warm_out("    bl _nova_warm_index")
                warm_emit_load_imm("x1", m_ep_tag)
                warm_out("    cmp x0, x1")
                warm_out("    b.ne " + m_next)
                let m_ebi = 0
                while m_ebi < len(m_ep_binders) {
                    let m_bname = m_ep_binders[m_ebi]
                    if m_bname == "_" {
                    } else {
                        warm_out("    ldr x0, [sp]")
                        warm_emit_load_imm("x1", m_ebi + 1)
                        warm_out("    bl _nova_warm_index")
                        let m_boff = warm_local_off(m_bname)
                        warm_out("    str x0, [x29, #-" + int_to_str(m_boff) + "]")
                    }
                    m_ebi = m_ebi + 1
                }
                warm_out("    add sp, sp, #16")
                if ast_tag(m_body) == AST_EXPR_STMT {
                    warm_gen_expr(m_body[1])
                } else { if ast_tag(m_body) == AST_BLOCK {
                    warm_gen_stmt(m_body)
                } else {
                    warm_gen_expr(m_body)
                } }
                warm_out("    b " + m_end)
                warm_label(m_next)
            } else {
                let m_next2 = warm_new_label()
                warm_gen_expr(m_pat)
                warm_out("    mov x1, x0")
                warm_out("    ldr x0, [sp]")
                warm_out("    cmp x0, x1")
                warm_out("    b.ne " + m_next2)
                warm_out("    add sp, sp, #16")
                if ast_tag(m_body) == AST_EXPR_STMT {
                    warm_gen_expr(m_body[1])
                } else { if ast_tag(m_body) == AST_BLOCK {
                    warm_gen_stmt(m_body)
                } else {
                    warm_gen_expr(m_body)
                } }
                warm_out("    b " + m_end)
                warm_label(m_next2)
            } }
            mi = mi + 1
        }
        warm_out("    add sp, sp, #16")
        warm_out("    mov x0, #0")
        warm_label(m_end)
        return 0
    }
    warm_out("    // unsupported winarm64 expression tag " + int_to_str(t))
    warm_out("    mov x0, #0")
    return 0
}

fn warm_gen_stmt(nd) {
    let t = ast_tag(nd)
    if t == AST_LET_STMT {
        let nm = nd[1]
        let val = nd[2]
        warm_gen_expr(val)
        let off = warm_local_off(nm)
        warm_out("    str x0, [x29, #-" + int_to_str(off) + "]")
        return 0
    }
    if t == AST_ASSIGN_STMT {
        let nm = nd[1]
        warm_gen_expr(nd[2])
        let off = warm_local_off(nm)
        warm_out("    str x0, [x29, #-" + int_to_str(off) + "]")
        return 0
    }
    if t == AST_EXPR_STMT {
        warm_gen_expr(nd[1])
        return 0
    }
    if t == AST_RETURN_STMT {
        let val = nd[1]
        if val == 0 {
            warm_out("    mov x0, #0")
        } else {
            warm_gen_expr(val)
        }
        warm_out("    b _warm_fn_epilogue_" + warm_current_fn())
        return 0
    }
    if t == AST_IF_STMT {
        let cond = nd[1]
        let then_b = nd[2]
        let else_b = nd[3]
        let else_lbl = warm_new_label()
        let end_lbl = warm_new_label()
        warm_gen_expr(cond)
        warm_out("    cbz x0, " + else_lbl)
        warm_gen_stmt(then_b)
        warm_out("    b " + end_lbl)
        warm_label(else_lbl)
        if else_b != 0 {
            warm_gen_stmt(else_b)
        }
        warm_label(end_lbl)
        return 0
    }
    if t == AST_WHILE_STMT {
        let head_lbl = warm_new_label()
        let end_lbl = warm_new_label()
        let saved_break = warm_break_label
        let saved_cont = warm_continue_label
        warm_break_label = end_lbl
        warm_continue_label = head_lbl
        warm_label(head_lbl)
        warm_gen_expr(nd[1])
        warm_out("    cbz x0, " + end_lbl)
        warm_gen_stmt(nd[2])
        warm_out("    b " + head_lbl)
        warm_label(end_lbl)
        warm_break_label = saved_break
        warm_continue_label = saved_cont
        return 0
    }
    if t == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            warm_gen_stmt(stmts[i])
            i = i + 1
        }
        return 0
    }
    if t == AST_BREAK_STMT {
        if len(warm_break_label) > 0 {
            warm_out("    b " + warm_break_label)
        }
        return 0
    }
    if t == AST_CONTINUE_STMT {
        if len(warm_continue_label) > 0 {
            warm_out("    b " + warm_continue_label)
        }
        return 0
    }
    if t == AST_MATCH_STMT {
        warm_gen_expr(nd)
        return 0
    }
    warm_out("    // unsupported winarm64 stmt tag " + int_to_str(t))
    return 0
}

fn warm_gen_function(nd) {
    let name = nd[1]
    let params = nd[2]
    let body = nd[3]

    warm_locals = list_new()
    warm_local_count = 0
    warm_params = params
    warm_param_count = len(params)
    warm_current_fn_name = name

    let pi = 0
    while pi < warm_param_count {
        push(warm_locals, params[pi])
        warm_local_count = warm_local_count + 1
        pi = pi + 1
    }
    warm_collect_locals(body)

    let frame_bytes = warm_local_count * 8
    let rem = frame_bytes % 16
    if rem > 0 { frame_bytes = frame_bytes + (16 - rem) }
    if frame_bytes < 16 { frame_bytes = 16 }

    warm_out("")
    warm_out(".globl " + name)
    warm_out(".p2align 2")
    warm_label(name)
    warm_out("    stp x29, x30, [sp, #-16]!")
    warm_out("    mov x29, sp")
    warm_out("    sub sp, sp, #" + int_to_str(frame_bytes))

    let ai = 0
    while ai < warm_param_count {
        if ai < 8 {
            let off = (ai + 1) * 8
            warm_out("    str x" + int_to_str(ai) + ", [x29, #-" + int_to_str(off) + "]")
        }
        ai = ai + 1
    }

    warm_gen_stmt(body)

    warm_out("    mov x0, #0")
    warm_label("_warm_fn_epilogue_" + name)
    warm_out("    add sp, sp, #" + int_to_str(frame_bytes))
    warm_out("    ldp x29, x30, [sp], #16")
    warm_out("    ret")
}

fn warm_emit_stub(label, msg) {
    let idx = warm_add_string(msg)
    warm_out("")
    warm_out(".p2align 2")
    warm_label(label)
    warm_out("    adrp x0, _wstr_" + int_to_str(idx))
    warm_out("    add x0, x0, :lo12:_wstr_" + int_to_str(idx))
    warm_out("    bl _nova_warm_println")
    warm_out("    mov w0, #1")
    warm_call_import("__imp_ExitProcess")
}

// Tiny Win32 runtime: enough to make println(string) work via
// GetStdHandle+WriteFile, plus error-stubs for unsupported builtins.
// All routines preserve the AAPCS64 frame discipline and 16-byte SP
// alignment at call boundaries.
fn warm_emit_runtime() {
    // ---- _nova_warm_strlen: NUL-terminated byte count of x0 in x0 ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_strlen")
    warm_out("    mov x1, x0")
    warm_out("    mov x2, #0")
    warm_label(".Lwarm_strlen_loop")
    warm_out("    ldrb w3, [x1, x2]")
    warm_out("    cbz w3, .Lwarm_strlen_done")
    warm_out("    add x2, x2, #1")
    warm_out("    b .Lwarm_strlen_loop")
    warm_label(".Lwarm_strlen_done")
    warm_out("    mov x0, x2")
    warm_out("    ret")

    // ---- _nova_warm_write_stdout(ptr=x0, len=x1) ----
    // GetStdHandle(-11) -> stdout handle, then
    // WriteFile(handle, buf, len, &written, NULL).
    // We need a tiny scratch slot for lpNumberOfBytesWritten — use the
    // stack. Frame layout: [sp, #0..7] saved x19 (buf ptr while we call
    // GetStdHandle), [sp, #8..15] saved x20 (len), [sp, #16..23]
    // lpNumberOfBytesWritten, [sp, #24..31] padding to 32-byte shadow.
    // Windows ARM64 does NOT require the 32-byte shadow space the x64
    // ABI does; we still keep 16-byte SP alignment.
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_write_stdout")
    warm_out("    stp x29, x30, [sp, #-48]!")
    warm_out("    mov x29, sp")
    warm_out("    str x19, [sp, #16]")           // save buf
    warm_out("    str x20, [sp, #24]")           // save len
    warm_out("    str x21, [sp, #32]")           // saved space for &written
    warm_out("    mov x19, x0")                  // buf
    warm_out("    mov x20, x1")                  // len
    // GetStdHandle(STD_OUTPUT_HANDLE = -11). DWORD arg in w0; we want
    // the 32-bit value 0xFFFFFFF5 = -11. movn produces this directly.
    warm_out("    movn w0, #10")                 // -11 in 32-bit
    warm_call_import("__imp_GetStdHandle")
    // x0 = stdout handle. Now WriteFile(hFile=x0, lpBuffer=x19,
    // nNumberOfBytesToWrite=x20, lpNumberOfBytesWritten=&[sp+32],
    // lpOverlapped=NULL).
    warm_out("    mov x1, x19")                  // lpBuffer
    warm_out("    mov x2, x20")                  // nNumberOfBytesToWrite
    warm_out("    add x3, sp, #32")              // &lpNumberOfBytesWritten
    warm_out("    mov x4, #0")                   // lpOverlapped = NULL
    warm_call_import("__imp_WriteFile")
    warm_out("    ldr x21, [sp, #32]")
    warm_out("    ldr x20, [sp, #24]")
    warm_out("    ldr x19, [sp, #16]")
    warm_out("    ldp x29, x30, [sp], #48")
    warm_out("    ret")

    // ---- _nova_warm_print: write(stdout, x0, strlen(x0)) ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_print")
    warm_out("    stp x29, x30, [sp, #-32]!")
    warm_out("    mov x29, sp")
    warm_out("    str x19, [sp, #16]")
    warm_out("    mov x19, x0")
    warm_out("    bl _nova_warm_strlen")
    warm_out("    mov x1, x0")                   // len
    warm_out("    mov x0, x19")                  // buf
    warm_out("    bl _nova_warm_write_stdout")
    warm_out("    ldr x19, [sp, #16]")
    warm_out("    ldp x29, x30, [sp], #32")
    warm_out("    ret")

    // ---- _nova_warm_println: print + CRLF ----
    // Windows console expects \r\n; PE binaries that emit only \n
    // print fine in modern terminals but cmd.exe sometimes ignores
    // the LF without CR. Use CRLF for compatibility.
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_println")
    warm_out("    stp x29, x30, [sp, #-16]!")
    warm_out("    mov x29, sp")
    warm_out("    bl _nova_warm_print")
    warm_out("    adrp x0, _warm_crlf")
    warm_out("    add x0, x0, :lo12:_warm_crlf")
    warm_out("    mov x1, #2")
    warm_out("    bl _nova_warm_write_stdout")
    warm_out("    ldp x29, x30, [sp], #16")
    warm_out("    ret")

    // R19B: real list runtime on Windows ARM64 (R17A.2 cross-target enum
    // codegen). Same layout as ARM64 Linux: header { sentinel=-1, len,
    // cap, data_ptr } / 8-byte slot data. Allocator bumps a 4 MiB static
    // BSS arena (no VirtualAlloc — keeps the import set restricted to
    // the existing KERNEL32 .def used by `make smoke-winarm64`).

    // ---- _nova_warm_alloc(x0=size) -> ptr (x0) ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_alloc")
    warm_out("    stp x29, x30, [sp, #-32]!")
    warm_out("    mov x29, sp")
    warm_out("    str x19, [sp, #16]")
    warm_out("    mov x19, x0")                    // x19 = aligned-up size
    warm_out("    add x19, x19, #15")
    warm_out("    and x19, x19, #-16")
    warm_out("    adrp x0, _nova_warm_heap_ptr")
    warm_out("    add x0, x0, :lo12:_nova_warm_heap_ptr")
    warm_out("    ldr x1, [x0]")                   // current ptr
    warm_out("    cbnz x1, .Lwarm_alloc_have_heap")
    // First call: point heap_ptr at the start of the static arena.
    warm_out("    adrp x1, _nova_warm_heap_arena")
    warm_out("    add x1, x1, :lo12:_nova_warm_heap_arena")
    warm_out("    movz x2, #0, lsl #0")
    warm_out("    movk x2, #64, lsl #16")          // 64 * 65536 = 4 MiB
    warm_out("    add x2, x1, x2")
    warm_out("    adrp x0, _nova_warm_heap_end")
    warm_out("    add x0, x0, :lo12:_nova_warm_heap_end")
    warm_out("    str x2, [x0]")
    warm_out("    adrp x0, _nova_warm_heap_ptr")
    warm_out("    add x0, x0, :lo12:_nova_warm_heap_ptr")
    warm_out("    str x1, [x0]")
    warm_label(".Lwarm_alloc_have_heap")
    warm_out("    adrp x0, _nova_warm_heap_ptr")
    warm_out("    add x0, x0, :lo12:_nova_warm_heap_ptr")
    warm_out("    ldr x1, [x0]")
    warm_out("    add x2, x1, x19")
    warm_out("    adrp x3, _nova_warm_heap_end")
    warm_out("    add x3, x3, :lo12:_nova_warm_heap_end")
    warm_out("    ldr x4, [x3]")
    warm_out("    cmp x2, x4")
    warm_out("    b.gt .Lwarm_alloc_fail")
    warm_out("    adrp x0, _nova_warm_heap_ptr")
    warm_out("    add x0, x0, :lo12:_nova_warm_heap_ptr")
    warm_out("    str x2, [x0]")
    warm_out("    mov x0, x1")
    warm_out("    ldr x19, [sp, #16]")
    warm_out("    ldp x29, x30, [sp], #32")
    warm_out("    ret")
    warm_label(".Lwarm_alloc_fail")
    warm_out("    mov w0, #1")
    warm_call_import("__imp_ExitProcess")

    // ---- _nova_warm_list_new ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_list_new")
    warm_out("    stp x29, x30, [sp, #-32]!")
    warm_out("    mov x29, sp")
    warm_out("    str x19, [sp, #16]")
    warm_out("    mov x0, #32")
    warm_out("    bl _nova_warm_alloc")
    warm_out("    mov x19, x0")
    warm_out("    mov x1, #-1")
    warm_out("    str x1, [x19]")
    warm_out("    str xzr, [x19, #8]")
    warm_out("    mov x1, #16")
    warm_out("    str x1, [x19, #16]")
    warm_out("    mov x0, #128")
    warm_out("    bl _nova_warm_alloc")
    warm_out("    str x0, [x19, #24]")
    warm_out("    mov x0, x19")
    warm_out("    ldr x19, [sp, #16]")
    warm_out("    ldp x29, x30, [sp], #32")
    warm_out("    ret")

    // ---- _nova_warm_push(list=x0, val=x1) -> list ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_push")
    warm_out("    stp x29, x30, [sp, #-48]!")
    warm_out("    mov x29, sp")
    warm_out("    str x19, [sp, #16]")
    warm_out("    str x20, [sp, #24]")
    warm_out("    str x21, [sp, #32]")
    warm_out("    mov x19, x0")
    warm_out("    mov x20, x1")
    warm_out("    ldr x2, [x19, #8]")
    warm_out("    ldr x3, [x19, #16]")
    warm_out("    cmp x2, x3")
    warm_out("    b.lt .Lwarm_push_ok")
    warm_out("    lsl x21, x3, #1")
    warm_out("    str x21, [x19, #16]")
    warm_out("    lsl x0, x21, #3")
    warm_out("    bl _nova_warm_alloc")
    warm_out("    mov x4, x0")
    warm_out("    ldr x5, [x19, #24]")
    warm_out("    ldr x6, [x19, #8]")
    warm_out("    mov x7, #0")
    warm_label(".Lwarm_push_copy")
    warm_out("    cmp x7, x6")
    warm_out("    b.ge .Lwarm_push_copy_done")
    warm_out("    ldr x8, [x5, x7, lsl #3]")
    warm_out("    str x8, [x4, x7, lsl #3]")
    warm_out("    add x7, x7, #1")
    warm_out("    b .Lwarm_push_copy")
    warm_label(".Lwarm_push_copy_done")
    warm_out("    str x4, [x19, #24]")
    warm_label(".Lwarm_push_ok")
    warm_out("    ldr x2, [x19, #8]")
    warm_out("    ldr x3, [x19, #24]")
    warm_out("    str x20, [x3, x2, lsl #3]")
    warm_out("    add x2, x2, #1")
    warm_out("    str x2, [x19, #8]")
    warm_out("    mov x0, x19")
    warm_out("    ldr x21, [sp, #32]")
    warm_out("    ldr x20, [sp, #24]")
    warm_out("    ldr x19, [sp, #16]")
    warm_out("    ldp x29, x30, [sp], #48")
    warm_out("    ret")

    // ---- _nova_warm_index(list=x0, idx=x1) -> value ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_index")
    warm_out("    ldr x2, [x0]")
    warm_out("    cmn x2, #1")
    warm_out("    b.ne .Lwarm_index_str")
    warm_out("    tst x1, x1")
    warm_out("    b.ge .Lwarm_index_list_pos")
    warm_out("    ldr x3, [x0, #8]")
    warm_out("    add x1, x1, x3")
    warm_label(".Lwarm_index_list_pos")
    warm_out("    ldr x3, [x0, #24]")
    warm_out("    ldr x0, [x3, x1, lsl #3]")
    warm_out("    ret")
    warm_label(".Lwarm_index_str")
    warm_out("    ldrb w0, [x0, x1]")
    warm_out("    ret")

    // ---- _nova_warm_len(x0) -> count ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_len")
    warm_out("    cbz x0, .Lwarm_len_zero")
    warm_out("    ldr x1, [x0]")
    warm_out("    cmn x1, #1")
    warm_out("    b.ne .Lwarm_len_str")
    warm_out("    ldr x0, [x0, #8]")
    warm_out("    ret")
    warm_label(".Lwarm_len_str")
    warm_out("    b _nova_warm_strlen")
    warm_label(".Lwarm_len_zero")
    warm_out("    mov x0, #0")
    warm_out("    ret")

    // ---- _nova_warm_assert(cond=x0, msg=x1) ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_assert")
    warm_out("    cbnz x0, .Lwarm_assert_ok")
    warm_out("    stp x29, x30, [sp, #-32]!")
    warm_out("    mov x29, sp")
    warm_out("    str x19, [sp, #16]")
    warm_out("    mov x19, x1")
    warm_out("    adrp x0, _warm_assert_prefix")
    warm_out("    add x0, x0, :lo12:_warm_assert_prefix")
    warm_out("    bl _nova_warm_print")
    warm_out("    cbz x19, .Lwarm_assert_no_msg")
    warm_out("    mov x0, x19")
    warm_out("    bl _nova_warm_println")
    warm_out("    b .Lwarm_assert_exit")
    warm_label(".Lwarm_assert_no_msg")
    warm_out("    adrp x0, _warm_assert_blank")
    warm_out("    add x0, x0, :lo12:_warm_assert_blank")
    warm_out("    bl _nova_warm_println")
    warm_label(".Lwarm_assert_exit")
    warm_out("    mov w0, #1")
    warm_call_import("__imp_ExitProcess")
    warm_label(".Lwarm_assert_ok")
    warm_out("    ret")

    // ---- BSS for the bump allocator ----
    // 4 MiB static arena holds the entire list heap; sized for the R17A
    // enum / match tests + small NOVA programs. PE32+ .bss is uninit so
    // the file-on-disk doesn't carry the 4 MiB.
    warm_out("")
    warm_out(".section .bss,\"bw\"")
    warm_out(".p2align 3")
    warm_label("_nova_warm_heap_ptr")
    warm_out("    .quad 0")
    warm_label("_nova_warm_heap_end")
    warm_out("    .quad 0")
    warm_label("_nova_warm_heap_arena")
    warm_out("    .skip 4194304")
    warm_out(".section .text,\"xr\"")

    // ---- RODATA strings for assert messages ----
    warm_out("")
    warm_out(".section .rdata,\"dr\"")
    warm_out(".p2align 3")
    warm_label("_warm_assert_prefix")
    warm_out("    .asciz " + DQ + "ASSERT FAILED: " + DQ)
    warm_label("_warm_assert_blank")
    warm_out("    .asciz " + DQ + "(no message)" + DQ)
    warm_out(".section .text,\"xr\"")

    warm_emit_stub("_nova_warm_stub_read_file", "winarm64: read_file not yet supported")
    warm_emit_stub("_nova_warm_stub_write_file", "winarm64: write_file not yet supported")

    // R11D NEON SIMD i32x8 intrinsics (ARM64 Windows).
    //
    // ABI mirror of the Linux ARM64 helpers: x0=a_ptr, x1=b_ptr,
    // x2=dst_ptr. The NEON quad register width is 128 bits == 4 i32
    // lanes, so each 8-lane builtin is two NEON ops.

    // ---- _nova_warm_simd_add_i32x8: dst = a + b ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_simd_add_i32x8")
    warm_out("    ldr q0, [x0]")
    warm_out("    ldr q1, [x1]")
    warm_out("    add v0.4s, v0.4s, v1.4s")
    warm_out("    str q0, [x2]")
    warm_out("    ldr q0, [x0, #16]")
    warm_out("    ldr q1, [x1, #16]")
    warm_out("    add v0.4s, v0.4s, v1.4s")
    warm_out("    str q0, [x2, #16]")
    warm_out("    mov x0, x2")
    warm_out("    ret")

    // ---- _nova_warm_simd_sub_i32x8: dst = a - b ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_simd_sub_i32x8")
    warm_out("    ldr q0, [x0]")
    warm_out("    ldr q1, [x1]")
    warm_out("    sub v0.4s, v0.4s, v1.4s")
    warm_out("    str q0, [x2]")
    warm_out("    ldr q0, [x0, #16]")
    warm_out("    ldr q1, [x1, #16]")
    warm_out("    sub v0.4s, v0.4s, v1.4s")
    warm_out("    str q0, [x2, #16]")
    warm_out("    mov x0, x2")
    warm_out("    ret")

    // ---- _nova_warm_simd_load_i32x8: dst = src (32-byte copy) ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_simd_load_i32x8")
    warm_out("    ldr q0, [x0]")
    warm_out("    ldr q1, [x0, #16]")
    warm_out("    str q0, [x1]")
    warm_out("    str q1, [x1, #16]")
    warm_out("    mov x0, x1")
    warm_out("    ret")

    // ---- _nova_warm_simd_store_i32x8: dst = src (arg-swap of load) ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_simd_store_i32x8")
    warm_out("    ldr q0, [x1]")
    warm_out("    ldr q1, [x1, #16]")
    warm_out("    str q0, [x0]")
    warm_out("    str q1, [x0, #16]")
    warm_out("    ret")

    // ---- _nova_warm_simd_sum_abs_diff: returns sum(abs(a[i]-b[i])) for i in [0,n) ----
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_simd_sum_abs_diff")
    warm_out("    mov x3, x0")                  // a iter
    warm_out("    mov x4, x1")                  // b iter
    warm_out("    mov x5, x2")                  // remaining n
    warm_out("    movi v2.4s, #0")
    warm_out("    lsr x6, x5, #2")              // x6 = n / 4
    warm_out("    cbz x6, .Lwarm_sad_tail")
    warm_label(".Lwarm_sad_loop")
    warm_out("    ldr q0, [x3], #16")
    warm_out("    ldr q1, [x4], #16")
    warm_out("    sub v3.4s, v0.4s, v1.4s")
    warm_out("    abs v3.4s, v3.4s")
    warm_out("    add v2.4s, v2.4s, v3.4s")
    warm_out("    subs x6, x6, #1")
    warm_out("    b.ne .Lwarm_sad_loop")
    warm_label(".Lwarm_sad_tail")
    warm_out("    and x5, x5, #3")
    warm_out("    addv s2, v2.4s")
    warm_out("    fmov w0, s2")
    warm_out("    sxtw x0, w0")
    warm_out("    cbz x5, .Lwarm_sad_done")
    warm_label(".Lwarm_sad_tail_loop")
    warm_out("    ldr w7, [x3], #4")
    warm_out("    ldr w8, [x4], #4")
    warm_out("    sub w7, w7, w8")
    warm_out("    cmp w7, #0")
    warm_out("    cneg w7, w7, lt")
    warm_out("    sxtw x7, w7")
    warm_out("    add x0, x0, x7")
    warm_out("    subs x5, x5, #1")
    warm_out("    b.ne .Lwarm_sad_tail_loop")
    warm_label(".Lwarm_sad_done")
    warm_out("    ret")

    // ---- _nova_warm_simd_sad_u8: raw-byte SAD primitive (R14B) ----
    // x0=a_ptr, x1=b_ptr, x2=n_bytes. Vector loop: 16 bytes / iter.
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_simd_sad_u8")
    warm_out("    mov x3, x0")
    warm_out("    mov x4, x1")
    warm_out("    mov x5, x2")
    warm_out("    movi v2.4s, #0")
    warm_out("    lsr x6, x5, #4")
    warm_out("    cbz x6, .Lwarm_sad8_tail")
    warm_label(".Lwarm_sad8_loop")
    warm_out("    ldr q0, [x3], #16")
    warm_out("    ldr q1, [x4], #16")
    warm_out("    uabd v3.16b, v0.16b, v1.16b")
    warm_out("    uaddlp v3.8h, v3.16b")
    warm_out("    uaddlp v3.4s, v3.8h")
    warm_out("    add v2.4s, v2.4s, v3.4s")
    warm_out("    subs x6, x6, #1")
    warm_out("    b.ne .Lwarm_sad8_loop")
    warm_label(".Lwarm_sad8_tail")
    warm_out("    and x5, x5, #15")
    warm_out("    addv s2, v2.4s")
    warm_out("    fmov w0, s2")
    warm_out("    sxtw x0, w0")
    warm_out("    cbz x5, .Lwarm_sad8_done")
    warm_label(".Lwarm_sad8_tail_loop")
    warm_out("    ldrb w7, [x3], #1")
    warm_out("    ldrb w8, [x4], #1")
    warm_out("    sub w7, w7, w8")
    warm_out("    cmp w7, #0")
    warm_out("    cneg w7, w7, lt")
    warm_out("    sxtw x7, w7")
    warm_out("    add x0, x0, x7")
    warm_out("    subs x5, x5, #1")
    warm_out("    b.ne .Lwarm_sad8_tail_loop")
    warm_label(".Lwarm_sad8_done")
    warm_out("    ret")

    // ---- _nova_warm_simd_mul_acc_byte_signed_byte ----
    // R18A: byte mul-acc, u8 * i8 -> i64. ARM64 Windows NEON.
    // 8 bytes per iter; tail scalar. See arm64 helper for details.
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_simd_mul_acc_byte_signed_byte")
    warm_out("    mov x3, x0")
    warm_out("    mov x4, x1")
    warm_out("    mov x5, x2")
    warm_out("    movi v2.4s, #0")
    warm_out("    lsr x6, x5, #3")
    warm_out("    cbz x6, .Lwarm_mac_us_tail")
    warm_label(".Lwarm_mac_us_loop")
    warm_out("    ldr d0, [x3], #8")
    warm_out("    ldr d1, [x4], #8")
    warm_out("    ushll v0.8h, v0.8b, #0")
    warm_out("    sshll v1.8h, v1.8b, #0")
    warm_out("    smull v3.4s, v0.4h, v1.4h")
    warm_out("    smull2 v4.4s, v0.8h, v1.8h")
    warm_out("    add v2.4s, v2.4s, v3.4s")
    warm_out("    add v2.4s, v2.4s, v4.4s")
    warm_out("    subs x6, x6, #1")
    warm_out("    b.ne .Lwarm_mac_us_loop")
    warm_label(".Lwarm_mac_us_tail")
    warm_out("    and x5, x5, #7")
    warm_out("    addv s2, v2.4s")
    warm_out("    fmov w0, s2")
    warm_out("    sxtw x0, w0")
    warm_out("    cbz x5, .Lwarm_mac_us_done")
    warm_label(".Lwarm_mac_us_tail_loop")
    warm_out("    ldrb w7, [x3], #1")
    warm_out("    ldrsb w8, [x4], #1")
    warm_out("    mul w7, w7, w8")
    warm_out("    sxtw x7, w7")
    warm_out("    add x0, x0, x7")
    warm_out("    subs x5, x5, #1")
    warm_out("    b.ne .Lwarm_mac_us_tail_loop")
    warm_label(".Lwarm_mac_us_done")
    warm_out("    ret")

    // ---- _nova_warm_simd_mul_acc_signed_signed_byte ----
    // R18A: byte mul-acc, i8 * i8 -> i64. ARM64 Windows NEON.
    warm_out("")
    warm_out(".p2align 2")
    warm_label("_nova_warm_simd_mul_acc_signed_signed_byte")
    warm_out("    mov x3, x0")
    warm_out("    mov x4, x1")
    warm_out("    mov x5, x2")
    warm_out("    movi v2.4s, #0")
    warm_out("    lsr x6, x5, #3")
    warm_out("    cbz x6, .Lwarm_mac_ss_tail")
    warm_label(".Lwarm_mac_ss_loop")
    warm_out("    ldr d0, [x3], #8")
    warm_out("    ldr d1, [x4], #8")
    warm_out("    sshll v0.8h, v0.8b, #0")
    warm_out("    sshll v1.8h, v1.8b, #0")
    warm_out("    smull v3.4s, v0.4h, v1.4h")
    warm_out("    smull2 v4.4s, v0.8h, v1.8h")
    warm_out("    add v2.4s, v2.4s, v3.4s")
    warm_out("    add v2.4s, v2.4s, v4.4s")
    warm_out("    subs x6, x6, #1")
    warm_out("    b.ne .Lwarm_mac_ss_loop")
    warm_label(".Lwarm_mac_ss_tail")
    warm_out("    and x5, x5, #7")
    warm_out("    addv s2, v2.4s")
    warm_out("    fmov w0, s2")
    warm_out("    sxtw x0, w0")
    warm_out("    cbz x5, .Lwarm_mac_ss_done")
    warm_label(".Lwarm_mac_ss_tail_loop")
    warm_out("    ldrsb w7, [x3], #1")
    warm_out("    ldrsb w8, [x4], #1")
    warm_out("    mul w7, w7, w8")
    warm_out("    sxtw x7, w7")
    warm_out("    add x0, x0, x7")
    warm_out("    subs x5, x5, #1")
    warm_out("    b.ne .Lwarm_mac_ss_tail_loop")
    warm_label(".Lwarm_mac_ss_done")
    warm_out("    ret")
}

fn winarm64_gen_program(program) {
    warm_locals = list_new()
    warm_local_count = 0
    warm_params = list_new()
    warm_param_count = 0
    warm_strings = list_new()
    warm_str_count = 0
    warm_label_count = 0
    warm_fns = list_new()
    warm_output = list_new()
    warm_break_label = ""
    warm_continue_label = ""

    let decls = program[1]

    // R19B: collect enum / global tables so the R17A enum codegen
    // helpers (`is_enum_name`, `enum_variant_index`, ...) resolve names.
    // R25A: also register struct decls so cg_reorder_struct_init can
    // find field-declaration order for AST_STRUCT_INIT codegen.
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_ENUM_DECL {
            let entry = list_new()
            push(entry, d[1])
            push(entry, d[2])
            push(cg_enums, entry)
            cg_enum_count = cg_enum_count + 1
        }
        if ast_tag(d) == AST_STRUCT_DECL {
            let s_entry = list_new()
            push(s_entry, d[1])
            push(s_entry, d[2])
            push(cg_structs, s_entry)
            cg_struct_count = cg_struct_count + 1
        }
        if ast_tag(d) == AST_LET_STMT {
            add_global(d[1])
        }
        // R32D: top-level AST_BLOCK (struct / enum destructure).
        if ast_tag(d) == AST_BLOCK {
            cg_collect_block_globals(d)
        }
        i = i + 1
    }

    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            push(warm_fns, d[1])
        }
        i = i + 1
    }

    // PE32+ import declarations. The Windows loader populates these IAT
    // slots at process startup; we BLR through __imp_<name>.
    warm_out(".extern __imp_ExitProcess")
    warm_out(".extern __imp_GetStdHandle")
    warm_out(".extern __imp_WriteFile")
    warm_out(".extern __imp_BCryptGenRandom")
    warm_out("")
    warm_out(".section .text,\"xr\"")

    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            warm_gen_function(d)
        }
        i = i + 1
    }

    // Emit `mainCRTStartup` for top-level statements. lld-link's default
    // console entry for non-CRT binaries is `mainCRTStartup`, so we land
    // there from the OS loader.
    warm_locals = list_new()
    warm_local_count = 0
    warm_params = list_new()
    warm_param_count = 0
    warm_current_fn_name = "mainCRTStartup"

    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dt = ast_tag(d)
        let count_this = 1
        if dt == AST_FN_DECL { count_this = 0 }
        if dt == AST_STRUCT_DECL { count_this = 0 }
        if dt == AST_ENUM_DECL { count_this = 0 }
        if dt == AST_METHOD_DECL { count_this = 0 }
        if dt == AST_EXTERN_FN { count_this = 0 }
        if dt == AST_ASM { count_this = 0 }
        if count_this == 1 {
            warm_collect_locals(d)
        }
        i = i + 1
    }
    let start_frame = warm_local_count * 8
    let srem = start_frame % 16
    if srem > 0 { start_frame = start_frame + (16 - srem) }
    if start_frame < 16 { start_frame = 16 }

    warm_out("")
    warm_out(".globl mainCRTStartup")
    warm_out(".p2align 2")
    warm_label("mainCRTStartup")
    warm_out("    stp x29, x30, [sp, #-16]!")
    warm_out("    mov x29, sp")
    warm_out("    sub sp, sp, #" + int_to_str(start_frame))

    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dt = ast_tag(d)
        let skip = 0
        if dt == AST_FN_DECL { skip = 1 }
        if dt == AST_STRUCT_DECL { skip = 1 }
        if dt == AST_ENUM_DECL { skip = 1 }
        if dt == AST_METHOD_DECL { skip = 1 }
        if dt == AST_EXTERN_FN { skip = 1 }
        if dt == AST_ASM { skip = 1 }
        if skip == 0 {
            warm_gen_stmt(d)
        }
        i = i + 1
    }

    warm_out("    add sp, sp, #" + int_to_str(start_frame))
    warm_out("    ldp x29, x30, [sp], #16")
    warm_out("    mov w0, #0")
    warm_call_import("__imp_ExitProcess")
    // Safety net — should never be reached, ExitProcess is noreturn.
    warm_out("    ret")

    warm_emit_runtime()

    // String table goes in .rdata so the PE loader maps it read-only.
    // Also emit the CRLF blob used by _nova_warm_println.
    warm_out("")
    warm_out(".section .rdata,\"dr\"")
    warm_label("_warm_crlf")
    warm_out("    .byte 13, 10")
    if warm_str_count > 0 {
        let si = 0
        while si < warm_str_count {
            warm_out(".p2align 3")
            warm_label("_wstr_" + int_to_str(si))
            warm_out("    .asciz " + DQ + escape_for_asm(warm_strings[si]) + DQ)
            si = si + 1
        }
    }

    return join(warm_output, chr(10))
}

fn gen_program(program) {
    if cg_target == 2 {
        return wasm_gen_program(program)
    }
    if cg_target == 4 {
        return arm64_gen_program(program)
    }
    if cg_target == 5 {
        return winarm64_gen_program(program)
    }
    let decls = program[1]

    // Expand mind declarations into regular statements
    let expanded = list_new()
    let ei = 0
    while ei < len(decls) {
        let ed = decls[ei]
        if ast_tag(ed) == AST_MIND {
            let mname = ed[1]
            let mnodes = ed[2]
            let mchannels = ed[3]
            let mscaling = ed[4]
            let mpersist = ed[5]
            // scheduler_ensure_init()
            let si_args = list_new()
            push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_ensure_init"), si_args)))
            // For each node: check if it has a scaling entry
            let ni = 0
            while ni < len(mnodes) {
                let nd_entry = mnodes[ni]
                let nd_name = nd_entry[0]
                let nd_type = nd_entry[1]
                let var_name = mname + "_" + nd_name
                let scale_entry = 0
                let sci = 0
                while sci < len(mscaling) {
                    if mscaling[sci][0] == nd_name {
                        scale_entry = mscaling[sci]
                    }
                    sci = sci + 1
                }
                if scale_entry == 0 {
                    let nn_args = list_new()
                    push(nn_args, ast_str(nd_name))
                    push(nn_args, ast_int(nd_type))
                    push(expanded, ast_let(var_name, ast_call(ast_ident("node_new"), nn_args)))
                    let sr_args = list_new()
                    push(sr_args, ast_ident(var_name))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_register"), sr_args)))
                } else {
                    let pool_var = mname + "_pool_" + nd_name
                    let np_args = list_new()
                    push(np_args, ast_str(nd_name))
                    push(np_args, ast_int(nd_type))
                    push(np_args, ast_int(scale_entry[2]))
                    push(np_args, ast_int(scale_entry[1]))
                    push(expanded, ast_let(pool_var, ast_call(ast_ident("node_pool_new"), np_args)))
                    let rp_args = list_new()
                    push(rp_args, ast_ident(pool_var))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_register_pool"), rp_args)))
                    let pf_args = list_new()
                    push(pf_args, ast_ident(pool_var))
                    push(expanded, ast_let(var_name, ast_call(ast_ident("node_pool_first"), pf_args)))
                }
                ni = ni + 1
            }
            // Create aggregate nodes list: MindName_nodes
            let nlist_var = mname + "_nodes"
            push(expanded, ast_let(nlist_var, ast_call(ast_ident("list_new"), list_new())))
            let nli = 0
            while nli < len(mnodes) {
                let nle = mnodes[nli]
                let nle_name = nle[0]
                let nle_var = mname + "_" + nle_name
                let ne_var = nlist_var + "_e" + int_to_str(nli)
                push(expanded, ast_let(ne_var, ast_call(ast_ident("list_new"), list_new())))
                let p1_args = list_new()
                push(p1_args, ast_ident(ne_var))
                push(p1_args, ast_str(nle_name))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("push"), p1_args)))
                let p2_args = list_new()
                push(p2_args, ast_ident(ne_var))
                push(p2_args, ast_ident(nle_var))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("push"), p2_args)))
                let p3_args = list_new()
                push(p3_args, ast_ident(nlist_var))
                push(p3_args, ast_ident(ne_var))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("push"), p3_args)))
                nli = nli + 1
            }
            // For each channel
            let ci = 0
            while ci < len(mchannels) {
                let ch = mchannels[ci]
                let ch_name = ch[0]
                let ch_source = ch[1]
                let ch_dests = ch[2]
                let ch_flow = ch[3]
                let ch_var = mname + "_ch_" + ch_name
                if ch_flow == 1 {
                    if len(ch_dests) == 1 {
                        let cd_args = list_new()
                        push(cd_args, ast_str(ch_name))
                        push(cd_args, ast_str(ch_source))
                        push(cd_args, ast_ident(mname + "_" + ch_dests[0]))
                        push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_direct"), cd_args)))
                    } else {
                        let cb_args = list_new()
                        push(cb_args, ast_str(ch_name))
                        push(cb_args, ast_str(ch_source))
                        push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_broadcast"), cb_args)))
                        let di = 0
                        while di < len(ch_dests) {
                            let ad_args = list_new()
                            push(ad_args, ast_ident(ch_var))
                            push(ad_args, ast_ident(mname + "_" + ch_dests[di]))
                            push(expanded, ast_expr_stmt(ast_call(ast_ident("channel_add_dest"), ad_args)))
                            di = di + 1
                        }
                    }
                }
                if ch_flow == 2 {
                    let cb2_args = list_new()
                    push(cb2_args, ast_str(ch_name))
                    push(cb2_args, ast_str(ch_source))
                    push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_broadcast"), cb2_args)))
                    let di = 0
                    while di < len(ch_dests) {
                        let ad_args = list_new()
                        push(ad_args, ast_ident(ch_var))
                        push(ad_args, ast_ident(mname + "_" + ch_dests[di]))
                        push(expanded, ast_expr_stmt(ast_call(ast_ident("channel_add_dest"), ad_args)))
                        di = di + 1
                    }
                }
                if ch_flow == 3 {
                    let cw_args = list_new()
                    push(cw_args, ast_str(ch_name))
                    push(cw_args, ast_str(ch_source))
                    push(cw_args, ast_int(50))
                    push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_weighted"), cw_args)))
                    let di = 0
                    while di < len(ch_dests) {
                        let ad_args = list_new()
                        push(ad_args, ast_ident(ch_var))
                        push(ad_args, ast_ident(mname + "_" + ch_dests[di]))
                        push(expanded, ast_expr_stmt(ast_call(ast_ident("channel_add_dest"), ad_args)))
                        di = di + 1
                    }
                }
                if ch_flow == 4 {
                    let cf_args = list_new()
                    push(cf_args, ast_str(ch_name))
                    push(cf_args, ast_str(ch_source))
                    push(cf_args, ast_int(50))
                    push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_filtered"), cf_args)))
                    let di = 0
                    while di < len(ch_dests) {
                        let ad_args = list_new()
                        push(ad_args, ast_ident(ch_var))
                        push(ad_args, ast_ident(mname + "_" + ch_dests[di]))
                        push(expanded, ast_expr_stmt(ast_call(ast_ident("channel_add_dest"), ad_args)))
                        di = di + 1
                    }
                }
                let sac_args = list_new()
                push(sac_args, ast_ident(ch_var))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_add_channel"), sac_args)))
                ci = ci + 1
            }
            // Create aggregate channels list: MindName_channels
            let clist_var = mname + "_channels"
            push(expanded, ast_let(clist_var, ast_call(ast_ident("list_new"), list_new())))
            // Persist section: open DB for each persist entry
            let pi = 0
            while pi < len(mpersist) {
                let pe = mpersist[pi]
                let pe_node = pe[0]
                let pe_path = pe[1]
                let pe_interval = pe[2]
                let db_var = mname + "_db_" + pe_node
                let dbo_args = list_new()
                push(dbo_args, ast_str(pe_path))
                push(expanded, ast_let(db_var, ast_call(ast_ident("db_open"), dbo_args)))
                let das_args = list_new()
                push(das_args, ast_ident(db_var))
                push(das_args, ast_int(pe_interval))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("db_set_autosave"), das_args)))
                pi = pi + 1
            }
            // Security section
            let msecurity = ed[6]
            let si2 = 0
            while si2 < len(msecurity) {
                let se = msecurity[si2]
                let se_node = se[0]
                let se_type = se[1]
                if se_type == "rate_limit" {
                    let srl_args = list_new()
                    push(srl_args, ast_str(se_node))
                    push(srl_args, ast_int(se[2]))
                    push(srl_args, ast_int(se[3]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_set_rate_limit"), srl_args)))
                }
                if se_type == "block" {
                    let sbr_args = list_new()
                    push(sbr_args, ast_str(se_node))
                    push(sbr_args, ast_str(se[2]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_block_route"), sbr_args)))
                }
                si2 = si2 + 1
            }
        } else {
          if ast_tag(ed) == AST_SOUL {
            let sname = ed[1]
            let s_identity = ed[2]
            let s_values = ed[3]
            let s_drives = ed[4]
            let s_feelings = ed[5]
            let s_phases = ed[6]
            let s_reactions = ed[7]
            let soul_var = sname + "_soul"

            let sei_args = list_new()
            push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_ensure_init"), sei_args)))

            let sn_args = list_new()
            push(sn_args, ast_str(sname))
            push(expanded, ast_let(soul_var, ast_call(ast_ident("soul_new"), sn_args)))

            let si = 0
            while si < len(s_identity) {
                let id_entry = s_identity[si]
                let sid_args = list_new()
                push(sid_args, ast_ident(soul_var))
                push(sid_args, ast_str(id_entry[0]))
                push(sid_args, ast_str(id_entry[1]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_identity"), sid_args)))
                si = si + 1
            }

            let vi = 0
            while vi < len(s_values) {
                let v_entry = s_values[vi]
                let sv_args = list_new()
                push(sv_args, ast_ident(soul_var))
                push(sv_args, ast_str(v_entry[0]))
                push(sv_args, ast_str(v_entry[1]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_value"), sv_args)))
                vi = vi + 1
            }

            let di = 0
            while di < len(s_drives) {
                let d_entry = s_drives[di]
                let sd_args = list_new()
                push(sd_args, ast_ident(soul_var))
                push(sd_args, ast_str(d_entry[0]))
                push(sd_args, ast_int(d_entry[1]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_drive"), sd_args)))
                di = di + 1
            }

            let fi = 0
            while fi < len(s_feelings) {
                let f_entry = s_feelings[fi]
                let sf_args = list_new()
                push(sf_args, ast_ident(soul_var))
                push(sf_args, ast_str(f_entry[0]))
                push(sf_args, ast_int(f_entry[1]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_feeling"), sf_args)))
                fi = fi + 1
            }

            let pi = 0
            while pi < len(s_phases) {
                let p_entry = s_phases[pi]
                let sp_args = list_new()
                push(sp_args, ast_ident(soul_var))
                push(sp_args, ast_str(p_entry[0]))
                push(sp_args, ast_str(p_entry[1]))
                push(sp_args, ast_str(p_entry[2]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_add_phase"), sp_args)))

                if p_entry[4] != "" {
                    let st_args = list_new()
                    push(st_args, ast_ident(soul_var))
                    push(st_args, ast_str(p_entry[0]))
                    push(st_args, ast_str(p_entry[4]))
                    push(st_args, ast_str(p_entry[5]))
                    push(st_args, ast_int(p_entry[6]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_phase_set_transition"), st_args)))
                }

                let phase_boosts = p_entry[3]
                let bi = 0
                while bi < len(phase_boosts) {
                    let boost = phase_boosts[bi]
                    let sb_args = list_new()
                    push(sb_args, ast_ident(soul_var))
                    push(sb_args, ast_str(p_entry[0]))
                    push(sb_args, ast_str(boost[0]))
                    push(sb_args, ast_int(boost[1]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_add_phase_boost"), sb_args)))
                    bi = bi + 1
                }
                pi = pi + 1
            }

            let ri = 0
            while ri < len(s_reactions) {
                let r_entry = s_reactions[ri]
                let trigger = r_entry[0]
                let effects = r_entry[1]
                let sr_args = list_new()
                push(sr_args, ast_ident(soul_var))
                push(sr_args, ast_str(trigger))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_add_reaction"), sr_args)))

                let efi = 0
                while efi < len(effects) {
                    let eff = effects[efi]
                    let se_args = list_new()
                    push(se_args, ast_ident(soul_var))
                    push(se_args, ast_str(trigger))
                    push(se_args, ast_str(eff[0]))
                    if eff[0] == "shift" {
                        push(se_args, ast_str(eff[1]))
                        push(se_args, ast_int(eff[2]))
                    }
                    if eff[0] == "strengthen" {
                        push(se_args, ast_str(eff[1]))
                        push(se_args, ast_int(0))
                    }
                    if eff[0] == "reconsider" {
                        push(se_args, ast_str(eff[1]))
                        push(se_args, ast_int(0))
                    }
                    if eff[0] == "transition_to" {
                        push(se_args, ast_str(eff[1]))
                        push(se_args, ast_int(0))
                    }
                    if eff[0] == "conditional_transition" {
                        push(se_args, ast_str(eff[3]))
                        push(se_args, ast_int(0))
                    }
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_add_reaction_effect"), se_args)))
                    efi = efi + 1
                }
                ri = ri + 1
            }

            if len(s_phases) > 0 {
                let sip_args = list_new()
                push(sip_args, ast_ident(soul_var))
                let first_phase = s_phases[0]
                push(sip_args, ast_str(first_phase[0]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_phase"), sip_args)))
            }

            let srs_args = list_new()
            push(srs_args, ast_ident(soul_var))
            push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_register_soul"), srs_args)))
          } else {
            if ast_tag(ed) == AST_SYSTEM {
                let sysname = ed[1]
                let sys_minds = ed[2]
                let sys_bridges = ed[3]
                let sys_shared = ed[4]
                let sys_soul = ed[5]
                let sys_var = sysname + "_sys"

                let sn_args = list_new()
                push(sn_args, ast_str(sysname))
                push(expanded, ast_let(sys_var, ast_call(ast_ident("system_new"), sn_args)))

                let mi = 0
                while mi < len(sys_minds) {
                    let me = sys_minds[mi]
                    let label = me[0]
                    let mtype = me[1]
                    let sam_args = list_new()
                    push(sam_args, ast_ident(sys_var))
                    push(sam_args, ast_str(label))
                    push(sam_args, ast_ident(mtype + "_nodes"))
                    push(sam_args, ast_ident(mtype + "_channels"))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("system_add_mind"), sam_args)))
                    mi = mi + 1
                }

                let bi = 0
                while bi < len(sys_bridges) {
                    let be = sys_bridges[bi]
                    let sab_args = list_new()
                    push(sab_args, ast_ident(sys_var))
                    push(sab_args, ast_str(be[0]))
                    push(sab_args, ast_str(be[1]))
                    push(sab_args, ast_str(be[2]))
                    push(sab_args, ast_int(be[3]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("system_add_bridge"), sab_args)))
                    bi = bi + 1
                }

                if sys_shared != "" {
                    let ssd_args = list_new()
                    push(ssd_args, ast_ident(sys_var))
                    push(ssd_args, ast_str(sys_shared))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("system_set_shared_db"), ssd_args)))
                }

                if sys_soul != "" {
                    let ssa_args = list_new()
                    push(ssa_args, ast_ident(sys_var))
                    push(ssa_args, ast_ident(sys_soul + "_soul"))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("system_attach_soul"), ssa_args)))
                }
            } else {
                push(expanded, ed)
            }
          }
        }
        ei = ei + 1
    }
    decls = expanded

    // First pass: collect struct and enum declarations
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_STRUCT_DECL {
            let entry = list_new()
            push(entry, d[1])
            push(entry, d[2])
            push(cg_structs, entry)
            cg_struct_count = cg_struct_count + 1
        }
        if ast_tag(d) == AST_ENUM_DECL {
            let entry = list_new()
            push(entry, d[1])
            push(entry, d[2])
            push(cg_enums, entry)
            cg_enum_count = cg_enum_count + 1
        }
        i = i + 1
    }

    // Collect globals (top-level let declarations)
    //
    // R32D: also recurse into top-level AST_BLOCK so the let stmts that
    // R25A (struct destructure) and R32D (let-enum-destructure) lower
    // into a `{ let tmp = rhs; let x = tmp.x; let y = tmp.y; ... }`
    // shape register their inner-let names as globals at the top level.
    // Without this, accesses like `print_int(x)` after the destructure
    // would fall through to an unreserved stack slot. The WASM codegen
    // already wires this path via wasm_collect_locals.
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_LET_STMT {
            add_global(d[1])
        }
        if ast_tag(d) == AST_BLOCK {
            cg_collect_block_globals(d)
        }
        i = i + 1
    }

    // Collect methods
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_METHOD_DECL {
            let mentry = list_new()
            push(mentry, d[1])
            push(mentry, d[2])
            push(cg_methods, mentry)
            cg_method_count = cg_method_count + 1
            let mfn_name = d[1] + "_" + d[2]
            push(cg_fns, mfn_name)
            _cg_ht_add(cg_fns_ht, mfn_name)
            _cg_ht_set(cg_fn_modules, mfn_name, cg_source_file)
        }
        i = i + 1
    }

    // Collect extern function declarations
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_EXTERN_FN {
            push(cg_fns, d[1])
            _cg_ht_add(cg_fns_ht, d[1])
            _cg_ht_set(cg_fn_modules, d[1], cg_source_file)
            push(cg_externs, d[1])
            cg_extern_count = cg_extern_count + 1
        }
        i = i + 1
    }

    // Collect function names (including lambdas from parser)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            push(cg_fns, d[1])
            _cg_ht_add(cg_fns_ht, d[1])
            _cg_ht_set(cg_fn_modules, d[1], cg_source_file)
        }
        i = i + 1
    }
    // Register lambda names
    let li = 0
    while li < len(par_lambdas) {
        let lam = par_lambdas[li]
        push(cg_fns, lam[1])
        _cg_ht_add(cg_fns_ht, lam[1])
        _cg_ht_set(cg_fn_modules, lam[1], cg_source_file)
        li = li + 1
    }

    // Pre-pass: compute captures for all lambdas
    li = 0
    while li < len(par_lambdas) {
        let lam = par_lambdas[li]
        let caps = compute_captures(lam)
        if len(caps) > 0 {
            let cap_entry = list_new()
            push(cap_entry, lam[1])
            push(cap_entry, caps)
            push(cg_lambda_caps, cap_entry)
            let ci = 0
            while ci < len(caps) {
                let slot_entry = list_new()
                push(slot_entry, lam[1])
                push(slot_entry, caps[ci])
                push(cg_capture_slots, slot_entry)
                ci = ci + 1
            }
        }
        li = li + 1
    }

    // R37A pre-pass: for each user fn / lambda, compute the set of its locals
    // that are captured by lambdas nested inside its body. Those locals must
    // be BOXED at let-stmt time so the source-scope reads/writes and the
    // closure's view share storage (by-reference capture). We walk each fn's
    // body collecting (1) the lambdas declared inside it and (2) the fn's own
    // local names, then intersect the union of inner-lambda captures with the
    // local names.
    li = 0
    while li < len(decls) {
        let dd = decls[li]
        if ast_tag(dd) == AST_FN_DECL {
            cg_compute_boxed_locals_for_fn(dd)
        }
        li = li + 1
    }
    li = 0
    while li < len(par_lambdas) {
        cg_compute_boxed_locals_for_fn(par_lambdas[li])
        li = li + 1
    }

    out(".intel_syntax noprefix")
    if cg_debug == 1 {
        if len(cg_source_file) > 0 {
            out("    .file 1 " + DQ + cg_source_file + DQ)
        }
    }
    out_section("text")

    // Generate functions
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            gen_function(d)
        }
        i = i + 1
    }

    // Generate method functions
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_METHOD_DECL {
            let mfn = list_new()
            push(mfn, AST_FN_DECL)
            push(mfn, d[1] + "_" + d[2])
            push(mfn, d[3])
            push(mfn, d[4])
            gen_function(mfn)
        }
        i = i + 1
    }

    // Generate lambda functions
    li = 0
    while li < len(par_lambdas) {
        gen_function(par_lambdas[li])
        li = li + 1
    }

    // Emit top-level asm blocks (outside _start)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_ASM {
            let asm_lines = d[1]
            let ai = 0
            while ai < len(asm_lines) {
                out("    " + asm_lines[ai])
                ai = ai + 1
            }
        }
        i = i + 1
    }

    // Generate _start for top-level code
    cg_locals = list_new()
    cg_local_count = 0
    cg_params = list_new()
    cg_param_count = 0
    cg_float_vars = list_new()
    cg_float_var_count = 0

    // Collect top-level locals (non-global let inside if/while)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dtag = ast_tag(d)
        if dtag == AST_IF_STMT {
            collect_locals(d)
        }
        if dtag == AST_WHILE_STMT {
            collect_locals(d)
        }
        if dtag == AST_FOR_STMT {
            collect_locals(d)
        }
        if dtag == AST_MATCH_STMT {
            collect_locals(d)
        }
        if dtag == AST_TRY_CATCH {
            collect_locals(d)
        }
        if dtag == AST_DO_WHILE {
            collect_locals(d)
        }
        if dtag == AST_FOR_INDEXED {
            collect_locals(d)
        }
        if dtag == AST_DESTRUCTURE {
            collect_locals(d)
        }
        if dtag == AST_EXPR_STMT {
            collect_locals(d)
        }
        if dtag == AST_LET_STMT {
            collect_comp_vars(d[2])
        }
        if dtag == AST_ASSIGN_STMT {
            collect_comp_vars(d[2])
        }
        i = i + 1
    }

    out("")
    if cg_target == 1 {
        out(".globl _main")
        out("_main:")
    } else {
        if cg_target == 3 {
            out(".globl mainCRTStartup")
            out("mainCRTStartup:")
        } else {
            if cg_link_libc == 1 {
                out(".globl main")
                out("main:")
            } else {
                out(".globl _start")
                out("_start:")
            }
        }
    }
    if cg_target == 3 {
        out("    call _nova_win_init_args")
        out("    call _nova_win_init_envp")
    } else {
        if cg_link_libc == 1 {
            // libc main(argc, argv, envp)
            out("    lea rax, [rdi + rdi + 1]")    // tag argc -> (argc<<1)|1
            out("    mov [rip + _g___argc], rax")
            out("    mov [rip + _g___argv], rsi")
            out("    mov [rip + _g___envp], rdx")
        } else {
            out("    mov rdi, [rsp]")
            out("    lea rsi, [rsp + 8]")
            out("    mov [rip + _g___argv], rsi")
            // envp is after argv: at rsp + 8 + (argc+1)*8  (uses raw argc)
            out("    mov rax, rdi")
            out("    inc rax")
            out("    lea rax, [rsp + 8 + rax*8]")
            out("    mov [rip + _g___envp], rax")
            out("    lea rax, [rdi + rdi + 1]")    // tag argc -> (argc<<1)|1
            out("    mov [rip + _g___argc], rax")
        }
    }
    out("    push rbp")
    out("    mov rbp, rsp")
    let frame_size = cg_local_count * 8
    let frame_rem2 = frame_size % 16
    if frame_rem2 == 0 {
    } else {
        frame_size = frame_size + (16 - frame_rem2)
    }
    if frame_size > 0 {
        out("    sub rsp, " + int_to_str(frame_size))
    }

    // Initialize IEEE 754 float constants at program startup.
    //
    // R38A: cg_float_count at this point only reflects floats already
    // emitted by FUNCTION-BODY codegen above; top-level let-rhs floats
    // get added LATER by the gen-stmt loop below this point. A program
    // whose floats live exclusively in top-level lets would skip the
    // init call entirely and read 0 bits from the .bss pool. Conserve
    // self-host bit identity by only pre-checking top-level let
    // statements whose value LITERALLY contains an AST_FLOAT_LIT —
    // a shallow check that catches `let x = 3.14` and the common
    // arithmetic expressions over float literals. Deep AST walking
    // is intentionally avoided here (the deep walker was tried but
    // tripped over cg-internal recursion limits during self-host;
    // shallow probing matches both NOVA self-host (no top-level
    // floats) and the R38A test_floats.nova case).
    let has_top_floats = 0
    let _fp_i = 0
    while _fp_i < len(decls) {
        let _fp_d = decls[_fp_i]
        if ast_tag(_fp_d) == AST_LET_STMT {
            if has_float_lit_shallow(_fp_d[2]) == 1 {
                has_top_floats = 1
            }
        }
        _fp_i = _fp_i + 1
    }
    if cg_float_count > 0 {
        out("    call _nova_init_floats")
    } else {
        if has_top_floats == 1 {
            out("    call _nova_init_floats")
        }
    }

    // Generate top-level statements (skip function and method declarations)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let skip_top = 0
        if ast_tag(d) == AST_FN_DECL { skip_top = 1 }
        if ast_tag(d) == AST_METHOD_DECL { skip_top = 1 }
        if ast_tag(d) == AST_EXTERN_FN { skip_top = 1 }
        if ast_tag(d) == AST_ASM { skip_top = 1 }
        if skip_top == 0 {
            gen_stmt(d)
        }
        i = i + 1
    }

    if cg_target == 3 {
        out("    xor ecx, ecx")
        out("    call [rip + __imp_ExitProcess]")
    } else {
        if cg_link_libc == 1 {
            out("    xor eax, eax")
            out("    mov rsp, rbp")
            out("    pop rbp")
            out("    ret")
        } else {
            out("    mov rdi, 0")
            emit_syscall(60)
        }
    }

    // Emit string data section
    //
    // _strlit_start (here) marks the lowest address of any string literal
    // (user or runtime). _strlit_end is emitted at the very end of all
    // rodata so the pointer-classifier can range-check addresses against
    // the entire merged .rodata block, regardless of which .rodata
    // emission added it. See gen_runtime() for the classifier.
    out("")
    out_section("rodata")
    out("    .align 8")
    out_label("_strlit_start")
    i = 0
    while i < cg_str_count {
        out("    .align 2")     // tagging: every string pointer must be even (bit0=0)
        out_label("_str_" + int_to_str(i))
        out("    .asciz " + DQ + escape_for_asm(cg_strings[i]) + DQ)
        i = i + 1
    }

    // Emit float constant slots in data section (initialized at startup)
    if cg_float_count > 0 {
        out("")
        out_section("bss")
        i = 0
        while i < cg_float_count {
            out("    .align 8")
            out_label("_fc_" + int_to_str(i))
            out("    .quad 0")
            i = i + 1
        }
    }

    // Emit globals in .bss
    out("")
    out_section("bss")
    // Always add argc/argv globals
    out("    .align 8")
    out_label("_g___argc")
    out("    .quad 0")
    out_label("_g___argv")
    out("    .quad 0")
    out_label("_g___envp")
    out("    .quad 0")
    i = 0
    while i < cg_global_count {
        out("    .align 8")
        out_label("_g_" + cg_globals[i])
        out("    .quad 0")
        i = i + 1
    }

    // R37A: closure capture slots `_cap_<lname>_<var>` are no longer emitted
    // — closures now lower to `[fn_ptr, captures_list]` tuples and captures
    // live in per-instance heap-allocated boxes (see AST_LAMBDA + AST_IDENT
    // handling in gen_expr). The .bss path that R35C used is dead code.

    // Emit Win32 API import declarations for PE/COFF linking
    if cg_target == 3 {
        out("")
        out(".extern __imp_ExitProcess")
        out(".extern __imp_GetStdHandle")
        out(".extern __imp_WriteFile")
        out(".extern __imp_ReadFile")
        out(".extern __imp_CreateFileA")
        out(".extern __imp_CloseHandle")
        out(".extern __imp_VirtualAlloc")
        out(".extern __imp_Sleep")
        out(".extern __imp_CreateDirectoryA")
        out(".extern __imp_DeleteFileA")
        out(".extern __imp_GetFileSizeEx")
        out(".extern __imp_GetSystemTimeAsFileTime")
        out(".extern __imp_GetCommandLineA")
        out(".extern __imp_GetEnvironmentStringsA")
        out(".extern __imp_FreeEnvironmentStringsA")
        out(".extern __imp_GetModuleFileNameA")
        out(".extern __imp_CreateProcessA")
        out(".extern __imp_OpenProcess")
        out(".extern __imp_WaitForSingleObject")
        out(".extern __imp_GetExitCodeProcess")
        out(".extern __imp_CreatePipe")
        out(".extern __imp_TerminateProcess")
        out(".extern __imp_GetCurrentProcessId")
        // C runtime signal/raise come from msvcrt; cross-windows ld pulls
        // them via -lmsvcrt added in the smoke target. PE imports are
        // resolved through msvcrt.dll at load time.
        out(".extern __imp_signal")
        out(".extern __imp_raise")
        out(".extern __imp_WSAStartup")
        out(".extern __imp_socket")
        out(".extern __imp_bind")
        out(".extern __imp_listen")
        out(".extern __imp_accept")
        out(".extern __imp_connect")
        out(".extern __imp_send")
        out(".extern __imp_recv")
        out(".extern __imp_sendto")
        out(".extern __imp_recvfrom")
        out(".extern __imp_setsockopt")
        out(".extern __imp_WSAPoll")
        out(".extern __imp_closesocket")
        // R31A: non-blocking I/O knobs. `ioctlsocket(s, FIONBIO=0x8004667e,
        // &one)` is the Win32 sibling of fcntl(F_SETFL, O_NONBLOCK).
        // `getsockopt(s, SOL_SOCKET=0xFFFF, SO_ERROR=0x1007, &val, &vlen)`
        // reads the deferred connect(2) error after the POLLOUT wait.
        out(".extern __imp_ioctlsocket")
        out(".extern __imp_getsockopt")
        // bcrypt.dll: BCryptGenRandom (cryptographically secure RNG).
        // Linked via -lbcrypt in cross-windows / smoke-secure-random.
        out(".extern __imp_BCryptGenRandom")
    }

    // Emit FFI extern declarations when linking with libc
    if cg_link_libc == 1 {
        out("")
        out(".extern dlopen")
        out(".extern dlsym")
        out(".extern dlclose")
        out(".extern exit")
        out(".extern system")
    }

    // Emit runtime library
    out("")
    out_section("text")
    gen_runtime()

    // Emit DWARF .debug_abbrev + .debug_info sections (Linux ELF only).
    // Must come AFTER all code emission so the per-function start/end
    // labels are defined in .text — the DIEs reference them as low_pc /
    // high_pc absolute addresses. Section order is .debug_abbrev BEFORE
    // .debug_info: the info section's CU header references abbrev table
    // offset 0, and putting abbrev first keeps that offset valid even if a
    // tool concatenates objects later.
    if cg_target == 0 {
        if cg_debug == 1 {
            if len(cg_source_file) > 0 {
                cg_emit_debug_abbrev_section()
                cg_emit_debug_info_section()
            }
        }
    }

    peephole_optimize()

    return join(cg_output, chr(10))
}

// =====================================================================
// WASM Backend — emits WebAssembly Text Format (WAT)
// =====================================================================

let wasm_strs = 0
let wasm_str_offset = 0
let wasm_data_entries = 0
let wasm_indent = 0
let wasm_local_map = 0
let wasm_local_idx = 0
let wasm_globals_list = 0
let wasm_break_depth = 0
let wasm_continue_depth = 0
let wasm_block_depth = 0
let wasm_fn_names = 0

fn wi(line) {
    let prefix = ""
    let ii = 0
    while ii < wasm_indent {
        prefix = prefix + "  "
        ii = ii + 1
    }
    push(cg_output, prefix + line)
}

fn wasm_add_str(s) {
    let offset = wasm_str_offset
    push(wasm_data_entries, offset)
    push(wasm_data_entries, s)
    wasm_str_offset = wasm_str_offset + len(s) + 1
    return offset
}

fn wasm_escape_str(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 34 {
            result = result + chr(92) + chr(34)
        } else {
            if c == 92 {
                result = result + chr(92) + chr(92)
            } else {
                if c == 10 {
                    result = result + chr(92) + "n"
                } else {
                    if c < 32 {
                        result = result + "."
                    } else {
                        result = result + chr(c)
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

fn wasm_local_get(name) {
    wi("local.get $" + name)
}

fn wasm_local_set(name) {
    wi("local.set $" + name)
}

fn wasm_global_get(name) {
    wi("global.get $g_" + name)
}

fn wasm_global_set(name) {
    wi("global.set $g_" + name)
}

fn wasm_is_global(name) {
    let i = 0
    while i < cg_global_count {
        if cg_globals[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

fn wasm_is_fn(name) {
    let i = 0
    while i < len(wasm_fn_names) {
        if wasm_fn_names[i] == name { return 1 }
        i = i + 1
    }
    if is_builtin_fn(name) == 1 { return 1 }
    return 0
}

fn wasm_collect_locals(nd) {
    let tag = ast_tag(nd)
    if tag == AST_LET_STMT {
        let vname = nd[1]
        if wasm_is_global(vname) == 0 {
            let exists = 0
            let k = 0
            while k < len(wasm_local_map) {
                if wasm_local_map[k] == vname { exists = 1 }
                k = k + 1
            }
            if exists == 0 {
                push(wasm_local_map, vname)
            }
        }
        // R19B: recurse into the let body so AST_ENUM_PATTERN binders
        // inside `let x = match { Enum::V(y) => y }` get registered too.
        wasm_collect_locals(nd[2])
    }
    if tag == AST_ASSIGN_STMT {
        wasm_collect_locals(nd[2])
    }
    if tag == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            wasm_collect_locals(stmts[i])
            i = i + 1
        }
    }
    if tag == AST_IF_STMT {
        wasm_collect_locals(nd[2])
        if len(nd) > 3 {
            if nd[3] == 0 {
            } else {
                wasm_collect_locals(nd[3])
            }
        }
    }
    if tag == AST_WHILE_STMT {
        wasm_collect_locals(nd[2])
    }
    if tag == AST_FOR_STMT {
        let vname = nd[1]
        let exists = 0
        let k = 0
        while k < len(wasm_local_map) {
            if wasm_local_map[k] == vname { exists = 1 }
            k = k + 1
        }
        if exists == 0 {
            push(wasm_local_map, vname)
        }
        wasm_collect_locals(nd[3])
    }
    if tag == AST_DO_WHILE {
        wasm_collect_locals(nd[1])
    }
    if tag == AST_TRY_CATCH {
        wasm_collect_locals(nd[1])
        wasm_collect_locals(nd[2])
    }
    if tag == AST_MATCH_STMT {
        // Walk match arms so let-bindings inside match-as-expression arm
        // bodies get a wasm local declared at function top. Without this
        // wasm_gen_let assigns to a local that was never declared and
        // wat2wasm rejects the module.
        //
        // R19B: also register binders from AST_ENUM_PATTERN arms so they
        // get a local declared at function top.
        wasm_collect_locals(nd[1])
        let m_arms = nd[2]
        let mai = 0
        while mai < len(m_arms) {
            let m_arm = m_arms[mai]
            let m_pat = m_arm[1]
            if ast_tag(m_pat) == AST_ENUM_PATTERN {
                let m_binders = m_pat[3]
                let mbi = 0
                while mbi < len(m_binders) {
                    let mbn = m_binders[mbi]
                    if mbn == "_" {
                    } else {
                        if wasm_is_global(mbn) == 0 {
                            let mb_exists = 0
                            let mk = 0
                            while mk < len(wasm_local_map) {
                                if wasm_local_map[mk] == mbn { mb_exists = 1 }
                                mk = mk + 1
                            }
                            if mb_exists == 0 { push(wasm_local_map, mbn) }
                        }
                    }
                    mbi = mbi + 1
                }
            }
            wasm_collect_locals(m_arm[2])
            mai = mai + 1
        }
    }
    if tag == AST_FOR_INDEXED {
        let iname = nd[1]
        let vname2 = nd[2]
        let exists = 0
        let k = 0
        while k < len(wasm_local_map) {
            if wasm_local_map[k] == iname { exists = 1 }
            k = k + 1
        }
        if exists == 0 { push(wasm_local_map, iname) }
        exists = 0
        k = 0
        while k < len(wasm_local_map) {
            if wasm_local_map[k] == vname2 { exists = 1 }
            k = k + 1
        }
        if exists == 0 { push(wasm_local_map, vname2) }
        wasm_collect_locals(nd[4])
    }
    // R20A: recurse into AST_TRY_PROPAGATE's inner expression so any
    // nested `let x = match …` style binders still register.
    if tag == AST_TRY_PROPAGATE {
        wasm_collect_locals(nd[1])
    }
    // R25A: AST_DO_EXPR appears in expression position via the parser's
    // struct-pattern match rewrite. Recurse into both init stmts and the
    // final expression so any let-binders register at function top.
    if tag == AST_DO_EXPR {
        let de_stmts = nd[1]
        let de_i = 0
        while de_i < len(de_stmts) {
            wasm_collect_locals(de_stmts[de_i])
            de_i = de_i + 1
        }
        wasm_collect_locals(nd[2])
    }
    // R25A: AST_EXPR_STMT can wrap an AST_DO_EXPR (struct-pattern match
    // arm body lowered via lower_struct_match_arm). Recurse so binders
    // inside the do-expr's init stmts get registered.
    if tag == AST_EXPR_STMT {
        wasm_collect_locals(nd[1])
    }
}

fn wasm_gen_expr(nd) {
    let tag = ast_tag(nd)

    if tag == AST_INT_LIT {
        wi("i64.const " + int_to_str(nd[1]))
        return 0
    }

    if tag == AST_BOOL_LIT {
        if nd[1] == 1 {
            wi("i64.const 1")
        } else {
            wi("i64.const 0")
        }
        return 0
    }

    if tag == AST_NONE_LIT {
        wi("i64.const 0")
        return 0
    }

    if tag == AST_FLOAT_LIT {
        // WASM: approximate float as scaled integer for now
        let fscale = 1
        let fdi = 0
        while fdi < nd[3] {
            fscale = fscale * 10
            fdi = fdi + 1
        }
        let wasm_fval = nd[1] * 1000 + (nd[2] * 1000 / fscale)
        wi("i64.const " + int_to_str(wasm_fval))
        return 0
    }

    if tag == AST_STR_LIT {
        let offset = wasm_add_str(nd[1])
        wi("i64.const " + int_to_str(offset))
        return 0
    }

    if tag == AST_IDENT {
        let name = nd[1]
        if wasm_is_global(name) == 1 {
            wasm_global_get(name)
        } else {
            if wasm_is_fn(name) == 1 {
                wi("i64.const 0")
            } else {
                wasm_local_get(name)
            }
        }
        return 0
    }

    if tag == AST_BIN_OP {
        let op = nd[1]
        if op == "==" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("call $rt_eq")
            return 0
        }
        if op == "+" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("call $rt_add")
            return 0
        }
        if op == "-" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.sub")
            return 0
        }
        if op == "*" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.mul")
            return 0
        }
        if op == "/" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.div_s")
            return 0
        }
        if op == "%" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.rem_s")
            return 0
        }
        if op == "<" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.lt_s")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == ">" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.gt_s")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == "<=" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.le_s")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == ">=" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.ge_s")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == "!=" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("call $rt_eq")
            wi("i64.eqz")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == "&" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.and")
            return 0
        }
        if op == "|" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.or")
            return 0
        }
        if op == "^" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.xor")
            return 0
        }
        if op == "<<" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.shl")
            return 0
        }
        if op == ">>" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.shr_s")
            return 0
        }
        wasm_gen_expr(nd[2])
        wasm_gen_expr(nd[3])
        wi("i64.add")
        return 0
    }

    if tag == AST_UNARY_OP {
        let op = nd[1]
        if op == "-" {
            wi("i64.const 0")
            wasm_gen_expr(nd[2])
            wi("i64.sub")
            return 0
        }
        if op == "!" {
            wasm_gen_expr(nd[2])
            wi("i64.eqz")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == "~" {
            wi("i64.const -1")
            wasm_gen_expr(nd[2])
            wi("i64.xor")
            return 0
        }
        wasm_gen_expr(nd[2])
        return 0
    }

    if tag == AST_AND_EXPR {
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        wi("i64.const 0")
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[2])
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }

    if tag == AST_OR_EXPR {
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        wi("i64.const 1")
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[2])
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }

    if tag == AST_CALL {
        let callee = nd[1]
        let args = nd[2]
        let callee_name = ""
        if ast_tag(callee) == AST_IDENT {
            callee_name = callee[1]
        }
        if ast_tag(callee) == AST_FIELD_ACCESS {
            callee_name = callee[1][1] + "_" + callee[2]
        }
        let i = 0
        while i < len(args) {
            wasm_gen_expr(args[i])
            i = i + 1
        }
        wi("call $" + callee_name)
        return 0
    }

    if tag == AST_STRUCT_INIT {
        // R25A: brace-init `Foo { field: val, ... }`. Same wire-shape as
        // AST_LIST_LIT — values pushed in declaration order. Reorder
        // source-order values to decl order via cg_reorder_struct_init,
        // then mirror AST_LIST_LIT's runtime sequence.
        // R26A: optional spread base on nd[4] — missing fields filled
        // from `base.field`.
        let s_name_w = nd[1]
        let s_vals_w = nd[2]
        let s_names_w = nd[3]
        let s_base_w = 0
        if len(nd) > 4 { s_base_w = nd[4] }
        let ordered_w = cg_reorder_struct_init_b(s_name_w, s_names_w, s_vals_w, s_base_w)
        wi("call $list_new")
        wi("global.set $g__wasm_list_tmp")
        let wi2 = 0
        while wi2 < len(ordered_w) {
            wi("global.get $g__wasm_list_tmp")
            wasm_gen_expr(ordered_w[wi2])
            wi("call $push")
            wi("drop")
            wi2 = wi2 + 1
        }
        wi("global.get $g__wasm_list_tmp")
        return 0
    }

    if tag == AST_INDEX_EXPR {
        wasm_gen_expr(nd[1])
        wasm_gen_expr(nd[2])
        wi("call $rt_index")
        return 0
    }

    if tag == AST_LIST_LIT {
        let elems = nd[1]
        wi("call $list_new")
        wi("global.set $g__wasm_list_tmp")
        let i = 0
        while i < len(elems) {
            wi("global.get $g__wasm_list_tmp")
            wasm_gen_expr(elems[i])
            wi("call $push")
            wi("drop")
            i = i + 1
        }
        wi("global.get $g__wasm_list_tmp")
        return 0
    }

    if tag == AST_NULLISH {
        wasm_gen_expr(nd[1])
        wi("local.tee $__nullish_tmp")
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        wi("local.get $__nullish_tmp")
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[2])
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }

    if tag == AST_FLOW {
        wasm_gen_expr(nd[2])
        wasm_gen_expr(nd[3])
        let ft = nd[1]
        if ft == FLOW_FWD { wi("call $_nova_flow_fwd") }
        if ft == FLOW_BWD { wi("call $_nova_flow_bwd") }
        if ft == FLOW_BROADCAST { wi("call $_nova_flow_broadcast") }
        if ft == FLOW_ENRICH { wi("call $_nova_flow_enrich") }
        if ft == FLOW_TENTATIVE { wi("call $_nova_flow_tentative") }
        if ft == FLOW_RESONATE { wi("call $_nova_flow_resonate") }
        if ft == FLOW_FILTER { wi("call $_nova_flow_filter") }
        return 0
    }

    if tag == AST_TERNARY {
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[2])
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[3])
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }

    // R19B: cross-target sum-type lowering for WASM. The enum value is
    // a heap-allocated list `[tag, ...fields]` — same wire layout as the
    // native paths — and we use the existing `$list_new`, `$push`,
    // `$rt_index` runtime helpers from wasm_gen_rt_core. AST_FIELD_ACCESS
    // on an enum (e.g. `Option::None` used as a value) lowers to a tag
    // constant; AST_MATCH_STMT uses an `if (result i64) ... else ...`
    // tree threaded through arms with a tail default of i64.const 0.
    // R25A: also handle AST_FIELD_ACCESS on struct values — a struct
    // value is a list `[v0, v1, ...]` in declaration order, so look up
    // the field's index via find_field_index and emit `$rt_index`.
    if tag == AST_FIELD_ACCESS {
        let fa_base = nd[1]
        let fa_field = nd[2]
        if ast_tag(fa_base) == AST_IDENT {
            let fa_base_name = fa_base[1]
            if is_enum_name(fa_base_name) == 1 {
                let fa_vidx = enum_variant_index(fa_base_name, fa_field)
                wi("i64.const " + int_to_str(fa_vidx))
                return 0
            }
        }
        let fidx = find_field_index(fa_field)
        if fidx >= 0 {
            wasm_gen_expr(fa_base)
            wi("i64.const " + int_to_str(fidx))
            wi("call $rt_index")
            return 0
        }
        wi("i64.const 0")
        return 0
    }
    if tag == AST_ENUM_CTOR {
        let ec_enum = nd[1]
        let ec_variant = nd[2]
        let ec_args = nd[3]
        let ec_tag = enum_variant_index(ec_enum, ec_variant)
        wi("call $list_new")
        wi("global.set $g__wasm_list_tmp")
        // Push the tag.
        wi("global.get $g__wasm_list_tmp")
        wi("i64.const " + int_to_str(ec_tag))
        wi("call $push")
        wi("drop")
        // Push each field value in declaration order.
        let eci = 0
        while eci < len(ec_args) {
            wi("global.get $g__wasm_list_tmp")
            wasm_gen_expr(ec_args[eci])
            wi("call $push")
            wi("drop")
            eci = eci + 1
        }
        wi("global.get $g__wasm_list_tmp")
        return 0
    }
    // R20A: postfix `?` Result propagation on WASM. Stash the inner
    // tagged tuple in $g__wasm_q_tmp; if value[0]==0 (Ok) the if-result
    // is value[1], otherwise the else-arm `return`s the whole tuple
    // (the Err Result) from the enclosing wasm func.
    if tag == AST_TRY_PROPAGATE {
        wasm_gen_expr(nd[1])
        wi("global.set $g__wasm_q_tmp")
        wi("global.get $g__wasm_q_tmp")
        wi("i64.const 0")
        wi("call $rt_index")
        wi("i64.const 0")
        wi("call $rt_eq")
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        // Ok branch: extract value[1] as the expression's result.
        wi("global.get $g__wasm_q_tmp")
        wi("i64.const 1")
        wi("call $rt_index")
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        // Err branch: push the whole tuple onto the stack and return
        // from the enclosing function. After `return` instruction
        // stack is polymorphic so the trailing `i64.const 0` keeps the
        // wasm validator happy about the else-arm producing i64.
        wi("global.get $g__wasm_q_tmp")
        wi("return")
        wi("i64.const 0")
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }
    if tag == AST_MATCH_STMT {
        let m_disc = nd[1]
        let m_arms = nd[2]
        // Evaluate the discriminant exactly once; save into a scratch
        // global. Each arm's tag check then re-reads that global.
        wasm_gen_expr(m_disc)
        wi("global.set $g__wasm_match_disc")
        // Build a chain of `if/else` blocks. The result of the chain is
        // the body of the matched arm (or 0 if no arm matched, matching
        // the x86-64 fall-through semantics).
        let mi = 0
        while mi < len(m_arms) {
            let m_arm = m_arms[mi]
            let m_pat = m_arm[1]
            let m_body = m_arm[2]
            let m_pt = ast_tag(m_pat)
            // R25A: detect a guarded wildcard arm (arm length > 3). The
            // parser-side rewrite for struct match patterns produces this
            // shape: `_ if <field-test chain> => body`. WASM previously
            // assumed AST_WILDCARD always succeeds and short-circuited
            // without checking the guard — handle the guarded variant by
            // wrapping body emission in an `if (result i64)`.
            let m_has_guard = 0
            if len(m_arm) > 3 { m_has_guard = 1 }
            if m_pt == AST_WILDCARD {
                if m_has_guard == 1 {
                    // Guarded wildcard: evaluate guard, branch on truthy.
                    wasm_gen_expr(m_arm[3])
                    wi("i64.eqz")
                    wi("i32.eqz")
                    wi("if (result i64)")
                    wasm_indent = wasm_indent + 1
                    if ast_tag(m_body) == AST_EXPR_STMT {
                        wasm_gen_expr(m_body[1])
                    } else { if ast_tag(m_body) == AST_BLOCK {
                        wasm_gen_stmt(m_body)
                        wi("i64.const 0")
                    } else {
                        wasm_gen_expr(m_body)
                    } }
                    wasm_indent = wasm_indent - 1
                    wi("else")
                    wasm_indent = wasm_indent + 1
                    // Leave chain open for next arm — same as enum-pattern.
                } else {
                    // `_` always matches: emit body and stop the chain.
                    if ast_tag(m_body) == AST_EXPR_STMT {
                        wasm_gen_expr(m_body[1])
                    } else { if ast_tag(m_body) == AST_BLOCK {
                        // Block body returns an i64; assume it's a single
                        // expression-stmt body (or no value).
                        wasm_gen_stmt(m_body)
                        wi("i64.const 0")
                    } else {
                        wasm_gen_expr(m_body)
                    } }
                    mi = mi + 1
                    // Close any previously-opened if-chains (one per prior arm).
                    let close_i = 0
                    while close_i < mi - 1 {
                        wasm_indent = wasm_indent - 1
                        wi("end")
                        close_i = close_i + 1
                    }
                    return 0
                }
            } else { if m_pt == AST_ENUM_PATTERN {
                let m_ep_enum = m_pat[1]
                let m_ep_variant = m_pat[2]
                let m_ep_binders = m_pat[3]
                let m_ep_tag = enum_variant_index(m_ep_enum, m_ep_variant)
                // Tag check: rt_index(disc, 0) == tag ?
                wi("global.get $g__wasm_match_disc")
                wi("i64.const 0")
                wi("call $rt_index")
                wi("i64.const " + int_to_str(m_ep_tag))
                wi("call $rt_eq")
                wi("i64.eqz")
                wi("i32.eqz")
                wi("if (result i64)")
                wasm_indent = wasm_indent + 1
                // Bind each binder to disc[1+i].
                let m_ebi = 0
                while m_ebi < len(m_ep_binders) {
                    let m_bname = m_ep_binders[m_ebi]
                    if m_bname == "_" {
                    } else {
                        wi("global.get $g__wasm_match_disc")
                        wi("i64.const " + int_to_str(m_ebi + 1))
                        wi("call $rt_index")
                        if wasm_is_global(m_bname) == 1 {
                            wi("global.set $g_" + m_bname)
                        } else {
                            wi("local.set $" + m_bname)
                        }
                    }
                    m_ebi = m_ebi + 1
                }
                // R33C: arm-guard support. Wrap body emission in an
                // inner `if` so a false guard falls through to the
                // chain's else branch (same fall-through semantics as
                // x86_64).
                if m_has_guard == 1 {
                    wasm_gen_expr(m_arm[3])
                    wi("i64.eqz")
                    wi("i32.eqz")
                    wi("if (result i64)")
                    wasm_indent = wasm_indent + 1
                    if ast_tag(m_body) == AST_EXPR_STMT {
                        wasm_gen_expr(m_body[1])
                    } else { if ast_tag(m_body) == AST_BLOCK {
                        wasm_gen_stmt(m_body)
                        wi("i64.const 0")
                    } else {
                        wasm_gen_expr(m_body)
                    } }
                    wasm_indent = wasm_indent - 1
                    wi("else")
                    wasm_indent = wasm_indent + 1
                    wi("i64.const 0")
                    wasm_indent = wasm_indent - 1
                    wi("end")
                } else {
                    if ast_tag(m_body) == AST_EXPR_STMT {
                        wasm_gen_expr(m_body[1])
                    } else { if ast_tag(m_body) == AST_BLOCK {
                        wasm_gen_stmt(m_body)
                        wi("i64.const 0")
                    } else {
                        wasm_gen_expr(m_body)
                    } }
                }
                wasm_indent = wasm_indent - 1
                wi("else")
                wasm_indent = wasm_indent + 1
                // Fall through to next arm — leave indent open for chain.
            } else {
                // Generic value pattern.
                wi("global.get $g__wasm_match_disc")
                wasm_gen_expr(m_pat)
                wi("call $rt_eq")
                wi("i64.eqz")
                wi("i32.eqz")
                wi("if (result i64)")
                wasm_indent = wasm_indent + 1
                // R33C: arm-guard support for value patterns too.
                if m_has_guard == 1 {
                    wasm_gen_expr(m_arm[3])
                    wi("i64.eqz")
                    wi("i32.eqz")
                    wi("if (result i64)")
                    wasm_indent = wasm_indent + 1
                    if ast_tag(m_body) == AST_EXPR_STMT {
                        wasm_gen_expr(m_body[1])
                    } else { if ast_tag(m_body) == AST_BLOCK {
                        wasm_gen_stmt(m_body)
                        wi("i64.const 0")
                    } else {
                        wasm_gen_expr(m_body)
                    } }
                    wasm_indent = wasm_indent - 1
                    wi("else")
                    wasm_indent = wasm_indent + 1
                    wi("i64.const 0")
                    wasm_indent = wasm_indent - 1
                    wi("end")
                } else {
                    if ast_tag(m_body) == AST_EXPR_STMT {
                        wasm_gen_expr(m_body[1])
                    } else { if ast_tag(m_body) == AST_BLOCK {
                        wasm_gen_stmt(m_body)
                        wi("i64.const 0")
                    } else {
                        wasm_gen_expr(m_body)
                    } }
                }
                wasm_indent = wasm_indent - 1
                wi("else")
                wasm_indent = wasm_indent + 1
            } }
            mi = mi + 1
        }
        // Default branch (no arm matched): yield 0.
        wi("i64.const 0")
        // Close every `if (result i64) ... else ...` we opened (one per
        // non-wildcard arm).
        let close_i2 = 0
        while close_i2 < len(m_arms) {
            wasm_indent = wasm_indent - 1
            wi("end")
            close_i2 = close_i2 + 1
        }
        return 0
    }

    if tag == AST_DO_EXPR {
        // R25A: AST_DO_EXPR appears in expression position when parser
        // rewrites a struct-pattern match into `do { let __tmp = expr;
        // match __tmp { ... } }`. Run init statements then evaluate
        // the final expression.
        let do_stmts = nd[1]
        let do_final = nd[2]
        let di = 0
        while di < len(do_stmts) {
            wasm_gen_stmt(do_stmts[di])
            di = di + 1
        }
        wasm_gen_expr(do_final)
        return 0
    }

    wi("i64.const 0")
    return 0
}

fn wasm_gen_stmt(nd) {
    let tag = ast_tag(nd)

    if tag == AST_EXPR_STMT {
        wasm_gen_expr(nd[1])
        wi("drop")
        return 0
    }

    if tag == AST_LET_STMT {
        let vname = nd[1]
        wasm_gen_expr(nd[2])
        if wasm_is_global(vname) == 1 {
            wasm_global_set(vname)
        } else {
            wasm_local_set(vname)
        }
        return 0
    }

    if tag == AST_ASSIGN_STMT {
        let vname = nd[1]
        wasm_gen_expr(nd[2])
        if wasm_is_global(vname) == 1 {
            wasm_global_set(vname)
        } else {
            wasm_local_set(vname)
        }
        return 0
    }

    if tag == AST_IF_STMT {
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if")
        wasm_indent = wasm_indent + 1
        wasm_block_depth = wasm_block_depth + 1
        wasm_gen_block_stmts(nd[2])
        wasm_block_depth = wasm_block_depth - 1
        wasm_indent = wasm_indent - 1
        if len(nd) > 3 {
            let else_nd = nd[3]
            if else_nd == 0 {
            } else {
                wi("else")
                wasm_indent = wasm_indent + 1
                wasm_block_depth = wasm_block_depth + 1
                let else_tag = ast_tag(else_nd)
                if else_tag == AST_BLOCK {
                    wasm_gen_block_stmts(else_nd)
                } else {
                    if else_tag == AST_IF_STMT {
                        wasm_gen_stmt(else_nd)
                    } else {
                        wasm_gen_block_stmts(else_nd)
                    }
                }
                wasm_block_depth = wasm_block_depth - 1
                wasm_indent = wasm_indent - 1
            }
        }
        wi("end")
        return 0
    }

    if tag == AST_WHILE_STMT {
        let save_break = wasm_break_depth
        let save_cont = wasm_continue_depth
        wi("block $brk" + int_to_str(cg_label_count))
        wi("loop $cont" + int_to_str(cg_label_count))
        wasm_indent = wasm_indent + 1
        wasm_break_depth = 1
        wasm_continue_depth = 0
        wasm_block_depth = wasm_block_depth + 2
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("br_if $brk" + int_to_str(cg_label_count))
        wasm_gen_block_stmts(nd[2])
        wi("br $cont" + int_to_str(cg_label_count))
        wasm_block_depth = wasm_block_depth - 2
        wasm_indent = wasm_indent - 1
        wi("end")
        wi("end")
        wasm_break_depth = save_break
        wasm_continue_depth = save_cont
        cg_label_count = cg_label_count + 1
        return 0
    }

    if tag == AST_FOR_STMT {
        let vname = nd[1]
        let iter_expr = nd[2]
        let body = nd[3]
        wasm_gen_expr(iter_expr)
        wasm_local_set("_for_iter")
        wi("i64.const 0")
        wasm_local_set("_for_idx")
        let save_break = wasm_break_depth
        let save_cont = wasm_continue_depth
        wi("block $brk" + int_to_str(cg_label_count))
        wi("loop $cont" + int_to_str(cg_label_count))
        wasm_indent = wasm_indent + 1
        wasm_break_depth = 1
        wasm_continue_depth = 0
        wasm_block_depth = wasm_block_depth + 2
        wasm_local_get("_for_idx")
        wasm_local_get("_for_iter")
        wi("call $len")
        wi("i64.ge_s")
        wi("br_if $brk" + int_to_str(cg_label_count))
        wasm_local_get("_for_iter")
        wasm_local_get("_for_idx")
        wi("call $rt_index")
        wasm_local_set(vname)
        wasm_gen_block_stmts(body)
        wasm_local_get("_for_idx")
        wi("i64.const 1")
        wi("i64.add")
        wasm_local_set("_for_idx")
        wi("br $cont" + int_to_str(cg_label_count))
        wasm_block_depth = wasm_block_depth - 2
        wasm_indent = wasm_indent - 1
        wi("end")
        wi("end")
        wasm_break_depth = save_break
        wasm_continue_depth = save_cont
        cg_label_count = cg_label_count + 1
        return 0
    }

    if tag == AST_RETURN_STMT {
        wasm_gen_expr(nd[1])
        wi("return")
        return 0
    }

    if tag == AST_BLOCK {
        wasm_gen_block_stmts(nd)
        return 0
    }

    if tag == AST_BREAK_STMT {
        wi("br $brk" + int_to_str(cg_label_count - 1))
        return 0
    }

    if tag == AST_CONTINUE_STMT {
        wi("br $cont" + int_to_str(cg_label_count - 1))
        return 0
    }

    if tag == AST_INDEX_ASSIGN {
        wasm_gen_expr(nd[1])
        wasm_gen_expr(nd[2])
        wasm_gen_expr(nd[3])
        wi("call $rt_index_set")
        wi("drop")
        return 0
    }

    if tag == AST_FN_DECL {
        return 0
    }
    if tag == AST_STRUCT_DECL {
        return 0
    }
    if tag == AST_ENUM_DECL {
        return 0
    }
    if tag == AST_METHOD_DECL {
        return 0
    }
    if tag == AST_MATCH_STMT {
        // R19B: statement-position match. Reuse the expression form and
        // drop the result (mirrors AST_EXPR_STMT but the body of the
        // chosen arm itself may have already produced no value).
        wasm_gen_expr(nd)
        wi("drop")
        return 0
    }

    return 0
}

fn wasm_gen_block_stmts(nd) {
    if ast_tag(nd) == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            wasm_gen_stmt(stmts[i])
            i = i + 1
        }
    } else {
        wasm_gen_stmt(nd)
    }
}

fn wasm_gen_function(d) {
    let fname = d[1]
    let params = d[2]
    let body = d[3]
    wasm_local_map = list_new()
    wasm_local_idx = 0
    let sig = "(func $" + fname
    let pi = 0
    while pi < len(params) {
        let pname = params[pi]
        if ast_tag(pname) == AST_DEFAULT_PARAM {
            pname = pname[1]
        }
        sig = sig + " (param $" + pname + " i64)"
        pi = pi + 1
    }
    sig = sig + " (result i64)"
    wasm_collect_locals(body)
    wi(sig)
    wasm_indent = wasm_indent + 1
    let li = 0
    while li < len(wasm_local_map) {
        wi("(local $" + wasm_local_map[li] + " i64)")
        li = li + 1
    }
    wi("(local $_for_iter i64)")
    wi("(local $_for_idx i64)")
    wasm_gen_block_stmts(body)
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

fn wasm_gen_rt_core() {
    // Memory allocator
    wi("(func $alloc (param $size i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i64)")
    wi("global.get $heap_ptr")
    wi("local.set $ptr")
    wi("global.get $heap_ptr")
    wi("local.get $size")
    wi("i64.add")
    wi("global.set $heap_ptr")
    wi("local.get $ptr")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_eq — compare two values (int or string)
    wi("(func $rt_eq (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("i64.const 1048576")
    wi("i64.lt_s")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.eq")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("call $rt_streq")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_streq — compare two null-terminated strings
    wi("(func $rt_streq (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ia i32)")
    wi("(local $ib i32)")
    wi("(local $ca i32)")
    wi("(local $cb i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.set $ia")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.set $ib")
    wi("block $done")
    wi("loop $cmp")
    wasm_indent = wasm_indent + 1
    wi("local.get $ia")
    wi("i32.load8_u")
    wi("local.set $ca")
    wi("local.get $ib")
    wi("i32.load8_u")
    wi("local.set $cb")
    wi("local.get $ca")
    wi("local.get $cb")
    wi("i32.ne")
    wi("if")
    wi("  i64.const 0")
    wi("  return")
    wi("end")
    wi("local.get $ca")
    wi("i32.eqz")
    wi("br_if $done")
    wi("local.get $ia")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ia")
    wi("local.get $ib")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ib")
    wi("br $cmp")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("i64.const 1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // str_eq — user-facing alias for rt_streq (the WASM dispatcher
    // routes calls to `str_eq(a, b)` via `call $str_eq`).
    wi("(func $str_eq (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("call $rt_streq")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_add — smart add (int add or string concat)
    wi("(func $rt_add (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("i64.const 1048576")
    wi("i64.lt_s")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.add")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("call $concat")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // strlen
    wi("(func $rt_strlen (param $s i32) (result i32)")
    wasm_indent = wasm_indent + 1
    wi("(local $n i32)")
    wi("block $done")
    wi("loop $cnt")
    wasm_indent = wasm_indent + 1
    wi("local.get $s")
    wi("local.get $n")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i32.eqz")
    wi("br_if $done")
    wi("local.get $n")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $n")
    wi("br $cnt")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $n")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // len — length of string or list
    wi("(func $len (param $v i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i64.const 1048576")
    wi("i64.lt_s")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i32.wrap_i64")
    wi("i64.load")
    wi("i64.const -1")
    wi("i64.eq")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.add")
    wi("i64.load")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i32.wrap_i64")
    wi("call $rt_strlen")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // concat — concatenate two strings
    wi("(func $concat (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $la i32)")
    wi("(local $lb i32)")
    wi("(local $dst i32)")
    wi("(local $i i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("call $rt_strlen")
    wi("local.set $la")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("call $rt_strlen")
    wi("local.set $lb")
    wi("local.get $la")
    wi("local.get $lb")
    wi("i32.add")
    wi("i32.const 1")
    wi("i32.add")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $dst")
    wi("i32.const 0")
    wi("local.set $i")
    wi("block $d1")
    wi("loop $c1")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $la")
    wi("i32.ge_u")
    wi("br_if $d1")
    wi("local.get $dst")
    wi("local.get $i")
    wi("i32.add")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.get $i")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i32.store8")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $c1")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("i32.const 0")
    wi("local.set $i")
    wi("block $d2")
    wi("loop $c2")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $lb")
    wi("i32.ge_u")
    wi("br_if $d2")
    wi("local.get $dst")
    wi("local.get $la")
    wi("i32.add")
    wi("local.get $i")
    wi("i32.add")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.get $i")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i32.store8")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $c2")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $dst")
    wi("local.get $la")
    wi("i32.add")
    wi("local.get $lb")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $dst")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

fn wasm_gen_rt_io() {
    // print — write string to stdout
    wi("(func $print (param $s i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i32)")
    wi("(local $slen i32)")
    wi("local.get $s")
    wi("i32.wrap_i64")
    wi("local.set $ptr")
    wi("local.get $ptr")
    wi("call $rt_strlen")
    wi("local.set $slen")
    wi("i32.const 0")
    wi("local.get $ptr")
    wi("i32.store")
    wi("i32.const 4")
    wi("local.get $slen")
    wi("i32.store")
    wi("i32.const 1")
    wi("i32.const 0")
    wi("i32.const 1")
    wi("i32.const 8")
    wi("call $fd_write")
    wi("drop")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // println — print + newline
    let nl_offset = wasm_add_str(chr(10))
    wi("(func $println (param $s i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $s")
    wi("call $print")
    wi("drop")
    wi("i64.const " + int_to_str(nl_offset))
    wi("call $print")
    wi("drop")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // int_to_str
    wi("(func $int_to_str (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $buf i32)")
    wi("(local $pos i32)")
    wi("(local $neg i32)")
    wi("(local $d i64)")
    wi("(local $tmp i64)")
    wi("i32.const 24")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $buf")
    wi("local.get $buf")
    wi("i32.const 20")
    wi("i32.add")
    wi("local.set $pos")
    wi("local.get $pos")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $n")
    wi("i64.const 0")
    wi("i64.lt_s")
    wi("if")
    wasm_indent = wasm_indent + 1
    wi("i32.const 1")
    wi("local.set $neg")
    wi("i64.const 0")
    wi("local.get $n")
    wi("i64.sub")
    wi("local.set $n")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("local.get $n")
    wi("i64.eqz")
    wi("if")
    wasm_indent = wasm_indent + 1
    wi("local.get $pos")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $pos")
    wi("local.get $pos")
    wi("i32.const 48")
    wi("i32.store8")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("block $done")
    wi("loop $digits")
    wasm_indent = wasm_indent + 1
    wi("local.get $n")
    wi("i64.eqz")
    wi("br_if $done")
    wi("local.get $n")
    wi("i64.const 10")
    wi("i64.rem_s")
    wi("local.set $d")
    wi("local.get $pos")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $pos")
    wi("local.get $pos")
    wi("local.get $d")
    wi("i32.wrap_i64")
    wi("i32.const 48")
    wi("i32.add")
    wi("i32.store8")
    wi("local.get $n")
    wi("i64.const 10")
    wi("i64.div_s")
    wi("local.set $n")
    wi("br $digits")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("local.get $neg")
    wi("if")
    wasm_indent = wasm_indent + 1
    wi("local.get $pos")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $pos")
    wi("local.get $pos")
    wi("i32.const 45")
    wi("i32.store8")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("local.get $pos")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // print_int
    wi("(func $print_int (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $n")
    wi("call $int_to_str")
    wi("call $print")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // assert
    let assert_msg = wasm_add_str("Assertion failed")
    let assert_sep = wasm_add_str(": ")
    wi("(func $assert (param $cond i64) (param $msg i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $cond")
    wi("i64.eqz")
    wi("if")
    wasm_indent = wasm_indent + 1
    wi("i64.const " + int_to_str(assert_msg))
    wi("call $print")
    wi("drop")
    wi("i64.const " + int_to_str(assert_sep))
    wi("call $print")
    wi("drop")
    wi("local.get $msg")
    wi("call $println")
    wi("drop")
    wi("i32.const 1")
    wi("call $proc_exit")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // list_new — allocate list header [magic=-1, count=0, cap=8, items_ptr]
    wi("(func $list_new (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $items i32)")
    wi("i64.const 32")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("i64.const 64")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $hdr")
    wi("i64.const -1")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i32.const 8")
    wi("i32.add")
    wi("i64.const 0")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i32.const 16")
    wi("i32.add")
    wi("i64.const 8")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("local.get $items")
    wi("i64.extend_i32_u")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // push — append value to list
    wi("(func $push (param $list i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $cnt i64)")
    wi("(local $items i32)")
    wi("local.get $list")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("local.get $hdr")
    wi("i32.const 8")
    wi("i32.add")
    wi("i64.load")
    wi("local.set $cnt")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("i64.load")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $items")
    wi("local.get $cnt")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("local.get $val")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i32.const 8")
    wi("i32.add")
    wi("local.get $cnt")
    wi("i64.const 1")
    wi("i64.add")
    wi("i64.store")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_index — list[i]
    wi("(func $rt_index (param $list i64) (param $idx i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $items i32)")
    wi("local.get $list")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("i64.load")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $items")
    wi("local.get $idx")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("i64.load")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_index_set — list[i] = val
    wi("(func $rt_index_set (param $list i64) (param $idx i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $items i32)")
    wi("local.get $list")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("i64.load")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $items")
    wi("local.get $idx")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("local.get $val")
    wi("i64.store")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_list_push — used by list literal codegen (pushes and returns list)
    wi("(func $rt_list_push (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $list i64)")
    wi("global.get $g__wasm_list_tmp")
    wi("local.set $list")
    wi("local.get $list")
    wi("local.get $val")
    wi("call $push")
