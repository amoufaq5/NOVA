    // --- R31A: sys_fcntl_setfl_nonblock(fd) -> 0 | -1 ---
    //
    // Sets O_NONBLOCK on a file descriptor. The two-syscall race-free
    // variant (F_GETFL then F_SETFL of GETFL|O_NONBLOCK) isn't needed
    // here because we own the fd from socket(2) onwards; a freshly
    // created TCP socket has flags == 0, so F_SETFL of just O_NONBLOCK
    // is correct and saves one syscall per dial. Win32 uses
    // ioctlsocket(s, FIONBIO, &one) which is the historical winsock
    // sibling of fcntl(F_SETFL, O_NONBLOCK).
