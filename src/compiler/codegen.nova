// Nova Compiler: x86-64 Code Generator
// Emits GAS Intel syntax assembly.
// Strategy: stack-based evaluation, variables on stack frame.
// Globals accessed via RIP-relative addressing in .bss.

let NL = chr(10)
let DQ = chr(34)
let cg_output = ""
let cg_label_count = 0
let cg_strings = 0
let cg_str_count = 0
let cg_locals = 0
let cg_local_count = 0
let cg_params = 0
let cg_param_count = 0
let cg_fns = 0
let cg_globals = 0
let cg_global_count = 0
let cg_break_label = ""
let cg_continue_label = ""
let cg_structs = 0
let cg_struct_count = 0

fn cg_init() {
    cg_output = ""
    cg_label_count = 0
    cg_strings = list_new()
    cg_str_count = 0
    cg_fns = list_new()
    cg_globals = list_new()
    cg_global_count = 0
    cg_structs = list_new()
    cg_struct_count = 0
}

fn out(s) {
    cg_output = cg_output + s + NL
}

fn out_label(name) {
    cg_output = cg_output + name + ":" + NL
}

fn new_label() {
    cg_label_count = cg_label_count + 1
    return ".L" + int_to_str(cg_label_count)
}

fn add_string(s) {
    let idx = cg_str_count
    push(cg_strings, s)
    cg_str_count = cg_str_count + 1
    return idx
}

fn add_global(name) {
    push(cg_globals, name)
    cg_global_count = cg_global_count + 1
}

fn is_global(name) {
    let i = 0
    while i < cg_global_count {
        if cg_globals[i] == name {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn local_offset(name) {
    let i = 0
    while i < cg_local_count {
        if cg_locals[i] == name {
            return (i + 1) * 8
        }
        i = i + 1
    }
    let j = 0
    while j < cg_param_count {
        if cg_params[j] == name {
            return (cg_local_count + j + 1) * 8
        }
        j = j + 1
    }
    push(cg_locals, name)
    cg_local_count = cg_local_count + 1
    return cg_local_count * 8
}

fn collect_locals(nd) {
    let tag = ast_tag(nd)
    if tag == AST_LET_STMT {
        let name = nd[1]
        if is_global(name) == 0 {
            push(cg_locals, name)
            cg_local_count = cg_local_count + 1
        }
    }
    if tag == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            collect_locals(stmts[i])
            i = i + 1
        }
    }
    if tag == AST_IF_STMT {
        collect_locals(nd[2])
        let else_cl = nd[3]
        if else_cl == 0 {
        } else {
            collect_locals(else_cl)
        }
    }
    if tag == AST_WHILE_STMT {
        collect_locals(nd[2])
    }
    if tag == AST_FOR_STMT {
        let var_name = nd[1]
        push(cg_locals, var_name)
        cg_local_count = cg_local_count + 1
        collect_locals(nd[3])
    }
}

fn struct_field_index(struct_name, field_name) {
    let i = 0
    while i < cg_struct_count {
        let s = cg_structs[i]
        if s[0] == struct_name {
            let fields = s[1]
            let j = 0
            while j < len(fields) {
                if fields[j] == field_name {
                    return j
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return 0 - 1
}

fn find_field_index(field_name) {
    let si = 0
    while si < cg_struct_count {
        let fields = cg_structs[si][1]
        let fi = 0
        while fi < len(fields) {
            if fields[fi] == field_name {
                return fi
            }
            fi = fi + 1
        }
        si = si + 1
    }
    return 0 - 1
}

fn is_struct_name(name) {
    let si = 0
    while si < cg_struct_count {
        if cg_structs[si][0] == name {
            return 1
        }
        si = si + 1
    }
    return 0
}

fn gen_expr(nd) {
    let tag = ast_tag(nd)

    if tag == AST_INT_LIT {
        out("    mov rax, " + int_to_str(nd[1]))
        return 0
    }

    if tag == AST_BOOL_LIT {
        out("    mov rax, " + int_to_str(nd[1]))
        return 0
    }

    if tag == AST_NONE_LIT {
        out("    xor eax, eax")
        return 0
    }

    if tag == AST_STR_LIT {
        let idx = add_string(nd[1])
        out("    lea rax, [rip + _str_" + int_to_str(idx) + "]")
        return 0
    }

    if tag == AST_IDENT {
        let name = nd[1]
        if is_global(name) == 1 {
            out("    mov rax, [rip + _g_" + name + "]")
        } else {
            let off = local_offset(name)
            out("    mov rax, [rbp - " + int_to_str(off) + "]")
        }
        return 0
    }

    if tag == AST_BIN_OP {
        let op = nd[1]
        gen_expr(nd[3])
        out("    push rax")
        gen_expr(nd[2])
        out("    pop rcx")
        if op == "+" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_add")
        }
        else { if op == "-" { out("    sub rax, rcx") }
        else { if op == "*" { out("    imul rax, rcx") }
        else { if op == "/" {
            out("    test rcx, rcx")
            out("    jz _div_zero_handler")
            out("    cqo")
            out("    idiv rcx")
        }
        else { if op == "%" {
            out("    test rcx, rcx")
            out("    jz _div_zero_handler")
            out("    cqo")
            out("    idiv rcx")
            out("    mov rax, rdx")
        }
        else { if op == "==" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_eq")
        }
        else { if op == "!=" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_neq")
        }
        else { if op == "<" {
            out("    cmp rax, rcx")
            out("    setl al")
            out("    movzx rax, al")
        }
        else { if op == ">" {
            out("    cmp rax, rcx")
            out("    setg al")
            out("    movzx rax, al")
        }
        else { if op == "<=" {
            out("    cmp rax, rcx")
            out("    setle al")
            out("    movzx rax, al")
        }
        else { if op == ">=" {
            out("    cmp rax, rcx")
            out("    setge al")
            out("    movzx rax, al")
        }
        else { if op == "&" {
            out("    and rax, rcx")
        }
        else { if op == "|" {
            out("    or rax, rcx")
        }
        else { if op == "^" {
            out("    xor rax, rcx")
        }
        else { if op == "<<" {
            out("    shl rax, cl")
        }
        else { if op == ">>" {
            out("    sar rax, cl")
        }
        else {
            out("    # unknown op: " + op)
        } } } } } } } } } } } } } } } }
        return 0
    }

    if tag == AST_UNARY_OP {
        let op = nd[1]
        gen_expr(nd[2])
        if op == "-" {
            out("    neg rax")
        }
        if op == "!" {
            out("    test rax, rax")
            out("    sete al")
            out("    movzx rax, al")
        }
        return 0
    }

    if tag == AST_CALL {
        let callee = nd[1]
        let args = nd[2]
        let argc = len(args)
        let callee_name = callee[1]
        if is_struct_name(callee_name) == 1 {
            // Struct constructor: create a list and push each arg
            out("    call _nova_list_new")
            out("    push rax")
            let ai = 0
            while ai < argc {
                gen_expr(args[ai])
                out("    mov rsi, rax")
                out("    mov rdi, [rsp]")
                out("    call _nova_push")
                ai = ai + 1
            }
            out("    pop rax")
            return 0
        }
        let i = argc - 1
        while i >= 0 {
            gen_expr(args[i])
            out("    push rax")
            i = i - 1
        }
        if argc > 0 { out("    pop rdi") }
        if argc > 1 { out("    pop rsi") }
        if argc > 2 { out("    pop rdx") }
        if argc > 3 { out("    pop rcx") }
        if argc > 4 { out("    pop r8") }
        if argc > 5 { out("    pop r9") }
        out("    call " + callee_name)
        return 0
    }

    if tag == AST_FIELD_ACCESS {
        let base = nd[1]
        let field_name = nd[2]
        let idx = find_field_index(field_name)
        gen_expr(base)
        out("    mov rcx, [rax + 24]")
        out("    mov rax, [rcx + " + int_to_str(idx * 8) + "]")
        return 0
    }

    if tag == AST_INDEX_EXPR {
        gen_expr(nd[2])
        out("    push rax")
        gen_expr(nd[1])
        out("    pop rcx")
        out("    mov rdi, rax")
        out("    mov rsi, rcx")
        out("    call _nova_index")
        return 0
    }

    if tag == AST_AND_EXPR {
        let end_lbl = new_label()
        gen_expr(nd[1])
        out("    test rax, rax")
        out("    jz " + end_lbl)
        gen_expr(nd[2])
        out("    test rax, rax")
        out("    jz " + end_lbl)
        out("    mov rax, 1")
        out_label(end_lbl)
        return 0
    }

    if tag == AST_OR_EXPR {
        let true_lbl = new_label()
        let end_lbl = new_label()
        gen_expr(nd[1])
        out("    test rax, rax")
        out("    jnz " + true_lbl)
        gen_expr(nd[2])
        out("    test rax, rax")
        out("    jnz " + true_lbl)
        out("    xor eax, eax")
        out("    jmp " + end_lbl)
        out_label(true_lbl)
        out("    mov rax, 1")
        out_label(end_lbl)
        return 0
    }

    out("    # unknown expr tag " + int_to_str(tag))
}

fn gen_stmt(nd) {
    let tag = ast_tag(nd)

    if tag == AST_LET_STMT {
        let name = nd[1]
        let value = nd[2]
        gen_expr(value)
        if is_global(name) == 1 {
            out("    mov [rip + _g_" + name + "], rax")
        } else {
            let off = local_offset(name)
            out("    mov [rbp - " + int_to_str(off) + "], rax")
        }
        return 0
    }

    if tag == AST_ASSIGN_STMT {
        let name = nd[1]
        let value = nd[2]
        gen_expr(value)
        if is_global(name) == 1 {
            out("    mov [rip + _g_" + name + "], rax")
        } else {
            let off = local_offset(name)
            out("    mov [rbp - " + int_to_str(off) + "], rax")
        }
        return 0
    }

    if tag == AST_RETURN_STMT {
        let value = nd[1]
        if value == 0 {
            out("    xor eax, eax")
        } else {
            gen_expr(value)
        }
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
        return 0
    }

    if tag == AST_IF_STMT {
        let cond = nd[1]
        let then_body = nd[2]
        let else_body = nd[3]
        let else_lbl = new_label()
        let end_lbl = new_label()
        gen_expr(cond)
        out("    test rax, rax")
        out("    jz " + else_lbl)
        gen_block(then_body)
        out("    jmp " + end_lbl)
        out_label(else_lbl)
        if else_body == 0 {
        } else {
            if ast_tag(else_body) == AST_IF_STMT {
                gen_stmt(else_body)
            } else {
                gen_block(else_body)
            }
        }
        out_label(end_lbl)
        return 0
    }

    if tag == AST_WHILE_STMT {
        let cond = nd[1]
        let body = nd[2]
        let loop_lbl = new_label()
        let end_lbl = new_label()
        let prev_break = cg_break_label
        let prev_continue = cg_continue_label
        cg_break_label = end_lbl
        cg_continue_label = loop_lbl
        out_label(loop_lbl)
        gen_expr(cond)
        out("    test rax, rax")
        out("    jz " + end_lbl)
        gen_block(body)
        out("    jmp " + loop_lbl)
        out_label(end_lbl)
        cg_break_label = prev_break
        cg_continue_label = prev_continue
        return 0
    }

    if tag == AST_FOR_STMT {
        let var_name = nd[1]
        let iter_expr = nd[2]
        let body = nd[3]
        let var_off = local_offset(var_name)

        // Check if iterator is range() call
        let is_range = 0
        if ast_tag(iter_expr) == AST_CALL {
            let callee = iter_expr[1]
            if ast_tag(callee) == AST_IDENT {
                if callee[1] == "range" {
                    is_range = 1
                }
            }
        }

        if is_range == 1 {
            let args = iter_expr[2]
            let argc = len(args)
            if argc == 1 {
                // range(end) - start=0
                out("    mov qword ptr [rbp - " + int_to_str(var_off) + "], 0")
                gen_expr(args[0])
                out("    push rax")
            } else {
                // range(start, end)
                gen_expr(args[0])
                out("    mov [rbp - " + int_to_str(var_off) + "], rax")
                gen_expr(args[1])
                out("    push rax")
            }
            let loop_lbl = new_label()
            let end_lbl = new_label()
            let cont_lbl = new_label()
            let prev_break = cg_break_label
            let prev_continue = cg_continue_label
            cg_break_label = end_lbl
            cg_continue_label = cont_lbl
            out_label(loop_lbl)
            out("    mov rax, [rbp - " + int_to_str(var_off) + "]")
            out("    cmp rax, [rsp]")
            out("    jge " + end_lbl)
            gen_block(body)
            out_label(cont_lbl)
            out("    inc qword ptr [rbp - " + int_to_str(var_off) + "]")
            out("    jmp " + loop_lbl)
            out_label(end_lbl)
            out("    add rsp, 8")
            cg_break_label = prev_break
            cg_continue_label = prev_continue
            return 0
        } else {
            gen_expr(iter_expr)
            out("    push rax")
            out("    push 0")
            let loop_lbl = new_label()
            let end_lbl = new_label()
            let cont_lbl = new_label()
            let prev_break = cg_break_label
            let prev_continue = cg_continue_label
            cg_break_label = end_lbl
            cg_continue_label = cont_lbl
            out_label(loop_lbl)
            out("    mov rcx, [rsp]")
            out("    mov rdi, [rsp+8]")
            out("    cmp rcx, [rdi+8]")
            out("    jge " + end_lbl)
            out("    mov rdi, [rdi+24]")
            out("    mov rax, [rdi+rcx*8]")
            out("    mov [rbp - " + int_to_str(var_off) + "], rax")
            gen_block(body)
            out_label(cont_lbl)
            out("    inc qword ptr [rsp]")
            out("    jmp " + loop_lbl)
            out_label(end_lbl)
            out("    add rsp, 16")
            cg_break_label = prev_break
            cg_continue_label = prev_continue
            return 0
        }
    }

    if tag == AST_EXPR_STMT {
        gen_expr(nd[1])
        return 0
    }

    if tag == AST_BREAK_STMT {
        out("    jmp " + cg_break_label)
        return 0
    }

    if tag == AST_CONTINUE_STMT {
        out("    jmp " + cg_continue_label)
        return 0
    }

    if tag == AST_INDEX_ASSIGN {
        let base = nd[1]
        let idx = nd[2]
        let value = nd[3]
        gen_expr(value)
        out("    push rax")
        gen_expr(idx)
        out("    push rax")
        gen_expr(base)
        out("    mov rcx, [rax + 24]")
        out("    pop rsi")
        out("    pop rdx")
        out("    mov [rcx + rsi*8], rdx")
        return 0
    }

    if tag == AST_FIELD_ASSIGN {
        let base = nd[1]
        let field_name = nd[2]
        let value = nd[3]
        let idx = find_field_index(field_name)
        gen_expr(value)
        out("    push rax")
        gen_expr(base)
        out("    mov rcx, [rax + 24]")
        out("    pop rdx")
        out("    mov [rcx + " + int_to_str(idx * 8) + "], rdx")
        return 0
    }

    if tag == AST_STRUCT_DECL {
        // Struct declarations are handled in gen_program first pass
        return 0
    }

    if tag == AST_BLOCK {
        gen_block(nd)
        return 0
    }

    out("    # unknown stmt tag " + int_to_str(tag))
}

fn escape_for_asm(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 10 { result = result + "\\n" }
        else { if c == 9 { result = result + "\\t" }
        else { if c == 92 { result = result + "\\\\" }
        else { if c == 34 { result = result + "\\\"" }
        else { if c == 0 { result = result + "\\0" }
        else { result = result + chr(c) }
        } } } }
        i = i + 1
    }
    return result
}

fn gen_block(nd) {
    let stmts = nd[1]
    let i = 0
    while i < len(stmts) {
        gen_stmt(stmts[i])
        i = i + 1
    }
}

fn gen_function(nd) {
    let name = nd[1]
    let params = nd[2]
    let body = nd[3]

    cg_locals = list_new()
    cg_local_count = 0
    cg_params = params
    cg_param_count = len(params)

    let pi = 0
    while pi < cg_param_count {
        push(cg_locals, params[pi])
        cg_local_count = cg_local_count + 1
        pi = pi + 1
    }

    collect_locals(body)

    out("")
    out(".globl " + name)
    out_label(name)
    out("    push rbp")
    out("    mov rbp, rsp")
    let frame_size = cg_local_count * 8
    if frame_size % 16 != 0 {
        frame_size = frame_size + (16 - (frame_size % 16))
    }
    if frame_size > 0 {
        out("    sub rsp, " + int_to_str(frame_size))
    }

    if cg_param_count > 0 { out("    mov [rbp - 8], rdi") }
    if cg_param_count > 1 { out("    mov [rbp - 16], rsi") }
    if cg_param_count > 2 { out("    mov [rbp - 24], rdx") }
    if cg_param_count > 3 { out("    mov [rbp - 32], rcx") }
    if cg_param_count > 4 { out("    mov [rbp - 40], r8") }
    if cg_param_count > 5 { out("    mov [rbp - 48], r9") }

    gen_block(body)

    out("    xor eax, eax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")
}

fn gen_program(program) {
    let decls = program[1]

    // First pass: collect struct declarations
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_STRUCT_DECL {
            let entry = list_new()
            push(entry, d[1])
            push(entry, d[2])
            push(cg_structs, entry)
            cg_struct_count = cg_struct_count + 1
        }
        i = i + 1
    }

    // Collect globals (top-level let declarations)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_LET_STMT {
            add_global(d[1])
        }
        i = i + 1
    }

    // Collect function names
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            push(cg_fns, d[1])
        }
        i = i + 1
    }

    out(".intel_syntax noprefix")
    out(".text")

    // Generate functions
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            gen_function(d)
        }
        i = i + 1
    }

    // Generate _start for top-level code
    cg_locals = list_new()
    cg_local_count = 0
    cg_params = list_new()
    cg_param_count = 0

    // Collect top-level locals (non-global let inside if/while)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dtag = ast_tag(d)
        if dtag == AST_IF_STMT {
            collect_locals(d)
        }
        if dtag == AST_WHILE_STMT {
            collect_locals(d)
        }
        if dtag == AST_FOR_STMT {
            collect_locals(d)
        }
        i = i + 1
    }

    out("")
    out(".globl _start")
    out_label("_start")
    out("    mov rdi, [rsp]")
    out("    lea rsi, [rsp + 8]")
    out("    mov [rip + _g___argc], rdi")
    out("    mov [rip + _g___argv], rsi")
    // envp is after argv: at rsp + 8 + (argc+1)*8
    out("    mov rax, rdi")
    out("    inc rax")
    out("    lea rax, [rsp + 8 + rax*8]")
    out("    mov [rip + _g___envp], rax")
    out("    push rbp")
    out("    mov rbp, rsp")
    let frame_size = cg_local_count * 8
    if frame_size % 16 != 0 {
        frame_size = frame_size + (16 - (frame_size % 16))
    }
    if frame_size > 0 {
        out("    sub rsp, " + int_to_str(frame_size))
    }

    // Generate top-level statements (skip function declarations)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
        } else {
            gen_stmt(d)
        }
        i = i + 1
    }

    out("    mov rdi, 0")
    out("    mov rax, 60")
    out("    syscall")

    // Emit string data section
    out("")
    out(".section .rodata")
    i = 0
    while i < cg_str_count {
        out_label("_str_" + int_to_str(i))
        out("    .asciz " + DQ + escape_for_asm(cg_strings[i]) + DQ)
        i = i + 1
    }

    // Emit globals in .bss
    out("")
    out(".section .bss")
    // Always add argc/argv globals
    out("    .align 8")
    out_label("_g___argc")
    out("    .quad 0")
    out_label("_g___argv")
    out("    .quad 0")
    out_label("_g___envp")
    out("    .quad 0")
    i = 0
    while i < cg_global_count {
        out("    .align 8")
        out_label("_g_" + cg_globals[i])
        out("    .quad 0")
        i = i + 1
    }

    // Emit runtime library
    out("")
    out(".text")
    gen_runtime()

    return cg_output
}

fn gen_runtime() {
    // --- Smart add: integer add or string concat ---
    out_label("_nova_add")
    out("    cmp rdi, 4096")
    out("    jl .add_int")
    out("    cmp rsi, 4096")
    out("    jl .add_int")
    out("    jmp _nova_concat")
    out(".add_int:")
    out("    lea rax, [rdi + rsi]")
    out("    ret")

    // --- Smart equality: integer or string ---
    out("")
    out_label("_nova_eq")
    out("    cmp rdi, rsi")
    out("    je .eq_true")
    out("    cmp rdi, 4096")
    out("    jl .eq_false")
    out("    cmp rsi, 4096")
    out("    jl .eq_false")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_str_eq")
    out("    pop rbp")
    out("    ret")
    out(".eq_true:")
    out("    mov eax, 1")
    out("    ret")
    out(".eq_false:")
    out("    xor eax, eax")
    out("    ret")

    // --- Smart not-equal ---
    out("")
    out_label("_nova_neq")
    out("    cmp rdi, rsi")
    out("    je .neq_false")
    out("    cmp rdi, 4096")
    out("    jl .neq_true")
    out("    cmp rsi, 4096")
    out("    jl .neq_true")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_str_eq")
    out("    xor eax, 1")
    out("    pop rbp")
    out("    ret")
    out(".neq_true:")
    out("    mov eax, 1")
    out("    ret")
    out(".neq_false:")
    out("    xor eax, eax")
    out("    ret")

    // --- print_int ---
    out("")
    out_label("_nova_print_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rsi, rdi")
    out("    test rsi, rsi")
    out("    jnz .pi_nonzero")
    out("    mov byte ptr [rbp-1], 48")
    out("    lea rsi, [rbp-1]")
    out("    mov rdx, 1")
    out("    jmp .pi_write")
    out(".pi_nonzero:")
    out("    lea rdi, [rbp-1]")
    out("    xor ecx, ecx")
    out("    mov rax, rsi")
    out("    test rax, rax")
    out("    jns .pi_pos")
    out("    neg rax")
    out("    mov cl, 1")
    out(".pi_pos:")
    out(".pi_loop:")
    out("    test rax, rax")
    out("    jz .pi_done_digits")
    out("    xor edx, edx")
    out("    mov r8, 10")
    out("    div r8")
    out("    add dl, 48")
    out("    mov [rdi], dl")
    out("    dec rdi")
    out("    jmp .pi_loop")
    out(".pi_done_digits:")
    out("    test cl, cl")
    out("    jz .pi_no_sign")
    out("    mov byte ptr [rdi], 45")
    out("    dec rdi")
    out(".pi_no_sign:")
    out("    inc rdi")
    out("    lea rdx, [rbp-1]")
    out("    sub rdx, rdi")
    out("    inc rdx")
    out("    mov rsi, rdi")
    out(".pi_write:")
    out("    mov rdi, 1")
    out("    mov rax, 1")
    out("    syscall")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- print_str ---
    out("")
    out_label("_nova_print_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rsi, rdi")
    out("    xor edx, edx")
    out(".ps_len:")
    out("    cmp byte ptr [rsi + rdx], 0")
    out("    je .ps_write")
    out("    inc edx")
    out("    jmp .ps_len")
    out(".ps_write:")
    out("    mov rdi, 1")
    out("    mov rax, 1")
    out("    syscall")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- println (print string + newline) ---
    out("")
    out_label("_nova_println")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rdi")
    out("    call _nova_print_str")
    out("    sub rsp, 8")
    out("    mov byte ptr [rsp], 10")
    out("    mov rsi, rsp")
    out("    mov rdx, 1")
    out("    mov rdi, 1")
    out("    mov rax, 1")
    out("    syscall")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- Heap allocator (brk-based bump allocator) ---
    out("")
    out_label("_nova_alloc")
    out("    push rbx")
    out("    mov rbx, rdi")
    out("    add rbx, 7")
    out("    and rbx, -8")
    out("    mov rax, [rip + _heap_ptr]")
    out("    test rax, rax")
    out("    jnz .alloc_have_heap")
    out("    mov rdi, 0")
    out("    mov rax, 12")
    out("    syscall")
    out("    mov [rip + _heap_base], rax")
    out("    mov [rip + _heap_ptr], rax")
    out("    lea rdi, [rax + 1048576]")
    out("    mov rax, 12")
    out("    syscall")
    out("    mov [rip + _heap_end], rax")
    out("    mov rax, [rip + _heap_ptr]")
    out(".alloc_have_heap:")
    out("    mov rcx, rax")
    out("    add rcx, rbx")
    out("    cmp rcx, [rip + _heap_end]")
    out("    jle .alloc_ok")
    out("    lea rdi, [rcx + 1048576]")
    out("    mov rax, 12")
    out("    syscall")
    out("    mov [rip + _heap_end], rax")
    out("    mov rax, [rip + _heap_ptr]")
    out("    mov rcx, rax")
    out("    add rcx, rbx")
    out(".alloc_ok:")
    out("    mov [rip + _heap_ptr], rcx")
    out("    pop rbx")
    out("    ret")

    // --- strlen ---
    out("")
    out_label("_nova_strlen")
    out("    xor eax, eax")
    out("    test rdi, rdi")
    out("    jz .sl_done")
    out(".sl_loop:")
    out("    cmp byte ptr [rdi + rax], 0")
    out("    je .sl_done")
    out("    inc rax")
    out("    jmp .sl_loop")
    out(".sl_done:")
    out("    ret")

    // --- concat(a, b) -> new string ---
    out("")
    out_label("_nova_concat")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov r14, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    add r14, rax")
    out("    inc r14")
    out("    mov rdi, r14")
    out("    call _nova_alloc")
    out("    mov r14, rax")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out(".cc_copy1:")
    out("    lodsb")
    out("    test al, al")
    out("    jz .cc_copy2")
    out("    stosb")
    out("    jmp .cc_copy1")
    out(".cc_copy2:")
    out("    mov rsi, r13")
    out(".cc_copy2_loop:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .cc_copy2_loop")
    out("    mov rax, r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- int_to_str(n) -> string ---
    out("")
    out_label("_nova_int_to_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rax, rdi")
    out("    lea rsi, [rbp-1]")
    out("    mov byte ptr [rsi], 0")
    out("    xor ecx, ecx")
    out("    test rax, rax")
    out("    jnz .its_nonzero")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    jmp .its_copy")
    out(".its_nonzero:")
    out("    jns .its_pos")
    out("    neg rax")
    out("    mov cl, 1")
    out(".its_pos:")
    out(".its_digit_loop:")
    out("    test rax, rax")
    out("    jz .its_sign")
    out("    xor edx, edx")
    out("    mov r8, 10")
    out("    div r8")
    out("    add dl, 48")
    out("    dec rsi")
    out("    mov [rsi], dl")
    out("    jmp .its_digit_loop")
    out(".its_sign:")
    out("    test cl, cl")
    out("    jz .its_copy")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 45")
    out(".its_copy:")
    out("    mov rdi, rsi")
    out("    call _nova_strlen")
    out("    inc rax")
    out("    mov r12, rdi")
    out("    mov rdi, rax")
    out("    push r12")
    out("    call _nova_alloc")
    out("    pop rsi")
    out("    mov rdi, rax")
    out("    push rax")
    out(".its_cp:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .its_cp")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- str_eq(a, b) -> 1 or 0 ---
    out("")
    out_label("_nova_str_eq")
    out("    xor eax, eax")
    out(".se_loop:")
    out("    mov cl, [rdi]")
    out("    cmp cl, [rsi]")
    out("    jne .se_done")
    out("    test cl, cl")
    out("    jz .se_equal")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .se_loop")
    out(".se_equal:")
    out("    mov eax, 1")
    out(".se_done:")
    out("    ret")

    // --- list_new() -> ptr to [count, cap, items_ptr] ---
    out("")
    // List layout: [MAGIC=-1, count, cap, items_ptr] (32 bytes)
    out_label("_nova_list_new")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rdi, 32")
    out("    call _nova_alloc")
    out("    mov qword ptr [rax], -1")
    out("    mov qword ptr [rax+8], 0")
    out("    mov qword ptr [rax+16], 16")
    out("    push rax")
    out("    mov rdi, 128")
    out("    call _nova_alloc")
    out("    pop rcx")
    out("    mov [rcx+24], rax")
    out("    mov rax, rcx")
    out("    pop rbp")
    out("    ret")

    // --- push(list, val) --- list=[magic, count, cap, items]
    out("")
    out_label("_nova_push")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rax, [rdi+8]")
    out("    cmp rax, [rdi+16]")
    out("    jl .push_ok")
    out("    push rdi")
    out("    push rsi")
    out("    mov rcx, [rdi+16]")
    out("    shl rcx, 1")
    out("    mov [rdi+16], rcx")
    out("    shl rcx, 3")
    out("    push rdi")
    out("    mov rdi, rcx")
    out("    call _nova_alloc")
    out("    pop rdi")
    out("    mov rcx, rax")
    out("    mov r8, [rdi+24]")
    out("    mov r9, [rdi+8]")
    out("    xor r10d, r10d")
    out(".push_copy:")
    out("    cmp r10, r9")
    out("    jge .push_copy_done")
    out("    mov r11, [r8+r10*8]")
    out("    mov [rcx+r10*8], r11")
    out("    inc r10")
    out("    jmp .push_copy")
    out(".push_copy_done:")
    out("    mov [rdi+24], rcx")
    out("    pop rsi")
    out("    pop rdi")
    out(".push_ok:")
    out("    mov rax, [rdi+8]")
    out("    mov rcx, [rdi+24]")
    out("    mov [rcx+rax*8], rsi")
    out("    inc qword ptr [rdi+8]")
    out("    pop rbp")
    out("    ret")

    // --- len(list_or_str) -> count ---
    out("")
    out_label("_nova_len")
    out("    test rdi, rdi")
    out("    jz .len_zero")
    out("    cmp qword ptr [rdi], -1")
    out("    je .len_list")
    out("    xor eax, eax")
    out(".len_str_loop:")
    out("    cmp byte ptr [rdi + rax], 0")
    out("    je .len_done")
    out("    inc rax")
    out("    jmp .len_str_loop")
    out(".len_list:")
    out("    mov rax, [rdi+8]")
    out(".len_done:")
    out("    ret")
    out(".len_zero:")
    out("    xor eax, eax")
    out("    ret")

    // --- exit(code) ---
    out("")
    out_label("_nova_exit")
    out("    mov rax, 60")
    out("    syscall")

    // --- read_file(path) -> string ptr or 0 ---
    out("")
    out_label("_nova_read_file")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    mov rax, 2")
    out("    mov rsi, 0")
    out("    syscall")
    out("    cmp rax, 0")
    out("    jl .rf_fail")
    out("    mov r12, rax")
    out("    mov rdi, 262144")
    out("    call _nova_alloc")
    out("    push rax")
    out("    mov rdi, r12")
    out("    mov rsi, rax")
    out("    mov rdx, 262143")
    out("    mov rax, 0")
    out("    syscall")
    out("    pop rsi")
    out("    mov byte ptr [rsi+rax], 0")
    out("    mov rdi, r12")
    out("    push rsi")
    out("    mov rax, 3")
    out("    syscall")
    out("    pop rax")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".rf_fail:")
    out("    xor eax, eax")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- write_file(path, data) -> 1 or 0 ---
    out("")
    out_label("_nova_write_file")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r13, rsi")
    out("    mov rax, 2")
    out("    mov rsi, 577")
    out("    mov rdx, 420")
    out("    syscall")
    out("    cmp rax, 0")
    out("    jl .wf_fail")
    out("    mov r12, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    mov rdx, rax")
    out("    mov rdi, r12")
    out("    mov rsi, r13")
    out("    mov rax, 1")
    out("    syscall")
    out("    mov rdi, r12")
    out("    mov rax, 3")
    out("    syscall")
    out("    mov rax, 1")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".wf_fail:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- index(obj, idx): list[idx] or str[idx] -> char code ---
    out("")
    out_label("_nova_index")
    out("    test rdi, rdi")
    out("    jz .idx_null")
    out("    cmp qword ptr [rdi], -1")
    out("    je .idx_list")
    out("    // String access - basic null check, no length check for perf")
    out("    cmp rsi, 0")
    out("    jl .idx_oob")
    out("    movzx eax, byte ptr [rdi + rsi]")
    out("    ret")
    out(".idx_list:")
    out("    // Handle negative index")
    out("    test rsi, rsi")
    out("    jns .idx_list_positive")
    out("    add rsi, [rdi + 8]")
    out("    test rsi, rsi")
    out("    jl .idx_oob")
    out(".idx_list_positive:")
    out("    cmp rsi, [rdi + 8]")
    out("    jge .idx_oob")
    out("    mov rax, [rdi + 24]")
    out("    mov rax, [rax + rsi*8]")
    out("    ret")
    out(".idx_null:")
    out("    lea rdi, [rip + _err_null_access]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    mov rax, 60")
    out("    syscall")
    out(".idx_oob:")
    out("    push rsi")
    out("    lea rdi, [rip + _err_index_oob]")
    out("    call _nova_print_str")
    out("    pop rdi")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _err_newline]")
    out("    call _nova_print_str")
    out("    mov rdi, 1")
    out("    mov rax, 60")
    out("    syscall")

    // --- chr(code) -> 1-char string ---
    out("")
    out_label("_nova_chr")
    out("    push rdi")
    out("    mov rdi, 2")
    out("    call _nova_alloc")
    out("    pop rcx")
    out("    mov [rax], cl")
    out("    mov byte ptr [rax+1], 0")
    out("    ret")

    // --- char_at(str, idx) -> char code ---
    out("")
    out_label("_nova_char_at")
    out("    movzx eax, byte ptr [rdi + rsi]")
    out("    ret")

    // --- substr(str, start, len) -> new string ---
    out("")
    out_label("_nova_substr")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    lea r12, [rdi + rsi]")
    out("    mov r13, rdx")
    out("    lea rdi, [rdx + 1]")
    out("    call _nova_alloc")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out("    mov rcx, r13")
    out("    rep movsb")
    out("    mov byte ptr [rdi], 0")
    out("    sub rdi, r13")
    out("    mov rax, rdi")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_to_int(str) -> int ---
    out("")
    out_label("_nova_str_to_int")
    out("    xor eax, eax")
    out("    xor ecx, ecx")
    out("    cmp byte ptr [rdi], 45")
    out("    jne .sti_loop")
    out("    mov cl, 1")
    out("    inc rdi")
    out(".sti_loop:")
    out("    movzx edx, byte ptr [rdi]")
    out("    sub edx, 48")
    out("    cmp edx, 9")
    out("    ja .sti_done")
    out("    imul rax, 10")
    out("    add rax, rdx")
    out("    inc rdi")
    out("    jmp .sti_loop")
    out(".sti_done:")
    out("    test cl, cl")
    out("    jz .sti_ret")
    out("    neg rax")
    out(".sti_ret:")
    out("    ret")

    // --- __arg(n) -> string or "" ---
    out("")
    out_label("_nova___arg")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    inc rdi")
    out("    cmp rdi, [rip + _g___argc]")
    out("    jge .arg_empty")
    out("    mov rax, [rip + _g___argv]")
    out("    mov rax, [rax + rdi*8]")
    out("    pop rbp")
    out("    ret")
    out(".arg_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop rbp")
    out("    ret")

    // --- pop(list) -> removes and returns last element ---
    out("")
    out_label("_nova_pop")
    out("    mov rax, [rdi+8]")
    out("    test rax, rax")
    out("    jz .pop_empty")
    out("    dec rax")
    out("    mov [rdi+8], rax")
    out("    mov rcx, [rdi+24]")
    out("    mov rax, [rcx+rax*8]")
    out("    ret")
    out(".pop_empty:")
    out("    xor eax, eax")
    out("    ret")

    // --- list_set(list, idx, val) -> sets list[idx] = val ---
    out("")
    out_label("_nova_list_set")
    out("    mov rax, [rdi+24]")
    out("    mov [rax+rsi*8], rdx")
    out("    ret")

    // --- contains(list, val) -> 1 if found, 0 if not ---
    out("")
    out_label("_nova_contains")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, [rdi+8]")
    out("    xor ecx, ecx")
    out(".contains_loop:")
    out("    cmp rcx, r14")
    out("    jge .contains_not_found")
    out("    mov rax, [r12+24]")
    out("    mov rdi, [rax+rcx*8]")
    out("    mov rsi, r13")
    out("    push rcx")
    out("    call _nova_eq")
    out("    pop rcx")
    out("    test rax, rax")
    out("    jnz .contains_found")
    out("    inc rcx")
    out("    jmp .contains_loop")
    out(".contains_found:")
    out("    mov eax, 1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".contains_not_found:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_remove(list, idx) -> removes element at idx, shifts remaining left ---
    out("")
    out_label("_nova_list_remove")
    out("    mov rax, [rdi+8]")
    out("    mov rcx, [rdi+24]")
    out("    mov r8, rsi")
    out(".lr_shift:")
    out("    lea r9, [r8+1]")
    out("    cmp r9, rax")
    out("    jge .lr_done")
    out("    mov r10, [rcx+r9*8]")
    out("    mov [rcx+r8*8], r10")
    out("    inc r8")
    out("    jmp .lr_shift")
    out(".lr_done:")
    out("    dec qword ptr [rdi+8]")
    out("    ret")

    // --- starts_with(str, prefix) -> 1 or 0 ---
    out("")
    out_label("_nova_starts_with")
    out("    xor eax, eax")
    out(".sw_loop:")
    out("    mov cl, [rsi]")
    out("    test cl, cl")
    out("    jz .sw_yes")
    out("    cmp cl, [rdi]")
    out("    jne .sw_no")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .sw_loop")
    out(".sw_yes:")
    out("    mov eax, 1")
    out(".sw_no:")
    out("    ret")

    // --- ends_with(str, suffix) -> 1 or 0 ---
    out("")
    out_label("_nova_ends_with")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov rcx, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    cmp rax, rcx")
    out("    ja .ew_no")
    out("    lea rdi, [r12+rcx]")
    out("    sub rdi, rax")
    out("    mov rsi, r13")
    out(".ew_loop:")
    out("    mov cl, [rsi]")
    out("    test cl, cl")
    out("    jz .ew_yes")
    out("    cmp cl, [rdi]")
    out("    jne .ew_no")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .ew_loop")
    out(".ew_yes:")
    out("    mov eax, 1")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ew_no:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_find(haystack, needle) -> index or -1 ---
    out("")
    out_label("_nova_str_find")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov r14, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    mov rcx, rax")
    out("    test rcx, rcx")
    out("    jz .sf_found_zero")
    out("    xor r8d, r8d")
    out(".sf_outer:")
    out("    lea rax, [r8+rcx]")
    out("    cmp rax, r14")
    out("    ja .sf_not_found")
    out("    xor r9d, r9d")
    out(".sf_inner:")
    out("    cmp r9, rcx")
    out("    jge .sf_found")
    out("    lea rax, [r12+r8]")
    out("    movzx edx, byte ptr [rax+r9]")
    out("    cmp dl, [r13+r9]")
    out("    jne .sf_next")
    out("    inc r9")
    out("    jmp .sf_inner")
    out(".sf_next:")
    out("    inc r8")
    out("    jmp .sf_outer")
    out(".sf_found:")
    out("    mov rax, r8")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".sf_found_zero:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".sf_not_found:")
    out("    mov rax, -1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- abs(n) -> absolute value ---
    out("")
    out_label("_nova_abs")
    out("    mov rax, rdi")
    out("    test rdi, rdi")
    out("    jns .abs_done")
    out("    neg rax")
    out(".abs_done:")
    out("    ret")

    // --- min(a, b) -> smaller value ---
    out("")
    out_label("_nova_min")
    out("    cmp rdi, rsi")
    out("    cmovle rax, rdi")
    out("    cmovg rax, rsi")
    out("    ret")

    // --- max(a, b) -> larger value ---
    out("")
    out_label("_nova_max")
    out("    cmp rdi, rsi")
    out("    cmovge rax, rdi")
    out("    cmovl rax, rsi")
    out("    ret")

    // --- time() -> current epoch seconds ---
    out("")
    out_label("_nova_time")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    out("    xor edi, edi")
    out("    lea rsi, [rbp - 16]")
    out("    mov rax, 228")
    out("    syscall")
    out("    mov rax, [rbp - 16]")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- sleep_ms(milliseconds) -> 0 ---
    out("")
    out_label("_nova_sleep_ms")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rax, rdi")
    out("    xor edx, edx")
    out("    mov rcx, 1000")
    out("    div rcx")
    out("    mov [rbp - 16], rax")
    out("    imul rdx, rdx, 1000000")
    out("    mov [rbp - 8], rdx")
    out("    lea rdi, [rbp - 16]")
    out("    xor esi, esi")
    out("    mov rax, 35")
    out("    syscall")
    out("    xor eax, eax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- mkdir(path) -> 0 on success, -1 on error ---
    out("")
    out_label("_nova_mkdir")
    out("    mov rax, 83")
    out("    mov rsi, 493")
    out("    syscall")
    out("    ret")

    // --- unlink(path) -> 0 on success, -1 on error ---
    out("")
    out_label("_nova_unlink")
    out("    mov rax, 87")
    out("    syscall")
    out("    ret")

    // --- file_size(path) -> size in bytes or -1 ---
    out("")
    out_label("_nova_file_size")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 160")
    out("    mov rax, 4")
    out("    lea rsi, [rbp - 160]")
    out("    syscall")
    out("    cmp rax, 0")
    out("    jl .fs_fail")
    out("    mov rax, [rbp - 160 + 48]")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")
    out(".fs_fail:")
    out("    mov rax, -1")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- socket(domain, type, protocol) -> fd ---
    out("")
    out_label("_nova_socket")
    out("    mov rax, 41")
    out("    syscall")
    out("    ret")

    // --- bind(fd, addr, addrlen) -> 0 or error ---
    out("")
    out_label("_nova_bind")
    out("    mov rax, 49")
    out("    syscall")
    out("    ret")

    // --- listen(fd, backlog) -> 0 or error ---
    out("")
    out_label("_nova_listen")
    out("    mov rax, 50")
    out("    syscall")
    out("    ret")

    // --- accept(fd, addr, addrlen) -> new fd ---
    out("")
    out_label("_nova_accept")
    out("    mov rax, 43")
    out("    syscall")
    out("    ret")

    // --- connect(fd, addr, addrlen) -> 0 or error ---
    out("")
    out_label("_nova_connect")
    out("    mov rax, 42")
    out("    syscall")
    out("    ret")

    // --- send_data(fd, buf, len) -> bytes sent ---
    out("")
    out_label("_nova_send_data")
    out("    mov rax, 1")
    out("    syscall")
    out("    ret")

    // --- recv_data(fd, buf, len) -> bytes received ---
    out("")
    out_label("_nova_recv_data")
    out("    mov rax, 0")
    out("    syscall")
    out("    ret")

    // --- close_fd(fd) -> 0 or error ---
    out("")
    out_label("_nova_close_fd")
    out("    mov rax, 3")
    out("    syscall")
    out("    ret")

    // --- make_sockaddr_in(port, ip_addr) -> pointer to sockaddr_in struct ---
    out("")
    out_label("_nova_make_sockaddr_in")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rdi, 16")
    out("    call _nova_alloc")
    out("    mov word ptr [rax], 2")
    out("    mov rcx, r12")
    out("    xchg cl, ch")
    out("    mov [rax + 2], cx")
    out("    mov [rax + 4], r13d")
    out("    mov qword ptr [rax + 8], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- fork() -> pid (0 in child, >0 in parent) ---
    out("")
    out_label("_nova_fork")
    out("    mov rax, 57")
    out("    syscall")
    out("    ret")

    // --- waitpid(pid) -> exit status ---
    out("")
    out_label("_nova_waitpid")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    out("    lea rsi, [rbp - 8]")
    out("    xor edx, edx")
    out("    mov rax, 61")
    out("    xor r10d, r10d")
    out("    syscall")
    out("    mov eax, [rbp - 8]")
    out("    shr eax, 8")
    out("    and eax, 255")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- exec(path, argv) -> doesn't return on success ---
    out("")
    out_label("_nova_exec")
    out("    mov rdx, 0")
    out("    mov rax, 59")
    out("    syscall")
    out("    ret")

    // --- pipe() -> list of [read_fd, write_fd] ---
    out("")
    out_label("_nova_pipe")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    out("    lea rdi, [rbp - 8]")
    out("    mov rax, 22")
    out("    syscall")
    out("    call _nova_list_new")
    out("    push rax")
    out("    mov edi, [rbp - 8]")
    out("    movsx rdi, edi")
    out("    mov rsi, rdi")
    out("    mov rdi, [rsp]")
    out("    call _nova_push")
    out("    mov edi, [rbp - 4]")
    out("    movsx rdi, edi")
    out("    mov rsi, rdi")
    out("    mov rdi, [rsp]")
    out("    call _nova_push")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- Division by zero handler ---
    out("")
    out_label("_div_zero_handler")
    out("    lea rdi, [rip + _err_div_zero]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    mov rax, 60")
    out("    syscall")

    // --- assert(condition, message) ---
    out("")
    out_label("_nova_assert")
    out("    test rdi, rdi")
    out("    jnz .assert_ok")
    out("    push rsi")
    out("    lea rdi, [rip + _err_assert_prefix]")
    out("    call _nova_print_str")
    out("    pop rdi")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    mov rax, 60")
    out("    syscall")
    out(".assert_ok:")
    out("    ret")

    // --- type_of(value) -> int (0=null, 1=int, 2=string, 3=list) ---
    out("")
    out_label("_nova_type_of")
    out("    test rdi, rdi")
    out("    jz .to_null")
    out("    cmp rdi, 4096")
    out("    jl .to_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .to_list")
    out("    mov eax, 2")
    out("    ret")
    out(".to_null:")
    out("    xor eax, eax")
    out("    ret")
    out(".to_int:")
    out("    mov eax, 1")
    out("    ret")
    out(".to_list:")
    out("    mov eax, 3")
    out("    ret")

    // --- debug_print(label, value) ---
    out("")
    out_label("_nova_debug_print")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    mov r12, rsi")
    out("    call _nova_print_str")
    out("    lea rdi, [rip + _debug_sep]")
    out("    call _nova_print_str")
    out("    mov rdi, r12")
    out("    test rdi, rdi")
    out("    jz .dp_null")
    out("    cmp rdi, 4096")
    out("    jl .dp_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .dp_list")
    out("    call _nova_println")
    out("    jmp .dp_done")
    out(".dp_null:")
    out("    lea rdi, [rip + _debug_null]")
    out("    call _nova_println")
    out("    jmp .dp_done")
    out(".dp_int:")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _err_newline]")
    out("    call _nova_print_str")
    out("    jmp .dp_done")
    out(".dp_list:")
    out("    lea rdi, [rip + _debug_list_prefix]")
    out("    call _nova_print_str")
    out("    mov rdi, r12")
    out("    mov rdi, [rdi + 8]")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _debug_list_suffix]")
    out("    call _nova_println")
    out(".dp_done:")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- hex(n) -> hex string with "0x" prefix ---
    out("")
    out_label("_nova_hex")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rax, rdi")
    out("    lea rsi, [rbp - 1]")
    out("    mov byte ptr [rsi], 0")
    out("    test rax, rax")
    out("    jnz .hex_nonzero")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    jmp .hex_prefix")
    out(".hex_nonzero:")
    out(".hex_loop:")
    out("    test rax, rax")
    out("    jz .hex_prefix")
    out("    mov rcx, rax")
    out("    and rcx, 0xF")
    out("    cmp rcx, 10")
    out("    jl .hex_digit")
    out("    add cl, 87")
    out("    jmp .hex_store")
    out(".hex_digit:")
    out("    add cl, 48")
    out(".hex_store:")
    out("    dec rsi")
    out("    mov [rsi], cl")
    out("    shr rax, 4")
    out("    jmp .hex_loop")
    out(".hex_prefix:")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 120")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    mov rdi, rsi")
    out("    call _nova_strlen")
    out("    inc rax")
    out("    mov r12, rdi")
    out("    mov rdi, rax")
    out("    push r12")
    out("    call _nova_alloc")
    out("    pop rsi")
    out("    mov rdi, rax")
    out("    push rax")
    out(".hex_cp:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .hex_cp")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- Wrappers with Nova-compatible names ---
    out("")
    out_label("println")
    out("    jmp _nova_println")
    out_label("print")
    out("    jmp _nova_print_str")
    out_label("print_int")
    out("    jmp _nova_print_int")
    out_label("concat")
    out("    jmp _nova_concat")
    out_label("int_to_str")
    out("    jmp _nova_int_to_str")
    out_label("str_to_int")
    out("    jmp _nova_str_to_int")
    out_label("list_new")
    out("    jmp _nova_list_new")
    out_label("push")
    out("    jmp _nova_push")
    out_label("len")
    out("    jmp _nova_len")
    out_label("read_file")
    out("    jmp _nova_read_file")
    out_label("write_file")
    out("    jmp _nova_write_file")
    out_label("exit")
    out("    jmp _nova_exit")
    out_label("chr")
    out("    jmp _nova_chr")
    out_label("char_at")
    out("    jmp _nova_char_at")
    out_label("substr")
    out("    jmp _nova_substr")
    out_label("__arg")
    out("    jmp _nova___arg")
    out_label("str_eq")
    out("    jmp _nova_str_eq")
    out_label("pop")
    out("    jmp _nova_pop")
    out_label("list_set")
    out("    jmp _nova_list_set")
    out_label("contains")
    out("    jmp _nova_contains")
    out_label("list_remove")
    out("    jmp _nova_list_remove")
    out_label("starts_with")
    out("    jmp _nova_starts_with")
    out_label("ends_with")
    out("    jmp _nova_ends_with")
    out_label("str_find")
    out("    jmp _nova_str_find")
    out_label("abs")
    out("    jmp _nova_abs")
    out_label("min")
    out("    jmp _nova_min")
    out_label("max")
    out("    jmp _nova_max")
    out_label("assert")
    out("    jmp _nova_assert")
    out_label("type_of")
    out("    jmp _nova_type_of")
    out_label("debug_print")
    out("    jmp _nova_debug_print")
    out_label("alloc")
    out("    jmp _nova_alloc")
    out_label("time")
    out("    jmp _nova_time")
    out_label("sleep_ms")
    out("    jmp _nova_sleep_ms")
    out_label("mkdir")
    out("    jmp _nova_mkdir")
    out_label("unlink")
    out("    jmp _nova_unlink")
    out_label("file_size")
    out("    jmp _nova_file_size")
    out_label("socket")
    out("    jmp _nova_socket")
    out_label("bind_socket")
    out("    jmp _nova_bind")
    out_label("listen_socket")
    out("    jmp _nova_listen")
    out_label("accept_conn")
    out("    jmp _nova_accept")
    out_label("connect_socket")
    out("    jmp _nova_connect")
    out_label("send_data")
    out("    jmp _nova_send_data")
    out_label("recv_data")
    out("    jmp _nova_recv_data")
    out_label("close_fd")
    out("    jmp _nova_close_fd")
    out_label("make_sockaddr_in")
    out("    jmp _nova_make_sockaddr_in")
    out_label("fork_process")
    out("    jmp _nova_fork")
    out_label("waitpid")
    out("    jmp _nova_waitpid")
    out_label("exec_program")
    out("    jmp _nova_exec")
    out_label("pipe_create")
    out("    jmp _nova_pipe")
    out_label("hex")
    out("    jmp _nova_hex")

    // --- Data for runtime ---
    out("")
    out(".section .rodata")
    out_label("_empty_str")
    out("    .asciz " + DQ + DQ)
    out_label("_err_null_access")
    out("    .asciz " + DQ + "Runtime error: null pointer access" + DQ)
    out_label("_err_index_oob")
    out("    .asciz " + DQ + "Runtime error: index out of bounds: " + DQ)
    out_label("_err_div_zero")
    out("    .asciz " + DQ + "Runtime error: division by zero" + DQ)
    out_label("_err_stack_overflow")
    out("    .asciz " + DQ + "Runtime error: stack overflow" + DQ)
    out_label("_err_newline")
    out("    .asciz " + DQ + "\\n" + DQ)
    out_label("_err_assert_prefix")
    out("    .asciz " + DQ + "Assertion failed: " + DQ)
    out_label("_debug_sep")
    out("    .asciz " + DQ + ": " + DQ)
    out_label("_debug_null")
    out("    .asciz " + DQ + "null" + DQ)
    out_label("_debug_list_prefix")
    out("    .asciz " + DQ + "list[len=" + DQ)
    out_label("_debug_list_suffix")
    out("    .asciz " + DQ + "]" + DQ)

    // --- Heap state in .bss ---
    out("")
    out(".section .bss")
    out("    .align 8")
    out_label("_heap_base")
    out("    .quad 0")
    out_label("_heap_ptr")
    out("    .quad 0")
    out_label("_heap_end")
    out("    .quad 0")
}
