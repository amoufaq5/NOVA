    // --- R29A: sys_poll(fds, nfds, timeout_ms) -> i32 ---
    //
    // Wait on an array of pollfd structs `{fd:i32, events:i16,
    // revents:i16}` (8 bytes each, caller-allocated). Returns the
    // number of fds with at least one event set in revents (>=1),
    // 0 on timeout, or -1 on syscall error. timeout_ms < 0 means
    // "wait forever"; 0 means "nonblocking probe".
    //
    // Linux x86-64 : syscall 7 (poll). Args already in rdi/rsi/rdx.
    // macOS BSD    : syscall 230 via syscall_num(7) -> 0x20000E6.
    // Windows      : __imp_WSAPoll (R28C wired the .extern). Same arg
    //                shape but System V rdi/rsi/rdx must be re-marshalled
    //                to Win64 rcx/edx/r8d; remember to bounce edx through
    //                a scratch (r9d) so the move sequence is collision-
    //                free. WSAPoll returns SOCKET_ERROR == -1 which we
    //                propagate via movsxd (sign-extend to 64 bits).
    out("")
    out_label("_nova_sys_poll")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 48")
        // Re-marshal System V (rdi, rsi, rdx) -> Win64 (rcx, rdx, r8).
        // Order matters: rdx is both the source for arg3 and the dest
        // for arg2, so bounce arg3 through r9 before clobbering rdx.
        out("    mov r9d, edx")                  // save timeout_ms
        out("    mov rdx, rsi")                  // nfds (low 32 used)
        out("    mov rcx, rdi")                  // &fds
        out("    mov r8d, r9d")                  // timeout_ms
        out("    call [rip + __imp_WSAPoll]")
        out("    movsxd rax, eax")              // sign-extend WSAPoll's int
        out("    mov rsp, rbp")
        out("    pop rbp")
    } else {
        // Linux/macOS: rdi=fds, rsi=nfds, rdx=timeout_ms already in
        // the right syscall registers. emit_syscall(7) routes to the
        // BSD-number on macOS via syscall_num.
        emit_syscall(7)
    }
    out("    ret")

