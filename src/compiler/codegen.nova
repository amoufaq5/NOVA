    // given timeout_ms; if no data, return [-1, 0, 0]. Otherwise
    // recvfrom() into a stack sockaddr_in, extract ip+port (host order),
    // build a 3-element list via _nova_list_new + _nova_push.
    out("")
    out_label("_nova_sys_recvfrom")
    if cg_target == 3 {
        // Windows path.
        // Stack frame: shadow (32) + WSAPOLLFD (16) + sockaddr_in (16)
        // + addrlen i32 (4 padded to 8) + saved args (40) = 112 aligned.
        // We use [rbp-16..-32] for sockaddr_in scratch, [rbp-40..-32]
        // for addrlen i32, [rbp-56..-40] for WSAPOLLFD, and [rbp-96..-56]
        // for saved (fd, buf, max_len, timeout_ms, list_handle).
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 128")
        out("    mov [rbp - 56], rdi")             // saved fd
        out("    mov [rbp - 64], rsi")             // saved buf
        out("    mov [rbp - 72], rdx")             // saved max_len
        out("    mov [rbp - 80], rcx")             // saved timeout_ms
        // WSAPOLLFD: { fd:i64, events:i16, revents:i16 padded }
        out("    mov rax, [rbp - 56]")
        out("    mov [rbp - 40], rax")             // fd
        out("    mov word ptr [rbp - 32], 256")   // events = POLLRDNORM (Win)
        out("    mov word ptr [rbp - 30], 0")     // revents = 0
        // WSAPoll(&pollfd, 1, timeout_ms)
        out("    lea rcx, [rbp - 40]")
        out("    mov edx, 1")
        out("    mov r8d, dword ptr [rbp - 80]")
        out("    call [rip + __imp_WSAPoll]")
        out("    test eax, eax")
        out("    jle .srf_win_timeout")
        // sockaddr_in scratch at [rbp - 16], addrlen at [rbp - 24]
        out("    mov word ptr [rbp - 16], 0")
        out("    mov word ptr [rbp - 14], 0")
        out("    mov dword ptr [rbp - 12], 0")
        out("    mov qword ptr [rbp - 8], 0")
        out("    mov dword ptr [rbp - 24], 16")
        out("    mov rcx, [rbp - 56]")             // s
        out("    mov rdx, [rbp - 64]")             // buf
        out("    mov r8, [rbp - 72]")              // len
        out("    xor r9d, r9d")                    // flags = 0
        out("    lea rax, [rbp - 16]")
        out("    mov [rsp + 32], rax")             // from
        out("    lea rax, [rbp - 24]")
        out("    mov [rsp + 40], rax")             // fromlen
        out("    call [rip + __imp_recvfrom]")
        out("    movsxd rax, eax")
        out("    test rax, rax")
        out("    js .srf_win_fail")
        // Build result list.
        out("    mov [rbp - 88], rax")             // bytes_read
        out("    call _nova_list_new")
        out("    mov [rbp - 96], rax")             // list handle
        out("    mov rdi, rax")
        out("    mov rsi, [rbp - 88]")
        out("    call _nova_push")
        // Extract ip (offset +4 of sockaddr_in, network byte order int).
        // We return as host-order int (callers know it's wire-format).
        out("    mov rdi, [rbp - 96]")
        out("    mov esi, dword ptr [rbp - 12]")
        out("    call _nova_push")
        // Extract port (offset +2, big-endian u16). ntohs via xchg.
        out("    mov rdi, [rbp - 96]")
        out("    movzx eax, word ptr [rbp - 14]")
        out("    xchg al, ah")
        out("    mov rsi, rax")
        out("    call _nova_push")
        out("    mov rax, [rbp - 96]")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
        out(".srf_win_timeout:")
        out(".srf_win_fail:")
        // Return [-1, 0, 0] so callers see a 3-element list with a
        // sentinel first element. Cheaper than a separate None marker.
        out("    call _nova_list_new")
        out("    mov [rbp - 96], rax")
        out("    mov rdi, rax")
        out("    mov rsi, -1")
        out("    call _nova_push")
        out("    mov rdi, [rbp - 96]")
        out("    xor rsi, rsi")
        out("    call _nova_push")
        out("    mov rdi, [rbp - 96]")
        out("    xor rsi, rsi")
        out("    call _nova_push")
        out("    mov rax, [rbp - 96]")
        out("    mov rsp, rbp")
        out("    pop rbp")
    } else {
        // Linux/macOS path. rdi=fd, rsi=buf, rdx=max_len, rcx=timeout_ms.
        // Stack frame: sockaddr_in (16) + addrlen i32 (8) + pollfd (8)
        // + saved (fd, buf, max_len, timeout_ms, bytes_read, list, scratch) = 96.
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 128")
        out("    mov [rbp - 48], rdi")             // saved fd
        out("    mov [rbp - 56], rsi")             // saved buf
        out("    mov [rbp - 64], rdx")             // saved max_len
        out("    mov [rbp - 72], rcx")             // saved timeout_ms
        // pollfd: { fd:i32, events:i16, revents:i16 } at [rbp - 32]
        out("    mov eax, dword ptr [rbp - 48]")
        out("    mov dword ptr [rbp - 32], eax")
        out("    mov word ptr [rbp - 28], 1")     // POLLIN
        out("    mov word ptr [rbp - 26], 0")     // revents
