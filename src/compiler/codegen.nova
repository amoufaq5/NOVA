        out("    sub rsp, 40")
        out("    call [rip + __imp_raise]")
        out("    add rsp, 40")
        out("    mov rsp, rbp")
        out("    pop rbp")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    push rdi")
        // sig -> stack
        emit_syscall(39)
        // rax = pid
        out("    pop rsi")
        out("    mov rdi, rax")
        emit_syscall(62)
        out("    mov rsp, rbp")
        out("    pop rbp")
    }
    out("    ret")

    // --- signal_install(sig, handler) -> 0 or -1 ---
    // Linux x64: rt_sigaction (#13) with sa_handler at offset 0. macOS:
    // BSD sigaction (#46) — left as syscall here so it returns -1 on
    // success when the kernel rejects the simplified sigaction block, but
    // we attempt the call so audit shows real syscall is wired. Windows:
    // C runtime signal() via msvcrt.
    out("")
    out_label("_nova_signal_install")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov rcx, rdi")
        out("    mov rdx, rsi")
        out("    sub rsp, 40")
        out("    call [rip + __imp_signal]")
        out("    add rsp, 40")
        out("    mov rsp, rbp")
        out("    pop rbp")
    } else {
        // Build a minimal struct sigaction on the stack:
        //   {sa_handler, sa_flags=0, sa_restorer=0, sa_mask=0}
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 160")
        out("    mov [rbp - 152], rsi")    // sa_handler
        out("    mov qword ptr [rbp - 144], 0")  // sa_flags
        out("    mov qword ptr [rbp - 136], 0")  // sa_restorer
        out("    mov qword ptr [rbp - 128], 0")  // sa_mask[0]
        out("    mov qword ptr [rbp - 120], 0")  // sa_mask[1]
        // syscall(13, signum, &act, NULL, sizeof(sigset_t)=8)
        out("    mov rax, 13")
        // rdi already has signum
        out("    lea rsi, [rbp - 152]")
        out("    xor rdx, rdx")
        out("    mov r10, 8")
        out("    syscall")
        out("    mov rsp, rbp")
        out("    pop rbp")
    }
    out("    ret")

    // --- Coroutine support ---
    // Context layout (80 bytes):
    //   0: rsp, 8: rbp, 16: rbx, 24: r12, 32: r13, 40: r14, 48: r15
    //   56: state (0=ready,1=running,2=suspended,3=done)
    //   64: stack_base, 72: result
    out("")
    out_label("_nova_coro_new")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rdi, 65536")
    out("    call _nova_alloc")
    out("    mov r14, rax")
    out("    mov rdi, 80")
    out("    call _nova_alloc")
    out("    push rax")
    out("    lea rcx, [r14 + 65536]")
    out("    sub rcx, 8")
    out("    mov qword ptr [rcx], 0")
    out("    sub rcx, 8")
    out("    mov [rcx], r13")
    out("    sub rcx, 8")
    out("    mov [rcx], r12")
    out("    sub rcx, 8")
    out("    lea rdx, [rip + _nova_coro_entry]")
    out("    mov [rcx], rdx")
    out("    pop rax")
    out("    mov [rax], rcx")
    out("    mov [rax + 8], rcx")
    out("    mov qword ptr [rax + 16], 0")
    out("    mov qword ptr [rax + 24], 0")
    out("    mov qword ptr [rax + 32], 0")
    out("    mov qword ptr [rax + 40], 0")
    out("    mov qword ptr [rax + 48], 0")
    out("    mov qword ptr [rax + 56], 0")
    out("    mov [rax + 64], r14")
    out("    mov qword ptr [rax + 72], 0")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    out("")
    out_label("_nova_coro_entry")
    out("    pop r12")
    out("    pop rdi")
    out("    call r12")
    out("    mov rcx, [rip + _current_coro]")
    out("    mov [rcx + 72], rax")
    out("    mov qword ptr [rcx + 56], 3")
    out("    mov rsp, [rip + _main_coro_ctx]")
    out("    mov rbp, [rip + _main_coro_ctx + 8]")
    out("    mov rbx, [rip + _main_coro_ctx + 16]")
    out("    mov r12, [rip + _main_coro_ctx + 24]")
    out("    mov r13, [rip + _main_coro_ctx + 32]")
    out("    mov r14, [rip + _main_coro_ctx + 40]")
    out("    mov r15, [rip + _main_coro_ctx + 48]")
    out("    mov rax, [rcx + 72]")
    out("    ret")

    out("")
    out_label("_nova_coro_resume")
    out("    mov [rip + _main_coro_ctx], rsp")
    out("    mov [rip + _main_coro_ctx + 8], rbp")
    out("    mov [rip + _main_coro_ctx + 16], rbx")
    out("    mov [rip + _main_coro_ctx + 24], r12")
    out("    mov [rip + _main_coro_ctx + 32], r13")
    out("    mov [rip + _main_coro_ctx + 40], r14")
    out("    mov [rip + _main_coro_ctx + 48], r15")
    out("    mov [rip + _current_coro], rdi")
    out("    mov rsp, [rdi]")
    out("    mov rbp, [rdi + 8]")
    out("    mov rbx, [rdi + 16]")
    out("    mov r12, [rdi + 24]")
    out("    mov r13, [rdi + 32]")
    out("    mov r14, [rdi + 40]")
    out("    mov r15, [rdi + 48]")
    out("    mov qword ptr [rdi + 56], 1")
    out("    ret")

    out("")
    out_label("_nova_coro_yield")
    out("    mov rax, [rip + _current_coro]")
    out("    mov [rax], rsp")
    out("    mov [rax + 8], rbp")
    out("    mov [rax + 16], rbx")
    out("    mov [rax + 24], r12")
    out("    mov [rax + 32], r13")
    out("    mov [rax + 40], r14")
    out("    mov [rax + 48], r15")
    out("    mov qword ptr [rax + 56], 2")
    out("    mov [rax + 72], rdi")
    out("    mov rsp, [rip + _main_coro_ctx]")
    out("    mov rbp, [rip + _main_coro_ctx + 8]")
    out("    mov rbx, [rip + _main_coro_ctx + 16]")
    out("    mov r12, [rip + _main_coro_ctx + 24]")
    out("    mov r13, [rip + _main_coro_ctx + 32]")
    out("    mov r14, [rip + _main_coro_ctx + 40]")
    out("    mov r15, [rip + _main_coro_ctx + 48]")
    out("    mov rax, rdi")
    out("    ret")

    out("")
    out_label("_nova_coro_done")
    out("    mov rax, [rdi + 56]")
    out("    cmp rax, 3")
    out("    je .coro_done_yes")
    out("    xor eax, eax")
    out("    ret")
    out(".coro_done_yes:")
    out("    mov eax, 1")
    out("    ret")

    out("")
    out_label("_nova_coro_result")
    out("    mov rax, [rdi + 72]")
    out("    ret")

    out("")
    out_label("_nova_coro_state")
    out("    mov rax, [rdi + 56]")
    out("    ret")

    // --- Division by zero handler ---
    out("")
    out_label("_div_zero_handler")
    out("    lea rdi, [rip + _err_div_zero]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    call _nova_exit")

    // --- _nova_throw_impl: dynamic exception dispatch ---
    out("")
    out_label("_nova_throw_impl")
    out("    mov [rip + _nova_error_value], rdi")
    out("    mov qword ptr [rip + _nova_error_flag], 1")
    out("    mov rcx, [rip + _nova_catch_stack]")
    out("    test rcx, rcx")
    out("    jz .throw_no_handler")
    out("    mov rbp, [rcx + 8]")
    out("    mov rsp, [rcx + 16]")
    out("    mov rax, [rcx + 24]")
    out("    mov rcx, [rcx]")
    out("    mov [rip + _nova_catch_stack], rcx")
    out("    jmp rax")
    out(".throw_no_handler:")
    out("    lea rdi, [rip + _err_uncaught]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    call _nova_exit")

    // --- assert(condition, message) ---
    out("")
    out_label("_nova_assert")
    out("    test rdi, rdi")
    out("    jnz .assert_ok")
    out("    push rsi")
    out("    lea rdi, [rip + _err_assert_prefix]")
    out("    call _nova_print_str")
    out("    pop rdi")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    call _nova_exit")
    out(".assert_ok:")
    out("    ret")

    // --- type_of(value) -> int (0=null, 1=int, 2=string, 3=list, 4=map) ---
    out("")
    out_label("_nova_type_of")
    out("    test rdi, rdi")
    out("    jz .to_null")
    out("    call _nova_check_rdi")
    out("    jz .to_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .to_list")
    out("    cmp qword ptr [rdi], -2")
    out("    je .to_map")
    out("    mov eax, 2")
    out("    ret")
    out(".to_null:")
    out("    xor eax, eax")
    out("    ret")
    out(".to_int:")
    out("    mov eax, 1")
    out("    ret")
    out(".to_list:")
    out("    mov eax, 3")
    out("    ret")
    out(".to_map:")
    out("    mov eax, 4")
    out("    ret")

    // --- type_name(value) -> string ---
    out("")
    out_label("_nova_type_name")
    out("    test rdi, rdi")
    out("    jz .tn_none")
    out("    call _nova_check_rdi")
    out("    jz .tn_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .tn_list")
    out("    cmp qword ptr [rdi], -2")
    out("    je .tn_map")
    out("    lea rax, [rip + _tn_str]")
    out("    ret")
    out(".tn_none:")
    out("    lea rax, [rip + _tn_none]")
    out("    ret")
    out(".tn_int:")
    out("    lea rax, [rip + _tn_int]")
    out("    ret")
    out(".tn_list:")
    out("    lea rax, [rip + _tn_list]")
    out("    ret")
    out(".tn_map:")
    out("    lea rax, [rip + _tn_map]")
    out("    ret")

    // --- debug_print(label, value) ---
    out("")
    out_label("_nova_debug_print")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    mov r12, rsi")
    out("    call _nova_print_str")
    out("    lea rdi, [rip + _debug_sep]")
    out("    call _nova_print_str")
    out("    mov rdi, r12")
    out("    test rdi, rdi")
    out("    jz .dp_null")
    out("    call _nova_check_rdi")
    out("    jz .dp_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .dp_list")
    out("    call _nova_println")
    out("    jmp .dp_done")
    out(".dp_null:")
    out("    lea rdi, [rip + _debug_null]")
    out("    call _nova_println")
    out("    jmp .dp_done")
    out(".dp_int:")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _err_newline]")
    out("    call _nova_print_str")
    out("    jmp .dp_done")
    out(".dp_list:")
    out("    lea rdi, [rip + _debug_list_prefix]")
    out("    call _nova_print_str")
    out("    mov rdi, r12")
    out("    mov rdi, [rdi + 8]")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _debug_list_suffix]")
    out("    call _nova_println")
    out(".dp_done:")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- hex(n) -> hex string with "0x" prefix ---
    out("")
    out_label("_nova_hex")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rax, rdi")
    out("    lea rsi, [rbp - 1]")
    out("    mov byte ptr [rsi], 0")
    out("    test rax, rax")
    out("    jnz .hex_nonzero")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    jmp .hex_prefix")
    out(".hex_nonzero:")
    out(".hex_loop:")
    out("    test rax, rax")
    out("    jz .hex_prefix")
    out("    mov rcx, rax")
    out("    and rcx, 0xF")
    out("    cmp rcx, 10")
    out("    jl .hex_digit")
    out("    add cl, 87")
    out("    jmp .hex_store")
    out(".hex_digit:")
    out("    add cl, 48")
    out(".hex_store:")
    out("    dec rsi")
    out("    mov [rsi], cl")
    out("    shr rax, 4")
    out("    jmp .hex_loop")
    out(".hex_prefix:")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 120")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    mov rdi, rsi")
    out("    call _nova_strlen")
    out("    inc rax")
    out("    mov r12, rdi")
    out("    mov rdi, rax")
    out("    push r12")
    out("    call _nova_alloc")
    out("    pop rsi")
    out("    mov rdi, rax")
    out("    push rax")
    out(".hex_cp:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .hex_cp")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- read_line() -> string (read line from stdin) ---
    out("")
    out_label("_nova_read_line")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov rdi, 1024")
    out("    call _nova_alloc")
    out("    mov r12, rax")
    out("    xor r13d, r13d")
    out(".rl_loop:")
    if cg_target == 3 {
        // PROVES alignment: entry %16==8; push rbp -> 0; push r12 -> 8;
        // push r13 -> 0; sub rsp, 64 -> 0 ✓.
        // Layout (rbp-relative across iterations of .rl_loop):
        //   [rbp-24] : BytesRead output
        // Per-iteration: win_call shadow is OK; for the ReadFile call we
        // need shadow+5th arg. With sub rsp,48 we get 32 shadow + 16 padding,
        // 5th arg at [rsp+32].
        out("    sub rsp, 48")
        out("    mov ecx, -10")
        win_call("GetStdHandle")
        out("    mov rcx, rax")
        out("    lea rdx, [r12 + r13]")
        out("    mov r8d, 1")
        out("    lea r9, [rbp - 24]")
        out("    mov qword ptr [rsp + 32], 0")
        out("    call [rip + __imp_ReadFile]")
        out("    movzx eax, byte ptr [rbp - 24]")
        out("    add rsp, 48")
    } else {
        out("    xor edi, edi")
        out("    lea rsi, [r12 + r13]")
        out("    mov rdx, 1")
        emit_syscall(0)
    }
    out("    cmp rax, 0")
    out("    jle .rl_done")
    out("    movzx eax, byte ptr [r12 + r13]")
    out("    cmp al, 10")
    out("    je .rl_done")
    out("    inc r13")
    out("    cmp r13, 1023")
    out("    jl .rl_loop")
    out(".rl_done:")
    out("    mov byte ptr [r12 + r13], 0")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- read_stdin(n) -> string (read n bytes from stdin) ---
    out("")
    out_label("_nova_read_stdin")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r13, rdi")
    out("    lea rdi, [r13 + 1]")
    out("    call _nova_alloc")
    out("    mov r12, rax")
    if cg_target == 3 {
        // PROVES alignment: same as _nova_read_line.
        out("    sub rsp, 48")
        out("    mov ecx, -10")
        win_call("GetStdHandle")
        out("    mov rcx, rax")
        out("    mov rdx, r12")
        out("    mov r8, r13")
        out("    lea r9, [rbp - 24]")
        out("    mov qword ptr [rsp + 32], 0")
        out("    call [rip + __imp_ReadFile]")
        out("    mov eax, [rbp - 24]")
        out("    add rsp, 48")
    } else {
        out("    xor edi, edi")
        out("    mov rsi, r12")
        out("    mov rdx, r13")
        emit_syscall(0)
    }
    out("    cmp rax, 0")
    out("    jl .rs_fail")
    out("    mov byte ptr [r12 + rax], 0")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".rs_fail:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- getenv(name) -> string or 0 ---
    out("")
    out_label("_nova_getenv")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_strlen")
    out("    mov r13, rax")
    out("    mov rdi, [rip + _g___envp]")
    out("    test rdi, rdi")
    out("    jz .ge_not_found")
    out(".ge_loop:")
    out("    mov rsi, [rdi]")
    out("    test rsi, rsi")
    out("    jz .ge_not_found")
    out("    push rdi")
    out("    mov rdi, r12")
    out("    mov rcx, r13")
    out("    xor eax, eax")
    out(".ge_cmp:")
    out("    test rcx, rcx")
    out("    jz .ge_check_eq")
    out("    movzx edx, byte ptr [rdi + rax]")
    out("    cmp dl, [rsi + rax]")
    out("    jne .ge_next")
    out("    inc rax")
    out("    dec rcx")
    out("    jmp .ge_cmp")
    out(".ge_check_eq:")
    out("    cmp byte ptr [rsi + r13], 61")
    out("    jne .ge_next")
    out("    lea rax, [rsi + r13 + 1]")
    out("    pop rdi")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ge_next:")
    out("    pop rdi")
    out("    add rdi, 8")
    out("    jmp .ge_loop")
    out(".ge_not_found:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- random(max) -> pseudo-random integer 0 to max-1 ---
    out("")
    out_label("_nova_random")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, rdi")
    out("    mov rax, [rip + _rand_state]")
    out("    test rax, rax")
    out("    jnz .rand_have_seed")
    out("    sub rsp, 16")
    if cg_target == 3 {
        out("    lea rcx, [rsp]")
        win_call("GetSystemTimeAsFileTime")
        out("    mov rax, [rsp]")
    } else {
        out("    xor edi, edi")
        out("    lea rsi, [rsp]")
        emit_syscall(228)
        out("    mov rax, [rsp]")
        out("    xor rax, [rsp + 8]")
    }
    out("    add rsp, 16")
    out("    test rax, rax")
    out("    jnz .rand_have_seed")
    out("    mov rax, 0x123456789ABCDEF0")
    out(".rand_have_seed:")
    out("    mov rdx, rax")
    out("    shl rdx, 13")
    out("    xor rax, rdx")
    out("    mov rdx, rax")
    out("    shr rdx, 7")
    out("    xor rax, rdx")
    out("    mov rdx, rax")
    out("    shl rdx, 17")
    out("    xor rax, rdx")
    out("    mov [rip + _rand_state], rax")
    out("    test rax, rax")
    out("    jns .rand_pos")
    out("    neg rax")
    out(".rand_pos:")
    out("    xor edx, edx")
    out("    div rcx")
    out("    mov rax, rdx")
    out("    pop rbp")
    out("    ret")

    // --- random_seed(n) -> set PRNG seed ---
    out("")
    out_label("_nova_random_seed")
    out("    mov [rip + _rand_state], rdi")
    out("    ret")

    // --- secure_random(buf_ptr, n_bytes) -> bytes_written, or -1 on error ---
    //
    // Cryptographically secure RNG via the OS interface. Distinct from
    // _nova_random which is a deterministic xorshift LCG (documented as
    // weak in random_seed's commit). This is the production-grade path
    // for private keys, nonces, DP noise.
    //
    // Linux x64: getrandom(buf, n, 0) syscall #318 (kernel 3.17+). On
    //   -ENOSYS (older kernel) we fall back to open("/dev/urandom",
    //   O_RDONLY) + read + close.
    // macOS: BSD syscall #500 (getentropy). Kernel writes exactly n
    //   bytes when 0 < n <= 256, otherwise errors. We loop in 256-byte
    //   chunks to handle larger requests.
    // Windows: BCryptGenRandom(NULL, buf, n,
    //   BCRYPT_USE_SYSTEM_PREFERRED_RNG=0x00000002) from bcrypt.dll.
    //   Returns NTSTATUS; 0 = STATUS_SUCCESS.
    // ARM64: served by lower_arm64 / arm64 path (syscall #278).
    out("")
    out_label("_nova_secure_random")
    if cg_target == 3 {
        // Windows: BCryptGenRandom(hAlgorithm=NULL, pbBuffer=buf,
        //   cbBuffer=n, dwFlags=BCRYPT_USE_SYSTEM_PREFERRED_RNG=2)
        //
        // Alignment: entry %16==8; push rbp -> 0; sub rsp,48 -> 0.
        //   shadow space [rsp+0..31], saved n_bytes at [rsp+32].
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 48")
        out("    mov [rsp + 32], rsi")   // save n_bytes
        out("    xor rcx, rcx")           // hAlgorithm = NULL
        out("    mov rdx, rdi")           // pbBuffer = buf
        out("    mov r8, rsi")            // cbBuffer = n
        out("    mov r9d, 2")             // BCRYPT_USE_SYSTEM_PREFERRED_RNG
        out("    call [rip + __imp_BCryptGenRandom]")
        out("    test eax, eax")
        out("    jnz .sr_win_fail")
        out("    mov rax, [rsp + 32]")    // return n_bytes
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
        out(".sr_win_fail:")
        out("    mov rax, -1")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
    } else {
        if cg_target == 1 {
            // macOS: BSD getentropy syscall (#500 -> 0x2000000+500
            //   = 33554932). Kernel only accepts n <= 256, so loop.
            //
            // Layout: r12=remaining, r13=current buf ptr, r14=chunk,
            //   r15=original total (returned on success).
            //
            // Alignment: entry %16==8; push rbp -> 0; push r12 -> 8;
            //   push r13 -> 0; push r14 -> 8; push r15 -> 0.
            out("    push rbp")
            out("    mov rbp, rsp")
            out("    push r12")
            out("    push r13")
            out("    push r14")
            out("    push r15")
            out("    mov r12, rsi")            // remaining
            out("    mov r13, rdi")            // current ptr
            out("    mov r15, rsi")            // original total (returned on ok)
            out(".sr_mac_loop:")
            out("    test r12, r12")
            out("    jz .sr_mac_done")
            out("    mov rax, r12")
            out("    cmp rax, 256")
            out("    jle .sr_mac_chunk_ok")
            out("    mov rax, 256")
            out(".sr_mac_chunk_ok:")
            out("    mov rdi, r13")
            out("    mov rsi, rax")
            out("    mov r14, rax")            // chunk size
            out("    mov rax, 33554932")        // BSD getentropy
            out("    syscall")
            out("    jc .sr_mac_fail")          // BSD: CF=1 on error
            out("    add r13, r14")
            out("    sub r12, r14")
            out("    jmp .sr_mac_loop")
            out(".sr_mac_done:")
            out("    mov rax, r15")
            out("    pop r15")
            out("    pop r14")
            out("    pop r13")
            out("    pop r12")
            out("    pop rbp")
            out("    ret")
            out(".sr_mac_fail:")
            out("    mov rax, -1")
            out("    pop r15")
            out("    pop r14")
            out("    pop r13")
            out("    pop r12")
            out("    pop rbp")
            out("    ret")
        } else {
            // Linux x64: getrandom(buf, n, flags=0) syscall #318.
            //   On success returns bytes read; on -ENOSYS (=-38) we
            //   fall back to /dev/urandom. Other negative returns
            //   propagate as -1.
            //
            // Alignment: entry %16==8; push rbp -> 0; push r12 -> 8;
            //   push r13 -> 0. Frame is 16 bytes (saved regs); intra-
            //   block push/pop happens only at fallback.
            out("    push rbp")
            out("    mov rbp, rsp")
            out("    push r12")
            out("    push r13")
            out("    mov r12, rdi")            // save buf
            out("    mov r13, rsi")            // save n
            out("    mov rax, 318")            // getrandom
            // rdi/rsi already hold buf/n
            out("    xor rdx, rdx")            // flags = 0
            out("    syscall")
            out("    cmp rax, -38")            // -ENOSYS?
            out("    je .sr_lin_fallback")
            out("    test rax, rax")
            out("    js .sr_lin_fail")
            out("    pop r13")
            out("    pop r12")
            out("    pop rbp")
            out("    ret")
            out(".sr_lin_fail:")
            out("    mov rax, -1")
            out("    pop r13")
            out("    pop r12")
            out("    pop rbp")
            out("    ret")
            out(".sr_lin_fallback:")
            // open("/dev/urandom", O_RDONLY=0)
            out("    lea rdi, [rip + _sr_urandom_path]")
            out("    xor rsi, rsi")
            out("    xor rdx, rdx")
            emit_syscall(2)
            out("    test rax, rax")
            out("    js .sr_lin_fail")
            // rax = fd. Stash on stack (callee-saved regs already used).
            out("    push rax")                 // saved fd
            out("    mov rdi, rax")             // fd
            out("    mov rsi, r12")             // buf
            out("    mov rdx, r13")             // count
            emit_syscall(0)                     // read
            out("    pop rdi")                  // restore fd
            out("    push rax")                 // saved nbytes
            emit_syscall(3)                     // close
            out("    pop rax")                  // restore nbytes
            out("    test rax, rax")
            out("    js .sr_lin_fail")
            out("    pop r13")
            out("    pop r12")
            out("    pop rbp")
            out("    ret")
        }
    }

    // ====================================================================
    // Low-level WASI builtins on native targets (R8A)
    // ====================================================================
    //
    // The wasm target wires these to wasi_snapshot_preview1.{path_open,
    // fd_read, fd_write, fd_close, fd_seek, path_filestat_get,
    // args_*, environ_*}. On native Linux x86-64 (cg_target == 0) we
    // translate to the POSIX-equivalent syscalls (open, read, write,
    // close, lseek, stat) so the same NOVA source compiles and tests
    // both directions. On non-Linux native targets (macOS, Windows)
    // we emit "-1 / empty-list" stubs so the labels resolve and the
    // build doesn't break; the primary contract is the WASM path.
    //
    // WASI -> POSIX flag mapping for wasi_open:
    //   WASI oflag bit 0 (CREAT, 0x01) -> Linux O_CREAT  (0x40)
    //   WASI oflag bit 3 (TRUNC, 0x08) -> Linux O_TRUNC  (0x200)
    // We always open O_RDWR (=2) so the returned fd supports both
    // wasi_read and wasi_write, matching the ALL_RIGHTS we hand to
    // path_open on the WASM side. Mode is 0644 (=420) for CREAT.
    if cg_target == 0 {
        // --- wasi_open(path, flags) -> fd | -1 ---
        out("")
        out_label("_nova_wasi_open")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov rdx, 420")              // mode 0644 (only used when O_CREAT)
        out("    mov rax, 2")                // base flags: O_RDWR
        out("    mov rcx, rsi")              // wasi flags
        out("    test rcx, 1")               // bit 0 == WASI CREAT
        out("    jz .wo_no_creat")
        out("    or rax, 64")                // | O_CREAT
        out(".wo_no_creat:")
        out("    test rcx, 8")               // bit 3 == WASI TRUNC
        out("    jz .wo_no_trunc")
        out("    or rax, 512")               // | O_TRUNC
        out(".wo_no_trunc:")
        out("    mov rsi, rax")              // syscall arg2 = flags
        // rdi already holds path
        emit_syscall(2)                       // open(path, flags, mode)
        out("    test rax, rax")
        out("    jns .wo_done")
        out("    mov rax, -1")
        out(".wo_done:")
        out("    pop rbp")
        out("    ret")

        // --- wasi_read(fd, buf, len) -> bytes_read | -1 ---
        out("")
        out_label("_nova_wasi_read")
        out("    push rbp")
        out("    mov rbp, rsp")
        // rdi=fd, rsi=buf, rdx=len (passed by NOVA argv convention)
        emit_syscall(0)                       // read
        out("    test rax, rax")
        out("    jns .wr_done")
        out("    mov rax, -1")
        out(".wr_done:")
        out("    pop rbp")
        out("    ret")

        // --- wasi_write(fd, buf, len) -> bytes_written | -1 ---
        out("")
        out_label("_nova_wasi_write")
        out("    push rbp")
        out("    mov rbp, rsp")
        emit_syscall(1)                       // write
        out("    test rax, rax")
        out("    jns .ww_done")
        out("    mov rax, -1")
        out(".ww_done:")
        out("    pop rbp")
        out("    ret")

        // --- wasi_close(fd) -> 0 | -1 ---
        out("")
        out_label("_nova_wasi_close")
        out("    push rbp")
        out("    mov rbp, rsp")
        emit_syscall(3)                       // close
        out("    test rax, rax")
        out("    jns .wc_done")
        out("    mov rax, -1")
        out(".wc_done:")
        out("    pop rbp")
        out("    ret")

        // --- wasi_seek(fd, off, whence) -> new_offset | -1 ---
        out("")
        out_label("_nova_wasi_seek")
        out("    push rbp")
        out("    mov rbp, rsp")
        // rdi=fd, rsi=off, rdx=whence
        out("    mov rax, 8")                 // lseek (Linux only here)
        out("    syscall")
        out("    test rax, rax")
        out("    jns .ws_done")
        out("    mov rax, -1")
        out(".ws_done:")
        out("    pop rbp")
        out("    ret")

        // --- wasi_filestat(path) -> list [size, mtime, kind] | 0 ---
        //
        // Linux x86-64 stat(2) buffer layout (144 bytes):
        //   off 48  st_size  (i64)
        //   off 88  st_mtime (i64 seconds since epoch)
        //   off 24  st_mode  (i32) -- masked with S_IFMT (0xF000) to pick kind
        //
        // Kind mapping (we report the WASI filetype codes so callers see
        // the same value across native and WASM):
        //   S_IFREG (0x8000)  -> 4 (regular_file)
        //   S_IFDIR (0x4000)  -> 3 (directory)
        //   S_IFLNK (0xA000)  -> 7 (symbolic_link)
        //   S_IFCHR (0x2000)  -> 2 (character_device)
        //   default           -> 0 (unknown)
        out("")
        out_label("_nova_wasi_filestat")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    push rbx")
        out("    push r12")
        out("    push r13")
        out("    push r14")
        out("    sub rsp, 160")               // 144-byte stat buf, rounded up
        out("    mov rsi, rsp")
        // rdi already holds path
        out("    mov rax, 4")                 // Linux stat
        out("    syscall")
        out("    test rax, rax")
        out("    jns .wfs_ok")
        out("    add rsp, 160")
        out("    xor eax, eax")
        out("    pop r14")
        out("    pop r13")
        out("    pop r12")
        out("    pop rbx")
        out("    pop rbp")
        out("    ret")
        out(".wfs_ok:")
        // r12 = size, r13 = mtime (sec), r14 = kind
        out("    mov r12, [rsp + 48]")        // st_size
        out("    mov r13, [rsp + 88]")        // st_mtime
        out("    mov eax, dword ptr [rsp + 24]")  // st_mode
        out("    and eax, 61440")             // 0xF000
        out("    mov r14d, 0")
        out("    cmp eax, 32768")             // S_IFREG 0x8000
        out("    jne .wfs_not_reg")
        out("    mov r14d, 4")
        out("    jmp .wfs_kind_done")
        out(".wfs_not_reg:")
        out("    cmp eax, 16384")             // S_IFDIR 0x4000
        out("    jne .wfs_not_dir")
        out("    mov r14d, 3")
        out("    jmp .wfs_kind_done")
        out(".wfs_not_dir:")
        out("    cmp eax, 40960")             // S_IFLNK 0xA000
        out("    jne .wfs_not_lnk")
        out("    mov r14d, 7")
        out("    jmp .wfs_kind_done")
        out(".wfs_not_lnk:")
        out("    cmp eax, 8192")              // S_IFCHR 0x2000
        out("    jne .wfs_kind_done")
        out("    mov r14d, 2")
        out(".wfs_kind_done:")
        out("    add rsp, 160")
        // Build a NOVA list and push three entries.
        out("    call _nova_list_new")
        out("    mov rbx, rax")
        out("    mov rdi, rbx")
        out("    mov rsi, r12")
        out("    call _nova_push")
        out("    mov rdi, rbx")
        out("    mov rsi, r13")
        out("    call _nova_push")
        out("    mov rdi, rbx")
        out("    mov rsi, r14")
        out("    call _nova_push")
        out("    mov rax, rbx")
        out("    pop r14")
        out("    pop r13")
        out("    pop r12")
        out("    pop rbx")
        out("    pop rbp")
        out("    ret")

        // --- wasi_args_get() -> list of argv strings ---
        //
        // On native we surface NOVA's already-parsed argv via the existing
        // _nova___arg(idx) machinery, walking from idx=0 until __arg returns
        // 0 (NULL ptr). This keeps the native + WASM call surface identical
        // so a NOVA program written against wasi_args_get works in both.
        out("")
        out_label("_nova_wasi_args_get")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    push rbx")
        out("    push r12")
        out("    sub rsp, 8")                 // align
        out("    call _nova_list_new")
        out("    mov rbx, rax")
        out("    xor r12, r12")
        out(".wag_loop:")
        out("    mov rdi, r12")
        out("    call _nova___arg")
        out("    test rax, rax")
        out("    jz .wag_done")
        out("    mov rdi, rbx")
        out("    mov rsi, rax")
        out("    call _nova_push")
        out("    inc r12")
        out("    jmp .wag_loop")
        out(".wag_done:")
        out("    mov rax, rbx")
        out("    add rsp, 8")
        out("    pop r12")
        out("    pop rbx")
        out("    pop rbp")
        out("    ret")

        // --- wasi_environ_get() -> list of "KEY=VALUE" strings ---
        //
        // The WASM target serves the real envp via environ_get +
        // environ_sizes_get. On native we surface an empty list -- the
        // mapping to libc environ would require pulling envp from the
        // System V startup frame, which lives outside NOVA's _start
        // boilerplate. NOVA's existing `getenv` builtin already covers
        // the per-key lookup case for native consumers.
        out("")
        out_label("_nova_wasi_environ_get")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    call _nova_list_new")
        out("    pop rbp")
        out("    ret")
    } else {
        // Non-Linux native targets (macOS, Windows) -- emit minimal
        // stubs. wasi_open/read/write/seek/close/filestat all return
        // -1 (failure); args_get/environ_get return empty NOVA list.
        // Real impls for those targets are deferred (the wasm path
        // is where the WASI surface actually pays off).
        out("")
        out_label("_nova_wasi_open")
        out("    mov rax, -1")
        out("    ret")
        out("")
        out_label("_nova_wasi_read")
        out("    mov rax, -1")
        out("    ret")
        out("")
        out_label("_nova_wasi_write")
        out("    mov rax, -1")
        out("    ret")
        out("")
        out_label("_nova_wasi_close")
        out("    mov rax, -1")
        out("    ret")
        out("")
        out_label("_nova_wasi_seek")
        out("    mov rax, -1")
        out("    ret")
        out("")
        out_label("_nova_wasi_filestat")
        out("    xor eax, eax")
        out("    ret")
        out("")
        out_label("_nova_wasi_args_get")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    call _nova_list_new")
        out("    pop rbp")
        out("    ret")
        out("")
        out_label("_nova_wasi_environ_get")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    call _nova_list_new")
        out("    pop rbp")
        out("    ret")
    }

    // --- map_new() -> map pointer ---
    // Map layout: [magic=-2, count, capacity, entries_ptr] (32 bytes)
    // Entry layout: [key, value, occupied] = 24 bytes per entry
    out("")
    out_label("_nova_map_new")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rdi, 32")
    out("    call _nova_alloc")
    out("    mov qword ptr [rax], -2")
    out("    mov qword ptr [rax + 8], 0")
    out("    mov qword ptr [rax + 16], 16")
    out("    push rax")
    out("    mov rdi, 384")
    out("    call _nova_alloc")
    out("    mov rdi, rax")
    out("    mov rcx, 48")
    out("    xor eax, eax")
    out("    rep stosq")
    out("    mov rax, rdi")
    out("    sub rax, 384")
    out("    pop rcx")
    out("    mov [rcx + 24], rax")
    out("    mov rax, rcx")
    out("    pop rbp")
    out("    ret")

    // --- _nova_hash_key(key in rdi) -> hash in rax ---
    out("")
    out_label("_nova_hash_key")
    out("    call _nova_check_rdi")
    out("    jz .hk_int")
    out("    xor eax, eax")
    out(".hk_str_loop:")
    out("    movzx ecx, byte ptr [rdi]")
    out("    test cl, cl")
    out("    jz .hk_done")
    out("    imul rax, 31")
    out("    add rax, rcx")
    out("    inc rdi")
    out("    jmp .hk_str_loop")
    out(".hk_int:")
    out("    mov rax, rdi")
    out("    test rax, rax")
    out("    jns .hk_done")
    out("    neg rax")
    out(".hk_done:")
    out("    ret")

    // --- map_set(map, key, value) ---
    out("")
    out_label("_nova_map_set")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    mov rdi, rsi")
    out("    call _nova_hash_key")
    out("    xor edx, edx")
    out("    div qword ptr [r12 + 16]")
    out("    mov r15, rdx")
    out(".ms_probe:")
    out("    mov rax, r15")
    out("    imul rax, 24")
    out("    add rax, [r12 + 24]")
    out("    cmp qword ptr [rax + 16], 0")
    out("    je .ms_insert")
    out("    mov rdi, [rax]")
    out("    mov rsi, r13")
    out("    call _nova_eq")
    out("    cmp rax, 1")
    out("    jne .ms_update")
    out("    inc r15")
    out("    cmp r15, [r12 + 16]")
    out("    jl .ms_probe")
    out("    xor r15d, r15d")
    out("    jmp .ms_probe")
    out(".ms_insert:")
    out("    mov [rax], r13")
    out("    mov [rax + 8], r14")
    out("    mov qword ptr [rax + 16], 1")
    out("    inc qword ptr [r12 + 8]")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ms_update:")
    out("    mov rax, r15")
    out("    imul rax, 24")
    out("    add rax, [r12 + 24]")
    out("    mov [rax + 8], r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_get(map, key) -> value or 0 ---
    out("")
    out_label("_nova_map_get")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rdi, rsi")
    out("    call _nova_hash_key")
    out("    xor edx, edx")
    out("    div qword ptr [r12 + 16]")
    out("    mov r14, rdx")
    out("    mov r15, [r12 + 16]")
    out("    xor ebx, ebx")
    out(".mg_probe:")
    out("    cmp rbx, r15")
    out("    jge .mg_not_found")
    out("    mov rax, r14")
    out("    imul rax, 24")
    out("    add rax, [r12 + 24]")
    out("    cmp qword ptr [rax + 16], 0")
    out("    je .mg_not_found")
    out("    push rax")
    out("    mov rdi, [rax]")
    out("    mov rsi, r13")
    out("    call _nova_eq")
    out("    cmp rax, 1")
    out("    pop rax")
    out("    jne .mg_found")
    out("    inc r14")
    out("    cmp r14, r15")
    out("    jl .mg_no_wrap")
    out("    xor r14d, r14d")
    out(".mg_no_wrap:")
    out("    inc rbx")
    out("    jmp .mg_probe")
    out(".mg_found:")
    out("    mov rax, [rax + 8]")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".mg_not_found:")
    out("    xor eax, eax")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_has(map, key) -> 1 or 0 ---
    out("")
    out_label("_nova_map_has")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_map_get")
    out("    test rax, rax")
    out("    jz .mh_no")
    out("    mov eax, 3")                 // tagged true
    out("    pop rbp")
    out("    ret")
    out(".mh_no:")
    out("    mov eax, 1")                 // tagged false
    out("    pop rbp")
    out("    ret")

    // --- join(list, separator) -> string  (O(n) two-pass) ---
    out("")
    out_label("_nova_join")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, [rdi + 8]")
    out("    test r14, r14")
    out("    jz .join_empty")
    // Pass 1: get separator length
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    mov [rbp - 48], rax")
    // Pass 1: sum element lengths
    out("    xor r15d, r15d")
    out("    xor ebx, ebx")
    out(".join_len_loop:")
    out("    cmp rbx, r14")
    out("    jge .join_len_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + rbx*8]")
    out("    call _nova_strlen")
    out("    add r15, rax")
    out("    inc rbx")
    out("    jmp .join_len_loop")
    out(".join_len_done:")
    // total += (count-1) * sep_len + 1
    out("    mov rax, r14")
    out("    dec rax")
    out("    imul rax, qword ptr [rbp - 48]")
    out("    add r15, rax")
    out("    inc r15")
    // Allocate single buffer
    out("    mov rdi, r15")
    out("    call _nova_alloc")
    out("    mov r15, rax")
    out("    mov rdi, rax")
    // Pass 2: copy elements with separators
    out("    xor ebx, ebx")
    out(".join_copy_loop:")
    out("    cmp rbx, r14")
    out("    jge .join_copy_done")
    out("    test rbx, rbx")
    out("    jz .join_no_sep")
    out("    mov rsi, r13")
    out(".join_sep_cp:")
    out("    lodsb")
    out("    test al, al")
    out("    jz .join_no_sep")
    out("    stosb")
    out("    jmp .join_sep_cp")
    out(".join_no_sep:")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rbx*8]")
    out(".join_elem_cp:")
    out("    lodsb")
    out("    test al, al")
    out("    jz .join_elem_done")
    out("    stosb")
    out("    jmp .join_elem_cp")
    out(".join_elem_done:")
    out("    inc rbx")
    out("    jmp .join_copy_loop")
    out(".join_copy_done:")
    out("    mov byte ptr [rdi], 0")
    out("    mov rax, r15")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".join_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- split(str, delimiter_char) -> list of strings ---
    out("")
    out_label("_nova_split")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    cmp r13, 256")
    out("    jl .split_char_ready")
    out("    movzx r13d, byte ptr [r13]")
    out(".split_char_ready:")
    out("    xor r15d, r15d")
    out("    xor ebx, ebx")
    out(".split_loop:")
    out("    movzx eax, byte ptr [r12 + rbx]")
    out("    test al, al")
    out("    jz .split_last")
    out("    cmp al, r13b")
    out("    je .split_found")
    out("    inc rbx")
    out("    jmp .split_loop")
    out(".split_found:")
    out("    mov rdi, r12")
    out("    mov rsi, r15")
    out("    mov rdx, rbx")
    out("    sub rdx, r15")
    out("    call _nova_substr")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_push")
    out("    inc rbx")
    out("    mov r15, rbx")
    out("    jmp .split_loop")
    out(".split_last:")
    out("    mov rdi, r12")
    out("    mov rsi, r15")
    out("    mov rdx, rbx")
    out("    sub rdx, r15")
    out("    call _nova_substr")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_push")
    out("    mov rax, r14")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- reverse(list) -> new reversed list ---
    out("")
    out_label("_nova_reverse")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, [rdi + 8]")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    mov rcx, r13")
    out("    dec rcx")
    out(".rev_loop:")
    out("    cmp rcx, 0")
    out("    jl .rev_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    mov rdi, r14")
    out("    push rcx")
    out("    call _nova_push")
    out("    pop rcx")
    out("    dec rcx")
    out("    jmp .rev_loop")
    out(".rev_done:")
    out("    mov rax, r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- sort(list) -> sorts list in place (insertion sort) ---
    out("")
    out_label("_nova_sort")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, [rdi + 8]")
    out("    cmp r13, 2")
    out("    jl .sort_done")
    out("    mov rdi, [r12 + 24]")
    out("    mov rcx, 1")
    out(".sort_outer:")
    out("    cmp rcx, r13")
    out("    jge .sort_done")
    out("    mov rax, [rdi + rcx*8]")
    out("    mov rdx, rcx")
    out("    dec rdx")
    out(".sort_inner:")
    out("    cmp rdx, 0")
    out("    jl .sort_place")
    out("    cmp [rdi + rdx*8], rax")
    out("    jle .sort_place")
    out("    mov r8, [rdi + rdx*8]")
    out("    mov [rdi + rdx*8 + 8], r8")
    out("    dec rdx")
    out("    jmp .sort_inner")
    out(".sort_place:")
    out("    inc rdx")
    out("    mov [rdi + rdx*8], rax")
    out("    inc rcx")
    out("    jmp .sort_outer")
    out(".sort_done:")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- IEEE 754 float_mul(a, b): rdi=double bits, rsi=double bits ---
    out("")
    out_label("_nova_float_mul")
    out("    movq xmm0, rdi")
    out("    movq xmm1, rsi")
    out("    mulsd xmm0, xmm1")
    out("    movq rax, xmm0")
    out("    ret")

    // --- IEEE 754 float_div(a, b) ---
    out("")
    out_label("_nova_float_div")
    out("    movq xmm0, rdi")
    out("    movq xmm1, rsi")
    out("    divsd xmm0, xmm1")
    out("    movq rax, xmm0")
    out("    ret")

    // --- IEEE 754 float_add(a, b) ---
    out("")
    out_label("_nova_float_add")
    out("    movq xmm0, rdi")
    out("    movq xmm1, rsi")
    out("    addsd xmm0, xmm1")
    out("    movq rax, xmm0")
    out("    ret")

    // --- IEEE 754 float_sub(a, b) ---
    out("")
    out_label("_nova_float_sub")
    out("    movq xmm0, rdi")
    out("    movq xmm1, rsi")
    out("    subsd xmm0, xmm1")
    out("    movq rax, xmm0")
    out("    ret")

    // --- IEEE 754 float_cmp(a, b) -> -1, 0, or 1 ---
    out("")
    out_label("_nova_float_cmp")
    out("    movq xmm0, rdi")
    out("    movq xmm1, rsi")
    out("    ucomisd xmm0, xmm1")
    out("    jp .fcmp_neq")
    out("    je .fcmp_eq")
    out(".fcmp_neq:")
    out("    ja .fcmp_gt")
    out("    mov rax, -1")
    out("    ret")
    out(".fcmp_gt:")
    out("    mov rax, 1")
    out("    ret")
    out(".fcmp_eq:")
    out("    xor eax, eax")
    out("    ret")

    // --- IEEE 754 math_sqrt(a) ---
    out("")
    out_label("_nova_math_sqrt")
    out("    movq xmm0, rdi")
    out("    sqrtsd xmm0, xmm0")
    out("    movq rax, xmm0")
    out("    ret")

    // --- to_float(n) -> convert integer to IEEE 754 double ---
    out("")
    out_label("_nova_to_float")
    out("    cvtsi2sd xmm0, rdi")
    out("    movq rax, xmm0")
    out("    ret")

    // --- from_float(f) -> convert IEEE 754 double to integer (truncate) ---
    out("")
    out_label("_nova_from_float")
    out("    movq xmm0, rdi")
    out("    cvttsd2si rax, xmm0")
    out("    ret")

    // --- R38A float builtins (operate on IEEE 754 doubles in rdi/rsi) ---
    //
    // The R38A spec names are slightly different from the legacy
    // to_float/from_float/fsqrt builtins; we expose BOTH naming families
    // so old call sites keep working. Each pair shares the same
    // implementation address — see the trampoline block at the bottom of
    // gen_runtime() that creates `int_to_f` / `f_to_int` / `f_sqrt`
    // aliases pointing at _nova_to_float / _nova_from_float /
    // _nova_math_sqrt respectively.

    // --- f_abs(x) -> mask off the sign bit (bit 63) ---
    out("")
    out_label("_nova_f_abs")
    out("    movabs rax, 0x7FFFFFFFFFFFFFFF")
    out("    and rax, rdi")
    out("    ret")

    // --- f_neg(x) -> flip the sign bit. Used by parser-lowered unary
    //                 minus on a float ident / non-literal expression. ---
    out("")
    out_label("_nova_f_neg")
    out("    movabs rax, 0x8000000000000000")
    out("    xor rax, rdi")
    out("    ret")

    // --- f_floor(x) -> roundsd with mode 1 (round toward -inf) ---
    //
    // SSE4.1 instruction. On the bootstrap target this is always
    // available (we target x86_64 with at least SSE4.1 — see codegen
    // emit-prelude). f_ceil and f_round share the same encoding with
    // different immediate.
    out("")
    out_label("_nova_f_floor")
    out("    movq xmm0, rdi")
    out("    roundsd xmm0, xmm0, 1")
    out("    movq rax, xmm0")
    out("    ret")

    // --- f_ceil(x) -> roundsd mode 2 (round toward +inf) ---
    out("")
    out_label("_nova_f_ceil")
    out("    movq xmm0, rdi")
    out("    roundsd xmm0, xmm0, 2")
    out("    movq rax, xmm0")
    out("    ret")

    // --- f_round(x) -> roundsd mode 0 (round to nearest, ties to even).
    //
    // Documented caveat: SSE2 / SSE4.1 round-to-nearest is BANKERS'
    // ROUNDING (ties go to even), not the schoolbook "always round
    // halves up". Examples: 0.5 -> 0.0 (not 1.0), 1.5 -> 2.0, 2.5 -> 2.0
    // (not 3.0), 3.5 -> 4.0. R38A documents this rather than emulating
    // schoolbook rounding (which would cost an extra branch and is
    // not what most numerical code wants anyway). Use f_floor(x + 0.5)
    // if schoolbook rounding is required. ---
    out("")
    out_label("_nova_f_round")
    out("    movq xmm0, rdi")
    out("    roundsd xmm0, xmm0, 0")
    out("    movq rax, xmm0")
    out("    ret")

    // --- f_min(a, b) -> minsd xmm0, xmm1 ---
    //
    // SSE2 instruction. When one operand is NaN, minsd / maxsd return
    // the SECOND operand (intentional IEEE quirk). NOVA's f_min(NaN, x)
    // returns x today — documented as a known caveat; a future round
    // can add a NaN-aware branch if needed.
    out("")
    out_label("_nova_f_min")
    out("    movq xmm0, rdi")
    out("    movq xmm1, rsi")
    out("    minsd xmm0, xmm1")
    out("    movq rax, xmm0")
    out("    ret")

    // --- f_max(a, b) -> maxsd xmm0, xmm1 ---
    out("")
    out_label("_nova_f_max")
    out("    movq xmm0, rdi")
    out("    movq xmm1, rsi")
    out("    maxsd xmm0, xmm1")
    out("    movq rax, xmm0")
    out("    ret")

    // --- float_to_str(f) -> string representation of IEEE 754 double ---
    out("")
    out_label("_nova_float_to_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 64")
    // [rbp-8]=original bits, [rbp-16]=neg_flag, [rbp-24]=result_str, [rbp-32..]=digit buf
    out("    mov [rbp - 8], rdi")
    out("    mov qword ptr [rbp - 16], 0")
    // Check sign bit
    out("    movq xmm0, rdi")
    out("    test rdi, rdi")
    out("    jns .fts_pos")
    // Check if negative (bit 63)
    out("    bt rdi, 63")
    out("    jnc .fts_pos")
    out("    mov qword ptr [rbp - 16], 1")
    // Negate: clear sign bit
    out("    mov rax, rdi")
    out("    mov rcx, 1")
    out("    shl rcx, 63")
    out("    xor rax, rcx")
    out("    movq xmm0, rax")
    out(".fts_pos:")
    // xmm0 = absolute value
    // Get integer part
    out("    cvttsd2si rdi, xmm0")
    out("    mov [rbp - 40], rdi")
    // Save abs float
    out("    movsd [rbp - 48], xmm0")
    // Convert integer part to string
    out("    call _nova_int_to_str")
    out("    mov [rbp - 24], rax")
    // If negative, prepend "-"
    out("    cmp qword ptr [rbp - 16], 0")
    out("    je .fts_no_sign")
    out("    lea rdi, [rip + _float_minus]")
    out("    mov rsi, [rbp - 24]")
    out("    call _nova_concat")
    out("    mov [rbp - 24], rax")
    out(".fts_no_sign:")
    // Append "."
    out("    mov rdi, [rbp - 24]")
    out("    lea rsi, [rip + _float_dot]")
    out("    call _nova_concat")
    out("    mov [rbp - 24], rax")
    // Get fractional part: (abs_float - integer_part) * 1000000
    out("    movsd xmm0, [rbp - 48]")
    out("    cvtsi2sd xmm1, qword ptr [rbp - 40]")
    out("    subsd xmm0, xmm1")
    // Multiply by 1000000 for 6 decimal digits
    out("    mov rax, 1000000")
    out("    cvtsi2sd xmm1, rax")
    out("    mulsd xmm0, xmm1")
    out("    cvttsd2si rax, xmm0")
    // Ensure non-negative
    out("    test rax, rax")
    out("    jns .fts_frac_pos")
    out("    neg rax")
    out(".fts_frac_pos:")
    // Extract 6 digits into buffer at [rbp-32]
    out("    mov rcx, 100000")
    out("    xor edx, edx")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 32], al")
    out("    mov rax, rdx")
    out("    mov rcx, 10000")
    out("    xor edx, edx")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 31], al")
    out("    mov rax, rdx")
    out("    mov rcx, 1000")
    out("    xor edx, edx")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 30], al")
    out("    mov rax, rdx")
    out("    mov rcx, 100")
    out("    xor edx, edx")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 29], al")
    out("    mov rax, rdx")
    out("    mov rcx, 10")
    out("    xor edx, edx")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 28], al")
    out("    add dl, 48")
    out("    mov [rbp - 27], dl")
    out("    mov byte ptr [rbp - 26], 0")
    // Append fractional digits
    out("    mov rdi, [rbp - 24]")
    out("    lea rsi, [rbp - 32]")
    out("    call _nova_concat")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- _nova_init_floats: initialize float constant pool at startup ---
    //
    // R38A: per-constant emit is now (int_part + frac_part / 10^frac_digits)
    // * 10^exponent. The exponent loop runs at startup once per constant,
    // multiplying by 10.0 for positive exp or dividing for negative exp.
    // Float precision: small exponents like e±10 stay within double's
    // ~15 significant digits; very large exponents (|exp| > 308) will
    // overflow/underflow to inf/0 which is the correct IEEE 754 behaviour.
    out("")
    out_label("_nova_init_floats")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    let fi = 0
    while fi < cg_float_count {
        // Convert (int_part, frac_part, frac_digits, exponent) to IEEE 754
        let ip = cg_float_int_parts[fi]
        let fp = cg_float_frac_parts[fi]
        let fd = cg_float_frac_digits[fi]
        let exp_v = cg_float_exponents[fi]
        // Compute divisor = 10^frac_digits
        // Build divisor=10^fd as a decimal string (avoid Nova int overflow at 0x100000)
        let divisor_str = "1"
        let di = 0
        while di < fd {
            divisor_str = divisor_str + "0"
            di = di + 1
        }
        // xmm0 = int_part, xmm1 = frac_part / divisor, xmm0 = sum
        out("    mov rax, " + int_to_str(ip))
        out("    cvtsi2sd xmm0, rax")
        out("    mov rax, " + int_to_str(fp))
        out("    cvtsi2sd xmm1, rax")
        out("    mov rax, " + divisor_str)
        out("    cvtsi2sd xmm2, rax")
        out("    divsd xmm1, xmm2")
        out("    addsd xmm0, xmm1")
        // R38A: apply scientific-notation exponent. Positive exp -> multiply
        // by 10.0 |exp| times; negative -> divide. Zero exp skips entirely
        // to keep the byte-stable baseline for `3.14` / `0.5` etc.
        if exp_v > 0 {
            out("    mov rax, 10")
            out("    cvtsi2sd xmm2, rax")
            let ei = 0
            while ei < exp_v {
                out("    mulsd xmm0, xmm2")
                ei = ei + 1
            }
        }
        if exp_v < 0 {
            out("    mov rax, 10")
            out("    cvtsi2sd xmm2, rax")
            let ei = 0
            let neg_exp = 0 - exp_v
            while ei < neg_exp {
                out("    divsd xmm0, xmm2")
                ei = ei + 1
            }
        }
        out("    movsd [rip + _fc_" + int_to_str(fi) + "], xmm0")
        fi = fi + 1
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- to_str(value) -> string representation ---
    // If value is an integer (per _nova_check_rdi): convert via int_to_str
    // If value is a pointer and [value] == -1: it's a list, return "[list]"
    // Otherwise: it's already a string, return as-is
    out("")
    out_label("_nova_to_str")
    out("    call _nova_check_rdi")
    out("    jz .ts_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .ts_list")
    out("    mov rax, rdi")
    out("    ret")
    out(".ts_int:")
    out("    jmp _nova_int_to_str")
    out(".ts_list:")
    out("    lea rax, [rip + _str_list_repr]")
    out("    ret")

    // --- map_list(list, fn): create new list by applying fn to each element ---
    // R37A: fn may be a closure tuple `[fn_ptr, captures_list]` (the new
    // shape) or a legacy raw fn pointer. We detect by inspecting [rsi]: if
    // it equals -1 (list magic word) it's a closure tuple. The closure
    // calls expect `(captures_list, elem)`; legacy raw calls expect
    // `(elem)`. cg_closure_dispatch handles both branches.
    out("")
    out_label("_nova_map_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")          // closure captures_list (or 0 for legacy)
    out("    sub rsp, 8")        // 16-byte align, also reserves is_closure slot
    out("    mov r12, rdi")  // source list
    out("    mov r13, rsi")  // raw fn ptr (closure code address)
    out("    xor ebx, ebx")  // captures_list = 0
    out("    mov dword ptr [rbp - 48], 0")   // is_closure flag (pad slot)
    out("    cmp qword ptr [rsi], -1")
    out("    jne .ml_have_fn")
    out("    mov rax, [rsi + 24]")
    out("    mov r13, [rax]")        // fn_ptr from tuple[0]
    out("    mov rbx, [rax + 8]")    // captures_list from tuple[1]
    out("    mov dword ptr [rbp - 48], 1")   // mark as closure call
    out(".ml_have_fn:")
    out("    call _nova_list_new")
    out("    mov r14, rax")  // result list
    out("    xor r15d, r15d")  // index
    out(".ml_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .ml_done")
    out("    mov rax, [r12 + 24]")
    out("    cmp dword ptr [rbp - 48], 0")
    out("    je .ml_legacy")
    out("    mov rsi, [rax + r15*8]")
    out("    mov rdi, rbx")
    out("    jmp .ml_dispatch")
    out(".ml_legacy:")
    out("    mov rdi, [rax + r15*8]")
    out(".ml_dispatch:")
    out("    mov r11, r13")
    out("    call r11")
    out("    mov rsi, rax")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out("    inc r15")
    out("    jmp .ml_loop")
    out(".ml_done:")
    out("    mov rax, r14")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- filter(list, fn): new list with elements where fn returns non-zero ---
    // R37A: closure-tuple aware (see _nova_map_list for protocol).
    out("")
    out_label("_nova_filter")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor ebx, ebx")
    out("    mov dword ptr [rbp - 48], 0")
    out("    cmp qword ptr [rsi], -1")
    out("    jne .fl_have_fn")
    out("    mov rax, [rsi + 24]")
    out("    mov r13, [rax]")
    out("    mov rbx, [rax + 8]")
    out("    mov dword ptr [rbp - 48], 1")
    out(".fl_have_fn:")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r15d, r15d")
    out(".fl_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .fl_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdx, [rax + r15*8]")    // elem
    out("    push rdx")
    out("    sub rsp, 8")  // align
    out("    cmp dword ptr [rbp - 48], 0")
    out("    je .fl_legacy")
    out("    mov rsi, rdx")
    out("    mov rdi, rbx")
    out("    jmp .fl_dispatch")
    out(".fl_legacy:")
    out("    mov rdi, rdx")
    out(".fl_dispatch:")
    out("    mov r11, r13")
    out("    call r11")
    out("    add rsp, 8")
    out("    pop rdx")
    out("    test rax, rax")
    out("    jz .fl_skip")
    out("    mov rsi, rdx")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out(".fl_skip:")
    out("    inc r15")
    out("    jmp .fl_loop")
    out(".fl_done:")
    out("    mov rax, r14")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- reduce(list, fn, init): accumulate with fn(acc, elem) ---
    // R37A: closure-tuple aware. For closure path, the call shape is
    // fn(captures_list, acc, elem). For legacy raw fn ptr it's fn(acc, elem).
    out("")
    out_label("_nova_reduce")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    sub rsp, 8")
    out("    mov r12, rdi")  // list
    out("    mov r13, rsi")  // raw fn ptr
    out("    mov r14, rdx")  // accumulator
    out("    xor ebx, ebx")
    out("    mov dword ptr [rbp - 48], 0")
    out("    cmp qword ptr [rsi], -1")
    out("    jne .rd_have_fn")
    out("    mov rax, [rsi + 24]")
    out("    mov r13, [rax]")
    out("    mov rbx, [rax + 8]")
    out("    mov dword ptr [rbp - 48], 1")
    out(".rd_have_fn:")
    out("    xor r15d, r15d")
    out(".rd_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .rd_done")
    out("    mov rax, [r12 + 24]")
    out("    cmp dword ptr [rbp - 48], 0")
    out("    je .rd_legacy")
    out("    mov rdx, [rax + r15*8]")    // elem
    out("    mov rsi, r14")                // acc
    out("    mov rdi, rbx")                // captures_list
    out("    jmp .rd_dispatch")
    out(".rd_legacy:")
    out("    mov rsi, [rax + r15*8]")
    out("    mov rdi, r14")
    out(".rd_dispatch:")
    out("    mov r11, r13")
    out("    call r11")
    out("    mov r14, rax")
    out("    inc r15")
    out("    jmp .rd_loop")
    out(".rd_done:")
    out("    mov rax, r14")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- foreach(list, fn): call fn(elem) for each, return 0 ---
    // R37A: closure-tuple aware (see _nova_map_list for protocol).
    out("")
    out_label("_nova_foreach")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor ebx, ebx")
    out("    mov dword ptr [rbp - 48], 0")
    out("    cmp qword ptr [rsi], -1")
    out("    jne .fe_have_fn")
    out("    mov rax, [rsi + 24]")
    out("    mov r13, [rax]")
    out("    mov rbx, [rax + 8]")
    out("    mov dword ptr [rbp - 48], 1")
    out(".fe_have_fn:")
    out("    xor r14d, r14d")
    out(".fe_loop:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .fe_done")
    out("    mov rax, [r12 + 24]")
    out("    cmp dword ptr [rbp - 48], 0")
    out("    je .fe_legacy")
    out("    mov rsi, [rax + r14*8]")
    out("    mov rdi, rbx")
    out("    jmp .fe_dispatch")
    out(".fe_legacy:")
    out("    mov rdi, [rax + r14*8]")
    out(".fe_dispatch:")
    out("    mov r11, r13")
    out("    call r11")
    out("    inc r14")
    out("    jmp .fe_loop")
    out(".fe_done:")
    out("    xor eax, eax")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- keys(map): return list of keys ---
    out("")
    out_label("_nova_keys")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 16]")
    out("    xor ecx, ecx")
    out(".keys_loop:")
    out("    cmp rcx, r14")
    out("    jge .keys_done")
    out("    mov rax, [r12 + 24]")  // entries_ptr
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")  // occupied?
    out("    je .keys_skip")
    out("    push rcx")
    out("    mov rsi, [rdi]")  // key
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out(".keys_skip:")
    out("    inc rcx")
    out("    jmp .keys_loop")
    out(".keys_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- values(map): return list of values ---
    out("")
    out_label("_nova_values")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 16]")
    out("    xor ecx, ecx")
    out(".vals_loop:")
    out("    cmp rcx, r14")
    out("    jge .vals_done")
    out("    mov rax, [r12 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .vals_skip")
    out("    push rcx")
    out("    mov rsi, [rdi + 8]")  // value
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out(".vals_skip:")
    out("    inc rcx")
    out("    jmp .vals_loop")
    out(".vals_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_entries(map) -> flat list [k0,v0,k1,v1,...] ---
    out("")
    out_label("_nova_map_entries")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 16]")
    out("    xor ecx, ecx")
    out(".me_loop:")
    out("    cmp rcx, r14")
    out("    jge .me_done")
    out("    mov rax, [r12 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .me_skip")
    out("    push rcx")
    out("    push rdi")
    out("    mov rsi, [rdi]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rdi")
    out("    mov rsi, [rdi + 8]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out(".me_skip:")
    out("    inc rcx")
    out("    jmp .me_loop")
    out(".me_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_upper(str): uppercase a string ---
    out("")
    out_label("_nova_str_upper")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    out("    lea rdi, [rax + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    xor ecx, ecx")
    out(".su_loop:")
    out("    cmp rcx, r13")
    out("    jge .su_done")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 97")
    out("    jl .su_copy")
    out("    cmp dl, 122")
    out("    jg .su_copy")
    out("    sub dl, 32")
    out(".su_copy:")
    out("    mov rax, [rsp]")
    out("    mov [rax + rcx], dl")
    out("    inc rcx")
    out("    jmp .su_loop")
    out(".su_done:")
    out("    pop rax")
    out("    mov byte ptr [rax + r13], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_lower(str): lowercase a string ---
    out("")
    out_label("_nova_str_lower")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    out("    lea rdi, [rax + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    xor ecx, ecx")
    out(".slw_loop:")
    out("    cmp rcx, r13")
    out("    jge .slw_done")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 65")
    out("    jl .slw_copy")
    out("    cmp dl, 90")
    out("    jg .slw_copy")
    out("    add dl, 32")
    out(".slw_copy:")
    out("    mov rax, [rsp]")
    out("    mov [rax + rcx], dl")
    out("    inc rcx")
    out("    jmp .slw_loop")
    out(".slw_done:")
    out("    pop rax")
    out("    mov byte ptr [rax + r13], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_trim(str): trim leading/trailing whitespace ---
    out("")
    out_label("_nova_str_trim")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    // find start (skip whitespace)
    out("    xor ecx, ecx")
    out(".st_lead:")
    out("    cmp rcx, r13")
    out("    jge .st_empty")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 32")
    out("    je .st_lead_next")
    out("    cmp dl, 9")
    out("    je .st_lead_next")
    out("    cmp dl, 10")
    out("    je .st_lead_next")
    out("    cmp dl, 13")
    out("    je .st_lead_next")
    out("    jmp .st_find_end")
    out(".st_lead_next:")
    out("    inc rcx")
    out("    jmp .st_lead")
    out(".st_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".st_find_end:")
    out("    mov rsi, rcx")  // start
    out("    mov rcx, r13")
    out("    dec rcx")
    out(".st_trail:")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 32")
    out("    je .st_trail_next")
    out("    cmp dl, 9")
    out("    je .st_trail_next")
    out("    cmp dl, 10")
    out("    je .st_trail_next")
    out("    cmp dl, 13")
    out("    je .st_trail_next")
    out("    jmp .st_copy")
    out(".st_trail_next:")
    out("    dec rcx")
    out("    jmp .st_trail")
    out(".st_copy:")
    out("    inc rcx")
    out("    sub rcx, rsi")  // length
    out("    mov rdi, r12")
    out("    add rdi, rsi")  // src start
    out("    mov rsi, rcx")  // length
    // substr(src+start, 0, len)
    out("    push rcx")
    out("    push rdi")
    out("    lea rdi, [rcx + 1]")
    out("    call _nova_alloc")
    out("    pop rdi")
    out("    pop rcx")
    out("    push rax")
    out("    mov rsi, rdi")
    out("    pop rdi")
    out("    push rdi")
    // copy rcx bytes from rsi to rdi
    out("    xor r8d, r8d")
    out(".st_cloop:")
    out("    cmp r8, rcx")
    out("    jge .st_cdone")
    out("    movzx edx, byte ptr [rsi + r8]")
    out("    mov [rdi + r8], dl")
    out("    inc r8")
    out("    jmp .st_cloop")
    out(".st_cdone:")
    out("    pop rax")
    out("    mov byte ptr [rax + rcx], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_replace(str, old, new): replace all occurrences ---
    out("")
    out_label("_nova_str_replace")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")  // source
    out("    mov r13, rsi")  // old
    out("    mov r14, rdx")  // new
    // Get lengths
    out("    call _nova_str_len")
    out("    push rax")  // src_len
    out("    mov rdi, r13")
    out("    call _nova_str_len")
    out("    mov r15, rax")  // old_len
    // Build result string by concatenation
    out("    lea rax, [rip + _empty_str]")
    out("    push rax")  // result
    out("    xor ecx, ecx")  // i
    out("    push rcx")
    out(".sr_loop:")
    out("    mov rcx, [rsp]")  // i
    out("    mov rax, [rsp + 16]")  // src_len
    out("    cmp rcx, rax")
    out("    jge .sr_done")
    // Check if old matches at position i
    out("    mov rdi, r12")
    out("    add rdi, rcx")
    out("    mov rsi, r13")
    out("    mov rdx, r15")
    out("    call _nova_strncmp")
    out("    test rax, rax")
    out("    jnz .sr_nomatch")
    // Match found: append new string
    out("    mov rdi, [rsp + 8]")
    out("    mov rsi, r14")
    out("    call _nova_concat")
    out("    mov [rsp + 8], rax")
    out("    mov rcx, [rsp]")
    out("    add rcx, r15")
    out("    mov [rsp], rcx")
    out("    jmp .sr_loop")
    out(".sr_nomatch:")
    // Append one char
    out("    mov rcx, [rsp]")
    out("    movzx edi, byte ptr [r12 + rcx]")
    out("    call _nova_chr")
    out("    mov rsi, rax")
    out("    mov rdi, [rsp + 8]")
    out("    call _nova_concat")
    out("    mov [rsp + 8], rax")
    out("    inc qword ptr [rsp]")
    out("    jmp .sr_loop")
    out(".sr_done:")
    out("    mov rax, [rsp + 8]")
    out("    add rsp, 24")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // Helper: compare n bytes, return 0 if equal
    out("")
    out_label("_nova_strncmp")
    out("    xor ecx, ecx")
    out(".snc_loop:")
    out("    cmp rcx, rdx")
    out("    jge .snc_eq")
    out("    movzx eax, byte ptr [rdi + rcx]")
    out("    movzx r8d, byte ptr [rsi + rcx]")
    out("    cmp al, r8b")
    out("    jne .snc_neq")
    out("    inc rcx")
    out("    jmp .snc_loop")
    out(".snc_eq:")
    out("    xor eax, eax")
    out("    ret")
    out(".snc_neq:")
    out("    mov eax, 1")
    out("    ret")

    // --- str_repeat(str, n): repeat string n times ---
    out("")
    out_label("_nova_str_repeat")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    sar r13, 1")                 // untag repeat count
    out("    lea rax, [rip + _empty_str]")
    out("    push rax")
    out(".srp_loop:")
    out("    cmp r13, 0")
    out("    jle .srp_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_concat")
    out("    mov [rsp], rax")
    out("    dec r13")
    out("    jmp .srp_loop")
    out(".srp_done:")
    out("    pop rax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- char_code(str): return ASCII code of first char ---
    out("")
    out_label("_nova_char_code")
    out("    movzx eax, byte ptr [rdi]")
    out("    ret")

    // --- to_int(str): parse string to integer ---
    out("")
    out_label("_nova_to_int")
    out("    jmp _nova_str_to_int")

    // --- range_list(start, end): create list [start, start+1, ..., end-1] ---
    out("")
    out_label("_nova_range_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    push rax")
    out(".rgl_loop:")
    out("    cmp r12, r13")
    out("    jge .rgl_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_push")
    out("    add r12, 2")              // tagged counter: +1 in untagged space
    out("    jmp .rgl_loop")
    out(".rgl_done:")
    out("    pop rax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- range_step(start, end, step): create list [start, start+step, ...] ---
    out("")
    out_label("_nova_range_step")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    call _nova_list_new")
    out("    push rax")
    out("    cmp r14, 1")
    out("    je .rgs_done")
    out("    jg .rgs_pos")
    out(".rgs_neg:")
    out("    cmp r12, r13")
    out("    jle .rgs_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_push")
    out("    add r12, r14")
    out("    dec r12")                 // tagged step add
    out("    jmp .rgs_neg")
    out(".rgs_pos:")
    out("    cmp r12, r13")
    out("    jge .rgs_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_push")
    out("    add r12, r14")
    out("    dec r12")                 // tagged step add
    out("    jmp .rgs_pos")
    out(".rgs_done:")
    out("    pop rax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_copy(list): shallow copy ---
    out("")
    out_label("_nova_list_copy")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    xor ecx, ecx")
    out(".lc_loop:")
    out("    cmp rcx, [r12 + 8]")
    out("    jge .lc_done")
    out("    push rcx")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out("    inc rcx")
    out("    jmp .lc_loop")
    out(".lc_done:")
    out("    mov rax, r13")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_slice(list, start, end): sublist ---
    out("")
    out_label("_nova_list_slice")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")  // start
    out("    mov r14, rdx")  // end
    out("    call _nova_list_new")
    out("    push rax")
    out(".ls_loop:")
    out("    cmp r13, r14")
    out("    jge .ls_done")
    out("    cmp r13, [r12 + 8]")
    out("    jge .ls_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + r13*8]")
    out("    mov rdi, [rsp]")
    out("    push r13")
    out("    call _nova_push")
    out("    pop r13")
    out("    inc r13")
    out("    jmp .ls_loop")
    out(".ls_done:")
    out("    pop rax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- append_list(dst, src): append all elements of src to dst ---
    out("")
    out_label("_nova_append_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out(".al_loop:")
    out("    cmp r14, [r13 + 8]")
    out("    jge .al_done")
    out("    mov rax, [r13 + 24]")
    out("    mov rsi, [rax + r14*8]")
    out("    mov rdi, r12")
    out("    call _nova_push")
    out("    inc r14")
    out("    jmp .al_loop")
    out(".al_done:")
    out("    mov rax, r12")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- index_of(list, value): find first index of value, or -1 ---
    out("")
    out_label("_nova_index_of")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    xor eax, eax")
    out(".iof_loop:")
    out("    cmp rax, rcx")
    out("    jge .iof_notfound")
    out("    cmp [rdi + rax*8], rsi")
    out("    je .iof_found")
    out("    inc rax")
    out("    jmp .iof_loop")
    out(".iof_found:")
    out("    lea rax, [rax + rax + 1]")    // tag found index
    out("    pop rbp")
    out("    ret")
    out(".iof_notfound:")
    out("    mov rax, -1")
    out("    pop rbp")
    out("    ret")

    // --- last_index_of(list, value): find last index of value, or -1 ---
    out("")
    out_label("_nova_last_index_of")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    mov rax, rcx")
    out("    dec rax")
    out(".liof_loop:")
    out("    cmp rax, 0")
    out("    jl .liof_notfound")
    out("    cmp [rdi + rax*8], rsi")
    out("    je .liof_found")
    out("    dec rax")
    out("    jmp .liof_loop")
    out(".liof_found:")
    out("    lea rax, [rax + rax + 1]")    // tag found index
    out("    pop rbp")
    out("    ret")
    out(".liof_notfound:")
    out("    mov rax, -1")
    out("    pop rbp")
    out("    ret")

    // --- map_remove(map, key) ---
    out("")
    out_label("_nova_map_remove")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rcx, [r12 + 16]")
    out("    mov rdi, [r12 + 24]")
    out("    xor eax, eax")
    out(".mr_loop:")
    out("    cmp rax, rcx")
    out("    jge .mr_done")
    out("    imul rsi, rax, 24")
    out("    add rsi, rdi")
    out("    cmp qword ptr [rsi + 16], 0")
    out("    je .mr_next")
    out("    push rax")
    out("    push rcx")
    out("    push rdi")
    out("    mov rdi, [rsi]")
    out("    mov rsi, r13")
    out("    call _nova_eq")
    out("    pop rdi")
    out("    pop rcx")
    out("    pop rsi")
    out("    cmp rax, 1")
    out("    je .mr_next2")
    out("    imul rax, rsi, 24")
    out("    add rax, rdi")
    out("    mov qword ptr [rax + 16], 0")
    out("    dec qword ptr [r12 + 8]")
    out("    jmp .mr_done")
    out(".mr_next2:")
    out("    mov rax, rsi")
    out(".mr_next:")
    out("    inc rax")
    out("    jmp .mr_loop")
    out(".mr_done:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_count(map): return count of entries ---
    out("")
    out_label("_nova_map_count")
    out("    mov rax, [rdi + 8]")
    out("    ret")

    // --- zip(list_a, list_b): create list of [a, b] pairs ---
    out("")
    out_label("_nova_zip")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    // min length
    out("    mov rax, [r12 + 8]")
    out("    mov rcx, [r13 + 8]")
    out("    cmp rax, rcx")
    out("    cmovg rax, rcx")
    out("    mov r15, rax")
    out("    xor ecx, ecx")
    out(".zip_loop:")
    out("    cmp rcx, r15")
    out("    jge .zip_done")
    out("    push rcx")
    // create pair list
    out("    call _nova_list_new")
    out("    push rax")
    out("    mov rdi, rax")
    out("    mov rcx, [rsp + 8]")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    call _nova_push")
    out("    mov rdi, [rsp]")
    out("    mov rcx, [rsp + 8]")
    out("    mov rax, [r13 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    call _nova_push")
    // push pair to result
    out("    pop rsi")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out("    pop rcx")
    out("    inc rcx")
    out("    jmp .zip_loop")
    out(".zip_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- enumerate(list) -> list of [idx, val] pairs ---
    out("")
    out_label("_nova_enumerate")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 8]")
    out("    xor ecx, ecx")
    out(".enum_loop:")
    out("    cmp rcx, r14")
    out("    jge .enum_done")
    out("    push rcx")
    out("    call _nova_list_new")
    out("    push rax")
    out("    mov rdi, rax")
    out("    mov rsi, [rsp + 8]")
    out("    lea rsi, [rsi + rsi + 1]")    // tag index for the pair
    out("    call _nova_push")
    out("    mov rdi, [rsp]")
    out("    mov rcx, [rsp + 8]")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    call _nova_push")
    out("    pop rsi")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out("    inc rcx")
    out("    jmp .enum_loop")
    out(".enum_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- pad_left(str, width, fill_char) ---
    out("")
    out_label("_nova_pad_left")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    mov rdi, r12")
    out("    call _nova_strlen")
    out("    cmp rax, r13")
    out("    jge .pl_ret_orig")
    out("    mov rcx, r13")
    out("    sub rcx, rax")
    out("    push rcx")
    out("    push rax")
    out("    lea rdi, [r13 + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    pop rdi")
    out("    pop rax")
    out("    pop rcx")
    out("    push rdi")
    out("    push rax")
    out("    mov rsi, r14")
    out("    mov al, [rsi]")
    out("    mov rsi, rdi")
    out(".pl_fill:")
    out("    test rcx, rcx")
    out("    jz .pl_copy")
    out("    mov [rsi], al")
    out("    inc rsi")
    out("    dec rcx")
    out("    jmp .pl_fill")
    out(".pl_copy:")
    out("    mov rdi, rsi")
    out("    mov rsi, r12")
    out("    pop rcx")
    out("    rep movsb")
    out("    mov byte ptr [rdi], 0")
    out("    pop rax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".pl_ret_orig:")
    out("    mov rax, r12")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- pad_right(str, width, fill_char) ---
    out("")
    out_label("_nova_pad_right")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    mov rdi, r12")
    out("    call _nova_strlen")
    out("    cmp rax, r13")
    out("    jge .pr_ret_orig")
    out("    mov rcx, r13")
    out("    sub rcx, rax")
    out("    push rcx")
    out("    push rax")
    out("    lea rdi, [r13 + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out("    mov rcx, [rsp + 8]")
    out("    rep movsb")
    out("    mov rsi, r14")
    out("    mov al, [rsi]")
    out("    mov rcx, [rsp + 16]")
    out(".pr_fill:")
    out("    test rcx, rcx")
    out("    jz .pr_end")
    out("    mov [rdi], al")
    out("    inc rdi")
    out("    dec rcx")
    out("    jmp .pr_fill")
    out(".pr_end:")
    out("    mov byte ptr [rdi], 0")
    out("    pop rax")
    out("    add rsp, 16")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".pr_ret_orig:")
    out("    mov rax, r12")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_count(haystack, needle) -> count of occurrences ---
    out("")
    out_label("_nova_str_count")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    push rax")
    out(".sc_loop:")
    out("    mov rdi, r12")
    out("    mov rsi, r13")
    out("    call _nova_str_find")
    out("    cmp rax, 0")
    out("    jl .sc_done")
    out("    inc r14")
    out("    add r12, rax")
    out("    add r12, [rsp]")
    out("    jmp .sc_loop")
    out(".sc_done:")
    out("    mov rax, r14")
    out("    add rsp, 8")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- flat_map(list, fn): map then flatten one level ---
    // R37A: closure-tuple aware (see _nova_map_list for protocol).
    out("")
    out_label("_nova_flat_map")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor ebx, ebx")
    out("    mov dword ptr [rbp - 48], 0")
    out("    cmp qword ptr [rsi], -1")
    out("    jne .fm_have_fn")
    out("    mov rax, [rsi + 24]")
    out("    mov r13, [rax]")
    out("    mov rbx, [rax + 8]")
    out("    mov dword ptr [rbp - 48], 1")
    out(".fm_have_fn:")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r15d, r15d")
    out(".fm_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .fm_done")
    out("    mov rax, [r12 + 24]")
    out("    cmp dword ptr [rbp - 48], 0")
    out("    je .fm_legacy")
    out("    mov rsi, [rax + r15*8]")
    out("    mov rdi, rbx")
    out("    jmp .fm_dispatch")
    out(".fm_legacy:")
    out("    mov rdi, [rax + r15*8]")
    out(".fm_dispatch:")
    out("    mov r11, r13")
    out("    call r11")
    // result should be a list, append its elements
    out("    cmp qword ptr [rax], -1")
    out("    jne .fm_single")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_append_list")
    out("    jmp .fm_next")
    out(".fm_single:")
    out("    mov rsi, rax")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out(".fm_next:")
    out("    inc r15")
    out("    jmp .fm_loop")
    out(".fm_done:")
    out("    mov rax, r14")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- any(list, fn): returns 1 if fn returns true for any element ---
    // R37A: closure-tuple aware (see _nova_map_list for protocol).
    out("")
    out_label("_nova_any")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor ebx, ebx")
    out("    mov dword ptr [rbp - 48], 0")
    out("    cmp qword ptr [rsi], -1")
    out("    jne .any_have_fn")
    out("    mov rax, [rsi + 24]")
    out("    mov r13, [rax]")
    out("    mov rbx, [rax + 8]")
    out("    mov dword ptr [rbp - 48], 1")
    out(".any_have_fn:")
    out("    xor r14d, r14d")
    out(".any_loop:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .any_false")
    out("    mov rax, [r12 + 24]")
    out("    cmp dword ptr [rbp - 48], 0")
    out("    je .any_legacy")
    out("    mov rsi, [rax + r14*8]")
    out("    mov rdi, rbx")
    out("    jmp .any_dispatch")
    out(".any_legacy:")
    out("    mov rdi, [rax + r14*8]")
    out(".any_dispatch:")
    out("    mov r11, r13")
    out("    call r11")
    out("    test rax, rax")
    out("    jnz .any_true")
    out("    inc r14")
    out("    jmp .any_loop")
    out(".any_true:")
    out("    mov eax, 1")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".any_false:")
    out("    xor eax, eax")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- all(list, fn): returns 1 if fn returns true for all elements ---
    // R37A: closure-tuple aware (see _nova_map_list for protocol).
    out("")
    out_label("_nova_all")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor ebx, ebx")
    out("    mov dword ptr [rbp - 48], 0")
    out("    cmp qword ptr [rsi], -1")
    out("    jne .all_have_fn")
    out("    mov rax, [rsi + 24]")
    out("    mov r13, [rax]")
    out("    mov rbx, [rax + 8]")
    out("    mov dword ptr [rbp - 48], 1")
    out(".all_have_fn:")
    out("    xor r14d, r14d")
    out(".all_loop:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .all_true")
    out("    mov rax, [r12 + 24]")
    out("    cmp dword ptr [rbp - 48], 0")
    out("    je .all_legacy")
    out("    mov rsi, [rax + r14*8]")
    out("    mov rdi, rbx")
    out("    jmp .all_dispatch")
    out(".all_legacy:")
    out("    mov rdi, [rax + r14*8]")
    out(".all_dispatch:")
    out("    mov r11, r13")
    out("    call r11")
    out("    test rax, rax")
    out("    jz .all_false")
    out("    inc r14")
    out("    jmp .all_loop")
    out(".all_true:")
    out("    mov eax, 1")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".all_false:")
    out("    xor eax, eax")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- sum(list): sum all integer elements ---
    out("")
    out_label("_nova_sum")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    xor eax, eax")
    out(".sum_loop:")
    out("    test rcx, rcx")
    out("    jz .sum_done")
    out("    add rax, [rdi]")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    jmp .sum_loop")
    out(".sum_done:")
    out("    pop rbp")
    out("    ret")

    // --- product(list): multiply all elements ---
    out("")
    out_label("_nova_product")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    mov rax, 1")
    out(".prod_loop:")
    out("    test rcx, rcx")
    out("    jz .prod_done")
    out("    imul rax, [rdi]")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    jmp .prod_loop")
    out(".prod_done:")
    out("    pop rbp")
    out("    ret")

    // --- min_list(list): find minimum element ---
    out("")
    out_label("_nova_min_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    test rcx, rcx")
    out("    jz .minl_empty")
    out("    mov rdi, [rdi + 24]")
    out("    mov rax, [rdi]")
    out("    add rdi, 8")
    out("    dec rcx")
    out(".minl_loop:")
    out("    test rcx, rcx")
    out("    jz .minl_done")
    out("    cmp [rdi], rax")
    out("    jge .minl_skip")
    out("    mov rax, [rdi]")
    out(".minl_skip:")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    jmp .minl_loop")
    out(".minl_empty:")
    out("    xor eax, eax")
    out(".minl_done:")
    out("    pop rbp")
    out("    ret")

    // --- max_list(list): find maximum element ---
    out("")
    out_label("_nova_max_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    test rcx, rcx")
    out("    jz .maxl_empty")
    out("    mov rdi, [rdi + 24]")
    out("    mov rax, [rdi]")
    out("    add rdi, 8")
    out("    dec rcx")
    out(".maxl_loop:")
    out("    test rcx, rcx")
    out("    jz .maxl_done")
    out("    cmp [rdi], rax")
    out("    jle .maxl_skip")
    out("    mov rax, [rdi]")
    out(".maxl_skip:")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    jmp .maxl_loop")
    out(".maxl_empty:")
    out("    xor eax, eax")
    out(".maxl_done:")
    out("    pop rbp")
    out("    ret")

    // --- flatten(list): flatten one level of nesting ---
    out("")
    out_label("_nova_flatten")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    xor r14d, r14d")
    out(".flat_outer:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .flat_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r14*8]")
    out("    call _nova_check_rdi")
    out("    jz .flat_push_one")
    out("    cmp qword ptr [rdi], -1")
    out("    jne .flat_push_one")
    out("    push r14")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    push rdi")
    out("    push rcx")
    out(".flat_inner:")
    out("    pop rcx")
    out("    pop rdi")
    out("    test rcx, rcx")
    out("    jz .flat_inner_done")
    out("    mov rsi, [rdi]")
    out("    push rcx")
    out("    push rdi")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rdi")
    out("    pop rcx")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    push rdi")
    out("    push rcx")
    out("    jmp .flat_inner")
    out(".flat_inner_done:")
    out("    pop r14")
    out("    inc r14")
    out("    jmp .flat_outer")
    out(".flat_push_one:")
    out("    push r14")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + r14*8]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop r14")
    out("    inc r14")
    out("    jmp .flat_outer")
    out(".flat_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- unique(list): return list with duplicates removed ---
    out("")
    out_label("_nova_unique")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    xor r14d, r14d")
    out(".uniq_outer:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .uniq_done")
    out("    mov rax, [r12 + 24]")
    out("    mov r15, [rax + r14*8]")
    out("    mov rdi, r13")
    out("    mov rsi, r15")
    out("    push r14")
    out("    call _nova_contains")
    out("    pop r14")
    out("    test rax, rax")
    out("    jnz .uniq_skip")
    out("    mov rdi, r13")
    out("    mov rsi, r15")
    out("    push r14")
    out("    call _nova_push")
    out("    pop r14")
    out(".uniq_skip:")
    out("    inc r14")
    out("    jmp .uniq_outer")
    out(".uniq_done:")
    out("    mov rax, r13")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_merge(m1, m2): return new map with all entries from both ---
