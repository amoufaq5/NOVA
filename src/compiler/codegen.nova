    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_map_new")
    out("    mov r14, rax")
    out("    mov r15, [r12 + 16]")
    out("    xor ecx, ecx")
    out(".mm_loop1:")
    out("    cmp rcx, r15")
    out("    jge .mm_phase2")
    out("    mov rax, [r12 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .mm_skip1")
    out("    push rcx")
    out("    mov rsi, [rdi]")
    out("    mov rdx, [rdi + 8]")
    out("    mov rdi, r14")
    out("    call _nova_map_set")
    out("    pop rcx")
    out(".mm_skip1:")
    out("    inc rcx")
    out("    jmp .mm_loop1")
    out(".mm_phase2:")
    out("    mov r15, [r13 + 16]")
    out("    xor ecx, ecx")
    out(".mm_loop2:")
    out("    cmp rcx, r15")
    out("    jge .mm_done")
    out("    mov rax, [r13 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .mm_skip2")
    out("    push rcx")
    out("    mov rsi, [rdi]")
    out("    mov rdx, [rdi + 8]")
    out("    mov rdi, r14")
    out("    call _nova_map_set")
    out("    pop rcx")
    out(".mm_skip2:")
    out("    inc rcx")
    out("    jmp .mm_loop2")
    out(".mm_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

