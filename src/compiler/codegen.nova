// Nova Compiler: x86-64 Code Generator
// Emits GAS Intel syntax assembly.
// Strategy: stack-based evaluation, variables on stack frame.
// Globals accessed via RIP-relative addressing in .bss.

let NL = chr(10)
let DQ = chr(34)
let PTR_THRESHOLD = "100000"
let cg_has_flow = 0
let cg_target = 0
let cg_output = ""
let cg_label_count = 0
let cg_strings = 0
let cg_str_count = 0
let cg_locals = 0
let cg_local_count = 0
let cg_params = 0
let cg_param_count = 0
let cg_fns = 0
let cg_globals = 0
let cg_global_count = 0
let cg_break_label = ""
let cg_continue_label = ""
let cg_catch_label = ""
let cg_structs = 0
let cg_struct_count = 0
let cg_enums = 0
let cg_enum_count = 0
let cg_lambda_caps = 0
let cg_capture_slots = 0
let cg_current_caps = 0
let cg_current_cap_name = ""
// R37A: closures lower to `[fn_ptr, captures_list]` tuples; captures_list[i]
// holds a 1-element BOX list whose [0] slot is the captured variable's
// storage. The enclosing scope must allocate the box at the let-stmt that
// declares a captured local so that source-scope reads/writes go through
// the same box (by-ref capture). cg_boxed_fns / cg_boxed_locals_per_fn
// is the pre-computed [fn_name, [boxed_local_names...]] table; the active
// per-function set is loaded into cg_boxed_locals before gen_function().
let cg_boxed_fns = 0
let cg_boxed_locals_per_fn = 0
let cg_boxed_locals = 0
let cg_boxed_locals_count = 0
let cg_lbl_names = 0
let cg_lbl_breaks = 0
let cg_lbl_continues = 0
let cg_lbl_count = 0
let cg_methods = 0
let cg_method_count = 0
let cg_externs = 0
let cg_extern_count = 0
let cg_debug = 1
let cg_source_file = ""
let cg_last_debug_line = 0
let cg_current_fn = ""
let cg_tco_label = ""
let cg_defers = 0
let cg_defer_count = 0
let cg_link_libc = 0
let cg_float_consts = 0
let cg_float_int_parts = 0
let cg_float_frac_parts = 0
let cg_float_frac_digits = 0
// R38A: scientific-notation exponent for each pooled float constant.
// Parallel array to cg_float_int_parts etc.; 0 for non-scientific
// literals.
let cg_float_exponents = 0
let cg_float_count = 0
let cg_float_vars = 0
let cg_float_var_count = 0
let cg_fns_ht = 0
let cg_fn_modules = 0
// DWARF .debug_info per-function metadata. Each entry in cg_dbg_fns is a
// list shaped [name, start_label, end_label, src_line, locals_names,
// locals_offsets, locals_param_flags]. Filled in by gen_function; consumed
// after all functions are emitted by cg_emit_debug_info_section. Only
// populated on the Linux ELF target with cg_debug == 1.
let cg_dbg_fns = 0
let cg_dbg_count = 0
let cg_dbg_fn_seq = 0
let CG_HT_SIZE = 8

fn _cg_ht_new() {
    let ht = list_new()
    let i = 0
    while i < CG_HT_SIZE {
        push(ht, list_new())
        i = i + 1
    }
    return ht
}

fn _cg_ht_hash(name) {
    return len(name) % CG_HT_SIZE
}

fn _cg_ht_add(ht, name) {
    let b = _cg_ht_hash(name)
    push(ht[b], name)
    return 0
}

fn _cg_ht_has(ht, name) {
    if name == 0 { return 0 }
    let b = _cg_ht_hash(name)
    let entries = ht[b]
    let i = 0
    while i < len(entries) {
        if entries[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

fn _cg_ht_set(ht, key, val) {
    let b = _cg_ht_hash(key)
    let entries = ht[b]
    let i = 0
    while i < len(entries) {
        if entries[i] == key {
            entries[i + 1] = val
            return 0
        }
        i = i + 2
    }
    push(entries, key)
    push(entries, val)
    return 0
}

fn _cg_ht_get(ht, key) {
    if key == 0 { return 0 }
    let b = _cg_ht_hash(key)
    let entries = ht[b]
    let i = 0
    while i < len(entries) {
        if entries[i] == key { return entries[i + 1] }
        i = i + 2
    }
    return 0
}

fn cg_init() {
    cg_output = list_new()
    cg_label_count = 0
    cg_strings = list_new()
    cg_str_count = 0
    cg_fns = list_new()
    cg_globals = list_new()
    cg_global_count = 0
    cg_structs = list_new()
    cg_struct_count = 0
    cg_enums = list_new()
    cg_enum_count = 0
    cg_lambda_caps = list_new()
    cg_capture_slots = list_new()
    cg_boxed_fns = list_new()
    cg_boxed_locals_per_fn = list_new()
    cg_boxed_locals = list_new()
    cg_boxed_locals_count = 0
    cg_current_caps = 0
    cg_current_cap_name = ""
    cg_lbl_names = list_new()
    cg_lbl_breaks = list_new()
    cg_lbl_continues = list_new()
    cg_lbl_count = 0
    cg_methods = list_new()
    cg_method_count = 0
    cg_externs = list_new()
    cg_extern_count = 0
    cg_last_debug_line = 0
    cg_has_flow = 0
    cg_float_consts = list_new()
    cg_float_int_parts = list_new()
    cg_float_frac_parts = list_new()
    cg_float_frac_digits = list_new()
    cg_float_exponents = list_new()
    cg_float_count = 0
    cg_float_vars = list_new()
    cg_float_var_count = 0
    cg_fns_ht = _cg_ht_new()
    cg_fn_modules = _cg_ht_new()
    cg_dbg_fns = list_new()
    cg_dbg_count = 0
    cg_dbg_fn_seq = 0
}

fn out(s) {
    push(cg_output, s)
}

fn out_label(name) {
    push(cg_output, name + ":")
}

fn out_globl(name) {
    out(".globl " + name)
}

fn out_section(sect) {
    if cg_target == 1 {
        if sect == "text" { out(".section __TEXT,__text") }
        if sect == "rodata" { out(".section __TEXT,__const") }
        if sect == "bss" { out(".section __DATA,__bss") }
    } else {
        if cg_target == 3 {
            if sect == "text" { out(".section .text,\"xr\"") }
            if sect == "rodata" { out(".section .rdata,\"dr\"") }
            if sect == "bss" { out(".section .bss,\"bw\"") }
        } else {
            if sect == "text" { out(".text") }
            if sect == "rodata" { out(".section .rodata") }
            if sect == "bss" { out(".section .bss") }
        }
    }
}

// Emit a DWARF .loc directive mapping the next instruction's PC to a
// (file=1, line=src_line) tuple. GAS turns these into a real .debug_line
// section on Linux ELF. On Windows PE/macOS Mach-O it is harmless: GAS-
// compatible assemblers (MinGW as, clang -target x86_64-apple-darwin)
// accept the directive but the resulting line table is best-effort
// — full Windows CodeView / Mach-O __debug_line is deferred (see
// DWARF_AUDIT.md).
//
// The `src_line < 1000000` cap is a sanity bound against bogus parser
// data; the old 4096 cap silently truncated DWARF for the bootstrapped
// compiler (15k+ lines) which broke step-through past line 4095.
fn cg_emit_loc(nd) {
    if cg_debug == 1 {
        if len(cg_source_file) > 0 {
            let ndlen = len(nd)
            if ndlen > 2 {
                let src_line = nd[ndlen - 1]
                if src_line > 0 {
                    if src_line < 1000000 {
                        if src_line == cg_last_debug_line {
                        } else {
                            out("    .loc 1 " + int_to_str(src_line) + " 0")
                            cg_last_debug_line = src_line
                        }
                    }
                }
            }
        }
    }
}

// DWARF .debug_info / .debug_abbrev emission.
//
// We layer real DIE entries on top of the .debug_line MVP so that gdb can
// answer `info locals`, `p localvar`, and the DAP adapter's `variables`
// request at NOVA breakpoints. Scope of this MVP:
//
//   * Compile unit (DW_TAG_compile_unit) with name/producer/language/
//     low_pc/high_pc/stmt_list.
//   * Per NOVA function: DW_TAG_subprogram with name + low_pc/high_pc +
//     frame_base (rbp). Parameters and locals appear as child DIEs
//     (DW_TAG_formal_parameter / DW_TAG_variable) with name + type + a
//     DW_OP_fbreg location expression keyed off rbp.
//   * Four base types: int (8-byte signed), str (8-byte address), list
//     (8-byte address), bool (1-byte). Every variable points at one of
//     these via DW_AT_type (DW_FORM_ref4 within the CU).
//
// Encoding: DWARF 4. We use DW_FORM_string for names (zero-terminated,
// emitted via `.asciz`) to keep things simple — no separate .debug_str.
// CU length is computed at link/assemble time via the
// `.Lnova_cu_end - .Lnova_cu_start` expression GAS supports. Per-DIE type
// refs use named labels for ref4 offsets so the assembler resolves them.
//
// Only emitted on Linux ELF (cg_target == 0). Mach-O / PE DWARF wiring is
// deferred (DWARF_AUDIT.md).

// Encode a single DWARF abbreviation declaration as a sequence of GAS
// directives. `code` is the abbrev number (>0), `tag` is the DW_TAG_*
// constant, `children` is 1 if the DIE has children else 0. The caller is
// expected to follow up with cg_dwarf_abbrev_attr() per attribute and then
// cg_dwarf_abbrev_end() to write the (0,0) terminator pair.
fn cg_dwarf_abbrev_decl(code, tag, children) {
    out("    .uleb128 " + int_to_str(code))
    out("    .uleb128 " + int_to_str(tag))
    out("    .byte " + int_to_str(children))
}

fn cg_dwarf_abbrev_attr(attr, form) {
    out("    .uleb128 " + int_to_str(attr))
    out("    .uleb128 " + int_to_str(form))
}

fn cg_dwarf_abbrev_end() {
    out("    .uleb128 0")
    out("    .uleb128 0")
}

// Emit a DW_FORM_exprloc value: a .uleb128 length followed by length bytes
// of DWARF expression. The expression is a sequence of (op, operand) pairs.
// For our needs we only need DW_OP_fbreg (0x91) + sleb128 offset, and
// DW_OP_reg6 (0x56) for frame_base = rbp.

// Emit a DW_TAG_base_type DIE. The abbrev (code 4) is: name (string),
// byte_size (data1), encoding (data1). Anchored at a label so other DIEs
// can DW_AT_type-reference it.
fn cg_dwarf_base_type(label, name, byte_size, encoding) {
    out(label + ":")
    out("    .uleb128 4")        // abbrev code: base_type
    out("    .asciz " + DQ + name + DQ)
    out("    .byte " + int_to_str(byte_size))
    out("    .byte " + int_to_str(encoding))
}

// Emit one variable DIE (either DW_TAG_variable or DW_TAG_formal_parameter).
// `abbrev_code` selects which abbrev to use. `rbp_offset` is the positive
// offset such that the variable lives at [rbp - rbp_offset]; we encode it
// as a negative SLEB128 in a DW_OP_fbreg expression. `type_label` is the
// .debug_info label of the type DIE this variable refers to.
//
// NOTE: kept for completeness; the per-function emission inside
// cg_dwarf_subprogram inlines this with per-function-scoped labels so the
// same local name in two functions cannot collide.
fn cg_dwarf_variable(abbrev_code, name, type_label, rbp_offset) {
    out("    .uleb128 " + int_to_str(abbrev_code))
    out("    .asciz " + DQ + name + DQ)
    out("    .long " + type_label + " - .Lnova_cu_header_start")
    out("    .uleb128 .Lnova_loc_end_" + name + "_" + int_to_str(rbp_offset) + " - .Lnova_loc_start_" + name + "_" + int_to_str(rbp_offset))
    out(".Lnova_loc_start_" + name + "_" + int_to_str(rbp_offset) + ":")
    out("    .byte 0x91")         // DW_OP_fbreg
    out("    .sleb128 " + int_to_str(0 - rbp_offset))
    out(".Lnova_loc_end_" + name + "_" + int_to_str(rbp_offset) + ":")
}

// Emit a DW_TAG_subprogram DIE plus its child variable DIEs, then the
// children terminator (a single zero byte).
fn cg_dwarf_subprogram(fn_entry) {
    let fn_name = fn_entry[0]
    let start_lbl = fn_entry[1]
    let end_lbl = fn_entry[2]
    let names = fn_entry[4]
    let offs = fn_entry[5]
    let pflags = fn_entry[6]

    out("    .uleb128 2")           // abbrev code: subprogram
    out("    .asciz " + DQ + fn_name + DQ)
    out("    .quad " + start_lbl)   // low_pc
    out("    .quad " + end_lbl)     // high_pc (DW_FORM_addr — absolute)
    // frame_base = DW_OP_reg6 (rbp). exprloc length is 1 byte.
    out("    .uleb128 1")
    out("    .byte 0x56")           // DW_OP_reg6
    // Now emit children: formal_parameter DIEs first, then variable DIEs.
    // We disambiguate per-variable location labels by appending the
    // function name AND the variable's slot index. Two reasons:
    //   * Two functions both using a local `i` would otherwise collide
    //     (different functions, same name).
    //   * Inside a single function, `let nxt =` declared in two sibling
    //     while bodies ends up listed twice in cg_locals (collect_locals
    //     walks each block). We dedup by name here — only the *first*
    //     occurrence becomes a DIE, since the codegen's local_offset()
    //     also returns the first slot's offset. This keeps `info locals`
    //     output clean (one entry per source name).
    let seen = list_new()
    let vi = 0
    while vi < len(names) {
        let vname = names[vi]
        let voff = offs[vi]
        let isp = pflags[vi]
        // Skip duplicate names within the same function.
        let dup = 0
        let sii = 0
        while sii < len(seen) {
            if seen[sii] == vname { dup = 1 }
            sii = sii + 1
        }
        if dup == 0 {
            push(seen, vname)
            let abbr = 3                 // variable
            if isp == 1 { abbr = 5 }     // formal_parameter
            // Sanitize vname for label use (NOVA idents are already
            // alnum/_; the sanitizer is a guard).
            let safe = cg_dwarf_sanitize(vname)
            let safe_fn = cg_dwarf_sanitize(fn_name)
            let suffix = safe_fn + "_" + safe + "_" + int_to_str(vi)
            out("    .uleb128 " + int_to_str(abbr))
            out("    .asciz " + DQ + vname + DQ)
            out("    .long .Lnova_dt_int - .Lnova_cu_header_start")
            out("    .uleb128 .Lnova_loc_e_" + suffix + " - .Lnova_loc_s_" + suffix)
            out(".Lnova_loc_s_" + suffix + ":")
            out("    .byte 0x91")        // DW_OP_fbreg
            out("    .sleb128 " + int_to_str(0 - voff))
            out(".Lnova_loc_e_" + suffix + ":")
        }
        vi = vi + 1
    }
    // End-of-children marker for this subprogram.
    out("    .byte 0")
}

// Sanitize an identifier so it is safe to splice into a GAS local label.
// NOVA identifiers are [A-Za-z_][A-Za-z0-9_]*, so this is mostly a guard
// against any future relaxation of the grammar.
fn cg_dwarf_sanitize(name) {
    let out_s = ""
    let i = 0
    while i < len(name) {
        let c = char_at(name, i)
        let ok = 0
        if c >= 48 { if c <= 57 { ok = 1 } }            // 0-9
        if c >= 65 { if c <= 90 { ok = 1 } }            // A-Z
        if c >= 97 { if c <= 122 { ok = 1 } }           // a-z
        if c == 95 { ok = 1 }                            // _
        if ok == 1 {
            out_s = out_s + chr(c)
        } else {
            out_s = out_s + "_"
        }
        i = i + 1
    }
    return out_s
}

// Emit the .debug_abbrev section. Five abbrev entries:
//   1: compile_unit (children=YES)        2: subprogram (children=YES)
//   3: variable (children=NO)             4: base_type (children=NO)
//   5: formal_parameter (children=NO)
// DWARF 4 tag/attr/form constants used:
//   tags: 0x11 compile_unit, 0x2e subprogram, 0x34 variable,
//         0x24 base_type, 0x05 formal_parameter
//   attrs: 0x03 name, 0x0b byte_size, 0x3e encoding, 0x49 type,
//          0x02 location, 0x11 low_pc, 0x12 high_pc, 0x40 frame_base,
//          0x25 producer, 0x13 language, 0x10 stmt_list
//   forms: 0x01 addr, 0x06 data4, 0x0b data1, 0x05 data2, 0x08 string,
//          0x13 ref4, 0x17 sec_offset, 0x18 exprloc
fn cg_emit_debug_abbrev_section() {
    out("")
    out(".section .debug_abbrev,\"\",@progbits")
    // Abbrev 1: compile_unit, children=YES
    cg_dwarf_abbrev_decl(1, 17, 1)
    cg_dwarf_abbrev_attr(37, 8)    // DW_AT_producer DW_FORM_string
    cg_dwarf_abbrev_attr(19, 5)    // DW_AT_language DW_FORM_data2
    cg_dwarf_abbrev_attr(3, 8)     // DW_AT_name DW_FORM_string
    cg_dwarf_abbrev_attr(17, 1)    // DW_AT_low_pc DW_FORM_addr
    cg_dwarf_abbrev_attr(18, 1)    // DW_AT_high_pc DW_FORM_addr
    cg_dwarf_abbrev_attr(16, 23)   // DW_AT_stmt_list DW_FORM_sec_offset
    cg_dwarf_abbrev_end()
    // Abbrev 2: subprogram, children=YES
    cg_dwarf_abbrev_decl(2, 46, 1)
    cg_dwarf_abbrev_attr(3, 8)     // DW_AT_name DW_FORM_string
    cg_dwarf_abbrev_attr(17, 1)    // DW_AT_low_pc DW_FORM_addr
    cg_dwarf_abbrev_attr(18, 1)    // DW_AT_high_pc DW_FORM_addr
    cg_dwarf_abbrev_attr(64, 24)   // DW_AT_frame_base DW_FORM_exprloc
    cg_dwarf_abbrev_end()
    // Abbrev 3: variable, children=NO
    cg_dwarf_abbrev_decl(3, 52, 0)
    cg_dwarf_abbrev_attr(3, 8)     // DW_AT_name DW_FORM_string
    cg_dwarf_abbrev_attr(73, 19)   // DW_AT_type DW_FORM_ref4
    cg_dwarf_abbrev_attr(2, 24)    // DW_AT_location DW_FORM_exprloc
    cg_dwarf_abbrev_end()
    // Abbrev 4: base_type, children=NO
    cg_dwarf_abbrev_decl(4, 36, 0)
    cg_dwarf_abbrev_attr(3, 8)     // DW_AT_name DW_FORM_string
    cg_dwarf_abbrev_attr(11, 11)   // DW_AT_byte_size DW_FORM_data1
    cg_dwarf_abbrev_attr(62, 11)   // DW_AT_encoding DW_FORM_data1
    cg_dwarf_abbrev_end()
    // Abbrev 5: formal_parameter, children=NO
    cg_dwarf_abbrev_decl(5, 5, 0)
    cg_dwarf_abbrev_attr(3, 8)     // DW_AT_name DW_FORM_string
    cg_dwarf_abbrev_attr(73, 19)   // DW_AT_type DW_FORM_ref4
    cg_dwarf_abbrev_attr(2, 24)    // DW_AT_location DW_FORM_exprloc
    cg_dwarf_abbrev_end()
    // Abbrev list terminator (single zero ULEB128).
    out("    .uleb128 0")
}

// Emit the .debug_info section: one CU header, one CU DIE with five base
// type DIEs as children, then one subprogram DIE per NOVA function. Each
// subprogram has formal_parameter + variable DIEs as children.
//
// CU length is encoded as `.long end - start - 4` per DWARF (the length
// field itself is excluded). end - start - 4 is computed via the label
// pair (.Lnova_cu_end, .Lnova_cu_after_len).
fn cg_emit_debug_info_section() {
    out("")
    out(".section .debug_info,\"\",@progbits")
    // CU header: unit_length (4 bytes), version (2), debug_abbrev_offset
    // (4 = sec_offset), address_size (1). Then the CU DIE. The
    // .Lnova_cu_header_start label is the *base* for DW_FORM_ref4 offsets
    // — the DWARF 4 spec defines ref4 as "an offset from the first byte
    // of the compilation header for the compilation unit containing the
    // reference" (DWARF 4 §7.5.4). That is the unit_length field, not
    // the start of the DIE area.
    out(".Lnova_cu_header_start:")
    out("    .long .Lnova_cu_end - .Lnova_cu_after_len")
    out(".Lnova_cu_after_len:")
    out("    .short 4")                          // DWARF version 4
    out("    .long 0")                            // .debug_abbrev offset 0
    out("    .byte 8")                            // address size (x86-64)
    out(".Lnova_cu_start:")
    // CU DIE — abbrev 1.
    out("    .uleb128 1")
    out("    .asciz " + DQ + "NOVA self-hosted compiler" + DQ)   // producer
    out("    .short 12")                          // DW_LANG_Python (close enough; gdb-friendly)
    out("    .asciz " + DQ + cg_source_file + DQ)               // name
    // low_pc = address of first function (or 0 if none). high_pc = address
    // past the last function. We use the labels emitted around the
    // outermost function span. Fall back to a 0/0 range if no functions
    // were emitted (top-level only).
    if cg_dbg_count > 0 {
        let first = cg_dbg_fns[0]
        let last = cg_dbg_fns[cg_dbg_count - 1]
        out("    .quad " + first[1])              // low_pc = first start
        out("    .quad " + last[2])               // high_pc = last end
    } else {
        out("    .quad 0")
        out("    .quad 0")
    }
    out("    .long 0")                            // stmt_list = start of .debug_line

    // Base type DIEs (children of the CU). Encodings: 5 = signed,
    // 1 = address, 2 = boolean. NOVA's runtime treats list and str as
    // 8-byte pointers; emit those as DW_ATE_address for gdb so `p` prints
    // them as addresses by default. `int` is a 64-bit signed scalar; gdb
    // will print decimal. `bool` is the standard 1-byte boolean.
    cg_dwarf_base_type(".Lnova_dt_int", "int", 8, 5)
    cg_dwarf_base_type(".Lnova_dt_str", "str", 8, 1)
    cg_dwarf_base_type(".Lnova_dt_list", "list", 8, 1)
    cg_dwarf_base_type(".Lnova_dt_bool", "bool", 1, 2)

    // Subprogram DIEs (also children of the CU).
    let si = 0
    while si < cg_dbg_count {
        cg_dwarf_subprogram(cg_dbg_fns[si])
        si = si + 1
    }

    // End-of-CU-children terminator (single zero byte).
    out("    .byte 0")
    out(".Lnova_cu_end:")
}

fn syscall_num(linux_num) {
    if cg_target == 0 { return linux_num }
    // macOS: 0x2000000 + BSD number
    if linux_num == 0 { return 33554435 }
    if linux_num == 1 { return 33554436 }
    if linux_num == 2 { return 33554437 }
    if linux_num == 3 { return 33554438 }
    if linux_num == 4 { return 33554620 }
    if linux_num == 9 { return 33554629 }
    if linux_num == 22 { return 33554474 }
    if linux_num == 39 { return 33554452 }   // getpid (BSD 20)
    if linux_num == 41 { return 33554529 }
    if linux_num == 62 { return 33554469 }   // kill  (BSD 37)
    if linux_num == 93 { return 33554525 }
    if linux_num == 42 { return 33554530 }
    if linux_num == 43 { return 33554462 }
    if linux_num == 44 { return 33554565 }   // sendto (BSD 133) — R28C UDP
    if linux_num == 45 { return 33554461 }   // recvfrom (BSD 29) — R28C UDP
    if linux_num == 49 { return 33554536 }
    if linux_num == 50 { return 33554538 }
    if linux_num == 54 { return 33554537 }   // setsockopt (BSD 105) — R28C UDP
    if linux_num == 7  { return 33554662 }   // poll (BSD 230) — R28C UDP timeout
    if linux_num == 72 { return 33554524 }   // fcntl (BSD 92) — R31A nonblock
    if linux_num == 55 { return 33554550 }   // getsockopt (BSD 118) — R31A SO_ERROR
    if linux_num == 57 { return 33554434 }
    if linux_num == 59 { return 33554491 }
    if linux_num == 60 { return 33554433 }
    if linux_num == 61 { return 33554439 }
    if linux_num == 83 { return 33554568 }
    if linux_num == 87 { return 33554442 }
    if linux_num == 112 { return 33554579 } // setsid (BSD 147)
    if linux_num == 228 { return 33554548 }
    return linux_num
}

fn emit_syscall(linux_num) {
    let n = syscall_num(linux_num)
    out("    mov rax, " + int_to_str(n))
    out("    syscall")
}

fn win_call(api_name) {
    out("    sub rsp, 32")
    out("    call [rip + __imp_" + api_name + "]")
    out("    add rsp, 32")
}

fn new_label() {
    cg_label_count = cg_label_count + 1
    return ".L" + int_to_str(cg_label_count)
}

fn add_string(s) {
    let si = 0
    while si < cg_str_count {
        if cg_strings[si] == s {
            return si
        }
        si = si + 1
    }
    let idx = cg_str_count
    push(cg_strings, s)
    cg_str_count = cg_str_count + 1
    return idx
}

// R38A: add_float_const accepts an additional `exp_p` (scientific-notation
// exponent). De-duplication keys on all four slots so `1.0` (exp=0) and
// `1e0` (exp=0) collapse, while `1.5` and `15e-1` stay distinct (they
// produce the same IEEE 754 bits but the runtime init-builder computes
// the value via different intermediate ops — keeping them separate keeps
// the existing test_ieee754.nova baseline byte-stable).
fn add_float_const(int_p, frac_p, frac_d, exp_p) {
    let fi = 0
    while fi < cg_float_count {
        if cg_float_int_parts[fi] == int_p {
            if cg_float_frac_parts[fi] == frac_p {
                if cg_float_frac_digits[fi] == frac_d {
                    if cg_float_exponents[fi] == exp_p {
                        return fi
                    }
                }
            }
        }
        fi = fi + 1
    }
    let idx = cg_float_count
    push(cg_float_int_parts, int_p)
    push(cg_float_frac_parts, frac_p)
    push(cg_float_frac_digits, frac_d)
    push(cg_float_exponents, exp_p)
    cg_float_count = cg_float_count + 1
    return idx
}

fn add_global(name) {
    push(cg_globals, name)
    cg_global_count = cg_global_count + 1
}

// R32D: recurse into a top-level AST_BLOCK to register its inner
// AST_LET_STMT names as globals. Used when the parser lowers a top-level
// destructure (struct or enum) into a block of plain lets. We don't
// recurse into nested AST_BLOCK structures: top-level destructure only
// ever produces a flat list of lets in a single block, so a shallow
// walk suffices and avoids accidentally hoisting deeply nested let
// names (inside if/while bodies etc.) into globals.
fn cg_collect_block_globals(block_nd) {
    if block_nd == 0 { return 0 }
    if type_of(block_nd) != 3 { return 0 }
    let stmts = block_nd[1]
    if stmts == 0 { return 0 }
    if type_of(stmts) != 3 { return 0 }
    let i = 0
    while i < len(stmts) {
        let s = stmts[i]
        if s != 0 {
            if type_of(s) == 3 {
                if ast_tag(s) == AST_LET_STMT {
                    add_global(s[1])
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn is_global(name) {
    let i = 0
    while i < cg_global_count {
        if cg_globals[i] == name {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn has_local(name) {
    let i = 0
    while i < cg_local_count {
        if cg_locals[i] == name {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn local_offset(name) {
    let i = 0
    while i < cg_local_count {
        if cg_locals[i] == name {
            return (i + 1) * 8
        }
        i = i + 1
    }
    let j = 0
    while j < cg_param_count {
        if cg_params[j] == name {
            return (cg_local_count + j + 1) * 8
        }
        j = j + 1
    }
    push(cg_locals, name)
    cg_local_count = cg_local_count + 1
    return cg_local_count * 8
}

fn collect_comp_vars(expr) {
    if expr == 0 { return 0 }
    let tag = ast_tag(expr)
    if tag == AST_LIST_COMP {
        let lc_var = expr[2]
        push(cg_locals, lc_var)
        cg_local_count = cg_local_count + 1
        return 0
    }
    if tag == AST_MAP_COMP {
        let mc_var = expr[3]
        push(cg_locals, mc_var)
        cg_local_count = cg_local_count + 1
        return 0
    }
    if tag == AST_CALL {
        let cargs = expr[2]
        let ci = 0
        while ci < len(cargs) {
            collect_comp_vars(cargs[ci])
            ci = ci + 1
        }
        return 0
    }
    if tag == AST_BIN_OP {
        collect_comp_vars(expr[2])
        collect_comp_vars(expr[3])
        return 0
    }
    if tag == AST_DO_EXPR {
        let di = 0
        while di < len(expr[1]) {
            collect_locals(expr[1][di])
            di = di + 1
        }
        collect_comp_vars(expr[2])
        return 0
    }
    // match/if/try can appear in expression position (RHS of let, fn-call
    // arg, etc.). Their arm bodies may declare locals via `let` — those
    // need a stack slot in the enclosing function's frame or the local
    // offset assigned by local_offset() falls outside the prologue's
    // `sub rsp, N`. Recurse into the bodies so collect_locals registers
    // them. Same trick as AST_DO_EXPR above.
    if tag == AST_MATCH_STMT {
        collect_comp_vars(expr[1])
        let arms = expr[2]
        let ai = 0
        while ai < len(arms) {
            let arm = arms[ai]
            let pat = arm[1]
            let body = arm[2]
            // R17A: register binders from enum-variant patterns in
            // expression-position match too — otherwise `let x = match v
            // { Option::Some(n) => n  Option::None => -1 }` would write
            // to an unreserved stack slot.
            if ast_tag(pat) == AST_ENUM_PATTERN {
                let binders = pat[3]
                let bi = 0
                while bi < len(binders) {
                    let bn = binders[bi]
                    if bn == "_" {
                    } else {
                        if is_global(bn) == 0 {
                            push(cg_locals, bn)
                            cg_local_count = cg_local_count + 1
                        }
                    }
                    bi = bi + 1
                }
            }
            if body == 0 {
            } else {
                let btag = ast_tag(body)
                if btag == AST_BLOCK {
                    collect_locals(body)
                } else { if btag == AST_EXPR_STMT {
                    collect_comp_vars(body[1])
                } else {
                    collect_locals(body)
                } }
            }
            ai = ai + 1
        }
        return 0
    }
    if tag == AST_IF_STMT {
        collect_comp_vars(expr[1])
        if expr[2] == 0 {
        } else {
            collect_locals(expr[2])
        }
        if expr[3] == 0 {
        } else {
            collect_locals(expr[3])
        }
        return 0
    }
    if tag == AST_TRY_CATCH {
        if expr[1] == 0 {
        } else {
            collect_locals(expr[1])
        }
        if expr[2] == 0 {
        } else {
            collect_locals(expr[2])
        }
        // catch-error variable binding lives at expr[3]; register it.
        if len(expr) > 3 {
            let cev = expr[3]
            if cev == 0 {
            } else { if cev == "" {
            } else {
                if is_global(cev) == 0 {
                    push(cg_locals, cev)
                    cg_local_count = cg_local_count + 1
                }
            } }
        }
        return 0
    }
    if tag == AST_BLOCK {
        collect_locals(expr)
        return 0
    }
    if tag == AST_TERNARY {
        collect_comp_vars(expr[1])
        collect_comp_vars(expr[2])
        collect_comp_vars(expr[3])
        return 0
    }
    if tag == AST_AND_EXPR {
        collect_comp_vars(expr[1])
        collect_comp_vars(expr[2])
        return 0
    }
    if tag == AST_OR_EXPR {
        collect_comp_vars(expr[1])
        collect_comp_vars(expr[2])
        return 0
    }
    if tag == AST_NULLISH {
        collect_comp_vars(expr[1])
        collect_comp_vars(expr[2])
        return 0
    }
    if tag == AST_UNARY_OP {
        collect_comp_vars(expr[2])
        return 0
    }
    if tag == AST_LIST_LIT {
        let lelts = expr[1]
        let li = 0
        while li < len(lelts) {
            collect_comp_vars(lelts[li])
            li = li + 1
        }
        return 0
    }
    if tag == AST_INDEX_EXPR {
        collect_comp_vars(expr[1])
        collect_comp_vars(expr[2])
        return 0
    }
    if tag == AST_FIELD_ACCESS {
        collect_comp_vars(expr[1])
        return 0
    }
    if tag == AST_TRY_PROPAGATE {
        collect_comp_vars(expr[1])
        return 0
    }
    return 0
}

fn collect_locals(nd) {
    let tag = ast_tag(nd)
    if tag == AST_LET_STMT {
        let name = nd[1]
        if is_global(name) == 0 {
            push(cg_locals, name)
            cg_local_count = cg_local_count + 1
        }
        collect_comp_vars(nd[2])
    }
    if tag == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            collect_locals(stmts[i])
            i = i + 1
        }
    }
    if tag == AST_IF_STMT {
        collect_locals(nd[2])
        let else_cl = nd[3]
        if else_cl == 0 {
        } else {
            collect_locals(else_cl)
        }
    }
    if tag == AST_WHILE_STMT {
        collect_locals(nd[2])
        if len(nd) > 4 {
            if nd[4] != 0 { collect_locals(nd[4]) }
        }
    }
    if tag == AST_FOR_STMT {
        let var_name = nd[1]
        push(cg_locals, var_name)
        cg_local_count = cg_local_count + 1
        collect_locals(nd[3])
        if len(nd) > 5 {
            if nd[5] != 0 { collect_locals(nd[5]) }
        }
    }
    if tag == AST_MATCH_STMT {
        let arms = nd[2]
        let ai = 0
        while ai < len(arms) {
            let arm = arms[ai]
            let pattern = arm[1]
            let body = arm[2]
            // R17A: register binder names from enum-variant patterns so
            // the function prologue reserves stack slots for them. Same
            // mechanism as AST_DESTRUCTURE / AST_FOR_INDEXED.
            if ast_tag(pattern) == AST_ENUM_PATTERN {
                let binders = pattern[3]
                let bi = 0
                while bi < len(binders) {
                    let bn = binders[bi]
                    if bn == "_" {
                    } else {
                        if is_global(bn) == 0 {
                            push(cg_locals, bn)
                            cg_local_count = cg_local_count + 1
                        }
                    }
                    bi = bi + 1
                }
            }
            if ast_tag(body) == AST_BLOCK {
                collect_locals(body)
            }
            ai = ai + 1
        }
    }
    if tag == AST_TRY_CATCH {
        collect_locals(nd[1])
        collect_locals(nd[2])
        let cev = nd[3]
        if cev == "" {
        } else {
            if is_global(cev) == 0 {
                push(cg_locals, cev)
                cg_local_count = cg_local_count + 1
            }
        }
        if len(nd) > 5 {
            collect_locals(nd[4])
        }
    }
    if tag == AST_DO_WHILE {
        collect_locals(nd[1])
    }
    if tag == AST_DEFER_STMT {
        collect_locals(nd[1])
    }
    if tag == AST_DESTRUCTURE {
        let dnames = nd[1]
        let di = 0
        while di < len(dnames) {
            if is_global(dnames[di]) == 0 {
                push(cg_locals, dnames[di])
                cg_local_count = cg_local_count + 1
            }
            di = di + 1
        }
        // Rest pattern (e.g. let [a, ...rest] = list) places the rest
        // name at nd[3]. parse_stmt appends a source-line number as the
        // last element of every statement, so the non-rest node has
        // length 4 (tag, dnames, dvalue, line) and the rest node has
        // length 5 (tag, dnames, dvalue, rest_name, line). Use > 4 to
        // distinguish them, or we'd treat the line number as a variable
        // name and segfault in DWARF emission (len() on an int).
        if len(nd) > 4 {
            let drname = nd[3]
            if is_global(drname) == 0 {
                push(cg_locals, drname)
                cg_local_count = cg_local_count + 1
            }
        }
    }
    if tag == AST_FOR_INDEXED {
        let idx_name = nd[1]
        let val_name = nd[2]
        push(cg_locals, idx_name)
        cg_local_count = cg_local_count + 1
        push(cg_locals, val_name)
        cg_local_count = cg_local_count + 1
        collect_locals(nd[4])
    }
    if tag == AST_LIST_COMP {
        let lc_var = nd[2]
        push(cg_locals, lc_var)
        cg_local_count = cg_local_count + 1
    }
    if tag == AST_MAP_COMP {
        let mc_var = nd[3]
        push(cg_locals, mc_var)
        cg_local_count = cg_local_count + 1
    }
    if tag == AST_EXPR_STMT {
        collect_comp_vars(nd[1])
    }
    if tag == AST_DO_EXPR {
        let di = 0
        while di < len(nd[1]) {
            collect_locals(nd[1][di])
            di = di + 1
        }
    }
    if tag == AST_ASSIGN_STMT {
        collect_comp_vars(nd[2])
    }
    if tag == AST_RETURN_STMT {
        if nd[1] == 0 { } else {
            collect_comp_vars(nd[1])
        }
    }
}

fn struct_field_index(struct_name, field_name) {
    let i = 0
    while i < cg_struct_count {
        let s = cg_structs[i]
        if s[0] == struct_name {
            let fields = s[1]
            let j = 0
            while j < len(fields) {
                if fields[j] == field_name {
                    return j
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return 0 - 1
}

// R25A: reorder brace-init values to match the struct's declaration
// order so codegen can emit positional pushes. Takes a source-order list
// of (field_name, value) pairs and the struct's declared field-name list,
// returns a parallel list of values in declaration order. Missing fields
// (not in source) get a 0 placeholder (ast_none) so the resulting list
// still has the right shape — codegen pushes one value per field. Source
// fields that don't appear in the declaration are silently dropped (the
// parser-time tc_check pass surfaces the warning).
//
// R26A: if `base` is non-zero, it's an AST_IDENT for the spread `..base`
// expression in update-syntax `Foo { field: val, ..base }`. Missing
// fields are filled with `base.field` (AST_FIELD_ACCESS) so the runtime
// copies values from the existing struct value. Parser guarantees `base`
// is always an AST_IDENT — non-trivial spreads are pre-bound to a fresh
// temp via a do-expr wrapper.
fn cg_reorder_struct_init(struct_name, src_names, src_values) {
    return cg_reorder_struct_init_b(struct_name, src_names, src_values, 0)
}

fn cg_reorder_struct_init_b(struct_name, src_names, src_values, base) {
    let i = 0
    let decl_fields = list_new()
    while i < cg_struct_count {
        if cg_structs[i][0] == struct_name {
            decl_fields = cg_structs[i][1]
            i = cg_struct_count
        }
        i = i + 1
    }
    let n = len(decl_fields)
    let result = list_new()
    let j = 0
    while j < n {
        let want = decl_fields[j]
        // Find `want` in src_names.
        let found = 0
        let k = 0
        while k < len(src_names) {
            if src_names[k] == want {
                push(result, src_values[k])
                found = 1
                k = len(src_names)
            }
            k = k + 1
        }
        if found == 0 {
            if base != 0 {
                // R26A: copy from base via `base.field`. base is an
                // AST_IDENT (parser invariant); each missing field
                // emits a fresh AST_FIELD_ACCESS pointing at it.
                push(result, ast_field_access(ast_ident(base[1]), want))
            } else {
                // Missing — push none placeholder so the value list has
                // the correct length / shape.
                push(result, ast_none())
            }
        }
        j = j + 1
    }
    return result
}

fn find_field_index(field_name) {
    let si = 0
    while si < cg_struct_count {
        let fields = cg_structs[si][1]
        let fi = 0
        while fi < len(fields) {
            if fields[fi] == field_name {
                return fi
            }
            fi = fi + 1
        }
        si = si + 1
    }
    return 0 - 1
}

fn is_struct_name(name) {
    let si = 0
    while si < cg_struct_count {
        if cg_structs[si][0] == name {
            return 1
        }
        si = si + 1
    }
    return 0
}

fn is_enum_name(name) {
    let si = 0
    while si < cg_enum_count {
        if cg_enums[si][0] == name {
            return 1
        }
        si = si + 1
    }
    return 0
}

// R17A: variant entries now have shape [name, arity]; the parser
// always emits this form (even legacy `enum X { A, B }` records as
// [["A", 0], ["B", 0]]). The accessors below intentionally take an
// already-extracted variant entry to keep the call sites compact.
fn enum_variant_entry_name(vent) {
    if vent == 0 { return "" }
    // A list has type_of == 3. A string has type_of == 2. The
    // simplest discriminator that works pre-self-host is len() — a
    // [name, arity] pair always has len >= 2; we never push a 1-elem
    // variant entry. Calling len() on a string returns the byte
    // count, which is > 0 for all real variant names, so we have to
    // distinguish via type_of.
    if type_of(vent) == 3 {
        if len(vent) >= 1 { return vent[0] }
        return ""
    }
    return vent
}

fn enum_variant_entry_arity(vent) {
    if vent == 0 { return 0 }
    if type_of(vent) == 3 {
        if len(vent) >= 2 { return vent[1] }
    }
    return 0
}

fn enum_variant_index(enum_name, variant_name) {
    let si = 0
    while si < cg_enum_count {
        if cg_enums[si][0] == enum_name {
            let variants = cg_enums[si][1]
            let vi = 0
            while vi < len(variants) {
                if enum_variant_entry_name(variants[vi]) == variant_name {
                    return vi
                }
                vi = vi + 1
            }
        }
        si = si + 1
    }
    return 0 - 1
}

// R17A: arity of a sum-type variant (0 for nullary). Returns -1 if
// the variant doesn't exist on the named enum.
fn enum_variant_arity(enum_name, variant_name) {
    let si = 0
    while si < cg_enum_count {
        if cg_enums[si][0] == enum_name {
            let variants = cg_enums[si][1]
            let vi = 0
            while vi < len(variants) {
                if enum_variant_entry_name(variants[vi]) == variant_name {
                    return enum_variant_entry_arity(variants[vi])
                }
                vi = vi + 1
            }
        }
        si = si + 1
    }
    return 0 - 1
}

// R17A: variant count of an enum (used for exhaustiveness).
fn enum_variant_count(enum_name) {
    let si = 0
    while si < cg_enum_count {
        if cg_enums[si][0] == enum_name {
            return len(cg_enums[si][1])
        }
        si = si + 1
    }
    return 0
}

// R17A: declaration-order name of variant i of an enum (for warnings).
fn enum_variant_name_at(enum_name, idx) {
    let si = 0
    while si < cg_enum_count {
        if cg_enums[si][0] == enum_name {
            let variants = cg_enums[si][1]
            if idx >= 0 {
                if idx < len(variants) {
                    return enum_variant_entry_name(variants[idx])
                }
            }
            return ""
        }
        si = si + 1
    }
    return ""
}

// R17A: exhaustiveness pass for match-on-sum-type. When at least one
// arm pattern is an AST_ENUM_PATTERN for enum E we treat the match as
// E-typed and demand coverage of every E variant unless a wildcard
// arm is present. Missing variants emit a single-line WARN to stderr
// (printed once per match) — non-fatal, as the task spec calls for.
//
// Implementation note: we walk arms left-to-right twice — once to
// pick the enum name + collect covered variants, once just for the
// wildcard check. Cheap; matches are tiny.
//
// R31D: parser.nova's tc_check_match_exhaustive runs first and tags
// already-checked match nodes by appending a 4th slot (==1). When that
// flag is present, skip — the warn was either already emitted or the
// match is exhaustive. Also skip when the same gen-pass has already
// recorded the node (gen_expr + gen_stmt would otherwise both fire).
fn cg_check_exhaustive(match_nd) {
    if len(match_nd) > 3 {
        if match_nd[3] == 1 { return 0 }
    }
    let arms = match_nd[2]
    let enum_name = ""
    let has_wildcard = 0
    let ai = 0
    while ai < len(arms) {
        let arm = arms[ai]
        let pat = arm[1]
        let ptag = ast_tag(pat)
        if ptag == AST_WILDCARD { has_wildcard = 1 }
        if ptag == AST_TYPE_PATTERN { has_wildcard = 1 }
        if ptag == AST_ENUM_PATTERN {
            if enum_name == "" { enum_name = pat[1] }
        }
        ai = ai + 1
    }
    if enum_name == "" { return 0 }
    if has_wildcard == 1 { return 0 }
    let total = enum_variant_count(enum_name)
    if total == 0 { return 0 }
    // Collect covered tag indices.
    let covered = list_new()
    ai = 0
    while ai < len(arms) {
        let arm = arms[ai]
        let pat = arm[1]
        if ast_tag(pat) == AST_ENUM_PATTERN {
            let vidx = enum_variant_index(pat[1], pat[2])
            if vidx >= 0 {
                let dup = 0
                let ci = 0
                while ci < len(covered) {
                    if covered[ci] == vidx { dup = 1 }
                    ci = ci + 1
                }
                if dup == 0 { push(covered, vidx) }
            }
        }
        ai = ai + 1
    }
    if len(covered) >= total { return 0 }
    // Build a comma-separated list of missing variant names for the
    // warning message — humans read this, not the compiler.
    let missing = ""
    let vi = 0
    let first = 1
    while vi < total {
        let seen = 0
        let ci = 0
        while ci < len(covered) {
            if covered[ci] == vi { seen = 1 }
            ci = ci + 1
        }
        if seen == 0 {
            if first == 1 {
                missing = enum_variant_name_at(enum_name, vi)
                first = 0
            } else {
                missing = missing + ", " + enum_variant_name_at(enum_name, vi)
            }
        }
        vi = vi + 1
    }
    println("warning: non-exhaustive match on " + enum_name + " (missing: " + missing + ")")
    // R31D: mark the match node as already-warned so any subsequent
    // pass over the same node (e.g. gen_expr followed by gen_stmt for
    // a let-bound match in an outer block) doesn't duplicate the line.
    if len(match_nd) < 4 { push(match_nd, 1) }
    return 0
}

fn get_lambda_caps(lname) {
    let i = 0
    while i < len(cg_lambda_caps) {
        let entry = cg_lambda_caps[i]
        if entry[0] == lname { return entry[1] }
        i = i + 1
    }
    return list_new()
}

fn is_capture_var(name) {
    if cg_current_caps == 0 { return 0 }
    let i = 0
    while i < len(cg_current_caps) {
        if cg_current_caps[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

// R37A: returns the capture index of `name` in cg_current_caps,
// or -1 if not a capture. Used to read/write captures_list[idx]
// inside the lambda body.
fn capture_index(name) {
    if cg_current_caps == 0 { return 0 - 1 }
    let i = 0
    while i < len(cg_current_caps) {
        if cg_current_caps[i] == name { return i }
        i = i + 1
    }
    return 0 - 1
}

// R37A: returns 1 iff `name` is a local of the current function that
// must be boxed (because it's captured by a nested lambda). cg_boxed_locals
// is set by gen_function before walking the body.
fn is_boxed_local(name) {
    if cg_boxed_locals == 0 { return 0 }
    let i = 0
    while i < cg_boxed_locals_count {
        if cg_boxed_locals[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

// R37A: emit captures_list pointer into rax. captures_list is the synthetic
// first parameter of every lambda compiled fn; it lives at [rbp - 8].
fn cg_emit_captures_list() {
    out("    mov rax, [rbp - 8]")
    return 0
}

// R37A: emit `mov rax, box_ptr` where box_ptr is captures_list[idx]
// (a 1-element list that stores the captured variable's value at [0]).
fn cg_emit_capture_box(idx) {
    cg_emit_captures_list()
    out("    mov rax, [rax + 24]")
    out("    mov rax, [rax + " + int_to_str(idx * 8) + "]")
    return 0
}

// R37A: emit code to load the value held by captures_list[idx].
// Result in rax. Pattern: rax = captures_list[idx][0].
fn cg_emit_capture_load(idx) {
    cg_emit_capture_box(idx)
    out("    mov rax, [rax + 24]")
    out("    mov rax, [rax]")
    return 0
}

// R37A: emit code to store rax INTO captures_list[idx]'s slot. The
// caller has already evaluated the source into rax; we push/pop to
// preserve it across the box-lookup. Result is the stored value in rax.
fn cg_emit_capture_store(idx) {
    out("    push rax")
    cg_emit_capture_box(idx)
    out("    mov rcx, [rax + 24]")
    out("    pop rax")
    out("    mov [rcx], rax")
    return 0
}

// R37A: emit a fresh 1-element list with rax as the initial value.
// Result in rax: the new box pointer. Used at let-stmt for boxed locals
// and at lambda-creation when binding a not-yet-boxed capture source.
fn cg_emit_alloc_box() {
    out("    push rax")
    out("    call _nova_list_new")
    out("    pop rcx")
    out("    mov rsi, rcx")
    out("    mov rdi, rax")
    out("    push rax")
    out("    call _nova_push")
    out("    pop rax")
    return 0
}

fn collect_idents_in(nd, names) {
    if nd == 0 { return 0 }
    let tag = nd[0]
    if tag == AST_IDENT {
        let nm = nd[1]
        let qi = 0
        let already = 0
        while qi < len(names) {
            if names[qi] == nm { already = 1 }
            qi = qi + 1
        }
        if already == 0 { push(names, nm) }
        return 0
    }
    if tag == AST_INT_LIT { return 0 }
    if tag == AST_FLOAT_LIT { return 0 }
    if tag == AST_STR_LIT { return 0 }
    if tag == AST_BOOL_LIT { return 0 }
    if tag == AST_NONE_LIT { return 0 }
    if tag == AST_WILDCARD { return 0 }
    if tag == AST_BREAK_STMT { return 0 }
    if tag == AST_CONTINUE_STMT { return 0 }
    if tag == AST_STRUCT_DECL { return 0 }
    if tag == AST_ENUM_DECL { return 0 }
    if tag == AST_LAMBDA { return 0 }
    if tag == AST_ASSIGN_STMT {
        let aname = nd[1]
        let qi = 0
        let already = 0
        while qi < len(names) {
            if names[qi] == aname { already = 1 }
            qi = qi + 1
        }
        if already == 0 { push(names, aname) }
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_BIN_OP {
        collect_idents_in(nd[2], names)
        collect_idents_in(nd[3], names)
        return 0
    }
    if tag == AST_UNARY_OP {
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_AND_EXPR {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_OR_EXPR {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_NULLISH {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_FLOW {
        collect_idents_in(nd[2], names)
        collect_idents_in(nd[3], names)
        return 0
    }
    if tag == AST_LET_STMT {
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_RETURN_STMT {
        if nd[1] == 0 { } else {
            collect_idents_in(nd[1], names)
        }
        return 0
    }
    if tag == AST_BLOCK {
        let stmts = nd[1]
        let bi = 0
        while bi < len(stmts) {
            collect_idents_in(stmts[bi], names)
            bi = bi + 1
        }
        return 0
    }
    if tag == AST_CALL {
        collect_idents_in(nd[1], names)
        let cargs = nd[2]
        let ci = 0
        while ci < len(cargs) {
            collect_idents_in(cargs[ci], names)
            ci = ci + 1
        }
        return 0
    }
    if tag == AST_IF_STMT {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        if nd[3] == 0 { } else {
            collect_idents_in(nd[3], names)
        }
        return 0
    }
    if tag == AST_WHILE_STMT {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_FOR_STMT {
        collect_idents_in(nd[2], names)
        collect_idents_in(nd[3], names)
        return 0
    }
    if tag == AST_DO_WHILE {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_INDEX_EXPR {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_INDEX_ASSIGN {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        collect_idents_in(nd[3], names)
        return 0
    }
    if tag == AST_FIELD_ACCESS {
        collect_idents_in(nd[1], names)
        return 0
    }
    if tag == AST_FIELD_ASSIGN {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[3], names)
        return 0
    }
    if tag == AST_EXPR_STMT {
        collect_idents_in(nd[1], names)
        return 0
    }
    if tag == AST_TERNARY {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        collect_idents_in(nd[3], names)
        return 0
    }
    if tag == AST_LIST_LIT {
        let elems = nd[1]
        let ei = 0
        while ei < len(elems) {
            collect_idents_in(elems[ei], names)
            ei = ei + 1
        }
        return 0
    }
    if tag == AST_MATCH_STMT {
        collect_idents_in(nd[1], names)
        let marms = nd[2]
        let mi = 0
        while mi < len(marms) {
            collect_idents_in(marms[mi][1], names)
            collect_idents_in(marms[mi][2], names)
            mi = mi + 1
        }
        return 0
    }
    if tag == AST_TRY_CATCH {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        if len(nd) > 5 {
            collect_idents_in(nd[4], names)
        }
        return 0
    }
    if tag == AST_THROW {
        collect_idents_in(nd[1], names)
        return 0
    }
    if tag == AST_FN_DECL {
        collect_idents_in(nd[3], names)
        return 0
    }
    if tag == AST_DESTRUCTURE {
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_FOR_INDEXED {
        collect_idents_in(nd[3], names)
        collect_idents_in(nd[4], names)
        return 0
    }
    if tag == AST_NULL_ACCESS {
        collect_idents_in(nd[1], names)
        return 0
    }
    if tag == AST_SLICE {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        collect_idents_in(nd[3], names)
        return 0
    }
    if tag == AST_LIST_COMP {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[3], names)
        if nd[4] == 0 { } else {
            collect_idents_in(nd[4], names)
        }
        return 0
    }
    if tag == AST_MAP_LIT {
        let mkeys = nd[1]
        let mvals = nd[2]
        let mi = 0
        while mi < len(mkeys) {
            collect_idents_in(mkeys[mi], names)
            collect_idents_in(mvals[mi], names)
            mi = mi + 1
        }
        return 0
    }
    if tag == AST_MAP_COMP {
        collect_idents_in(nd[1], names)
        collect_idents_in(nd[2], names)
        collect_idents_in(nd[4], names)
        if nd[5] == 0 { } else {
            collect_idents_in(nd[5], names)
        }
        return 0
    }
    if tag == AST_DO_EXPR {
        let di = 0
        while di < len(nd[1]) {
            collect_idents_in(nd[1][di], names)
            di = di + 1
        }
        collect_idents_in(nd[2], names)
        return 0
    }
    if tag == AST_TRY_PROPAGATE {
        collect_idents_in(nd[1], names)
        return 0
    }
    return 0
}

fn compute_captures(lam) {
    let lam_params = lam[2]
    let lam_body = lam[3]
    let all_names = list_new()
    collect_idents_in(lam_body, all_names)
    // R37A: nested-closure transitivity. collect_idents_in does NOT descend
    // into inner AST_LAMBDAs (line 1451), so a free var referenced ONLY from
    // a nested lambda would be missed (e.g. `|k| |x| x + k` — the outer needs
    // to see `k` so it can forward k's box through its own captures_list, but
    // without recursing, `k` only appears in the inner's body). Recursively
    // gather free vars of every nested lambda (their captures, recursively
    // computed) and add them as candidate captures of the OUTER lambda;
    // outer params/body-lets still shadow them in the filter below.
    let inner_lams = list_new()
    cg_collect_inner_lambdas(lam_body, inner_lams)
    let inli = 0
    while inli < len(inner_lams) {
        let in_lam_name = inner_lams[inli]
        let in_lam_node = cg_find_lambda_by_name(in_lam_name)
        if in_lam_node != 0 {
            let inner_caps = compute_captures(in_lam_node)
            let ic = 0
            while ic < len(inner_caps) {
                let in_nm = inner_caps[ic]
                let already = 0
                let qi = 0
                while qi < len(all_names) {
                    if all_names[qi] == in_nm { already = 1 }
                    qi = qi + 1
                }
                if already == 0 { push(all_names, in_nm) }
                ic = ic + 1
            }
        }
        inli = inli + 1
    }
    let save_locals = cg_locals
    let save_lcount = cg_local_count
    cg_locals = list_new()
    cg_local_count = 0
    let pi = 0
    while pi < len(lam_params) {
        push(cg_locals, lam_params[pi])
        cg_local_count = cg_local_count + 1
        pi = pi + 1
    }
    collect_locals(lam_body)
    let body_bound = cg_locals
    let body_bcount = cg_local_count
    cg_locals = save_locals
    cg_local_count = save_lcount
    let captures = list_new()
    let ni = 0
    while ni < len(all_names) {
        let nm = all_names[ni]
        let skip = 0
        let bi = 0
        while bi < body_bcount {
            if body_bound[bi] == nm { skip = 1 }
            bi = bi + 1
        }
        if skip == 0 {
            if is_builtin_fn(nm) == 1 { skip = 1 }
        }
        if skip == 0 {
            if is_known_function(nm) == 1 { skip = 1 }
        }
        if skip == 0 {
            if is_global(nm) == 1 { skip = 1 }
        }
        if skip == 0 {
            push(captures, nm)
        }
        ni = ni + 1
    }
    return captures
}

// R37A: look up a lambda fn-decl by name in par_lambdas. Used by
// compute_captures to recurse into nested lambdas.
fn cg_find_lambda_by_name(name) {
    let i = 0
    while i < len(par_lambdas) {
        let lam = par_lambdas[i]
        if lam[1] == name { return lam }
        i = i + 1
    }
    return 0
}

// R37A: walk a node collecting AST_LAMBDA references into `out_lams`.
// Recurses through statement and expression forms; deep enough to catch
// lambdas nested inside if/while/match/blocks/expressions.
fn cg_collect_inner_lambdas(nd, out_lams) {
    if nd == 0 { return 0 }
    let tag = nd[0]
    if tag == AST_LAMBDA {
        push(out_lams, nd[1])
        return 0
    }
    if tag == AST_INT_LIT { return 0 }
    if tag == AST_FLOAT_LIT { return 0 }
    if tag == AST_STR_LIT { return 0 }
    if tag == AST_BOOL_LIT { return 0 }
    if tag == AST_NONE_LIT { return 0 }
    if tag == AST_IDENT { return 0 }
    if tag == AST_WILDCARD { return 0 }
    if tag == AST_BREAK_STMT { return 0 }
    if tag == AST_CONTINUE_STMT { return 0 }
    if tag == AST_STRUCT_DECL { return 0 }
    if tag == AST_ENUM_DECL { return 0 }
    if tag == AST_BLOCK {
        let bs = nd[1]
        let i = 0
        while i < len(bs) {
            cg_collect_inner_lambdas(bs[i], out_lams)
            i = i + 1
        }
        return 0
    }
    if tag == AST_LET_STMT {
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_ASSIGN_STMT {
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_EXPR_STMT {
        cg_collect_inner_lambdas(nd[1], out_lams)
        return 0
    }
    if tag == AST_RETURN_STMT {
        if nd[1] == 0 { return 0 }
        cg_collect_inner_lambdas(nd[1], out_lams)
        return 0
    }
    if tag == AST_IF_STMT {
        cg_collect_inner_lambdas(nd[1], out_lams)
        if nd[2] != 0 { cg_collect_inner_lambdas(nd[2], out_lams) }
        if nd[3] != 0 { cg_collect_inner_lambdas(nd[3], out_lams) }
        return 0
    }
    if tag == AST_WHILE_STMT {
        cg_collect_inner_lambdas(nd[1], out_lams)
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_FOR_STMT {
        cg_collect_inner_lambdas(nd[2], out_lams)
        cg_collect_inner_lambdas(nd[3], out_lams)
        return 0
    }
    if tag == AST_BIN_OP {
        cg_collect_inner_lambdas(nd[2], out_lams)
        cg_collect_inner_lambdas(nd[3], out_lams)
        return 0
    }
    if tag == AST_UNARY_OP {
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_AND_EXPR {
        cg_collect_inner_lambdas(nd[1], out_lams)
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_OR_EXPR {
        cg_collect_inner_lambdas(nd[1], out_lams)
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_NULLISH {
        cg_collect_inner_lambdas(nd[1], out_lams)
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_CALL {
        cg_collect_inner_lambdas(nd[1], out_lams)
        let cas = nd[2]
        let i = 0
        while i < len(cas) {
            cg_collect_inner_lambdas(cas[i], out_lams)
            i = i + 1
        }
        return 0
    }
    if tag == AST_INDEX_EXPR {
        cg_collect_inner_lambdas(nd[1], out_lams)
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_FIELD_ACCESS {
        cg_collect_inner_lambdas(nd[1], out_lams)
        return 0
    }
    if tag == AST_LIST_LIT {
        let els = nd[1]
        let i = 0
        while i < len(els) {
            cg_collect_inner_lambdas(els[i], out_lams)
            i = i + 1
        }
        return 0
    }
    if tag == AST_TUPLE_LIT {
        let tels = nd[1]
        let i = 0
        while i < len(tels) {
            cg_collect_inner_lambdas(tels[i], out_lams)
            i = i + 1
        }
        return 0
    }
    if tag == AST_TERNARY {
        cg_collect_inner_lambdas(nd[1], out_lams)
        cg_collect_inner_lambdas(nd[2], out_lams)
        cg_collect_inner_lambdas(nd[3], out_lams)
        return 0
    }
    if tag == AST_MATCH_STMT {
        cg_collect_inner_lambdas(nd[1], out_lams)
        let arms = nd[2]
        let i = 0
        while i < len(arms) {
            let arm = arms[i]
            cg_collect_inner_lambdas(arm[2], out_lams)
            if len(arm) > 3 {
                if arm[3] != 0 { cg_collect_inner_lambdas(arm[3], out_lams) }
            }
            i = i + 1
        }
        return 0
    }
    if tag == AST_TRY_CATCH {
        cg_collect_inner_lambdas(nd[1], out_lams)
        cg_collect_inner_lambdas(nd[2], out_lams)
        if len(nd) > 5 {
            if nd[4] != 0 { cg_collect_inner_lambdas(nd[4], out_lams) }
        }
        return 0
    }
    if tag == AST_DO_EXPR {
        let dstmts = nd[1]
        let i = 0
        while i < len(dstmts) {
            cg_collect_inner_lambdas(dstmts[i], out_lams)
            i = i + 1
        }
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    if tag == AST_DEFER_STMT {
        cg_collect_inner_lambdas(nd[1], out_lams)
        return 0
    }
    if tag == AST_THROW {
        cg_collect_inner_lambdas(nd[1], out_lams)
        return 0
    }
    if tag == AST_TRY_PROPAGATE {
        cg_collect_inner_lambdas(nd[1], out_lams)
        return 0
    }
    if tag == AST_DESTRUCTURE {
        cg_collect_inner_lambdas(nd[2], out_lams)
        return 0
    }
    return 0
}

// R37A: compute the per-function set of locals that need to be boxed.
// Uses cg_collect_inner_lambdas to find all lambdas in fn_decl's body,
// then for each inner lambda intersects its capture set (already in
// cg_lambda_caps) with fn_decl's own locals (params + body lets).
// The intersection becomes the boxed-set; stored in cg_boxed_locals_per_fn.
fn cg_compute_boxed_locals_for_fn(fn_decl) {
    let fname = fn_decl[1]
    let fparams = fn_decl[2]
    let fbody = fn_decl[3]
    let inner_lams = list_new()
    cg_collect_inner_lambdas(fbody, inner_lams)
    if len(inner_lams) == 0 { return 0 }
    // Build the fn's local-name set (params + body lets).
    let save_locals = cg_locals
    let save_lcount = cg_local_count
    cg_locals = list_new()
    cg_local_count = 0
    let pi = 0
    while pi < len(fparams) {
        push(cg_locals, fparams[pi])
        cg_local_count = cg_local_count + 1
        pi = pi + 1
    }
    collect_locals(fbody)
    let fn_locals = cg_locals
    let fn_lcount = cg_local_count
    cg_locals = save_locals
    cg_local_count = save_lcount
    // For each inner lambda's capture, if the capture name is a local of
    // this fn, mark it as boxed for THIS fn.
    let boxed = list_new()
    let bx = 0
    while bx < len(inner_lams) {
        let lam_name = inner_lams[bx]
        let lcaps = get_lambda_caps(lam_name)
        let ci = 0
        while ci < len(lcaps) {
            let nm = lcaps[ci]
            let is_my_local = 0
            let li2 = 0
            while li2 < fn_lcount {
                if fn_locals[li2] == nm { is_my_local = 1 }
                li2 = li2 + 1
            }
            if is_my_local == 1 {
                let already = 0
                let bi = 0
                while bi < len(boxed) {
                    if boxed[bi] == nm { already = 1 }
                    bi = bi + 1
                }
                if already == 0 { push(boxed, nm) }
            }
            ci = ci + 1
        }
        bx = bx + 1
    }
    if len(boxed) > 0 {
        let entry = list_new()
        push(entry, fname)
        push(entry, boxed)
        push(cg_boxed_locals_per_fn, entry)
    }
    return 0
}

// R37A: look up the boxed-locals set for fn `name`.
fn cg_get_boxed_locals_for_fn(name) {
    let i = 0
    while i < len(cg_boxed_locals_per_fn) {
        let e = cg_boxed_locals_per_fn[i]
        if e[0] == name { return e[1] }
        i = i + 1
    }
    return list_new()
}

fn is_builtin_fn(name) {
    if name == "println" { return 1 }
    if name == "print" { return 1 }
    if name == "print_int" { return 1 }
    if name == "concat" { return 1 }
    if name == "int_to_str" { return 1 }
    if name == "str_to_int" { return 1 }
    if name == "list_new" { return 1 }
    if name == "push" { return 1 }
    if name == "len" { return 1 }
    if name == "read_file" { return 1 }
    if name == "write_file" { return 1 }
    if name == "exit" { return 1 }
    if name == "chr" { return 1 }
    if name == "char_at" { return 1 }
    if name == "substr" { return 1 }
    if name == "__arg" { return 1 }
    if name == "str_eq" { return 1 }
    if name == "pop" { return 1 }
    if name == "list_set" { return 1 }
    if name == "contains" { return 1 }
    if name == "list_remove" { return 1 }
    if name == "starts_with" { return 1 }
    if name == "ends_with" { return 1 }
    if name == "str_find" { return 1 }
    if name == "abs" { return 1 }
    if name == "min" { return 1 }
    if name == "max" { return 1 }
    if name == "assert" { return 1 }
    if name == "type_of" { return 1 }
    if name == "typename" { return 1 }
    if name == "debug_print" { return 1 }
    if name == "alloc" { return 1 }
    if name == "time" { return 1 }
    if name == "sleep_ms" { return 1 }
    if name == "mkdir" { return 1 }
    if name == "unlink" { return 1 }
    if name == "file_size" { return 1 }
    if name == "socket" { return 1 }
    if name == "bind_socket" { return 1 }
    if name == "listen_socket" { return 1 }
    if name == "accept_conn" { return 1 }
    if name == "connect_socket" { return 1 }
    if name == "send_data" { return 1 }
    if name == "recv_data" { return 1 }
    if name == "close_fd" { return 1 }
    if name == "make_sockaddr_in" { return 1 }
    if name == "fork_process" { return 1 }
    if name == "waitpid" { return 1 }
    if name == "exec_program" { return 1 }
    if name == "pipe_create" { return 1 }
    if name == "setsid" { return 1 }
    if name == "getpid" { return 1 }
    if name == "kill_proc" { return 1 }
    if name == "raise_sig" { return 1 }
    if name == "signal_install" { return 1 }
    if name == "hex" { return 1 }
    if name == "read_line" { return 1 }
    if name == "read_stdin" { return 1 }
    if name == "getenv" { return 1 }
    if name == "random" { return 1 }
    if name == "random_seed" { return 1 }
    if name == "secure_random" { return 1 }
    if name == "map_new" { return 1 }
    if name == "map_set" { return 1 }
    if name == "map_get" { return 1 }
    if name == "map_has" { return 1 }
    if name == "join" { return 1 }
    if name == "split" { return 1 }
    if name == "reverse" { return 1 }
    if name == "sort" { return 1 }
    if name == "float_mul" { return 1 }
    if name == "float_div" { return 1 }
    if name == "float_add" { return 1 }
    if name == "float_sub" { return 1 }
    if name == "float_cmp" { return 1 }
    if name == "float_to_str" { return 1 }
    if name == "to_float" { return 1 }
    if name == "from_float" { return 1 }
    if name == "fsqrt" { return 1 }
    // R38A: float builtin family. `int_to_f` and `f_to_int` are the
    // renamed canonical converters (aliases for to_float/from_float —
    // both are kept for backward compatibility). `f_sqrt` is an alias
    // for fsqrt. f_abs / f_floor / f_ceil / f_round use roundsd. f_min /
    // f_max use minsd / maxsd. All operate on IEEE 754 double-precision
    // values flowing through the integer-shaped 8-byte box (movq xmm,
    // rdi at entry; movq rax, xmm at exit).
    if name == "int_to_f" { return 1 }
    if name == "f_to_int" { return 1 }
    if name == "f_sqrt" { return 1 }
    if name == "f_abs" { return 1 }
    if name == "f_floor" { return 1 }
    if name == "f_ceil" { return 1 }
    if name == "f_round" { return 1 }
    if name == "f_min" { return 1 }
    if name == "f_max" { return 1 }
    if name == "f_neg" { return 1 }
    if cg_link_libc == 1 {
        if name == "ffi_open" { return 1 }
        if name == "ffi_sym" { return 1 }
        if name == "ffi_close" { return 1 }
        if name == "ffi_call0" { return 1 }
        if name == "ffi_call1" { return 1 }
        if name == "ffi_call2" { return 1 }
        if name == "ffi_call3" { return 1 }
        if name == "ffi_call4" { return 1 }
        if name == "ffi_call5" { return 1 }
        if name == "ffi_calln" { return 1 }
        if name == "ffi_callf1" { return 1 }
        if name == "ffi_callf2" { return 1 }
        if name == "ffi_callf3" { return 1 }
        if name == "ffi_callf4" { return 1 }
        if name == "system_exec" { return 1 }
    }
    if name == "to_str" { return 1 }
    if name == "get_error" { return 1 }
    if name == "map_list" { return 1 }
    if name == "filter" { return 1 }
    if name == "reduce" { return 1 }
    if name == "foreach" { return 1 }
    if name == "keys" { return 1 }
    if name == "values" { return 1 }
    if name == "str_upper" { return 1 }
    if name == "str_lower" { return 1 }
    if name == "str_trim" { return 1 }
    if name == "strcmp" { return 1 }
    if name == "int_mul" { return 1 }
    if name == "int_add" { return 1 }
    if name == "int_sub" { return 1 }
    if name == "int_div" { return 1 }
    if name == "int_mod" { return 1 }
    if name == "int_shl" { return 1 }
    if name == "int_shr" { return 1 }
    if name == "int_and" { return 1 }
    if name == "int_or"  { return 1 }
    if name == "int_xor" { return 1 }
    if name == "chars" { return 1 }
    if name == "str_replace" { return 1 }
    if name == "str_repeat" { return 1 }
    if name == "char_code" { return 1 }
    if name == "to_int" { return 1 }
    if name == "range_list" { return 1 }
    if name == "range_step" { return 1 }
    if name == "range" { return 1 }
    if name == "list_copy" { return 1 }
    if name == "list_slice" { return 1 }
    if name == "append_list" { return 1 }
    if name == "index_of" { return 1 }
    if name == "last_index_of" { return 1 }
    if name == "map_remove" { return 1 }
    if name == "map_count" { return 1 }
    if name == "zip" { return 1 }
    if name == "flat_map" { return 1 }
    if name == "any" { return 1 }
    if name == "all" { return 1 }
    if name == "sum" { return 1 }
    if name == "product" { return 1 }
    if name == "min_list" { return 1 }
    if name == "max_list" { return 1 }
    if name == "flatten" { return 1 }
    if name == "unique" { return 1 }
    if name == "map_merge" { return 1 }
    if name == "enumerate" { return 1 }
    if name == "pad_left" { return 1 }
    if name == "pad_right" { return 1 }
    if name == "str_count" { return 1 }
    if name == "coro_new" { return 1 }
    if name == "coro_resume" { return 1 }
    if name == "coro_yield" { return 1 }
    if name == "coro_done" { return 1 }
    if name == "coro_result" { return 1 }
    if name == "coro_state" { return 1 }
    if name == "store64" { return 1 }
    if name == "load64" { return 1 }
    if name == "store8" { return 1 }
    if name == "load8" { return 1 }
    if name == "memcpy_raw" { return 1 }
    if name == "__intrinsic_dot_i32" { return 1 }
    // R11D: SIMD intrinsics on 8x i32 lanes. Pointer-based ABI: every
    // builtin takes raw int32 buffer pointers (32 bytes = 8 lanes).
    // On Linux x86-64 (cg_target == 0) these lower to AVX2 (vpaddd /
    // vpsubd / vmovdqu / vpsadbw). On ARM64 native (cg_target == 4) /
    // ARM64 Windows (cg_target == 5) they emit NEON (2x 128-bit ops).
    // On macOS / Windows x86-64 / WASM they fall back to scalar loops
    // so the same NOVA source compiles everywhere. Documented in
    // SIMD_AUDIT.md / NEXT_SESSION.md.
    if name == "simd_add_i32x8" { return 1 }
    if name == "simd_sub_i32x8" { return 1 }
    if name == "simd_load_i32x8" { return 1 }
    if name == "simd_store_i32x8" { return 1 }
    if name == "simd_sum_abs_diff" { return 1 }
    // R14B: raw-byte SAD primitive. Eliminates the i32 staging buffer
    // that R12A's stereo_sad_block_simd / lk_optical_flow_simd require:
    // a single 32-byte AVX2 `vpsadbw` instruction reduces 32 bytes of
    // input to four i64 partial sums, vs the 8 i32 lanes of
    // simd_sum_abs_diff which need 8x more bytes converted upstream
    // via store8 + store8 + store8 + store8 per int32. Targets where
    // image pixels live as raw byte buffers (PGM, RGB, YUV) and the
    // SAD is computed per-block over the raw bytes -- exactly the
    // stereo block matching / optical flow workloads.
    if name == "simd_sad_u8" { return 1 }
    // R18A: byte-level multiply-accumulate primitives. Close R17C's LK
    // ceiling (0.80x full-LK after simd_sad_u8 wire-in) by giving the
    // 5 LK accumulator math kernels (Sum Ix^2, Sum Iy^2, Sum Ix*Iy,
    // Sum Ix*It, Sum Iy*It) a single SIMD instruction sequence that
    // does N byte multiplies + horizontal-sum to a scalar i64.
    //
    // simd_mul_acc_byte_signed_byte(a_u8, b_i8, n)    -> Sum a[i]*b[i]
    //   a is unsigned u8 (e.g. raw image pixel), b is signed i8
    //   (e.g. gradient). Matches Intel's asymmetric pmaddubsw shape,
    //   but lowering uses pmovzxbw + pmovsxbw + pmaddwd to avoid the
    //   i16-saturation behaviour of pmaddubsw (we need exact Sum, not
    //   saturated). Use case: cross-correlation, signed-gradient *
    //   pixel-intensity convolutions.
    //
    // simd_mul_acc_signed_signed_byte(a_i8, b_i8, n) -> Sum a[i]*b[i]
    //   Both args signed i8 (gradient * gradient). Used by all 5 LK
    //   accumulators since Ix / Iy / It are signed gradients of the
    //   underlying image. Lowering: pmovsxbw both + pmaddwd.
    if name == "simd_mul_acc_byte_signed_byte"   { return 1 }
    if name == "simd_mul_acc_signed_signed_byte" { return 1 }
    // WASI low-level builtins (R8A): expose raw WASI snapshot_preview1
    // primitives so NOVA programs targeting serverless / CDN-edge can
    // drive the runtime directly. On the WASM target they wrap the
    // imported wasi_snapshot_preview1.{path_open,fd_read,fd_write,
    // fd_close,fd_seek,path_filestat_get,args_*,environ_*}. On native
    // x86-64 Linux they map to POSIX equivalents (open/read/write/
    // close/lseek/stat/argv/environ) so round-trip tests can run
    // without WASM. Stubbed (-> -1 / empty list) on the other native
    // targets (Windows, macOS, ARM64, winARM64) until those grow real
    // POSIX-compat shims.
    if name == "wasi_open" { return 1 }
    if name == "wasi_read" { return 1 }
    if name == "wasi_write" { return 1 }
    if name == "wasi_close" { return 1 }
    if name == "wasi_seek" { return 1 }
    if name == "wasi_filestat" { return 1 }
    if name == "wasi_args_get" { return 1 }
    if name == "wasi_environ_get" { return 1 }
    // R28C: UDP syscalls for NAT hole-punching (R23E.2 follow-up). The
    // four builtins below expose datagram socket primitives so NOVA
    // programs can implement UDP hole-punching after TCP-based STUN-
    // style NAT discovery (R23E). Native x86-64 Linux/macOS go through
    // socket(AF_INET, SOCK_DGRAM, 0) + sendto/recvfrom/setsockopt
    // syscalls (41, 44, 45, 54 -> macOS BSD 97, 133, 29, 105). ARM64
    // Linux uses syscalls 198/206/207/208. Windows / winARM64 go
    // through ws2_32.dll (sendto, recvfrom, setsockopt imports added
    // below). WASM stubs to -1 since WASI doesn't define UDP.
    if name == "sys_socket_udp" { return 1 }
    if name == "sys_sendto" { return 1 }
    if name == "sys_recvfrom" { return 1 }
    if name == "sys_setsockopt_so_reuseaddr" { return 1 }
    // R29A: poll(2) for multi-FD wait. The motivating use case is
    // pipelined I/O over multiple sockets (R28A's blocked phase-1 /
    // phase-2 cascade — a single-threaded peer handler that can't wait
    // on more than one fd today, so the accept queue stalls behind
    // whichever fd is "currently active"). poll covers select's surface
    // area in a single syscall on every modern OS and is what stdlib
    // glibc/musl/macOS/Win select-likes lower to internally.
    //   Linux x86-64 : syscall 7 (poll)
    //   macOS BSD    : syscall 230 (poll) via 0x2000000 prefix
    //   ARM64-Linux  : syscall 73 (ppoll, since poll was removed) with
    //                  a synthesized timespec; NULL when timeout_ms < 0
    //   Windows x64  : __imp_WSAPoll via WS2_32.dll (R28C already wired
    //                  the .extern; we reuse it)
    //   winARM64     : stub returning -1
    //   WASM         : stub returning -1 (WASI has no native poll on
    //                  arbitrary fd sets; preview1 only exposes
    //                  poll_oneoff which is shaped differently)
    if name == "sys_poll" { return 1 }
    // R31A: non-blocking I/O helpers for parallel connect(2). The
    // motivating workload is CrossEngin's DRFETCH phase-1 dial pass:
    // R30A's sys_poll(POLLIN) already parallelises the response wait,
    // but the originator still walks `_gossip_dial` serially because
    // connect(2) blocks on this runtime. With fcntl(F_SETFL,
    // O_NONBLOCK) + connect returning EINPROGRESS + sys_poll(POLLOUT),
    // every peer's TCP handshake races in parallel; the dial portion
    // of the round shrinks from O(N * dial_RTT) to O(max_dial_RTT).
    //   sys_fcntl_setfl_nonblock(fd) -> i32
    //     fcntl(fd, F_SETFL=4, O_NONBLOCK=2048) -> 0 | -1
    //     Linux x86-64 : syscall 72 (fcntl)
    //     macOS BSD    : syscall 92 via 0x2000000 prefix
    //     ARM64-Linux  : syscall 25 (fcntl)
    //     Windows x64  : __imp_ioctlsocket with FIONBIO
    //     winARM64     : stub returning -1
    //     WASM         : stub returning -1 (preview1 has fd_fdstat_set_flags
    //                    but the polling cycle doesn't apply on WASI)
    //   sys_getsockopt_so_error(fd) -> i32
    //     getsockopt(fd, SOL_SOCKET=1, SO_ERROR=4, &val, &valsize) -> val
    //     (the SO_ERROR int value itself, not the getsockopt rc), or -1
    //     if the syscall itself failed. Reads the deferred connect(2)
    //     error after a non-blocking connect + sys_poll(POLLOUT).
    //     Linux x86-64 : syscall 55 (getsockopt)
    //     macOS BSD    : syscall 118 via 0x2000000 prefix
    //     ARM64-Linux  : syscall 209 (getsockopt)
    //     Windows x64  : __imp_getsockopt
    //     winARM64     : stub returning -1
    //     WASM         : stub returning -1
    if name == "sys_fcntl_setfl_nonblock" { return 1 }
    if name == "sys_getsockopt_so_error" { return 1 }
    return 0
}

// R13A: subset of is_builtin_fn that can be emitted INLINE at the call
// site -- skipping the runtime label's call/ret + push rbp / pop rbp
// overhead. The motivating workload is the production stereo SAD inner
// loop, which calls simd_sum_abs_diff ~65k times per disparity scan
// with only ~49 lanes per call; the per-call overhead (~10 ns)
// amortised over so few lanes exceeds the AVX2 inner-loop win, so
// R12A's wired SIMD path actually regressed to 0.85x / 0.20x.
//
// Inlined targets:
//   * cg_target == 0  (Linux x86-64) : AVX2 sequence emitted inline,
//                                       no call/ret/prologue/epilogue.
// The other targets (macOS, Windows, WASM, ARM64) keep using the
// runtime label fallback -- the scalar fallback's overhead is already
// dominated by the loop body, and the ARM64 paths use a separate AST
// walker (arm_gen_call / warm_gen_call) anyway. Function-pointer
// callers (e.g. `let f = simd_sum_abs_diff; f(...)`) also still resolve
// to the runtime label since the inline path requires a direct call.
//
// Inlining is ALSO extended to the cheapest integer arithmetic
// helpers (int_add / int_sub / int_mul / int_div / int_mod / int_and /
// int_or / int_xor / int_shl / int_shr). Each runtime label is 2-4
// instructions; calling them through the function-call ABI adds ~5 ns
// / call. CE's SIMD staging code (which deliberately uses int_* to
// bypass the smart-op classifier) hits these in tight loops --
// inlining recovers a material fraction of the per-iteration overhead
// that was disqualifying the SIMD wiring from showing a win.
// int_div / int_mod use `cqo + idiv rsi` which clobbers rdx; this is
// safe at the call site because 2-arg calls leave rdx undefined per
// the System V ABI (the caller didn't load it for arg 2).
fn is_inline_builtin_fn(name) {
    if cg_target != 0 { return 0 }
    if name == "simd_add_i32x8" { return 1 }
    if name == "simd_sub_i32x8" { return 1 }
    if name == "simd_load_i32x8" { return 1 }
    if name == "simd_store_i32x8" { return 1 }
    if name == "simd_sum_abs_diff" { return 1 }
    // R14B: raw-byte SAD via AVX2 vpsadbw. Same inlining motivation
    // as simd_sum_abs_diff -- the stereo SAD inner loop calls this
    // ~65k times per disparity scan; the call/ret overhead at
    // ~49 bytes per call ate the AVX2 win in R12A.
    if name == "simd_sad_u8" { return 1 }
    // R18A: byte-level multiply-accumulate primitives -- inlined for
    // the same reason as simd_sad_u8 / simd_sum_abs_diff. LK's inner
    // loop calls these 5x per pixel * win^2 cells (e.g. ~24M calls for
    // a 200x200 image with ws=5), so call/ret overhead at ~25-49 lanes
    // per call would dominate the AVX2 win. Fresh new_label() per call
    // so multiple inlined calls in the same fn body don't collide.
    if name == "simd_mul_acc_byte_signed_byte"   { return 1 }
    if name == "simd_mul_acc_signed_signed_byte" { return 1 }
    if name == "int_add" { return 1 }
    if name == "int_sub" { return 1 }
    if name == "int_mul" { return 1 }
    if name == "int_div" { return 1 }
    if name == "int_mod" { return 1 }
    if name == "int_and" { return 1 }
    if name == "int_or"  { return 1 }
    if name == "int_xor" { return 1 }
    if name == "int_shl" { return 1 }
    if name == "int_shr" { return 1 }
    return 0
}

// R13A: emit AVX2 body for a SIMD builtin at the call site, assuming
// the args are already in (rdi, rsi, rdx) per the System V ABI just as
// the runtime label expects. Bit-identical to the runtime label body
// but skips push rbp / mov rbp,rsp / pop rbp / ret -- saves ~5
// instructions per call site (the dominant per-call overhead at small
// lane counts).
//
// Uses fresh labels via new_label() so two inlined calls in the same
// function don't collide on .sad_loop / .sad_tail / etc.
//
// Caller must have already evaluated args and placed them in rdi/rsi
// (and rdx for sum_abs_diff). All inlined paths preserve every
// callee-saved register (only ymm0..ymm3 / rax / r8 / r9 / r10 / rcx
// are clobbered -- the same set already clobbered by `call simd_*`).
fn emit_inline_simd(name) {
    // simd_add_i32x8(a_ptr, b_ptr, dst_ptr) -> dst_ptr in rax.
    if name == "simd_add_i32x8" {
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu ymm1, [rsi]")
        out("    vpaddd ymm0, ymm0, ymm1")
        out("    vmovdqu [rdx], ymm0")
        out("    mov rax, rdx")
        out("    vzeroupper")
        return 0
    }
    // simd_sub_i32x8(a_ptr, b_ptr, dst_ptr) -> dst_ptr in rax.
    if name == "simd_sub_i32x8" {
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu ymm1, [rsi]")
        out("    vpsubd ymm0, ymm0, ymm1")
        out("    vmovdqu [rdx], ymm0")
        out("    mov rax, rdx")
        out("    vzeroupper")
        return 0
    }
    // simd_load_i32x8(src_ptr, dst_ptr) -> dst_ptr in rax.
    if name == "simd_load_i32x8" {
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu [rsi], ymm0")
        out("    mov rax, rsi")
        out("    vzeroupper")
        return 0
    }
    // simd_store_i32x8(dst_ptr, src_ptr) -> dst_ptr in rax.
    if name == "simd_store_i32x8" {
        out("    vmovdqu ymm0, [rsi]")
        out("    vmovdqu [rdi], ymm0")
        out("    mov rax, rdi")
        out("    vzeroupper")
        return 0
    }
    // simd_sum_abs_diff(a_ptr, b_ptr, n) -> scalar sum in rax.
    if name == "simd_sum_abs_diff" {
        let lbl_loop = new_label()
        let lbl_tail = new_label()
        let lbl_tail_loop = new_label()
        let lbl_done = new_label()
        out("    xor eax, eax")
        out("    vpxor ymm2, ymm2, ymm2")
        out("    mov rcx, rdx")
        out("    shr rcx, 3")
        out("    test rcx, rcx")
        out("    jz " + lbl_tail)
        out_label(lbl_loop)
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu ymm1, [rsi]")
        out("    vpsubd ymm3, ymm0, ymm1")
        out("    vpabsd ymm3, ymm3")
        out("    vpaddd ymm2, ymm2, ymm3")
        out("    add rdi, 32")
        out("    add rsi, 32")
        out("    dec rcx")
        out("    jnz " + lbl_loop)
        out("    vextracti128 xmm0, ymm2, 1")
        out("    vpaddd xmm2, xmm2, xmm0")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vmovd eax, xmm2")
        out("    movsxd rax, eax")
        out_label(lbl_tail)
        out("    and rdx, 7")
        out("    test rdx, rdx")
        out("    jz " + lbl_done)
        out_label(lbl_tail_loop)
        out("    mov r8d, [rdi]")
        out("    sub r8d, [rsi]")
        out("    mov r9d, r8d")
        out("    sar r9d, 31")
        out("    xor r8d, r9d")
        out("    sub r8d, r9d")
        out("    movsxd r10, r8d")
        out("    add rax, r10")
        out("    add rdi, 4")
        out("    add rsi, 4")
        out("    dec rdx")
        out("    jnz " + lbl_tail_loop)
        out_label(lbl_done)
        out("    vzeroupper")
        return 0
    }
    // R14B: simd_sad_u8(a_ptr, b_ptr, n_bytes) -> scalar i64 sum in rax.
    // Operates on RAW BYTES (u8 lanes), unlike simd_sum_abs_diff which
    // operates on packed i32 lanes. Uses AVX2 `vpsadbw` which produces
    // 4 partial i64 sums per 32-byte input (one per 8-byte lane); we
    // accumulate them across the loop and horizontal-sum at the end.
    //
    // This eliminates the byte->i32 staging that R12A's
    // stereo_sad_block_simd / lk_optical_flow_simd require: a single
    // `vpsadbw` reduces 32 bytes -> 4 i64 partials in one instruction,
    // vs 4x32 = 128 store8 calls per 32-element SAD via the i32 path.
    // The tail (n_bytes % 32) is a scalar loop.
    //
    // Calling convention: rdi=a_ptr, rsi=b_ptr, rdx=n_bytes. Returns
    // int64 in rax. Clobbers ymm0..ymm3, xmm3, rcx, rax, r8, r9.
    if name == "simd_sad_u8" {
        let lbl_loop_u8 = new_label()
        let lbl_tail_u8 = new_label()
        let lbl_tail_loop_u8 = new_label()
        let lbl_done_u8 = new_label()
        out("    xor eax, eax")
        out("    vpxor ymm2, ymm2, ymm2")
        out("    mov rcx, rdx")
        out("    shr rcx, 5")
        out("    test rcx, rcx")
        out("    jz " + lbl_tail_u8)
        out_label(lbl_loop_u8)
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu ymm1, [rsi]")
        out("    vpsadbw ymm3, ymm0, ymm1")
        out("    vpaddq ymm2, ymm2, ymm3")
        out("    add rdi, 32")
        out("    add rsi, 32")
        out("    dec rcx")
        out("    jnz " + lbl_loop_u8)
        out("    vextracti128 xmm3, ymm2, 1")
        out("    vpaddq xmm2, xmm2, xmm3")
        out("    vpshufd xmm3, xmm2, 0x4e")
        out("    vpaddq xmm2, xmm2, xmm3")
        out("    vmovq rax, xmm2")
        out_label(lbl_tail_u8)
        out("    and rdx, 31")
        out("    test rdx, rdx")
        out("    jz " + lbl_done_u8)
        out_label(lbl_tail_loop_u8)
        out("    movzx r8d, byte ptr [rdi]")
        out("    movzx r9d, byte ptr [rsi]")
        out("    sub r8d, r9d")
        out("    mov r9d, r8d")
        out("    sar r9d, 31")
        out("    xor r8d, r9d")
        out("    sub r8d, r9d")
        out("    movsxd r9, r8d")
        out("    add rax, r9")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz " + lbl_tail_loop_u8)
        out_label(lbl_done_u8)
        out("    vzeroupper")
        return 0
    }
    // R18A: simd_mul_acc_byte_signed_byte(a_u8_ptr, b_i8_ptr, n) -> rax.
    // Sum of a[i] * b[i] over n bytes, where a is unsigned u8 and b is
    // signed i8 (asymmetric mul-acc, like Intel's pmaddubsw shape but
    // without saturation).
    //
    // Lowering uses 16 bytes per iter: vpmovzxbw zero-extends 16 u8 a-
    // bytes to 16 i16 lanes (in ymm), vpmovsxbw sign-extends 16 i8 b-
    // bytes to 16 i16 lanes, then vpmaddwd computes 8 i32 pair-sums
    // (a[2i]*b[2i] + a[2i+1]*b[2i+1]) which accumulate into ymm2.
    // After the loop, horizontal-sum ymm2 (8 i32) -> scalar i64 in rax.
    // Tail (n % 16) is scalar: load byte, sign/zero extend, multiply,
    // sign-extend to i64, add. Calling convention: rdi=a, rsi=b,
    // rdx=n. Clobbers ymm0..ymm3, rcx, rax, r8, r9.
    if name == "simd_mul_acc_byte_signed_byte" {
        let lbl_loop_us = new_label()
        let lbl_tail_us = new_label()
        let lbl_tail_loop_us = new_label()
        let lbl_done_us = new_label()
        out("    xor eax, eax")
        out("    vpxor ymm2, ymm2, ymm2")
        out("    mov rcx, rdx")
        out("    shr rcx, 4")
        out("    test rcx, rcx")
        out("    jz " + lbl_tail_us)
        out_label(lbl_loop_us)
        out("    vpmovzxbw ymm0, [rdi]")
        out("    vpmovsxbw ymm1, [rsi]")
        out("    vpmaddwd ymm3, ymm0, ymm1")
        out("    vpaddd ymm2, ymm2, ymm3")
        out("    add rdi, 16")
        out("    add rsi, 16")
        out("    dec rcx")
        out("    jnz " + lbl_loop_us)
        out("    vextracti128 xmm3, ymm2, 1")
        out("    vpaddd xmm2, xmm2, xmm3")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vmovd eax, xmm2")
        out("    movsxd rax, eax")
        out_label(lbl_tail_us)
        out("    and rdx, 15")
        out("    test rdx, rdx")
        out("    jz " + lbl_done_us)
        out_label(lbl_tail_loop_us)
        out("    movzx r8d, byte ptr [rdi]")
        out("    movsx r9d, byte ptr [rsi]")
        out("    imul r8d, r9d")
        out("    movsxd r9, r8d")
        out("    add rax, r9")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz " + lbl_tail_loop_us)
        out_label(lbl_done_us)
        out("    vzeroupper")
        return 0
    }
    // R18A: simd_mul_acc_signed_signed_byte(a_i8_ptr, b_i8_ptr, n) -> rax.
    // Sum of a[i] * b[i] over n bytes, both args treated as signed i8.
    // The accumulator math for all 5 LK kernels (Sum Ix^2, Sum Iy^2,
    // Sum Ix*Iy, Sum Ix*It, Sum Iy*It): Ix/Iy/It are signed gradients
    // of an underlying u8 image, so both operands are i8.
    //
    // Same lowering shape as byte_signed_byte but with vpmovsxbw on the
    // a-operand too (sign-extend instead of zero-extend). The vector
    // loop processes 16 bytes per iter; vpmaddwd produces 8 i32 pair-
    // sums into ymm2. Horizontal-sum to scalar i64 at the end. Tail
    // (n % 16) is scalar with movsx on both bytes.
    if name == "simd_mul_acc_signed_signed_byte" {
        let lbl_loop_ss = new_label()
        let lbl_tail_ss = new_label()
        let lbl_tail_loop_ss = new_label()
        let lbl_done_ss = new_label()
        out("    xor eax, eax")
        out("    vpxor ymm2, ymm2, ymm2")
        out("    mov rcx, rdx")
        out("    shr rcx, 4")
        out("    test rcx, rcx")
        out("    jz " + lbl_tail_ss)
        out_label(lbl_loop_ss)
        out("    vpmovsxbw ymm0, [rdi]")
        out("    vpmovsxbw ymm1, [rsi]")
        out("    vpmaddwd ymm3, ymm0, ymm1")
        out("    vpaddd ymm2, ymm2, ymm3")
        out("    add rdi, 16")
        out("    add rsi, 16")
        out("    dec rcx")
        out("    jnz " + lbl_loop_ss)
        out("    vextracti128 xmm3, ymm2, 1")
        out("    vpaddd xmm2, xmm2, xmm3")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vmovd eax, xmm2")
        out("    movsxd rax, eax")
        out_label(lbl_tail_ss)
        out("    and rdx, 15")
        out("    test rdx, rdx")
        out("    jz " + lbl_done_ss)
        out_label(lbl_tail_loop_ss)
        out("    movsx r8d, byte ptr [rdi]")
        out("    movsx r9d, byte ptr [rsi]")
        out("    imul r8d, r9d")
        out("    movsxd r9, r8d")
        out("    add rax, r9")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz " + lbl_tail_loop_ss)
        out_label(lbl_done_ss)
        out("    vzeroupper")
        return 0
    }
    // R13A: cheapest integer-arithmetic helpers -- each runtime label
    // is 2-3 instructions, so inlining replaces a call/ret round-trip
    // with a single instruction. Bit-identical to the runtime label
    // (same opcode sequence, just without the surrounding ret). Args
    // are already in rdi (arg 0) and rsi (arg 1) per the System V ABI.
    if name == "int_add" {
        out("    lea rax, [rdi + rsi]")
        return 0
    }
    if name == "int_sub" {
        out("    mov rax, rdi")
        out("    sub rax, rsi")
        return 0
    }
    if name == "int_mul" {
        out("    mov rax, rdi")
        out("    imul rax, rsi")
        return 0
    }
    if name == "int_div" {
        // Signed 64-bit divide: rax / rsi -> rax. cqo sign-extends rax
        // into rdx:rax for idiv. Clobbers rdx, which the call-site ABI
        // leaves undefined for 2-arg calls.
        out("    mov rax, rdi")
        out("    cqo")
        out("    idiv rsi")
        return 0
    }
    if name == "int_mod" {
        // Signed 64-bit remainder: rax mod rsi -> rdx, copied to rax.
        out("    mov rax, rdi")
        out("    cqo")
        out("    idiv rsi")
        out("    mov rax, rdx")
        return 0
    }
    if name == "int_and" {
        out("    mov rax, rdi")
        out("    and rax, rsi")
        return 0
    }
    if name == "int_or" {
        out("    mov rax, rdi")
        out("    or rax, rsi")
        return 0
    }
    if name == "int_xor" {
        out("    mov rax, rdi")
        out("    xor rax, rsi")
        return 0
    }
    if name == "int_shl" {
        // shl needs rcx as the shift count; runtime label moves rsi to rcx.
        out("    mov rax, rdi")
        out("    mov rcx, rsi")
        out("    shl rax, cl")
        return 0
    }
    if name == "int_shr" {
        // sar (arithmetic shift right) mirrors the runtime label.
        out("    mov rax, rdi")
        out("    mov rcx, rsi")
        out("    sar rax, cl")
        return 0
    }
    return 0
}

fn is_known_function(name) {
    if _cg_ht_has(cg_fns_ht, name) == 1 { return 1 }
    if is_builtin_fn(name) == 1 { return 1 }
    return 0
}

fn fn_module(name) {
    let m = _cg_ht_get(cg_fn_modules, name)
    if m == 0 { return "" }
    return m
}

fn mark_float_var(name) {
    let i = 0
    while i < cg_float_var_count {
        if cg_float_vars[i] == name { return 0 }
        i = i + 1
    }
    push(cg_float_vars, name)
    cg_float_var_count = cg_float_var_count + 1
    return 0
}

fn is_float_var(name) {
    let i = 0
    while i < cg_float_var_count {
        if cg_float_vars[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

// R38A: shallow predicate that returns 1 iff `nd` is, or trivially
// contains, an AST_FLOAT_LIT. Used to gate the `call _nova_init_floats`
// emission for programs whose floats live in top-level let-rhs only.
// Checks: AST_FLOAT_LIT directly; AST_UNARY_OP on a float literal;
// AST_BIN_OP whose nd[2] OR nd[3] is itself a shallow float container;
// AST_CALL ignored (the conservative path — false negatives at this
// point just mean the init call gets emitted later anyway because
// cg_float_count will grow during the AST_LET_STMT codegen pass; we
// only need to avoid a false NEGATIVE for the simple top-level
// `let x = 3.14` case). Recursion depth is bounded by the binop /
// unary nesting, which is small for any real-world let RHS.
fn has_float_lit_shallow(nd) {
    if nd == 0 { return 0 }
    if type_of(nd) != 3 { return 0 }
    let t = ast_tag(nd)
    if t == AST_FLOAT_LIT { return 1 }
    if t == AST_UNARY_OP {
        if len(nd) > 2 {
            return has_float_lit_shallow(nd[2])
        }
        return 0
    }
    if t == AST_BIN_OP {
        if len(nd) > 2 {
            if has_float_lit_shallow(nd[2]) == 1 { return 1 }
        }
        if len(nd) > 3 {
            if has_float_lit_shallow(nd[3]) == 1 { return 1 }
        }
        return 0
    }
    return 0
}

// R38A.2 (deferred): is_float_typed returns 1 iff `nd` is a float-
// RESULT-TYPED expression. The intent is to use it at let-stmt /
// assign-stmt sites in place of is_float_expr — distinguishing
// "expression's result is float" from "either operand is float so
// codegen needs SSE2". Critical for comparison ops which have float
// operands but INT result.
//
// DEFERRED: wiring this in at the let-stmt site triggers an
// unidentified self-host bootstrapping crash (stage1-from-source
// segfaults when compiling certain mind/emotion.nova patterns).
// The function is defined and tested in isolation but not invoked
// from production code paths. Root-cause TBD — likely interacts
// with the AST_PAREN dead-code branch or some recursion-depth
// behaviour of the bootstrap-compiled stage1. Test_floats.nova
// works around the limitation by using if-condition syntax instead
// of `let cmp = a < b` storage.
fn is_float_typed(nd) {
    let tag = ast_tag(nd)
    if tag == AST_FLOAT_LIT { return 1 }
    if tag == AST_IDENT {
        if is_float_var(nd[1]) == 1 { return 1 }
    }
    if tag == AST_PAREN {
        return is_float_typed(nd[1])
    }
    if tag == AST_BIN_OP {
        let bop = nd[1]
        if bop == "==" { return 0 }
        if bop == "!=" { return 0 }
        if bop == "<" { return 0 }
        if bop == ">" { return 0 }
        if bop == "<=" { return 0 }
        if bop == ">=" { return 0 }
        if is_float_typed(nd[2]) == 1 { return 1 }
        if is_float_typed(nd[3]) == 1 { return 1 }
    }
    if tag == AST_UNARY_OP {
        if nd[1] == "-" {
            if is_float_typed(nd[2]) == 1 { return 1 }
        }
    }
    if tag == AST_CALL {
        let cn = nd[1]
        if ast_tag(cn) == AST_IDENT {
            let fname = cn[1]
            if fname == "to_float" { return 1 }
            if fname == "float_add" { return 1 }
            if fname == "float_sub" { return 1 }
            if fname == "float_mul" { return 1 }
            if fname == "float_div" { return 1 }
            if fname == "fsqrt" { return 1 }
            if fname == "int_to_f" { return 1 }
            if fname == "f_sqrt" { return 1 }
            if fname == "f_abs" { return 1 }
            if fname == "f_neg" { return 1 }
            if fname == "f_floor" { return 1 }
            if fname == "f_ceil" { return 1 }
            if fname == "f_round" { return 1 }
            if fname == "f_min" { return 1 }
            if fname == "f_max" { return 1 }
        }
    }
    return 0
}

// R38A: returns 1 iff `nd` is a TYPED-AS-FLOAT expression (i.e. its
// runtime value is an IEEE 754 double-precision number). Comparison
// ops always return int (0/1) even on float operands, so they are NOT
// float-typed — even though their lowering uses ucomisd internally.
// See is_float_op_node for the "requires float codegen" predicate that
// callers at AST_BIN_OP / AST_UNARY_OP use.
fn is_float_expr(nd) {
    let tag = ast_tag(nd)
    if tag == AST_FLOAT_LIT { return 1 }
    if tag == AST_IDENT {
        if is_float_var(nd[1]) == 1 { return 1 }
    }
    if tag == AST_PAREN {
        return is_float_expr(nd[1])
    }
    if tag == AST_BIN_OP {
        if is_float_expr(nd[2]) == 1 { return 1 }
        if is_float_expr(nd[3]) == 1 { return 1 }
    }
    if tag == AST_UNARY_OP {
        if nd[1] == "-" {
            if is_float_expr(nd[2]) == 1 { return 1 }
        }
    }
    if tag == AST_CALL {
        let cn = nd[1]
        if ast_tag(cn) == AST_IDENT {
            let fname = cn[1]
            if fname == "to_float" { return 1 }
            if fname == "float_add" { return 1 }
            if fname == "float_sub" { return 1 }
            if fname == "float_mul" { return 1 }
            if fname == "float_div" { return 1 }
            if fname == "fsqrt" { return 1 }
            // R38A: every helper that RETURNS a float must be in this
            // list so dependent `let` binders are tagged float — that's
            // how subsequent arithmetic flips into the SSE2 codegen
            // path instead of the integer ALU path.
            if fname == "int_to_f" { return 1 }
            if fname == "f_sqrt" { return 1 }
            if fname == "f_abs" { return 1 }
            if fname == "f_neg" { return 1 }
            if fname == "f_floor" { return 1 }
            if fname == "f_ceil" { return 1 }
            if fname == "f_round" { return 1 }
            if fname == "f_min" { return 1 }
            if fname == "f_max" { return 1 }
        }
    }
    return 0
}

// R38A.2 (deferred): walk the param-type annotations on an
// AST_FN_DECL and call mark_float_var() for any param whose
// annotated base type is "float". The intent is to enable
// `fn add_all(a: float, b: float) -> float { ... }` to route a+b
// through SSE2 codegen. NOT invoked from production code paths
// today — same self-host crash family as is_float_typed; tracked
// as R38A.2. Test_floats.nova exercises the mixed-arg pattern via
// float_add() calls instead.
//
// Defensive about every step of the type-probing chain because the
// 5th slot on AST_FN_DECL is a R23A/R24A optional metadata list whose
// shape can vary across method-decl-to-fn-decl synthesis sites:
//
//   * Regular fn_decl, lambda fn_decl: len(nd) == 6, nd[5] is the
//     param_types list. Each entry is either 0 (no annotation) or a
//     `[base_name, [type_args]]` pair.
//   * Method-decl-to-fn-decl synthesis: only 4 slots (tag, name,
//     params, body) — no param_types. The `len(nd) > 5` guard handles
//     this case (skip silently).
//
// Lambdas have an injected first param "__captures__" so the
// param_types index needs to align via ptype_offset.
fn cg_mark_float_params(nd, effective_params, is_lambda_fn) {
    if len(nd) <= 5 { return 0 }
    let pt_list = nd[5]
    if pt_list == 0 { return 0 }
    if type_of(pt_list) != 3 { return 0 }
    let ptype_offset = 0
    if is_lambda_fn == 1 { ptype_offset = 1 }
    let pti = 0
    while pti < len(pt_list) {
        let pt_entry = pt_list[pti]
        if pt_entry != 0 {
            if type_of(pt_entry) == 3 {
                if len(pt_entry) >= 1 {
                    let pt_base = pt_entry[0]
                    if pt_base != 0 {
                        if type_of(pt_base) == 2 {
                            if pt_base == "float" {
                                let pname_idx = pti + ptype_offset
                                if pname_idx < len(effective_params) {
                                    mark_float_var(effective_params[pname_idx])
                                }
                            }
                        }
                    }
                }
            }
        }
        pti = pti + 1
    }
    return 0
}

// R38A.2 (deferred): returns 1 iff the binop node `nd` needs FLOAT
// codegen — same semantic as is_float_expr currently does at the
// AST_BIN_OP gen_expr site, but defined as a separate helper so a
// future round can distinguish "needs SSE2" (this) from
// "result-typed-as-float" (is_float_typed). NOT used in production
// today — see is_float_typed for the deferred rationale.
fn is_float_op_node(nd) {
    if nd == 0 { return 0 }
    if type_of(nd) != 3 { return 0 }
    if ast_tag(nd) != AST_BIN_OP { return 0 }
    if is_float_expr(nd[2]) == 1 { return 1 }
    if is_float_expr(nd[3]) == 1 { return 1 }
    return 0
}

// --- Optimization: Constant Folding Helpers ---
// Sentinel value indicating a node cannot be constant-folded.
// Using a large negative value that is unlikely to appear in real code.
let FOLD_SENTINEL = 0 - 999999999

fn log2_exact(v) {
    if v <= 0 { return 0 - 1 }
    if v == 1 { return 0 }
    if v == 2 { return 1 }
    if v == 4 { return 2 }
    if v == 8 { return 3 }
    if v == 16 { return 4 }
    if v == 32 { return 5 }
    if v == 64 { return 6 }
    if v == 128 { return 7 }
    if v == 256 { return 8 }
    if v == 512 { return 9 }
    if v == 1024 { return 10 }
    if v == 2048 { return 11 }
    if v == 4096 { return 12 }
    return 0 - 1
}

fn try_fold(nd) {
    let tag = ast_tag(nd)
    if tag == AST_INT_LIT { return nd[1] }
    if tag == AST_FLOAT_LIT { return FOLD_SENTINEL }
    if tag == AST_BOOL_LIT { return nd[1] }
    if tag == AST_NONE_LIT { return 0 }
    if tag == AST_UNARY_OP {
        let inner = try_fold(nd[2])
        if inner == FOLD_SENTINEL { return FOLD_SENTINEL }
        if nd[1] == "-" { return 0 - inner }
        if nd[1] == "!" {
            if inner == 0 { return 1 }
            return 0
        }
        return FOLD_SENTINEL
    }
    if tag == AST_BIN_OP {
        let lv = try_fold(nd[2])
        if lv == FOLD_SENTINEL { return FOLD_SENTINEL }
        let rv = try_fold(nd[3])
        if rv == FOLD_SENTINEL { return FOLD_SENTINEL }
        let op = nd[1]
        if op == "+" { return lv + rv }
        if op == "-" { return lv - rv }
        if op == "*" { return lv * rv }
        if op == "/" {
            if rv == 0 { return FOLD_SENTINEL }
            return lv / rv
        }
        if op == "%" {
            if rv == 0 { return FOLD_SENTINEL }
            return lv % rv
        }
        if op == "&" { return lv & rv }
        if op == "|" { return lv | rv }
        if op == "^" { return lv ^ rv }
        if op == "<<" { return lv << rv }
        if op == ">>" { return lv >> rv }
        if op == "==" {
            if lv == rv { return 1 }
            return 0
        }
        if op == "<" {
            if lv < rv { return 1 }
            return 0
        }
        if op == ">" {
            if lv > rv { return 1 }
            return 0
        }
        if op == "<=" {
            if lv <= rv { return 1 }
            return 0
        }
        if op == ">=" {
            if lv >= rv { return 1 }
            return 0
        }
        return FOLD_SENTINEL
    }
    return FOLD_SENTINEL
}

fn is_foldable(val) {
    if val == FOLD_SENTINEL { return 0 }
    return 1
}

// ===================================================================
// AST-level Optimization Passes (R12E)
//
// Two pre-codegen passes that rewrite the AST in place:
//
//   cg_fold_constants(program)    — constant folding
//   cg_eliminate_dead_code(program) — DCE
//
// Pipeline: parse → cg_fold_constants → cg_eliminate_dead_code → codegen.
// Both are no-ops when cg_no_opt == 1 (set by the --no-opt CLI flag).
//
// All integer arithmetic in NOVA is signed 64-bit (i64). Folding follows
// two's-complement wraparound semantics: e.g. (1 << 62) * 4 wraps to a
// negative i64 the same way the runtime computation would, so source-level
// behavior is preserved.
//
// Folding only operates on constant expressions: integer/bool/none literals
// and arithmetic/comparison/bitwise operators applied to constants. It does
// NOT fold expressions containing function calls, variable references, or
// strings (string + is overloaded as concat; the smart-op runtime handles
// it at runtime). This keeps the pass safe in the presence of NOVA's
// overloaded operators and the smart-op runtime described in R6A.
// ===================================================================

let cg_no_opt = 0

// ---- Constant Folding Pass ----

// Replace a node's contents with an int-literal node carrying `value`.
// Mutates the existing list (so identity is preserved for parent pointers).
fn _cg_replace_with_int(nd, value) {
    // Clear the list and rebuild as [AST_INT_LIT, value].
    while len(nd) > 0 {
        pop(nd)
    }
    push(nd, AST_INT_LIT)
    push(nd, value)
    return nd
}

// R27A.2 (this round): replace a node's contents with an AST_LIST_LIT
// carrying `elements`. Mutates in place so any parent pointer to nd
// continues to address the rewritten node. Used by the struct const-fold
// optimisation to collapse `Foo { x: 10, ..Foo { x: 1, y: 2 } }` (and the
// parser-emitted do-expr wrapper that caches non-trivial spread bases)
// down to a single literal list — same wire-shape as the runtime-emitted
// struct value `[v0, v1, ...]` in field declaration order.
fn _cg_replace_with_list_lit(nd, elements) {
    while len(nd) > 0 {
        pop(nd)
    }
    push(nd, AST_LIST_LIT)
    push(nd, elements)
    return nd
}

// ---- R27A.2 NOVA struct const-fold side-table ----
//
// The fold pass runs upstream of cg_init() so cg_structs is empty at this
// point. We mirror the (name, fields) entries here so the fold pass can
// recover field-declaration order when collapsing an all-literal
// AST_STRUCT_INIT (or the parser-emitted spread do-expr) down to an
// AST_LIST_LIT. Built once at the start of cg_fold_constants from the
// program's AST_STRUCT_DECL nodes; cleared on each invocation.
let cg_fold_structs = 0
let cg_fold_struct_count = 0

fn _cg_fold_register_structs(program) {
    cg_fold_structs = list_new()
    cg_fold_struct_count = 0
    if program == 0 { return 0 }
    let decls = program[1]
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_STRUCT_DECL {
            let entry = list_new()
            push(entry, d[1])   // name
            push(entry, d[2])   // declaration-order field name list
            push(cg_fold_structs, entry)
            cg_fold_struct_count = cg_fold_struct_count + 1
        }
        i = i + 1
    }
    return 0
}

// Returns the declaration-order field-name list for `name`, or 0 if no
// such struct has been registered. Linear scan — struct count is small
// (a few dozen even in the self-host build) so a hash table would be
// over-engineering.
fn _cg_fold_find_struct(name) {
    let i = 0
    while i < cg_fold_struct_count {
        if cg_fold_structs[i][0] == name {
            return cg_fold_structs[i][1]
        }
        i = i + 1
    }
    return 0
}

// Returns 1 iff `nd` is a primitive literal node — int / bool / str /
// float / none. Identifiers, calls, list/struct/lambda/etc. are NOT
// literals for this pass: only ground constants safely commute through
// the merge step. We don't recurse into list/map literals (whose elements
// might be arbitrary expressions) — conservatively skipping nested
// containers keeps the fold safe.
fn _cg_is_literal_value(nd) {
    if nd == 0 { return 0 }
    let t = ast_tag(nd)
    if t == AST_INT_LIT { return 1 }
    if t == AST_BOOL_LIT { return 1 }
    if t == AST_STR_LIT { return 1 }
    if t == AST_FLOAT_LIT { return 1 }
    if t == AST_NONE_LIT { return 1 }
    return 0
}

// All entries of a value-list are literals (per _cg_is_literal_value).
// Empty list returns 1 (trivially all-literal).
fn _cg_all_literals(values) {
    let i = 0
    while i < len(values) {
        if _cg_is_literal_value(values[i]) == 0 { return 0 }
        i = i + 1
    }
    return 1
}

// Try to collapse an all-literal AST_STRUCT_INIT (no spread base) into a
// synthetic AST_LIST_LIT in field-declaration order. Mutates nd in place
// and returns 1 on success, 0 otherwise. Skipped silently when the struct
// hasn't been registered (e.g. external type) so the unchanged AST falls
// through to the existing runtime emit path.
//
// Conditions:
//   * nd[4] is zero / absent (no `..base` spread)
//   * every value in nd[2] is a primitive literal
//   * the struct name is registered in cg_fold_structs
//
// Effect: produce a new list `[v0, v1, ...]` in decl order; fields not
// supplied by the source get an ast_none() placeholder (mirrors the
// codegen-time cg_reorder_struct_init behaviour for partial inits). The
// caller is responsible for invoking this only on AST_STRUCT_INIT nodes.
fn _cg_try_fold_struct_init(nd) {
    if len(nd) > 4 {
        if nd[4] != 0 { return 0 }
    }
    let src_vals = nd[2]
    let src_names = nd[3]
    if _cg_all_literals(src_vals) == 0 { return 0 }
    let decl_fields = _cg_fold_find_struct(nd[1])
    if decl_fields == 0 { return 0 }
    let n = len(decl_fields)
    let ordered = list_new()
    let j = 0
    while j < n {
        let want = decl_fields[j]
        let found = 0
        let k = 0
        while k < len(src_names) {
            if src_names[k] == want {
                push(ordered, src_vals[k])
                found = 1
                k = len(src_names)
            }
            k = k + 1
        }
        if found == 0 {
            push(ordered, ast_none())
        }
        j = j + 1
    }
    _cg_replace_with_list_lit(nd, ordered)
    return 1
}

// Try to collapse the parser-emitted struct-update do-expr wrapper into a
// single AST_LIST_LIT. The parser shape for a non-trivial spread base is:
//
//     do {
//         let _struct_spread_tmp_N = <base_expr>
//         <AST_STRUCT_INIT with override values and base = ident(tmp)>
//     }
//
// When both <base_expr> is itself an AST_STRUCT_INIT with all-literal
// fields AND every override value is a literal, the entire construction
// is a compile-time constant. We materialise the merged value list in
// field-declaration order (override beats base by field name) and
// rewrite the do-expr in place. Mutates nd and returns 1 on success.
fn _cg_try_fold_struct_update_do(nd) {
    let ds = nd[1]
    if len(ds) != 1 { return 0 }
    let s = ds[0]
    if ast_tag(s) != AST_LET_STMT { return 0 }
    let tmp_name = s[1]
    if starts_with(tmp_name, "_struct_spread_tmp_") == 0 { return 0 }
    let base_init = s[2]
    if base_init == 0 { return 0 }
    if ast_tag(base_init) != AST_STRUCT_INIT { return 0 }
    // The base itself must not have its own spread (no chained
    // un-collapsed update). When base_init has nd[4] != 0 we bail out
    // and let later iterations handle it (currently single-pass).
    if len(base_init) > 4 {
        if base_init[4] != 0 { return 0 }
    }
    let final_init = nd[2]
    if final_init == 0 { return 0 }
    if ast_tag(final_init) != AST_STRUCT_INIT { return 0 }
    if len(final_init) <= 4 { return 0 }
    let ref = final_init[4]
    if ref == 0 { return 0 }
    if ast_tag(ref) != AST_IDENT { return 0 }
    if ref[1] != tmp_name { return 0 }
    if final_init[1] != base_init[1] { return 0 }
    // Both sides must be all-literal: the base supplies every field by
    // construction, the overrides supply a subset.
    if _cg_all_literals(base_init[2]) == 0 { return 0 }
    if _cg_all_literals(final_init[2]) == 0 { return 0 }
    let decl_fields = _cg_fold_find_struct(final_init[1])
    if decl_fields == 0 { return 0 }
    let n = len(decl_fields)
    let ordered = list_new()
    let j = 0
    while j < n {
        let want = decl_fields[j]
        // Override wins by field name.
        let found = 0
        let k = 0
        while k < len(final_init[3]) {
            if final_init[3][k] == want {
                push(ordered, final_init[2][k])
                found = 1
                k = len(final_init[3])
            }
            k = k + 1
        }
        if found == 0 {
            // Look up in the base.
            let bk = 0
            while bk < len(base_init[3]) {
                if base_init[3][bk] == want {
                    push(ordered, base_init[2][bk])
                    found = 1
                    bk = len(base_init[3])
                }
                bk = bk + 1
            }
        }
        if found == 0 {
            // Neither side supplied — same fallback as cg_reorder_struct_init.
            push(ordered, ast_none())
        }
        j = j + 1
    }
    _cg_replace_with_list_lit(nd, ordered)
    return 1
}

// Try to evaluate an AST node as an integer constant.
// Returns the integer value or FOLD_SENTINEL if not foldable.
// Recursively folds sub-expressions as a side effect.
fn _cg_fold_eval(nd) {
    if nd == 0 { return FOLD_SENTINEL }
    let tag = ast_tag(nd)
    if tag == AST_INT_LIT { return nd[1] }
    if tag == AST_BOOL_LIT { return nd[1] }
    // Skip floats: folding floats requires the float layout; keep them as is.
    if tag == AST_FLOAT_LIT { return FOLD_SENTINEL }
    if tag == AST_NONE_LIT { return FOLD_SENTINEL }
    if tag == AST_UNARY_OP {
        // Fold operand first (deep-fold).
        cg_fold_expr(nd[2])
        let inner = _cg_fold_eval(nd[2])
        if inner == FOLD_SENTINEL { return FOLD_SENTINEL }
        if nd[1] == "-" { return 0 - inner }
        if nd[1] == "!" {
            if inner == 0 { return 1 }
            return 0
        }
        if nd[1] == "~" { return ~inner }
        return FOLD_SENTINEL
    }
    if tag == AST_BIN_OP {
        // Deep-fold operands first so nested constants collapse.
        cg_fold_expr(nd[2])
        cg_fold_expr(nd[3])
        let lv = _cg_fold_eval(nd[2])
        if lv == FOLD_SENTINEL { return FOLD_SENTINEL }
        let rv = _cg_fold_eval(nd[3])
        if rv == FOLD_SENTINEL { return FOLD_SENTINEL }
        let op = nd[1]
        // String concat / list ops aren't reachable here because their
        // operands aren't int/bool literals (skipped above).
        if op == "+" { return lv + rv }
        if op == "-" { return lv - rv }
        if op == "*" { return lv * rv }
        if op == "/" {
            if rv == 0 { return FOLD_SENTINEL }
            return lv / rv
        }
        if op == "%" {
            if rv == 0 { return FOLD_SENTINEL }
            return lv % rv
        }
        if op == "&" { return lv & rv }
        if op == "|" { return lv | rv }
        if op == "^" { return lv ^ rv }
        if op == "<<" { return lv << rv }
        if op == ">>" { return lv >> rv }
        if op == "==" {
            if lv == rv { return 1 }
            return 0
        }
        if op == "!=" {
            if lv == rv { return 0 }
            return 1
        }
        if op == "<" {
            if lv < rv { return 1 }
            return 0
        }
        if op == ">" {
            if lv > rv { return 1 }
            return 0
        }
        if op == "<=" {
            if lv <= rv { return 1 }
            return 0
        }
        if op == ">=" {
            if lv >= rv { return 1 }
            return 0
        }
        if op == "**" {
            // Limit to small positive exponents to avoid pathological loops.
            if rv < 0 { return FOLD_SENTINEL }
            if rv > 30 { return FOLD_SENTINEL }
            let pw = 1
            let pi = 0
            while pi < rv {
                pw = pw * lv
                pi = pi + 1
            }
            return pw
        }
        return FOLD_SENTINEL
    }
    return FOLD_SENTINEL
}

// Walk an expression node and fold any constant subexpressions in place.
// Returns the (possibly rewritten) node — same identity unless the whole
// node was a constant expression, in which case it has been mutated to
// AST_INT_LIT in place.
fn cg_fold_expr(nd) {
    if nd == 0 { return nd }
    let tag = ast_tag(nd)
    // Leaf literals: nothing to do.
    if tag == AST_INT_LIT { return nd }
    if tag == AST_STR_LIT { return nd }
    if tag == AST_BOOL_LIT { return nd }
    if tag == AST_NONE_LIT { return nd }
    if tag == AST_FLOAT_LIT { return nd }
    if tag == AST_IDENT { return nd }
    if tag == AST_WILDCARD { return nd }

    if tag == AST_BIN_OP {
        // Try to evaluate to a constant integer.
        let v = _cg_fold_eval(nd)
        if is_foldable(v) == 1 {
            _cg_replace_with_int(nd, v)
            return nd
        }
        // Operands are already folded by _cg_fold_eval; nothing further.
        return nd
    }
    if tag == AST_UNARY_OP {
        let v = _cg_fold_eval(nd)
        if is_foldable(v) == 1 {
            _cg_replace_with_int(nd, v)
            return nd
        }
        return nd
    }
    if tag == AST_TERNARY {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        cg_fold_expr(nd[3])
        // If cond is constant, simplify by reusing the chosen branch's
        // contents. But we can't easily swap node tags safely; leave the
        // ternary in place and let codegen's existing constant-cond
        // shortcut handle it.
        return nd
    }
    if tag == AST_AND_EXPR {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_OR_EXPR {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_NULLISH {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_CALL {
        // Walk arguments. Don't fold the callee identifier itself.
        let args = nd[2]
        let i = 0
        while i < len(args) {
            cg_fold_expr(args[i])
            i = i + 1
        }
        return nd
    }
    if tag == AST_INDEX_EXPR {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_SLICE {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        cg_fold_expr(nd[3])
        return nd
    }
    if tag == AST_FIELD_ACCESS {
        cg_fold_expr(nd[1])
        return nd
    }
    if tag == AST_LIST_LIT {
        let els = nd[1]
        let i = 0
        while i < len(els) {
            cg_fold_expr(els[i])
            i = i + 1
        }
        return nd
    }
    if tag == AST_MAP_LIT {
        let ks = nd[1]
        let vs = nd[2]
        let i = 0
        while i < len(ks) {
            cg_fold_expr(ks[i])
            cg_fold_expr(vs[i])
            i = i + 1
        }
        return nd
    }
    if tag == AST_STRUCT_INIT {
        let sv = nd[2]
        let i = 0
        while i < len(sv) {
            cg_fold_expr(sv[i])
            i = i + 1
        }
        // R26A: also fold the optional spread base on nd[4] (typically
        // an AST_IDENT — folding is a no-op but keeps the walker uniform).
        if len(nd) > 4 {
            if nd[4] != 0 { cg_fold_expr(nd[4]) }
        }
        // R27A.2: collapse all-literal struct-init (no spread base) into
        // a synthetic AST_LIST_LIT in field-declaration order. Wire-shape
        // matches the runtime-emitted struct value across every target
        // (the four codegens push the same per-field sequence for both
        // AST_STRUCT_INIT and AST_LIST_LIT), so the rewrite is
        // transparent. Mutation is in place so any parent pointer to nd
        // stays valid; ast_tag(nd) reports AST_LIST_LIT after the fold.
        _cg_try_fold_struct_init(nd)
        return nd
    }
    if tag == AST_LAMBDA {
        cg_fold_stmt(nd[3])
        return nd
    }
    if tag == AST_PIPE {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_NULL_ACCESS {
        cg_fold_expr(nd[1])
        return nd
    }
    if tag == AST_DO_EXPR {
        // R27A.2: detect the parser-emitted struct-update wrapper FIRST
        // (pre-order), before recursing into the let-RHS. The wrapper
        // shape is:
        //
        //     do { let _struct_spread_tmp_N = <BaseInit>; <OverrideInit> }
        //
        // When both BaseInit and OverrideInit are all-literal struct
        // inits over the same struct type, collapse the do-expr down to
        // a single AST_LIST_LIT. Pre-order checking matters: a post-order
        // pass would first fold the inner AST_STRUCT_INIT (which has no
        // base) into an AST_LIST_LIT, losing the field-name list that
        // the spread merge needs. By checking the outer wrapper first
        // and folding directly, we keep the inner StructInit metadata in
        // hand. If the wrapper matches and folds, we return early —
        // ast_tag(nd) is now AST_LIST_LIT.
        if _cg_try_fold_struct_update_do(nd) == 1 {
            return nd
        }
        let ds = nd[1]
        let i = 0
        while i < len(ds) {
            cg_fold_stmt(ds[i])
            i = i + 1
        }
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_CONFIDENCE {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_SPREAD {
        return nd
    }
    if tag == AST_LIST_COMP {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[3])
        if len(nd) > 4 {
            if nd[4] != 0 { cg_fold_expr(nd[4]) }
        }
        return nd
    }
    if tag == AST_MAP_COMP {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        cg_fold_expr(nd[4])
        if len(nd) > 5 {
            if nd[5] != 0 { cg_fold_expr(nd[5]) }
        }
        return nd
    }
    if tag == AST_TRY_PROPAGATE {
        cg_fold_expr(nd[1])
        // R20A: const-fold `Result::Ok(constant)?` directly to the
        // constant by recognising the AST_ENUM_CTOR inner pattern.
        // Result::Ok is variant index 0 of the stdlib `Result` enum.
        let inner = nd[1]
        if inner == 0 { return nd }
        if ast_tag(inner) != AST_ENUM_CTOR { return nd }
        if inner[1] != "Result" { return nd }
        if inner[2] != "Ok" { return nd }
        let ctor_args = inner[3]
        if len(ctor_args) != 1 { return nd }
        let only = ctor_args[0]
        if only == 0 { return nd }
        // Replace this AST_TRY_PROPAGATE node with the single payload
        // expression by overwriting its slots. The node's storage list
        // has 2 slots; mutate the tag and child to mimic the payload.
        if ast_tag(only) == AST_INT_LIT {
            _cg_replace_with_int(nd, only[1])
            return nd
        }
        return nd
    }
    return nd
}

// Walk a statement (or block) and fold expressions inside it.
fn cg_fold_stmt(nd) {
    if nd == 0 { return nd }
    let tag = ast_tag(nd)
    if tag == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            cg_fold_stmt(stmts[i])
            i = i + 1
        }
        return nd
    }
    if tag == AST_LET_STMT {
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_ASSIGN_STMT {
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_EXPR_STMT {
        cg_fold_expr(nd[1])
        return nd
    }
    if tag == AST_RETURN_STMT {
        if nd[1] != 0 { cg_fold_expr(nd[1]) }
        return nd
    }
    if tag == AST_IF_STMT {
        cg_fold_expr(nd[1])
        if nd[2] != 0 { cg_fold_stmt(nd[2]) }
        if nd[3] != 0 { cg_fold_stmt(nd[3]) }
        return nd
    }
    if tag == AST_WHILE_STMT {
        cg_fold_expr(nd[1])
        cg_fold_stmt(nd[2])
        if len(nd) > 4 {
            if nd[4] != 0 { cg_fold_stmt(nd[4]) }
        }
        return nd
    }
    if tag == AST_DO_WHILE {
        cg_fold_stmt(nd[1])
        cg_fold_expr(nd[2])
        return nd
    }
    if tag == AST_FOR_STMT {
        cg_fold_expr(nd[2])
        cg_fold_stmt(nd[3])
        if len(nd) > 5 {
            if nd[5] != 0 { cg_fold_stmt(nd[5]) }
        }
        return nd
    }
    if tag == AST_FOR_INDEXED {
        cg_fold_expr(nd[3])
        cg_fold_stmt(nd[4])
        return nd
    }
    if tag == AST_TRY_CATCH {
        cg_fold_stmt(nd[1])
        cg_fold_stmt(nd[2])
        // try_catch shape: [tag, try, catch, err_var, line]               (5 elts, no finally)
        //                  [tag, try, catch, err_var, finally_body, line] (6 elts, with finally)
        // Recurse into finally only when present. The line number sits at
        // the end either way and must not be treated as a statement node.
        if len(nd) > 5 {
            if nd[4] != 0 { cg_fold_stmt(nd[4]) }
        }
        return nd
    }
    if tag == AST_THROW {
        if nd[1] != 0 { cg_fold_expr(nd[1]) }
        return nd
    }
    if tag == AST_MATCH_STMT {
        cg_fold_expr(nd[1])
        let arms = nd[2]
        let i = 0
        while i < len(arms) {
            let arm = arms[i]
            // arm is [AST_MATCH_ARM, pattern, body]
            cg_fold_stmt(arm[2])
            i = i + 1
        }
        return nd
    }
    if tag == AST_DEFER_STMT {
        cg_fold_stmt(nd[1])
        return nd
    }
    if tag == AST_FN_DECL {
        cg_fold_stmt(nd[3])
        return nd
    }
    if tag == AST_METHOD_DECL {
        cg_fold_stmt(nd[4])
        return nd
    }
    if tag == AST_INDEX_ASSIGN {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[2])
        cg_fold_expr(nd[3])
        return nd
    }
    if tag == AST_FIELD_ASSIGN {
        cg_fold_expr(nd[1])
        cg_fold_expr(nd[3])
        return nd
    }
    if tag == AST_DESTRUCTURE {
        cg_fold_expr(nd[2])
        return nd
    }
    // Treat anything else as an expression statement.
    return nd
}

// Top-level constant-folding entry point. Walks every declaration in the
// program AST and folds every expression in place.
//
// R27A.2: before traversing, mirror the program's AST_STRUCT_DECL nodes
// into cg_fold_structs so the struct-init / struct-update folds can
// recover field-declaration order. Runs upstream of cg_init() so we
// cannot reuse cg_structs (still empty at this point).
fn cg_fold_constants(program) {
    if cg_no_opt == 1 { return program }
    if program == 0 { return program }
    _cg_fold_register_structs(program)
    let decls = program[1]
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        let dt = ast_tag(d)
        if dt == AST_FN_DECL {
            cg_fold_stmt(d[3])
        } else {
            if dt == AST_METHOD_DECL {
                cg_fold_stmt(d[4])
            } else {
                cg_fold_stmt(d)
            }
        }
        i = i + 1
    }
    return program
}

// ---- Dead Code Elimination Pass ----
//
// Three categories of dead code targeted:
//   1. Unreachable statements after return/break/continue/throw.
//   2. Constant-condition if/while/do-while:
//        if false { A } else { B }  →  B
//        if true  { A } else { B }  →  A
//        while false { ... }         →  removed entirely
//   3. Unused let bindings whose RHS has no side effects.

// Returns 1 iff the statement unconditionally terminates the enclosing
// block: return / break / continue / throw. Statements after such a
// terminator are dead.
fn _cg_dce_is_terminator(nd) {
    if nd == 0 { return 0 }
    let t = ast_tag(nd)
    if t == AST_RETURN_STMT { return 1 }
    if t == AST_BREAK_STMT { return 1 }
    if t == AST_CONTINUE_STMT { return 1 }
    if t == AST_THROW { return 1 }
    return 0
}

// Returns 1 iff the expression has no observable side effects, i.e. it is
// safe to delete its computation when its result is unused. Conservative:
// only pure literals, ident reads, and arithmetic over those qualify.
// Calls (any callee), assignments, increments, throws etc. are NOT pure.
fn _cg_dce_is_pure(nd) {
    if nd == 0 { return 1 }
    let t = ast_tag(nd)
    if t == AST_INT_LIT { return 1 }
    if t == AST_STR_LIT { return 1 }
    if t == AST_BOOL_LIT { return 1 }
    if t == AST_NONE_LIT { return 1 }
    if t == AST_FLOAT_LIT { return 1 }
    if t == AST_IDENT { return 1 }
    if t == AST_BIN_OP {
        if _cg_dce_is_pure(nd[2]) == 0 { return 0 }
        if _cg_dce_is_pure(nd[3]) == 0 { return 0 }
        return 1
    }
    if t == AST_UNARY_OP {
        return _cg_dce_is_pure(nd[2])
    }
    if t == AST_INDEX_EXPR {
        if _cg_dce_is_pure(nd[1]) == 0 { return 0 }
        if _cg_dce_is_pure(nd[2]) == 0 { return 0 }
        return 1
    }
    if t == AST_FIELD_ACCESS {
        return _cg_dce_is_pure(nd[1])
    }
    if t == AST_TERNARY {
        if _cg_dce_is_pure(nd[1]) == 0 { return 0 }
        if _cg_dce_is_pure(nd[2]) == 0 { return 0 }
        if _cg_dce_is_pure(nd[3]) == 0 { return 0 }
        return 1
    }
    if t == AST_AND_EXPR {
        if _cg_dce_is_pure(nd[1]) == 0 { return 0 }
        if _cg_dce_is_pure(nd[2]) == 0 { return 0 }
        return 1
    }
    if t == AST_OR_EXPR {
        if _cg_dce_is_pure(nd[1]) == 0 { return 0 }
        if _cg_dce_is_pure(nd[2]) == 0 { return 0 }
        return 1
    }
    if t == AST_NULLISH {
        if _cg_dce_is_pure(nd[1]) == 0 { return 0 }
        if _cg_dce_is_pure(nd[2]) == 0 { return 0 }
        return 1
    }
    // CALL, LIST_LIT, MAP_LIT, STRUCT_INIT, LAMBDA, DO_EXPR, LIST_COMP,
    // MAP_COMP, etc. may have observable effects (allocation, calls).
    return 0
}

// Returns 1 iff identifier `name` appears anywhere in expression node.
fn _cg_dce_expr_uses(nd, name) {
    if nd == 0 { return 0 }
    let t = ast_tag(nd)
    if t == AST_IDENT {
        if nd[1] == name { return 1 }
        return 0
    }
    if t == AST_BIN_OP {
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[3], name) == 1 { return 1 }
        return 0
    }
    if t == AST_UNARY_OP {
        return _cg_dce_expr_uses(nd[2], name)
    }
    if t == AST_CALL {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        let args = nd[2]
        let i = 0
        while i < len(args) {
            if _cg_dce_expr_uses(args[i], name) == 1 { return 1 }
            i = i + 1
        }
        return 0
    }
    if t == AST_INDEX_EXPR {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_SLICE {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[3], name) == 1 { return 1 }
        return 0
    }
    if t == AST_FIELD_ACCESS {
        return _cg_dce_expr_uses(nd[1], name)
    }
    if t == AST_TERNARY {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[3], name) == 1 { return 1 }
        return 0
    }
    if t == AST_AND_EXPR {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_OR_EXPR {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_NULLISH {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_LIST_LIT {
        let els = nd[1]
        let i = 0
        while i < len(els) {
            if _cg_dce_expr_uses(els[i], name) == 1 { return 1 }
            i = i + 1
        }
        return 0
    }
    if t == AST_MAP_LIT {
        let ks = nd[1]
        let vs = nd[2]
        let i = 0
        while i < len(ks) {
            if _cg_dce_expr_uses(ks[i], name) == 1 { return 1 }
            if _cg_dce_expr_uses(vs[i], name) == 1 { return 1 }
            i = i + 1
        }
        return 0
    }
    if t == AST_STRUCT_INIT {
        let sv = nd[2]
        let i = 0
        while i < len(sv) {
            if _cg_dce_expr_uses(sv[i], name) == 1 { return 1 }
            i = i + 1
        }
        // R26A: also check the optional spread base on nd[4]. When
        // present this is an AST_IDENT — DCE must not eliminate the
        // local that backs it.
        if len(nd) > 4 {
            if nd[4] != 0 {
                if _cg_dce_expr_uses(nd[4], name) == 1 { return 1 }
            }
        }
        return 0
    }
    if t == AST_PIPE {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_NULL_ACCESS {
        return _cg_dce_expr_uses(nd[1], name)
    }
    if t == AST_LAMBDA {
        return _cg_dce_stmt_uses(nd[3], name)
    }
    if t == AST_DO_EXPR {
        let ds = nd[1]
        let i = 0
        while i < len(ds) {
            if _cg_dce_stmt_uses(ds[i], name) == 1 { return 1 }
            i = i + 1
        }
        return _cg_dce_expr_uses(nd[2], name)
    }
    if t == AST_LIST_COMP {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[3], name) == 1 { return 1 }
        if len(nd) > 4 {
            if nd[4] != 0 {
                if _cg_dce_expr_uses(nd[4], name) == 1 { return 1 }
            }
        }
        return 0
    }
    if t == AST_MAP_COMP {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[4], name) == 1 { return 1 }
        if len(nd) > 5 {
            if nd[5] != 0 {
                if _cg_dce_expr_uses(nd[5], name) == 1 { return 1 }
            }
        }
        return 0
    }
    if t == AST_CONFIDENCE {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_SPREAD {
        if nd[1] == name { return 1 }
        return 0
    }
    // if/match/try can appear in expression position (e.g. `let x = if c { a } else { b }`,
    // `let x = match v { ... }`). Reuse the stmt walker for these.
    if t == AST_IF_STMT { return _cg_dce_stmt_uses(nd, name) }
    if t == AST_MATCH_STMT { return _cg_dce_stmt_uses(nd, name) }
    if t == AST_TRY_CATCH { return _cg_dce_stmt_uses(nd, name) }
    if t == AST_BLOCK { return _cg_dce_stmt_uses(nd, name) }
    if t == AST_TRY_PROPAGATE { return _cg_dce_expr_uses(nd[1], name) }
    return 0
}

// Returns 1 iff identifier `name` appears anywhere in a statement node.
fn _cg_dce_stmt_uses(nd, name) {
    if nd == 0 { return 0 }
    let t = ast_tag(nd)
    if t == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            if _cg_dce_stmt_uses(stmts[i], name) == 1 { return 1 }
            i = i + 1
        }
        return 0
    }
    if t == AST_LET_STMT {
        // The let's own name shadows the outer one — but in the search-
        // pre-deletion case we only ever ask "is `name` used in the rest
        // of the block?" and rely on the caller to skip the let itself.
        return _cg_dce_expr_uses(nd[2], name)
    }
    if t == AST_ASSIGN_STMT {
        if nd[1] == name { return 1 }
        return _cg_dce_expr_uses(nd[2], name)
    }
    if t == AST_EXPR_STMT { return _cg_dce_expr_uses(nd[1], name) }
    if t == AST_RETURN_STMT {
        if nd[1] == 0 { return 0 }
        return _cg_dce_expr_uses(nd[1], name)
    }
    if t == AST_IF_STMT {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if nd[2] != 0 {
            if _cg_dce_stmt_uses(nd[2], name) == 1 { return 1 }
        }
        if nd[3] != 0 {
            if _cg_dce_stmt_uses(nd[3], name) == 1 { return 1 }
        }
        return 0
    }
    if t == AST_WHILE_STMT {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_stmt_uses(nd[2], name) == 1 { return 1 }
        if len(nd) > 4 {
            if nd[4] != 0 {
                if _cg_dce_stmt_uses(nd[4], name) == 1 { return 1 }
            }
        }
        return 0
    }
    if t == AST_DO_WHILE {
        if _cg_dce_stmt_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_FOR_STMT {
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        if _cg_dce_stmt_uses(nd[3], name) == 1 { return 1 }
        if len(nd) > 5 {
            if nd[5] != 0 {
                if _cg_dce_stmt_uses(nd[5], name) == 1 { return 1 }
            }
        }
        return 0
    }
    if t == AST_FOR_INDEXED {
        if _cg_dce_expr_uses(nd[3], name) == 1 { return 1 }
        return _cg_dce_stmt_uses(nd[4], name)
    }
    if t == AST_TRY_CATCH {
        if _cg_dce_stmt_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_stmt_uses(nd[2], name) == 1 { return 1 }
        // finally only present when len > 5 (see ast_try_catch shape note).
        if len(nd) > 5 {
            if nd[4] != 0 {
                if _cg_dce_stmt_uses(nd[4], name) == 1 { return 1 }
            }
        }
        return 0
    }
    if t == AST_THROW {
        if nd[1] == 0 { return 0 }
        return _cg_dce_expr_uses(nd[1], name)
    }
    if t == AST_MATCH_STMT {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        let arms = nd[2]
        let i = 0
        while i < len(arms) {
            let arm = arms[i]
            if _cg_dce_stmt_uses(arm[2], name) == 1 { return 1 }
            i = i + 1
        }
        return 0
    }
    if t == AST_DEFER_STMT {
        return _cg_dce_stmt_uses(nd[1], name)
    }
    if t == AST_INDEX_ASSIGN {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[2], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[3], name) == 1 { return 1 }
        return 0
    }
    if t == AST_FIELD_ASSIGN {
        if _cg_dce_expr_uses(nd[1], name) == 1 { return 1 }
        if _cg_dce_expr_uses(nd[3], name) == 1 { return 1 }
        return 0
    }
    if t == AST_DESTRUCTURE {
        return _cg_dce_expr_uses(nd[2], name)
    }
    if t == AST_FN_DECL {
        return _cg_dce_stmt_uses(nd[3], name)
    }
    if t == AST_METHOD_DECL {
        return _cg_dce_stmt_uses(nd[4], name)
    }
    return 0
}

// Helper to make an AST_BLOCK from a single statement.
fn _cg_dce_singleton_block(stmt) {
    let stmts = list_new()
    push(stmts, stmt)
    return ast_block(stmts)
}

// Rebuilds a stmt-list in place: drops dead stmts after a terminator and
// recursively DCE-ifies each surviving statement. Block-local only —
// unused-let elimination is handled separately at function scope (see
// _cg_dce_drop_unused_lets_in_fn) because NOVA has function-scope let
// hoisting: a `let` inside any nested block is still visible in the
// enclosing function via collect_locals.
fn _cg_dce_block_stmts(stmts) {
    // Pass 1: recurse into nested control-flow.
    let i = 0
    while i < len(stmts) {
        cg_dce_stmt(stmts[i])
        i = i + 1
    }
    // Pass 2: truncate after first terminator (unreachable-after-return).
    let cut = len(stmts)
    let j = 0
    let found = 0
    while j < len(stmts) {
        if found == 0 {
            if _cg_dce_is_terminator(stmts[j]) == 1 {
                cut = j + 1
                found = 1
            }
        }
        j = j + 1
    }
    while len(stmts) > cut {
        pop(stmts)
    }
    return stmts
}

// Function-scope unused-let drop.
// A `let x = pure_expr` is removable iff:
//   1. The RHS is pure (no calls/allocations/visible effects).
//   2. x is never read in any descendant of the function body, except
//      inside the let itself.
//   3. x is never assigned to elsewhere (otherwise removing the let
//      would change semantics of those assignments — they would create
//      a new binding scope).
//   4. The name is not a known global, capture, or compile-time symbol
//      that would still be referenced through indirect codegen paths.
// Conservative: skip destructure lets and lets inside lambdas / loops
// (analyzed only at top-level depth of the function body).
fn _cg_dce_count_reads_anywhere(body_stmts, name, except_idx) {
    let total = 0
    let i = 0
    while i < len(body_stmts) {
        if i == except_idx {
        } else {
            if _cg_dce_stmt_uses(body_stmts[i], name) == 1 {
                total = total + 1
            }
        }
        i = i + 1
    }
    return total
}

// Returns 1 iff there's an AST_ASSIGN_STMT somewhere in the stmt list
// targeting `name`. We don't reach into nested blocks via this check
// (the recursive walk for _cg_dce_stmt_uses already covered them, but
// here we want to be even more conservative about reassignment).
fn _cg_dce_has_assign_to(body_stmts, name) {
    let i = 0
    while i < len(body_stmts) {
        if _cg_dce_stmt_assigns(body_stmts[i], name) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn _cg_dce_stmt_assigns(nd, name) {
    if nd == 0 { return 0 }
    let t = ast_tag(nd)
    if t == AST_ASSIGN_STMT {
        if nd[1] == name { return 1 }
        return 0
    }
    if t == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            if _cg_dce_stmt_assigns(stmts[i], name) == 1 { return 1 }
            i = i + 1
        }
        return 0
    }
    if t == AST_IF_STMT {
        if nd[2] != 0 {
            if _cg_dce_stmt_assigns(nd[2], name) == 1 { return 1 }
        }
        if nd[3] != 0 {
            if _cg_dce_stmt_assigns(nd[3], name) == 1 { return 1 }
        }
        return 0
    }
    if t == AST_WHILE_STMT {
        if _cg_dce_stmt_assigns(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_DO_WHILE { return _cg_dce_stmt_assigns(nd[1], name) }
    if t == AST_FOR_STMT { return _cg_dce_stmt_assigns(nd[3], name) }
    if t == AST_FOR_INDEXED { return _cg_dce_stmt_assigns(nd[4], name) }
    if t == AST_TRY_CATCH {
        if _cg_dce_stmt_assigns(nd[1], name) == 1 { return 1 }
        if _cg_dce_stmt_assigns(nd[2], name) == 1 { return 1 }
        return 0
    }
    if t == AST_MATCH_STMT {
        let arms = nd[2]
        let i = 0
        while i < len(arms) {
            if _cg_dce_stmt_assigns(arms[i][2], name) == 1 { return 1 }
            i = i + 1
        }
        return 0
    }
    if t == AST_DEFER_STMT { return _cg_dce_stmt_assigns(nd[1], name) }
    return 0
}

// Walk a function body's top-level statements and drop pure unused lets.
// Only operates at the top level of the body (no recursing into blocks);
// nested lets are not visible to the outer scope's collect_locals (they
// ARE, but reasoning about them is fragile, so skip).
fn _cg_dce_drop_unused_lets_in_fn(body_stmts) {
    let k = 0
    while k < len(body_stmts) {
        let s = body_stmts[k]
        let stag = ast_tag(s)
        let removed = 0
        if stag == AST_LET_STMT {
            let lname = s[1]
            let lvalue = s[2]
            if _cg_dce_is_pure(lvalue) == 1 {
                // Check no other top-level stmt reads or assigns to lname.
                let reads = _cg_dce_count_reads_anywhere(body_stmts, lname, k)
                if reads == 0 {
                    if _cg_dce_has_assign_to(body_stmts, lname) == 0 {
                        // Shift remaining stmts left.
                        let n = k
                        while n < len(body_stmts) - 1 {
                            body_stmts[n] = body_stmts[n + 1]
                            n = n + 1
                        }
                        pop(body_stmts)
                        removed = 1
                    }
                }
            }
        }
        if removed == 0 {
            k = k + 1
        }
    }
    return body_stmts
}

// Recursively DCE a single statement node, mutating in place. For
// control-flow nodes with constant conditions, the *contents* of the
// node are rewritten in place (e.g. an if(false) becomes the else
// branch's block contents).
fn cg_dce_stmt(nd) {
    if nd == 0 { return nd }
    let t = ast_tag(nd)
    if t == AST_BLOCK {
        _cg_dce_block_stmts(nd[1])
        return nd
    }
    if t == AST_LET_STMT {
        // RHS may contain a lambda or do-expr; recurse into it.
        // (Expression-level fold/DCE handled by fold pass + recursion below.)
        return nd
    }
    if t == AST_ASSIGN_STMT { return nd }
    if t == AST_EXPR_STMT { return nd }
    if t == AST_RETURN_STMT { return nd }
    if t == AST_IF_STMT {
        // Recurse into branches. We DO NOT collapse if-with-constant-cond
        // at the AST level because NOVA permits if/match as both
        // statements AND expressions, and the AST does not distinguish
        // them. Rewriting in place would replace an expression-valued
        // node (RHS of `let a = if true { 42 } else { 0 }`) with a plain
        // block, breaking codegen. The existing per-target codegen
        // already handles constant-cond if-stmts as a separate fast path
        // (see gen_stmt's AST_IF_STMT shortcut around line 2755), which
        // works correctly in both contexts because it emits inline code.
        if nd[2] != 0 { cg_dce_stmt(nd[2]) }
        if nd[3] != 0 { cg_dce_stmt(nd[3]) }
        return nd
    }
    if t == AST_WHILE_STMT {
        // Recurse into body and while-else. We do NOT replace
        // `while false { ... }` in place because while is parsed at both
        // statement and expression boundaries (e.g. `loop { ... }` is
        // desugared to `while 1 { ... }`) and rewriting in place could
        // perturb constant-cond detection in the codegen. The existing
        // per-target codegen already handles a literal-false condition
        // by emitting only the optional while-else and skipping the body
        // (see gen_stmt's AST_WHILE_STMT shortcut around line 3883).
        cg_dce_stmt(nd[2])
        if len(nd) > 4 {
            if nd[4] != 0 { cg_dce_stmt(nd[4]) }
        }
        return nd
    }
    if t == AST_DO_WHILE {
        cg_dce_stmt(nd[1])
        return nd
    }
    if t == AST_FOR_STMT {
        cg_dce_stmt(nd[3])
        if len(nd) > 5 {
            if nd[5] != 0 { cg_dce_stmt(nd[5]) }
        }
        return nd
    }
    if t == AST_FOR_INDEXED {
        cg_dce_stmt(nd[4])
        return nd
    }
    if t == AST_TRY_CATCH {
        cg_dce_stmt(nd[1])
        cg_dce_stmt(nd[2])
        // finally only present when len > 5 (see ast_try_catch shape note).
        if len(nd) > 5 {
            if nd[4] != 0 { cg_dce_stmt(nd[4]) }
        }
        return nd
    }
    if t == AST_THROW { return nd }
    if t == AST_MATCH_STMT {
        let arms = nd[2]
        let i = 0
        while i < len(arms) {
            let arm = arms[i]
            cg_dce_stmt(arm[2])
            i = i + 1
        }
        return nd
    }
    if t == AST_DEFER_STMT {
        cg_dce_stmt(nd[1])
        return nd
    }
    if t == AST_FN_DECL {
        cg_dce_stmt(nd[3])
        return nd
    }
    if t == AST_METHOD_DECL {
        cg_dce_stmt(nd[4])
        return nd
    }
    return nd
}

// Top-level DCE entry point. Walks every declaration in the program AST.
fn cg_eliminate_dead_code(program) {
    if cg_no_opt == 1 { return program }
    if program == 0 { return program }
    let decls = program[1]
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        cg_dce_stmt(d)
        // For function/method bodies, do a function-scope pass to drop
        // pure unused let bindings. Only top-level stmts of the body
        // are examined — nested lets are conservatively left alone.
        let dt = ast_tag(d)
        if dt == AST_FN_DECL {
            if ast_tag(d[3]) == AST_BLOCK {
                _cg_dce_drop_unused_lets_in_fn(d[3][1])
            }
        }
        if dt == AST_METHOD_DECL {
            if ast_tag(d[4]) == AST_BLOCK {
                _cg_dce_drop_unused_lets_in_fn(d[4][1])
            }
        }
        i = i + 1
    }
    return program
}

fn gen_float_operand(nd, xmm_reg) {
    let tag = ast_tag(nd)
    if tag == AST_FLOAT_LIT {
        // R38A: AST_FLOAT_LIT slot[4] is the scientific-notation exponent
        // (0 for non-scientific literals). Tolerate the pre-R38A 3-slot
        // shape by defaulting to 0 when the node is too short.
        let fl_exp = 0
        if len(nd) > 4 { fl_exp = nd[4] }
        let fc_idx = add_float_const(nd[1], nd[2], nd[3], fl_exp)
        out("    movsd " + xmm_reg + ", [rip + _fc_" + int_to_str(fc_idx) + "]")
        return 0
    }
    if tag == AST_INT_LIT {
        out("    mov rax, " + int_to_str(nd[1]))
        out("    cvtsi2sd " + xmm_reg + ", rax")
        return 0
    }
    gen_expr(nd)
    // In float context, assume rax holds IEEE 754 bits (movq, not cvtsi2sd)
    out("    movq " + xmm_reg + ", rax")
    return 0
}

fn gen_float_binop(nd) {
    let op = nd[1]
    gen_float_operand(nd[3], "xmm1")
    out("    sub rsp, 8")
    out("    movsd [rsp], xmm1")
    gen_float_operand(nd[2], "xmm0")
    out("    movsd xmm1, [rsp]")
    out("    add rsp, 8")
    if op == "+" {
        out("    addsd xmm0, xmm1")
        out("    movq rax, xmm0")
        return 0
    }
    if op == "-" {
        out("    subsd xmm0, xmm1")
        out("    movq rax, xmm0")
        return 0
    }
    if op == "*" {
        out("    mulsd xmm0, xmm1")
        out("    movq rax, xmm0")
        return 0
    }
    if op == "/" {
        out("    divsd xmm0, xmm1")
        out("    movq rax, xmm0")
        return 0
    }
    if op == "==" {
        out("    ucomisd xmm0, xmm1")
        out("    sete al")
        out("    setnp cl")
        out("    and al, cl")
        out("    movzx rax, al")
        out("    lea rax, [rax + rax + 1]")
        return 0
    }
    if op == "!=" {
        out("    ucomisd xmm0, xmm1")
        out("    setne al")
        out("    setp cl")
        out("    or al, cl")
        out("    movzx rax, al")
        out("    lea rax, [rax + rax + 1]")
        return 0
    }
    if op == "<" {
        out("    ucomisd xmm0, xmm1")
        out("    setb al")
        out("    movzx rax, al")
        out("    lea rax, [rax + rax + 1]")
        return 0
    }
    if op == ">" {
        out("    ucomisd xmm0, xmm1")
        out("    seta al")
        out("    movzx rax, al")
        out("    lea rax, [rax + rax + 1]")
        return 0
    }
    if op == "<=" {
        out("    ucomisd xmm0, xmm1")
        out("    setbe al")
        out("    movzx rax, al")
        out("    lea rax, [rax + rax + 1]")
        return 0
    }
    if op == ">=" {
        out("    ucomisd xmm0, xmm1")
        out("    setae al")
        out("    movzx rax, al")
        out("    lea rax, [rax + rax + 1]")
        return 0
    }
    out("    movq rax, xmm0")
    return 0
}

fn gen_expr(nd) {
    let tag = ast_tag(nd)

    if tag == AST_INT_LIT {
        // value tagging: integer n is represented as (n<<1)|1
        out("    mov rax, " + int_to_str(nd[1] * 2 + 1))
        return 0
    }

    if tag == AST_FLOAT_LIT {
        // R38A: tolerate the pre-R38A 4-slot shape; default exponent=0.
        let fl_exp2 = 0
        if len(nd) > 4 { fl_exp2 = nd[4] }
        let fc_idx = add_float_const(nd[1], nd[2], nd[3], fl_exp2)
        out("    movsd xmm0, [rip + _fc_" + int_to_str(fc_idx) + "]")
        out("    movq rax, xmm0")
        return 0
    }

    if tag == AST_BOOL_LIT {
        // booleans are tagged ints: false->1, true->3
        out("    mov rax, " + int_to_str(nd[1] * 2 + 1))
        return 0
    }

    if tag == AST_NONE_LIT {
        // None is tagged integer 0 (so it never classifies as a pointer)
        out("    mov eax, 1")
        return 0
    }

    if tag == AST_STR_LIT {
        let idx = add_string(nd[1])
        out("    lea rax, [rip + _str_" + int_to_str(idx) + "]")
        return 0
    }

    if tag == AST_IDENT {
        let name = nd[1]
        if has_local(name) == 1 {
            let off = local_offset(name)
            // R37A: boxed local — load box, then deref to get value.
            if is_boxed_local(name) == 1 {
                out("    mov rax, [rbp - " + int_to_str(off) + "]")
                out("    mov rax, [rax + 24]")
                out("    mov rax, [rax]")
                return 0
            }
            out("    mov rax, [rbp - " + int_to_str(off) + "]")
            return 0
        }
        if is_capture_var(name) == 1 {
            // R37A: read from captures_list[idx][0] via the new box ABI.
            let cidx = capture_index(name)
            cg_emit_capture_load(cidx)
            return 0
        }
        if is_global(name) == 1 {
            out("    mov rax, [rip + _g_" + name + "]")
            return 0
        }
        if is_known_function(name) == 1 {
            out("    lea rax, [rip + " + name + "]")
            return 0
        }
        let off = local_offset(name)
        out("    mov rax, [rbp - " + int_to_str(off) + "]")
        return 0
    }

    if tag == AST_BIN_OP {
        let op = nd[1]

        if is_float_expr(nd) == 1 {
            gen_float_binop(nd)
            return 0
        }

        // --- Optimization: Constant Folding ---
        // If both operands are constant literals, compute at compile time.
        let left_val = try_fold(nd[2])
        let right_val = try_fold(nd[3])

        if is_foldable(left_val) == 1 {
            if is_foldable(right_val) == 1 {
                // Both operands are constants - fold at compile time
                let result = 0
                if op == "+" { result = left_val + right_val }
                if op == "-" { result = left_val - right_val }
                if op == "*" { result = left_val * right_val }
                if op == "/" {
                    if right_val == 0 {
                        // Division by zero: leave result as 0, runtime will catch it
                    } else {
                        result = left_val / right_val
                    }
                }
                if op == "%" {
                    if right_val == 0 {
                        // Mod by zero: leave result as 0
                    } else {
                        result = left_val % right_val
                    }
                }
                if op == "**" {
                    let pw = 1
                    let pi = 0
                    while pi < right_val {
                        pw = pw * left_val
                        pi = pi + 1
                    }
                    result = pw
                }
                if op == "&" { result = left_val & right_val }
                if op == "|" { result = left_val | right_val }
                if op == "^" { result = left_val ^ right_val }
                if op == "<<" { result = left_val << right_val }
                if op == ">>" { result = left_val >> right_val }
                if op == "==" {
                    if left_val == right_val { result = 1 } else { result = 0 }
                }
                if op == "!=" {
                    if left_val == right_val { result = 0 } else { result = 1 }
                }
                if op == "<" {
                    if left_val < right_val { result = 1 } else { result = 0 }
                }
                if op == ">" {
                    if left_val > right_val { result = 1 } else { result = 0 }
                }
                if op == "<=" {
                    if left_val <= right_val { result = 1 } else { result = 0 }
                }
                if op == ">=" {
                    if left_val >= right_val { result = 1 } else { result = 0 }
                }
                out("    mov rax, " + int_to_str(result * 2 + 1))   // tag folded constant
                return 0
            }
        }

        // Identity operation elimination (only for ops without overloaded semantics)
        // +,* are overloaded (string concat/repeat) so NOT safe for identity elim
        if is_foldable(right_val) == 1 {
            let ident_skip = 0
            if right_val == 0 {
                if op == "-" { ident_skip = 1 }
                if op == "|" { ident_skip = 1 }
                if op == "^" { ident_skip = 1 }
                if op == "<<" { ident_skip = 1 }
                if op == ">>" { ident_skip = 1 }
            }
            if right_val == 1 {
                if op == "/" { ident_skip = 1 }
            }
            if ident_skip == 1 {
                gen_expr(nd[2])
                return 0
            }
        }

        // Strength reduction: divide by power of 2 → arithmetic shift right
        let sr_done = 0
        if op == "/" {
            let rv2 = try_fold(nd[3])
            if is_foldable(rv2) == 1 {
                if rv2 > 0 {
                    let sr_shift = log2_exact(rv2)
                    if sr_shift >= 0 {
                        gen_expr(nd[2])
                        out("    sar rax, 1")                              // untag
                        out("    sar rax, " + int_to_str(sr_shift))
                        out("    lea rax, [rax + rax + 1]")                // retag
                        sr_done = 1
                    }
                }
            }
        }
        if sr_done == 1 {
            return 0
        }

        // Non-constant path: generate code for both operands
        let rtag = ast_tag(nd[3])
        let right_simple = 0
        if rtag == AST_INT_LIT { right_simple = 1 }
        if rtag == AST_BOOL_LIT { right_simple = 1 }
        if rtag == AST_NONE_LIT { right_simple = 1 }
        if right_simple == 1 {
            gen_expr(nd[2])
            out("    mov rcx, rax")
            gen_expr(nd[3])
            out("    xchg rax, rcx")
        } else {
            gen_expr(nd[3])
            out("    push rax")
            gen_expr(nd[2])
            out("    pop rcx")
        }
        if op == "+" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_add")
        }
        else { if op == "-" {
            out("    sub rax, rcx")
            out("    inc rax")
        }
        else { if op == "*" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_mul")
        }
        else { if op == "/" {
            out("    sar rax, 1")                       // untag dividend
            out("    sar rcx, 1")                       // untag divisor
            out("    test rcx, rcx")
            out("    jz _div_zero_handler")
            out("    cqo")
            out("    idiv rcx")
            out("    lea rax, [rax + rax + 1]")          // retag quotient
        }
        else { if op == "%" {
            out("    sar rax, 1")                       // untag dividend
            out("    sar rcx, 1")                       // untag divisor
            out("    test rcx, rcx")
            out("    jz _div_zero_handler")
            out("    cqo")
            out("    idiv rcx")
            out("    lea rax, [rdx + rdx + 1]")          // retag remainder
        }
        else { if op == "**" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_pow")
        }
        else { if op == "==" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_eq")
        }
        else { if op == "!=" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_neq")
        }
        else { if op == "<" {
            out("    cmp rax, rcx")
            out("    setl al")
            out("    movzx rax, al")
            out("    lea rax, [rax + rax + 1]")
        }
        else { if op == ">" {
            out("    cmp rax, rcx")
            out("    setg al")
            out("    movzx rax, al")
            out("    lea rax, [rax + rax + 1]")
        }
        else { if op == "<=" {
            out("    cmp rax, rcx")
            out("    setle al")
            out("    movzx rax, al")
            out("    lea rax, [rax + rax + 1]")
        }
        else { if op == ">=" {
            out("    cmp rax, rcx")
            out("    setge al")
            out("    movzx rax, al")
            out("    lea rax, [rax + rax + 1]")
        }
        else { if op == "&" {
            out("    and rax, rcx")
        }
        else { if op == "|" {
            out("    or rax, rcx")
        }
        else { if op == "^" {
            out("    xor rax, rcx")
            out("    or rax, 1")
        }
        else { if op == "<<" {
            out("    sar rcx, 1")
            out("    sar rax, 1")
            out("    shl rax, cl")
            out("    lea rax, [rax + rax + 1]")
        }
        else { if op == ">>" {
            out("    sar rcx, 1")
            out("    sar rax, 1")
            out("    sar rax, cl")
            out("    lea rax, [rax + rax + 1]")
        }
        else {
            out("    # unknown op: " + op)
        } } } } } } } } } } } } } } } } }
        return 0
    }

    if tag == AST_UNARY_OP {
        let op = nd[1]
        if op == "-" {
            if is_float_expr(nd[2]) == 1 {
                gen_float_operand(nd[2], "xmm0")
                out("    mov rax, 1")
                out("    shl rax, 63")
                out("    movq xmm1, rax")
                out("    xorpd xmm0, xmm1")
                out("    movq rax, xmm0")
                return 0
            }
        }
        gen_expr(nd[2])
        if op == "-" {
            out("    neg rax")
            out("    add rax, 2")
        }
        if op == "!" {
            // tagged truthiness: only tagged-0 (== 1) is falsy
            out("    cmp rax, 1")
            out("    sete al")
            out("    movzx rax, al")
            out("    lea rax, [rax + rax + 1]")
        }
        if op == "~" {
            out("    not rax")
            out("    or rax, 1")
        }
        return 0
    }

    if tag == AST_STRUCT_INIT {
        // R25A: brace-init `Foo { field: val, ... }`. Same wire-shape as
        // the positional ctor (R23A): a struct value is a list `[v0, v1,
        // ...]` in field declaration order. Reorder source-order values
        // to decl order, then emit the same _nova_list_new + push loop
        // as the positional ctor.
        // R26A: optional spread base on nd[4] — when set, missing fields
        // are filled from `base.field` (cg_reorder_struct_init_b).
        let s_name = nd[1]
        let s_vals = nd[2]
        let s_names = nd[3]
        let s_base = 0
        if len(nd) > 4 { s_base = nd[4] }
        let ordered = cg_reorder_struct_init_b(s_name, s_names, s_vals, s_base)
        out("    call _nova_list_new")
        out("    push rax")
        let ai = 0
        while ai < len(ordered) {
            gen_expr(ordered[ai])
            out("    mov rsi, rax")
            out("    mov rdi, [rsp]")
            out("    call _nova_push")
            ai = ai + 1
        }
        out("    pop rax")
        return 0
    }

    if tag == AST_CALL {
        let callee = nd[1]
        let args = nd[2]
        let argc = len(args)

        // Check for spread args: foo(...list)
        let has_spread = 0
        let spi = 0
        while spi < argc {
            if ast_tag(args[spi]) == AST_SPREAD { has_spread = 1 }
            spi = spi + 1
        }
        if has_spread == 1 {
            if argc == 1 {
                if ast_tag(args[0]) == AST_SPREAD {
                    let sp_name = ""
                    if ast_tag(callee) == AST_IDENT { sp_name = callee[1] }
                    gen_expr(args[0][1])
                    out("    mov r10, rax")
                    out("    mov r11, [r10 + 24]")
                    let sp_lbl = new_label()
                    out("    cmp qword ptr [r10 + 8], 1")
                    out("    jl " + sp_lbl)
                    out("    mov rdi, [r11]")
                    out("    cmp qword ptr [r10 + 8], 2")
                    out("    jl " + sp_lbl)
                    out("    mov rsi, [r11 + 8]")
                    out("    cmp qword ptr [r10 + 8], 3")
                    out("    jl " + sp_lbl)
                    out("    mov rdx, [r11 + 16]")
                    out("    cmp qword ptr [r10 + 8], 4")
                    out("    jl " + sp_lbl)
                    out("    mov rcx, [r11 + 24]")
                    out("    cmp qword ptr [r10 + 8], 5")
                    out("    jl " + sp_lbl)
                    out("    mov r8, [r11 + 32]")
                    out("    cmp qword ptr [r10 + 8], 6")
                    out("    jl " + sp_lbl)
                    out("    mov r9, [r11 + 40]")
                    out_label(sp_lbl)
                    if sp_name == "" {
                    } else {
                        if is_known_function(sp_name) == 1 {
                            out("    call " + sp_name)
                        } else {
                            if is_global(sp_name) == 1 {
                                out("    push rdi")
                                out("    mov r11, [rip + _g_" + sp_name + "]")
                                out("    pop rdi")
                            } else {
                                let soff = local_offset(sp_name)
                                out("    push rdi")
                                out("    mov r11, [rbp - " + int_to_str(soff) + "]")
                                out("    pop rdi")
                            }
                            out("    call r11")
                        }
                    }
                    return 0
                }
            }
        }

        let callee_name = ""
        let is_direct = 0
        if ast_tag(callee) == AST_IDENT {
            callee_name = callee[1]
            if is_struct_name(callee_name) == 1 {
                // Struct constructor: create a list and push each arg
                out("    call _nova_list_new")
                out("    push rax")
                let ai = 0
                while ai < argc {
                    gen_expr(args[ai])
                    out("    mov rsi, rax")
                    out("    mov rdi, [rsp]")
                    out("    call _nova_push")
                    ai = ai + 1
                }
                out("    pop rax")
                return 0
            }
            if is_known_function(callee_name) == 1 {
                is_direct = 1
            }
        }
        if ast_tag(callee) == AST_FIELD_ACCESS {
            let mbase = callee[1]
            let mname = callee[2]
            let resolved_method = ""
            let mi = 0
            while mi < cg_method_count {
                if cg_methods[mi][1] == mname {
                    resolved_method = cg_methods[mi][0] + "_" + mname
                    mi = cg_method_count
                }
                mi = mi + 1
            }
            if resolved_method == "" {
                if is_known_function(mname) == 1 {
                    resolved_method = mname
                }
            }
            if resolved_method == "" {
            } else {
                let mtotal = argc + 1
                let m_extra = 0
                let m_pad = 0
                if mtotal > 6 {
                    m_extra = mtotal - 6
                    if m_extra % 2 == 1 { m_pad = 8 }
                }
                if m_pad > 0 { out("    sub rsp, 8") }
                let mai = argc - 1
                while mai >= 0 {
                    gen_expr(args[mai])
                    out("    push rax")
                    mai = mai - 1
                }
                gen_expr(mbase)
                out("    push rax")
                if mtotal > 0 { out("    pop rdi") }
                if mtotal > 1 { out("    pop rsi") }
                if mtotal > 2 { out("    pop rdx") }
                if mtotal > 3 { out("    pop rcx") }
                if mtotal > 4 { out("    pop r8") }
                if mtotal > 5 { out("    pop r9") }
                out("    call " + resolved_method)
                if mtotal > 6 {
                    out("    add rsp, " + int_to_str(m_extra * 8 + m_pad))
                }
                return 0
            }
        }
        if is_direct == 1 {
            // Direct call to a known function
            let extra_args = 0
            let align_pad = 0
            if argc > 6 {
                extra_args = argc - 6
                if extra_args % 2 == 1 { align_pad = 8 }
            }
            if align_pad > 0 { out("    sub rsp, 8") }
            let i = argc - 1
            while i >= 0 {
                gen_expr(args[i])
                out("    push rax")
                i = i - 1
            }
            if argc > 0 { out("    pop rdi") }
            if argc > 1 { out("    pop rsi") }
            if argc > 2 { out("    pop rdx") }
            if argc > 3 { out("    pop rcx") }
            if argc > 4 { out("    pop r8") }
            if argc > 5 { out("    pop r9") }
            // R13A: inline SIMD intrinsic call sites on Linux x86-64.
            // Eliminates the call/ret + push rbp/pop rbp overhead that
            // dominated wallclock at small lane counts (~49 lanes per
            // call in stereo SAD), which was the root cause of R12A's
            // realized 0.85x stereo / 0.20x LK regression vs scalar.
            // Args are already in rdi/rsi/rdx so we just emit the
            // AVX2 body directly. The runtime label is still emitted
            // below for fn-pointer callers and other targets.
            if is_inline_builtin_fn(callee_name) == 1 {
                emit_inline_simd(callee_name)
                return 0
            }
            let call_target = callee_name
            if cg_link_libc == 1 {
                if callee_name == "main" {
                    call_target = "_user_main"
                }
            }
            out("    call " + call_target)
            if argc > 6 {
                out("    add rsp, " + int_to_str(extra_args * 8 + align_pad))
            }
        } else {
            // R37A: indirect call dispatch. The callee VALUE may be:
            //   (a) a closure tuple `[fn_ptr, captures_list]` — the new
            //       R37A shape produced by AST_LAMBDA. Recognized by
            //       `[rax] == -1` (list magic word). Calling convention is
            //       fn_ptr(captures_list, original_args...).
            //   (b) a raw top-level fn pointer (legacy: `let f = double`
            //       where `double` is a known top-level fn). The compiled
            //       fn takes args in the original order without a hidden
            //       captures_list.
            //
            // We pick the path at runtime via the magic-word check. Args are
            // first pushed onto the stack so we don't need to know the path
            // before evaluating them; then we load callee into rax, detect,
            // and pop into the right registers.
            let ind_total = argc + 1  // +1 for captures_list in worst case
            let ind_pad = 0
            if ind_total > 6 {
                let ind_extra = ind_total - 6
                if ind_extra % 2 == 1 { ind_pad = 8 }
            } else {
                // Even for closure path we may push 6 slots; align to 16.
                if argc > 5 {
                    if (argc - 5) % 2 == 1 { ind_pad = 8 }
                }
            }
            if ind_pad > 0 { out("    sub rsp, 8") }
            // Evaluate args first, push onto stack (right-to-left).
            let i = argc - 1
            while i >= 0 {
                gen_expr(args[i])
                out("    push rax")
                i = i - 1
            }
            // Load callee value into rax.
            if ast_tag(callee) == AST_IDENT {
                if is_global(callee_name) == 1 {
                    out("    mov rax, [rip + _g_" + callee_name + "]")
                } else {
                    let off = local_offset(callee_name)
                    if is_boxed_local(callee_name) == 1 {
                        out("    mov rax, [rbp - " + int_to_str(off) + "]")
                        out("    mov rax, [rax + 24]")
                        out("    mov rax, [rax]")
                    } else {
                        out("    mov rax, [rbp - " + int_to_str(off) + "]")
                    }
                }
            } else {
                gen_expr(callee)
            }
            // Runtime detection: closure tuple vs raw fn ptr.
            let legacy_lbl = new_label()
            let dispatch_lbl = new_label()
            out("    cmp qword ptr [rax], -1")
            out("    jne " + legacy_lbl)
            // Closure path: rax is the tuple. Extract fn_ptr + captures_list.
            out("    mov rcx, [rax + 24]")
            out("    mov r11, [rcx]")           // fn_ptr at slot 0
            out("    mov rax, [rcx + 8]")       // captures_list at slot 1
            out("    mov rdi, rax")              // captures_list -> rdi (synthetic 1st arg)
            if argc > 0 { out("    pop rsi") }
            if argc > 1 { out("    pop rdx") }
            if argc > 2 { out("    pop rcx") }
            if argc > 3 { out("    pop r8") }
            if argc > 4 { out("    pop r9") }
            out("    jmp " + dispatch_lbl)
            out_label(legacy_lbl)
            // Legacy path: rax is a raw fn ptr. Original args -> rdi/rsi/...
            out("    mov r11, rax")
            if argc > 0 { out("    pop rdi") }
            if argc > 1 { out("    pop rsi") }
            if argc > 2 { out("    pop rdx") }
            if argc > 3 { out("    pop rcx") }
            if argc > 4 { out("    pop r8") }
            if argc > 5 { out("    pop r9") }
            out_label(dispatch_lbl)
            out("    call r11")
            if argc > 5 {
                out("    add rsp, " + int_to_str((argc - 5) * 8 + ind_pad))
            } else {
                if ind_pad > 0 { out("    add rsp, " + int_to_str(ind_pad)) }
            }
        }
        return 0
    }

    if tag == AST_LIST_LIT {
        let elems = nd[1]
        let ecount = len(elems)
        out("    call _nova_list_new")
        if ecount > 0 {
            out("    push rax")
            let ei = 0
            while ei < ecount {
                gen_expr(elems[ei])
                out("    mov rsi, rax")
                out("    mov rdi, [rsp]")
                out("    call _nova_push")
                ei = ei + 1
            }
            out("    pop rax")
        }
        return 0
    }

    // R17A: sum-type variant constructor. Lowers to a fresh list whose
    // first slot is the variant's declaration-order tag. e.g.
    //   Option::Some(42)  ->  [0, 42]
    //   Option::None      ->  [1]
    if tag == AST_ENUM_CTOR {
        let ec_enum = nd[1]
        let ec_variant = nd[2]
        let ec_args = nd[3]
        let ec_tag = enum_variant_index(ec_enum, ec_variant)
        out("    call _nova_list_new")
        out("    push rax")
        out("    mov rax, " + int_to_str(ec_tag))
        out("    mov rsi, rax")
        out("    mov rdi, [rsp]")
        out("    call _nova_push")
        let eci = 0
        while eci < len(ec_args) {
            gen_expr(ec_args[eci])
            out("    mov rsi, rax")
            out("    mov rdi, [rsp]")
            out("    call _nova_push")
            eci = eci + 1
        }
        out("    pop rax")
        return 0
    }

    // R20A: postfix `?` Result propagation. Evaluate the inner
    // expression to a tagged tuple `[tag, payload]`; if tag==0 (Ok)
    // unwrap to `payload` and continue, otherwise return the whole
    // tagged tuple from the enclosing function — which IS the Err
    // Result — preserving its payload string. Defers run on the
    // early-return path so the function's cleanup is still honoured.
    if tag == AST_TRY_PROPAGATE {
        let ok_lbl = new_label()
        gen_expr(nd[1])
        out("    push rax")
        out("    mov rdi, rax")
        out("    mov rsi, 0")
        out("    call _nova_index")
        out("    cmp rax, 2")
        out("    jb " + ok_lbl)
        // Err path: return the original tagged tuple unchanged.
        if cg_defer_count > 0 {
            gen_defers()
        }
        out("    pop rax")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
        out_label(ok_lbl)
        // Ok path: replace value with payload at index 1.
        out("    pop rdi")
        out("    mov rsi, 1")
        out("    call _nova_index")
        return 0
    }

    if tag == AST_LAMBDA {
        // R37A: a closure value is a 2-element list `[fn_ptr, captures_list]`.
        // captures_list is a fresh per-instance list whose i-th slot is a
        // 1-element BOX holding the captured variable's value. Boxes are
        // SHARED with the enclosing scope (when the captured local was
        // declared as a boxed local — see is_boxed_local handling in
        // gen_function/let-stmt), giving by-reference semantics: a write
        // in either the source scope OR through the closure mutates the
        // same storage and is observable from both sides.
        let lname = nd[1]
        let lcaps = get_lambda_caps(lname)
        let lcap_count = len(lcaps)
        // Step 1: allocate captures_list (or 0 if no captures).
        if lcap_count == 0 {
            out("    xor eax, eax")
            out("    push rax")
        } else {
            out("    call _nova_list_new")
            out("    push rax")
            let lci = 0
            while lci < lcap_count {
                let cap_nm = lcaps[lci]
                // Fetch the box pointer for cap_nm. Sources, in priority:
                //  (a) a boxed local in the CURRENT scope -> stack slot
                //      holds the box pointer directly; load and reuse it.
                //  (b) a capture of the CURRENT scope (nested closure) ->
                //      forward the box pointer from this fn's captures_list
                //      (captures_list[outer_idx]).
                //  (c) a non-boxed local (shouldn't happen for captures, since
                //      compute_captures + cg_compute_boxed_locals_for_fn co-ordinate;
                //      but we fall back to wrapping the value in a fresh box).
                //  (d) a global -> wrap the current global value into a fresh
                //      box (globals don't share storage with the closure by
                //      design; this preserves R35C's "globals are live via
                //      _g_<name>" behaviour by reading the global at call time
                //      via is_global in the body, NOT via the box. The box is
                //      never read for globals since compute_captures excludes
                //      globals from the capture set in the first place.)
                if is_global(cap_nm) == 1 {
                    out("    mov rax, [rip + _g_" + cap_nm + "]")
                    cg_emit_alloc_box()
                } else {
                    if is_capture_var(cap_nm) == 1 {
                        // Outer closure forwarding: load the box from THIS
                        // fn's captures_list at the outer capture index.
                        let outer_idx = capture_index(cap_nm)
                        cg_emit_capture_box(outer_idx)
                    } else {
                        if has_local(cap_nm) == 1 {
                            if is_boxed_local(cap_nm) == 1 {
                                let lo = local_offset(cap_nm)
                                out("    mov rax, [rbp - " + int_to_str(lo) + "]")
                            } else {
                                let lo2 = local_offset(cap_nm)
                                out("    mov rax, [rbp - " + int_to_str(lo2) + "]")
                                cg_emit_alloc_box()
                            }
                        } else {
                            // Fallback: best-effort wrap current value.
                            let lo3 = local_offset(cap_nm)
                            out("    mov rax, [rbp - " + int_to_str(lo3) + "]")
                            cg_emit_alloc_box()
                        }
                    }
                }
                // Push the box (in rax) onto captures_list.
                out("    mov rsi, rax")
                out("    mov rdi, [rsp]")
                out("    call _nova_push")
                lci = lci + 1
            }
            // captures_list is on top of stack; leave it there for the
            // closure-tuple construction below.
        }
        // Step 2: build the closure tuple [fn_ptr, captures_list].
        // captures_list (or 0) is currently on top of stack.
        out("    call _nova_list_new")
        out("    push rax")
        out("    lea rax, [rip + " + lname + "]")
        out("    mov rsi, rax")
        out("    mov rdi, [rsp]")
        out("    call _nova_push")
        out("    pop rax")        // tuple in rax
        out("    pop rcx")        // captures_list in rcx
        out("    push rax")        // tuple back on stack
        out("    mov rsi, rcx")
        out("    mov rdi, [rsp]")
        out("    call _nova_push")
        out("    pop rax")        // final tuple in rax
        return 0
    }

