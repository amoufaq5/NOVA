    out_label("_nova_sys_getsockopt_so_error")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 48")
        out("    mov dword ptr [rbp - 8], 0")     // optval out = 0
        out("    mov dword ptr [rbp - 12], 4")    // optlen = 4
        out("    mov rcx, rdi")                    // s = fd
