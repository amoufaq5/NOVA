    out("    mov rax, rdi")
    out("    xor edx, edx")
    out("    mov rcx, 1000")
    out("    div rcx")
    out("    mov [rbp - 16], rax")
    out("    imul rdx, rdx, 1000000")
    out("    mov [rbp - 8], rdx")
    out("    lea rdi, [rbp - 16]")
    out("    xor esi, esi")
    out("    mov rax, 35")
    out("    syscall")
    out("    xor eax, eax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

