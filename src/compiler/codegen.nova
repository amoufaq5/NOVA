    // --- R31A: sys_getsockopt_so_error(fd) -> int ---
    //
    // Reads the deferred connect(2) error from a non-blocking socket
    // after sys_poll(POLLOUT) has reported the fd ready. The value is
    // the SO_ERROR int itself, NOT the getsockopt return code: 0 means
