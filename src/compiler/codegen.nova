    out("    cmovge rax, rdi")
    out("    cmovl rax, rsi")
    out("    ret")

    // --- time() -> current epoch seconds ---
    out("")
    out_label("_nova_time")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    out("    xor edi, edi")
    out("    lea rsi, [rbp - 16]")
    out("    mov rax, 228")
    out("    syscall")
    out("    mov rax, [rbp - 16]")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

