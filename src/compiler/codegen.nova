fn is_known_function(name) {
    // Check user-defined functions
    let fi = 0
    while fi < len(cg_fns) {
        if cg_fns[fi] == name {
            return 1
        }
        fi = fi + 1
    }
    // Check builtins
    if is_builtin_fn(name) == 1 {
        return 1
    }
    return 0
}

// --- Optimization: Constant Folding Helpers ---
// Sentinel value indicating a node cannot be constant-folded.
// Using a large negative value that is unlikely to appear in real code.
let FOLD_SENTINEL = 0 - 999999999

fn log2_exact(v) {
    if v <= 0 { return 0 - 1 }
    if v == 1 { return 0 }
    if v == 2 { return 1 }
    if v == 4 { return 2 }
    if v == 8 { return 3 }
    if v == 16 { return 4 }
    if v == 32 { return 5 }
    if v == 64 { return 6 }
    if v == 128 { return 7 }
    if v == 256 { return 8 }
    if v == 512 { return 9 }
    if v == 1024 { return 10 }
    if v == 2048 { return 11 }
    if v == 4096 { return 12 }
    return 0 - 1
}

fn try_fold(nd) {
    let tag = ast_tag(nd)
    if tag == AST_INT_LIT { return nd[1] }
    if tag == AST_FLOAT_LIT { return nd[1] }
    if tag == AST_BOOL_LIT { return nd[1] }
    if tag == AST_NONE_LIT { return 0 }
    if tag == AST_UNARY_OP {
        let inner = try_fold(nd[2])
        if inner == FOLD_SENTINEL { return FOLD_SENTINEL }
        if nd[1] == "-" { return 0 - inner }
        if nd[1] == "!" {
            if inner == 0 { return 1 }
            return 0
        }
        return FOLD_SENTINEL
    }
    if tag == AST_BIN_OP {
        let lv = try_fold(nd[2])
        if lv == FOLD_SENTINEL { return FOLD_SENTINEL }
        let rv = try_fold(nd[3])
        if rv == FOLD_SENTINEL { return FOLD_SENTINEL }
        let op = nd[1]
        if op == "+" { return lv + rv }
        if op == "-" { return lv - rv }
        if op == "*" { return lv * rv }
        if op == "/" {
            if rv == 0 { return FOLD_SENTINEL }
            return lv / rv
        }
        if op == "%" {
            if rv == 0 { return FOLD_SENTINEL }
            return lv % rv
        }
        if op == "&" { return lv & rv }
        if op == "|" { return lv | rv }
        if op == "^" { return lv ^ rv }
        if op == "<<" { return lv << rv }
        if op == ">>" { return lv >> rv }
        if op == "==" {
            if lv == rv { return 1 }
            return 0
        }
        if op == "<" {
            if lv < rv { return 1 }
            return 0
        }
        if op == ">" {
            if lv > rv { return 1 }
            return 0
        }
        if op == "<=" {
            if lv <= rv { return 1 }
            return 0
        }
        if op == ">=" {
            if lv >= rv { return 1 }
            return 0
        }
        return FOLD_SENTINEL
    }
    return FOLD_SENTINEL
}

fn is_foldable(val) {
    if val == FOLD_SENTINEL { return 0 }
    return 1
}

fn gen_expr(nd) {
    let tag = ast_tag(nd)

    if tag == AST_INT_LIT {
        out("    mov rax, " + int_to_str(nd[1]))
        return 0
    }

    if tag == AST_FLOAT_LIT {
        out("    mov rax, " + int_to_str(nd[1]))
        return 0
    }

    if tag == AST_BOOL_LIT {
        out("    mov rax, " + int_to_str(nd[1]))
        return 0
    }

    if tag == AST_NONE_LIT {
        out("    xor eax, eax")
        return 0
    }

    if tag == AST_STR_LIT {
        let idx = add_string(nd[1])
        out("    lea rax, [rip + _str_" + int_to_str(idx) + "]")
        return 0
    }

    if tag == AST_IDENT {
        let name = nd[1]
        if has_local(name) == 1 {
            let off = local_offset(name)
            out("    mov rax, [rbp - " + int_to_str(off) + "]")
            return 0
        }
        if is_capture_var(name) == 1 {
            out("    mov rax, [rip + _cap_" + cg_current_cap_name + "_" + name + "]")
            return 0
        }
        if is_global(name) == 1 {
            out("    mov rax, [rip + _g_" + name + "]")
            return 0
        }
        if is_known_function(name) == 1 {
            out("    lea rax, [rip + " + name + "]")
            return 0
        }
        let off = local_offset(name)
        out("    mov rax, [rbp - " + int_to_str(off) + "]")
        return 0
    }

    if tag == AST_BIN_OP {
        let op = nd[1]

        // --- Optimization: Constant Folding ---
        // If both operands are constant literals, compute at compile time.
        let left_val = try_fold(nd[2])
        let right_val = try_fold(nd[3])

        if is_foldable(left_val) == 1 {
            if is_foldable(right_val) == 1 {
                // Both operands are constants - fold at compile time
                let result = 0
                if op == "+" { result = left_val + right_val }
                if op == "-" { result = left_val - right_val }
                if op == "*" { result = left_val * right_val }
                if op == "/" {
                    if right_val == 0 {
                        // Division by zero: leave result as 0, runtime will catch it
                    } else {
                        result = left_val / right_val
                    }
                }
                if op == "%" {
                    if right_val == 0 {
                        // Mod by zero: leave result as 0
                    } else {
                        result = left_val % right_val
                    }
                }
                if op == "**" {
                    let pw = 1
                    let pi = 0
                    while pi < right_val {
                        pw = pw * left_val
                        pi = pi + 1
                    }
                    result = pw
                }
                if op == "&" { result = left_val & right_val }
                if op == "|" { result = left_val | right_val }
                if op == "^" { result = left_val ^ right_val }
                if op == "<<" { result = left_val << right_val }
                if op == ">>" { result = left_val >> right_val }
                if op == "==" {
                    if left_val == right_val { result = 1 } else { result = 0 }
                }
                if op == "!=" {
                    if left_val == right_val { result = 0 } else { result = 1 }
                }
                if op == "<" {
                    if left_val < right_val { result = 1 } else { result = 0 }
                }
                if op == ">" {
                    if left_val > right_val { result = 1 } else { result = 0 }
                }
                if op == "<=" {
                    if left_val <= right_val { result = 1 } else { result = 0 }
                }
                if op == ">=" {
                    if left_val >= right_val { result = 1 } else { result = 0 }
                }
                out("    mov rax, " + int_to_str(result))
                return 0
            }
        }

        // Identity operation elimination (only for ops without overloaded semantics)
        // +,* are overloaded (string concat/repeat) so NOT safe for identity elim
        if is_foldable(right_val) == 1 {
            let ident_skip = 0
            if right_val == 0 {
                if op == "-" { ident_skip = 1 }
                if op == "|" { ident_skip = 1 }
                if op == "^" { ident_skip = 1 }
                if op == "<<" { ident_skip = 1 }
                if op == ">>" { ident_skip = 1 }
            }
            if right_val == 1 {
                if op == "/" { ident_skip = 1 }
            }
            if ident_skip == 1 {
                gen_expr(nd[2])
                return 0
            }
        }

        // Strength reduction: divide by power of 2 → arithmetic shift right
        let sr_done = 0
        if op == "/" {
            let rv2 = try_fold(nd[3])
            if is_foldable(rv2) == 1 {
                if rv2 > 0 {
                    let sr_shift = log2_exact(rv2)
                    if sr_shift >= 0 {
                        gen_expr(nd[2])
                        out("    sar rax, " + int_to_str(sr_shift))
                        sr_done = 1
                    }
                }
            }
        }
        if sr_done == 1 {
            return 0
        }

        // Non-constant path: generate code for both operands
        let rtag = ast_tag(nd[3])
        let right_simple = 0
        if rtag == AST_INT_LIT { right_simple = 1 }
        if rtag == AST_BOOL_LIT { right_simple = 1 }
        if rtag == AST_NONE_LIT { right_simple = 1 }
        if right_simple == 1 {
            gen_expr(nd[2])
            out("    mov rcx, rax")
            gen_expr(nd[3])
            out("    xchg rax, rcx")
        } else {
            gen_expr(nd[3])
            out("    push rax")
            gen_expr(nd[2])
            out("    pop rcx")
        }
        if op == "+" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_add")
        }
        else { if op == "-" { out("    sub rax, rcx") }
        else { if op == "*" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_mul")
        }
        else { if op == "/" {
            out("    test rcx, rcx")
            out("    jz _div_zero_handler")
            out("    cqo")
            out("    idiv rcx")
        }
        else { if op == "%" {
            out("    test rcx, rcx")
            out("    jz _div_zero_handler")
            out("    cqo")
            out("    idiv rcx")
            out("    mov rax, rdx")
        }
        else { if op == "**" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_pow")
        }
        else { if op == "==" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_eq")
        }
        else { if op == "!=" {
            out("    mov rdi, rax")
            out("    mov rsi, rcx")
            out("    call _nova_neq")
        }
        else { if op == "<" {
            out("    cmp rax, rcx")
            out("    setl al")
            out("    movzx rax, al")
        }
        else { if op == ">" {
            out("    cmp rax, rcx")
            out("    setg al")
            out("    movzx rax, al")
        }
        else { if op == "<=" {
            out("    cmp rax, rcx")
            out("    setle al")
            out("    movzx rax, al")
        }
        else { if op == ">=" {
            out("    cmp rax, rcx")
            out("    setge al")
            out("    movzx rax, al")
        }
        else { if op == "&" {
            out("    and rax, rcx")
        }
        else { if op == "|" {
            out("    or rax, rcx")
        }
        else { if op == "^" {
            out("    xor rax, rcx")
        }
        else { if op == "<<" {
            out("    shl rax, cl")
        }
        else { if op == ">>" {
            out("    sar rax, cl")
        }
        else {
            out("    # unknown op: " + op)
        } } } } } } } } } } } } } } } } }
        return 0
    }

    if tag == AST_UNARY_OP {
        let op = nd[1]
        gen_expr(nd[2])
        if op == "-" {
            out("    neg rax")
        }
        if op == "!" {
            out("    test rax, rax")
            out("    sete al")
            out("    movzx rax, al")
        }
        if op == "~" {
            out("    not rax")
        }
        return 0
    }

    if tag == AST_CALL {
        let callee = nd[1]
        let args = nd[2]
        let argc = len(args)

        // Check for spread args: foo(...list)
        let has_spread = 0
        let spi = 0
        while spi < argc {
            if ast_tag(args[spi]) == AST_SPREAD { has_spread = 1 }
            spi = spi + 1
        }
        if has_spread == 1 {
            if argc == 1 {
                if ast_tag(args[0]) == AST_SPREAD {
                    let sp_name = ""
                    if ast_tag(callee) == AST_IDENT { sp_name = callee[1] }
                    gen_expr(args[0][1])
                    out("    mov r10, rax")
                    out("    mov r11, [r10 + 24]")
                    let sp_lbl = new_label()
                    out("    cmp qword ptr [r10 + 8], 1")
                    out("    jl " + sp_lbl)
                    out("    mov rdi, [r11]")
                    out("    cmp qword ptr [r10 + 8], 2")
                    out("    jl " + sp_lbl)
                    out("    mov rsi, [r11 + 8]")
                    out("    cmp qword ptr [r10 + 8], 3")
                    out("    jl " + sp_lbl)
                    out("    mov rdx, [r11 + 16]")
                    out("    cmp qword ptr [r10 + 8], 4")
                    out("    jl " + sp_lbl)
                    out("    mov rcx, [r11 + 24]")
                    out("    cmp qword ptr [r10 + 8], 5")
                    out("    jl " + sp_lbl)
                    out("    mov r8, [r11 + 32]")
                    out("    cmp qword ptr [r10 + 8], 6")
                    out("    jl " + sp_lbl)
                    out("    mov r9, [r11 + 40]")
                    out_label(sp_lbl)
                    if sp_name == "" {
                    } else {
                        if is_known_function(sp_name) == 1 {
                            out("    call " + sp_name)
                        } else {
                            if is_global(sp_name) == 1 {
                                out("    push rdi")
                                out("    mov r11, [rip + _g_" + sp_name + "]")
                                out("    pop rdi")
                            } else {
                                let soff = local_offset(sp_name)
                                out("    push rdi")
                                out("    mov r11, [rbp - " + int_to_str(soff) + "]")
                                out("    pop rdi")
                            }
                            out("    call r11")
                        }
                    }
                    return 0
                }
            }
        }

        let callee_name = ""
        let is_direct = 0
        if ast_tag(callee) == AST_IDENT {
            callee_name = callee[1]
            if is_struct_name(callee_name) == 1 {
                // Struct constructor: create a list and push each arg
                out("    call _nova_list_new")
                out("    push rax")
                let ai = 0
                while ai < argc {
                    gen_expr(args[ai])
                    out("    mov rsi, rax")
                    out("    mov rdi, [rsp]")
                    out("    call _nova_push")
                    ai = ai + 1
                }
                out("    pop rax")
                return 0
            }
            if is_known_function(callee_name) == 1 {
                is_direct = 1
            }
        }
        if ast_tag(callee) == AST_FIELD_ACCESS {
            let mbase = callee[1]
            let mname = callee[2]
            let resolved_method = ""
            let mi = 0
            while mi < cg_method_count {
                if cg_methods[mi][1] == mname {
                    resolved_method = cg_methods[mi][0] + "_" + mname
                    mi = cg_method_count
                }
                mi = mi + 1
            }
            if resolved_method == "" {
                if is_known_function(mname) == 1 {
                    resolved_method = mname
                }
            }
            if resolved_method == "" {
            } else {
                let mai = argc - 1
                while mai >= 0 {
                    gen_expr(args[mai])
                    out("    push rax")
                    mai = mai - 1
                }
                gen_expr(mbase)
                out("    push rax")
                let mtotal = argc + 1
                if mtotal > 0 { out("    pop rdi") }
                if mtotal > 1 { out("    pop rsi") }
                if mtotal > 2 { out("    pop rdx") }
                if mtotal > 3 { out("    pop rcx") }
                if mtotal > 4 { out("    pop r8") }
                if mtotal > 5 { out("    pop r9") }
                out("    call " + resolved_method)
                return 0
            }
        }
        if is_direct == 1 {
            // Direct call to a known function
            let i = argc - 1
            while i >= 0 {
                gen_expr(args[i])
                out("    push rax")
                i = i - 1
            }
            if argc > 0 { out("    pop rdi") }
            if argc > 1 { out("    pop rsi") }
            if argc > 2 { out("    pop rdx") }
            if argc > 3 { out("    pop rcx") }
            if argc > 4 { out("    pop r8") }
            if argc > 5 { out("    pop r9") }
            out("    call " + callee_name)
        } else {
            // Indirect call through a function pointer variable
            // Evaluate args first, push onto stack
            let i = argc - 1
            while i >= 0 {
                gen_expr(args[i])
                out("    push rax")
                i = i - 1
            }
            if argc > 0 { out("    pop rdi") }
            if argc > 1 { out("    pop rsi") }
            if argc > 2 { out("    pop rdx") }
            if argc > 3 { out("    pop rcx") }
            if argc > 4 { out("    pop r8") }
            if argc > 5 { out("    pop r9") }
            // Load function pointer into r11 (caller-saved, not used for args)
            // The callee could be an identifier (variable) or any expression
            if ast_tag(callee) == AST_IDENT {
                if is_global(callee_name) == 1 {
                    out("    mov r11, [rip + _g_" + callee_name + "]")
                } else {
                    let off = local_offset(callee_name)
                    out("    mov r11, [rbp - " + int_to_str(off) + "]")
                }
            } else {
                // Complex expression callee - save arg registers, evaluate, restore
                // For now, push all arg regs, evaluate callee, then restore
                if argc > 0 { out("    push rdi") }
                if argc > 1 { out("    push rsi") }
                gen_expr(callee)
                out("    mov r11, rax")
                if argc > 1 { out("    pop rsi") }
                if argc > 0 { out("    pop rdi") }
            }
            out("    call r11")
        }
        return 0
    }

    if tag == AST_LIST_LIT {
        let elems = nd[1]
        let ecount = len(elems)
        out("    call _nova_list_new")
        if ecount > 0 {
            out("    push rax")
            let ei = 0
            while ei < ecount {
                gen_expr(elems[ei])
                out("    mov rsi, rax")
                out("    mov rdi, [rsp]")
                out("    call _nova_push")
                ei = ei + 1
            }
            out("    pop rax")
        }
        return 0
    }

    if tag == AST_LAMBDA {
        let lname = nd[1]
        let lcaps = get_lambda_caps(lname)
        let lci = 0
        while lci < len(lcaps) {
            let cap_nm = lcaps[lci]
            if is_global(cap_nm) == 1 {
                out("    mov rax, [rip + _g_" + cap_nm + "]")
            } else {
                if is_capture_var(cap_nm) == 1 {
                    out("    mov rax, [rip + _cap_" + cg_current_cap_name + "_" + cap_nm + "]")
                } else {
                    let cap_off = local_offset(cap_nm)
                    out("    mov rax, [rbp - " + int_to_str(cap_off) + "]")
                }
            }
            out("    mov [rip + _cap_" + lname + "_" + cap_nm + "], rax")
            lci = lci + 1
        }
        out("    lea rax, [rip + " + lname + "]")
        return 0
    }

    if tag == AST_FIELD_ACCESS {
        let base = nd[1]
        let field_name = nd[2]
        // Check if base is an enum name
        if ast_tag(base) == AST_IDENT {
            let base_name = base[1]
            if is_enum_name(base_name) == 1 {
                let vidx = enum_variant_index(base_name, field_name)
                out("    mov rax, " + int_to_str(vidx))
                return 0
            }
        }
        let idx = find_field_index(field_name)
        gen_expr(base)
        out("    mov rcx, [rax + 24]")
        out("    mov rax, [rcx + " + int_to_str(idx * 8) + "]")
        return 0
    }

    if tag == AST_INDEX_EXPR {
        gen_expr(nd[2])
        out("    push rax")
        gen_expr(nd[1])
        out("    pop rcx")
        out("    mov rdi, rax")
        out("    mov rsi, rcx")
        out("    call _nova_index")
        return 0
    }

    if tag == AST_AND_EXPR {
        let end_lbl = new_label()
        gen_expr(nd[1])
        out("    test rax, rax")
        out("    jz " + end_lbl)
        gen_expr(nd[2])
        out("    test rax, rax")
        out("    jz " + end_lbl)
        out("    mov rax, 1")
        out_label(end_lbl)
        return 0
    }

    if tag == AST_OR_EXPR {
        let true_lbl = new_label()
        let end_lbl = new_label()
        gen_expr(nd[1])
        out("    test rax, rax")
        out("    jnz " + true_lbl)
        gen_expr(nd[2])
        out("    test rax, rax")
        out("    jnz " + true_lbl)
        out("    xor eax, eax")
        out("    jmp " + end_lbl)
        out_label(true_lbl)
        out("    mov rax, 1")
        out_label(end_lbl)
        return 0
    }

    if tag == AST_NULLISH {
        let else_lbl = new_label()
        let end_lbl = new_label()
        gen_expr(nd[1])
        out("    test rax, rax")
        out("    jnz " + end_lbl)
        gen_expr(nd[2])
        out_label(end_lbl)
        return 0
    }

    if tag == AST_FLOW {
        cg_has_flow = 1
        let ft = nd[1]
        gen_expr(nd[3])
        out("    push rax")
        gen_expr(nd[2])
        out("    pop rsi")
        out("    mov rdi, rax")
        if ft == FLOW_FWD { out("    call _nova_flow_fwd") }
        if ft == FLOW_BWD { out("    call _nova_flow_bwd") }
        if ft == FLOW_BROADCAST { out("    call _nova_flow_broadcast") }
        if ft == FLOW_ENRICH { out("    call _nova_flow_enrich") }
        if ft == FLOW_TENTATIVE { out("    call _nova_flow_tentative") }
        if ft == FLOW_RESONATE { out("    call _nova_flow_resonate") }
        if ft == FLOW_FILTER { out("    call _nova_flow_filter") }
        return 0
    }

    if tag == AST_TERNARY {
        let else_lbl = new_label()
        let end_lbl = new_label()
        gen_expr(nd[1])
        out("    test rax, rax")
        out("    jz " + else_lbl)
        gen_expr(nd[2])
        out("    jmp " + end_lbl)
        out_label(else_lbl)
        gen_expr(nd[3])
        out_label(end_lbl)
        return 0
    }

    if tag == AST_LIST_COMP {
        let comp_expr = nd[1]
        let comp_var = nd[2]
        let comp_iter = nd[3]
        let comp_cond = nd[4]
        let comp_var_off = local_offset(comp_var)
        out("    call _nova_list_new")
        out("    push rax")
        gen_expr(comp_iter)
        out("    push rax")
        out("    push 0")
        let comp_loop = new_label()
        let comp_end = new_label()
        out_label(comp_loop)
        out("    mov rcx, [rsp]")
        out("    mov rdi, [rsp+8]")
        out("    cmp rcx, [rdi+8]")
        out("    jge " + comp_end)
        out("    mov rdi, [rdi+24]")
        out("    mov rax, [rdi+rcx*8]")
        out("    mov [rbp - " + int_to_str(comp_var_off) + "], rax")
        if comp_cond == 0 {
        } else {
            let comp_skip = new_label()
            gen_expr(comp_cond)
            out("    test rax, rax")
            out("    jz " + comp_skip)
            gen_expr(comp_expr)
            out("    mov rsi, rax")
            out("    mov rdi, [rsp+16]")
            out("    call _nova_push")
            out_label(comp_skip)
            out("    inc qword ptr [rsp]")
            out("    jmp " + comp_loop)
            out_label(comp_end)
            out("    add rsp, 16")
            out("    pop rax")
            return 0
        }
        gen_expr(comp_expr)
        out("    mov rsi, rax")
        out("    mov rdi, [rsp+16]")
        out("    call _nova_push")
        out("    inc qword ptr [rsp]")
        out("    jmp " + comp_loop)
        out_label(comp_end)
        out("    add rsp, 16")
        out("    pop rax")
        return 0
    }

    if tag == AST_MAP_LIT {
        let mkeys = nd[1]
        let mvals = nd[2]
        let mcount = len(mkeys)
        out("    call _nova_map_new")
        if mcount > 0 {
            out("    push rax")
            let mi = 0
            while mi < mcount {
                gen_expr(mkeys[mi])
                out("    push rax")
                gen_expr(mvals[mi])
                out("    mov rdx, rax")
                out("    pop rsi")
                out("    mov rdi, [rsp]")
                out("    call _nova_map_set")
                mi = mi + 1
            }
            out("    pop rax")
        }
        return 0
    }

    if tag == AST_MAP_COMP {
        let mc_key_expr = nd[1]
        let mc_val_expr = nd[2]
        let mc_var = nd[3]
        let mc_iter = nd[4]
        let mc_cond = nd[5]
        let mc_var_off = local_offset(mc_var)
        out("    call _nova_map_new")
        out("    push rax")
        gen_expr(mc_iter)
        out("    push rax")
        out("    push 0")
        let mc_loop = new_label()
        let mc_end = new_label()
        out_label(mc_loop)
        out("    mov rcx, [rsp]")
        out("    mov rdi, [rsp+8]")
        out("    cmp rcx, [rdi+8]")
        out("    jge " + mc_end)
        out("    mov rdi, [rdi+24]")
        out("    mov rax, [rdi+rcx*8]")
        out("    mov [rbp - " + int_to_str(mc_var_off) + "], rax")
        if mc_cond == 0 {
        } else {
            let mc_skip = new_label()
            gen_expr(mc_cond)
            out("    test rax, rax")
            out("    jz " + mc_skip)
            gen_expr(mc_key_expr)
            out("    push rax")
            gen_expr(mc_val_expr)
            out("    mov rdx, rax")
            out("    pop rsi")
            out("    mov rdi, [rsp+16]")
            out("    call _nova_map_set")
            out_label(mc_skip)
            out("    inc qword ptr [rsp]")
            out("    jmp " + mc_loop)
            out_label(mc_end)
            out("    add rsp, 16")
            out("    pop rax")
            return 0
        }
        gen_expr(mc_key_expr)
        out("    push rax")
        gen_expr(mc_val_expr)
        out("    mov rdx, rax")
        out("    pop rsi")
        out("    mov rdi, [rsp+16]")
        out("    call _nova_map_set")
        out("    inc qword ptr [rsp]")
        out("    jmp " + mc_loop)
        out_label(mc_end)
        out("    add rsp, 16")
        out("    pop rax")
        return 0
    }

    if tag == AST_NULL_ACCESS {
        let null_end = new_label()
        gen_expr(nd[1])
        out("    test rax, rax")
        out("    jz " + null_end)
        let nf_name = nd[2]
        let nf_idx = find_field_index(nf_name)
        out("    mov rcx, [rax + 24]")
        out("    mov rax, [rcx + " + int_to_str(nf_idx * 8) + "]")
        out_label(null_end)
        return 0
    }

    if tag == AST_SLICE {
        gen_expr(nd[3])
        out("    push rax")
        gen_expr(nd[2])
        out("    push rax")
        gen_expr(nd[1])
        out("    pop rsi")
        out("    pop rdx")
        out("    mov rdi, rax")
        out("    call list_slice")
        return 0
    }

    if tag == AST_DO_EXPR {
        let do_stmts = nd[1]
        let do_final = nd[2]
        let di = 0
        while di < len(do_stmts) {
            gen_stmt(do_stmts[di])
            di = di + 1
        }
        gen_expr(do_final)
        return 0
    }

    if tag == AST_MATCH_STMT {
        let mexpr = nd[1]
        let marms = nd[2]
        let mend = new_label()
        gen_expr(mexpr)
        out("    push rax")
        let mi = 0
        while mi < len(marms) {
            let marm = marms[mi]
            let mpat = marm[1]
            let mbody = marm[2]
            let mptag = ast_tag(mpat)
            let mhas_guard = 0
            if len(marm) > 3 { mhas_guard = 1 }
            if mptag == AST_WILDCARD {
                let mnxt_w = new_label()
                if mhas_guard == 1 {
                    gen_expr(marm[3])
                    out("    test rax, rax")
                    out("    jz " + mnxt_w)
                }
                out("    add rsp, 8")
                if ast_tag(mbody) == AST_EXPR_STMT {
                    gen_expr(mbody[1])
                } else { if ast_tag(mbody) == AST_BLOCK {
                    gen_block(mbody)
                } else {
                    gen_stmt(mbody)
                } }
                out("    jmp " + mend)
                if mhas_guard == 1 { out_label(mnxt_w) }
            } else { if mptag == AST_TYPE_PATTERN {
                let mnxt_t = new_label()
                let mtp_id = mpat[1]
                out("    mov rdi, [rsp]")
                out("    call _nova_type_of")
                out("    cmp rax, " + int_to_str(mtp_id))
                out("    jne " + mnxt_t)
                if mhas_guard == 1 {
                    gen_expr(marm[3])
                    out("    test rax, rax")
                    out("    jz " + mnxt_t)
                }
                out("    add rsp, 8")
                if ast_tag(mbody) == AST_EXPR_STMT {
                    gen_expr(mbody[1])
                } else { if ast_tag(mbody) == AST_BLOCK {
                    gen_block(mbody)
                } else {
                    gen_stmt(mbody)
                } }
                out("    jmp " + mend)
                out_label(mnxt_t)
            } else {
                let mnxt = new_label()
                gen_expr(mpat)
                out("    mov rcx, rax")
                out("    mov rax, [rsp]")
                out("    mov rdi, rax")
                out("    mov rsi, rcx")
                out("    call _nova_eq")
                out("    test rax, rax")
                out("    jz " + mnxt)
                if mhas_guard == 1 {
                    gen_expr(marm[3])
                    out("    test rax, rax")
                    out("    jz " + mnxt)
                }
                out("    add rsp, 8")
                if ast_tag(mbody) == AST_EXPR_STMT {
                    gen_expr(mbody[1])
                } else { if ast_tag(mbody) == AST_BLOCK {
                    gen_block(mbody)
                } else {
                    gen_stmt(mbody)
                } }
                out("    jmp " + mend)
                out_label(mnxt)
            } }
            mi = mi + 1
        }
        out("    add rsp, 8")
        out("    xor eax, eax")
        out_label(mend)
        return 0
    }

    if tag == AST_IF_STMT {
        let icond = nd[1]
        let ithen = nd[2]
        let ielse = nd[3]
        let ielse_lbl = new_label()
        let iend_lbl = new_label()
        gen_expr(icond)
        out("    test rax, rax")
        out("    jz " + ielse_lbl)
        if ast_tag(ithen) == AST_BLOCK {
            gen_block(ithen)
        } else {
            gen_stmt(ithen)
        }
        out("    jmp " + iend_lbl)
        out_label(ielse_lbl)
        if ielse == 0 {
            out("    xor eax, eax")
        } else {
            if ast_tag(ielse) == AST_BLOCK {
                gen_block(ielse)
            } else {
                gen_stmt(ielse)
            }
        }
        out_label(iend_lbl)
        return 0
    }

    if tag == AST_TRY_CATCH {
        let try_body = nd[1]
        let catch_body = nd[2]
        let catch_err_var = nd[3]
        let tcatch_lbl = new_label()
        let tend_lbl = new_label()
        let old_catch = cg_catch_label
        cg_catch_label = tcatch_lbl

        out("    mov rdi, 32")
        out("    call _nova_alloc")
        out("    mov rcx, [rip + _nova_catch_stack]")
        out("    mov [rax], rcx")
        out("    mov [rax + 8], rbp")
        out("    mov [rax + 16], rsp")
        out("    lea rcx, [rip + " + tcatch_lbl + "]")
        out("    mov [rax + 24], rcx")
        out("    mov [rip + _nova_catch_stack], rax")
        out("    mov qword ptr [rip + _nova_error_flag], 0")

        gen_block(try_body)

        out("    mov rcx, [rip + _nova_catch_stack]")
        out("    mov rcx, [rcx]")
        out("    mov [rip + _nova_catch_stack], rcx")
        out("    jmp " + tend_lbl)

        out_label(tcatch_lbl)
        if catch_err_var == "" {
        } else {
            out("    mov rax, [rip + _nova_error_value]")
            if is_global(catch_err_var) == 1 {
                out("    mov [rip + _g_" + catch_err_var + "], rax")
            } else {
                let eoff = local_offset(catch_err_var)
                out("    mov [rbp - " + int_to_str(eoff) + "], rax")
            }
        }
        gen_block(catch_body)
        out("    mov qword ptr [rip + _nova_error_flag], 0")
        out_label(tend_lbl)
        cg_catch_label = old_catch
        return 0
    }

    out("    # unknown expr tag " + int_to_str(tag))
}

fn gen_stmt(nd) {
    cg_emit_loc(nd)
    let tag = ast_tag(nd)

    if tag == AST_LET_STMT {
        let name = nd[1]
        let value = nd[2]
        gen_expr(value)
        if is_global(name) == 1 {
            out("    mov [rip + _g_" + name + "], rax")
        } else {
            let off = local_offset(name)
            out("    mov [rbp - " + int_to_str(off) + "], rax")
        }
        return 0
    }

    if tag == AST_ASSIGN_STMT {
        let name = nd[1]
        let value = nd[2]
        gen_expr(value)
        if has_local(name) == 1 {
            let off = local_offset(name)
            out("    mov [rbp - " + int_to_str(off) + "], rax")
        } else {
            if is_capture_var(name) == 1 {
                out("    mov [rip + _cap_" + cg_current_cap_name + "_" + name + "], rax")
            } else {
                if is_global(name) == 1 {
                    out("    mov [rip + _g_" + name + "], rax")
                } else {
                    let off = local_offset(name)
                    out("    mov [rbp - " + int_to_str(off) + "], rax")
                }
            }
        }
        return 0
    }

    if tag == AST_RETURN_STMT {
        let value = nd[1]
        if value == 0 {
            gen_defers()
            out("    xor eax, eax")
            out("    mov rsp, rbp")
            out("    pop rbp")
            out("    ret")
            return 0
        }
        if cg_defer_count == 0 {
            if len(cg_current_fn) > 0 {
                if ast_tag(value) == AST_CALL {
                    let tc_callee = value[1]
                    if ast_tag(tc_callee) == AST_IDENT {
                        if tc_callee[1] == cg_current_fn {
                            let tc_args = value[2]
                            let tc_argc = len(tc_args)
                            if tc_argc <= 6 {
                                gen_tco_call(tc_args, tc_argc)
                                return 0
                            }
                        }
                    }
                }
            }
        }
        gen_expr(value)
        if cg_defer_count > 0 {
            out("    push rax")
            gen_defers()
            out("    pop rax")
        }
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
        return 0
    }

    if tag == AST_IF_STMT {
        let cond = nd[1]
        let then_body = nd[2]
        let else_body = nd[3]

        // --- Optimization: Dead Code Elimination for constant conditions ---
        let cond_val = try_fold(cond)
        if is_foldable(cond_val) == 1 {
            if cond_val == 0 {
                // Condition is always false: only emit else branch (if any)
                if else_body == 0 {
                    // No else branch, entire if is dead code
                } else {
                    if ast_tag(else_body) == AST_IF_STMT {
                        gen_stmt(else_body)
                    } else {
                        gen_block(else_body)
                    }
                }
                return 0
            } else {
                // Condition is always true: only emit then branch
                gen_block(then_body)
                return 0
            }
        }

        // Non-constant condition: generate normal if/else
        let else_lbl = new_label()
        let end_lbl = new_label()
        gen_expr(cond)
        out("    test rax, rax")
        out("    jz " + else_lbl)
        gen_block(then_body)
        out("    jmp " + end_lbl)
        out_label(else_lbl)
        if else_body == 0 {
        } else {
            if ast_tag(else_body) == AST_IF_STMT {
                gen_stmt(else_body)
            } else {
                gen_block(else_body)
            }
        }
        out_label(end_lbl)
        return 0
    }

    if tag == AST_WHILE_STMT {
        let cond = nd[1]
        let body = nd[2]
        let wlabel = ""
        let while_else = 0
        if len(nd) > 3 { wlabel = nd[3] }
        if len(nd) > 4 { while_else = nd[4] }

        let cond_val = try_fold(cond)
        if is_foldable(cond_val) == 1 {
            if cond_val == 0 {
                if while_else != 0 {
                    gen_block(while_else)
                }
                return 0
            }
        }

        let loop_lbl = new_label()
        let end_lbl = new_label()
        let nobreak_lbl = end_lbl
        if while_else != 0 {
            nobreak_lbl = new_label()
        }
        let prev_break = cg_break_label
        let prev_continue = cg_continue_label
        cg_break_label = end_lbl
        cg_continue_label = loop_lbl
        if wlabel == "" {
        } else {
            push(cg_lbl_names, wlabel)
            push(cg_lbl_breaks, end_lbl)
            push(cg_lbl_continues, loop_lbl)
            cg_lbl_count = cg_lbl_count + 1
        }
        out_label(loop_lbl)
        gen_expr(cond)
        out("    test rax, rax")
        out("    jz " + nobreak_lbl)
        gen_block(body)
        out("    jmp " + loop_lbl)
        if while_else != 0 {
            out_label(nobreak_lbl)
            gen_block(while_else)
        }
        out_label(end_lbl)
        cg_break_label = prev_break
        cg_continue_label = prev_continue
        if wlabel == "" {
        } else {
            cg_lbl_count = cg_lbl_count - 1
        }
        return 0
    }

    if tag == AST_FOR_STMT {
        let var_name = nd[1]
        let iter_expr = nd[2]
        let body = nd[3]
        let flabel = ""
        let for_else = 0
        if len(nd) > 4 { flabel = nd[4] }
        if len(nd) > 5 { for_else = nd[5] }
        let var_off = local_offset(var_name)

        let is_range = 0
        if ast_tag(iter_expr) == AST_CALL {
            let callee = iter_expr[1]
            if ast_tag(callee) == AST_IDENT {
                if callee[1] == "range" {
                    is_range = 1
                }
            }
        }

        if is_range == 1 {
            let args = iter_expr[2]
            let argc = len(args)
            let has_step = 0
            if argc == 1 {
                out("    mov qword ptr [rbp - " + int_to_str(var_off) + "], 0")
                gen_expr(args[0])
                out("    push rax")
            } else {
                gen_expr(args[0])
                out("    mov [rbp - " + int_to_str(var_off) + "], rax")
                gen_expr(args[1])
                out("    push rax")
            }
            if argc >= 3 {
                gen_expr(args[2])
                out("    push rax")
                has_step = 1
            }
            let loop_lbl = new_label()
            let end_lbl = new_label()
            let cont_lbl = new_label()
            let break_lbl = end_lbl
            if for_else != 0 { break_lbl = new_label() }
            let prev_break = cg_break_label
            let prev_continue = cg_continue_label
            cg_break_label = break_lbl
            cg_continue_label = cont_lbl
            if flabel == "" {
            } else {
                push(cg_lbl_names, flabel)
                push(cg_lbl_breaks, break_lbl)
                push(cg_lbl_continues, cont_lbl)
                cg_lbl_count = cg_lbl_count + 1
            }
            out_label(loop_lbl)
            out("    mov rax, [rbp - " + int_to_str(var_off) + "]")
            if has_step == 1 {
                out("    mov rcx, [rsp]")
                out("    test rcx, rcx")
                let neg_lbl = new_label()
                let check_done = new_label()
                out("    js " + neg_lbl)
                out("    cmp rax, [rsp+8]")
                out("    jge " + end_lbl)
                out("    jmp " + check_done)
                out_label(neg_lbl)
                out("    cmp rax, [rsp+8]")
                out("    jle " + end_lbl)
                out_label(check_done)
            } else {
                out("    cmp rax, [rsp]")
                out("    jge " + end_lbl)
            }
            gen_block(body)
            out_label(cont_lbl)
            if has_step == 1 {
                out("    mov rax, [rsp]")
                out("    add [rbp - " + int_to_str(var_off) + "], rax")
            } else {
                out("    inc qword ptr [rbp - " + int_to_str(var_off) + "]")
            }
            out("    jmp " + loop_lbl)
            if for_else != 0 {
                out_label(break_lbl)
                if has_step == 1 {
                    out("    add rsp, 16")
                } else {
                    out("    add rsp, 8")
                }
                let skip_lbl = new_label()
                out("    jmp " + skip_lbl)
                out_label(end_lbl)
                if has_step == 1 {
                    out("    add rsp, 16")
                } else {
                    out("    add rsp, 8")
                }
                gen_block(for_else)
                out_label(skip_lbl)
            } else {
                out_label(end_lbl)
                if has_step == 1 {
                    out("    add rsp, 16")
                } else {
                    out("    add rsp, 8")
                }
            }
            cg_break_label = prev_break
            cg_continue_label = prev_continue
            if flabel == "" {
            } else {
                cg_lbl_count = cg_lbl_count - 1
            }
            return 0
        } else {
            gen_expr(iter_expr)
            out("    push rax")
            out("    push 0")
            let loop_lbl = new_label()
            let end_lbl = new_label()
            let cont_lbl = new_label()
            let break_lbl = end_lbl
            if for_else != 0 { break_lbl = new_label() }
            let prev_break = cg_break_label
            let prev_continue = cg_continue_label
            cg_break_label = break_lbl
            cg_continue_label = cont_lbl
            if flabel == "" {
            } else {
                push(cg_lbl_names, flabel)
                push(cg_lbl_breaks, break_lbl)
                push(cg_lbl_continues, cont_lbl)
                cg_lbl_count = cg_lbl_count + 1
            }
            // Convert strings to char code lists for iteration
            out("    mov rdi, [rsp+8]")
            out("    cmp qword ptr [rdi], -1")
            out("    je " + loop_lbl)
            out("    mov rdi, [rsp+8]")
            out("    call _nova_str_to_chars")
            out("    mov [rsp+8], rax")
            // List iteration
            out_label(loop_lbl)
            out("    mov rcx, [rsp]")
            out("    mov rdi, [rsp+8]")
            out("    cmp rcx, [rdi+8]")
            out("    jge " + end_lbl)
            out("    mov rdi, [rdi+24]")
            out("    mov rax, [rdi+rcx*8]")
            out("    mov [rbp - " + int_to_str(var_off) + "], rax")
            gen_block(body)
            out_label(cont_lbl)
            out("    inc qword ptr [rsp]")
            out("    jmp " + loop_lbl)
            if for_else != 0 {
                out_label(break_lbl)
                out("    add rsp, 16")
                let skip_lbl = new_label()
                out("    jmp " + skip_lbl)
                out_label(end_lbl)
                out("    add rsp, 16")
                gen_block(for_else)
                out_label(skip_lbl)
            } else {
                out_label(end_lbl)
                out("    add rsp, 16")
            }
            cg_break_label = prev_break
            cg_continue_label = prev_continue
            if flabel == "" {
            } else {
                cg_lbl_count = cg_lbl_count - 1
            }
            return 0
        }
    }

    if tag == AST_DO_WHILE {
        let body = nd[1]
        let cond = nd[2]
        let loop_lbl = new_label()
        let end_lbl = new_label()
        let cont_lbl = new_label()
        let prev_break = cg_break_label
        let prev_continue = cg_continue_label
        cg_break_label = end_lbl
        cg_continue_label = cont_lbl
        out_label(loop_lbl)
        gen_block(body)
        out_label(cont_lbl)
        gen_expr(cond)
        out("    test rax, rax")
        out("    jnz " + loop_lbl)
        out_label(end_lbl)
        cg_break_label = prev_break
        cg_continue_label = prev_continue
        return 0
    }

    if tag == AST_EXPR_STMT {
        gen_expr(nd[1])
        return 0
    }

    if tag == AST_DEFER_STMT {
        push(cg_defers, nd[1])
        cg_defer_count = cg_defer_count + 1
        return 0
    }

    if tag == AST_BREAK_STMT {
        if len(nd) > 1 {
            let blbl = nd[1]
            let bi = 0
            while bi < cg_lbl_count {
                if cg_lbl_names[bi] == blbl {
                    out("    jmp " + cg_lbl_breaks[bi])
                    return 0
                }
                bi = bi + 1
            }
        }
        out("    jmp " + cg_break_label)
        return 0
    }

    if tag == AST_CONTINUE_STMT {
        if len(nd) > 1 {
            let clbl = nd[1]
            let ci = 0
            while ci < cg_lbl_count {
                if cg_lbl_names[ci] == clbl {
                    out("    jmp " + cg_lbl_continues[ci])
                    return 0
                }
                ci = ci + 1
            }
        }
        out("    jmp " + cg_continue_label)
        return 0
    }

    if tag == AST_INDEX_ASSIGN {
        let base = nd[1]
        let idx = nd[2]
        let value = nd[3]
        gen_expr(value)
        out("    push rax")
        gen_expr(idx)
        out("    push rax")
        gen_expr(base)
        out("    mov rcx, [rax + 24]")
        out("    pop rsi")
        out("    pop rdx")
        out("    mov [rcx + rsi*8], rdx")
        return 0
    }

    if tag == AST_FIELD_ASSIGN {
        let base = nd[1]
        let field_name = nd[2]
        let value = nd[3]
        let idx = find_field_index(field_name)
        gen_expr(value)
        out("    push rax")
        gen_expr(base)
        out("    mov rcx, [rax + 24]")
        out("    pop rdx")
        out("    mov [rcx + " + int_to_str(idx * 8) + "], rdx")
        return 0
    }

    if tag == AST_STRUCT_DECL {
        return 0
    }

    if tag == AST_ENUM_DECL {
        return 0
    }

    if tag == AST_BLOCK {
        gen_block(nd)
        return 0
    }

    if tag == AST_MATCH_STMT {
        let expr = nd[1]
        let arms = nd[2]
        let end_lbl = new_label()

        // Evaluate the match expression once, save on stack
        gen_expr(expr)
        out("    push rax")

        let i = 0
        while i < len(arms) {
            let arm = arms[i]
            let pattern = arm[1]
            let body = arm[2]
            let pat_tag = ast_tag(pattern)

            let has_guard = 0
            if len(arm) > 3 { has_guard = 1 }
            if pat_tag == AST_WILDCARD {
                let next_arm_w = new_label()
                if has_guard == 1 {
                    gen_expr(arm[3])
                    out("    test rax, rax")
                    out("    jz " + next_arm_w)
                }
                out("    add rsp, 8")
                if ast_tag(body) == AST_BLOCK {
                    gen_block(body)
                } else {
                    gen_stmt(body)
                }
                out("    jmp " + end_lbl)
                if has_guard == 1 {
                    out_label(next_arm_w)
                }
            } else { if pat_tag == AST_TYPE_PATTERN {
                let next_arm_t = new_label()
                let tp_id = pattern[1]
                out("    mov rdi, [rsp]")
                out("    call _nova_type_of")
                out("    cmp rax, " + int_to_str(tp_id))
                out("    jne " + next_arm_t)
                if has_guard == 1 {
                    gen_expr(arm[3])
                    out("    test rax, rax")
                    out("    jz " + next_arm_t)
                }
                out("    add rsp, 8")
                if ast_tag(body) == AST_BLOCK {
                    gen_block(body)
                } else {
                    gen_stmt(body)
                }
                out("    jmp " + end_lbl)
                out_label(next_arm_t)
            } else {
                // Compare match value with pattern
                let next_arm = new_label()
                gen_expr(pattern)
                out("    mov rcx, rax")
                out("    mov rax, [rsp]")
                out("    mov rdi, rax")
                out("    mov rsi, rcx")
                out("    call _nova_eq")
                out("    test rax, rax")
                out("    jz " + next_arm)
                if has_guard == 1 {
                    gen_expr(arm[3])
                    out("    test rax, rax")
                    out("    jz " + next_arm)
                }
                // Match! Execute body
                out("    add rsp, 8")
                if ast_tag(body) == AST_BLOCK {
                    gen_block(body)
                } else {
                    gen_stmt(body)
                }
                out("    jmp " + end_lbl)
                out_label(next_arm)
            } }
            i = i + 1
        }

        // If no arm matched, clean up stack
        out("    add rsp, 8")
        out_label(end_lbl)
        return 0
    }

    if tag == AST_TRY_CATCH {
        let try_body = nd[1]
        let catch_body = nd[2]
        let catch_err_var = nd[3]
        let catch_lbl = new_label()
        let end_lbl = new_label()

        let old_catch = cg_catch_label
        cg_catch_label = catch_lbl

        out("    mov rdi, 32")
        out("    call _nova_alloc")
        out("    mov rcx, [rip + _nova_catch_stack]")
        out("    mov [rax], rcx")
        out("    mov [rax + 8], rbp")
        out("    mov [rax + 16], rsp")
        out("    lea rcx, [rip + " + catch_lbl + "]")
        out("    mov [rax + 24], rcx")
        out("    mov [rip + _nova_catch_stack], rax")
        out("    mov qword ptr [rip + _nova_error_flag], 0")

        gen_block(try_body)

        out("    mov rcx, [rip + _nova_catch_stack]")
        out("    mov rcx, [rcx]")
        out("    mov [rip + _nova_catch_stack], rcx")
        out("    jmp " + end_lbl)

        out_label(catch_lbl)
        if catch_err_var == "" {
        } else {
            out("    mov rax, [rip + _nova_error_value]")
            if is_global(catch_err_var) == 1 {
                out("    mov [rip + _g_" + catch_err_var + "], rax")
            } else {
                let eoff = local_offset(catch_err_var)
                out("    mov [rbp - " + int_to_str(eoff) + "], rax")
            }
        }
        gen_block(catch_body)
        out("    mov qword ptr [rip + _nova_error_flag], 0")

        out_label(end_lbl)
        if len(nd) > 5 {
            gen_block(nd[4])
        }

        cg_catch_label = old_catch
        return 0
    }

    if tag == AST_THROW {
        let value = nd[1]
        gen_expr(value)
        out("    mov rdi, rax")
        out("    call _nova_throw_impl")
        return 0
    }

    if tag == AST_DESTRUCTURE {
        let dnames = nd[1]
        let dvalue = nd[2]
        gen_expr(dvalue)
        out("    push rax")
        let di = 0
        while di < len(dnames) {
            let dname = dnames[di]
            out("    mov rax, [rsp]")
            out("    mov rdi, rax")
            out("    mov rsi, " + int_to_str(di))
            out("    call _nova_index")
            if is_global(dname) == 1 {
                out("    mov [rip + _g_" + dname + "], rax")
            } else {
                let doff = local_offset(dname)
                out("    mov [rbp - " + int_to_str(doff) + "], rax")
            }
            di = di + 1
        }
        if len(nd) > 3 {
            let drname = nd[3]
            out("    mov rdi, [rsp]")
            out("    call _nova_len")
            out("    mov rdx, rax")
            out("    mov rdi, [rsp]")
            out("    mov rsi, " + int_to_str(len(dnames)))
            out("    call _nova_list_slice")
            if is_global(drname) == 1 {
                out("    mov [rip + _g_" + drname + "], rax")
            } else {
                let droff = local_offset(drname)
                out("    mov [rbp - " + int_to_str(droff) + "], rax")
            }
        }
        out("    add rsp, 8")
        return 0
    }

    if tag == AST_ASM {
        let asm_lines = nd[1]
        let ai = 0
        while ai < len(asm_lines) {
            out("    " + asm_lines[ai])
            ai = ai + 1
        }
        return 0
    }

    if tag == AST_FOR_INDEXED {
        let idx_name = nd[1]
        let val_name = nd[2]
        let iter_expr = nd[3]
        let body = nd[4]
        let filabel = ""
        if len(nd) > 6 { filabel = nd[5] }
        let idx_off = local_offset(idx_name)
        let val_off = local_offset(val_name)
        gen_expr(iter_expr)
        let fi_notmap = new_label()
        let fi_ready = new_label()
        out("    cmp qword ptr [rax], -2")
        out("    jne " + fi_notmap)
        out("    mov rdi, rax")
        out("    call _nova_map_entries")
        out("    push rax")
        out("    push 1")
        out("    jmp " + fi_ready)
        out_label(fi_notmap)
        out("    push rax")
        out("    push 0")
        out_label(fi_ready)
        out("    push 0")
        let fi_loop = new_label()
        let fi_end = new_label()
        let fi_cont = new_label()
        let prev_break = cg_break_label
        let prev_continue = cg_continue_label
        cg_break_label = fi_end
        cg_continue_label = fi_cont
        if filabel == "" {
        } else {
            push(cg_lbl_names, filabel)
            push(cg_lbl_breaks, fi_end)
            push(cg_lbl_continues, fi_cont)
            cg_lbl_count = cg_lbl_count + 1
        }
        let fi_map_path = new_label()
        let fi_body = new_label()
        out_label(fi_loop)
        out("    mov rcx, [rsp]")
        out("    mov rdi, [rsp+16]")
        out("    cmp qword ptr [rsp+8], 1")
        out("    je " + fi_map_path)
        out("    cmp rcx, [rdi+8]")
        out("    jge " + fi_end)
        out("    mov [rbp - " + int_to_str(idx_off) + "], rcx")
        out("    mov rdi, [rdi+24]")
        out("    mov rax, [rdi+rcx*8]")
        out("    mov [rbp - " + int_to_str(val_off) + "], rax")
        out("    jmp " + fi_body)
        out_label(fi_map_path)
        out("    mov rax, [rdi+8]")
        out("    shr rax, 1")
        out("    cmp rcx, rax")
        out("    jge " + fi_end)
        out("    mov rdi, [rdi+24]")
        out("    mov rax, rcx")
        out("    shl rax, 1")
        out("    mov rdx, [rdi+rax*8]")
        out("    mov [rbp - " + int_to_str(idx_off) + "], rdx")
        out("    inc rax")
        out("    mov rdx, [rdi+rax*8]")
        out("    mov [rbp - " + int_to_str(val_off) + "], rdx")
        out_label(fi_body)
        gen_block(body)
        out_label(fi_cont)
        out("    inc qword ptr [rsp]")
        out("    jmp " + fi_loop)
        out_label(fi_end)
        out("    add rsp, 24")
        cg_break_label = prev_break
        cg_continue_label = prev_continue
        if filabel == "" {
        } else {
            cg_lbl_count = cg_lbl_count - 1
        }
        return 0
    }

    out("    # unknown stmt tag " + int_to_str(tag))
}

fn escape_for_asm(s) {
    let bs = chr(92)
    let result = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        let esc_done = 0
        if c == 10 { result = result + bs + "n"; esc_done = 1 }
        if c == 9 { if esc_done == 0 { result = result + bs + "t"; esc_done = 1 } }
        if c == 13 { if esc_done == 0 { result = result + bs + "r"; esc_done = 1 } }
        if c == 92 { if esc_done == 0 { result = result + bs + bs; esc_done = 1 } }
        if c == 34 { if esc_done == 0 { result = result + bs + chr(34); esc_done = 1 } }
        if c == 0 { if esc_done == 0 { result = result + bs + "0"; esc_done = 1 } }
        if esc_done == 0 { result = result + chr(c) }
        i = i + 1
    }
    return result
}

fn gen_block(nd) {
    let stmts = nd[1]
    let i = 0
    while i < len(stmts) {
        let s = stmts[i]
        gen_stmt(s)
        if ast_tag(s) == AST_RETURN_STMT {
            return 0
        }
        if ast_tag(s) == AST_THROW {
            return 0
        }
        i = i + 1
    }
}

fn gen_tco_call(tc_args, tc_argc) {
    let ti = 0
    while ti < tc_argc {
        gen_expr(tc_args[ti])
        out("    push rax")
        ti = ti + 1
    }
    ti = tc_argc - 1
    while ti >= 0 {
        out("    pop rax")
        let toff = (ti + 1) * 8
        out("    mov [rbp - " + int_to_str(toff) + "], rax")
        ti = ti - 1
    }
    out("    jmp " + cg_tco_label)
}

fn gen_defers() {
    let di = cg_defer_count - 1
    while di >= 0 {
        gen_block(cg_defers[di])
        di = di - 1
    }
}

fn gen_function(nd) {
    let name = nd[1]
    let params = nd[2]
    let body = nd[3]

    let fn_caps = get_lambda_caps(name)
    if len(fn_caps) > 0 {
        cg_current_caps = fn_caps
        cg_current_cap_name = name
    } else {
        cg_current_caps = 0
        cg_current_cap_name = ""
    }

    cg_locals = list_new()
    cg_local_count = 0
    cg_params = params
    cg_param_count = len(params)
    cg_defers = list_new()
    cg_defer_count = 0

    let pi = 0
    while pi < cg_param_count {
        push(cg_locals, params[pi])
        cg_local_count = cg_local_count + 1
        pi = pi + 1
    }

    collect_locals(body)

    out("")
    out_globl(name)
    cg_emit_loc(nd)
    out_label(name)
    out("    push rbp")
    out("    mov rbp, rsp")
    let frame_size = cg_local_count * 8
    let frame_rem = frame_size % 16
    if frame_rem == 0 {
    } else {
        frame_size = frame_size + (16 - frame_rem)
    }
    if frame_size > 0 {
        out("    sub rsp, " + int_to_str(frame_size))
    }

    if cg_param_count > 0 { out("    mov [rbp - 8], rdi") }
    if cg_param_count > 1 { out("    mov [rbp - 16], rsi") }
    if cg_param_count > 2 { out("    mov [rbp - 24], rdx") }
    if cg_param_count > 3 { out("    mov [rbp - 32], rcx") }
    if cg_param_count > 4 { out("    mov [rbp - 40], r8") }
    if cg_param_count > 5 { out("    mov [rbp - 48], r9") }

    let tco_lbl = new_label()
    cg_current_fn = name
    cg_tco_label = tco_lbl
    out_label(tco_lbl)

    gen_block(body)

    cg_current_fn = ""
    cg_tco_label = ""
    gen_defers()
    let stmts = body[1]
    let has_implicit = 0
    if len(stmts) > 0 {
        let last = stmts[len(stmts) - 1]
        let lt = ast_tag(last)
        if lt == AST_EXPR_STMT { has_implicit = 1 }
        if lt == AST_RETURN_STMT { has_implicit = 1 }
        if lt == AST_ASM { has_implicit = 1 }
    }
    if has_implicit == 0 {
        out("    xor eax, eax")
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")
}

fn gen_program(program) {
    if cg_target == 2 {
        return wasm_gen_program(program)
    }
    let decls = program[1]

    // Expand mind declarations into regular statements
    let expanded = list_new()
    let ei = 0
    while ei < len(decls) {
        let ed = decls[ei]
        if ast_tag(ed) == AST_MIND {
            let mname = ed[1]
            let mnodes = ed[2]
            let mchannels = ed[3]
            let mscaling = ed[4]
            let mpersist = ed[5]
            // scheduler_ensure_init()
            let si_args = list_new()
            push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_ensure_init"), si_args)))
            // For each node: check if it has a scaling entry
            let ni = 0
            while ni < len(mnodes) {
                let nd_entry = mnodes[ni]
                let nd_name = nd_entry[0]
                let nd_type = nd_entry[1]
                let var_name = mname + "_" + nd_name
                let scale_entry = 0
                let sci = 0
                while sci < len(mscaling) {
                    if mscaling[sci][0] == nd_name {
                        scale_entry = mscaling[sci]
                    }
                    sci = sci + 1
                }
                if scale_entry == 0 {
                    let nn_args = list_new()
                    push(nn_args, ast_str(nd_name))
                    push(nn_args, ast_int(nd_type))
                    push(expanded, ast_let(var_name, ast_call(ast_ident("node_new"), nn_args)))
                    let sr_args = list_new()
                    push(sr_args, ast_ident(var_name))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_register"), sr_args)))
                } else {
                    let pool_var = mname + "_pool_" + nd_name
                    let np_args = list_new()
                    push(np_args, ast_str(nd_name))
                    push(np_args, ast_int(nd_type))
                    push(np_args, ast_int(scale_entry[2]))
                    push(np_args, ast_int(scale_entry[1]))
                    push(expanded, ast_let(pool_var, ast_call(ast_ident("node_pool_new"), np_args)))
                    let rp_args = list_new()
                    push(rp_args, ast_ident(pool_var))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_register_pool"), rp_args)))
                    let pf_args = list_new()
                    push(pf_args, ast_ident(pool_var))
                    push(expanded, ast_let(var_name, ast_call(ast_ident("node_pool_first"), pf_args)))
                }
                ni = ni + 1
            }
            // Create aggregate nodes list: MindName_nodes
            let nlist_var = mname + "_nodes"
            push(expanded, ast_let(nlist_var, ast_call(ast_ident("list_new"), list_new())))
            let nli = 0
            while nli < len(mnodes) {
                let nle = mnodes[nli]
                let nle_name = nle[0]
                let nle_var = mname + "_" + nle_name
                let ne_var = nlist_var + "_e" + int_to_str(nli)
                push(expanded, ast_let(ne_var, ast_call(ast_ident("list_new"), list_new())))
                let p1_args = list_new()
                push(p1_args, ast_ident(ne_var))
                push(p1_args, ast_str(nle_name))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("push"), p1_args)))
                let p2_args = list_new()
                push(p2_args, ast_ident(ne_var))
                push(p2_args, ast_ident(nle_var))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("push"), p2_args)))
                let p3_args = list_new()
                push(p3_args, ast_ident(nlist_var))
                push(p3_args, ast_ident(ne_var))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("push"), p3_args)))
                nli = nli + 1
            }
            // For each channel
            let ci = 0
            while ci < len(mchannels) {
                let ch = mchannels[ci]
                let ch_name = ch[0]
                let ch_source = ch[1]
                let ch_dests = ch[2]
                let ch_flow = ch[3]
                let ch_var = mname + "_ch_" + ch_name
                if ch_flow == 1 {
                    if len(ch_dests) == 1 {
                        let cd_args = list_new()
                        push(cd_args, ast_str(ch_name))
                        push(cd_args, ast_str(ch_source))
                        push(cd_args, ast_ident(mname + "_" + ch_dests[0]))
                        push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_direct"), cd_args)))
                    } else {
                        let cb_args = list_new()
                        push(cb_args, ast_str(ch_name))
                        push(cb_args, ast_str(ch_source))
                        push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_broadcast"), cb_args)))
                        let di = 0
                        while di < len(ch_dests) {
                            let ad_args = list_new()
                            push(ad_args, ast_ident(ch_var))
                            push(ad_args, ast_ident(mname + "_" + ch_dests[di]))
                            push(expanded, ast_expr_stmt(ast_call(ast_ident("channel_add_dest"), ad_args)))
                            di = di + 1
                        }
                    }
                }
                if ch_flow == 2 {
                    let cb2_args = list_new()
                    push(cb2_args, ast_str(ch_name))
                    push(cb2_args, ast_str(ch_source))
                    push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_broadcast"), cb2_args)))
                    let di = 0
                    while di < len(ch_dests) {
                        let ad_args = list_new()
                        push(ad_args, ast_ident(ch_var))
                        push(ad_args, ast_ident(mname + "_" + ch_dests[di]))
                        push(expanded, ast_expr_stmt(ast_call(ast_ident("channel_add_dest"), ad_args)))
                        di = di + 1
                    }
                }
                if ch_flow == 3 {
                    let cw_args = list_new()
                    push(cw_args, ast_str(ch_name))
                    push(cw_args, ast_str(ch_source))
                    push(cw_args, ast_int(50))
                    push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_weighted"), cw_args)))
                    let di = 0
                    while di < len(ch_dests) {
                        let ad_args = list_new()
                        push(ad_args, ast_ident(ch_var))
                        push(ad_args, ast_ident(mname + "_" + ch_dests[di]))
                        push(expanded, ast_expr_stmt(ast_call(ast_ident("channel_add_dest"), ad_args)))
                        di = di + 1
                    }
                }
                if ch_flow == 4 {
                    let cf_args = list_new()
                    push(cf_args, ast_str(ch_name))
                    push(cf_args, ast_str(ch_source))
                    push(cf_args, ast_int(50))
                    push(expanded, ast_let(ch_var, ast_call(ast_ident("channel_filtered"), cf_args)))
                    let di = 0
                    while di < len(ch_dests) {
                        let ad_args = list_new()
                        push(ad_args, ast_ident(ch_var))
                        push(ad_args, ast_ident(mname + "_" + ch_dests[di]))
                        push(expanded, ast_expr_stmt(ast_call(ast_ident("channel_add_dest"), ad_args)))
                        di = di + 1
                    }
                }
                let sac_args = list_new()
                push(sac_args, ast_ident(ch_var))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_add_channel"), sac_args)))
                ci = ci + 1
            }
            // Create aggregate channels list: MindName_channels
            let clist_var = mname + "_channels"
            push(expanded, ast_let(clist_var, ast_call(ast_ident("list_new"), list_new())))
            // Persist section: open DB for each persist entry
            let pi = 0
            while pi < len(mpersist) {
                let pe = mpersist[pi]
                let pe_node = pe[0]
                let pe_path = pe[1]
                let pe_interval = pe[2]
                let db_var = mname + "_db_" + pe_node
                let dbo_args = list_new()
                push(dbo_args, ast_str(pe_path))
                push(expanded, ast_let(db_var, ast_call(ast_ident("db_open"), dbo_args)))
                let das_args = list_new()
                push(das_args, ast_ident(db_var))
                push(das_args, ast_int(pe_interval))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("db_set_autosave"), das_args)))
                pi = pi + 1
            }
            // Security section
            let msecurity = ed[6]
            let si2 = 0
            while si2 < len(msecurity) {
                let se = msecurity[si2]
                let se_node = se[0]
                let se_type = se[1]
                if se_type == "rate_limit" {
                    let srl_args = list_new()
                    push(srl_args, ast_str(se_node))
                    push(srl_args, ast_int(se[2]))
                    push(srl_args, ast_int(se[3]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_set_rate_limit"), srl_args)))
                }
                if se_type == "block" {
                    let sbr_args = list_new()
                    push(sbr_args, ast_str(se_node))
                    push(sbr_args, ast_str(se[2]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_block_route"), sbr_args)))
                }
                si2 = si2 + 1
            }
        } else {
          if ast_tag(ed) == AST_SOUL {
            let sname = ed[1]
            let s_identity = ed[2]
            let s_values = ed[3]
            let s_drives = ed[4]
            let s_feelings = ed[5]
            let s_phases = ed[6]
            let s_reactions = ed[7]
            let soul_var = sname + "_soul"

            let sei_args = list_new()
            push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_ensure_init"), sei_args)))

            let sn_args = list_new()
            push(sn_args, ast_str(sname))
            push(expanded, ast_let(soul_var, ast_call(ast_ident("soul_new"), sn_args)))

            let si = 0
            while si < len(s_identity) {
                let id_entry = s_identity[si]
                let sid_args = list_new()
                push(sid_args, ast_ident(soul_var))
                push(sid_args, ast_str(id_entry[0]))
                push(sid_args, ast_str(id_entry[1]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_identity"), sid_args)))
                si = si + 1
            }

            let vi = 0
            while vi < len(s_values) {
                let v_entry = s_values[vi]
                let sv_args = list_new()
                push(sv_args, ast_ident(soul_var))
                push(sv_args, ast_str(v_entry[0]))
                push(sv_args, ast_str(v_entry[1]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_value"), sv_args)))
                vi = vi + 1
            }

            let di = 0
            while di < len(s_drives) {
                let d_entry = s_drives[di]
                let sd_args = list_new()
                push(sd_args, ast_ident(soul_var))
                push(sd_args, ast_str(d_entry[0]))
                push(sd_args, ast_int(d_entry[1]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_drive"), sd_args)))
                di = di + 1
            }

            let fi = 0
            while fi < len(s_feelings) {
                let f_entry = s_feelings[fi]
                let sf_args = list_new()
                push(sf_args, ast_ident(soul_var))
                push(sf_args, ast_str(f_entry[0]))
                push(sf_args, ast_int(f_entry[1]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_feeling"), sf_args)))
                fi = fi + 1
            }

            let pi = 0
            while pi < len(s_phases) {
                let p_entry = s_phases[pi]
                let sp_args = list_new()
                push(sp_args, ast_ident(soul_var))
                push(sp_args, ast_str(p_entry[0]))
                push(sp_args, ast_str(p_entry[1]))
                push(sp_args, ast_str(p_entry[2]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_add_phase"), sp_args)))

                if p_entry[4] != "" {
                    let st_args = list_new()
                    push(st_args, ast_ident(soul_var))
                    push(st_args, ast_str(p_entry[0]))
                    push(st_args, ast_str(p_entry[4]))
                    push(st_args, ast_str(p_entry[5]))
                    push(st_args, ast_int(p_entry[6]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_phase_set_transition"), st_args)))
                }

                let phase_boosts = p_entry[3]
                let bi = 0
                while bi < len(phase_boosts) {
                    let boost = phase_boosts[bi]
                    let sb_args = list_new()
                    push(sb_args, ast_ident(soul_var))
                    push(sb_args, ast_str(p_entry[0]))
                    push(sb_args, ast_str(boost[0]))
                    push(sb_args, ast_int(boost[1]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_add_phase_boost"), sb_args)))
                    bi = bi + 1
                }
                pi = pi + 1
            }

            let ri = 0
            while ri < len(s_reactions) {
                let r_entry = s_reactions[ri]
                let trigger = r_entry[0]
                let effects = r_entry[1]
                let sr_args = list_new()
                push(sr_args, ast_ident(soul_var))
                push(sr_args, ast_str(trigger))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_add_reaction"), sr_args)))

                let efi = 0
                while efi < len(effects) {
                    let eff = effects[efi]
                    let se_args = list_new()
                    push(se_args, ast_ident(soul_var))
                    push(se_args, ast_str(trigger))
                    push(se_args, ast_str(eff[0]))
                    if eff[0] == "shift" {
                        push(se_args, ast_str(eff[1]))
                        push(se_args, ast_int(eff[2]))
                    }
                    if eff[0] == "strengthen" {
                        push(se_args, ast_str(eff[1]))
                        push(se_args, ast_int(0))
                    }
                    if eff[0] == "reconsider" {
                        push(se_args, ast_str(eff[1]))
                        push(se_args, ast_int(0))
                    }
                    if eff[0] == "transition_to" {
                        push(se_args, ast_str(eff[1]))
                        push(se_args, ast_int(0))
                    }
                    if eff[0] == "conditional_transition" {
                        push(se_args, ast_str(eff[3]))
                        push(se_args, ast_int(0))
                    }
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_add_reaction_effect"), se_args)))
                    efi = efi + 1
                }
                ri = ri + 1
            }

            if len(s_phases) > 0 {
                let sip_args = list_new()
                push(sip_args, ast_ident(soul_var))
                let first_phase = s_phases[0]
                push(sip_args, ast_str(first_phase[0]))
                push(expanded, ast_expr_stmt(ast_call(ast_ident("soul_set_phase"), sip_args)))
            }

            let srs_args = list_new()
            push(srs_args, ast_ident(soul_var))
            push(expanded, ast_expr_stmt(ast_call(ast_ident("scheduler_register_soul"), srs_args)))
          } else {
            if ast_tag(ed) == AST_SYSTEM {
                let sysname = ed[1]
                let sys_minds = ed[2]
                let sys_bridges = ed[3]
                let sys_shared = ed[4]
                let sys_soul = ed[5]
                let sys_var = sysname + "_sys"

                let sn_args = list_new()
                push(sn_args, ast_str(sysname))
                push(expanded, ast_let(sys_var, ast_call(ast_ident("system_new"), sn_args)))

                let mi = 0
                while mi < len(sys_minds) {
                    let me = sys_minds[mi]
                    let label = me[0]
                    let mtype = me[1]
                    let sam_args = list_new()
                    push(sam_args, ast_ident(sys_var))
                    push(sam_args, ast_str(label))
                    push(sam_args, ast_ident(mtype + "_nodes"))
                    push(sam_args, ast_ident(mtype + "_channels"))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("system_add_mind"), sam_args)))
                    mi = mi + 1
                }

                let bi = 0
                while bi < len(sys_bridges) {
                    let be = sys_bridges[bi]
                    let sab_args = list_new()
                    push(sab_args, ast_ident(sys_var))
                    push(sab_args, ast_str(be[0]))
                    push(sab_args, ast_str(be[1]))
                    push(sab_args, ast_str(be[2]))
                    push(sab_args, ast_int(be[3]))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("system_add_bridge"), sab_args)))
                    bi = bi + 1
                }

                if sys_shared != "" {
                    let ssd_args = list_new()
                    push(ssd_args, ast_ident(sys_var))
                    push(ssd_args, ast_str(sys_shared))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("system_set_shared_db"), ssd_args)))
                }

                if sys_soul != "" {
                    let ssa_args = list_new()
                    push(ssa_args, ast_ident(sys_var))
                    push(ssa_args, ast_ident(sys_soul + "_soul"))
                    push(expanded, ast_expr_stmt(ast_call(ast_ident("system_attach_soul"), ssa_args)))
                }
            } else {
                push(expanded, ed)
            }
          }
        }
        ei = ei + 1
    }
    decls = expanded

    // First pass: collect struct and enum declarations
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_STRUCT_DECL {
            let entry = list_new()
            push(entry, d[1])
            push(entry, d[2])
            push(cg_structs, entry)
            cg_struct_count = cg_struct_count + 1
        }
        if ast_tag(d) == AST_ENUM_DECL {
            let entry = list_new()
            push(entry, d[1])
            push(entry, d[2])
            push(cg_enums, entry)
            cg_enum_count = cg_enum_count + 1
        }
        i = i + 1
    }

    // Collect globals (top-level let declarations)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_LET_STMT {
            add_global(d[1])
        }
        i = i + 1
    }

    // Collect methods
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_METHOD_DECL {
            let mentry = list_new()
            push(mentry, d[1])
            push(mentry, d[2])
            push(cg_methods, mentry)
            cg_method_count = cg_method_count + 1
            let mfn_name = d[1] + "_" + d[2]
            push(cg_fns, mfn_name)
        }
        i = i + 1
    }

    // Collect extern function declarations
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_EXTERN_FN {
            push(cg_fns, d[1])
            push(cg_externs, d[1])
            cg_extern_count = cg_extern_count + 1
        }
        i = i + 1
    }

    // Collect function names (including lambdas from parser)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            push(cg_fns, d[1])
        }
        i = i + 1
    }
    // Register lambda names
    let li = 0
    while li < len(par_lambdas) {
        let lam = par_lambdas[li]
        push(cg_fns, lam[1])
        li = li + 1
    }

    // Pre-pass: compute captures for all lambdas
    li = 0
    while li < len(par_lambdas) {
        let lam = par_lambdas[li]
        let caps = compute_captures(lam)
        if len(caps) > 0 {
            let cap_entry = list_new()
            push(cap_entry, lam[1])
            push(cap_entry, caps)
            push(cg_lambda_caps, cap_entry)
            let ci = 0
            while ci < len(caps) {
                let slot_entry = list_new()
                push(slot_entry, lam[1])
                push(slot_entry, caps[ci])
                push(cg_capture_slots, slot_entry)
                ci = ci + 1
            }
        }
        li = li + 1
    }

    out(".intel_syntax noprefix")
    if cg_debug == 1 {
        if len(cg_source_file) > 0 {
            out("    .file 1 " + DQ + cg_source_file + DQ)
        }
    }
    out_section("text")

    // Generate functions
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            gen_function(d)
        }
        i = i + 1
    }

    // Generate method functions
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_METHOD_DECL {
            let mfn = list_new()
            push(mfn, AST_FN_DECL)
            push(mfn, d[1] + "_" + d[2])
            push(mfn, d[3])
            push(mfn, d[4])
            gen_function(mfn)
        }
        i = i + 1
    }

    // Generate lambda functions
    li = 0
    while li < len(par_lambdas) {
        gen_function(par_lambdas[li])
        li = li + 1
    }

    // Emit top-level asm blocks (outside _start)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_ASM {
            let asm_lines = d[1]
            let ai = 0
            while ai < len(asm_lines) {
                out("    " + asm_lines[ai])
                ai = ai + 1
            }
        }
        i = i + 1
    }

    // Generate _start for top-level code
    cg_locals = list_new()
    cg_local_count = 0
    cg_params = list_new()
    cg_param_count = 0

    // Collect top-level locals (non-global let inside if/while)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dtag = ast_tag(d)
        if dtag == AST_IF_STMT {
            collect_locals(d)
        }
        if dtag == AST_WHILE_STMT {
            collect_locals(d)
        }
        if dtag == AST_FOR_STMT {
            collect_locals(d)
        }
        if dtag == AST_MATCH_STMT {
            collect_locals(d)
        }
        if dtag == AST_TRY_CATCH {
            collect_locals(d)
        }
        if dtag == AST_DO_WHILE {
            collect_locals(d)
        }
        if dtag == AST_FOR_INDEXED {
            collect_locals(d)
        }
        if dtag == AST_DESTRUCTURE {
            collect_locals(d)
        }
        if dtag == AST_EXPR_STMT {
            collect_locals(d)
        }
        if dtag == AST_LET_STMT {
            collect_comp_vars(d[2])
        }
        if dtag == AST_ASSIGN_STMT {
            collect_comp_vars(d[2])
        }
        i = i + 1
    }

    out("")
    if cg_target == 1 {
        out(".globl _main")
        out("_main:")
    } else {
        if cg_target == 3 {
            out(".globl mainCRTStartup")
            out("mainCRTStartup:")
        } else {
            out(".globl _start")
            out("_start:")
        }
    }
    if cg_target == 3 {
        out("    xor edi, edi")
        out("    xor esi, esi")
        out("    mov [rip + _g___argc], rdi")
        out("    mov [rip + _g___argv], rsi")
        out("    mov [rip + _g___envp], rsi")
    } else {
        out("    mov rdi, [rsp]")
        out("    lea rsi, [rsp + 8]")
        out("    mov [rip + _g___argc], rdi")
        out("    mov [rip + _g___argv], rsi")
        // envp is after argv: at rsp + 8 + (argc+1)*8
        out("    mov rax, rdi")
        out("    inc rax")
        out("    lea rax, [rsp + 8 + rax*8]")
        out("    mov [rip + _g___envp], rax")
    }
    out("    push rbp")
    out("    mov rbp, rsp")
    let frame_size = cg_local_count * 8
    let frame_rem2 = frame_size % 16
    if frame_rem2 == 0 {
    } else {
        frame_size = frame_size + (16 - frame_rem2)
    }
    if frame_size > 0 {
        out("    sub rsp, " + int_to_str(frame_size))
    }

    // Generate top-level statements (skip function and method declarations)
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let skip_top = 0
        if ast_tag(d) == AST_FN_DECL { skip_top = 1 }
        if ast_tag(d) == AST_METHOD_DECL { skip_top = 1 }
        if ast_tag(d) == AST_EXTERN_FN { skip_top = 1 }
        if ast_tag(d) == AST_ASM { skip_top = 1 }
        if skip_top == 0 {
            gen_stmt(d)
        }
        i = i + 1
    }

    if cg_target == 3 {
        out("    xor ecx, ecx")
        out("    call [rip + __imp_ExitProcess]")
    } else {
        out("    mov rdi, 0")
        emit_syscall(60)
    }

    // Emit string data section
    out("")
    out_section("rodata")
    i = 0
    while i < cg_str_count {
        out_label("_str_" + int_to_str(i))
        out("    .asciz " + DQ + escape_for_asm(cg_strings[i]) + DQ)
        i = i + 1
    }

    // Emit globals in .bss
    out("")
    out_section("bss")
    // Always add argc/argv globals
    out("    .align 8")
    out_label("_g___argc")
    out("    .quad 0")
    out_label("_g___argv")
    out("    .quad 0")
    out_label("_g___envp")
    out("    .quad 0")
    i = 0
    while i < cg_global_count {
        out("    .align 8")
        out_label("_g_" + cg_globals[i])
        out("    .quad 0")
        i = i + 1
    }

    // Emit closure capture slots
    i = 0
    while i < len(cg_capture_slots) {
        let slot = cg_capture_slots[i]
        out("    .align 8")
        out_label("_cap_" + slot[0] + "_" + slot[1])
        out("    .quad 0")
        i = i + 1
    }

    // Emit Win32 API import declarations for PE/COFF linking
    if cg_target == 3 {
        out("")
        out(".extern __imp_ExitProcess")
        out(".extern __imp_GetStdHandle")
        out(".extern __imp_WriteFile")
        out(".extern __imp_ReadFile")
        out(".extern __imp_CreateFileA")
        out(".extern __imp_CloseHandle")
        out(".extern __imp_VirtualAlloc")
        out(".extern __imp_Sleep")
        out(".extern __imp_CreateDirectoryA")
        out(".extern __imp_DeleteFileA")
        out(".extern __imp_GetFileSizeEx")
        out(".extern __imp_GetSystemTimeAsFileTime")
    }

    // Emit runtime library
    out("")
    out_section("text")
    gen_runtime()

    peephole_optimize()

    return join(cg_output, chr(10))
}

// =====================================================================
// WASM Backend — emits WebAssembly Text Format (WAT)
// =====================================================================

let wasm_strs = 0
let wasm_str_offset = 0
let wasm_data_entries = 0
let wasm_indent = 0
let wasm_local_map = 0
let wasm_local_idx = 0
let wasm_globals_list = 0
let wasm_break_depth = 0
let wasm_continue_depth = 0
let wasm_block_depth = 0
let wasm_fn_names = 0

fn wi(line) {
    let prefix = ""
    let ii = 0
    while ii < wasm_indent {
        prefix = prefix + "  "
        ii = ii + 1
    }
    push(cg_output, prefix + line)
}

fn wasm_add_str(s) {
    let offset = wasm_str_offset
    push(wasm_data_entries, offset)
    push(wasm_data_entries, s)
    wasm_str_offset = wasm_str_offset + len(s) + 1
    return offset
}

fn wasm_escape_str(s) {
    let result = ""
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 34 {
            result = result + chr(92) + chr(34)
        } else {
            if c == 92 {
                result = result + chr(92) + chr(92)
            } else {
                if c == 10 {
                    result = result + chr(92) + "n"
                } else {
                    if c < 32 {
                        result = result + "."
                    } else {
                        result = result + chr(c)
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

fn wasm_local_get(name) {
    wi("local.get $" + name)
}

fn wasm_local_set(name) {
    wi("local.set $" + name)
}

fn wasm_global_get(name) {
    wi("global.get $g_" + name)
}

fn wasm_global_set(name) {
    wi("global.set $g_" + name)
}

fn wasm_is_global(name) {
    let i = 0
    while i < cg_global_count {
        if cg_globals[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

fn wasm_is_fn(name) {
    let i = 0
    while i < len(wasm_fn_names) {
        if wasm_fn_names[i] == name { return 1 }
        i = i + 1
    }
    if is_builtin_fn(name) == 1 { return 1 }
    return 0
}

fn wasm_collect_locals(nd) {
    let tag = ast_tag(nd)
    if tag == AST_LET_STMT {
        let vname = nd[1]
        if wasm_is_global(vname) == 0 {
            let exists = 0
            let k = 0
            while k < len(wasm_local_map) {
                if wasm_local_map[k] == vname { exists = 1 }
                k = k + 1
            }
            if exists == 0 {
                push(wasm_local_map, vname)
            }
        }
    }
    if tag == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            wasm_collect_locals(stmts[i])
            i = i + 1
        }
    }
    if tag == AST_IF_STMT {
        wasm_collect_locals(nd[2])
        if len(nd) > 3 {
            if nd[3] == 0 {
            } else {
                wasm_collect_locals(nd[3])
            }
        }
    }
    if tag == AST_WHILE_STMT {
        wasm_collect_locals(nd[2])
    }
    if tag == AST_FOR_STMT {
        let vname = nd[1]
        let exists = 0
        let k = 0
        while k < len(wasm_local_map) {
            if wasm_local_map[k] == vname { exists = 1 }
            k = k + 1
        }
        if exists == 0 {
            push(wasm_local_map, vname)
        }
        wasm_collect_locals(nd[3])
    }
    if tag == AST_DO_WHILE {
        wasm_collect_locals(nd[1])
    }
    if tag == AST_TRY_CATCH {
        wasm_collect_locals(nd[1])
        wasm_collect_locals(nd[2])
    }
    if tag == AST_FOR_INDEXED {
        let iname = nd[1]
        let vname2 = nd[2]
        let exists = 0
        let k = 0
        while k < len(wasm_local_map) {
            if wasm_local_map[k] == iname { exists = 1 }
            k = k + 1
        }
        if exists == 0 { push(wasm_local_map, iname) }
        exists = 0
        k = 0
        while k < len(wasm_local_map) {
            if wasm_local_map[k] == vname2 { exists = 1 }
            k = k + 1
        }
        if exists == 0 { push(wasm_local_map, vname2) }
        wasm_collect_locals(nd[4])
    }
}

fn wasm_gen_expr(nd) {
    let tag = ast_tag(nd)

    if tag == AST_INT_LIT {
        wi("i64.const " + int_to_str(nd[1]))
        return 0
    }

    if tag == AST_BOOL_LIT {
        if nd[1] == 1 {
            wi("i64.const 1")
        } else {
            wi("i64.const 0")
        }
        return 0
    }

    if tag == AST_NONE_LIT {
        wi("i64.const 0")
        return 0
    }

    if tag == AST_FLOAT_LIT {
        wi("i64.const " + int_to_str(nd[1]))
        return 0
    }

    if tag == AST_STR_LIT {
        let offset = wasm_add_str(nd[1])
        wi("i64.const " + int_to_str(offset))
        return 0
    }

    if tag == AST_IDENT {
        let name = nd[1]
        if wasm_is_global(name) == 1 {
            wasm_global_get(name)
        } else {
            if wasm_is_fn(name) == 1 {
                wi("i64.const 0")
            } else {
                wasm_local_get(name)
            }
        }
        return 0
    }

    if tag == AST_BIN_OP {
        let op = nd[1]
        if op == "==" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("call $rt_eq")
            return 0
        }
        if op == "+" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("call $rt_add")
            return 0
        }
        if op == "-" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.sub")
            return 0
        }
        if op == "*" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.mul")
            return 0
        }
        if op == "/" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.div_s")
            return 0
        }
        if op == "%" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.rem_s")
            return 0
        }
        if op == "<" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.lt_s")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == ">" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.gt_s")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == "<=" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.le_s")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == ">=" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.ge_s")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == "!=" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("call $rt_eq")
            wi("i64.eqz")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == "&" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.and")
            return 0
        }
        if op == "|" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.or")
            return 0
        }
        if op == "^" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.xor")
            return 0
        }
        if op == "<<" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.shl")
            return 0
        }
        if op == ">>" {
            wasm_gen_expr(nd[2])
            wasm_gen_expr(nd[3])
            wi("i64.shr_s")
            return 0
        }
        wasm_gen_expr(nd[2])
        wasm_gen_expr(nd[3])
        wi("i64.add")
        return 0
    }

    if tag == AST_UNARY_OP {
        let op = nd[1]
        if op == "-" {
            wi("i64.const 0")
            wasm_gen_expr(nd[2])
            wi("i64.sub")
            return 0
        }
        if op == "!" {
            wasm_gen_expr(nd[2])
            wi("i64.eqz")
            wi("i64.extend_i32_u")
            return 0
        }
        if op == "~" {
            wi("i64.const -1")
            wasm_gen_expr(nd[2])
            wi("i64.xor")
            return 0
        }
        wasm_gen_expr(nd[2])
        return 0
    }

    if tag == AST_AND_EXPR {
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        wi("i64.const 0")
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[2])
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }

    if tag == AST_OR_EXPR {
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        wi("i64.const 1")
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[2])
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }

    if tag == AST_CALL {
        let callee = nd[1]
        let args = nd[2]
        let callee_name = ""
        if ast_tag(callee) == AST_IDENT {
            callee_name = callee[1]
        }
        if ast_tag(callee) == AST_FIELD_ACCESS {
            callee_name = callee[1][1] + "_" + callee[2]
        }
        let i = 0
        while i < len(args) {
            wasm_gen_expr(args[i])
            i = i + 1
        }
        wi("call $" + callee_name)
        return 0
    }

    if tag == AST_INDEX_EXPR {
        wasm_gen_expr(nd[1])
        wasm_gen_expr(nd[2])
        wi("call $rt_index")
        return 0
    }

    if tag == AST_LIST_LIT {
        let elems = nd[1]
        wi("call $list_new")
        wi("global.set $g__wasm_list_tmp")
        let i = 0
        while i < len(elems) {
            wi("global.get $g__wasm_list_tmp")
            wasm_gen_expr(elems[i])
            wi("call $push")
            wi("drop")
            i = i + 1
        }
        wi("global.get $g__wasm_list_tmp")
        return 0
    }

    if tag == AST_NULLISH {
        wasm_gen_expr(nd[1])
        wi("local.tee $__nullish_tmp")
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        wi("local.get $__nullish_tmp")
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[2])
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }

    if tag == AST_FLOW {
        wasm_gen_expr(nd[2])
        wasm_gen_expr(nd[3])
        let ft = nd[1]
        if ft == FLOW_FWD { wi("call $_nova_flow_fwd") }
        if ft == FLOW_BWD { wi("call $_nova_flow_bwd") }
        if ft == FLOW_BROADCAST { wi("call $_nova_flow_broadcast") }
        if ft == FLOW_ENRICH { wi("call $_nova_flow_enrich") }
        if ft == FLOW_TENTATIVE { wi("call $_nova_flow_tentative") }
        if ft == FLOW_RESONATE { wi("call $_nova_flow_resonate") }
        if ft == FLOW_FILTER { wi("call $_nova_flow_filter") }
        return 0
    }

    if tag == AST_TERNARY {
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if (result i64)")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[2])
        wasm_indent = wasm_indent - 1
        wi("else")
        wasm_indent = wasm_indent + 1
        wasm_gen_expr(nd[3])
        wasm_indent = wasm_indent - 1
        wi("end")
        return 0
    }

    wi("i64.const 0")
    return 0
}

fn wasm_gen_stmt(nd) {
    let tag = ast_tag(nd)

    if tag == AST_EXPR_STMT {
        wasm_gen_expr(nd[1])
        wi("drop")
        return 0
    }

    if tag == AST_LET_STMT {
        let vname = nd[1]
        wasm_gen_expr(nd[2])
        if wasm_is_global(vname) == 1 {
            wasm_global_set(vname)
        } else {
            wasm_local_set(vname)
        }
        return 0
    }

    if tag == AST_ASSIGN_STMT {
        let vname = nd[1]
        wasm_gen_expr(nd[2])
        if wasm_is_global(vname) == 1 {
            wasm_global_set(vname)
        } else {
            wasm_local_set(vname)
        }
        return 0
    }

    if tag == AST_IF_STMT {
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("i32.eqz")
        wi("if")
        wasm_indent = wasm_indent + 1
        wasm_block_depth = wasm_block_depth + 1
        wasm_gen_block_stmts(nd[2])
        wasm_block_depth = wasm_block_depth - 1
        wasm_indent = wasm_indent - 1
        if len(nd) > 3 {
            let else_nd = nd[3]
            if else_nd == 0 {
            } else {
                wi("else")
                wasm_indent = wasm_indent + 1
                wasm_block_depth = wasm_block_depth + 1
                let else_tag = ast_tag(else_nd)
                if else_tag == AST_BLOCK {
                    wasm_gen_block_stmts(else_nd)
                } else {
                    if else_tag == AST_IF_STMT {
                        wasm_gen_stmt(else_nd)
                    } else {
                        wasm_gen_block_stmts(else_nd)
                    }
                }
                wasm_block_depth = wasm_block_depth - 1
                wasm_indent = wasm_indent - 1
            }
        }
        wi("end")
        return 0
    }

    if tag == AST_WHILE_STMT {
        let save_break = wasm_break_depth
        let save_cont = wasm_continue_depth
        wi("block $brk" + int_to_str(cg_label_count))
        wi("loop $cont" + int_to_str(cg_label_count))
        wasm_indent = wasm_indent + 1
        wasm_break_depth = 1
        wasm_continue_depth = 0
        wasm_block_depth = wasm_block_depth + 2
        wasm_gen_expr(nd[1])
        wi("i64.eqz")
        wi("br_if $brk" + int_to_str(cg_label_count))
        wasm_gen_block_stmts(nd[2])
        wi("br $cont" + int_to_str(cg_label_count))
        wasm_block_depth = wasm_block_depth - 2
        wasm_indent = wasm_indent - 1
        wi("end")
        wi("end")
        wasm_break_depth = save_break
        wasm_continue_depth = save_cont
        cg_label_count = cg_label_count + 1
        return 0
    }

    if tag == AST_FOR_STMT {
        let vname = nd[1]
        let iter_expr = nd[2]
        let body = nd[3]
        wasm_gen_expr(iter_expr)
        wasm_local_set("_for_iter")
        wi("i64.const 0")
        wasm_local_set("_for_idx")
        let save_break = wasm_break_depth
        let save_cont = wasm_continue_depth
        wi("block $brk" + int_to_str(cg_label_count))
        wi("loop $cont" + int_to_str(cg_label_count))
        wasm_indent = wasm_indent + 1
        wasm_break_depth = 1
        wasm_continue_depth = 0
        wasm_block_depth = wasm_block_depth + 2
        wasm_local_get("_for_idx")
        wasm_local_get("_for_iter")
        wi("call $len")
        wi("i64.ge_s")
        wi("br_if $brk" + int_to_str(cg_label_count))
        wasm_local_get("_for_iter")
        wasm_local_get("_for_idx")
        wi("call $rt_index")
        wasm_local_set(vname)
        wasm_gen_block_stmts(body)
        wasm_local_get("_for_idx")
        wi("i64.const 1")
        wi("i64.add")
        wasm_local_set("_for_idx")
        wi("br $cont" + int_to_str(cg_label_count))
        wasm_block_depth = wasm_block_depth - 2
        wasm_indent = wasm_indent - 1
        wi("end")
        wi("end")
        wasm_break_depth = save_break
        wasm_continue_depth = save_cont
        cg_label_count = cg_label_count + 1
        return 0
    }

    if tag == AST_RETURN_STMT {
        wasm_gen_expr(nd[1])
        wi("return")
        return 0
    }

    if tag == AST_BLOCK {
        wasm_gen_block_stmts(nd)
        return 0
    }

    if tag == AST_BREAK_STMT {
        wi("br $brk" + int_to_str(cg_label_count - 1))
        return 0
    }

    if tag == AST_CONTINUE_STMT {
        wi("br $cont" + int_to_str(cg_label_count - 1))
        return 0
    }

    if tag == AST_INDEX_ASSIGN {
        wasm_gen_expr(nd[1])
        wasm_gen_expr(nd[2])
        wasm_gen_expr(nd[3])
        wi("call $rt_index_set")
        wi("drop")
        return 0
    }

    if tag == AST_FN_DECL {
        return 0
    }
    if tag == AST_STRUCT_DECL {
        return 0
    }
    if tag == AST_ENUM_DECL {
        return 0
    }
    if tag == AST_METHOD_DECL {
        return 0
    }

    return 0
}

fn wasm_gen_block_stmts(nd) {
    if ast_tag(nd) == AST_BLOCK {
        let stmts = nd[1]
        let i = 0
        while i < len(stmts) {
            wasm_gen_stmt(stmts[i])
            i = i + 1
        }
    } else {
        wasm_gen_stmt(nd)
    }
}

fn wasm_gen_function(d) {
    let fname = d[1]
    let params = d[2]
    let body = d[3]
    wasm_local_map = list_new()
    wasm_local_idx = 0
    let sig = "(func $" + fname
    let pi = 0
    while pi < len(params) {
        let pname = params[pi]
        if ast_tag(pname) == AST_DEFAULT_PARAM {
            pname = pname[1]
        }
        sig = sig + " (param $" + pname + " i64)"
        pi = pi + 1
    }
    sig = sig + " (result i64)"
    wasm_collect_locals(body)
    wi(sig)
    wasm_indent = wasm_indent + 1
    let li = 0
    while li < len(wasm_local_map) {
        wi("(local $" + wasm_local_map[li] + " i64)")
        li = li + 1
    }
    wi("(local $_for_iter i64)")
    wi("(local $_for_idx i64)")
    wasm_gen_block_stmts(body)
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

fn wasm_gen_rt_core() {
    // Memory allocator
    wi("(func $alloc (param $size i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i64)")
    wi("global.get $heap_ptr")
    wi("local.set $ptr")
    wi("global.get $heap_ptr")
    wi("local.get $size")
    wi("i64.add")
    wi("global.set $heap_ptr")
    wi("local.get $ptr")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_eq — compare two values (int or string)
    wi("(func $rt_eq (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("i64.const 1048576")
    wi("i64.lt_s")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.eq")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("call $rt_streq")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_streq — compare two null-terminated strings
    wi("(func $rt_streq (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ia i32)")
    wi("(local $ib i32)")
    wi("(local $ca i32)")
    wi("(local $cb i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.set $ia")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.set $ib")
    wi("block $done")
    wi("loop $cmp")
    wasm_indent = wasm_indent + 1
    wi("local.get $ia")
    wi("i32.load8_u")
    wi("local.set $ca")
    wi("local.get $ib")
    wi("i32.load8_u")
    wi("local.set $cb")
    wi("local.get $ca")
    wi("local.get $cb")
    wi("i32.ne")
    wi("if")
    wi("  i64.const 0")
    wi("  return")
    wi("end")
    wi("local.get $ca")
    wi("i32.eqz")
    wi("br_if $done")
    wi("local.get $ia")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ia")
    wi("local.get $ib")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ib")
    wi("br $cmp")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("i64.const 1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_add — smart add (int add or string concat)
    wi("(func $rt_add (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("i64.const 1048576")
    wi("i64.lt_s")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.add")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("call $concat")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // strlen
    wi("(func $rt_strlen (param $s i32) (result i32)")
    wasm_indent = wasm_indent + 1
    wi("(local $n i32)")
    wi("block $done")
    wi("loop $cnt")
    wasm_indent = wasm_indent + 1
    wi("local.get $s")
    wi("local.get $n")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i32.eqz")
    wi("br_if $done")
    wi("local.get $n")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $n")
    wi("br $cnt")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $n")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // len — length of string or list
    wi("(func $len (param $v i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i64.const 1048576")
    wi("i64.lt_s")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i32.wrap_i64")
    wi("i64.load")
    wi("i64.const -1")
    wi("i64.eq")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.add")
    wi("i64.load")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i32.wrap_i64")
    wi("call $rt_strlen")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // concat — concatenate two strings
    wi("(func $concat (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $la i32)")
    wi("(local $lb i32)")
    wi("(local $dst i32)")
    wi("(local $i i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("call $rt_strlen")
    wi("local.set $la")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("call $rt_strlen")
    wi("local.set $lb")
    wi("local.get $la")
    wi("local.get $lb")
    wi("i32.add")
    wi("i32.const 1")
    wi("i32.add")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $dst")
    wi("i32.const 0")
    wi("local.set $i")
    wi("block $d1")
    wi("loop $c1")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $la")
    wi("i32.ge_u")
    wi("br_if $d1")
    wi("local.get $dst")
    wi("local.get $i")
    wi("i32.add")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.get $i")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i32.store8")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $c1")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("i32.const 0")
    wi("local.set $i")
    wi("block $d2")
    wi("loop $c2")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $lb")
    wi("i32.ge_u")
    wi("br_if $d2")
    wi("local.get $dst")
    wi("local.get $la")
    wi("i32.add")
    wi("local.get $i")
    wi("i32.add")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.get $i")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i32.store8")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $c2")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $dst")
    wi("local.get $la")
    wi("i32.add")
    wi("local.get $lb")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $dst")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

fn wasm_gen_rt_io() {
    // print — write string to stdout
    wi("(func $print (param $s i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i32)")
    wi("(local $slen i32)")
    wi("local.get $s")
    wi("i32.wrap_i64")
    wi("local.set $ptr")
    wi("local.get $ptr")
    wi("call $rt_strlen")
    wi("local.set $slen")
    wi("i32.const 0")
    wi("local.get $ptr")
    wi("i32.store")
    wi("i32.const 4")
    wi("local.get $slen")
    wi("i32.store")
    wi("i32.const 1")
    wi("i32.const 0")
    wi("i32.const 1")
    wi("i32.const 8")
    wi("call $fd_write")
    wi("drop")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // println — print + newline
    let nl_offset = wasm_add_str(chr(10))
    wi("(func $println (param $s i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $s")
    wi("call $print")
    wi("drop")
    wi("i64.const " + int_to_str(nl_offset))
    wi("call $print")
    wi("drop")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // int_to_str
    wi("(func $int_to_str (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $buf i32)")
    wi("(local $pos i32)")
    wi("(local $neg i32)")
    wi("(local $d i64)")
    wi("(local $tmp i64)")
    wi("i32.const 24")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $buf")
    wi("local.get $buf")
    wi("i32.const 20")
    wi("i32.add")
    wi("local.set $pos")
    wi("local.get $pos")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $n")
    wi("i64.const 0")
    wi("i64.lt_s")
    wi("if")
    wasm_indent = wasm_indent + 1
    wi("i32.const 1")
    wi("local.set $neg")
    wi("i64.const 0")
    wi("local.get $n")
    wi("i64.sub")
    wi("local.set $n")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("local.get $n")
    wi("i64.eqz")
    wi("if")
    wasm_indent = wasm_indent + 1
    wi("local.get $pos")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $pos")
    wi("local.get $pos")
    wi("i32.const 48")
    wi("i32.store8")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("block $done")
    wi("loop $digits")
    wasm_indent = wasm_indent + 1
    wi("local.get $n")
    wi("i64.eqz")
    wi("br_if $done")
    wi("local.get $n")
    wi("i64.const 10")
    wi("i64.rem_s")
    wi("local.set $d")
    wi("local.get $pos")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $pos")
    wi("local.get $pos")
    wi("local.get $d")
    wi("i32.wrap_i64")
    wi("i32.const 48")
    wi("i32.add")
    wi("i32.store8")
    wi("local.get $n")
    wi("i64.const 10")
    wi("i64.div_s")
    wi("local.set $n")
    wi("br $digits")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("local.get $neg")
    wi("if")
    wasm_indent = wasm_indent + 1
    wi("local.get $pos")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $pos")
    wi("local.get $pos")
    wi("i32.const 45")
    wi("i32.store8")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("local.get $pos")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // print_int
    wi("(func $print_int (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $n")
    wi("call $int_to_str")
    wi("call $print")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // assert
    let assert_msg = wasm_add_str("Assertion failed")
    let assert_sep = wasm_add_str(": ")
    wi("(func $assert (param $cond i64) (param $msg i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $cond")
    wi("i64.eqz")
    wi("if")
    wasm_indent = wasm_indent + 1
    wi("i64.const " + int_to_str(assert_msg))
    wi("call $print")
    wi("drop")
    wi("i64.const " + int_to_str(assert_sep))
    wi("call $print")
    wi("drop")
    wi("local.get $msg")
    wi("call $println")
    wi("drop")
    wi("i32.const 1")
    wi("call $proc_exit")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // list_new — allocate list header [magic=-1, count=0, cap=8, items_ptr]
    wi("(func $list_new (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $items i32)")
    wi("i64.const 32")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("i64.const 64")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $hdr")
    wi("i64.const -1")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i32.const 8")
    wi("i32.add")
    wi("i64.const 0")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i32.const 16")
    wi("i32.add")
    wi("i64.const 8")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("local.get $items")
    wi("i64.extend_i32_u")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // push — append value to list
    wi("(func $push (param $list i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $cnt i64)")
    wi("(local $items i32)")
    wi("local.get $list")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("local.get $hdr")
    wi("i32.const 8")
    wi("i32.add")
    wi("i64.load")
    wi("local.set $cnt")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("i64.load")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $items")
    wi("local.get $cnt")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("local.get $val")
    wi("i64.store")
    wi("local.get $hdr")
    wi("i32.const 8")
    wi("i32.add")
    wi("local.get $cnt")
    wi("i64.const 1")
    wi("i64.add")
    wi("i64.store")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_index — list[i]
    wi("(func $rt_index (param $list i64) (param $idx i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $items i32)")
    wi("local.get $list")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("i64.load")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $items")
    wi("local.get $idx")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("i64.load")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_index_set — list[i] = val
    wi("(func $rt_index_set (param $list i64) (param $idx i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $items i32)")
    wi("local.get $list")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("i64.load")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $items")
    wi("local.get $idx")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("local.get $val")
    wi("i64.store")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // rt_list_push — used by list literal codegen (pushes and returns list)
    wi("(func $rt_list_push (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $list i64)")
    wi("global.get $g__wasm_list_tmp")
    wi("local.set $list")
    wi("local.get $list")
    wi("local.get $val")
    wi("call $push")
    wi("drop")
    wi("local.get $list")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // list_set — alias for rt_index_set
    wi("(func $list_set (param $list i64) (param $idx i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $list")
    wi("local.get $idx")
    wi("local.get $val")
    wi("call $rt_index_set")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

fn wasm_gen_rt_extra() {
    // pop — remove and return last element
    wi("(func $pop (param $list i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $cnt i64)")
    wi("(local $items i32)")
    wi("(local $val i64)")
    wi("local.get $list")
    wi("i32.wrap_i64")
    wi("local.set $hdr")
    wi("local.get $hdr")
    wi("i32.const 8")
    wi("i32.add")
    wi("i64.load")
    wi("local.set $cnt")
    wi("local.get $hdr")
    wi("i32.const 24")
    wi("i32.add")
    wi("i64.load")
    wi("i32.wrap_i64")
    wi("local.set $items")
    wi("local.get $items")
    wi("local.get $cnt")
    wi("i64.const 1")
    wi("i64.sub")
    wi("i32.wrap_i64")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("i64.load")
    wi("local.set $val")
    wi("local.get $hdr")
    wi("i32.const 8")
    wi("i32.add")
    wi("local.get $cnt")
    wi("i64.const 1")
    wi("i64.sub")
    wi("i64.store")
    wi("local.get $val")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // exit
    wi("(func $exit (param $code i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $code")
    wi("i32.wrap_i64")
    wi("call $proc_exit")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // str_to_int — parse integer from string
    wi("(func $str_to_int (param $s i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i32)")
    wi("(local $result i64)")
    wi("(local $c i32)")
    wi("(local $neg i32)")
    wi("local.get $s")
    wi("i32.wrap_i64")
    wi("local.set $ptr")
    wi("local.get $ptr")
    wi("i32.load8_u")
    wi("i32.const 45")
    wi("i32.eq")
    wi("if")
    wi("  i32.const 1")
    wi("  local.set $neg")
    wi("  local.get $ptr")
    wi("  i32.const 1")
    wi("  i32.add")
    wi("  local.set $ptr")
    wi("end")
    wi("block $done")
    wi("loop $parse")
    wasm_indent = wasm_indent + 1
    wi("local.get $ptr")
    wi("i32.load8_u")
    wi("local.set $c")
    wi("local.get $c")
    wi("i32.eqz")
    wi("br_if $done")
    wi("local.get $c")
    wi("i32.const 48")
    wi("i32.lt_u")
    wi("br_if $done")
    wi("local.get $c")
    wi("i32.const 57")
    wi("i32.gt_u")
    wi("br_if $done")
    wi("local.get $result")
    wi("i64.const 10")
    wi("i64.mul")
    wi("local.get $c")
    wi("i32.const 48")
    wi("i32.sub")
    wi("i64.extend_i32_u")
    wi("i64.add")
    wi("local.set $result")
    wi("local.get $ptr")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ptr")
    wi("br $parse")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $neg")
    wi("if (result i64)")
    wi("  i64.const 0")
    wi("  local.get $result")
    wi("  i64.sub")
    wi("else")
    wi("  local.get $result")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // char_at — return char code at index
    wi("(func $char_at (param $s i64) (param $idx i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $s")
    wi("i32.wrap_i64")
    wi("local.get $idx")
    wi("i32.wrap_i64")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // chr — create single-char string
    wi("(func $chr (param $c i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i32)")
    wi("i64.const 2")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $ptr")
    wi("local.get $ptr")
    wi("local.get $c")
    wi("i32.wrap_i64")
    wi("i32.store8")
    wi("local.get $ptr")
    wi("i32.const 1")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $ptr")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // substr
    wi("(func $substr (param $s i64) (param $start i64) (param $slen i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i32)")
    wi("(local $dst i32)")
    wi("(local $i i32)")
    wi("local.get $slen")
    wi("i64.const 1")
    wi("i64.add")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $dst")
    wi("local.get $s")
    wi("i32.wrap_i64")
    wi("local.get $start")
    wi("i32.wrap_i64")
    wi("i32.add")
    wi("local.set $ptr")
    wi("block $done")
    wi("loop $cp")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $slen")
    wi("i32.wrap_i64")
    wi("i32.ge_u")
    wi("br_if $done")
    wi("local.get $dst")
    wi("local.get $i")
    wi("i32.add")
    wi("local.get $ptr")
    wi("local.get $i")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i32.store8")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $cp")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $dst")
    wi("local.get $slen")
    wi("i32.wrap_i64")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $dst")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // type_of
    wi("(func $type_of (param $v i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i64.const 1048576")
    wi("i64.lt_s")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const 1")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i32.wrap_i64")
    wi("i64.load")
    wi("i64.const -1")
    wi("i64.eq")
    wi("if (result i64)")
    wi("  i64.const 3")
    wi("else")
    wi("  local.get $v")
    wi("  i32.wrap_i64")
    wi("  i64.load")
    wi("  i64.const -2")
    wi("  i64.eq")
    wi("  if (result i64)")
    wi("    i64.const 4")
    wi("  else")
    wi("    i64.const 2")
    wi("  end")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // contains — check if list contains value
    wi("(func $contains (param $list i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $i i64)")
    wi("(local $n i64)")
    wi("local.get $list")
    wi("call $len")
    wi("local.set $n")
    wi("block $found")
    wi("loop $search")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $n")
    wi("i64.ge_s")
    wi("br_if $found")
    wi("local.get $list")
    wi("local.get $i")
    wi("call $rt_index")
    wi("local.get $val")
    wi("call $rt_eq")
    wi("i64.eqz")
    wi("i32.eqz")
    wi("if")
    wi("  i64.const 1")
    wi("  return")
    wi("end")
    wi("local.get $i")
    wi("i64.const 1")
    wi("i64.add")
    wi("local.set $i")
    wi("br $search")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // debug_print — print label and value
    wi("(func $debug_print (param $label i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $label")
    wi("call $print")
    wi("drop")
    let sep = wasm_add_str(": ")
    wi("i64.const " + int_to_str(sep))
    wi("call $print")
    wi("drop")
    wi("local.get $val")
    wi("call $int_to_str")
    wi("call $println")
    wi("drop")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

fn wasm_gen_program(program) {
    let decls = program[1]
    wasm_strs = list_new()
    wasm_str_offset = 8192
    wasm_data_entries = list_new()
    wasm_indent = 0
    wasm_fn_names = list_new()
    wasm_block_depth = 0

    // Collect globals
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_LET_STMT {
            add_global(d[1])
        }
        i = i + 1
    }

    // Collect function names
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            push(cg_fns, d[1])
            push(wasm_fn_names, d[1])
        }
        i = i + 1
    }

    let Q = chr(34)

    // Module header
    out("(module")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "fd_write" + Q + " (func $fd_write (param i32 i32 i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "proc_exit" + Q + " (func $proc_exit (param i32)))")
    out("  (memory (export " + Q + "memory" + Q + ") 256)")
    out("  (global $heap_ptr (mut i64) (i64.const 65536))")
    out("  (global $g__wasm_list_tmp (mut i64) (i64.const 0))")
    i = 0
    while i < cg_global_count {
        out("  (global $g_" + cg_globals[i] + " (mut i64) (i64.const 0))")
        i = i + 1
    }
    out("")

    // Runtime functions
    wasm_indent = 1
    wasm_gen_rt_core()
    wasm_gen_rt_io()
    wasm_gen_rt_extra()

    // User functions
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            wasm_gen_function(d)
        }
        i = i + 1
    }

    // _start entry point
    out("  (func (export " + Q + "_start" + Q + ")")
    wasm_indent = 2

    // Collect top-level locals
    wasm_local_map = list_new()
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dtag = ast_tag(d)
        if dtag == AST_IF_STMT { wasm_collect_locals(d) }
        if dtag == AST_WHILE_STMT { wasm_collect_locals(d) }
        if dtag == AST_FOR_STMT { wasm_collect_locals(d) }
        if dtag == AST_DO_WHILE { wasm_collect_locals(d) }
        if dtag == AST_FOR_INDEXED { wasm_collect_locals(d) }
        if dtag == AST_EXPR_STMT { wasm_collect_locals(d) }
        i = i + 1
    }

    let li = 0
    while li < len(wasm_local_map) {
        wi("(local $" + wasm_local_map[li] + " i64)")
        li = li + 1
    }
    wi("(local $_for_iter i64)")
    wi("(local $_for_idx i64)")

    // Generate top-level statements
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dtag2 = ast_tag(d)
        let skip = 0
        if dtag2 == AST_FN_DECL { skip = 1 }
        if dtag2 == AST_METHOD_DECL { skip = 1 }
        if dtag2 == AST_STRUCT_DECL { skip = 1 }
        if dtag2 == AST_ENUM_DECL { skip = 1 }
        if skip == 0 {
            wasm_gen_stmt(d)
        }
        i = i + 1
    }

    out("  )")
    out("")

    // Data section for strings
    i = 0
    while i < len(wasm_data_entries) {
        let doff = wasm_data_entries[i]
        let dstr = wasm_data_entries[i + 1]
        out("  (data (i32.const " + int_to_str(doff) + ") " + Q + wasm_escape_str(dstr) + chr(92) + "00" + Q + ")")
        i = i + 2
    }

    out(")")

    return join(cg_output, chr(10))
}

fn peephole_optimize() {
    let n = len(cg_output)
    let i = 0
    // Pass 1: push/pop elimination
    while i < n - 1 {
        let cur = cg_output[i]
        let nxt = cg_output[i + 1]
        if cur == "    push rax" {
            if nxt == "    pop rax" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "")
            }
            if nxt == "    pop rcx" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "    mov rcx, rax")
            }
            if nxt == "    pop rdi" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "    mov rdi, rax")
            }
            if nxt == "    pop rsi" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "    mov rsi, rax")
            }
        }
        if cur == "    push rcx" {
            if nxt == "    pop rcx" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "")
            }
        }
        if cur == "    push rdi" {
            if nxt == "    pop rdi" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "")
            }
        }
        i = i + 1
    }
    // Pass 2: mov rax,0 → xor eax,eax; redundant movs
    i = 0
    while i < n {
        let cur = cg_output[i]
        if cur == "    mov rax, 0" {
            list_set(cg_output, i, "    xor eax, eax")
        }
        if cur == "    mov rdi, 0" {
            list_set(cg_output, i, "    xor edi, edi")
        }
        if cur == "    mov rsi, 0" {
            list_set(cg_output, i, "    xor esi, esi")
        }
        if cur == "    mov rcx, 0" {
            list_set(cg_output, i, "    xor ecx, ecx")
        }
        i = i + 1
    }
    // Pass 3: jmp-to-next-label elimination
    i = 0
    while i < n - 1 {
        let cur = cg_output[i]
        let nxt = cg_output[i + 1]
        if starts_with(cur, "    jmp ") == 1 {
            let target = substr(cur, 8, len(cur) - 8)
            if nxt == target + ":" {
                list_set(cg_output, i, "")
            }
        }
        i = i + 1
    }
    // Pass 4: redundant mov to same reg when second doesn't read that reg
    i = 0
    while i < n - 1 {
        let cur = cg_output[i]
        let nxt = cg_output[i + 1]
        if starts_with(cur, "    mov rax, ") == 1 {
            if starts_with(nxt, "    mov rax, ") == 1 {
                if contains(nxt, "rax]") == 0 {
                    if contains(nxt, "rax +") == 0 {
                        if contains(nxt, "rax*") == 0 {
                            list_set(cg_output, i, "")
                        }
                    }
                }
            }
        }
        i = i + 1
    }
}

fn gen_runtime() {
    // --- Smart add: integer add or string concat ---
    out_label("_nova_add")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .add_int")
    out("    cmp rsi, 0x" + PTR_THRESHOLD)
    out("    jl .add_int")
    out("    jmp _nova_concat")
    out(".add_int:")
    out("    lea rax, [rdi + rsi]")
    out("    ret")

    // --- Smart multiply: integer mul, string repeat, or list repeat ---
    out("")
    out_label("_nova_mul")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jge .mul_ptr")
    out("    cmp rsi, 0x" + PTR_THRESHOLD)
    out("    jge .mul_ptr_swap")
    out("    mov rax, rdi")
    out("    imul rax, rsi")
    out("    ret")
    out(".mul_ptr_swap:")
    out("    xchg rdi, rsi")
    out(".mul_ptr:")
    out("    cmp qword ptr [rdi], -1")
    out("    je .mul_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call str_repeat")
    out("    pop rbp")
    out("    ret")
    out(".mul_list:")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_list_repeat")
    out("    pop rbp")
    out("    ret")

    // --- Power: rdi ** rsi (integer exponentiation) ---
    out("")
    out_label("_nova_pow")
    out("    mov rax, 1")
    out("    test rsi, rsi")
    out("    jz .pow_done")
    out(".pow_loop:")
    out("    imul rax, rdi")
    out("    dec rsi")
    out("    jnz .pow_loop")
    out(".pow_done:")
    out("    ret")

    // --- List repeat: rdi=list, rsi=count ---
    out("")
    out_label("_nova_list_repeat")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r15, r15")
    out(".listrep_outer:")
    out("    cmp r15, r13")
    out("    jge .listrep_done")
    out("    mov rax, [r12 + 8]")
    out("    xor rcx, rcx")
    out(".listrep_inner:")
    out("    cmp rcx, rax")
    out("    jge .listrep_next")
    out("    push rax")
    out("    push rcx")
    out("    mov rdx, [r12 + 24]")
    out("    mov rsi, [rdx + rcx*8]")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out("    pop rcx")
    out("    pop rax")
    out("    inc rcx")
    out("    jmp .listrep_inner")
    out(".listrep_next:")
    out("    inc r15")
    out("    jmp .listrep_outer")
    out(".listrep_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- Smart equality: integer or string ---
    out("")
    out_label("_nova_eq")
    out("    cmp rdi, rsi")
    out("    je .eq_true")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .eq_false")
    out("    cmp rsi, 0x" + PTR_THRESHOLD)
    out("    jl .eq_false")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_str_eq")
    out("    pop rbp")
    out("    ret")
    out(".eq_true:")
    out("    mov eax, 1")
    out("    ret")
    out(".eq_false:")
    out("    xor eax, eax")
    out("    ret")

    // --- Smart not-equal ---
    out("")
    out_label("_nova_neq")
    out("    cmp rdi, rsi")
    out("    je .neq_false")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .neq_true")
    out("    cmp rsi, 0x" + PTR_THRESHOLD)
    out("    jl .neq_true")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_str_eq")
    out("    xor eax, 1")
    out("    pop rbp")
    out("    ret")
    out(".neq_true:")
    out("    mov eax, 1")
    out("    ret")
    out(".neq_false:")
    out("    xor eax, eax")
    out("    ret")

    // --- Smart less-than: int or string comparison ---
    out("")
    out_label("_nova_lt")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .lt_int")
    out("    cmp rsi, 0x" + PTR_THRESHOLD)
    out("    jl .lt_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_strcmp")
    out("    pop rbp")
    out("    test rax, rax")
    out("    setl al")
    out("    movzx rax, al")
    out("    ret")
    out(".lt_int:")
    out("    cmp rdi, rsi")
    out("    setl al")
    out("    movzx rax, al")
    out("    ret")

    // --- Smart greater-than ---
    out("")
    out_label("_nova_gt")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .gt_int")
    out("    cmp rsi, 0x" + PTR_THRESHOLD)
    out("    jl .gt_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_strcmp")
    out("    pop rbp")
    out("    test rax, rax")
    out("    setg al")
    out("    movzx rax, al")
    out("    ret")
    out(".gt_int:")
    out("    cmp rdi, rsi")
    out("    setg al")
    out("    movzx rax, al")
    out("    ret")

    // --- Smart less-equal ---
    out("")
    out_label("_nova_le")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .le_int")
    out("    cmp rsi, 0x" + PTR_THRESHOLD)
    out("    jl .le_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_strcmp")
    out("    pop rbp")
    out("    test rax, rax")
    out("    setle al")
    out("    movzx rax, al")
    out("    ret")
    out(".le_int:")
    out("    cmp rdi, rsi")
    out("    setle al")
    out("    movzx rax, al")
    out("    ret")

    // --- Smart greater-equal ---
    out("")
    out_label("_nova_ge")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .ge_int")
    out("    cmp rsi, 0x" + PTR_THRESHOLD)
    out("    jl .ge_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_strcmp")
    out("    pop rbp")
    out("    test rax, rax")
    out("    setge al")
    out("    movzx rax, al")
    out("    ret")
    out(".ge_int:")
    out("    cmp rdi, rsi")
    out("    setge al")
    out("    movzx rax, al")
    out("    ret")

    // --- String compare: returns -1, 0, or 1 ---
    out("")
    out_label("_nova_strcmp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out(".strcmp_loop:")
    out("    movzx eax, byte ptr [r12]")
    out("    movzx ecx, byte ptr [r13]")
    out("    test al, al")
    out("    jz .strcmp_end")
    out("    test cl, cl")
    out("    jz .strcmp_end")
    out("    cmp al, cl")
    out("    jne .strcmp_diff")
    out("    inc r12")
    out("    inc r13")
    out("    jmp .strcmp_loop")
    out(".strcmp_diff:")
    out("    sub rax, rcx")
    out("    pop r13")
    out("    pop r12")
    out("    ret")
    out(".strcmp_end:")
    out("    sub rax, rcx")
    out("    pop r13")
    out("    pop r12")
    out("    ret")

    // --- print_int ---
    out("")
    out_label("_nova_print_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rsi, rdi")
    out("    test rsi, rsi")
    out("    jnz .pi_nonzero")
    out("    mov byte ptr [rbp-1], 48")
    out("    lea rsi, [rbp-1]")
    out("    mov rdx, 1")
    out("    jmp .pi_write")
    out(".pi_nonzero:")
    out("    lea rdi, [rbp-1]")
    out("    xor ecx, ecx")
    out("    mov rax, rsi")
    out("    test rax, rax")
    out("    jns .pi_pos")
    out("    neg rax")
    out("    mov cl, 1")
    out(".pi_pos:")
    out(".pi_loop:")
    out("    test rax, rax")
    out("    jz .pi_done_digits")
    out("    xor edx, edx")
    out("    mov r8, 10")
    out("    div r8")
    out("    add dl, 48")
    out("    mov [rdi], dl")
    out("    dec rdi")
    out("    jmp .pi_loop")
    out(".pi_done_digits:")
    out("    test cl, cl")
    out("    jz .pi_no_sign")
    out("    mov byte ptr [rdi], 45")
    out("    dec rdi")
    out(".pi_no_sign:")
    out("    inc rdi")
    out("    lea rdx, [rbp-1]")
    out("    sub rdx, rdi")
    out("    inc rdx")
    out("    mov rsi, rdi")
    out(".pi_write:")
    if cg_target == 3 {
        out("    push rdx")
        out("    push rsi")
        out("    mov ecx, -11")
        win_call("GetStdHandle")
        out("    pop rsi")
        out("    pop rdx")
        out("    mov rcx, rax")
        out("    mov r8, rdx")
        out("    mov rdx, rsi")
        out("    lea r9, [rbp - 32]")
        out("    push 0")
        out("    sub rsp, 32")
        out("    call [rip + __imp_WriteFile]")
        out("    add rsp, 40")
    } else {
        out("    mov rdi, 1")
        emit_syscall(1)
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- print_str ---
    out("")
    out_label("_nova_print_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rsi, rdi")
    out("    xor edx, edx")
    out(".ps_len:")
    out("    cmp byte ptr [rsi + rdx], 0")
    out("    je .ps_write")
    out("    inc edx")
    out("    jmp .ps_len")
    out(".ps_write:")
    if cg_target == 3 {
        out("    push rdx")
        out("    push rsi")
        out("    mov ecx, -11")
        win_call("GetStdHandle")
        out("    pop rsi")
        out("    pop rdx")
        out("    sub rsp, 16")
        out("    mov rcx, rax")
        out("    mov r8, rdx")
        out("    mov rdx, rsi")
        out("    lea r9, [rsp]")
        out("    mov qword ptr [rsp + 8], 0")
        out("    push qword ptr [rsp + 8]")
        out("    sub rsp, 32")
        out("    call [rip + __imp_WriteFile]")
        out("    add rsp, 56")
    } else {
        out("    mov rdi, 1")
        emit_syscall(1)
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- println (print string + newline) ---
    out("")
    out_label("_nova_println")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rdi")
    out("    call _nova_print_str")
    out("    sub rsp, 8")
    out("    mov byte ptr [rsp], 10")
    out("    mov rsi, rsp")
    out("    mov rdx, 1")
    if cg_target == 3 {
        out("    push rdx")
        out("    push rsi")
        out("    mov ecx, -11")
        win_call("GetStdHandle")
        out("    pop rsi")
        out("    pop rdx")
        out("    mov rcx, rax")
        out("    mov r8, rdx")
        out("    mov rdx, rsi")
        out("    lea r9, [rbp - 16]")
        out("    push 0")
        out("    sub rsp, 32")
        out("    call [rip + __imp_WriteFile]")
        out("    add rsp, 40")
    } else {
        out("    mov rdi, 1")
        emit_syscall(1)
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- Heap allocator (brk-based bump allocator) ---
    out("")
    out_label("_nova_alloc")
    out("    push rbx")
    out("    mov rbx, rdi")
    out("    add rbx, 7")
    out("    and rbx, -8")
    out("    mov rax, [rip + _heap_ptr]")
    out("    test rax, rax")
    out("    jnz .alloc_have_heap")
    if cg_target == 3 {
        out("    xor ecx, ecx")
        out("    mov edx, 1048576")
        out("    mov r8d, 12288")
        out("    mov r9d, 4")
        win_call("VirtualAlloc")
    } else {
        if cg_target == 1 {
            out("    xor edi, edi")
            out("    mov rsi, 1048576")
            out("    mov rdx, 3")
            out("    mov r10, 4098")
            out("    mov r8, -1")
            out("    xor r9d, r9d")
            emit_syscall(9)
        } else {
            out("    mov rdi, 0")
            emit_syscall(12)
        }
    }
    out("    mov [rip + _heap_base], rax")
    out("    mov [rip + _heap_ptr], rax")
    if cg_target == 3 {
        out("    lea rax, [rax + 1048576]")
    } else {
        if cg_target == 1 {
            out("    lea rax, [rax + 1048576]")
        } else {
            out("    lea rdi, [rax + 1048576]")
            emit_syscall(12)
        }
    }
    out("    mov [rip + _heap_end], rax")
    out("    mov rax, [rip + _heap_ptr]")
    out(".alloc_have_heap:")
    out("    mov rcx, rax")
    out("    add rcx, rbx")
    out("    cmp rcx, [rip + _heap_end]")
    out("    jle .alloc_ok")
    if cg_target == 3 {
        out("    xor ecx, ecx")
        out("    mov edx, 1048576")
        out("    mov r8d, 12288")
        out("    mov r9d, 4")
        win_call("VirtualAlloc")
        out("    mov [rip + _heap_end], rax")
        out("    add qword ptr [rip + _heap_end], 1048576")
        out("    mov rax, [rip + _heap_ptr]")
    } else {
        if cg_target == 1 {
            out("    xor edi, edi")
            out("    mov rsi, 1048576")
            out("    mov rdx, 3")
            out("    mov r10, 4098")
            out("    mov r8, -1")
            out("    xor r9d, r9d")
            emit_syscall(9)
            out("    mov [rip + _heap_end], rax")
            out("    add qword ptr [rip + _heap_end], 1048576")
            out("    mov rax, [rip + _heap_ptr]")
        } else {
            out("    lea rdi, [rcx + 1048576]")
            emit_syscall(12)
            out("    mov [rip + _heap_end], rax")
            out("    mov rax, [rip + _heap_ptr]")
        }
    }
    out("    mov rcx, rax")
    out("    add rcx, rbx")
    out(".alloc_ok:")
    out("    mov [rip + _heap_ptr], rcx")
    out("    pop rbx")
    out("    ret")

    // --- strlen ---
    out("")
    out_label("_nova_strlen")
    out("    xor eax, eax")
    out("    test rdi, rdi")
    out("    jz .sl_done")
    out(".sl_loop:")
    out("    cmp byte ptr [rdi + rax], 0")
    out("    je .sl_done")
    out("    inc rax")
    out("    jmp .sl_loop")
    out(".sl_done:")
    out("    ret")

    // --- concat(a, b) -> new string ---
    out("")
    out_label("_nova_concat")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov r14, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    add r14, rax")
    out("    inc r14")
    out("    mov rdi, r14")
    out("    call _nova_alloc")
    out("    mov r14, rax")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out(".cc_copy1:")
    out("    lodsb")
    out("    test al, al")
    out("    jz .cc_copy2")
    out("    stosb")
    out("    jmp .cc_copy1")
    out(".cc_copy2:")
    out("    mov rsi, r13")
    out(".cc_copy2_loop:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .cc_copy2_loop")
    out("    mov rax, r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- int_to_str(n) -> string ---
    out("")
    out_label("_nova_int_to_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rax, rdi")
    out("    lea rsi, [rbp-1]")
    out("    mov byte ptr [rsi], 0")
    out("    xor ecx, ecx")
    out("    test rax, rax")
    out("    jnz .its_nonzero")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    jmp .its_copy")
    out(".its_nonzero:")
    out("    jns .its_pos")
    out("    neg rax")
    out("    mov cl, 1")
    out(".its_pos:")
    out(".its_digit_loop:")
    out("    test rax, rax")
    out("    jz .its_sign")
    out("    xor edx, edx")
    out("    mov r8, 10")
    out("    div r8")
    out("    add dl, 48")
    out("    dec rsi")
    out("    mov [rsi], dl")
    out("    jmp .its_digit_loop")
    out(".its_sign:")
    out("    test cl, cl")
    out("    jz .its_copy")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 45")
    out(".its_copy:")
    out("    mov rdi, rsi")
    out("    call _nova_strlen")
    out("    inc rax")
    out("    mov r12, rdi")
    out("    mov rdi, rax")
    out("    push r12")
    out("    call _nova_alloc")
    out("    pop rsi")
    out("    mov rdi, rax")
    out("    push rax")
    out(".its_cp:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .its_cp")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- str_eq(a, b) -> 1 or 0 ---
    out("")
    out_label("_nova_str_eq")
    out("    xor eax, eax")
    out(".se_loop:")
    out("    mov cl, [rdi]")
    out("    cmp cl, [rsi]")
    out("    jne .se_done")
    out("    test cl, cl")
    out("    jz .se_equal")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .se_loop")
    out(".se_equal:")
    out("    mov eax, 1")
    out(".se_done:")
    out("    ret")

    // --- list_new() -> ptr to [count, cap, items_ptr] ---
    out("")
    // List layout: [MAGIC=-1, count, cap, items_ptr] (32 bytes)
    out_label("_nova_list_new")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rdi, 32")
    out("    call _nova_alloc")
    out("    mov qword ptr [rax], -1")
    out("    mov qword ptr [rax+8], 0")
    out("    mov qword ptr [rax+16], 16")
    out("    push rax")
    out("    mov rdi, 128")
    out("    call _nova_alloc")
    out("    pop rcx")
    out("    mov [rcx+24], rax")
    out("    mov rax, rcx")
    out("    pop rbp")
    out("    ret")

    // --- push(list, val) --- list=[magic, count, cap, items]
    out("")
    out_label("_nova_push")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rax, [rdi+8]")
    out("    cmp rax, [rdi+16]")
    out("    jl .push_ok")
    out("    push rdi")
    out("    push rsi")
    out("    mov rcx, [rdi+16]")
    out("    shl rcx, 1")
    out("    mov [rdi+16], rcx")
    out("    shl rcx, 3")
    out("    push rdi")
    out("    mov rdi, rcx")
    out("    call _nova_alloc")
    out("    pop rdi")
    out("    mov rcx, rax")
    out("    mov r8, [rdi+24]")
    out("    mov r9, [rdi+8]")
    out("    xor r10d, r10d")
    out(".push_copy:")
    out("    cmp r10, r9")
    out("    jge .push_copy_done")
    out("    mov r11, [r8+r10*8]")
    out("    mov [rcx+r10*8], r11")
    out("    inc r10")
    out("    jmp .push_copy")
    out(".push_copy_done:")
    out("    mov [rdi+24], rcx")
    out("    pop rsi")
    out("    pop rdi")
    out(".push_ok:")
    out("    mov rax, [rdi+8]")
    out("    mov rcx, [rdi+24]")
    out("    mov [rcx+rax*8], rsi")
    out("    inc qword ptr [rdi+8]")
    out("    pop rbp")
    out("    ret")

    // --- len(list_or_str) -> count ---
    out("")
    out_label("_nova_len")
    out("    test rdi, rdi")
    out("    jz .len_zero")
    out("    cmp qword ptr [rdi], -1")
    out("    je .len_list")
    out("    xor eax, eax")
    out(".len_str_loop:")
    out("    cmp byte ptr [rdi + rax], 0")
    out("    je .len_done")
    out("    inc rax")
    out("    jmp .len_str_loop")
    out(".len_list:")
    out("    mov rax, [rdi+8]")
    out(".len_done:")
    out("    ret")
    out(".len_zero:")
    out("    xor eax, eax")
    out("    ret")

    // --- str_len(ptr): count bytes until null ---
    out("")
    out_label("_nova_str_len")
    out("    xor eax, eax")
    out(".strlen_loop:")
    out("    cmp byte ptr [rdi + rax], 0")
    out("    je .strlen_done")
    out("    inc rax")
    out("    jmp .strlen_loop")
    out(".strlen_done:")
    out("    ret")

    // --- exit(code) ---
    out("")
    out_label("_nova_exit")
    if cg_target == 3 {
        out("    mov ecx, edi")
        win_call("ExitProcess")
    } else {
        emit_syscall(60)
    }

    // --- read_file(path) -> string ptr or 0 ---
    out("")
    out_label("_nova_read_file")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    if cg_target == 3 {
        out("    sub rsp, 64")
        out("    mov rcx, rdi")
        out("    mov edx, -2147483648")
        out("    xor r8d, r8d")
        out("    xor r9d, r9d")
        out("    push 0")
        out("    push 128")
        out("    push 3")
        out("    sub rsp, 32")
        out("    call [rip + __imp_CreateFileA]")
        out("    add rsp, 56")
        out("    cmp rax, -1")
        out("    je .rf_fail")
        out("    mov r12, rax")
        out("    mov rdi, 524288")
        out("    call _nova_alloc")
        out("    mov [rbp - 24], rax")
        out("    mov rcx, r12")
        out("    mov rdx, rax")
        out("    mov r8d, 524287")
        out("    lea r9, [rbp - 32]")
        out("    push 0")
        out("    sub rsp, 32")
        out("    call [rip + __imp_ReadFile]")
        out("    add rsp, 40")
        out("    mov rsi, [rbp - 24]")
        out("    mov eax, [rbp - 32]")
        out("    mov byte ptr [rsi + rax], 0")
        out("    mov rcx, r12")
        win_call("CloseHandle")
        out("    mov rax, [rbp - 24]")
        out("    add rsp, 64")
    } else {
        out("    mov rsi, 0")
        emit_syscall(2)
        out("    cmp rax, 0")
        out("    jl .rf_fail")
        out("    mov r12, rax")
        out("    mov rdi, 524288")
        out("    call _nova_alloc")
        out("    push rax")
        out("    mov rdi, r12")
        out("    mov rsi, rax")
        out("    mov rdx, 524287")
        emit_syscall(0)
        out("    pop rsi")
        out("    mov byte ptr [rsi+rax], 0")
        out("    mov rdi, r12")
        out("    push rsi")
        emit_syscall(3)
        out("    pop rax")
    }
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".rf_fail:")
    out("    xor eax, eax")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- write_file(path, data) -> 1 or 0 ---
    out("")
    out_label("_nova_write_file")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r13, rsi")
    if cg_target == 3 {
        out("    sub rsp, 64")
        out("    mov rcx, rdi")
        out("    mov edx, 1073741824")
        out("    xor r8d, r8d")
        out("    xor r9d, r9d")
        out("    push 0")
        out("    push 128")
        out("    push 2")
        out("    sub rsp, 32")
        out("    call [rip + __imp_CreateFileA]")
        out("    add rsp, 56")
        out("    cmp rax, -1")
        out("    je .wf_fail")
        out("    mov r12, rax")
        out("    mov rdi, r13")
        out("    call _nova_strlen")
        out("    mov rcx, r12")
        out("    mov rdx, r13")
        out("    mov r8, rax")
        out("    lea r9, [rbp - 24]")
        out("    push 0")
        out("    sub rsp, 32")
        out("    call [rip + __imp_WriteFile]")
        out("    add rsp, 40")
        out("    mov rcx, r12")
        win_call("CloseHandle")
        out("    mov rax, 1")
        out("    add rsp, 64")
    } else {
        out("    mov rsi, 577")
        out("    mov rdx, 420")
        emit_syscall(2)
        out("    cmp rax, 0")
        out("    jl .wf_fail")
        out("    mov r12, rax")
        out("    mov rdi, r13")
        out("    call _nova_strlen")
        out("    mov rdx, rax")
        out("    mov rdi, r12")
        out("    mov rsi, r13")
        emit_syscall(1)
        out("    mov rdi, r12")
        emit_syscall(3)
        out("    mov rax, 1")
    }
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".wf_fail:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- index(obj, idx): list[idx] or str[idx] -> char code ---
    out("")
    out_label("_nova_index")
    out("    test rdi, rdi")
    out("    jz .idx_null")
    out("    cmp qword ptr [rdi], -1")
    out("    je .idx_list")
    out("    test rsi, rsi")
    out("    jns .idx_str_positive")
    out("    push rdi")
    out("    push rsi")
    out("    call _nova_strlen")
    out("    pop rsi")
    out("    pop rdi")
    out("    add rsi, rax")
    out("    test rsi, rsi")
    out("    jl .idx_oob")
    out(".idx_str_positive:")
    out("    movzx eax, byte ptr [rdi + rsi]")
    out("    ret")
    out(".idx_list:")
    out("    // Handle negative index")
    out("    test rsi, rsi")
    out("    jns .idx_list_positive")
    out("    add rsi, [rdi + 8]")
    out("    test rsi, rsi")
    out("    jl .idx_oob")
    out(".idx_list_positive:")
    out("    cmp rsi, [rdi + 8]")
    out("    jge .idx_oob")
    out("    mov rax, [rdi + 24]")
    out("    mov rax, [rax + rsi*8]")
    out("    ret")
    out(".idx_null:")
    out("    lea rdi, [rip + _err_null_access]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    call _nova_exit")
    out(".idx_oob:")
    out("    push rsi")
    out("    lea rdi, [rip + _err_index_oob]")
    out("    call _nova_print_str")
    out("    pop rdi")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _err_newline]")
    out("    call _nova_print_str")
    out("    mov rdi, 1")
    out("    call _nova_exit")

    // --- chr(code) -> 1-char string ---
    out("")
    out_label("_nova_chr")
    out("    push rdi")
    out("    mov rdi, 2")
    out("    call _nova_alloc")
    out("    pop rcx")
    out("    mov [rax], cl")
    out("    mov byte ptr [rax+1], 0")
    out("    ret")

    // --- char_at(str, idx) -> char code ---
    out("")
    out_label("_nova_char_at")
    out("    movzx eax, byte ptr [rdi + rsi]")
    out("    ret")

    // --- substr(str, start, len) -> new string ---
    out("")
    out_label("_nova_substr")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    lea r12, [rdi + rsi]")
    out("    mov r13, rdx")
    out("    lea rdi, [rdx + 1]")
    out("    call _nova_alloc")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out("    mov rcx, r13")
    out("    rep movsb")
    out("    mov byte ptr [rdi], 0")
    out("    sub rdi, r13")
    out("    mov rax, rdi")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_to_int(str) -> int ---
    out("")
    out_label("_nova_str_to_int")
    out("    xor eax, eax")
    out("    xor ecx, ecx")
    out("    cmp byte ptr [rdi], 45")
    out("    jne .sti_loop")
    out("    mov cl, 1")
    out("    inc rdi")
    out(".sti_loop:")
    out("    movzx edx, byte ptr [rdi]")
    out("    sub edx, 48")
    out("    cmp edx, 9")
    out("    ja .sti_done")
    out("    imul rax, 10")
    out("    add rax, rdx")
    out("    inc rdi")
    out("    jmp .sti_loop")
    out(".sti_done:")
    out("    test cl, cl")
    out("    jz .sti_ret")
    out("    neg rax")
    out(".sti_ret:")
    out("    ret")

    // --- __arg(n) -> string or "" ---
    out("")
    out_label("_nova___arg")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    inc rdi")
    out("    cmp rdi, [rip + _g___argc]")
    out("    jge .arg_empty")
    out("    mov rax, [rip + _g___argv]")
    out("    mov rax, [rax + rdi*8]")
    out("    pop rbp")
    out("    ret")
    out(".arg_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop rbp")
    out("    ret")

    // --- pop(list) -> removes and returns last element ---
    out("")
    out_label("_nova_pop")
    out("    mov rax, [rdi+8]")
    out("    test rax, rax")
    out("    jz .pop_empty")
    out("    dec rax")
    out("    mov [rdi+8], rax")
    out("    mov rcx, [rdi+24]")
    out("    mov rax, [rcx+rax*8]")
    out("    ret")
    out(".pop_empty:")
    out("    xor eax, eax")
    out("    ret")

    // --- list_set(list, idx, val) -> sets list[idx] = val ---
    out("")
    out_label("_nova_list_set")
    out("    mov rax, [rdi+24]")
    out("    mov [rax+rsi*8], rdx")
    out("    ret")

    // --- contains(list_or_str, val) -> 1 if found, 0 if not ---
    out("")
    out_label("_nova_contains")
    out("    cmp qword ptr [rdi], -2")
    out("    je .contains_is_map")
    out("    cmp qword ptr [rdi], -1")
    out("    je .contains_is_list")
    out("    call _nova_str_find")
    out("    cmp rax, 0")
    out("    jl .contains_str_no")
    out("    mov eax, 1")
    out("    ret")
    out(".contains_str_no:")
    out("    xor eax, eax")
    out("    ret")
    out(".contains_is_map:")
    out("    jmp _nova_map_has")
    out(".contains_is_list:")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, [rdi+8]")
    out("    xor ecx, ecx")
    out(".contains_loop:")
    out("    cmp rcx, r14")
    out("    jge .contains_not_found")
    out("    mov rax, [r12+24]")
    out("    mov rdi, [rax+rcx*8]")
    out("    mov rsi, r13")
    out("    push rcx")
    out("    call _nova_eq")
    out("    pop rcx")
    out("    test rax, rax")
    out("    jnz .contains_found")
    out("    inc rcx")
    out("    jmp .contains_loop")
    out(".contains_found:")
    out("    mov eax, 1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".contains_not_found:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_remove(list, idx) -> removes element at idx, shifts remaining left ---
    out("")
    out_label("_nova_list_remove")
    out("    mov rax, [rdi+8]")
    out("    mov rcx, [rdi+24]")
    out("    mov r8, rsi")
    out(".lr_shift:")
    out("    lea r9, [r8+1]")
    out("    cmp r9, rax")
    out("    jge .lr_done")
    out("    mov r10, [rcx+r9*8]")
    out("    mov [rcx+r8*8], r10")
    out("    inc r8")
    out("    jmp .lr_shift")
    out(".lr_done:")
    out("    dec qword ptr [rdi+8]")
    out("    ret")

    // --- starts_with(str, prefix) -> 1 or 0 ---
    out("")
    out_label("_nova_starts_with")
    out("    xor eax, eax")
    out(".sw_loop:")
    out("    mov cl, [rsi]")
    out("    test cl, cl")
    out("    jz .sw_yes")
    out("    cmp cl, [rdi]")
    out("    jne .sw_no")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .sw_loop")
    out(".sw_yes:")
    out("    mov eax, 1")
    out(".sw_no:")
    out("    ret")

    // --- ends_with(str, suffix) -> 1 or 0 ---
    out("")
    out_label("_nova_ends_with")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov rcx, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    cmp rax, rcx")
    out("    ja .ew_no")
    out("    lea rdi, [r12+rcx]")
    out("    sub rdi, rax")
    out("    mov rsi, r13")
    out(".ew_loop:")
    out("    mov cl, [rsi]")
    out("    test cl, cl")
    out("    jz .ew_yes")
    out("    cmp cl, [rdi]")
    out("    jne .ew_no")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .ew_loop")
    out(".ew_yes:")
    out("    mov eax, 1")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ew_no:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_find(haystack, needle) -> index or -1 ---
    out("")
    out_label("_nova_str_find")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov r14, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    mov rcx, rax")
    out("    test rcx, rcx")
    out("    jz .sf_found_zero")
    out("    xor r8d, r8d")
    out(".sf_outer:")
    out("    lea rax, [r8+rcx]")
    out("    cmp rax, r14")
    out("    ja .sf_not_found")
    out("    xor r9d, r9d")
    out(".sf_inner:")
    out("    cmp r9, rcx")
    out("    jge .sf_found")
    out("    lea rax, [r12+r8]")
    out("    movzx edx, byte ptr [rax+r9]")
    out("    cmp dl, [r13+r9]")
    out("    jne .sf_next")
    out("    inc r9")
    out("    jmp .sf_inner")
    out(".sf_next:")
    out("    inc r8")
    out("    jmp .sf_outer")
    out(".sf_found:")
    out("    mov rax, r8")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".sf_found_zero:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".sf_not_found:")
    out("    mov rax, -1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- abs(n) -> absolute value ---
    out("")
    out_label("_nova_abs")
    out("    mov rax, rdi")
    out("    test rdi, rdi")
    out("    jns .abs_done")
    out("    neg rax")
    out(".abs_done:")
    out("    ret")

    // --- min(a, b) -> smaller value ---
    out("")
    out_label("_nova_min")
    out("    cmp rdi, rsi")
    out("    cmovle rax, rdi")
    out("    cmovg rax, rsi")
    out("    ret")

    // --- max(a, b) -> larger value ---
    out("")
    out_label("_nova_max")
    out("    cmp rdi, rsi")
    out("    cmovge rax, rdi")
    out("    cmovl rax, rsi")
    out("    ret")

    // --- time() -> current epoch seconds ---
    out("")
    out_label("_nova_time")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    if cg_target == 3 {
        out("    lea rcx, [rbp - 16]")
        win_call("GetSystemTimeAsFileTime")
        out("    mov rax, [rbp - 16]")
        out("    mov rcx, 10000000")
        out("    xor edx, edx")
        out("    div rcx")
        out("    mov rcx, 11644473600")
        out("    sub rax, rcx")
    } else {
        out("    xor edi, edi")
        out("    lea rsi, [rbp - 16]")
        emit_syscall(228)
        out("    mov rax, [rbp - 16]")
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- sleep_ms(milliseconds) -> 0 ---
    out("")
    out_label("_nova_sleep_ms")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    if cg_target == 3 {
        out("    mov rcx, rdi")
        win_call("Sleep")
    } else {
        out("    mov rax, rdi")
        out("    xor edx, edx")
        out("    mov rcx, 1000")
        out("    div rcx")
        if cg_target == 1 {
            out("    mov [rbp - 16], rax")
            out("    imul rdx, rdx, 1000")
            out("    mov [rbp - 8], rdx")
            out("    xor edi, edi")
            out("    xor esi, esi")
            out("    xor edx, edx")
            out("    xor r10d, r10d")
            out("    lea r8, [rbp - 16]")
            emit_syscall(93)
        } else {
            out("    mov [rbp - 16], rax")
            out("    imul rdx, rdx, 1000000")
            out("    mov [rbp - 8], rdx")
            out("    lea rdi, [rbp - 16]")
            out("    xor esi, esi")
            emit_syscall(35)
        }
    }
    out("    xor eax, eax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- mkdir(path) -> 0 on success, -1 on error ---
    out("")
    out_label("_nova_mkdir")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov rcx, rdi")
        out("    xor edx, edx")
        win_call("CreateDirectoryA")
        out("    test eax, eax")
        out("    jz .mkdir_fail")
        out("    xor eax, eax")
        out("    pop rbp")
        out("    ret")
        out(".mkdir_fail:")
        out("    mov rax, -1")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    mov rsi, 493")
        emit_syscall(83)
        out("    ret")
    }

    // --- unlink(path) -> 0 on success, -1 on error ---
    out("")
    out_label("_nova_unlink")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov rcx, rdi")
        win_call("DeleteFileA")
        out("    test eax, eax")
        out("    jz .unlink_fail")
        out("    xor eax, eax")
        out("    pop rbp")
        out("    ret")
        out(".unlink_fail:")
        out("    mov rax, -1")
        out("    pop rbp")
        out("    ret")
    } else {
        emit_syscall(87)
        out("    ret")
    }

    // --- file_size(path) -> size in bytes or -1 ---
    out("")
    out_label("_nova_file_size")
    out("    push rbp")
    out("    mov rbp, rsp")
    if cg_target == 3 {
        out("    sub rsp, 64")
        out("    mov rcx, rdi")
        out("    mov edx, -2147483648")
        out("    xor r8d, r8d")
        out("    xor r9d, r9d")
        out("    push 0")
        out("    push 128")
        out("    push 3")
        out("    sub rsp, 32")
        out("    call [rip + __imp_CreateFileA]")
        out("    add rsp, 56")
        out("    cmp rax, -1")
        out("    je .fs_fail")
        out("    mov [rbp - 8], rax")
        out("    mov rcx, rax")
        out("    lea rdx, [rbp - 16]")
        win_call("GetFileSizeEx")
        out("    mov rcx, [rbp - 8]")
        out("    push qword ptr [rbp - 16]")
        win_call("CloseHandle")
        out("    pop rax")
        out("    add rsp, 64")
    } else {
        out("    sub rsp, 160")
        out("    lea rsi, [rbp - 160]")
        emit_syscall(4)
        out("    cmp rax, 0")
        out("    jl .fs_fail")
        if cg_target == 1 {
            out("    mov rax, [rbp - 160 + 96]")
        } else {
            out("    mov rax, [rbp - 160 + 48]")
        }
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")
    out(".fs_fail:")
    out("    mov rax, -1")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- socket(domain, type, protocol) -> fd ---
    out("")
    out_label("_nova_socket")
    if cg_target == 3 { out("    mov rax, -1") } else { emit_syscall(41) }
    out("    ret")

    // --- bind(fd, addr, addrlen) -> 0 or error ---
    out("")
    out_label("_nova_bind")
    if cg_target == 3 { out("    mov rax, -1") } else { emit_syscall(49) }
    out("    ret")

    // --- listen(fd, backlog) -> 0 or error ---
    out("")
    out_label("_nova_listen")
    if cg_target == 3 { out("    mov rax, -1") } else { emit_syscall(50) }
    out("    ret")

    // --- accept(fd, addr, addrlen) -> new fd ---
    out("")
    out_label("_nova_accept")
    if cg_target == 3 { out("    mov rax, -1") } else { emit_syscall(43) }
    out("    ret")

    // --- connect(fd, addr, addrlen) -> 0 or error ---
    out("")
    out_label("_nova_connect")
    if cg_target == 3 { out("    mov rax, -1") } else { emit_syscall(42) }
    out("    ret")

    // --- send_data(fd, buf, len) -> bytes sent ---
    out("")
    out_label("_nova_send_data")
    if cg_target == 3 { out("    mov rax, -1") } else { emit_syscall(1) }
    out("    ret")

    // --- recv_data(fd, buf, len) -> bytes received ---
    out("")
    out_label("_nova_recv_data")
    if cg_target == 3 { out("    mov rax, -1") } else { emit_syscall(0) }
    out("    ret")

    // --- close_fd(fd) -> 0 or error ---
    out("")
    out_label("_nova_close_fd")
    if cg_target == 3 {
        out("    mov rcx, rdi")
        win_call("CloseHandle")
    } else {
        emit_syscall(3)
    }
    out("    ret")

    // --- make_sockaddr_in(port, ip_addr) -> pointer to sockaddr_in struct ---
    out("")
    out_label("_nova_make_sockaddr_in")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rdi, 16")
    out("    call _nova_alloc")
    out("    mov word ptr [rax], 2")
    out("    mov rcx, r12")
    out("    xchg cl, ch")
    out("    mov [rax + 2], cx")
    out("    mov [rax + 4], r13d")
    out("    mov qword ptr [rax + 8], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- fork() -> pid (0 in child, >0 in parent) ---
    out("")
    out_label("_nova_fork")
    if cg_target == 3 { out("    mov rax, -1") } else { emit_syscall(57) }
    out("    ret")

    // --- waitpid(pid) -> exit status ---
    out("")
    out_label("_nova_waitpid")
    if cg_target == 3 {
        out("    mov rax, -1")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 16")
        out("    lea rsi, [rbp - 8]")
        out("    xor edx, edx")
        out("    xor r10d, r10d")
        emit_syscall(61)
        out("    mov eax, [rbp - 8]")
        out("    shr eax, 8")
        out("    and eax, 255")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
    }

    // --- exec(path, argv) -> doesn't return on success ---
    out("")
    out_label("_nova_exec")
    if cg_target == 3 { out("    mov rax, -1") } else { out("    mov rdx, 0"); emit_syscall(59) }
    out("    ret")

    // --- pipe() -> list of [read_fd, write_fd] ---
    out("")
    out_label("_nova_pipe")
    if cg_target == 3 {
        out("    call _nova_list_new")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 16")
        out("    lea rdi, [rbp - 8]")
        emit_syscall(22)
        out("    call _nova_list_new")
        out("    push rax")
        out("    mov edi, [rbp - 8]")
        out("    movsx rdi, edi")
        out("    mov rsi, rdi")
        out("    mov rdi, [rsp]")
        out("    call _nova_push")
        out("    mov edi, [rbp - 4]")
        out("    movsx rdi, edi")
        out("    mov rsi, rdi")
        out("    mov rdi, [rsp]")
        out("    call _nova_push")
        out("    pop rax")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
    }

    // --- Coroutine support ---
    // Context layout (80 bytes):
    //   0: rsp, 8: rbp, 16: rbx, 24: r12, 32: r13, 40: r14, 48: r15
    //   56: state (0=ready,1=running,2=suspended,3=done)
    //   64: stack_base, 72: result
    out("")
    out_label("_nova_coro_new")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rdi, 65536")
    out("    call _nova_alloc")
    out("    mov r14, rax")
    out("    mov rdi, 80")
    out("    call _nova_alloc")
    out("    push rax")
    out("    lea rcx, [r14 + 65536]")
    out("    sub rcx, 8")
    out("    mov qword ptr [rcx], 0")
    out("    sub rcx, 8")
    out("    mov [rcx], r13")
    out("    sub rcx, 8")
    out("    mov [rcx], r12")
    out("    sub rcx, 8")
    out("    lea rdx, [rip + _nova_coro_entry]")
    out("    mov [rcx], rdx")
    out("    pop rax")
    out("    mov [rax], rcx")
    out("    mov [rax + 8], rcx")
    out("    mov qword ptr [rax + 16], 0")
    out("    mov qword ptr [rax + 24], 0")
    out("    mov qword ptr [rax + 32], 0")
    out("    mov qword ptr [rax + 40], 0")
    out("    mov qword ptr [rax + 48], 0")
    out("    mov qword ptr [rax + 56], 0")
    out("    mov [rax + 64], r14")
    out("    mov qword ptr [rax + 72], 0")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    out("")
    out_label("_nova_coro_entry")
    out("    pop r12")
    out("    pop rdi")
    out("    call r12")
    out("    mov rcx, [rip + _current_coro]")
    out("    mov [rcx + 72], rax")
    out("    mov qword ptr [rcx + 56], 3")
    out("    mov rsp, [rip + _main_coro_ctx]")
    out("    mov rbp, [rip + _main_coro_ctx + 8]")
    out("    mov rbx, [rip + _main_coro_ctx + 16]")
    out("    mov r12, [rip + _main_coro_ctx + 24]")
    out("    mov r13, [rip + _main_coro_ctx + 32]")
    out("    mov r14, [rip + _main_coro_ctx + 40]")
    out("    mov r15, [rip + _main_coro_ctx + 48]")
    out("    mov rax, [rcx + 72]")
    out("    ret")

    out("")
    out_label("_nova_coro_resume")
    out("    mov [rip + _main_coro_ctx], rsp")
    out("    mov [rip + _main_coro_ctx + 8], rbp")
    out("    mov [rip + _main_coro_ctx + 16], rbx")
    out("    mov [rip + _main_coro_ctx + 24], r12")
    out("    mov [rip + _main_coro_ctx + 32], r13")
    out("    mov [rip + _main_coro_ctx + 40], r14")
    out("    mov [rip + _main_coro_ctx + 48], r15")
    out("    mov [rip + _current_coro], rdi")
    out("    mov rsp, [rdi]")
    out("    mov rbp, [rdi + 8]")
    out("    mov rbx, [rdi + 16]")
    out("    mov r12, [rdi + 24]")
    out("    mov r13, [rdi + 32]")
    out("    mov r14, [rdi + 40]")
    out("    mov r15, [rdi + 48]")
    out("    mov qword ptr [rdi + 56], 1")
    out("    ret")

    out("")
    out_label("_nova_coro_yield")
    out("    mov rax, [rip + _current_coro]")
    out("    mov [rax], rsp")
    out("    mov [rax + 8], rbp")
    out("    mov [rax + 16], rbx")
    out("    mov [rax + 24], r12")
    out("    mov [rax + 32], r13")
    out("    mov [rax + 40], r14")
    out("    mov [rax + 48], r15")
    out("    mov qword ptr [rax + 56], 2")
    out("    mov [rax + 72], rdi")
    out("    mov rsp, [rip + _main_coro_ctx]")
    out("    mov rbp, [rip + _main_coro_ctx + 8]")
    out("    mov rbx, [rip + _main_coro_ctx + 16]")
    out("    mov r12, [rip + _main_coro_ctx + 24]")
    out("    mov r13, [rip + _main_coro_ctx + 32]")
    out("    mov r14, [rip + _main_coro_ctx + 40]")
    out("    mov r15, [rip + _main_coro_ctx + 48]")
    out("    mov rax, rdi")
    out("    ret")

    out("")
    out_label("_nova_coro_done")
    out("    mov rax, [rdi + 56]")
    out("    cmp rax, 3")
    out("    je .coro_done_yes")
    out("    xor eax, eax")
    out("    ret")
    out(".coro_done_yes:")
    out("    mov eax, 1")
    out("    ret")

    out("")
    out_label("_nova_coro_result")
    out("    mov rax, [rdi + 72]")
    out("    ret")

    out("")
    out_label("_nova_coro_state")
    out("    mov rax, [rdi + 56]")
    out("    ret")

    // --- Division by zero handler ---
    out("")
    out_label("_div_zero_handler")
    out("    lea rdi, [rip + _err_div_zero]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    call _nova_exit")

    // --- _nova_throw_impl: dynamic exception dispatch ---
    out("")
    out_label("_nova_throw_impl")
    out("    mov [rip + _nova_error_value], rdi")
    out("    mov qword ptr [rip + _nova_error_flag], 1")
    out("    mov rcx, [rip + _nova_catch_stack]")
    out("    test rcx, rcx")
    out("    jz .throw_no_handler")
    out("    mov rbp, [rcx + 8]")
    out("    mov rsp, [rcx + 16]")
    out("    mov rax, [rcx + 24]")
    out("    mov rcx, [rcx]")
    out("    mov [rip + _nova_catch_stack], rcx")
    out("    jmp rax")
    out(".throw_no_handler:")
    out("    lea rdi, [rip + _err_uncaught]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    call _nova_exit")

    // --- assert(condition, message) ---
    out("")
    out_label("_nova_assert")
    out("    test rdi, rdi")
    out("    jnz .assert_ok")
    out("    push rsi")
    out("    lea rdi, [rip + _err_assert_prefix]")
    out("    call _nova_print_str")
    out("    pop rdi")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    call _nova_exit")
    out(".assert_ok:")
    out("    ret")

    // --- type_of(value) -> int (0=null, 1=int, 2=string, 3=list, 4=map) ---
    out("")
    out_label("_nova_type_of")
    out("    test rdi, rdi")
    out("    jz .to_null")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .to_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .to_list")
    out("    cmp qword ptr [rdi], -2")
    out("    je .to_map")
    out("    mov eax, 2")
    out("    ret")
    out(".to_null:")
    out("    xor eax, eax")
    out("    ret")
    out(".to_int:")
    out("    mov eax, 1")
    out("    ret")
    out(".to_list:")
    out("    mov eax, 3")
    out("    ret")
    out(".to_map:")
    out("    mov eax, 4")
    out("    ret")

    // --- type_name(value) -> string ---
    out("")
    out_label("_nova_type_name")
    out("    test rdi, rdi")
    out("    jz .tn_none")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .tn_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .tn_list")
    out("    cmp qword ptr [rdi], -2")
    out("    je .tn_map")
    out("    lea rax, [rip + _tn_str]")
    out("    ret")
    out(".tn_none:")
    out("    lea rax, [rip + _tn_none]")
    out("    ret")
    out(".tn_int:")
    out("    lea rax, [rip + _tn_int]")
    out("    ret")
    out(".tn_list:")
    out("    lea rax, [rip + _tn_list]")
    out("    ret")
    out(".tn_map:")
    out("    lea rax, [rip + _tn_map]")
    out("    ret")

    // --- debug_print(label, value) ---
    out("")
    out_label("_nova_debug_print")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    mov r12, rsi")
    out("    call _nova_print_str")
    out("    lea rdi, [rip + _debug_sep]")
    out("    call _nova_print_str")
    out("    mov rdi, r12")
    out("    test rdi, rdi")
    out("    jz .dp_null")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .dp_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .dp_list")
    out("    call _nova_println")
    out("    jmp .dp_done")
    out(".dp_null:")
    out("    lea rdi, [rip + _debug_null]")
    out("    call _nova_println")
    out("    jmp .dp_done")
    out(".dp_int:")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _err_newline]")
    out("    call _nova_print_str")
    out("    jmp .dp_done")
    out(".dp_list:")
    out("    lea rdi, [rip + _debug_list_prefix]")
    out("    call _nova_print_str")
    out("    mov rdi, r12")
    out("    mov rdi, [rdi + 8]")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _debug_list_suffix]")
    out("    call _nova_println")
    out(".dp_done:")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- hex(n) -> hex string with "0x" prefix ---
    out("")
    out_label("_nova_hex")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rax, rdi")
    out("    lea rsi, [rbp - 1]")
    out("    mov byte ptr [rsi], 0")
    out("    test rax, rax")
    out("    jnz .hex_nonzero")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    jmp .hex_prefix")
    out(".hex_nonzero:")
    out(".hex_loop:")
    out("    test rax, rax")
    out("    jz .hex_prefix")
    out("    mov rcx, rax")
    out("    and rcx, 0xF")
    out("    cmp rcx, 10")
    out("    jl .hex_digit")
    out("    add cl, 87")
    out("    jmp .hex_store")
    out(".hex_digit:")
    out("    add cl, 48")
    out(".hex_store:")
    out("    dec rsi")
    out("    mov [rsi], cl")
    out("    shr rax, 4")
    out("    jmp .hex_loop")
    out(".hex_prefix:")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 120")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    mov rdi, rsi")
    out("    call _nova_strlen")
    out("    inc rax")
    out("    mov r12, rdi")
    out("    mov rdi, rax")
    out("    push r12")
    out("    call _nova_alloc")
    out("    pop rsi")
    out("    mov rdi, rax")
    out("    push rax")
    out(".hex_cp:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .hex_cp")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- read_line() -> string (read line from stdin) ---
    out("")
    out_label("_nova_read_line")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov rdi, 1024")
    out("    call _nova_alloc")
    out("    mov r12, rax")
    out("    xor r13d, r13d")
    out(".rl_loop:")
    if cg_target == 3 {
        out("    sub rsp, 48")
        out("    mov ecx, -10")
        win_call("GetStdHandle")
        out("    mov rcx, rax")
        out("    lea rdx, [r12 + r13]")
        out("    mov r8d, 1")
        out("    lea r9, [rbp - 24]")
        out("    push 0")
        out("    sub rsp, 32")
        out("    call [rip + __imp_ReadFile]")
        out("    add rsp, 40")
        out("    movzx eax, byte ptr [rbp - 24]")
        out("    add rsp, 48")
    } else {
        out("    xor edi, edi")
        out("    lea rsi, [r12 + r13]")
        out("    mov rdx, 1")
        emit_syscall(0)
    }
    out("    cmp rax, 0")
    out("    jle .rl_done")
    out("    movzx eax, byte ptr [r12 + r13]")
    out("    cmp al, 10")
    out("    je .rl_done")
    out("    inc r13")
    out("    cmp r13, 1023")
    out("    jl .rl_loop")
    out(".rl_done:")
    out("    mov byte ptr [r12 + r13], 0")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- read_stdin(n) -> string (read n bytes from stdin) ---
    out("")
    out_label("_nova_read_stdin")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r13, rdi")
    out("    lea rdi, [r13 + 1]")
    out("    call _nova_alloc")
    out("    mov r12, rax")
    if cg_target == 3 {
        out("    sub rsp, 48")
        out("    mov ecx, -10")
        win_call("GetStdHandle")
        out("    mov rcx, rax")
        out("    mov rdx, r12")
        out("    mov r8, r13")
        out("    lea r9, [rbp - 24]")
        out("    push 0")
        out("    sub rsp, 32")
        out("    call [rip + __imp_ReadFile]")
        out("    add rsp, 40")
        out("    mov eax, [rbp - 24]")
        out("    add rsp, 48")
    } else {
        out("    xor edi, edi")
        out("    mov rsi, r12")
        out("    mov rdx, r13")
        emit_syscall(0)
    }
    out("    cmp rax, 0")
    out("    jl .rs_fail")
    out("    mov byte ptr [r12 + rax], 0")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".rs_fail:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- getenv(name) -> string or 0 ---
    out("")
    out_label("_nova_getenv")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_strlen")
    out("    mov r13, rax")
    out("    mov rdi, [rip + _g___envp]")
    out("    test rdi, rdi")
    out("    jz .ge_not_found")
    out(".ge_loop:")
    out("    mov rsi, [rdi]")
    out("    test rsi, rsi")
    out("    jz .ge_not_found")
    out("    push rdi")
    out("    mov rdi, r12")
    out("    mov rcx, r13")
    out("    xor eax, eax")
    out(".ge_cmp:")
    out("    test rcx, rcx")
    out("    jz .ge_check_eq")
    out("    movzx edx, byte ptr [rdi + rax]")
    out("    cmp dl, [rsi + rax]")
    out("    jne .ge_next")
    out("    inc rax")
    out("    dec rcx")
    out("    jmp .ge_cmp")
    out(".ge_check_eq:")
    out("    cmp byte ptr [rsi + r13], 61")
    out("    jne .ge_next")
    out("    lea rax, [rsi + r13 + 1]")
    out("    pop rdi")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ge_next:")
    out("    pop rdi")
    out("    add rdi, 8")
    out("    jmp .ge_loop")
    out(".ge_not_found:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- random(max) -> pseudo-random integer 0 to max-1 ---
    out("")
    out_label("_nova_random")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, rdi")
    out("    mov rax, [rip + _rand_state]")
    out("    test rax, rax")
    out("    jnz .rand_have_seed")
    out("    sub rsp, 16")
    if cg_target == 3 {
        out("    lea rcx, [rsp]")
        win_call("GetSystemTimeAsFileTime")
        out("    mov rax, [rsp]")
    } else {
        out("    xor edi, edi")
        out("    lea rsi, [rsp]")
        emit_syscall(228)
        out("    mov rax, [rsp]")
        out("    xor rax, [rsp + 8]")
    }
    out("    add rsp, 16")
    out("    test rax, rax")
    out("    jnz .rand_have_seed")
    out("    mov rax, 0x123456789ABCDEF0")
    out(".rand_have_seed:")
    out("    mov rdx, rax")
    out("    shl rdx, 13")
    out("    xor rax, rdx")
    out("    mov rdx, rax")
    out("    shr rdx, 7")
    out("    xor rax, rdx")
    out("    mov rdx, rax")
    out("    shl rdx, 17")
    out("    xor rax, rdx")
    out("    mov [rip + _rand_state], rax")
    out("    test rax, rax")
    out("    jns .rand_pos")
    out("    neg rax")
    out(".rand_pos:")
    out("    xor edx, edx")
    out("    div rcx")
    out("    mov rax, rdx")
    out("    pop rbp")
    out("    ret")

    // --- random_seed(n) -> set PRNG seed ---
    out("")
    out_label("_nova_random_seed")
    out("    mov [rip + _rand_state], rdi")
    out("    ret")

    // --- map_new() -> map pointer ---
    // Map layout: [magic=-2, count, capacity, entries_ptr] (32 bytes)
    // Entry layout: [key, value, occupied] = 24 bytes per entry
    out("")
    out_label("_nova_map_new")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rdi, 32")
    out("    call _nova_alloc")
    out("    mov qword ptr [rax], -2")
    out("    mov qword ptr [rax + 8], 0")
    out("    mov qword ptr [rax + 16], 16")
    out("    push rax")
    out("    mov rdi, 384")
    out("    call _nova_alloc")
    out("    mov rdi, rax")
    out("    mov rcx, 48")
    out("    xor eax, eax")
    out("    rep stosq")
    out("    mov rax, rdi")
    out("    sub rax, 384")
    out("    pop rcx")
    out("    mov [rcx + 24], rax")
    out("    mov rax, rcx")
    out("    pop rbp")
    out("    ret")

    // --- _nova_hash_key(key in rdi) -> hash in rax ---
    out("")
    out_label("_nova_hash_key")
    out("    mov rax, rdi")
    out("    cmp rax, 0x" + PTR_THRESHOLD)
    out("    jl .hk_int")
    out("    xor eax, eax")
    out(".hk_str_loop:")
    out("    movzx ecx, byte ptr [rdi]")
    out("    test cl, cl")
    out("    jz .hk_done")
    out("    imul rax, 31")
    out("    add rax, rcx")
    out("    inc rdi")
    out("    jmp .hk_str_loop")
    out(".hk_int:")
    out("    test rax, rax")
    out("    jns .hk_done")
    out("    neg rax")
    out(".hk_done:")
    out("    ret")

    // --- map_set(map, key, value) ---
    out("")
    out_label("_nova_map_set")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    mov rdi, rsi")
    out("    call _nova_hash_key")
    out("    xor edx, edx")
    out("    div qword ptr [r12 + 16]")
    out("    mov r15, rdx")
    out(".ms_probe:")
    out("    mov rax, r15")
    out("    imul rax, 24")
    out("    add rax, [r12 + 24]")
    out("    cmp qword ptr [rax + 16], 0")
    out("    je .ms_insert")
    out("    mov rdi, [rax]")
    out("    mov rsi, r13")
    out("    call _nova_eq")
    out("    test rax, rax")
    out("    jnz .ms_update")
    out("    inc r15")
    out("    cmp r15, [r12 + 16]")
    out("    jl .ms_probe")
    out("    xor r15d, r15d")
    out("    jmp .ms_probe")
    out(".ms_insert:")
    out("    mov [rax], r13")
    out("    mov [rax + 8], r14")
    out("    mov qword ptr [rax + 16], 1")
    out("    inc qword ptr [r12 + 8]")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ms_update:")
    out("    mov rax, r15")
    out("    imul rax, 24")
    out("    add rax, [r12 + 24]")
    out("    mov [rax + 8], r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_get(map, key) -> value or 0 ---
    out("")
    out_label("_nova_map_get")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rdi, rsi")
    out("    call _nova_hash_key")
    out("    xor edx, edx")
    out("    div qword ptr [r12 + 16]")
    out("    mov r14, rdx")
    out("    mov r15, [r12 + 16]")
    out("    xor ebx, ebx")
    out(".mg_probe:")
    out("    cmp rbx, r15")
    out("    jge .mg_not_found")
    out("    mov rax, r14")
    out("    imul rax, 24")
    out("    add rax, [r12 + 24]")
    out("    cmp qword ptr [rax + 16], 0")
    out("    je .mg_not_found")
    out("    push rax")
    out("    mov rdi, [rax]")
    out("    mov rsi, r13")
    out("    call _nova_eq")
    out("    test rax, rax")
    out("    pop rax")
    out("    jnz .mg_found")
    out("    inc r14")
    out("    cmp r14, r15")
    out("    jl .mg_no_wrap")
    out("    xor r14d, r14d")
    out(".mg_no_wrap:")
    out("    inc rbx")
    out("    jmp .mg_probe")
    out(".mg_found:")
    out("    mov rax, [rax + 8]")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".mg_not_found:")
    out("    xor eax, eax")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_has(map, key) -> 1 or 0 ---
    out("")
    out_label("_nova_map_has")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_map_get")
    out("    test rax, rax")
    out("    jz .mh_no")
    out("    mov eax, 1")
    out("    pop rbp")
    out("    ret")
    out(".mh_no:")
    out("    xor eax, eax")
    out("    pop rbp")
    out("    ret")

    // --- join(list, separator) -> string  (O(n) two-pass) ---
    out("")
    out_label("_nova_join")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, [rdi + 8]")
    out("    test r14, r14")
    out("    jz .join_empty")
    // Pass 1: get separator length
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    mov [rbp - 48], rax")
    // Pass 1: sum element lengths
    out("    xor r15d, r15d")
    out("    xor ebx, ebx")
    out(".join_len_loop:")
    out("    cmp rbx, r14")
    out("    jge .join_len_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + rbx*8]")
    out("    call _nova_strlen")
    out("    add r15, rax")
    out("    inc rbx")
    out("    jmp .join_len_loop")
    out(".join_len_done:")
    // total += (count-1) * sep_len + 1
    out("    mov rax, r14")
    out("    dec rax")
    out("    imul rax, qword ptr [rbp - 48]")
    out("    add r15, rax")
    out("    inc r15")
    // Allocate single buffer
    out("    mov rdi, r15")
    out("    call _nova_alloc")
    out("    mov r15, rax")
    out("    mov rdi, rax")
    // Pass 2: copy elements with separators
    out("    xor ebx, ebx")
    out(".join_copy_loop:")
    out("    cmp rbx, r14")
    out("    jge .join_copy_done")
    out("    test rbx, rbx")
    out("    jz .join_no_sep")
    out("    mov rsi, r13")
    out(".join_sep_cp:")
    out("    lodsb")
    out("    test al, al")
    out("    jz .join_no_sep")
    out("    stosb")
    out("    jmp .join_sep_cp")
    out(".join_no_sep:")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rbx*8]")
    out(".join_elem_cp:")
    out("    lodsb")
    out("    test al, al")
    out("    jz .join_elem_done")
    out("    stosb")
    out("    jmp .join_elem_cp")
    out(".join_elem_done:")
    out("    inc rbx")
    out("    jmp .join_copy_loop")
    out(".join_copy_done:")
    out("    mov byte ptr [rdi], 0")
    out("    mov rax, r15")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".join_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    add rsp, 8")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- split(str, delimiter_char) -> list of strings ---
    out("")
    out_label("_nova_split")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    cmp r13, 256")
    out("    jl .split_char_ready")
    out("    movzx r13d, byte ptr [r13]")
    out(".split_char_ready:")
    out("    xor r15d, r15d")
    out("    xor ebx, ebx")
    out(".split_loop:")
    out("    movzx eax, byte ptr [r12 + rbx]")
    out("    test al, al")
    out("    jz .split_last")
    out("    cmp al, r13b")
    out("    je .split_found")
    out("    inc rbx")
    out("    jmp .split_loop")
    out(".split_found:")
    out("    mov rdi, r12")
    out("    mov rsi, r15")
    out("    mov rdx, rbx")
    out("    sub rdx, r15")
    out("    call _nova_substr")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_push")
    out("    inc rbx")
    out("    mov r15, rbx")
    out("    jmp .split_loop")
    out(".split_last:")
    out("    mov rdi, r12")
    out("    mov rsi, r15")
    out("    mov rdx, rbx")
    out("    sub rdx, r15")
    out("    call _nova_substr")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_push")
    out("    mov rax, r14")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- reverse(list) -> new reversed list ---
    out("")
    out_label("_nova_reverse")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, [rdi + 8]")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    mov rcx, r13")
    out("    dec rcx")
    out(".rev_loop:")
    out("    cmp rcx, 0")
    out("    jl .rev_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    mov rdi, r14")
    out("    push rcx")
    out("    call _nova_push")
    out("    pop rcx")
    out("    dec rcx")
    out("    jmp .rev_loop")
    out(".rev_done:")
    out("    mov rax, r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- sort(list) -> sorts list in place (insertion sort) ---
    out("")
    out_label("_nova_sort")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, [rdi + 8]")
    out("    cmp r13, 2")
    out("    jl .sort_done")
    out("    mov rdi, [r12 + 24]")
    out("    mov rcx, 1")
    out(".sort_outer:")
    out("    cmp rcx, r13")
    out("    jge .sort_done")
    out("    mov rax, [rdi + rcx*8]")
    out("    mov rdx, rcx")
    out("    dec rdx")
    out(".sort_inner:")
    out("    cmp rdx, 0")
    out("    jl .sort_place")
    out("    cmp [rdi + rdx*8], rax")
    out("    jle .sort_place")
    out("    mov r8, [rdi + rdx*8]")
    out("    mov [rdi + rdx*8 + 8], r8")
    out("    dec rdx")
    out("    jmp .sort_inner")
    out(".sort_place:")
    out("    inc rdx")
    out("    mov [rdi + rdx*8], rax")
    out("    inc rcx")
    out("    jmp .sort_outer")
    out(".sort_done:")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- float_mul(a, b) -> (a * b) / 1000 ---
    out("")
    out_label("_nova_float_mul")
    out("    mov rax, rdi")
    out("    imul rsi")
    out("    mov rcx, 1000")
    out("    cqo")
    out("    idiv rcx")
    out("    ret")

    // --- float_div(a, b) -> (a * 1000) / b ---
    out("")
    out_label("_nova_float_div")
    out("    mov rax, rdi")
    out("    mov rcx, 1000")
    out("    imul rcx")
    out("    idiv rsi")
    out("    ret")

    // --- to_float(n) -> n * 1000 ---
    out("")
    out_label("_nova_to_float")
    out("    mov rax, rdi")
    out("    imul rax, 1000")
    out("    ret")

    // --- from_float(f) -> f / 1000 ---
    out("")
    out_label("_nova_from_float")
    out("    mov rax, rdi")
    out("    cqo")
    out("    mov rcx, 1000")
    out("    idiv rcx")
    out("    ret")

    // --- float_to_str(n) -> string like "3.140" ---
    // Uses only stack slots (no callee-saved regs, since runtime clobbers them)
    // [rbp-8]=frac, [rbp-16]=neg_flag, [rbp-24]=result_str
    // [rbp-32..rbp-29]=frac digit buffer
    out("")
    out_label("_nova_float_to_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 48")
    // Handle negative: store flag at [rbp-16]
    out("    mov qword ptr [rbp - 16], 0")
    out("    test rdi, rdi")
    out("    jns .fts_pos")
    out("    mov qword ptr [rbp - 16], 1")
    out("    neg rdi")
    out(".fts_pos:")
    // Split: integer = rdi/1000, frac = rdi%1000
    out("    mov rax, rdi")
    out("    xor edx, edx")
    out("    mov rcx, 1000")
    out("    div rcx")
    out("    mov [rbp - 8], rdx")
    // Convert integer part to string
    out("    mov rdi, rax")
    out("    call _nova_int_to_str")
    out("    mov [rbp - 24], rax")
    // If negative, prepend "-"
    out("    cmp qword ptr [rbp - 16], 0")
    out("    je .fts_no_sign")
    out("    lea rdi, [rip + _float_minus]")
    out("    mov rsi, [rbp - 24]")
    out("    call _nova_concat")
    out("    mov [rbp - 24], rax")
    out(".fts_no_sign:")
    // Append "."
    out("    mov rdi, [rbp - 24]")
    out("    lea rsi, [rip + _float_dot]")
    out("    call _nova_concat")
    out("    mov [rbp - 24], rax")
    // Compute 3 fractional digits from [rbp-8] (0..999)
    out("    mov rax, [rbp - 8]")
    out("    xor edx, edx")
    out("    mov rcx, 100")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 32], al")
    out("    mov rax, rdx")
    out("    xor edx, edx")
    out("    mov rcx, 10")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 31], al")
    out("    add dl, 48")
    out("    mov [rbp - 30], dl")
    out("    mov byte ptr [rbp - 29], 0")
    // Append fractional digits
    out("    mov rdi, [rbp - 24]")
    out("    lea rsi, [rbp - 32]")
    out("    call _nova_concat")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- to_str(value) -> string representation ---
    // If value < 0x100000: treat as integer, convert via int_to_str
    // If value >= 0x100000 and [value] == -1: it's a list, return "[list]"
    // Otherwise: it's already a string, return as-is
    out("")
    out_label("_nova_to_str")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .ts_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .ts_list")
    out("    mov rax, rdi")
    out("    ret")
    out(".ts_int:")
    out("    jmp _nova_int_to_str")
    out(".ts_list:")
    out("    lea rax, [rip + _str_list_repr]")
    out("    ret")

    // --- map_list(list, fn): create new list by applying fn to each element ---
    out("")
    out_label("_nova_map_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")  // source list
    out("    mov r13, rsi")  // function pointer
    out("    call _nova_list_new")
    out("    mov r14, rax")  // result list
    out("    xor r15d, r15d")  // index
    out(".ml_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .ml_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r15*8]")
    out("    mov r11, r13")
    out("    call r11")
    out("    mov rsi, rax")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out("    inc r15")
    out("    jmp .ml_loop")
    out(".ml_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- filter(list, fn): new list with elements where fn returns non-zero ---
    out("")
    out_label("_nova_filter")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r15d, r15d")
    out(".fl_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .fl_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r15*8]")
    out("    push rdi")
    out("    mov r11, r13")
    out("    call r11")
    out("    pop rdi")
    out("    test rax, rax")
    out("    jz .fl_skip")
    out("    mov rsi, rdi")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out(".fl_skip:")
    out("    inc r15")
    out("    jmp .fl_loop")
    out(".fl_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- reduce(list, fn, init): accumulate with fn(acc, elem) ---
    out("")
    out_label("_nova_reduce")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")  // list
    out("    mov r13, rsi")  // function
    out("    mov r14, rdx")  // accumulator
    out("    xor r15d, r15d")
    out(".rd_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .rd_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + r15*8]")
    out("    mov rdi, r14")
    out("    mov r11, r13")
    out("    call r11")
    out("    mov r14, rax")
    out("    inc r15")
    out("    jmp .rd_loop")
    out(".rd_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- foreach(list, fn): call fn(elem) for each, return 0 ---
    out("")
    out_label("_nova_foreach")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out(".fe_loop:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .fe_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r14*8]")
    out("    mov r11, r13")
    out("    call r11")
    out("    inc r14")
    out("    jmp .fe_loop")
    out(".fe_done:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- keys(map): return list of keys ---
    out("")
    out_label("_nova_keys")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 16]")
    out("    xor ecx, ecx")
    out(".keys_loop:")
    out("    cmp rcx, r14")
    out("    jge .keys_done")
    out("    mov rax, [r12 + 24]")  // entries_ptr
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")  // occupied?
    out("    je .keys_skip")
    out("    push rcx")
    out("    mov rsi, [rdi]")  // key
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out(".keys_skip:")
    out("    inc rcx")
    out("    jmp .keys_loop")
    out(".keys_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- values(map): return list of values ---
    out("")
    out_label("_nova_values")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 16]")
    out("    xor ecx, ecx")
    out(".vals_loop:")
    out("    cmp rcx, r14")
    out("    jge .vals_done")
    out("    mov rax, [r12 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .vals_skip")
    out("    push rcx")
    out("    mov rsi, [rdi + 8]")  // value
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out(".vals_skip:")
    out("    inc rcx")
    out("    jmp .vals_loop")
    out(".vals_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_entries(map) -> flat list [k0,v0,k1,v1,...] ---
    out("")
    out_label("_nova_map_entries")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 16]")
    out("    xor ecx, ecx")
    out(".me_loop:")
    out("    cmp rcx, r14")
    out("    jge .me_done")
    out("    mov rax, [r12 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .me_skip")
    out("    push rcx")
    out("    push rdi")
    out("    mov rsi, [rdi]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rdi")
    out("    mov rsi, [rdi + 8]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out(".me_skip:")
    out("    inc rcx")
    out("    jmp .me_loop")
    out(".me_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_upper(str): uppercase a string ---
    out("")
    out_label("_nova_str_upper")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    out("    lea rdi, [rax + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    xor ecx, ecx")
    out(".su_loop:")
    out("    cmp rcx, r13")
    out("    jge .su_done")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 97")
    out("    jl .su_copy")
    out("    cmp dl, 122")
    out("    jg .su_copy")
    out("    sub dl, 32")
    out(".su_copy:")
    out("    mov rax, [rsp]")
    out("    mov [rax + rcx], dl")
    out("    inc rcx")
    out("    jmp .su_loop")
    out(".su_done:")
    out("    pop rax")
    out("    mov byte ptr [rax + r13], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_lower(str): lowercase a string ---
    out("")
    out_label("_nova_str_lower")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    out("    lea rdi, [rax + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    xor ecx, ecx")
    out(".slw_loop:")
    out("    cmp rcx, r13")
    out("    jge .slw_done")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 65")
    out("    jl .slw_copy")
    out("    cmp dl, 90")
    out("    jg .slw_copy")
    out("    add dl, 32")
    out(".slw_copy:")
    out("    mov rax, [rsp]")
    out("    mov [rax + rcx], dl")
    out("    inc rcx")
    out("    jmp .slw_loop")
    out(".slw_done:")
    out("    pop rax")
    out("    mov byte ptr [rax + r13], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_trim(str): trim leading/trailing whitespace ---
    out("")
    out_label("_nova_str_trim")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    // find start (skip whitespace)
    out("    xor ecx, ecx")
    out(".st_lead:")
    out("    cmp rcx, r13")
    out("    jge .st_empty")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 32")
    out("    je .st_lead_next")
    out("    cmp dl, 9")
    out("    je .st_lead_next")
    out("    cmp dl, 10")
    out("    je .st_lead_next")
    out("    cmp dl, 13")
    out("    je .st_lead_next")
    out("    jmp .st_find_end")
    out(".st_lead_next:")
    out("    inc rcx")
    out("    jmp .st_lead")
    out(".st_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".st_find_end:")
    out("    mov rsi, rcx")  // start
    out("    mov rcx, r13")
    out("    dec rcx")
    out(".st_trail:")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 32")
    out("    je .st_trail_next")
    out("    cmp dl, 9")
    out("    je .st_trail_next")
    out("    cmp dl, 10")
    out("    je .st_trail_next")
    out("    cmp dl, 13")
    out("    je .st_trail_next")
    out("    jmp .st_copy")
    out(".st_trail_next:")
    out("    dec rcx")
    out("    jmp .st_trail")
    out(".st_copy:")
    out("    inc rcx")
    out("    sub rcx, rsi")  // length
    out("    mov rdi, r12")
    out("    add rdi, rsi")  // src start
    out("    mov rsi, rcx")  // length
    // substr(src+start, 0, len)
    out("    push rcx")
    out("    push rdi")
    out("    lea rdi, [rcx + 1]")
    out("    call _nova_alloc")
    out("    pop rdi")
    out("    pop rcx")
    out("    push rax")
    out("    mov rsi, rdi")
    out("    pop rdi")
    out("    push rdi")
    // copy rcx bytes from rsi to rdi
    out("    xor r8d, r8d")
    out(".st_cloop:")
    out("    cmp r8, rcx")
    out("    jge .st_cdone")
    out("    movzx edx, byte ptr [rsi + r8]")
    out("    mov [rdi + r8], dl")
    out("    inc r8")
    out("    jmp .st_cloop")
    out(".st_cdone:")
    out("    pop rax")
    out("    mov byte ptr [rax + rcx], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_replace(str, old, new): replace all occurrences ---
    out("")
    out_label("_nova_str_replace")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")  // source
    out("    mov r13, rsi")  // old
    out("    mov r14, rdx")  // new
    // Get lengths
    out("    call _nova_str_len")
    out("    push rax")  // src_len
    out("    mov rdi, r13")
    out("    call _nova_str_len")
    out("    mov r15, rax")  // old_len
    // Build result string by concatenation
    out("    lea rax, [rip + _empty_str]")
    out("    push rax")  // result
    out("    xor ecx, ecx")  // i
    out("    push rcx")
    out(".sr_loop:")
    out("    mov rcx, [rsp]")  // i
    out("    mov rax, [rsp + 16]")  // src_len
    out("    cmp rcx, rax")
    out("    jge .sr_done")
    // Check if old matches at position i
    out("    mov rdi, r12")
    out("    add rdi, rcx")
    out("    mov rsi, r13")
    out("    mov rdx, r15")
    out("    call _nova_strncmp")
    out("    test rax, rax")
    out("    jnz .sr_nomatch")
    // Match found: append new string
    out("    mov rdi, [rsp + 8]")
    out("    mov rsi, r14")
    out("    call _nova_concat")
    out("    mov [rsp + 8], rax")
    out("    mov rcx, [rsp]")
    out("    add rcx, r15")
    out("    mov [rsp], rcx")
    out("    jmp .sr_loop")
    out(".sr_nomatch:")
    // Append one char
    out("    mov rcx, [rsp]")
    out("    movzx edi, byte ptr [r12 + rcx]")
    out("    call _nova_chr")
    out("    mov rsi, rax")
    out("    mov rdi, [rsp + 8]")
    out("    call _nova_concat")
    out("    mov [rsp + 8], rax")
    out("    inc qword ptr [rsp]")
    out("    jmp .sr_loop")
    out(".sr_done:")
    out("    mov rax, [rsp + 8]")
    out("    add rsp, 24")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // Helper: compare n bytes, return 0 if equal
    out("")
    out_label("_nova_strncmp")
    out("    xor ecx, ecx")
    out(".snc_loop:")
    out("    cmp rcx, rdx")
    out("    jge .snc_eq")
    out("    movzx eax, byte ptr [rdi + rcx]")
    out("    movzx r8d, byte ptr [rsi + rcx]")
    out("    cmp al, r8b")
    out("    jne .snc_neq")
    out("    inc rcx")
    out("    jmp .snc_loop")
    out(".snc_eq:")
    out("    xor eax, eax")
    out("    ret")
    out(".snc_neq:")
    out("    mov eax, 1")
    out("    ret")

    // --- str_repeat(str, n): repeat string n times ---
    out("")
    out_label("_nova_str_repeat")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    lea rax, [rip + _empty_str]")
    out("    push rax")
    out(".srp_loop:")
    out("    cmp r13, 0")
    out("    jle .srp_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_concat")
    out("    mov [rsp], rax")
    out("    dec r13")
    out("    jmp .srp_loop")
    out(".srp_done:")
    out("    pop rax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- char_code(str): return ASCII code of first char ---
    out("")
    out_label("_nova_char_code")
    out("    movzx eax, byte ptr [rdi]")
    out("    ret")

    // --- to_int(str): parse string to integer ---
    out("")
    out_label("_nova_to_int")
    out("    jmp _nova_str_to_int")

    // --- range_list(start, end): create list [start, start+1, ..., end-1] ---
    out("")
    out_label("_nova_range_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    push rax")
    out(".rgl_loop:")
    out("    cmp r12, r13")
    out("    jge .rgl_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_push")
    out("    inc r12")
    out("    jmp .rgl_loop")
    out(".rgl_done:")
    out("    pop rax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- range_step(start, end, step): create list [start, start+step, ...] ---
    out("")
    out_label("_nova_range_step")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    call _nova_list_new")
    out("    push rax")
    out("    test r14, r14")
    out("    jz .rgs_done")
    out("    jg .rgs_pos")
    out(".rgs_neg:")
    out("    cmp r12, r13")
    out("    jle .rgs_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_push")
    out("    add r12, r14")
    out("    jmp .rgs_neg")
    out(".rgs_pos:")
    out("    cmp r12, r13")
    out("    jge .rgs_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_push")
    out("    add r12, r14")
    out("    jmp .rgs_pos")
    out(".rgs_done:")
    out("    pop rax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_copy(list): shallow copy ---
    out("")
    out_label("_nova_list_copy")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    xor ecx, ecx")
    out(".lc_loop:")
    out("    cmp rcx, [r12 + 8]")
    out("    jge .lc_done")
    out("    push rcx")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out("    inc rcx")
    out("    jmp .lc_loop")
    out(".lc_done:")
    out("    mov rax, r13")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_slice(list, start, end): sublist ---
    out("")
    out_label("_nova_list_slice")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")  // start
    out("    mov r14, rdx")  // end
    out("    call _nova_list_new")
    out("    push rax")
    out(".ls_loop:")
    out("    cmp r13, r14")
    out("    jge .ls_done")
    out("    cmp r13, [r12 + 8]")
    out("    jge .ls_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + r13*8]")
    out("    mov rdi, [rsp]")
    out("    push r13")
    out("    call _nova_push")
    out("    pop r13")
    out("    inc r13")
    out("    jmp .ls_loop")
    out(".ls_done:")
    out("    pop rax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- append_list(dst, src): append all elements of src to dst ---
    out("")
    out_label("_nova_append_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out(".al_loop:")
    out("    cmp r14, [r13 + 8]")
    out("    jge .al_done")
    out("    mov rax, [r13 + 24]")
    out("    mov rsi, [rax + r14*8]")
    out("    mov rdi, r12")
    out("    call _nova_push")
    out("    inc r14")
    out("    jmp .al_loop")
    out(".al_done:")
    out("    mov rax, r12")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- index_of(list, value): find first index of value, or -1 ---
    out("")
    out_label("_nova_index_of")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    xor eax, eax")
    out(".iof_loop:")
    out("    cmp rax, rcx")
    out("    jge .iof_notfound")
    out("    cmp [rdi + rax*8], rsi")
    out("    je .iof_found")
    out("    inc rax")
    out("    jmp .iof_loop")
    out(".iof_found:")
    out("    pop rbp")
    out("    ret")
    out(".iof_notfound:")
    out("    mov rax, -1")
    out("    pop rbp")
    out("    ret")

    // --- last_index_of(list, value): find last index of value, or -1 ---
    out("")
    out_label("_nova_last_index_of")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    mov rax, rcx")
    out("    dec rax")
    out(".liof_loop:")
    out("    cmp rax, 0")
    out("    jl .liof_notfound")
    out("    cmp [rdi + rax*8], rsi")
    out("    je .liof_found")
    out("    dec rax")
    out("    jmp .liof_loop")
    out(".liof_found:")
    out("    pop rbp")
    out("    ret")
    out(".liof_notfound:")
    out("    mov rax, -1")
    out("    pop rbp")
    out("    ret")

    // --- map_remove(map, key) ---
    out("")
    out_label("_nova_map_remove")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rcx, [r12 + 16]")
    out("    mov rdi, [r12 + 24]")
    out("    xor eax, eax")
    out(".mr_loop:")
    out("    cmp rax, rcx")
    out("    jge .mr_done")
    out("    imul rsi, rax, 24")
    out("    add rsi, rdi")
    out("    cmp qword ptr [rsi + 16], 0")
    out("    je .mr_next")
    out("    push rax")
    out("    push rcx")
    out("    push rdi")
    out("    mov rdi, [rsi]")
    out("    mov rsi, r13")
    out("    call _nova_eq")
    out("    pop rdi")
    out("    pop rcx")
    out("    pop rsi")
    out("    test rax, rax")
    out("    jz .mr_next2")
    out("    imul rax, rsi, 24")
    out("    add rax, rdi")
    out("    mov qword ptr [rax + 16], 0")
    out("    dec qword ptr [r12 + 8]")
    out("    jmp .mr_done")
    out(".mr_next2:")
    out("    mov rax, rsi")
    out(".mr_next:")
    out("    inc rax")
    out("    jmp .mr_loop")
    out(".mr_done:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_count(map): return count of entries ---
    out("")
    out_label("_nova_map_count")
    out("    mov rax, [rdi + 8]")
    out("    ret")

    // --- zip(list_a, list_b): create list of [a, b] pairs ---
    out("")
    out_label("_nova_zip")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    // min length
    out("    mov rax, [r12 + 8]")
    out("    mov rcx, [r13 + 8]")
    out("    cmp rax, rcx")
    out("    cmovg rax, rcx")
    out("    mov r15, rax")
    out("    xor ecx, ecx")
    out(".zip_loop:")
    out("    cmp rcx, r15")
    out("    jge .zip_done")
    out("    push rcx")
    // create pair list
    out("    call _nova_list_new")
    out("    push rax")
    out("    mov rdi, rax")
    out("    mov rcx, [rsp + 8]")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    call _nova_push")
    out("    mov rdi, [rsp]")
    out("    mov rcx, [rsp + 8]")
    out("    mov rax, [r13 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    call _nova_push")
    // push pair to result
    out("    pop rsi")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out("    pop rcx")
    out("    inc rcx")
    out("    jmp .zip_loop")
    out(".zip_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- enumerate(list) -> list of [idx, val] pairs ---
    out("")
    out_label("_nova_enumerate")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 8]")
    out("    xor ecx, ecx")
    out(".enum_loop:")
    out("    cmp rcx, r14")
    out("    jge .enum_done")
    out("    push rcx")
    out("    call _nova_list_new")
    out("    push rax")
    out("    mov rdi, rax")
    out("    mov rsi, [rsp + 8]")
    out("    call _nova_push")
    out("    mov rdi, [rsp]")
    out("    mov rcx, [rsp + 8]")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    call _nova_push")
    out("    pop rsi")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out("    inc rcx")
    out("    jmp .enum_loop")
    out(".enum_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- pad_left(str, width, fill_char) ---
    out("")
    out_label("_nova_pad_left")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    mov rdi, r12")
    out("    call _nova_strlen")
    out("    cmp rax, r13")
    out("    jge .pl_ret_orig")
    out("    mov rcx, r13")
    out("    sub rcx, rax")
    out("    push rcx")
    out("    push rax")
    out("    lea rdi, [r13 + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    pop rdi")
    out("    pop rax")
    out("    pop rcx")
    out("    push rdi")
    out("    push rax")
    out("    mov rsi, r14")
    out("    mov al, [rsi]")
    out("    mov rsi, rdi")
    out(".pl_fill:")
    out("    test rcx, rcx")
    out("    jz .pl_copy")
    out("    mov [rsi], al")
    out("    inc rsi")
    out("    dec rcx")
    out("    jmp .pl_fill")
    out(".pl_copy:")
    out("    mov rdi, rsi")
    out("    mov rsi, r12")
    out("    pop rcx")
    out("    rep movsb")
    out("    mov byte ptr [rdi], 0")
    out("    pop rax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".pl_ret_orig:")
    out("    mov rax, r12")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- pad_right(str, width, fill_char) ---
    out("")
    out_label("_nova_pad_right")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    mov rdi, r12")
    out("    call _nova_strlen")
    out("    cmp rax, r13")
    out("    jge .pr_ret_orig")
    out("    mov rcx, r13")
    out("    sub rcx, rax")
    out("    push rcx")
    out("    push rax")
    out("    lea rdi, [r13 + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out("    mov rcx, [rsp + 8]")
    out("    rep movsb")
    out("    mov rsi, r14")
    out("    mov al, [rsi]")
    out("    mov rcx, [rsp + 16]")
    out(".pr_fill:")
    out("    test rcx, rcx")
    out("    jz .pr_end")
    out("    mov [rdi], al")
    out("    inc rdi")
    out("    dec rcx")
    out("    jmp .pr_fill")
    out(".pr_end:")
    out("    mov byte ptr [rdi], 0")
    out("    pop rax")
    out("    add rsp, 16")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".pr_ret_orig:")
    out("    mov rax, r12")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_count(haystack, needle) -> count of occurrences ---
    out("")
    out_label("_nova_str_count")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    push rax")
    out(".sc_loop:")
    out("    mov rdi, r12")
    out("    mov rsi, r13")
    out("    call _nova_str_find")
    out("    cmp rax, 0")
    out("    jl .sc_done")
    out("    inc r14")
    out("    add r12, rax")
    out("    add r12, [rsp]")
    out("    jmp .sc_loop")
    out(".sc_done:")
    out("    mov rax, r14")
    out("    add rsp, 8")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- flat_map(list, fn): map then flatten one level ---
    out("")
    out_label("_nova_flat_map")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r15d, r15d")
    out(".fm_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .fm_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r15*8]")
    out("    mov r11, r13")
    out("    call r11")
    // result should be a list, append its elements
    out("    cmp qword ptr [rax], -1")
    out("    jne .fm_single")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_append_list")
    out("    jmp .fm_next")
    out(".fm_single:")
    out("    mov rsi, rax")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out(".fm_next:")
    out("    inc r15")
    out("    jmp .fm_loop")
    out(".fm_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- any(list, fn): returns 1 if fn returns true for any element ---
    out("")
    out_label("_nova_any")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out(".any_loop:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .any_false")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r14*8]")
    out("    mov r11, r13")
    out("    call r11")
    out("    test rax, rax")
    out("    jnz .any_true")
    out("    inc r14")
    out("    jmp .any_loop")
    out(".any_true:")
    out("    mov eax, 1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".any_false:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- all(list, fn): returns 1 if fn returns true for all elements ---
    out("")
    out_label("_nova_all")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out(".all_loop:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .all_true")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r14*8]")
    out("    mov r11, r13")
    out("    call r11")
    out("    test rax, rax")
    out("    jz .all_false")
    out("    inc r14")
    out("    jmp .all_loop")
    out(".all_true:")
    out("    mov eax, 1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".all_false:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- sum(list): sum all integer elements ---
    out("")
    out_label("_nova_sum")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    xor eax, eax")
    out(".sum_loop:")
    out("    test rcx, rcx")
    out("    jz .sum_done")
    out("    add rax, [rdi]")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    jmp .sum_loop")
    out(".sum_done:")
    out("    pop rbp")
    out("    ret")

    // --- product(list): multiply all elements ---
    out("")
    out_label("_nova_product")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    mov rax, 1")
    out(".prod_loop:")
    out("    test rcx, rcx")
    out("    jz .prod_done")
    out("    imul rax, [rdi]")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    jmp .prod_loop")
    out(".prod_done:")
    out("    pop rbp")
    out("    ret")

    // --- min_list(list): find minimum element ---
    out("")
    out_label("_nova_min_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    test rcx, rcx")
    out("    jz .minl_empty")
    out("    mov rdi, [rdi + 24]")
    out("    mov rax, [rdi]")
    out("    add rdi, 8")
    out("    dec rcx")
    out(".minl_loop:")
    out("    test rcx, rcx")
    out("    jz .minl_done")
    out("    cmp [rdi], rax")
    out("    jge .minl_skip")
    out("    mov rax, [rdi]")
    out(".minl_skip:")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    jmp .minl_loop")
    out(".minl_empty:")
    out("    xor eax, eax")
    out(".minl_done:")
    out("    pop rbp")
    out("    ret")

    // --- max_list(list): find maximum element ---
    out("")
    out_label("_nova_max_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, [rdi + 8]")
    out("    test rcx, rcx")
    out("    jz .maxl_empty")
    out("    mov rdi, [rdi + 24]")
    out("    mov rax, [rdi]")
    out("    add rdi, 8")
    out("    dec rcx")
    out(".maxl_loop:")
    out("    test rcx, rcx")
    out("    jz .maxl_done")
    out("    cmp [rdi], rax")
    out("    jle .maxl_skip")
    out("    mov rax, [rdi]")
    out(".maxl_skip:")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    jmp .maxl_loop")
    out(".maxl_empty:")
    out("    xor eax, eax")
    out(".maxl_done:")
    out("    pop rbp")
    out("    ret")

    // --- flatten(list): flatten one level of nesting ---
    out("")
    out_label("_nova_flatten")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    xor r14d, r14d")
    out(".flat_outer:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .flat_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r14*8]")
    out("    cmp rdi, 0x" + PTR_THRESHOLD)
    out("    jl .flat_push_one")
    out("    cmp qword ptr [rdi], -1")
    out("    jne .flat_push_one")
    out("    push r14")
    out("    mov rcx, [rdi + 8]")
    out("    mov rdi, [rdi + 24]")
    out("    push rdi")
    out("    push rcx")
    out(".flat_inner:")
    out("    pop rcx")
    out("    pop rdi")
    out("    test rcx, rcx")
    out("    jz .flat_inner_done")
    out("    mov rsi, [rdi]")
    out("    push rcx")
    out("    push rdi")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rdi")
    out("    pop rcx")
    out("    add rdi, 8")
    out("    dec rcx")
    out("    push rdi")
    out("    push rcx")
    out("    jmp .flat_inner")
    out(".flat_inner_done:")
    out("    pop r14")
    out("    inc r14")
    out("    jmp .flat_outer")
    out(".flat_push_one:")
    out("    push r14")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + r14*8]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop r14")
    out("    inc r14")
    out("    jmp .flat_outer")
    out(".flat_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- unique(list): return list with duplicates removed ---
    out("")
    out_label("_nova_unique")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    xor r14d, r14d")
    out(".uniq_outer:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .uniq_done")
    out("    mov rax, [r12 + 24]")
    out("    mov r15, [rax + r14*8]")
    out("    mov rdi, r13")
    out("    mov rsi, r15")
    out("    push r14")
    out("    call _nova_contains")
    out("    pop r14")
    out("    test rax, rax")
    out("    jnz .uniq_skip")
    out("    mov rdi, r13")
    out("    mov rsi, r15")
    out("    push r14")
    out("    call _nova_push")
    out("    pop r14")
    out(".uniq_skip:")
    out("    inc r14")
    out("    jmp .uniq_outer")
    out(".uniq_done:")
    out("    mov rax, r13")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_merge(m1, m2): return new map with all entries from both ---
    out("")
    out_label("_nova_map_merge")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_map_new")
    out("    mov r14, rax")
    out("    mov r15, [r12 + 16]")
    out("    xor ecx, ecx")
    out(".mm_loop1:")
    out("    cmp rcx, r15")
    out("    jge .mm_phase2")
    out("    mov rax, [r12 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .mm_skip1")
    out("    push rcx")
    out("    mov rsi, [rdi]")
    out("    mov rdx, [rdi + 8]")
    out("    mov rdi, r14")
    out("    call _nova_map_set")
    out("    pop rcx")
    out(".mm_skip1:")
    out("    inc rcx")
    out("    jmp .mm_loop1")
    out(".mm_phase2:")
    out("    mov r15, [r13 + 16]")
    out("    xor ecx, ecx")
    out(".mm_loop2:")
    out("    cmp rcx, r15")
    out("    jge .mm_done")
    out("    mov rax, [r13 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .mm_skip2")
    out("    push rcx")
    out("    mov rsi, [rdi]")
    out("    mov rdx, [rdi + 8]")
    out("    mov rdi, r14")
    out("    call _nova_map_set")
    out("    pop rcx")
    out(".mm_skip2:")
    out("    inc rcx")
    out("    jmp .mm_loop2")
    out(".mm_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

