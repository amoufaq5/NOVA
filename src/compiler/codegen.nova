        out("    lea rdi, [rbp - 32]")
        out("    mov rsi, 1")
        out("    mov rdx, [rbp - 72]")
        emit_syscall(7)
        out("    test rax, rax")
        out("    jle .srf_nx_timeout")
        // sockaddr_in scratch at [rbp - 16], addrlen at [rbp - 24]
        out("    mov word ptr [rbp - 16], 0")
        out("    mov word ptr [rbp - 14], 0")
        out("    mov dword ptr [rbp - 12], 0")
        out("    mov qword ptr [rbp - 8], 0")
        out("    mov dword ptr [rbp - 24], 16")
        out("    mov rdi, [rbp - 48]")             // fd
        out("    mov rsi, [rbp - 56]")             // buf
        out("    mov rdx, [rbp - 64]")             // len
        out("    xor r10, r10")                    // flags = 0
        out("    lea r8, [rbp - 16]")              // &sockaddr
        out("    lea r9, [rbp - 24]")              // &addrlen
        emit_syscall(45)
        out("    test rax, rax")
        out("    js .srf_nx_fail")
        out("    mov [rbp - 80], rax")             // bytes_read
        out("    call _nova_list_new")
        out("    mov [rbp - 88], rax")
        out("    mov rdi, rax")
        out("    mov rsi, [rbp - 80]")
        out("    call _nova_push")
        out("    mov rdi, [rbp - 88]")
        out("    mov esi, dword ptr [rbp - 12]")
        out("    call _nova_push")
        out("    mov rdi, [rbp - 88]")
        out("    movzx eax, word ptr [rbp - 14]")
        out("    xchg al, ah")
        out("    mov rsi, rax")
        out("    call _nova_push")
        out("    mov rax, [rbp - 88]")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
        out(".srf_nx_timeout:")
        out(".srf_nx_fail:")
        out("    call _nova_list_new")
        out("    mov [rbp - 88], rax")
        out("    mov rdi, rax")
        out("    mov rsi, -1")
        out("    call _nova_push")
        out("    mov rdi, [rbp - 88]")
        out("    xor rsi, rsi")
        out("    call _nova_push")
        out("    mov rdi, [rbp - 88]")
        out("    xor rsi, rsi")
