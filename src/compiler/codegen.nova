    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    lea r12, [rdi + rsi]")
    out("    mov r13, rdx")
    out("    lea rdi, [rdx + 1]")
    out("    call _nova_alloc")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out("    mov rcx, r13")
    out("    rep movsb")
    out("    mov byte ptr [rdi], 0")
    out("    sub rdi, r13")
    out("    mov rax, rdi")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_to_int(str) -> int ---
    out("")
    out_label("_nova_str_to_int")
    out("    xor eax, eax")
    out("    xor ecx, ecx")
    out("    cmp byte ptr [rdi], 45")
    out("    jne .sti_loop")
    out("    mov cl, 1")
    out("    inc rdi")
    out(".sti_loop:")
    out("    movzx edx, byte ptr [rdi]")
    out("    sub edx, 48")
    out("    cmp edx, 9")
    out("    ja .sti_done")
    out("    imul rax, 10")
    out("    add rax, rdx")
    out("    inc rdi")
    out("    jmp .sti_loop")
    out(".sti_done:")
    out("    test cl, cl")
    out("    jz .sti_ret")
    out("    neg rax")
    out(".sti_ret:")
    out("    ret")

    // --- __arg(n) -> string or "" ---
    out("")
    out_label("_nova___arg")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    inc rdi")
    out("    cmp rdi, [rip + _g___argc]")
    out("    jge .arg_empty")
    out("    mov rax, [rip + _g___argv]")
    out("    mov rax, [rax + rdi*8]")
    out("    pop rbp")
    out("    ret")
    out(".arg_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop rbp")
    out("    ret")

    // --- pop(list) -> removes and returns last element ---
    out("")
    out_label("_nova_pop")
    out("    mov rax, [rdi+8]")
    out("    test rax, rax")
    out("    jz .pop_empty")
    out("    dec rax")
    out("    mov [rdi+8], rax")
    out("    mov rcx, [rdi+24]")
    out("    mov rax, [rcx+rax*8]")
    out("    ret")
    out(".pop_empty:")
    out("    xor eax, eax")
    out("    ret")

    // --- list_set(list, idx, val) -> sets list[idx] = val ---
    out("")
    out_label("_nova_list_set")
    out("    mov rax, [rdi+24]")
    out("    mov [rax+rsi*8], rdx")
    out("    ret")

    // --- contains(list, val) -> 1 if found, 0 if not ---
    out("")
    out_label("_nova_contains")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, [rdi+8]")
    out("    xor ecx, ecx")
    out(".contains_loop:")
    out("    cmp rcx, r14")
    out("    jge .contains_not_found")
    out("    mov rax, [r12+24]")
    out("    mov rdi, [rax+rcx*8]")
    out("    mov rsi, r13")
    out("    push rcx")
    out("    call _nova_eq")
    out("    pop rcx")
    out("    test rax, rax")
    out("    jnz .contains_found")
    out("    inc rcx")
    out("    jmp .contains_loop")
    out(".contains_found:")
    out("    mov eax, 1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".contains_not_found:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_remove(list, idx) -> removes element at idx, shifts remaining left ---
    out("")
    out_label("_nova_list_remove")
    out("    mov rax, [rdi+8]")
    out("    mov rcx, [rdi+24]")
    out("    mov r8, rsi")
    out(".lr_shift:")
    out("    lea r9, [r8+1]")
    out("    cmp r9, rax")
    out("    jge .lr_done")
    out("    mov r10, [rcx+r9*8]")
    out("    mov [rcx+r8*8], r10")
    out("    inc r8")
    out("    jmp .lr_shift")
    out(".lr_done:")
    out("    dec qword ptr [rdi+8]")
    out("    ret")

    // --- starts_with(str, prefix) -> 1 or 0 ---
    out("")
    out_label("_nova_starts_with")
    out("    xor eax, eax")
    out(".sw_loop:")
    out("    mov cl, [rsi]")
    out("    test cl, cl")
    out("    jz .sw_yes")
    out("    cmp cl, [rdi]")
    out("    jne .sw_no")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .sw_loop")
    out(".sw_yes:")
    out("    mov eax, 1")
    out(".sw_no:")
    out("    ret")

    // --- ends_with(str, suffix) -> 1 or 0 ---
    out("")
    out_label("_nova_ends_with")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov rcx, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    cmp rax, rcx")
    out("    ja .ew_no")
    out("    lea rdi, [r12+rcx]")
    out("    sub rdi, rax")
    out("    mov rsi, r13")
    out(".ew_loop:")
    out("    mov cl, [rsi]")
    out("    test cl, cl")
    out("    jz .ew_yes")
    out("    cmp cl, [rdi]")
    out("    jne .ew_no")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .ew_loop")
    out(".ew_yes:")
    out("    mov eax, 1")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ew_no:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_find(haystack, needle) -> index or -1 ---
    out("")
    out_label("_nova_str_find")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov r14, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    mov rcx, rax")
    out("    test rcx, rcx")
    out("    jz .sf_found_zero")
    out("    xor r8d, r8d")
    out(".sf_outer:")
    out("    lea rax, [r8+rcx]")
    out("    cmp rax, r14")
    out("    ja .sf_not_found")
    out("    xor r9d, r9d")
    out(".sf_inner:")
    out("    cmp r9, rcx")
    out("    jge .sf_found")
    out("    lea rax, [r12+r8]")
    out("    movzx edx, byte ptr [rax+r9]")
    out("    cmp dl, [r13+r9]")
    out("    jne .sf_next")
    out("    inc r9")
    out("    jmp .sf_inner")
    out(".sf_next:")
    out("    inc r8")
    out("    jmp .sf_outer")
    out(".sf_found:")
    out("    mov rax, r8")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".sf_found_zero:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".sf_not_found:")
    out("    mov rax, -1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

