    // --- str_to_chars: convert string to list of char codes ---
    out_label("_nova_str_to_chars")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    xor r13, r13")
    out(".stc_len:")
    out("    movzx rax, byte ptr [r12 + r13]")
    out("    test al, al")
    out("    jz .stc_got_len")
    out("    inc r13")
    out("    jmp .stc_len")
    out(".stc_got_len:")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r13, r13")
    out(".stc_loop:")
    out("    movzx rax, byte ptr [r12 + r13]")
    out("    test al, al")
    out("    jz .stc_done")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_push")
    out("    inc r13")
    out("    jmp .stc_loop")
    out(".stc_done:")
    out("    mov rax, r14")
    out("    add rsp, 8")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- Flow operators runtime (only emitted when flow ops are used) ---
    if cg_has_flow == 1 {

    // ~> forward flow: rdi=signal, rsi=node -> signal or 0
    out("")
    out_label("_nova_flow_fwd")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, r12")
    out("    mov rsi, rbx")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    call node_process")
    out("    mov rdi, r12")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_fwd_empty")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    jmp .flow_fwd_done")
    out(".flow_fwd_empty:")
    out("    xor eax, eax")
    out(".flow_fwd_done:")
    out("    add rsp, 8")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // <~ backward flow: rdi=signal, rsi=node -> reflected signal or 0
    out("")
    out_label("_nova_flow_bwd")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, rbx")
    out("    call signal_moment")
    out("    mov r13, rax")
    out("    mov rdi, rbx")
    out("    call signal_dest")
    out("    push rax")
    out("    mov rdi, rbx")
    out("    call signal_origin")
    out("    pop rsi")
    out("    mov rdx, rax")
    out("    mov rdi, r13")
    out("    call signal_reflection")
    out("    mov rbx, rax")
    out("    mov rdi, r12")
    out("    mov rsi, rbx")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    call node_process")
    out("    mov rdi, r12")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_bwd_empty")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    jmp .flow_bwd_done")
    out(".flow_bwd_empty:")
    out("    xor eax, eax")
    out(".flow_bwd_done:")
    out("    add rsp, 8")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // =>> broadcast: rdi=signal, rsi=node_list -> count
    out("")
    out_label("_nova_flow_broadcast")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, r12")
    out("    call _nova_len")
    out("    mov r13, rax")
    out("    xor r14d, r14d")
    out(".flow_bcast_loop:")
    out("    cmp r14, r13")
    out("    jge .flow_bcast_done")
    out("    mov rdi, r12")
    out("    mov rsi, r14")
    out("    call _nova_index")
    out("    mov rdi, rax")
    out("    mov rsi, rbx")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    mov rsi, r14")
    out("    call _nova_index")
    out("    mov rdi, rax")
    out("    call node_process")
    out("    inc r14")
    out("    jmp .flow_bcast_loop")
    out(".flow_bcast_done:")
    out("    mov rax, r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // <<~ enrichment: rdi=signal, rsi=rememberer_node -> enriched signal
    out("")
    out_label("_nova_flow_enrich")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, r12")
    out("    mov rsi, rbx")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    call node_process")
    out("    mov rdi, r12")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_enrich_noctx")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    mov rdi, rax")
    out("    call signal_moment")
    out("    mov rdx, rax")
    out("    mov rdi, rbx")
    out("    lea rsi, [rip + _flow_ctx_key]")
    out("    call signal_enrich")
    out(".flow_enrich_noctx:")
    out("    mov rax, rbx")
    out("    add rsp, 8")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // ~~> tentative flow: rdi=signal, rsi=node -> signal or 0
    out("")
    out_label("_nova_flow_tentative")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, rbx")
    out("    call signal_priority")
    out("    shr rax, 1")
    out("    mov rsi, rax")
    out("    mov rdi, rbx")
    out("    call signal_elevate")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out("    call _nova_flow_fwd")
    out("    add rsp, 8")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // <=> resonance: rdi=node_a, rsi=node_b -> signal or 0
    out("")
    out_label("_nova_flow_resonate")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, rbx")
    out("    call node_process")
    out("    mov rdi, rbx")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_res_empty")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    mov rdi, r12")
    out("    mov rsi, rax")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    call node_process")
    out("    mov rdi, r12")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_res_empty")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    mov r13, rax")
    out("    mov rdi, rbx")
    out("    mov rsi, r13")
    out("    call node_receive")
    out("    mov rax, r13")
    out("    jmp .flow_res_done")
    out(".flow_res_empty:")
    out("    xor eax, eax")
    out(".flow_res_done:")
    out("    add rsp, 8")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // |~> filtered flow: rdi=signal, rsi=node -> signal or 0
    out("")
    out_label("_nova_flow_filter")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, rbx")
    out("    call signal_moment")
    out("    mov rdi, rax")
    out("    call moment_salience")
    out("    push rax")
    out("    lea rdi, [rip + _flow_threshold_key]")
    out("    mov rsi, rdi")
    out("    mov rdi, r12")
    out("    call node_get_config")
    out("    test rax, rax")
    out("    jnz .flow_filt_has_thresh")
    out("    mov rax, 30")
    out(".flow_filt_has_thresh:")
    out("    pop rcx")
    out("    cmp rcx, rax")
    out("    jl .flow_filt_blocked")
    out("    mov rdi, rbx")
    out("    mov rsi, r12")
    out("    call _nova_flow_fwd")
    out("    jmp .flow_filt_done")
    out(".flow_filt_blocked:")
    out("    xor eax, eax")
    out(".flow_filt_done:")
    out("    add rsp, 8")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    } // end cg_has_flow

    // --- Data for runtime ---
    out("")
    out_section("rodata")
    out_label("_empty_str")
    out("    .asciz " + DQ + DQ)
    out_label("_err_null_access")
    out("    .asciz " + DQ + "Runtime error: null pointer access" + DQ)
    out_label("_err_index_oob")
    out("    .asciz " + DQ + "Runtime error: index out of bounds: " + DQ)
    out_label("_err_div_zero")
    out("    .asciz " + DQ + "Runtime error: division by zero" + DQ)
    out_label("_err_stack_overflow")
    out("    .asciz " + DQ + "Runtime error: stack overflow" + DQ)
    out_label("_err_newline")
    out("    .asciz " + DQ + "\\n" + DQ)
    out_label("_err_assert_prefix")
    out("    .asciz " + DQ + "Assertion failed: " + DQ)
    out_label("_err_uncaught")
    out("    .asciz " + DQ + "Uncaught exception" + DQ)
    out_label("_debug_sep")
    out("    .asciz " + DQ + ": " + DQ)
    out_label("_debug_null")
    out("    .asciz " + DQ + "null" + DQ)
    out_label("_debug_list_prefix")
    out("    .asciz " + DQ + "list[len=" + DQ)
    out_label("_debug_list_suffix")
    out("    .asciz " + DQ + "]" + DQ)
    out_label("_tn_none")
    out("    .asciz " + DQ + "none" + DQ)
    out_label("_tn_int")
    out("    .asciz " + DQ + "int" + DQ)
    out_label("_tn_str")
    out("    .asciz " + DQ + "str" + DQ)
    out_label("_tn_list")
    out("    .asciz " + DQ + "list" + DQ)
    out_label("_tn_map")
    out("    .asciz " + DQ + "map" + DQ)
    out_label("_float_dot")
    out("    .asciz " + DQ + "." + DQ)
    out_label("_float_minus")
    out("    .asciz " + DQ + "-" + DQ)
    out_label("_str_list_repr")
    out("    .asciz " + DQ + "[list]" + DQ)
    if cg_has_flow == 1 {
        out_label("_flow_ctx_key")
        out("    .asciz " + DQ + "context" + DQ)
        out_label("_flow_threshold_key")
        out("    .asciz " + DQ + "threshold" + DQ)
    }

    // --- Heap state in .bss ---
    out("")
    out_section("bss")
    out("    .align 8")
    out_label("_heap_base")
    out("    .quad 0")
    out_label("_heap_ptr")
    out("    .quad 0")
    out_label("_heap_end")
    out("    .quad 0")
    out_label("_rand_state")
    out("    .quad 0")
    out_label("_nova_error_flag")
    out("    .quad 0")
    out_label("_nova_error_value")
    out("    .quad 0")
    out_label("_nova_catch_stack")
    out("    .quad 0")
    out_label("_main_coro_ctx")
    out("    .space 56")
    out_label("_current_coro")
    out("    .quad 0")
}
