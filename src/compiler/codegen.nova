    // --- __intrinsic_dot_i32(a, b, n) -> int (AVX2; Linux x86-64) ---
    // Computes sum(a[i] * b[i]) for n int32 elements.
    // Args: rdi=a_ptr, rsi=b_ptr, rdx=n.
    // Returns: rax = int64-extended dot product.
    // Loop processes 8 int32s per iter via vmovdqu+vpmulld+vpaddd; tail is scalar.
    // Documented in SIMD_AUDIT.md.  Linux-only; Win64 / macOS callers must guard.
    out_label("__intrinsic_dot_i32")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")                    // rax = 0 (covers no-vector case)
        out("    vpxor ymm2, ymm2, ymm2")          // accumulator = 0
        out("    mov rcx, rdx")                    // rcx = n
        out("    shr rcx, 3")                      // rcx = n / 8 (vector iters)
        out("    test rcx, rcx")
        out("    jz .dot_i32_tail")
        out(".dot_i32_loop:")
        out("    vmovdqu ymm0, [rdi]")             // load 8 ints from A
        out("    vmovdqu ymm1, [rsi]")             // load 8 ints from B
        out("    vpmulld ymm0, ymm0, ymm1")        // lanewise 32-bit multiply
        out("    vpaddd ymm2, ymm2, ymm0")         // accumulate
        out("    add rdi, 32")
        out("    add rsi, 32")
        out("    dec rcx")
        out("    jnz .dot_i32_loop")
        // Horizontal reduce ymm2 (8 int32) -> rax (int64).
        // Pairwise: vphaddd ymm2, ymm2, ymm2 -> 4 sums in low 64 of each lane.
        // Again to fold pairs: still cross-lane garbage in upper half, so we
        // extract the upper 128 and add to lower 128, then phaddd twice in xmm.
        out("    vextracti128 xmm0, ymm2, 1")      // high 128 -> xmm0
        out("    vpaddd xmm2, xmm2, xmm0")         // sum of 4 lanes (in-lane)
        out("    vphaddd xmm2, xmm2, xmm2")        // pairs of pairs
        out("    vphaddd xmm2, xmm2, xmm2")        // all 4 -> low lane
        out("    vmovd eax, xmm2")                 // extract low int32
        out("    movsxd rax, eax")                 // sign-extend to int64
        out(".dot_i32_tail:")
        out("    and rdx, 7")                      // tail count = n & 7
        out("    test rdx, rdx")
        out("    jz .dot_i32_done")
        out(".dot_i32_tail_loop:")
        out("    mov r8d, [rdi]")                  // load int32 from A
        out("    imul r8d, [rsi]")                 // multiply by int32 from B
        out("    movsxd r9, r8d")
        out("    add rax, r9")                     // accumulate sign-extended
        out("    add rdi, 4")
        out("    add rsi, 4")
        out("    dec rdx")
        out("    jnz .dot_i32_tail_loop")
        out(".dot_i32_done:")
        // Zero ymm scratch to avoid SSE/AVX transition penalty for callers.
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        // Non-Linux targets get a scalar fallback so cross-compiles still link.
        // Win64 ABI: args in rcx, rdx, r8 (not rdi/rsi/rdx). macOS uses SysV.
        // We use SysV-style here; Windows callers are documented as unsafe.
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    test rdx, rdx")
        out("    jz .dot_i32s_done")
        out(".dot_i32s_loop:")
        out("    mov r8d, [rdi]")
        out("    imul r8d, [rsi]")
        out("    movsxd r9, r8d")
        out("    add rax, r9")
        out("    add rdi, 4")
        out("    add rsi, 4")
        out("    dec rdx")
        out("    jnz .dot_i32s_loop")
        out(".dot_i32s_done:")
        out("    pop rbp")
        out("    ret")
    }

    // === R11D SIMD i32x8 intrinsics ============================================
    //
    // ABI for every simd_* builtin: callers pass raw int32 buffer pointers.
    // A "SIMD value" is 32 bytes = 8 lanes of int32, allocated by the caller
    // via `alloc(32)`. The builtins are explicit -- NOVA's `+`/`*` operators
    // still dispatch to the smart-op classifier, so SIMD inputs never reach
    // those paths (they are just pointers to the classifier; users invoke
    // these builtins by name).
    //
    // Lowering:
    //   * cg_target == 0  (Linux x86-64)   : AVX2 (vpaddd/vpsubd/vpabsd)
    //   * cg_target == 1  (macOS x86-64)   : scalar loop fallback (no AVX2
    //                                        runtime guarantee on Apple silicon
    //                                        Rosetta / older Intel Macs)
    //   * cg_target == 3  (Windows x86-64) : scalar loop fallback
    //   * cg_target == 2  (WASM)           : scalar loop fallback (v128
    //                                        SIMD imports deferred -- see
    //                                        NEXT_SESSION.md)
    // ARM64 (cg_target == 4 / 5) emits its own NEON sequences in the arm_*
    // and warm_* call paths above; the labels below are x86-64 ELF/PE/Mach-O
    // only.

    // --- simd_add_i32x8(a_ptr, b_ptr, dst_ptr) -> dst_ptr ---
    // dst[0..8) = a[0..8) + b[0..8) lanewise.
    out_label("simd_add_i32x8")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu ymm1, [rsi]")
        out("    vpaddd ymm0, ymm0, ymm1")
        out("    vmovdqu [rdx], ymm0")
        out("    mov rax, rdx")
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        // Scalar fallback: 8 int32 adds.
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov r8, 0")
        out(".simd_addf_loop:")
        out("    mov eax, [rdi + r8 * 4]")
        out("    add eax, [rsi + r8 * 4]")
        out("    mov [rdx + r8 * 4], eax")
        out("    inc r8")
        out("    cmp r8, 8")
        out("    jl .simd_addf_loop")
        out("    mov rax, rdx")
        out("    pop rbp")
        out("    ret")
    }

    // --- simd_sub_i32x8(a_ptr, b_ptr, dst_ptr) -> dst_ptr ---
    // dst[0..8) = a[0..8) - b[0..8) lanewise.
    out_label("simd_sub_i32x8")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu ymm1, [rsi]")
        out("    vpsubd ymm0, ymm0, ymm1")
        out("    vmovdqu [rdx], ymm0")
        out("    mov rax, rdx")
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov r8, 0")
        out(".simd_subf_loop:")
        out("    mov eax, [rdi + r8 * 4]")
        out("    sub eax, [rsi + r8 * 4]")
        out("    mov [rdx + r8 * 4], eax")
        out("    inc r8")
        out("    cmp r8, 8")
        out("    jl .simd_subf_loop")
        out("    mov rax, rdx")
        out("    pop rbp")
        out("    ret")
    }

    // --- simd_load_i32x8(src_ptr, dst_ptr) -> dst_ptr ---
    // 32-byte aligned-or-unaligned copy via YMM (or scalar movs).
    out_label("simd_load_i32x8")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu [rsi], ymm0")
        out("    mov rax, rsi")
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov r8, 0")
        out(".simd_loadf_loop:")
        out("    mov eax, [rdi + r8 * 4]")
        out("    mov [rsi + r8 * 4], eax")
        out("    inc r8")
        out("    cmp r8, 8")
        out("    jl .simd_loadf_loop")
        out("    mov rax, rsi")
        out("    pop rbp")
        out("    ret")
    }

    // --- simd_store_i32x8(dst_ptr, src_ptr) -> dst_ptr ---
    // 32-byte store from a YMM register -- arg-order mirror of simd_load.
    out_label("simd_store_i32x8")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    vmovdqu ymm0, [rsi]")
        out("    vmovdqu [rdi], ymm0")
        out("    mov rax, rdi")
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov r8, 0")
        out(".simd_storef_loop:")
        out("    mov eax, [rsi + r8 * 4]")
        out("    mov [rdi + r8 * 4], eax")
        out("    inc r8")
        out("    cmp r8, 8")
        out("    jl .simd_storef_loop")
        out("    mov rax, rdi")
        out("    pop rbp")
        out("    ret")
    }

    // --- simd_sum_abs_diff(a_ptr, b_ptr, n) -> int ---
    // Sum of absolute differences over n int32 elements; the SAD building
    // block used by stereo block matching, optical flow, video coding etc.
    //
    // Calling convention: rdi=a_ptr, rsi=b_ptr, rdx=n. Returns int64 in
    // rax. Processes 8 int32s per iteration; tail is scalar.
    out_label("simd_sum_abs_diff")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    vpxor ymm2, ymm2, ymm2")            // accumulator (8 i32 lanes)
        out("    mov rcx, rdx")
        out("    shr rcx, 3")                        // rcx = n / 8
        out("    test rcx, rcx")
        out("    jz .sad_tail")
        out(".sad_loop:")
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu ymm1, [rsi]")
        // diff = a - b
        out("    vpsubd ymm3, ymm0, ymm1")
        // abs(diff): max(diff, -diff). For ymm SIMD on AVX2, use vpabsd.
        out("    vpabsd ymm3, ymm3")
        out("    vpaddd ymm2, ymm2, ymm3")
        out("    add rdi, 32")
        out("    add rsi, 32")
        out("    dec rcx")
        out("    jnz .sad_loop")
        // Horizontal reduce ymm2 (8 i32) -> rax.
        out("    vextracti128 xmm0, ymm2, 1")
        out("    vpaddd xmm2, xmm2, xmm0")           // 4 sums in xmm2
        out("    vphaddd xmm2, xmm2, xmm2")          // 2 sums
        out("    vphaddd xmm2, xmm2, xmm2")          // 1 sum
        out("    vmovd eax, xmm2")
        out("    movsxd rax, eax")
        out(".sad_tail:")
        out("    and rdx, 7")
        out("    test rdx, rdx")
        out("    jz .sad_done")
        out(".sad_tail_loop:")
        out("    mov r8d, [rdi]")
        out("    sub r8d, [rsi]")
        // abs(r8d): r9 = sign-extension mask; r8d ^= r9; r8d -= r9 (which is 0 or -1).
        out("    mov r9d, r8d")
        out("    sar r9d, 31")
        out("    xor r8d, r9d")
        out("    sub r8d, r9d")
        out("    movsxd r10, r8d")
        out("    add rax, r10")
        out("    add rdi, 4")
        out("    add rsi, 4")
        out("    dec rdx")
        out("    jnz .sad_tail_loop")
        out(".sad_done:")
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        // Scalar fallback for macOS / Windows / WASM x86-64.
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    test rdx, rdx")
        out("    jz .sads_done")
        out(".sads_loop:")
        out("    mov r8d, [rdi]")
        out("    sub r8d, [rsi]")
        out("    mov r9d, r8d")
        out("    sar r9d, 31")
        out("    xor r8d, r9d")
        out("    sub r8d, r9d")
        out("    movsxd r10, r8d")
        out("    add rax, r10")
        out("    add rdi, 4")
        out("    add rsi, 4")
        out("    dec rdx")
        out("    jnz .sads_loop")
        out(".sads_done:")
        out("    pop rbp")
        out("    ret")
    }

    // --- simd_sad_u8(a_ptr, b_ptr, n_bytes) -> int ---
    // R14B: byte-level SAD primitive. Skips the i32 staging that
    // simd_sum_abs_diff requires upstream: feeds 32 raw bytes per loop
    // iteration through AVX2 `vpsadbw`, which produces 4x i64 partial
    // sums in one instruction. Horizontal-sum reduces to scalar i64.
    //
    // Calling convention: rdi=a_ptr, rsi=b_ptr, rdx=n_bytes. Returns
    // int64 in rax. Caller-allocated raw byte buffers. Per-byte values
    // treated as unsigned (0..255) -- the absolute difference is always
    // in [0, 255] so the partial sums never overflow i64 even for
    // gigabyte-scale buffers.
    out_label("simd_sad_u8")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    vpxor ymm2, ymm2, ymm2")
        out("    mov rcx, rdx")
        out("    shr rcx, 5")
        out("    test rcx, rcx")
        out("    jz .sadu8_tail")
        out(".sadu8_loop:")
        out("    vmovdqu ymm0, [rdi]")
        out("    vmovdqu ymm1, [rsi]")
        out("    vpsadbw ymm3, ymm0, ymm1")
        out("    vpaddq ymm2, ymm2, ymm3")
        out("    add rdi, 32")
        out("    add rsi, 32")
        out("    dec rcx")
        out("    jnz .sadu8_loop")
        out("    vextracti128 xmm3, ymm2, 1")
        out("    vpaddq xmm2, xmm2, xmm3")
        out("    vpshufd xmm3, xmm2, 0x4e")
        out("    vpaddq xmm2, xmm2, xmm3")
        out("    vmovq rax, xmm2")
        out(".sadu8_tail:")
        out("    and rdx, 31")
        out("    test rdx, rdx")
        out("    jz .sadu8_done")
        out(".sadu8_tail_loop:")
        out("    movzx r8d, byte ptr [rdi]")
        out("    movzx r9d, byte ptr [rsi]")
        out("    sub r8d, r9d")
        out("    mov r9d, r8d")
        out("    sar r9d, 31")
        out("    xor r8d, r9d")
        out("    sub r8d, r9d")
        out("    movsxd r10, r8d")
        out("    add rax, r10")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz .sadu8_tail_loop")
        out(".sadu8_done:")
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    test rdx, rdx")
        out("    jz .sadu8s_done")
        out(".sadu8s_loop:")
        out("    movzx r8d, byte ptr [rdi]")
        out("    movzx r9d, byte ptr [rsi]")
        out("    sub r8d, r9d")
        out("    mov r9d, r8d")
        out("    sar r9d, 31")
        out("    xor r8d, r9d")
        out("    sub r8d, r9d")
        out("    movsxd r10, r8d")
        out("    add rax, r10")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz .sadu8s_loop")
        out(".sadu8s_done:")
        out("    pop rbp")
        out("    ret")
    }

    // --- simd_mul_acc_byte_signed_byte(a_u8, b_i8, n) -> int ---
    // R18A: byte-level multiply-accumulate primitive. Computes
    // Sum a[i] * b[i] over n bytes where a is treated as unsigned u8
    // and b is treated as signed i8 (asymmetric, Intel pmaddubsw shape).
    // Runtime label used by fn-pointer callers and as the cross-target
    // entry point (macOS/Windows x86-64 use the scalar fallback below;
    // ARM64 / WASM dispatch to their own helper / WAT body).
    //
    // x86-64 Linux uses vpmovzxbw + vpmovsxbw + vpmaddwd, 16 bytes/iter,
    // and horizontal-sums into i64. macOS/Windows fall back to a scalar
    // a*b loop with movzx/movsx + imul + sign-extend-to-i64 + add.
    out_label("simd_mul_acc_byte_signed_byte")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    vpxor ymm2, ymm2, ymm2")
        out("    mov rcx, rdx")
        out("    shr rcx, 4")
        out("    test rcx, rcx")
        out("    jz .mac_us_tail")
        out(".mac_us_loop:")
        out("    vpmovzxbw ymm0, [rdi]")
        out("    vpmovsxbw ymm1, [rsi]")
        out("    vpmaddwd ymm3, ymm0, ymm1")
        out("    vpaddd ymm2, ymm2, ymm3")
        out("    add rdi, 16")
        out("    add rsi, 16")
        out("    dec rcx")
        out("    jnz .mac_us_loop")
        out("    vextracti128 xmm3, ymm2, 1")
        out("    vpaddd xmm2, xmm2, xmm3")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vmovd eax, xmm2")
        out("    movsxd rax, eax")
        out(".mac_us_tail:")
        out("    and rdx, 15")
        out("    test rdx, rdx")
        out("    jz .mac_us_done")
        out(".mac_us_tail_loop:")
        out("    movzx r8d, byte ptr [rdi]")
        out("    movsx r9d, byte ptr [rsi]")
        out("    imul r8d, r9d")
        out("    movsxd r9, r8d")
        out("    add rax, r9")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz .mac_us_tail_loop")
        out(".mac_us_done:")
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    test rdx, rdx")
        out("    jz .mac_us_s_done")
        out(".mac_us_s_loop:")
        out("    movzx r8d, byte ptr [rdi]")
        out("    movsx r9d, byte ptr [rsi]")
        out("    imul r8d, r9d")
        out("    movsxd r9, r8d")
        out("    add rax, r9")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz .mac_us_s_loop")
        out(".mac_us_s_done:")
        out("    pop rbp")
        out("    ret")
    }

    // --- simd_mul_acc_signed_signed_byte(a_i8, b_i8, n) -> int ---
    // R18A: byte-level multiply-accumulate primitive for the LK
    // accumulator math (Ix*Ix, Iy*Iy, Ix*Iy, Ix*It, Iy*It). Both
    // operands are treated as signed i8 since LK gradients are
    // [-127, 127]. Same lowering shape as the unsigned/signed variant
    // but uses vpmovsxbw on BOTH operands (sign-extend instead of
    // zero-extend on the a side). Tail loop uses movsx on both bytes.
    out_label("simd_mul_acc_signed_signed_byte")
    if cg_target == 0 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    vpxor ymm2, ymm2, ymm2")
        out("    mov rcx, rdx")
        out("    shr rcx, 4")
        out("    test rcx, rcx")
        out("    jz .mac_ss_tail")
        out(".mac_ss_loop:")
        out("    vpmovsxbw ymm0, [rdi]")
        out("    vpmovsxbw ymm1, [rsi]")
        out("    vpmaddwd ymm3, ymm0, ymm1")
        out("    vpaddd ymm2, ymm2, ymm3")
        out("    add rdi, 16")
        out("    add rsi, 16")
        out("    dec rcx")
        out("    jnz .mac_ss_loop")
        out("    vextracti128 xmm3, ymm2, 1")
        out("    vpaddd xmm2, xmm2, xmm3")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vphaddd xmm2, xmm2, xmm2")
        out("    vmovd eax, xmm2")
        out("    movsxd rax, eax")
        out(".mac_ss_tail:")
        out("    and rdx, 15")
        out("    test rdx, rdx")
        out("    jz .mac_ss_done")
        out(".mac_ss_tail_loop:")
        out("    movsx r8d, byte ptr [rdi]")
        out("    movsx r9d, byte ptr [rsi]")
        out("    imul r8d, r9d")
        out("    movsxd r9, r8d")
        out("    add rax, r9")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz .mac_ss_tail_loop")
        out(".mac_ss_done:")
        out("    vzeroupper")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    xor eax, eax")
        out("    test rdx, rdx")
        out("    jz .mac_ss_s_done")
        out(".mac_ss_s_loop:")
        out("    movsx r8d, byte ptr [rdi]")
        out("    movsx r9d, byte ptr [rsi]")
        out("    imul r8d, r9d")
        out("    movsxd r9, r8d")
        out("    add rax, r9")
        out("    add rdi, 1")
        out("    add rsi, 1")
        out("    dec rdx")
        out("    jnz .mac_ss_s_loop")
        out(".mac_ss_s_done:")
        out("    pop rbp")
        out("    ret")
    }

    // --- str_to_chars: convert string to list of char codes ---
    out_label("_nova_str_to_chars")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    sub rsp, 8")
    out("    mov r12, rdi")
    out("    xor r13, r13")
    out(".stc_len:")
    out("    movzx rax, byte ptr [r12 + r13]")
    out("    test al, al")
    out("    jz .stc_got_len")
    out("    inc r13")
    out("    jmp .stc_len")
    out(".stc_got_len:")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r13, r13")
    out(".stc_loop:")
    out("    movzx rax, byte ptr [r12 + r13]")
    out("    test al, al")
    out("    jz .stc_done")
    out("    mov rdi, r14")
    out("    lea rsi, [rax + rax + 1]")    // tag char code
    out("    call _nova_push")
    out("    inc r13")
    out("    jmp .stc_loop")
    out(".stc_done:")
    out("    mov rax, r14")
    out("    add rsp, 8")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- Flow operators runtime (only emitted when flow ops are used) ---
    if cg_has_flow == 1 {

    // ~> forward flow: rdi=signal, rsi=node -> signal or 0
    out("")
    out_label("_nova_flow_fwd")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, r12")
    out("    mov rsi, rbx")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    call node_process")
    out("    mov rdi, r12")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_fwd_empty")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    jmp .flow_fwd_done")
    out(".flow_fwd_empty:")
    out("    xor eax, eax")
    out(".flow_fwd_done:")
    out("    add rsp, 8")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // <~ backward flow: rdi=signal, rsi=node -> reflected signal or 0
    out("")
    out_label("_nova_flow_bwd")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, rbx")
    out("    call signal_moment")
    out("    mov r13, rax")
    out("    mov rdi, rbx")
    out("    call signal_dest")
    out("    push rax")
    out("    mov rdi, rbx")
    out("    call signal_origin")
    out("    pop rsi")
    out("    mov rdx, rax")
    out("    mov rdi, r13")
    out("    call signal_reflection")
    out("    mov rbx, rax")
    out("    mov rdi, r12")
    out("    mov rsi, rbx")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    call node_process")
    out("    mov rdi, r12")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_bwd_empty")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    jmp .flow_bwd_done")
    out(".flow_bwd_empty:")
    out("    xor eax, eax")
    out(".flow_bwd_done:")
    out("    add rsp, 8")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // =>> broadcast: rdi=signal, rsi=node_list -> count
    out("")
    out_label("_nova_flow_broadcast")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, r12")
    out("    call _nova_len")
    out("    mov r13, rax")
    out("    xor r14d, r14d")
    out(".flow_bcast_loop:")
    out("    cmp r14, r13")
    out("    jge .flow_bcast_done")
    out("    mov rdi, r12")
    out("    mov rsi, r14")
    out("    call _nova_index")
    out("    mov rdi, rax")
    out("    mov rsi, rbx")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    mov rsi, r14")
    out("    call _nova_index")
    out("    mov rdi, rax")
    out("    call node_process")
    out("    inc r14")
    out("    jmp .flow_bcast_loop")
    out(".flow_bcast_done:")
    out("    mov rax, r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // <<~ enrichment: rdi=signal, rsi=rememberer_node -> enriched signal
    out("")
    out_label("_nova_flow_enrich")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, r12")
    out("    mov rsi, rbx")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    call node_process")
    out("    mov rdi, r12")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_enrich_noctx")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    mov rdi, rax")
    out("    call signal_moment")
    out("    mov rdx, rax")
    out("    mov rdi, rbx")
    out("    lea rsi, [rip + _flow_ctx_key]")
    out("    call signal_enrich")
    out(".flow_enrich_noctx:")
    out("    mov rax, rbx")
    out("    add rsp, 8")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // ~~> tentative flow: rdi=signal, rsi=node -> signal or 0
    out("")
    out_label("_nova_flow_tentative")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, rbx")
    out("    call signal_priority")
    out("    shr rax, 1")
    out("    mov rsi, rax")
    out("    mov rdi, rbx")
    out("    call signal_elevate")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out("    call _nova_flow_fwd")
    out("    add rsp, 8")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // <=> resonance: rdi=node_a, rsi=node_b -> signal or 0
    out("")
    out_label("_nova_flow_resonate")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    push r13")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, rbx")
    out("    call node_process")
    out("    mov rdi, rbx")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_res_empty")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    mov rdi, r12")
    out("    mov rsi, rax")
    out("    call node_receive")
    out("    mov rdi, r12")
    out("    call node_process")
    out("    mov rdi, r12")
    out("    call node_drain_outbox")
    out("    mov r13, rax")
    out("    mov rdi, r13")
    out("    call _nova_len")
    out("    cmp rax, 0")
    out("    je .flow_res_empty")
    out("    mov rdi, r13")
    out("    mov rsi, 0")
    out("    call _nova_index")
    out("    mov r13, rax")
    out("    mov rdi, rbx")
    out("    mov rsi, r13")
    out("    call node_receive")
    out("    mov rax, r13")
    out("    jmp .flow_res_done")
    out(".flow_res_empty:")
    out("    xor eax, eax")
    out(".flow_res_done:")
    out("    add rsp, 8")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    // |~> filtered flow: rdi=signal, rsi=node -> signal or 0
    out("")
    out_label("_nova_flow_filter")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push rbx")
    out("    push r12")
    out("    sub rsp, 8")
    out("    mov rbx, rdi")
    out("    mov r12, rsi")
    out("    mov rdi, rbx")
    out("    call signal_moment")
    out("    mov rdi, rax")
    out("    call moment_salience")
    out("    push rax")
    out("    lea rdi, [rip + _flow_threshold_key]")
    out("    mov rsi, rdi")
    out("    mov rdi, r12")
    out("    call node_get_config")
    out("    test rax, rax")
    out("    jnz .flow_filt_has_thresh")
    out("    mov rax, 30")
    out(".flow_filt_has_thresh:")
    out("    pop rcx")
    out("    cmp rcx, rax")
    out("    jl .flow_filt_blocked")
    out("    mov rdi, rbx")
    out("    mov rsi, r12")
    out("    call _nova_flow_fwd")
    out("    jmp .flow_filt_done")
    out(".flow_filt_blocked:")
    out("    xor eax, eax")
    out(".flow_filt_done:")
    out("    add rsp, 8")
    out("    pop r12")
    out("    pop rbx")
    out("    pop rbp")
    out("    ret")

    } // end cg_has_flow

    // --- Data for runtime ---
    out("")
    out_section("rodata")
    out_label("_empty_str")
    out("    .asciz " + DQ + DQ)
    out_label("_err_null_access")
    out("    .asciz " + DQ + "Runtime error: null pointer access" + DQ)
    out_label("_err_index_oob")
    out("    .asciz " + DQ + "Runtime error: index out of bounds: " + DQ)
    out_label("_err_div_zero")
    out("    .asciz " + DQ + "Runtime error: division by zero" + DQ)
    out_label("_err_stack_overflow")
    out("    .asciz " + DQ + "Runtime error: stack overflow" + DQ)
    out_label("_err_newline")
    out("    .asciz " + DQ + "\\n" + DQ)
    out_label("_err_assert_prefix")
    out("    .asciz " + DQ + "Assertion failed: " + DQ)
    out_label("_err_uncaught")
    out("    .asciz " + DQ + "Uncaught exception" + DQ)
    out_label("_debug_sep")
    out("    .asciz " + DQ + ": " + DQ)
    out_label("_debug_null")
    out("    .asciz " + DQ + "null" + DQ)
    out_label("_debug_list_prefix")
    out("    .asciz " + DQ + "list[len=" + DQ)
    out_label("_debug_list_suffix")
    out("    .asciz " + DQ + "]" + DQ)
    out_label("_tn_none")
    out("    .asciz " + DQ + "none" + DQ)
    out_label("_tn_int")
    out("    .asciz " + DQ + "int" + DQ)
    out_label("_tn_str")
    out("    .asciz " + DQ + "str" + DQ)
    out_label("_tn_list")
    out("    .asciz " + DQ + "list" + DQ)
    out_label("_tn_map")
    out("    .asciz " + DQ + "map" + DQ)
    out_label("_float_dot")
    out("    .asciz " + DQ + "." + DQ)
    out_label("_float_minus")
    out("    .asciz " + DQ + "-" + DQ)
    out_label("_str_list_repr")
    out("    .asciz " + DQ + "[list]" + DQ)
    // secure_random fallback path (Linux only, exercised when
    // getrandom syscall returns -ENOSYS on pre-3.17 kernels).
    out_label("_sr_urandom_path")
    out("    .asciz " + DQ + "/dev/urandom" + DQ)
    if cg_has_flow == 1 {
        out_label("_flow_ctx_key")
        out("    .asciz " + DQ + "context" + DQ)
        out_label("_flow_threshold_key")
        out("    .asciz " + DQ + "threshold" + DQ)
    }

    // _strlit_end is the upper bound of every string literal address used
    // by the pointer-classifier (gen_runtime _nova_check_rdi / _rsi). It
    // must come after every literal-emitting section to span them all.
    out_label("_strlit_end")

    // --- Heap state in .bss ---
    out("")
    out_section("bss")
    out("    .align 8")
    out_label("_heap_base")
    out("    .quad 0")
    out_label("_heap_ptr")
    out("    .quad 0")
    out_label("_heap_end")
    out("    .quad 0")
    out_label("_rand_state")
    out("    .quad 0")
    out_label("_nova_error_flag")
    out("    .quad 0")
    out_label("_nova_error_value")
    out("    .quad 0")
    out_label("_nova_catch_stack")
    out("    .quad 0")
    out_label("_main_coro_ctx")
    out("    .space 56")
    out_label("_current_coro")
    out("    .quad 0")
    // Windows-specific state slots (used only on cg_target == 3 paths).
    // _wsa_inited: 0 if WSAStartup not yet called, 1 if it has.
    out_label("_wsa_inited")
    out("    .quad 0")
    out_label("_win_wsadata")
    out("    .space 408")

    // --- FFI Runtime (only when --link-libc is used) ---
    if cg_link_libc == 1 {
        out("")
        out_section("text")

        // ffi_open(lib_path) -> handle
        out("")
        out_label("_nova_ffi_open")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov rsi, 1")
        out("    call dlopen")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_sym(handle, name) -> fn_ptr
        out("")
        out_label("_nova_ffi_sym")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    call dlsym")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_close(handle)
        out("")
        out_label("_nova_ffi_close")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    call dlclose")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_call0(fn_ptr) -> result
        out("")
        out_label("_nova_ffi_call0")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    xor eax, eax")
        out("    call r11")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_call1(fn_ptr, a1) -> result
        out("")
        out_label("_nova_ffi_call1")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    mov rdi, rsi")
        out("    xor eax, eax")
        out("    call r11")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_call2(fn_ptr, a1, a2) -> result
        out("")
        out_label("_nova_ffi_call2")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    mov rdi, rsi")
        out("    mov rsi, rdx")
        out("    xor eax, eax")
        out("    call r11")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_call3(fn_ptr, a1, a2, a3) -> result
        out("")
        out_label("_nova_ffi_call3")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    mov rdi, rsi")
        out("    mov rsi, rdx")
        out("    mov rdx, rcx")
        out("    xor eax, eax")
        out("    call r11")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_call4(fn_ptr, a1, a2, a3, a4) -> result
        out("")
        out_label("_nova_ffi_call4")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    mov rdi, rsi")
        out("    mov rsi, rdx")
        out("    mov rdx, rcx")
        out("    mov rcx, r8")
        out("    xor eax, eax")
        out("    call r11")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_call5(fn_ptr, a1, a2, a3, a4, a5) -> result
        out("")
        out_label("_nova_ffi_call5")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    mov rdi, rsi")
        out("    mov rsi, rdx")
        out("    mov rdx, rcx")
        out("    mov rcx, r8")
        out("    mov r8, r9")
        out("    xor eax, eax")
        out("    call r11")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_calln(fn_ptr, args_list) -> result
        // Loads args from list: 0-5 into rdi-r9, 6+ onto stack
        out("")
        out_label("_nova_ffi_calln")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    push r12")
        out("    push r13")
        out("    push r14")
        out("    push r15")
        out("    mov r12, rdi")
        out("    mov r13, rsi")
        out("    mov r14, [r13 + 8]")
        out("    mov r15, [r13 + 24]")
        out("    mov rax, r14")
        out("    cmp rax, 6")
        out("    jle .ffi_calln_no_stack")
        out("    sub rax, 6")
        out("    test rax, 1")
        out("    jz .ffi_calln_no_pad")
        out("    sub rsp, 8")
        out(".ffi_calln_no_pad:")
        out("    mov rcx, r14")
        out("    dec rcx")
        out(".ffi_calln_push:")
        out("    cmp rcx, 5")
        out("    jle .ffi_calln_no_stack")
        out("    push qword ptr [r15 + rcx*8]")
        out("    dec rcx")
        out("    jmp .ffi_calln_push")
        out(".ffi_calln_no_stack:")
        out("    cmp r14, 6")
        out("    jl .ffi_calln_s6")
        out("    mov r9, [r15 + 40]")
        out(".ffi_calln_s6:")
        out("    cmp r14, 5")
        out("    jl .ffi_calln_s5")
        out("    mov r8, [r15 + 32]")
        out(".ffi_calln_s5:")
        out("    cmp r14, 4")
        out("    jl .ffi_calln_s4")
        out("    mov rcx, [r15 + 24]")
        out(".ffi_calln_s4:")
        out("    cmp r14, 3")
        out("    jl .ffi_calln_s3")
        out("    mov rdx, [r15 + 16]")
        out(".ffi_calln_s3:")
        out("    cmp r14, 2")
        out("    jl .ffi_calln_s2")
        out("    mov rsi, [r15 + 8]")
        out(".ffi_calln_s2:")
        out("    cmp r14, 1")
        out("    jl .ffi_calln_call")
        out("    mov rdi, [r15]")
        out(".ffi_calln_call:")
        out("    xor eax, eax")
        out("    call r12")
        out("    lea rsp, [rbp - 32]")
        out("    pop r15")
        out("    pop r14")
        out("    pop r13")
        out("    pop r12")
        out("    pop rbp")
        out("    ret")

        // ffi_callf1(fn_ptr, f1) -> float result
        out("")
        out_label("_nova_ffi_callf1")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    movq xmm0, rsi")
        out("    mov al, 1")
        out("    call r11")
        out("    movq rax, xmm0")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_callf2(fn_ptr, f1, f2) -> float result
        out("")
        out_label("_nova_ffi_callf2")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    movq xmm0, rsi")
        out("    movq xmm1, rdx")
        out("    mov al, 2")
        out("    call r11")
        out("    movq rax, xmm0")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_callf3(fn_ptr, f1, f2, f3) -> float result
        out("")
        out_label("_nova_ffi_callf3")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    movq xmm0, rsi")
        out("    movq xmm1, rdx")
        out("    movq xmm2, rcx")
        out("    mov al, 3")
        out("    call r11")
        out("    movq rax, xmm0")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // ffi_callf4(fn_ptr, f1, f2, f3, f4) -> float result
        out("")
        out_label("_nova_ffi_callf4")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    mov r11, rdi")
        out("    movq xmm0, rsi")
        out("    movq xmm1, rdx")
        out("    movq xmm2, rcx")
        out("    movq xmm3, r8")
        out("    mov al, 4")
        out("    call r11")
        out("    movq rax, xmm0")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // system_exec(cmd_str) -> exit status
        out("")
        out_label("_nova_system_exec")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    and rsp, -16")
        out("    call system")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")

        // Dispatch trampolines for user-facing names
        out("")
        out_label("ffi_open")
        out("    jmp _nova_ffi_open")
        out_label("ffi_sym")
        out("    jmp _nova_ffi_sym")
        out_label("ffi_close")
        out("    jmp _nova_ffi_close")
        out_label("ffi_call0")
        out("    jmp _nova_ffi_call0")
        out_label("ffi_call1")
        out("    jmp _nova_ffi_call1")
        out_label("ffi_call2")
        out("    jmp _nova_ffi_call2")
        out_label("ffi_call3")
        out("    jmp _nova_ffi_call3")
        out_label("ffi_call4")
        out("    jmp _nova_ffi_call4")
        out_label("ffi_call5")
        out("    jmp _nova_ffi_call5")
        out_label("ffi_calln")
        out("    jmp _nova_ffi_calln")
        out_label("ffi_callf1")
        out("    jmp _nova_ffi_callf1")
        out_label("ffi_callf2")
        out("    jmp _nova_ffi_callf2")
        out_label("ffi_callf3")
        out("    jmp _nova_ffi_callf3")
        out_label("ffi_callf4")
        out("    jmp _nova_ffi_callf4")
        out_label("system_exec")
        out("    jmp _nova_system_exec")
    }
}
