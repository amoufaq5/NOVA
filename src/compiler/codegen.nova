    // --- close_fd(fd) -> 0 or error ---
    out("")
    out_label("_nova_close_fd")
    out("    mov rax, 3")
    out("    syscall")
    out("    ret")

    // --- make_sockaddr_in(port, ip_addr) -> pointer to sockaddr_in struct ---
    out("")
    out_label("_nova_make_sockaddr_in")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov rdi, 16")
    out("    call _nova_alloc")
    out("    mov word ptr [rax], 2")
    out("    mov rcx, r12")
    out("    xchg cl, ch")
    out("    mov [rax + 2], cx")
    out("    mov [rax + 4], r13d")
    out("    mov qword ptr [rax + 8], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- fork() -> pid (0 in child, >0 in parent) ---
    out("")
    out_label("_nova_fork")
    out("    mov rax, 57")
    out("    syscall")
    out("    ret")

    // --- waitpid(pid) -> exit status ---
    out("")
    out_label("_nova_waitpid")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    out("    lea rsi, [rbp - 8]")
    out("    xor edx, edx")
    out("    mov rax, 61")
    out("    xor r10d, r10d")
    out("    syscall")
    out("    mov eax, [rbp - 8]")
    out("    shr eax, 8")
    out("    and eax, 255")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- exec(path, argv) -> doesn't return on success ---
    out("")
    out_label("_nova_exec")
    out("    mov rdx, 0")
    out("    mov rax, 59")
    out("    syscall")
    out("    ret")

    // --- pipe() -> list of [read_fd, write_fd] ---
    out("")
    out_label("_nova_pipe")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    out("    lea rdi, [rbp - 8]")
    out("    mov rax, 22")
    out("    syscall")
    out("    call _nova_list_new")
    out("    push rax")
    out("    mov edi, [rbp - 8]")
    out("    movsx rdi, edi")
    out("    mov rsi, rdi")
    out("    mov rdi, [rsp]")
    out("    call _nova_push")
    out("    mov edi, [rbp - 4]")
    out("    movsx rdi, edi")
    out("    mov rsi, rdi")
    out("    mov rdi, [rsp]")
    out("    call _nova_push")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- Division by zero handler ---
    out("")
    out_label("_div_zero_handler")
    out("    lea rdi, [rip + _err_div_zero]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    mov rax, 60")
    out("    syscall")

    // --- assert(condition, message) ---
    out("")
    out_label("_nova_assert")
    out("    test rdi, rdi")
    out("    jnz .assert_ok")
    out("    push rsi")
    out("    lea rdi, [rip + _err_assert_prefix]")
    out("    call _nova_print_str")
    out("    pop rdi")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    mov rax, 60")
    out("    syscall")
    out(".assert_ok:")
    out("    ret")

    // --- type_of(value) -> int (0=null, 1=int, 2=string, 3=list) ---
    out("")
    out_label("_nova_type_of")
    out("    test rdi, rdi")
    out("    jz .to_null")
    out("    cmp rdi, 4096")
    out("    jl .to_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .to_list")
    out("    mov eax, 2")
    out("    ret")
    out(".to_null:")
    out("    xor eax, eax")
    out("    ret")
    out(".to_int:")
    out("    mov eax, 1")
    out("    ret")
    out(".to_list:")
    out("    mov eax, 3")
    out("    ret")

    // --- debug_print(label, value) ---
    out("")
    out_label("_nova_debug_print")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    mov r12, rsi")
    out("    call _nova_print_str")
    out("    lea rdi, [rip + _debug_sep]")
    out("    call _nova_print_str")
    out("    mov rdi, r12")
    out("    test rdi, rdi")
    out("    jz .dp_null")
    out("    cmp rdi, 4096")
    out("    jl .dp_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .dp_list")
    out("    call _nova_println")
    out("    jmp .dp_done")
    out(".dp_null:")
    out("    lea rdi, [rip + _debug_null]")
    out("    call _nova_println")
    out("    jmp .dp_done")
    out(".dp_int:")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _err_newline]")
    out("    call _nova_print_str")
    out("    jmp .dp_done")
    out(".dp_list:")
    out("    lea rdi, [rip + _debug_list_prefix]")
    out("    call _nova_print_str")
    out("    mov rdi, r12")
    out("    mov rdi, [rdi + 8]")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _debug_list_suffix]")
    out("    call _nova_println")
    out(".dp_done:")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- hex(n) -> hex string with "0x" prefix ---
    out("")
    out_label("_nova_hex")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rax, rdi")
    out("    lea rsi, [rbp - 1]")
    out("    mov byte ptr [rsi], 0")
    out("    test rax, rax")
    out("    jnz .hex_nonzero")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    jmp .hex_prefix")
    out(".hex_nonzero:")
    out(".hex_loop:")
    out("    test rax, rax")
    out("    jz .hex_prefix")
    out("    mov rcx, rax")
    out("    and rcx, 0xF")
    out("    cmp rcx, 10")
    out("    jl .hex_digit")
    out("    add cl, 87")
    out("    jmp .hex_store")
    out(".hex_digit:")
    out("    add cl, 48")
    out(".hex_store:")
    out("    dec rsi")
    out("    mov [rsi], cl")
    out("    shr rax, 4")
    out("    jmp .hex_loop")
    out(".hex_prefix:")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 120")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    mov rdi, rsi")
    out("    call _nova_strlen")
    out("    inc rax")
    out("    mov r12, rdi")
    out("    mov rdi, rax")
    out("    push r12")
    out("    call _nova_alloc")
    out("    pop rsi")
    out("    mov rdi, rax")
    out("    push rax")
    out(".hex_cp:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .hex_cp")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- read_line() -> string (read line from stdin) ---
    out("")
    out_label("_nova_read_line")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov rdi, 1024")
    out("    call _nova_alloc")
    out("    mov r12, rax")
    out("    xor r13d, r13d")
    out(".rl_loop:")
    out("    xor edi, edi")
    out("    lea rsi, [r12 + r13]")
    out("    mov rdx, 1")
    out("    xor eax, eax")
    out("    syscall")
    out("    cmp rax, 0")
    out("    jle .rl_done")
    out("    movzx eax, byte ptr [r12 + r13]")
    out("    cmp al, 10")
    out("    je .rl_done")
    out("    inc r13")
    out("    cmp r13, 1023")
    out("    jl .rl_loop")
    out(".rl_done:")
    out("    mov byte ptr [r12 + r13], 0")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- read_stdin(n) -> string (read n bytes from stdin) ---
    out("")
    out_label("_nova_read_stdin")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r13, rdi")
    out("    lea rdi, [r13 + 1]")
    out("    call _nova_alloc")
    out("    mov r12, rax")
    out("    xor edi, edi")
    out("    mov rsi, r12")
    out("    mov rdx, r13")
    out("    xor eax, eax")
    out("    syscall")
    out("    cmp rax, 0")
    out("    jl .rs_fail")
    out("    mov byte ptr [r12 + rax], 0")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".rs_fail:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- getenv(name) -> string or 0 ---
    out("")
    out_label("_nova_getenv")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_strlen")
    out("    mov r13, rax")
    out("    mov rdi, [rip + _g___envp]")
    out("    test rdi, rdi")
    out("    jz .ge_not_found")
    out(".ge_loop:")
    out("    mov rsi, [rdi]")
    out("    test rsi, rsi")
    out("    jz .ge_not_found")
    out("    push rdi")
    out("    mov rdi, r12")
    out("    mov rcx, r13")
    out("    xor eax, eax")
    out(".ge_cmp:")
    out("    test rcx, rcx")
    out("    jz .ge_check_eq")
    out("    movzx edx, byte ptr [rdi + rax]")
    out("    cmp dl, [rsi + rax]")
    out("    jne .ge_next")
    out("    inc rax")
    out("    dec rcx")
    out("    jmp .ge_cmp")
    out(".ge_check_eq:")
    out("    cmp byte ptr [rsi + r13], 61")
    out("    jne .ge_next")
    out("    lea rax, [rsi + r13 + 1]")
    out("    pop rdi")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ge_next:")
    out("    pop rdi")
    out("    add rdi, 8")
    out("    jmp .ge_loop")
    out(".ge_not_found:")
    out("    xor eax, eax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- random(max) -> pseudo-random integer 0 to max-1 ---
    out("")
    out_label("_nova_random")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rcx, rdi")
    out("    mov rax, [rip + _rand_state]")
    out("    test rax, rax")
    out("    jnz .rand_have_seed")
    out("    sub rsp, 16")
    out("    xor edi, edi")
    out("    lea rsi, [rsp]")
    out("    mov rax, 228")
    out("    syscall")
    out("    mov rax, [rsp]")
    out("    xor rax, [rsp + 8]")
    out("    add rsp, 16")
    out("    test rax, rax")
    out("    jnz .rand_have_seed")
    out("    mov rax, 0x123456789ABCDEF0")
    out(".rand_have_seed:")
    out("    mov rdx, rax")
    out("    shl rdx, 13")
    out("    xor rax, rdx")
    out("    mov rdx, rax")
    out("    shr rdx, 7")
    out("    xor rax, rdx")
    out("    mov rdx, rax")
    out("    shl rdx, 17")
    out("    xor rax, rdx")
    out("    mov [rip + _rand_state], rax")
    out("    test rax, rax")
    out("    jns .rand_pos")
    out("    neg rax")
    out(".rand_pos:")
    out("    xor edx, edx")
    out("    div rcx")
    out("    mov rax, rdx")
    out("    pop rbp")
    out("    ret")

    // --- random_seed(n) -> set PRNG seed ---
    out("")
    out_label("_nova_random_seed")
    out("    mov [rip + _rand_state], rdi")
    out("    ret")

    // --- map_new() -> map pointer ---
    // Map layout: [magic=-2, count, capacity, entries_ptr] (32 bytes)
    // Entry layout: [key, value, occupied] = 24 bytes per entry
    out("")
    out_label("_nova_map_new")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rdi, 32")
    out("    call _nova_alloc")
    out("    mov qword ptr [rax], -2")
    out("    mov qword ptr [rax + 8], 0")
    out("    mov qword ptr [rax + 16], 16")
    out("    push rax")
    out("    mov rdi, 384")
    out("    call _nova_alloc")
    out("    mov rdi, rax")
    out("    mov rcx, 48")
    out("    xor eax, eax")
    out("    rep stosq")
    out("    mov rax, rdi")
    out("    sub rax, 384")
    out("    pop rcx")
    out("    mov [rcx + 24], rax")
    out("    mov rax, rcx")
    out("    pop rbp")
    out("    ret")

    // --- map_set(map, key, value) ---
    out("")
    out_label("_nova_map_set")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, rdx")
    out("    mov rax, rsi")
    out("    test rax, rax")
    out("    jns .ms_pos")
    out("    neg rax")
    out(".ms_pos:")
    out("    xor edx, edx")
    out("    div qword ptr [r12 + 16]")
    out("    mov rcx, rdx")
    out("    mov rdi, [r12 + 24]")
    out(".ms_probe:")
    out("    mov rax, rcx")
    out("    imul rax, 24")
    out("    add rax, rdi")
    out("    cmp qword ptr [rax + 16], 0")
    out("    je .ms_insert")
    out("    cmp [rax], r13")
    out("    je .ms_update")
    out("    inc rcx")
    out("    cmp rcx, [r12 + 16]")
    out("    jl .ms_probe")
    out("    xor ecx, ecx")
    out("    jmp .ms_probe")
    out(".ms_insert:")
    out("    mov [rax], r13")
    out("    mov [rax + 8], r14")
    out("    mov qword ptr [rax + 16], 1")
    out("    inc qword ptr [r12 + 8]")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ms_update:")
    out("    mov [rax + 8], r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- map_get(map, key) -> value or 0 ---
    out("")
    out_label("_nova_map_get")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rax, rsi")
    out("    test rax, rax")
    out("    jns .mg_pos")
    out("    neg rax")
    out(".mg_pos:")
    out("    xor edx, edx")
    out("    div qword ptr [rdi + 16]")
    out("    mov rcx, rdx")
    out("    mov r8, [rdi + 24]")
    out("    mov r9, [rdi + 16]")
    out("    xor r10d, r10d")
    out(".mg_probe:")
    out("    cmp r10, r9")
    out("    jge .mg_not_found")
    out("    mov rax, rcx")
    out("    imul rax, 24")
    out("    add rax, r8")
    out("    cmp qword ptr [rax + 16], 0")
    out("    je .mg_not_found")
    out("    cmp [rax], rsi")
    out("    je .mg_found")
    out("    inc rcx")
    out("    cmp rcx, r9")
    out("    jl .mg_no_wrap")
    out("    xor ecx, ecx")
    out(".mg_no_wrap:")
    out("    inc r10")
    out("    jmp .mg_probe")
    out(".mg_found:")
    out("    mov rax, [rax + 8]")
    out("    pop rbp")
    out("    ret")
    out(".mg_not_found:")
    out("    xor eax, eax")
    out("    pop rbp")
    out("    ret")

    // --- map_has(map, key) -> 1 or 0 ---
    out("")
    out_label("_nova_map_has")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_map_get")
    out("    test rax, rax")
    out("    jz .mh_no")
    out("    mov eax, 1")
    out("    pop rbp")
    out("    ret")
    out(".mh_no:")
    out("    xor eax, eax")
    out("    pop rbp")
    out("    ret")

    // --- join(list, separator) -> string ---
    out("")
    out_label("_nova_join")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, [rdi + 8]")
    out("    lea rax, [rip + _empty_str]")
    out("    mov r15, rax")
    out("    xor ebx, ebx")
    out("    test r14, r14")
    out("    jz .join_done")
    out(".join_loop:")
    out("    cmp rbx, r14")
    out("    jge .join_done")
    out("    test rbx, rbx")
    out("    jz .join_no_sep")
    out("    mov rdi, r15")
    out("    mov rsi, r13")
    out("    call _nova_concat")
    out("    mov r15, rax")
    out(".join_no_sep:")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rbx*8]")
    out("    mov rdi, r15")
    out("    call _nova_concat")
    out("    mov r15, rax")
    out("    inc rbx")
    out("    jmp .join_loop")
    out(".join_done:")
    out("    mov rax, r15")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- split(str, delimiter_char) -> list of strings ---
    out("")
    out_label("_nova_split")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    push rbx")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r15d, r15d")
    out("    xor ebx, ebx")
    out(".split_loop:")
    out("    movzx eax, byte ptr [r12 + rbx]")
    out("    test al, al")
    out("    jz .split_last")
    out("    cmp al, r13b")
    out("    je .split_found")
    out("    inc rbx")
    out("    jmp .split_loop")
    out(".split_found:")
    out("    mov rdi, r12")
    out("    mov rsi, r15")
    out("    mov rdx, rbx")
    out("    sub rdx, r15")
    out("    call _nova_substr")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_push")
    out("    inc rbx")
    out("    mov r15, rbx")
    out("    jmp .split_loop")
    out(".split_last:")
    out("    mov rdi, r12")
    out("    mov rsi, r15")
    out("    mov rdx, rbx")
    out("    sub rdx, r15")
    out("    call _nova_substr")
    out("    mov rdi, r14")
    out("    mov rsi, rax")
    out("    call _nova_push")
    out("    mov rax, r14")
    out("    pop rbx")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- reverse(list) -> new reversed list ---
    out("")
    out_label("_nova_reverse")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, [rdi + 8]")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    mov rcx, r13")
    out("    dec rcx")
    out(".rev_loop:")
    out("    cmp rcx, 0")
    out("    jl .rev_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    mov rdi, r14")
    out("    push rcx")
    out("    call _nova_push")
    out("    pop rcx")
    out("    dec rcx")
    out("    jmp .rev_loop")
    out(".rev_done:")
    out("    mov rax, r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- sort(list) -> sorts list in place (insertion sort) ---
    out("")
    out_label("_nova_sort")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, [rdi + 8]")
    out("    cmp r13, 2")
    out("    jl .sort_done")
    out("    mov rdi, [r12 + 24]")
    out("    mov rcx, 1")
    out(".sort_outer:")
    out("    cmp rcx, r13")
    out("    jge .sort_done")
    out("    mov rax, [rdi + rcx*8]")
    out("    mov rdx, rcx")
    out("    dec rdx")
    out(".sort_inner:")
    out("    cmp rdx, 0")
    out("    jl .sort_place")
    out("    cmp [rdi + rdx*8], rax")
    out("    jle .sort_place")
    out("    mov r8, [rdi + rdx*8]")
    out("    mov [rdi + rdx*8 + 8], r8")
    out("    dec rdx")
    out("    jmp .sort_inner")
    out(".sort_place:")
    out("    inc rdx")
    out("    mov [rdi + rdx*8], rax")
    out("    inc rcx")
    out("    jmp .sort_outer")
    out(".sort_done:")
    out("    mov rax, r12")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- float_mul(a, b) -> (a * b) / 1000 ---
    out("")
    out_label("_nova_float_mul")
    out("    mov rax, rdi")
    out("    imul rsi")
    out("    mov rcx, 1000")
    out("    cqo")
    out("    idiv rcx")
    out("    ret")

    // --- float_div(a, b) -> (a * 1000) / b ---
    out("")
    out_label("_nova_float_div")
    out("    mov rax, rdi")
    out("    mov rcx, 1000")
    out("    imul rcx")
    out("    idiv rsi")
    out("    ret")

    // --- to_float(n) -> n * 1000 ---
    out("")
    out_label("_nova_to_float")
    out("    mov rax, rdi")
    out("    imul rax, 1000")
    out("    ret")

    // --- from_float(f) -> f / 1000 ---
    out("")
    out_label("_nova_from_float")
    out("    mov rax, rdi")
    out("    cqo")
    out("    mov rcx, 1000")
    out("    idiv rcx")
    out("    ret")

    // --- float_to_str(n) -> string like "3.140" ---
    // Uses only stack slots (no callee-saved regs, since runtime clobbers them)
    // [rbp-8]=frac, [rbp-16]=neg_flag, [rbp-24]=result_str
    // [rbp-32..rbp-29]=frac digit buffer
    out("")
    out_label("_nova_float_to_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 48")
    // Handle negative: store flag at [rbp-16]
    out("    mov qword ptr [rbp - 16], 0")
    out("    test rdi, rdi")
    out("    jns .fts_pos")
    out("    mov qword ptr [rbp - 16], 1")
    out("    neg rdi")
    out(".fts_pos:")
    // Split: integer = rdi/1000, frac = rdi%1000
    out("    mov rax, rdi")
    out("    xor edx, edx")
    out("    mov rcx, 1000")
    out("    div rcx")
    out("    mov [rbp - 8], rdx")
    // Convert integer part to string
    out("    mov rdi, rax")
    out("    call _nova_int_to_str")
    out("    mov [rbp - 24], rax")
    // If negative, prepend "-"
    out("    cmp qword ptr [rbp - 16], 0")
    out("    je .fts_no_sign")
    out("    lea rdi, [rip + _float_minus]")
    out("    mov rsi, [rbp - 24]")
    out("    call _nova_concat")
    out("    mov [rbp - 24], rax")
    out(".fts_no_sign:")
    // Append "."
    out("    mov rdi, [rbp - 24]")
    out("    lea rsi, [rip + _float_dot]")
    out("    call _nova_concat")
    out("    mov [rbp - 24], rax")
    // Compute 3 fractional digits from [rbp-8] (0..999)
    out("    mov rax, [rbp - 8]")
    out("    xor edx, edx")
    out("    mov rcx, 100")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 32], al")
    out("    mov rax, rdx")
    out("    xor edx, edx")
    out("    mov rcx, 10")
    out("    div rcx")
    out("    add al, 48")
    out("    mov [rbp - 31], al")
    out("    add dl, 48")
    out("    mov [rbp - 30], dl")
    out("    mov byte ptr [rbp - 29], 0")
    // Append fractional digits
    out("    mov rdi, [rbp - 24]")
    out("    lea rsi, [rbp - 32]")
    out("    call _nova_concat")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- to_str(value) -> string representation ---
    // If value < 4096: treat as integer, convert via int_to_str
    // If value >= 4096 and [value] == -1: it's a list, return "[list]"
    // Otherwise: it's already a string, return as-is
    out("")
    out_label("_nova_to_str")
    out("    cmp rdi, 4096")
    out("    jl .ts_int")
    out("    cmp qword ptr [rdi], -1")
    out("    je .ts_list")
    out("    mov rax, rdi")
    out("    ret")
    out(".ts_int:")
    out("    jmp _nova_int_to_str")
    out(".ts_list:")
    out("    lea rax, [rip + _str_list_repr]")
    out("    ret")

    // --- map_list(list, fn): create new list by applying fn to each element ---
    out("")
    out_label("_nova_map_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")  // source list
    out("    mov r13, rsi")  // function pointer
    out("    call _nova_list_new")
    out("    mov r14, rax")  // result list
    out("    xor r15d, r15d")  // index
    out(".ml_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .ml_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r15*8]")
    out("    mov r11, r13")
    out("    call r11")
    out("    mov rsi, rax")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out("    inc r15")
    out("    jmp .ml_loop")
    out(".ml_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- filter(list, fn): new list with elements where fn returns non-zero ---
    out("")
    out_label("_nova_filter")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r15d, r15d")
    out(".fl_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .fl_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r15*8]")
    out("    push rdi")
    out("    mov r11, r13")
    out("    call r11")
    out("    pop rdi")
    out("    test rax, rax")
    out("    jz .fl_skip")
    out("    mov rsi, rdi")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out(".fl_skip:")
    out("    inc r15")
    out("    jmp .fl_loop")
    out(".fl_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- reduce(list, fn, init): accumulate with fn(acc, elem) ---
    out("")
    out_label("_nova_reduce")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")  // list
    out("    mov r13, rsi")  // function
    out("    mov r14, rdx")  // accumulator
    out("    xor r15d, r15d")
    out(".rd_loop:")
    out("    cmp r15, [r12 + 8]")
    out("    jge .rd_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + r15*8]")
    out("    mov rdi, r14")
    out("    mov r11, r13")
    out("    call r11")
    out("    mov r14, rax")
    out("    inc r15")
    out("    jmp .rd_loop")
    out(".rd_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- foreach(list, fn): call fn(elem) for each, return 0 ---
    out("")
    out_label("_nova_foreach")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out(".fe_loop:")
    out("    cmp r14, [r12 + 8]")
    out("    jge .fe_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rdi, [rax + r14*8]")
    out("    mov r11, r13")
    out("    call r11")
    out("    inc r14")
    out("    jmp .fe_loop")
    out(".fe_done:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- keys(map): return list of keys ---
    out("")
    out_label("_nova_keys")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 8]")  // capacity
    out("    xor ecx, ecx")
    out(".keys_loop:")
    out("    cmp rcx, r14")
    out("    jge .keys_done")
    out("    mov rax, [r12 + 24]")  // entries_ptr
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")  // occupied?
    out("    je .keys_skip")
    out("    push rcx")
    out("    mov rsi, [rdi]")  // key
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out(".keys_skip:")
    out("    inc rcx")
    out("    jmp .keys_loop")
    out(".keys_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- values(map): return list of values ---
    out("")
    out_label("_nova_values")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    mov r14, [r12 + 8]")
    out("    xor ecx, ecx")
    out(".vals_loop:")
    out("    cmp rcx, r14")
    out("    jge .vals_done")
    out("    mov rax, [r12 + 24]")
    out("    imul rdi, rcx, 24")
    out("    add rdi, rax")
    out("    cmp qword ptr [rdi + 16], 0")
    out("    je .vals_skip")
    out("    push rcx")
    out("    mov rsi, [rdi + 8]")  // value
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out(".vals_skip:")
    out("    inc rcx")
    out("    jmp .vals_loop")
    out(".vals_done:")
    out("    mov rax, r13")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_upper(str): uppercase a string ---
    out("")
    out_label("_nova_str_upper")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    out("    lea rdi, [rax + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    xor ecx, ecx")
    out(".su_loop:")
    out("    cmp rcx, r13")
    out("    jge .su_done")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 97")
    out("    jl .su_copy")
    out("    cmp dl, 122")
    out("    jg .su_copy")
    out("    sub dl, 32")
    out(".su_copy:")
    out("    mov rax, [rsp]")
    out("    mov [rax + rcx], dl")
    out("    inc rcx")
    out("    jmp .su_loop")
    out(".su_done:")
    out("    pop rax")
    out("    mov byte ptr [rax + r13], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_lower(str): lowercase a string ---
    out("")
    out_label("_nova_str_lower")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    out("    lea rdi, [rax + 1]")
    out("    call _nova_alloc")
    out("    push rax")
    out("    xor ecx, ecx")
    out(".slw_loop:")
    out("    cmp rcx, r13")
    out("    jge .slw_done")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 65")
    out("    jl .slw_copy")
    out("    cmp dl, 90")
    out("    jg .slw_copy")
    out("    add dl, 32")
    out(".slw_copy:")
    out("    mov rax, [rsp]")
    out("    mov [rax + rcx], dl")
    out("    inc rcx")
    out("    jmp .slw_loop")
    out(".slw_done:")
    out("    pop rax")
    out("    mov byte ptr [rax + r13], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_trim(str): trim leading/trailing whitespace ---
    out("")
    out_label("_nova_str_trim")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_str_len")
    out("    mov r13, rax")
    // find start (skip whitespace)
    out("    xor ecx, ecx")
    out(".st_lead:")
    out("    cmp rcx, r13")
    out("    jge .st_empty")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 32")
    out("    je .st_lead_next")
    out("    cmp dl, 9")
    out("    je .st_lead_next")
    out("    cmp dl, 10")
    out("    je .st_lead_next")
    out("    cmp dl, 13")
    out("    je .st_lead_next")
    out("    jmp .st_find_end")
    out(".st_lead_next:")
    out("    inc rcx")
    out("    jmp .st_lead")
    out(".st_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".st_find_end:")
    out("    mov rsi, rcx")  // start
    out("    mov rcx, r13")
    out("    dec rcx")
    out(".st_trail:")
    out("    movzx edx, byte ptr [r12 + rcx]")
    out("    cmp dl, 32")
    out("    je .st_trail_next")
    out("    cmp dl, 9")
    out("    je .st_trail_next")
    out("    cmp dl, 10")
    out("    je .st_trail_next")
    out("    cmp dl, 13")
    out("    je .st_trail_next")
    out("    jmp .st_copy")
    out(".st_trail_next:")
    out("    dec rcx")
    out("    jmp .st_trail")
    out(".st_copy:")
    out("    inc rcx")
    out("    sub rcx, rsi")  // length
    out("    mov rdi, r12")
    out("    add rdi, rsi")  // src start
    out("    mov rsi, rcx")  // length
    // substr(src+start, 0, len)
    out("    push rcx")
    out("    push rdi")
    out("    lea rdi, [rcx + 1]")
    out("    call _nova_alloc")
    out("    pop rdi")
    out("    pop rcx")
    out("    push rax")
    out("    mov rsi, rdi")
    out("    pop rdi")
    out("    push rdi")
    // copy rcx bytes from rsi to rdi
    out("    xor r8d, r8d")
    out(".st_cloop:")
    out("    cmp r8, rcx")
    out("    jge .st_cdone")
    out("    movzx edx, byte ptr [rsi + r8]")
    out("    mov [rdi + r8], dl")
    out("    inc r8")
    out("    jmp .st_cloop")
    out(".st_cdone:")
    out("    pop rax")
    out("    mov byte ptr [rax + rcx], 0")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_replace(str, old, new): replace all occurrences ---
    out("")
    out_label("_nova_str_replace")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")  // source
    out("    mov r13, rsi")  // old
    out("    mov r14, rdx")  // new
    // Get lengths
    out("    call _nova_str_len")
    out("    push rax")  // src_len
    out("    mov rdi, r13")
    out("    call _nova_str_len")
    out("    mov r15, rax")  // old_len
    // Build result string by concatenation
    out("    lea rax, [rip + _empty_str]")
    out("    push rax")  // result
    out("    xor ecx, ecx")  // i
    out("    push rcx")
    out(".sr_loop:")
    out("    mov rcx, [rsp]")  // i
    out("    mov rax, [rsp + 16]")  // src_len
    out("    cmp rcx, rax")
    out("    jge .sr_done")
    // Check if old matches at position i
    out("    mov rdi, r12")
    out("    add rdi, rcx")
    out("    mov rsi, r13")
    out("    mov rdx, r15")
    out("    call _nova_strncmp")
    out("    test rax, rax")
    out("    jnz .sr_nomatch")
    // Match found: append new string
    out("    mov rdi, [rsp + 8]")
    out("    mov rsi, r14")
    out("    call _nova_concat")
    out("    mov [rsp + 8], rax")
    out("    mov rcx, [rsp]")
    out("    add rcx, r15")
    out("    mov [rsp], rcx")
    out("    jmp .sr_loop")
    out(".sr_nomatch:")
    // Append one char
    out("    mov rcx, [rsp]")
    out("    movzx edi, byte ptr [r12 + rcx]")
    out("    call _nova_chr")
    out("    mov rsi, rax")
    out("    mov rdi, [rsp + 8]")
    out("    call _nova_concat")
    out("    mov [rsp + 8], rax")
    out("    inc qword ptr [rsp]")
    out("    jmp .sr_loop")
    out(".sr_done:")
    out("    mov rax, [rsp + 8]")
    out("    add rsp, 24")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // Helper: compare n bytes, return 0 if equal
    out("")
    out_label("_nova_strncmp")
    out("    xor ecx, ecx")
    out(".snc_loop:")
    out("    cmp rcx, rdx")
    out("    jge .snc_eq")
    out("    movzx eax, byte ptr [rdi + rcx]")
    out("    movzx r8d, byte ptr [rsi + rcx]")
    out("    cmp al, r8b")
    out("    jne .snc_neq")
    out("    inc rcx")
    out("    jmp .snc_loop")
    out(".snc_eq:")
    out("    xor eax, eax")
    out("    ret")
    out(".snc_neq:")
    out("    mov eax, 1")
    out("    ret")

    // --- str_repeat(str, n): repeat string n times ---
    out("")
    out_label("_nova_str_repeat")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    lea rax, [rip + _empty_str]")
    out("    push rax")
    out(".srp_loop:")
    out("    cmp r13, 0")
    out("    jle .srp_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_concat")
    out("    mov [rsp], rax")
    out("    dec r13")
    out("    jmp .srp_loop")
    out(".srp_done:")
    out("    pop rax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- char_code(str): return ASCII code of first char ---
    out("")
    out_label("_nova_char_code")
    out("    movzx eax, byte ptr [rdi]")
    out("    ret")

    // --- to_int(str): parse string to integer ---
    out("")
    out_label("_nova_to_int")
    out("    jmp _nova_str_to_int")

    // --- range_list(start, end): create list [start, start+1, ..., end-1] ---
    out("")
    out_label("_nova_range_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_list_new")
    out("    push rax")
    out(".rgl_loop:")
    out("    cmp r12, r13")
    out("    jge .rgl_done")
    out("    mov rdi, [rsp]")
    out("    mov rsi, r12")
    out("    call _nova_push")
    out("    inc r12")
    out("    jmp .rgl_loop")
    out(".rgl_done:")
    out("    pop rax")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_copy(list): shallow copy ---
    out("")
    out_label("_nova_list_copy")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    call _nova_list_new")
    out("    mov r13, rax")
    out("    xor ecx, ecx")
    out(".lc_loop:")
    out("    cmp rcx, [r12 + 8]")
    out("    jge .lc_done")
    out("    push rcx")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + rcx*8]")
    out("    mov rdi, r13")
    out("    call _nova_push")
    out("    pop rcx")
    out("    inc rcx")
    out("    jmp .lc_loop")
    out(".lc_done:")
    out("    mov rax, r13")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_slice(list, start, end): sublist ---
    out("")
    out_label("_nova_list_slice")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")  // start
    out("    mov r14, rdx")  // end
    out("    call _nova_list_new")
    out("    push rax")
    out(".ls_loop:")
    out("    cmp r13, r14")
    out("    jge .ls_done")
    out("    cmp r13, [r12 + 8]")
    out("    jge .ls_done")
    out("    mov rax, [r12 + 24]")
    out("    mov rsi, [rax + r13*8]")
    out("    mov rdi, [rsp]")
    out("    push r13")
    out("    call _nova_push")
    out("    pop r13")
    out("    inc r13")
    out("    jmp .ls_loop")
    out(".ls_done:")
    out("    pop rax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- append_list(dst, src): append all elements of src to dst ---
    out("")
    out_label("_nova_append_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    xor r14d, r14d")
    out(".al_loop:")
    out("    cmp r14, [r13 + 8]")
    out("    jge .al_done")
    out("    mov rax, [r13 + 24]")
    out("    mov rsi, [rax + r14*8]")
    out("    mov rdi, r12")
    out("    call _nova_push")
    out("    inc r14")
    out("    jmp .al_loop")
    out(".al_done:")
    out("    mov rax, r12")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- Wrappers with Nova-compatible names ---
    out("")
    out_label("println")
    out("    jmp _nova_println")
    out_label("print")
    out("    jmp _nova_print_str")
    out_label("print_int")
    out("    jmp _nova_print_int")
    out_label("concat")
    out("    jmp _nova_concat")
    out_label("int_to_str")
