    // --- R28C: UDP syscalls (sendto/recvfrom) for NAT hole-punching ---
    //
    // The four helpers below implement the datagram-socket primitives
    // R23E.2 needs to drive UDP hole-punching after TCP-based NAT
    // discovery. They share the same wire shape across all six targets:
    //
    //   sys_socket_udp() -> fd | -1
    //   sys_sendto(fd, buf, len, addr_ip, addr_port) -> bytes_sent | -1
    //   sys_recvfrom(fd, buf, max_len, timeout_ms)
    //       -> [bytes_read, sender_ip, sender_port]
    //   sys_setsockopt_so_reuseaddr(fd) -> 0 | -1
    //
    // sender_ip is a host-byte-order u32 (e.g. 127.0.0.1 = 0x7F000001
    // in big-endian wire == 0x0100007F as native u32). Callers should
    // unpack via the same scheme make_sockaddr_in uses (per-octet via
    // int_and / int_shr). timeout_ms of 0 returns immediately without
    // blocking; values > 0 wait up to that many milliseconds.

    // --- sys_socket_udp() -> fd | -1 ---
    // socket(AF_INET=2, SOCK_DGRAM=2, IPPROTO_UDP=0).
    out("")
    out_label("_nova_sys_socket_udp")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 32")
        out("    call _nova_win_init_wsa")
        out("    mov ecx, 2")          // AF_INET
        out("    mov edx, 2")          // SOCK_DGRAM
        out("    xor r8d, r8d")        // protocol = 0
        out("    call [rip + __imp_socket]")
        out("    mov rsp, rbp")
        out("    pop rbp")
    } else {
        out("    mov rdi, 2")          // AF_INET
        out("    mov rsi, 2")          // SOCK_DGRAM
        out("    xor rdx, rdx")        // protocol = 0
        emit_syscall(41)
    }
    out("    ret")

    // --- sys_sendto(fd, buf, len, addr_ip, addr_port) -> bytes_sent | -1 ---
    //
    // Materialises a sockaddr_in on the local stack: family=AF_INET (2),
    // port (big-endian u16), ip (already in network order on input —
    // callers pass the int as the wire-format dword), 8 bytes of pad.
    // Then dispatches to sendto syscall 44 (Linux) / 133 (macOS BSD) /
    // ws2_32.dll on Windows.
    out("")
    out_label("_nova_sys_sendto")
    if cg_target == 3 {
        // Windows: sendto(s, buf, len, flags=0, &to, tolen=16). Shadow
        // space [rsp..rsp+31], stack args [rsp+32]=to, [rsp+40]=tolen.
        // sockaddr_in lives at [rbp - 24] (16 bytes); save fd at -32.
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 64")
        out("    mov word ptr [rbp - 24], 2")     // sin_family = AF_INET
        out("    mov eax, r8d")                    // port (low 16 bits)
        out("    xchg al, ah")                     // htons
        out("    mov word ptr [rbp - 22], ax")
        out("    mov [rbp - 20], ecx")             // ip (32 bits)
        out("    mov qword ptr [rbp - 16], 0")    // sin_zero
        // rdi=fd already (Linux ABI); on Windows our incoming is rdi/rsi/rdx/rcx/r8
        // Save scratch for the call.
        out("    mov [rbp - 32], rdi")             // fd
        out("    mov [rbp - 40], rsi")             // buf
        out("    mov [rbp - 48], rdx")             // len
        out("    mov rcx, [rbp - 32]")             // s = fd
        out("    mov rdx, [rbp - 40]")             // buf
        out("    mov r8, [rbp - 48]")              // len
        out("    xor r9d, r9d")                    // flags = 0
        out("    lea rax, [rbp - 24]")
        out("    mov [rsp + 32], rax")             // to
        out("    mov qword ptr [rsp + 40], 16")    // tolen
        out("    call [rip + __imp_sendto]")
        out("    movsxd rax, eax")                 // sign-extend SOCKET_ERROR / count
        out("    mov rsp, rbp")
        out("    pop rbp")
    } else {
        // Linux x64: rdi=fd, rsi=buf, rdx=len already correct. Build
        // sockaddr_in on stack at [rbp - 16]; pass r8=&sa, r9=16.
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 32")
        out("    mov word ptr [rbp - 16], 2")     // sin_family = AF_INET
        out("    mov eax, r8d")                    // port
        out("    xchg al, ah")                     // htons
        out("    mov word ptr [rbp - 14], ax")
        out("    mov [rbp - 12], ecx")             // ip
        out("    mov qword ptr [rbp - 8], 0")     // sin_zero
        out("    xor r10, r10")                    // flags = 0
        out("    lea r8, [rbp - 16]")              // &sockaddr_in
        out("    mov r9, 16")                       // addrlen
        emit_syscall(44)
        out("    mov rsp, rbp")
        out("    pop rbp")
    }
    out("    ret")

