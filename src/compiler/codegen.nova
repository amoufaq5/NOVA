    //   Linux x86-64 : syscall 72 (fcntl), arg2=F_SETFL=4,
    //                  arg3=O_NONBLOCK=2048.
    //   macOS BSD    : syscall 92 routed via syscall_num(72).
    //   Windows      : __imp_ioctlsocket with FIONBIO == 0x8004667e.
    //                  One i32 cmd argument selects "set blocking-mode";
    //                  *argp == 1 means non-blocking.
    out("")
    out_label("_nova_sys_fcntl_setfl_nonblock")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 48")
        out("    mov dword ptr [rbp - 8], 1")     // argp = 1
        out("    mov rcx, rdi")                    // s = fd
        // FIONBIO = _IOW('f',126,u_long) == 0x8004667e on Win32.
        out("    mov edx, -2147195266")            // 0x8004667e as signed
        out("    lea r8, [rbp - 8]")               // &argp
        out("    call [rip + __imp_ioctlsocket]")
        out("    test eax, eax")
        out("    jz .sfcntl_win_ok")
        out("    mov rax, -1")
        out(".sfcntl_win_ok:")
        out("    mov rsp, rbp")
        out("    pop rbp")
