    wi("local.get $c")
    wi("i32.eqz")
    wi("br_if $done")
    wi("local.get $c")
    wi("i32.const 48")
    wi("i32.lt_u")
    wi("br_if $done")
    wi("local.get $c")
    wi("i32.const 57")
    wi("i32.gt_u")
    wi("br_if $done")
    wi("local.get $result")
    wi("i64.const 10")
    wi("i64.mul")
    wi("local.get $c")
    wi("i32.const 48")
    wi("i32.sub")
    wi("i64.extend_i32_u")
    wi("i64.add")
    wi("local.set $result")
    wi("local.get $ptr")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ptr")
    wi("br $parse")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $neg")
    wi("if (result i64)")
    wi("  i64.const 0")
    wi("  local.get $result")
    wi("  i64.sub")
    wi("else")
    wi("  local.get $result")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // char_at — return char code at index
    wi("(func $char_at (param $s i64) (param $idx i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $s")
    wi("i32.wrap_i64")
    wi("local.get $idx")
    wi("i32.wrap_i64")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // chr — create single-char string
    wi("(func $chr (param $c i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i32)")
    wi("i64.const 2")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $ptr")
    wi("local.get $ptr")
    wi("local.get $c")
    wi("i32.wrap_i64")
    wi("i32.store8")
    wi("local.get $ptr")
    wi("i32.const 1")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $ptr")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // substr
    wi("(func $substr (param $s i64) (param $start i64) (param $slen i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ptr i32)")
    wi("(local $dst i32)")
    wi("(local $i i32)")
    wi("local.get $slen")
    wi("i64.const 1")
    wi("i64.add")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $dst")
    wi("local.get $s")
    wi("i32.wrap_i64")
    wi("local.get $start")
    wi("i32.wrap_i64")
    wi("i32.add")
    wi("local.set $ptr")
    wi("block $done")
    wi("loop $cp")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $slen")
    wi("i32.wrap_i64")
    wi("i32.ge_u")
    wi("br_if $done")
    wi("local.get $dst")
    wi("local.get $i")
    wi("i32.add")
    wi("local.get $ptr")
    wi("local.get $i")
    wi("i32.add")
    wi("i32.load8_u")
    wi("i32.store8")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $cp")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $dst")
    wi("local.get $slen")
    wi("i32.wrap_i64")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $dst")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // type_of
    wi("(func $type_of (param $v i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i64.const 1048576")
    wi("i64.lt_s")
    wi("if (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const 1")
    wasm_indent = wasm_indent - 1
    wi("else")
    wasm_indent = wasm_indent + 1
    wi("local.get $v")
    wi("i32.wrap_i64")
    wi("i64.load")
    wi("i64.const -1")
    wi("i64.eq")
    wi("if (result i64)")
    wi("  i64.const 3")
    wi("else")
    wi("  local.get $v")
    wi("  i32.wrap_i64")
    wi("  i64.load")
    wi("  i64.const -2")
    wi("  i64.eq")
    wi("  if (result i64)")
    wi("    i64.const 4")
    wi("  else")
    wi("    i64.const 2")
    wi("  end")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // contains — check if list contains value
    wi("(func $contains (param $list i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $i i64)")
    wi("(local $n i64)")
    wi("local.get $list")
    wi("call $len")
    wi("local.set $n")
    wi("block $found")
    wi("loop $search")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $n")
    wi("i64.ge_s")
    wi("br_if $found")
    wi("local.get $list")
    wi("local.get $i")
    wi("call $rt_index")
    wi("local.get $val")
    wi("call $rt_eq")
    wi("i64.eqz")
    wi("i32.eqz")
    wi("if")
    wi("  i64.const 1")
    wi("  return")
    wi("end")
    wi("local.get $i")
    wi("i64.const 1")
    wi("i64.add")
    wi("local.set $i")
    wi("br $search")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // debug_print — print label and value
    wi("(func $debug_print (param $label i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $label")
    wi("call $print")
    wi("drop")
    let sep = wasm_add_str(": ")
    wi("i64.const " + int_to_str(sep))
    wi("call $print")
    wi("drop")
    wi("local.get $val")
    wi("call $int_to_str")
    wi("call $println")
    wi("drop")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- WASI file I/O scratch layout (linear memory offsets 16..63) ----
    //   16   opened_fd_out   (4 bytes) -- path_open writes the fd here
    //   32   iovec.buf_ptr   (4 bytes) -- fd_read/fd_write iovec
    //   36   iovec.buf_len   (4 bytes)
    //   48   n_io_out        (4 bytes) -- fd_read nread / fd_write nwritten
    // Offsets 0..15 belong to print (its own iovec lives at 0..8 with
    // the fd_write byte-count slot at offset 8). File I/O therefore
    // never clobbers print's working area.

    // _nova_wasi_path_offset -- skip leading '/' and the first directory
    // component so the path passed to path_open is relative to the
    // preopen directory mounted on that prefix. E.g. /tmp/out.txt
    // becomes out.txt (preopen /tmp maps to dirfd 3 in node WASI).
    // Returns the offset (relative to the original string ptr) of the
    // first byte to send to path_open. If the path has no leading '/',
    // returns 0 (treat as already-relative).
    wi("(func $_nova_wasi_path_offset (param $s i32) (result i32)")
    wasm_indent = wasm_indent + 1
    wi("(local $i i32)")
    wi("(local $c i32)")
    wi("local.get $s")
    wi("i32.load8_u")
    wi("i32.const 47")
    wi("i32.ne")
    wi("if")
    wi("  i32.const 0")
    wi("  return")
    wi("end")
    wi("i32.const 1")
    wi("local.set $i")
    wi("block $done")
    wi("loop $scan")
    wasm_indent = wasm_indent + 1
    wi("local.get $s")
    wi("local.get $i")
    wi("i32.add")
    wi("i32.load8_u")
    wi("local.set $c")
    wi("local.get $c")
    wi("i32.eqz")
    wi("br_if $done")
    wi("local.get $c")
    wi("i32.const 47")
    wi("i32.eq")
    wi("if")
    wi("  local.get $i")
    wi("  i32.const 1")
    wi("  i32.add")
    wi("  return")
    wi("end")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $scan")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    // No second '/' found -- fall back to skipping just the leading '/'.
    wi("i32.const 1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // read_file(path) -> string ptr (NUL-terminated) on success, 0 on failure.
    // WASI sequence:
    //   path_open(dirfd=3, dirflags=0, path_ptr, path_len, oflags=0,
    //             fs_rights_base=ALL_RIGHTS, fs_rights_inheriting=ALL_RIGHTS,
    //             fdflags=0, opened_fd_out=&scratch[16])
    //   fd_read(fd, iovs=&scratch[32], iovs_len=1, nread_out=&scratch[48])
    //   fd_close(fd)
    // The dirfd of 3 matches node's preopen ordering (stdin=0, stdout=1,
    // stderr=2, first preopen=3). Buffer is allocated through the bump
    // allocator at 524288 bytes (matches the native read_file budget).
    wi("(func $read_file (param $path i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $p i32)")
    wi("(local $rel i32)")
    wi("(local $plen i32)")
    wi("(local $buf i32)")
    wi("(local $fd i32)")
    wi("(local $rc i32)")
    wi("(local $nread i32)")
    wi("local.get $path")
    wi("i32.wrap_i64")
    wi("local.set $p")
    wi("local.get $p")
    wi("call $_nova_wasi_path_offset")
    wi("local.set $rel")
    wi("local.get $p")
    wi("local.get $rel")
    wi("i32.add")
    wi("local.set $rel")
    wi("local.get $rel")
    wi("call $rt_strlen")
    wi("local.set $plen")
    // Allocate the read buffer up front so we can store its ptr in the
    // iovec before path_open (path_open does not touch the iovec).
    wi("i64.const 524288")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $buf")
    wi("i32.const 32")
    wi("local.get $buf")
    wi("i32.store")
    wi("i32.const 36")
    wi("i32.const 524287")
    wi("i32.store")
    wi("i32.const 48")
    wi("i32.const 0")
    wi("i32.store")
    wi("i32.const 16")
    wi("i32.const 0")
    wi("i32.store")
    // path_open(dirfd=3, dirflags=0, path_ptr=$rel, path_len=$plen,
    //            oflags=0, rights_base=ALL_RIGHTS, rights_inherit=ALL_RIGHTS,
    //            fdflags=0, fd_out=16)
    wi("i32.const 3")
    wi("i32.const 0")
    wi("local.get $rel")
    wi("local.get $plen")
    wi("i32.const 0")
    wi("i64.const 81788927")
    wi("i64.const 81788927")
    wi("i32.const 0")
    wi("i32.const 16")
    wi("call $path_open")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if")
    wi("  i64.const 0")
    wi("  return")
    wi("end")
    wi("i32.const 16")
    wi("i32.load")
    wi("local.set $fd")
    wi("local.get $fd")
    wi("i32.const 32")
    wi("i32.const 1")
    wi("i32.const 48")
    wi("call $fd_read")
    wi("drop")
    wi("i32.const 48")
    wi("i32.load")
    wi("local.set $nread")
    wi("local.get $buf")
    wi("local.get $nread")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $fd")
    wi("call $fd_close")
    wi("drop")
    wi("local.get $buf")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // write_file(path, data) -> 1 on success, 0 on failure.
    // WASI sequence:
    //   path_open(dirfd=3, dirflags=0, path_ptr, path_len,
    //             oflags=OFLAGS_CREAT|OFLAGS_TRUNC (0x09),
    //             fs_rights_base=ALL_RIGHTS, fs_rights_inheriting=ALL_RIGHTS,
    //             fdflags=0, opened_fd_out=&scratch[16])
    //   fd_write(fd, iovs=&scratch[32], iovs_len=1, nwritten_out=&scratch[48])
    //   fd_close(fd)
    // We always pass strlen($data) bytes (NOVA strings are NUL-terminated;
    // the NUL itself is not written, matching the native write_file).
    wi("(func $write_file (param $path i64) (param $data i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $p i32)")
    wi("(local $rel i32)")
    wi("(local $plen i32)")
    wi("(local $d i32)")
    wi("(local $dlen i32)")
    wi("(local $fd i32)")
    wi("(local $rc i32)")
    wi("local.get $path")
    wi("i32.wrap_i64")
    wi("local.set $p")
    wi("local.get $p")
    wi("call $_nova_wasi_path_offset")
    wi("local.set $rel")
    wi("local.get $p")
    wi("local.get $rel")
    wi("i32.add")
    wi("local.set $rel")
    wi("local.get $rel")
    wi("call $rt_strlen")
    wi("local.set $plen")
    wi("local.get $data")
    wi("i32.wrap_i64")
    wi("local.set $d")
    wi("local.get $d")
    wi("call $rt_strlen")
    wi("local.set $dlen")
    wi("i32.const 32")
    wi("local.get $d")
    wi("i32.store")
    wi("i32.const 36")
    wi("local.get $dlen")
    wi("i32.store")
    wi("i32.const 48")
    wi("i32.const 0")
    wi("i32.store")
    wi("i32.const 16")
    wi("i32.const 0")
    wi("i32.store")
    // path_open with O_CREAT|O_TRUNC (0x01|0x08 = 0x09) and ALL_RIGHTS.
    wi("i32.const 3")
    wi("i32.const 0")
    wi("local.get $rel")
    wi("local.get $plen")
    wi("i32.const 9")
    wi("i64.const 81788927")
    wi("i64.const 81788927")
    wi("i32.const 0")
    wi("i32.const 16")
    wi("call $path_open")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if")
    wi("  i64.const 0")
    wi("  return")
    wi("end")
    wi("i32.const 16")
    wi("i32.load")
    wi("local.set $fd")
    wi("local.get $fd")
    wi("i32.const 32")
    wi("i32.const 1")
    wi("i32.const 48")
    wi("call $fd_write")
    wi("drop")
    wi("local.get $fd")
    wi("call $fd_close")
    wi("drop")
    wi("i64.const 1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // secure_random(buf_ptr i64, n_bytes i64) -> i64
    //
    // WASI random_get(buf, len) fills `buf..buf+len` with high-quality
    // entropy. Returns 0 on success; we map to n_bytes on success,
    // -1 on failure. Distinct from any deterministic helper above.
    wi("(func $secure_random (param $buf i64) (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $rc i32)")
    wi("local.get $buf")
    wi("i32.wrap_i64")
    wi("local.get $n")
    wi("i32.wrap_i64")
    wi("call $random_get")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.eq")
    wi("if (result i64)")
    wi("  local.get $n")
    wi("else")
    wi("  i64.const -1")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ============================================================
    // Low-level WASI builtins (R8A: serverless preopens surface)
    // ============================================================
    //
    // These thin wrappers expose wasi_snapshot_preview1 primitives to
    // NOVA programs so a serverless / CDN-edge deployment can read,
    // write, seek, stat and inspect argv/envp directly without going
    // through read_file/write_file (which are convenience builtins
    // that allocate a 512KiB buffer and assume small files).
    //
    // Filesystem ops route through dirfd=3 — the first preopened
    // directory in WASI's fd table (stdin=0, stdout=1, stderr=2,
    // preopen[0]=3). For wasmtime/wasmer/node-WASI hosts:
    //
    //   wasmtime --dir=/tmp my.wasm    -> /tmp is dirfd 3
    //   wasmtime --mapdir=/in::/host/x -> /in is dirfd 3 mapped to /host/x
    //
    // _nova_wasi_path_offset (above) strips the leading dir prefix
    // ("/tmp/" -> "") so paths sent to path_open are relative to the
    // preopen root, matching the WASI semantic that you cannot escape
    // a preopen with absolute paths.
    //
    // The scratch layout (offsets 16..63 in linear memory) is shared
    // with read_file/write_file; the layout comment above is
    // authoritative. Where wasi_filestat needs a 64-byte filestat
    // buffer, it reserves offsets 64..127 (also unused by print/file
    // I/O).

    // wasi_open(path: str, flags: int) -> fd | -1
    //
    // flags is a bitmask layered over WASI's oflags:
    //   bit 0 -> O_CREAT      (0x01)
    //   bit 1 -> O_DIRECTORY  (0x02)
    //   bit 2 -> O_EXCL       (0x04)
    //   bit 3 -> O_TRUNC      (0x08)
    // and on the rights side we always pass ALL_RIGHTS so the returned
    // fd can read, write, seek, etc. -- the host enforces the actual
    // capability set against the preopen's rights.
    wi("(func $wasi_open (param $path i64) (param $flags i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $p i32)")
    wi("(local $rel i32)")
    wi("(local $plen i32)")
    wi("(local $rc i32)")
    wi("local.get $path")
    wi("i32.wrap_i64")
    wi("local.set $p")
    wi("local.get $p")
    wi("call $_nova_wasi_path_offset")
    wi("local.set $rel")
    wi("local.get $p")
    wi("local.get $rel")
    wi("i32.add")
    wi("local.set $rel")
    wi("local.get $rel")
    wi("call $rt_strlen")
    wi("local.set $plen")
    wi("i32.const 16")
    wi("i32.const 0")
    wi("i32.store")
    // path_open(dirfd=3, dirflags=0, path_ptr, path_len, oflags=$flags,
    //           rights_base=ALL_RIGHTS, rights_inherit=ALL_RIGHTS,
    //           fdflags=0, fd_out=16).
    wi("i32.const 3")
    wi("i32.const 0")
    wi("local.get $rel")
    wi("local.get $plen")
    wi("local.get $flags")
    wi("i32.wrap_i64")
    wi("i64.const 81788927")
    wi("i64.const 81788927")
    wi("i32.const 0")
    wi("i32.const 16")
    wi("call $path_open")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if (result i64)")
    wi("  i64.const -1")
    wi("else")
    wi("  i32.const 16")
    wi("  i32.load")
    wi("  i64.extend_i32_u")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // wasi_read(fd: int, buf: int, len: int) -> bytes_read | -1
    //
    // Builds a 1-iovec at scratch[32..39] pointing to (buf, len), calls
    // fd_read, and returns the nread written by WASI into scratch[48].
    wi("(func $wasi_read (param $fd i64) (param $buf i64) (param $len i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $rc i32)")
    wi("i32.const 32")
    wi("local.get $buf")
    wi("i32.wrap_i64")
    wi("i32.store")
    wi("i32.const 36")
    wi("local.get $len")
    wi("i32.wrap_i64")
    wi("i32.store")
    wi("i32.const 48")
    wi("i32.const 0")
    wi("i32.store")
    wi("local.get $fd")
    wi("i32.wrap_i64")
    wi("i32.const 32")
    wi("i32.const 1")
    wi("i32.const 48")
    wi("call $fd_read")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if (result i64)")
    wi("  i64.const -1")
    wi("else")
    wi("  i32.const 48")
    wi("  i32.load")
    wi("  i64.extend_i32_u")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // wasi_write(fd: int, buf: int, len: int) -> bytes_written | -1
    wi("(func $wasi_write (param $fd i64) (param $buf i64) (param $len i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $rc i32)")
    wi("i32.const 32")
    wi("local.get $buf")
    wi("i32.wrap_i64")
    wi("i32.store")
    wi("i32.const 36")
    wi("local.get $len")
    wi("i32.wrap_i64")
    wi("i32.store")
    wi("i32.const 48")
    wi("i32.const 0")
    wi("i32.store")
    wi("local.get $fd")
    wi("i32.wrap_i64")
    wi("i32.const 32")
    wi("i32.const 1")
    wi("i32.const 48")
    wi("call $fd_write")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if (result i64)")
    wi("  i64.const -1")
    wi("else")
    wi("  i32.const 48")
    wi("  i32.load")
    wi("  i64.extend_i32_u")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // wasi_close(fd: int) -> 0 | -1
    wi("(func $wasi_close (param $fd i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $rc i32)")
    wi("local.get $fd")
    wi("i32.wrap_i64")
    wi("call $fd_close")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.eq")
    wi("if (result i64)")
    wi("  i64.const 0")
    wi("else")
    wi("  i64.const -1")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // wasi_seek(fd: int, offset: int, whence: int) -> new_offset | -1
    //
    // whence: 0=SET, 1=CUR, 2=END (WASI matches POSIX). new_offset
    // is written by WASI into scratch[48..55] as i64.
    wi("(func $wasi_seek (param $fd i64) (param $off i64) (param $whence i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $rc i32)")
    wi("i32.const 48")
    wi("i64.const 0")
    wi("i64.store")
    wi("local.get $fd")
    wi("i32.wrap_i64")
    wi("local.get $off")
    wi("local.get $whence")
    wi("i32.wrap_i64")
    wi("i32.const 48")
    wi("call $fd_seek")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if (result i64)")
    wi("  i64.const -1")
    wi("else")
    wi("  i32.const 48")
    wi("  i64.load")
    wi("end")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // wasi_filestat(path: str) -> list [size, mtime_ns, kind] | 0
    //
    // path_filestat_get writes a 64-byte filestat struct to its buf:
    //   off  0  device   u64
    //   off  8  inode    u64
    //   off 16  filetype u8       (kind: 3=regular, 2=char, 4=directory, ...)
    //   off 24  nlink    u64
    //   off 32  size     u64
    //   off 40  atime    u64 (ns)
    //   off 48  mtime    u64 (ns)
    //   off 56  ctime    u64 (ns)
    // We park the struct at scratch[64..127] (outside the iovec area
    // used by wasi_read/write/seek) and surface [size, mtime, kind]
    // as a NOVA list -- the three fields a serverless caller actually
    // cares about. Returns 0 on lookup failure (errno != 0).
    wi("(func $wasi_filestat (param $path i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $p i32)")
    wi("(local $rel i32)")
    wi("(local $plen i32)")
    wi("(local $rc i32)")
    wi("(local $list i64)")
    wi("local.get $path")
    wi("i32.wrap_i64")
    wi("local.set $p")
    wi("local.get $p")
    wi("call $_nova_wasi_path_offset")
    wi("local.set $rel")
    wi("local.get $p")
    wi("local.get $rel")
    wi("i32.add")
    wi("local.set $rel")
    wi("local.get $rel")
    wi("call $rt_strlen")
    wi("local.set $plen")
    // path_filestat_get(fd=3, flags=1 (FOLLOW_SYMLINKS), path_ptr, path_len, buf_out=64)
    wi("i32.const 3")
    wi("i32.const 1")
    wi("local.get $rel")
    wi("local.get $plen")
    wi("i32.const 64")
    wi("call $path_filestat_get")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if")
    wi("  i64.const 0")
    wi("  return")
    wi("end")
    // Allocate a NOVA list [size, mtime_ns, kind] via list_new + push.
    wi("call $list_new")
    wi("local.set $list")
    wi("local.get $list")
    wi("i32.const 96")
    wi("i64.load")
    wi("call $push")
    wi("drop")
    wi("local.get $list")
    wi("i32.const 112")
    wi("i64.load")
    wi("call $push")
    wi("drop")
    wi("local.get $list")
    wi("i32.const 80")
    wi("i32.load8_u")
    wi("i64.extend_i32_u")
    wi("call $push")
    wi("drop")
    wi("local.get $list")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // wasi_args_get() -> list of argv strings
    //
    // Standard WASI sequence:
    //   args_sizes_get(&argc_out, &buf_size_out)
    //   allocate buf_size bytes for the concatenated argv data
    //   allocate argc * 4 bytes for the argv pointer array
    //   args_get(argv_ptr_table, argv_buf)
    //   walk argc entries; each is a (NUL-terminated) pointer into argv_buf.
    //
    // Scratch: argc at [128], buf_size at [132].
    wi("(func $wasi_args_get (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $argc i32)")
    wi("(local $bufsz i32)")
    wi("(local $argv_table i32)")
    wi("(local $argv_buf i32)")
    wi("(local $list i64)")
    wi("(local $i i32)")
    wi("(local $rc i32)")
    wi("i32.const 128")
    wi("i32.const 132")
    wi("call $args_sizes_get")
    wi("local.set $rc")
    wi("call $list_new")
    wi("local.set $list")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if")
    wi("  local.get $list")
    wi("  return")
    wi("end")
    wi("i32.const 128")
    wi("i32.load")
    wi("local.set $argc")
    wi("i32.const 132")
    wi("i32.load")
    wi("local.set $bufsz")
    // WASI args_get writes 4-byte i32 pointers into argv_table, so the
    // table must be 4-byte aligned. The bump allocator returns raw
    // heap_ptr; we round it up to the next multiple of 4 before
    // allocating to satisfy wasmtime's strict align check.
    wi("global.get $heap_ptr")
    wi("i64.const 3")
    wi("i64.add")
    wi("i64.const -4")
    wi("i64.and")
    wi("global.set $heap_ptr")
    wi("local.get $argc")
    wi("i32.const 4")
    wi("i32.mul")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $argv_table")
    wi("local.get $bufsz")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $argv_buf")
    wi("local.get $argv_table")
    wi("local.get $argv_buf")
    wi("call $args_get")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if")
    wi("  local.get $list")
    wi("  return")
    wi("end")
    wi("block $done")
    wi("loop $walk")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $argc")
    wi("i32.ge_u")
    wi("br_if $done")
    wi("local.get $list")
    wi("local.get $argv_table")
    wi("local.get $i")
    wi("i32.const 4")
    wi("i32.mul")
    wi("i32.add")
    wi("i32.load")
    wi("i64.extend_i32_u")
    wi("call $push")
    wi("drop")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $walk")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $list")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // wasi_environ_get() -> list of "KEY=VALUE" strings (same layout)
    wi("(func $wasi_environ_get (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $envc i32)")
    wi("(local $bufsz i32)")
    wi("(local $env_table i32)")
    wi("(local $env_buf i32)")
    wi("(local $list i64)")
    wi("(local $i i32)")
    wi("(local $rc i32)")
    wi("i32.const 128")
    wi("i32.const 132")
    wi("call $environ_sizes_get")
    wi("local.set $rc")
    wi("call $list_new")
    wi("local.set $list")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if")
    wi("  local.get $list")
    wi("  return")
    wi("end")
    wi("i32.const 128")
    wi("i32.load")
    wi("local.set $envc")
    wi("i32.const 132")
    wi("i32.load")
    wi("local.set $bufsz")
    // 4-byte alignment for the pointer table -- see wasi_args_get above.
    wi("global.get $heap_ptr")
    wi("i64.const 3")
    wi("i64.add")
    wi("i64.const -4")
    wi("i64.and")
    wi("global.set $heap_ptr")
    wi("local.get $envc")
    wi("i32.const 4")
    wi("i32.mul")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $env_table")
    wi("local.get $bufsz")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $env_buf")
    wi("local.get $env_table")
    wi("local.get $env_buf")
    wi("call $environ_get")
    wi("local.set $rc")
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if")
    wi("  local.get $list")
    wi("  return")
    wi("end")
    wi("block $done")
    wi("loop $walk")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $envc")
    wi("i32.ge_u")
    wi("br_if $done")
    wi("local.get $list")
    wi("local.get $env_table")
    wi("local.get $i")
    wi("i32.const 4")
    wi("i32.mul")
    wi("i32.add")
    wi("i32.load")
    wi("i64.extend_i32_u")
    wi("call $push")
    wi("drop")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $walk")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $list")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // R28C: UDP syscall stubs on WASM. WASI snapshot_preview1 does not
    // expose datagram sockets, so these always return the failure
    // sentinel (-1 / [-1, 0, 0]). Programs that need UDP hole-punching
    // should run on native targets (Linux x86-64, macOS, ARM64-Linux)
    // where R28C lowers to real socket/sendto/recvfrom/setsockopt
    // syscalls. The stubs exist so the same NOVA source compiles
    // without #if cfg-gates at the source level.
    wi("(func $sys_socket_udp (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const -1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $sys_sendto (param $fd i64) (param $buf i64) (param $blen i64) (param $ip i64) (param $port i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const -1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $sys_recvfrom (param $fd i64) (param $buf i64) (param $mlen i64) (param $timeout_ms i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $list i64)")
    wi("call $list_new")
    wi("local.set $list")
    wi("local.get $list")
    wi("i64.const -1")
    wi("call $push")
    wi("drop")
    wi("local.get $list")
    wi("i64.const 0")
    wi("call $push")
    wi("drop")
    wi("local.get $list")
    wi("i64.const 0")
    wi("call $push")
    wi("drop")
    wi("local.get $list")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $sys_setsockopt_so_reuseaddr (param $fd i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const -1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // R30D: sys_poll(fds, nfds, timeout_ms) -> i32 translation shim
    // mapping POSIX pollfd onto WASI preview1 `poll_oneoff`.
    //
    // Why a shim and not a passthrough: R29A's WASM stub returned -1
    // unconditionally because preview1 has no plain `poll` -- only
    // `poll_oneoff` with subscription/event arrays. The two shapes
    // don't map 1:1, so the shim translates in three phases:
    //
    //   1. Count phase. Walk pollfd[nfds]. For each entry's events
    //      bitmask emit ONE fd_read subscription if POLLIN (0x01) is
    //      requested and ONE fd_write subscription if POLLOUT (0x04)
    //      is requested. (Both bits emit two subscriptions for the
    //      same fd.) Append ONE clock subscription iff timeout_ms >=
    //      0; timeout_ms < 0 means "wait forever" so we omit it.
    //
    //   2. Build phase. Bump-allocate the subscription array
    //      (48 bytes/subscription, 8-byte aligned) and the event
    //      array (32 bytes/event, 8-byte aligned) plus a 4-byte
    //      nevents_out slot from $heap_ptr. Fill each subscription:
    //        userdata u64 @0 = (pollfd_index << 1) | is_write_bit
    //                          (sentinel -1 for the clock entry)
    //        tag u8 @8        = 0 (clock) / 1 (fd_read) / 2 (fd_write)
    //        payload @16      = fd:u32 for read/write,
    //                           or {id:u32, timeout:u64, prec:u64,
    //                               flags:u16} for clock with
    //                              clock_id=0 (CLOCKID_REALTIME),
    //                              timeout = ms * 1_000_000 ns.
    //
    //   3. Call + decode phase. Call poll_oneoff(subs, evs, nsubs,
    //      &nevents_out). Iterate the produced events: decode
    //      userdata; if it equals -1 the clock fired -> timeout,
    //      revents stay clear and we keep walking (no other events
    //      can have signalled). For fd events OR POLLIN/POLLOUT into
    //      pollfd[index].revents and bump a per-pollfd "any-bit-set"
    //      counter (separate from the OR so multi-bit fds count once).
    //
    // Return value matches POSIX: number of pollfds whose revents
    // got at least one bit set; 0 on pure timeout; -1 on WASI errno
    // != 0 (host-side syscall error).
    //
    // Scratch memory: the bump allocator $alloc (over $heap_ptr).
    // Same approach as wasi_args_get / wasi_environ_get -- no fixed
    // region, no new globals, naturally handles arbitrary nfds.
    // 8-byte alignment is enforced by rounding $heap_ptr up before
    // the allocation; preview1 requires 8-byte alignment for both
    // arrays (subscription has 8-byte fields, event has u64 nbytes).
    //
    // userdata encoding: (pollfd_idx << 1) | is_write. The low bit
    // distinguishes the read vs write subscription for the same fd;
    // the high bits recover the pollfd index in O(1) without
    // scanning the subscription array. The clock entry uses the
    // sentinel -1 (all-bits-set) which can never collide with a
    // real (idx << 1)|bit value for any reasonable nfds.
    wi("(func $sys_poll (param $fds i64) (param $nfds i64) (param $timeout_ms i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $nfds_i i32)")
    wi("(local $fds_i i32)")
    wi("(local $tmo i64)")
    wi("(local $has_clock i32)")
    wi("(local $i i32)")
    wi("(local $ev i32)")
    wi("(local $pfd i32)")
    wi("(local $nsubs i32)")
    wi("(local $subs i32)")
    wi("(local $evs i32)")
    wi("(local $nev_out i32)")
    wi("(local $sub_ptr i32)")
    wi("(local $idx i32)")
    wi("(local $rc i32)")
    wi("(local $nproduced i32)")
    wi("(local $ev_ptr i32)")
    wi("(local $ud_lo i32)")
    wi("(local $ud_hi i32)")
    wi("(local $ud_pidx i32)")
    wi("(local $is_w i32)")
    wi("(local $pfd_slot i32)")
    wi("(local $rev_old i32)")
    wi("(local $bit i32)")
    wi("(local $nready i64)")
    wi("(local $j i32)")
    wi("(local $rev_check i32)")
    // Convert i64 args to i32 working values.
    wi("local.get $fds")
    wi("i32.wrap_i64")
    wi("local.set $fds_i")
    wi("local.get $nfds")
    wi("i32.wrap_i64")
    wi("local.set $nfds_i")
    wi("local.get $timeout_ms")
    wi("local.set $tmo")
    // has_clock = (timeout_ms >= 0) ? 1 : 0
    wi("local.get $tmo")
    wi("i64.const 0")
    wi("i64.ge_s")
    wi("if (result i32)")
    wi("  i32.const 1")
    wi("else")
    wi("  i32.const 0")
    wi("end")
    wi("local.set $has_clock")
    // ---- Phase 1: count subscriptions ----
    wi("i32.const 0")
    wi("local.set $nsubs")
    wi("i32.const 0")
    wi("local.set $i")
    wi("block $count_done")
    wi("loop $count_loop")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $nfds_i")
    wi("i32.ge_u")
    wi("br_if $count_done")
    // ev = (u16)*(fds_i + i*8 + 4)
    wi("local.get $fds_i")
    wi("local.get $i")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("i32.const 4")
    wi("i32.add")
    wi("i32.load16_u")
    wi("local.set $ev")
    // POLLIN -> +1 subscription
    wi("local.get $ev")
    wi("i32.const 1")
    wi("i32.and")
    wi("if")
    wi("  local.get $nsubs")
    wi("  i32.const 1")
    wi("  i32.add")
    wi("  local.set $nsubs")
    wi("end")
    // POLLOUT -> +1 subscription
    wi("local.get $ev")
    wi("i32.const 4")
    wi("i32.and")
    wi("if")
    wi("  local.get $nsubs")
    wi("  i32.const 1")
    wi("  i32.add")
    wi("  local.set $nsubs")
    wi("end")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $count_loop")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    // Add the clock subscription if needed.
    wi("local.get $nsubs")
    wi("local.get $has_clock")
    wi("i32.add")
    wi("local.set $nsubs")
    // If we have zero subscriptions there's nothing to wait on; return 0
    // immediately (POSIX poll(NULL, 0, 0) returns 0 too).
    wi("local.get $nsubs")
    wi("i32.eqz")
    wi("if")
    wi("  i64.const 0")
    wi("  return")
    wi("end")
    // ---- Phase 2a: allocate subs / evs / nev_out (8-byte aligned) ----
    // Round heap_ptr up to multiple of 8.
    wi("global.get $heap_ptr")
    wi("i64.const 7")
    wi("i64.add")
    wi("i64.const -8")
    wi("i64.and")
    wi("global.set $heap_ptr")
    wi("local.get $nsubs")
    wi("i32.const 48")
    wi("i32.mul")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $subs")
    wi("global.get $heap_ptr")
    wi("i64.const 7")
    wi("i64.add")
    wi("i64.const -8")
    wi("i64.and")
    wi("global.set $heap_ptr")
    wi("local.get $nsubs")
    wi("i32.const 32")
    wi("i32.mul")
    wi("i64.extend_i32_u")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $evs")
    wi("global.get $heap_ptr")
    wi("i64.const 7")
    wi("i64.add")
    wi("i64.const -8")
    wi("i64.and")
    wi("global.set $heap_ptr")
    wi("i64.const 8")
    wi("call $alloc")
    wi("i32.wrap_i64")
    wi("local.set $nev_out")
    // Zero the subscription region. poll_oneoff requires unused payload
    // bytes to be zero (host treats them as flags=0, precision=0).
    wi("i32.const 0")
    wi("local.set $j")
    wi("block $zero_done")
    wi("loop $zero_loop")
    wasm_indent = wasm_indent + 1
    wi("local.get $j")
    wi("local.get $nsubs")
    wi("i32.const 48")
    wi("i32.mul")
    wi("i32.ge_u")
    wi("br_if $zero_done")
    wi("local.get $subs")
    wi("local.get $j")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store8")
    wi("local.get $j")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $j")
    wi("br $zero_loop")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    // ---- Phase 2b: build subscriptions ----
    wi("i32.const 0")
    wi("local.set $idx")
    wi("i32.const 0")
    wi("local.set $i")
    wi("block $build_done")
    wi("loop $build_loop")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $nfds_i")
    wi("i32.ge_u")
    wi("br_if $build_done")
    // pfd_slot = fds_i + i*8
    wi("local.get $fds_i")
    wi("local.get $i")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("local.set $pfd_slot")
    // events = *(pfd_slot + 4) (u16)
    wi("local.get $pfd_slot")
    wi("i32.const 4")
    wi("i32.add")
    wi("i32.load16_u")
    wi("local.set $ev")
    // Clear revents so each call starts fresh.
    wi("local.get $pfd_slot")
    wi("i32.const 6")
    wi("i32.add")
    wi("i32.const 0")
    wi("i32.store16")
    // POLLIN -> emit fd_read subscription
    wi("local.get $ev")
    wi("i32.const 1")
    wi("i32.and")
    wi("if")
    wi("  local.get $subs")
    wi("  local.get $idx")
    wi("  i32.const 48")
    wi("  i32.mul")
    wi("  i32.add")
    wi("  local.set $sub_ptr")
    // userdata = (i << 1) | 0
    wi("  local.get $sub_ptr")
    wi("  local.get $i")
    wi("  i64.extend_i32_u")
    wi("  i64.const 1")
    wi("  i64.shl")
    wi("  i64.store")
    // tag (u8) @ +8 = 1 (fd_read)
    wi("  local.get $sub_ptr")
    wi("  i32.const 8")
    wi("  i32.add")
    wi("  i32.const 1")
    wi("  i32.store8")
    // fd (u32) @ +16
    wi("  local.get $sub_ptr")
    wi("  i32.const 16")
    wi("  i32.add")
    wi("  local.get $pfd_slot")
    wi("  i32.load")
    wi("  i32.store")
    wi("  local.get $idx")
    wi("  i32.const 1")
    wi("  i32.add")
    wi("  local.set $idx")
    wi("end")
    // POLLOUT -> emit fd_write subscription
    wi("local.get $ev")
    wi("i32.const 4")
    wi("i32.and")
    wi("if")
    wi("  local.get $subs")
    wi("  local.get $idx")
    wi("  i32.const 48")
    wi("  i32.mul")
    wi("  i32.add")
    wi("  local.set $sub_ptr")
    // userdata = (i << 1) | 1
    wi("  local.get $sub_ptr")
    wi("  local.get $i")
    wi("  i64.extend_i32_u")
    wi("  i64.const 1")
    wi("  i64.shl")
    wi("  i64.const 1")
    wi("  i64.or")
    wi("  i64.store")
    // tag (u8) @ +8 = 2 (fd_write)
    wi("  local.get $sub_ptr")
    wi("  i32.const 8")
    wi("  i32.add")
    wi("  i32.const 2")
    wi("  i32.store8")
    // fd (u32) @ +16
    wi("  local.get $sub_ptr")
    wi("  i32.const 16")
    wi("  i32.add")
    wi("  local.get $pfd_slot")
    wi("  i32.load")
    wi("  i32.store")
    wi("  local.get $idx")
    wi("  i32.const 1")
    wi("  i32.add")
    wi("  local.set $idx")
    wi("end")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $build_loop")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    // ---- Phase 2c: append the clock subscription if timeout_ms >= 0 ----
    wi("local.get $has_clock")
    wi("if")
    wi("  local.get $subs")
    wi("  local.get $idx")
    wi("  i32.const 48")
    wi("  i32.mul")
    wi("  i32.add")
    wi("  local.set $sub_ptr")
    // userdata = -1 (clock sentinel)
    wi("  local.get $sub_ptr")
    wi("  i64.const -1")
    wi("  i64.store")
    // tag (u8) @ +8 = 0 (clock); zero-init already cleared so omit
    // explicit store of 0 -- kept implicit by the zero-fill pass above.
    // clock_id (u32) @ +16 = 0 (CLOCKID_REALTIME)
    wi("  local.get $sub_ptr")
    wi("  i32.const 16")
    wi("  i32.add")
    wi("  i32.const 0")
    wi("  i32.store")
    // timeout (u64) @ +24 = timeout_ms * 1_000_000 ns
    wi("  local.get $sub_ptr")
    wi("  i32.const 24")
    wi("  i32.add")
    wi("  local.get $tmo")
    wi("  i64.const 1000000")
    wi("  i64.mul")
    wi("  i64.store")
    // precision (u64) @ +32 = 0 (any)
    // flags (u16) @ +40 = 0 (relative — bit set would be ABSTIME)
    // Both already zero from the zero-fill pass.
    wi("end")
    // ---- Phase 3: call poll_oneoff ----
    wi("local.get $subs")
    wi("local.get $evs")
    wi("local.get $nsubs")
    wi("local.get $nev_out")
    wi("call $poll_oneoff")
    wi("local.set $rc")
    // Non-zero errno -> propagate -1.
    wi("local.get $rc")
    wi("i32.const 0")
    wi("i32.ne")
    wi("if")
    wi("  i64.const -1")
    wi("  return")
    wi("end")
    wi("local.get $nev_out")
    wi("i32.load")
    wi("local.set $nproduced")
    // ---- Phase 3b: decode events into pollfd.revents ----
    wi("i32.const 0")
    wi("local.set $j")
    wi("block $dec_done")
    wi("loop $dec_loop")
    wasm_indent = wasm_indent + 1
    wi("local.get $j")
    wi("local.get $nproduced")
    wi("i32.ge_u")
    wi("br_if $dec_done")
    wi("local.get $evs")
    wi("local.get $j")
    wi("i32.const 32")
    wi("i32.mul")
    wi("i32.add")
    wi("local.set $ev_ptr")
    // Load userdata low 32 bits (high half also loaded for the sentinel check).
    wi("local.get $ev_ptr")
    wi("i32.load")
    wi("local.set $ud_lo")
    wi("local.get $ev_ptr")
    wi("i32.const 4")
    wi("i32.add")
    wi("i32.load")
    wi("local.set $ud_hi")
    // Clock sentinel: low == -1 && high == -1
    wi("local.get $ud_lo")
    wi("i32.const -1")
    wi("i32.eq")
    wi("local.get $ud_hi")
    wi("i32.const -1")
    wi("i32.eq")
    wi("i32.and")
    wi("if")
    // Clock fired -> timeout; skip this event but keep walking
    // (other already-ready fds before the deadline will still appear).
    wi("  local.get $j")
    wi("  i32.const 1")
    wi("  i32.add")
    wi("  local.set $j")
    wi("  br $dec_loop")
    wi("end")
    // pollfd_idx = ud_lo >> 1; is_write = ud_lo & 1
    wi("local.get $ud_lo")
    wi("i32.const 1")
    wi("i32.shr_u")
    wi("local.set $ud_pidx")
    wi("local.get $ud_lo")
    wi("i32.const 1")
    wi("i32.and")
    wi("local.set $is_w")
    // pfd_slot = fds_i + idx*8
    wi("local.get $fds_i")
    wi("local.get $ud_pidx")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("local.set $pfd_slot")
    // bit = is_w ? POLLOUT (4) : POLLIN (1)
    wi("local.get $is_w")
    wi("if (result i32)")
    wi("  i32.const 4")
    wi("else")
    wi("  i32.const 1")
    wi("end")
    wi("local.set $bit")
    // revents @ +6 |= bit (read-modify-write u16)
    wi("local.get $pfd_slot")
    wi("i32.const 6")
    wi("i32.add")
    wi("i32.load16_u")
    wi("local.set $rev_old")
    wi("local.get $pfd_slot")
    wi("i32.const 6")
    wi("i32.add")
    wi("local.get $rev_old")
    wi("local.get $bit")
    wi("i32.or")
    wi("i32.store16")
    wi("local.get $j")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $j")
    wi("br $dec_loop")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    // ---- Phase 3c: count pollfds whose revents got bits set ----
    // (Distinct from $nproduced because multi-bit fds — POLLIN +
    // POLLOUT both ready — would otherwise be double-counted.)
    wi("i64.const 0")
    wi("local.set $nready")
    wi("i32.const 0")
    wi("local.set $i")
    wi("block $tally_done")
    wi("loop $tally_loop")
    wasm_indent = wasm_indent + 1
    wi("local.get $i")
    wi("local.get $nfds_i")
    wi("i32.ge_u")
    wi("br_if $tally_done")
    wi("local.get $fds_i")
    wi("local.get $i")
    wi("i32.const 8")
    wi("i32.mul")
    wi("i32.add")
    wi("i32.const 6")
    wi("i32.add")
    wi("i32.load16_u")
    wi("local.set $rev_check")
    wi("local.get $rev_check")
    wi("if")
    wi("  local.get $nready")
    wi("  i64.const 1")
    wi("  i64.add")
    wi("  local.set $nready")
    wi("end")
    wi("local.get $i")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $i")
    wi("br $tally_loop")
    wasm_indent = wasm_indent - 1
    wi("end")
    wi("end")
    wi("local.get $nready")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // R31A: sys_fcntl_setfl_nonblock / sys_getsockopt_so_error stubs on
    // WASM. The motivating workload (parallel TCP connect with
    // POLLOUT) doesn't apply to WASI -- preview1 has neither plain
    // sockets nor fcntl, only the abstract poll_oneoff cycle that R30D
    // already wraps. Programs that need parallel dialing should run on
    // the native targets (Linux x86-64, ARM64-Linux, macOS) where the
    // helpers issue real fcntl/getsockopt syscalls. The stubs let the
    // same NOVA source compile without source-level #if cfg-gates.
    wi("(func $sys_fcntl_setfl_nonblock (param $fd i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const -1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $sys_getsockopt_so_error (param $fd i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("i64.const -1")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

// R15B: WASM v128 SIMD lowering for the R11D / R14B intrinsics.
//
// Closes R11D's last gap: WASM was previously the only target where the
// SIMD builtins (`simd_add_i32x8`, `simd_sub_i32x8`, `simd_load_i32x8`,
// `simd_store_i32x8`, `simd_sum_abs_diff`, `simd_sad_u8`) had no
// definition at all -- a NOVA program that called them and was compiled
// with `--target=wasm` would emit a `call $simd_*` referencing an
// undefined function, failing `wat2wasm` validation.
//
// Lowering strategy:
//
//   WebAssembly SIMD (the WASM v128 proposal, finalized 2021 / Phase 4)
//   provides 128-bit packed vectors -- HALF the AVX2 lane width. The
//   R11D builtins operate on 8x i32 lanes (256 bits / 32 bytes), so
//   each NOVA simd_*_i32x8 call emits TWO v128 ops (one per 4-lane
//   half) under WASM. The R14B `simd_sad_u8` over 32 raw bytes is also
//   2 v128 iterations per logical 32-byte buffer.
//
//   Per-call WAT shape:
//
//     simd_add_i32x8(a, b, dst):
//       v128.load a[0..16] + v128.load b[0..16] + i32x4.add + v128.store dst[0..16]
//       v128.load a[16..32] + v128.load b[16..32] + i32x4.add + v128.store dst[16..32]
//
//     simd_sum_abs_diff(a, b, n):
//       loop n>=8: 2x (v128.load + v128.load + i32x4.sub + i32x4.abs + acc i32x4.add)
//       horizontal sum acc via extract_lane 0..3 + i32.add chain
//       tail (n%8) scalar
//
//     simd_sad_u8(a, b, n):
//       loop n>=16: v128.load + v128.load
//                 + (i8x16.sub_sat_u(a,b) | i8x16.sub_sat_u(b,a))  -- unsigned abs diff
//                 + i16x8.extadd_pairwise_i8x16_u
//                 + i32x4.extadd_pairwise_i16x8_u
//                 + acc i32x4.add
//       horizontal sum acc via extract_lane chain
//       tail (n%16) scalar
//
// Performance: WASM v128 has 4 i32 lanes vs AVX2's 8, so the throughput
// ceiling under WASM is ~half of native x86-64. Stereo SAD measured
// ~2x WASM-SIMD/scalar (vs ~4x AVX2/scalar native). All modern engines
// enable the SIMD feature by default: wasmtime since 0.27 (current is
// 45), wasmer always, Chrome 91+, Firefox 89+, Safari 16+ -- universal
// coverage today.
//
// All helpers `int_add`, `int_sub`, `int_mul`, ..., `store8`, `load8`
// are also defined here because the existing SIMD test harnesses
// (tests/test_simd_intrinsics.nova etc) use them to pack/unpack i32
// buffers and the WASM runtime never previously defined them as
// callable functions.
fn wasm_gen_rt_simd() {
    // ---- store8 / load8: raw single-byte memory helpers ----
    //
    // store8(ptr, val): write low byte of val to memory at ptr.
    //   WAT: i32.store8 takes (ptr i32, val i32).
    wi("(func $store8 (param $ptr i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $ptr")
    wi("i32.wrap_i64")
    wi("local.get $val")
    wi("i32.wrap_i64")
    wi("i32.store8")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // load8(ptr): read unsigned byte at ptr, returns 0..255.
    wi("(func $load8 (param $ptr i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $ptr")
    wi("i32.wrap_i64")
    wi("i32.load8_u")
    wi("i64.extend_i32_u")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // store64 / load64: 8-byte memory helpers.
    wi("(func $store64 (param $ptr i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $ptr")
    wi("i32.wrap_i64")
    wi("local.get $val")
    wi("i64.store")
    wi("i64.const 0")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $load64 (param $ptr i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $ptr")
    wi("i32.wrap_i64")
    wi("i64.load")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // memcpy_raw(dst, src, n): byte copy.
    wi("(func $memcpy_raw (param $dst i64) (param $src i64) (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $d i32)")
    wi("(local $s i32)")
    wi("(local $rem i32)")
    wi("local.get $dst")
    wi("i32.wrap_i64")
    wi("local.set $d")
    wi("local.get $src")
    wi("i32.wrap_i64")
    wi("local.set $s")
    wi("local.get $n")
    wi("i32.wrap_i64")
    wi("local.set $rem")
    wi("block $done")
    wi("loop $cp")
    wi("local.get $rem")
    wi("i32.eqz")
    wi("br_if $done")
    wi("local.get $d")
    wi("local.get $s")
    wi("i32.load8_u")
    wi("i32.store8")
    wi("local.get $d")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $d")
    wi("local.get $s")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $s")
    wi("local.get $rem")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $rem")
    wi("br $cp")
    wi("end")
    wi("end")
    wi("local.get $dst")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- int_* arithmetic helpers (R13A's bypass-the-classifier set) ----
    //
    // The R11D / R12A / R13A SIMD code calls int_add / int_mul / int_sub
    // etc. to bypass the smart-op classifier (which would otherwise treat
    // i32 buffer pointer arithmetic as string concat). On WASM these are
    // never inlined (cf. is_inline_builtin_fn gating cg_target==0), so
    // they must exist as callable WAT functions.
    wi("(func $int_add (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.add")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_sub (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.sub")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_mul (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.mul")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_div (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.div_s")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_mod (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.rem_s")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_and (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.and")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_or (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.or")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_xor (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.xor")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_shl (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.shl")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    wi("(func $int_shr (param $a i64) (param $b i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $a")
    wi("local.get $b")
    wi("i64.shr_s")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- simd_add_i32x8: dst[0..32] = a[0..32] + b[0..32] lanewise ----
    //
    // WAT shape (per half, repeated twice for the two 16-byte halves):
    //   v128.load a_off
    //   v128.load b_off
    //   i32x4.add        ;; 0xfd 110 -- lanewise i32 add, 4 lanes
    //   v128.store dst_off
    //
    // a, b, dst are i64 NOVA pointers; v128 memory ops use i32 addresses
    // so wrap each pointer with i32.wrap_i64. Returns dst (matching the
    // native AVX2 / NEON ABI: pointer in rax / x0).
    wi("(func $simd_add_i32x8 (param $a i64) (param $b i64) (param $dst i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ap i32)")
    wi("(local $bp i32)")
    wi("(local $dp i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.set $ap")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.set $bp")
    wi("local.get $dst")
    wi("i32.wrap_i64")
    wi("local.set $dp")
    // Lower 16 bytes (lanes 0..3).
    wi("local.get $dp")
    wi("local.get $ap")
    wi("v128.load")
    wi("local.get $bp")
    wi("v128.load")
    wi("i32x4.add")
    wi("v128.store")
    // Upper 16 bytes (lanes 4..7).
    wi("local.get $dp")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.get $ap")
    wi("i32.const 16")
    wi("i32.add")
    wi("v128.load")
    wi("local.get $bp")
    wi("i32.const 16")
    wi("i32.add")
    wi("v128.load")
    wi("i32x4.add")
    wi("v128.store")
    wi("local.get $dst")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- simd_sub_i32x8: dst = a - b lanewise (mirror of add) ----
    wi("(func $simd_sub_i32x8 (param $a i64) (param $b i64) (param $dst i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ap i32)")
    wi("(local $bp i32)")
    wi("(local $dp i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.set $ap")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.set $bp")
    wi("local.get $dst")
    wi("i32.wrap_i64")
    wi("local.set $dp")
    wi("local.get $dp")
    wi("local.get $ap")
    wi("v128.load")
    wi("local.get $bp")
    wi("v128.load")
    wi("i32x4.sub")
    wi("v128.store")
    wi("local.get $dp")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.get $ap")
    wi("i32.const 16")
    wi("i32.add")
    wi("v128.load")
    wi("local.get $bp")
    wi("i32.const 16")
    wi("i32.add")
    wi("v128.load")
    wi("i32x4.sub")
    wi("v128.store")
    wi("local.get $dst")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- simd_load_i32x8: 32-byte copy via 2x v128.load + 2x v128.store ----
    //
    // ABI mirrors the AVX2 path (rdi=src, rsi=dst, returns dst). The
    // explicit v128 load/store pair makes the 32-byte copy visible to
    // SIMD analysis tools (wasm-objdump grep v128).
    wi("(func $simd_load_i32x8 (param $src i64) (param $dst i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $sp i32)")
    wi("(local $dp i32)")
    wi("local.get $src")
    wi("i32.wrap_i64")
    wi("local.set $sp")
    wi("local.get $dst")
    wi("i32.wrap_i64")
    wi("local.set $dp")
    wi("local.get $dp")
    wi("local.get $sp")
    wi("v128.load")
    wi("v128.store")
    wi("local.get $dp")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.get $sp")
    wi("i32.const 16")
    wi("i32.add")
    wi("v128.load")
    wi("v128.store")
    wi("local.get $dst")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- simd_store_i32x8: arg-mirror of load (dst, src) ABI ----
    wi("(func $simd_store_i32x8 (param $dst i64) (param $src i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $sp i32)")
    wi("(local $dp i32)")
    wi("local.get $src")
    wi("i32.wrap_i64")
    wi("local.set $sp")
    wi("local.get $dst")
    wi("i32.wrap_i64")
    wi("local.set $dp")
    wi("local.get $dp")
    wi("local.get $sp")
    wi("v128.load")
    wi("v128.store")
    wi("local.get $dp")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.get $sp")
    wi("i32.const 16")
    wi("i32.add")
    wi("v128.load")
    wi("v128.store")
    wi("local.get $dst")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- simd_sum_abs_diff(a, b, n) -> sum(abs(a[i]-b[i])) for n i32 lanes ----
    //
    // WAT shape:
    //   acc = v128.splat(0)               ;; 4-lane i32 accumulator
    //   while n >= 8:                     ;; 8 lanes per iter (2x v128)
    //     d0 = i32x4.abs(i32x4.sub(load a, load b))   ;; lanes 0..3
    //     d1 = i32x4.abs(i32x4.sub(load a+16, load b+16)) ;; lanes 4..7
    //     acc = acc + d0 + d1
    //     a += 32; b += 32; n -= 8
    //   sum = extract_lane(acc, 0) + ... + extract_lane(acc, 3)
    //   while n > 0:                      ;; scalar tail
    //     sum += abs(load_i32(a) - load_i32(b))
    //     a += 4; b += 4; n -= 1
    //   return sum
    wi("(func $simd_sum_abs_diff (param $a i64) (param $b i64) (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ap i32)")
    wi("(local $bp i32)")
    wi("(local $nn i32)")
    wi("(local $sum i32)")
    wi("(local $acc v128)")
    wi("(local $diff i32)")
    wi("(local $sign i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.set $ap")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.set $bp")
    wi("local.get $n")
    wi("i32.wrap_i64")
    wi("local.set $nn")
    wi("i32.const 0")
    wi("i32x4.splat")
    wi("local.set $acc")
    // Vector loop: 8 i32 lanes per iter via 2x v128.
    wi("block $vec_done")
    wi("loop $vec")
    wi("local.get $nn")
    wi("i32.const 8")
    wi("i32.lt_s")
    wi("br_if $vec_done")
    // acc += abs(a[0..3] - b[0..3])
    wi("local.get $acc")
    wi("local.get $ap")
    wi("v128.load")
    wi("local.get $bp")
    wi("v128.load")
    wi("i32x4.sub")
    wi("i32x4.abs")
    wi("i32x4.add")
    // acc += abs(a[4..7] - b[4..7])
    wi("local.get $ap")
    wi("i32.const 16")
    wi("i32.add")
    wi("v128.load")
    wi("local.get $bp")
    wi("i32.const 16")
    wi("i32.add")
    wi("v128.load")
    wi("i32x4.sub")
    wi("i32x4.abs")
    wi("i32x4.add")
    wi("local.set $acc")
    wi("local.get $ap")
    wi("i32.const 32")
    wi("i32.add")
    wi("local.set $ap")
    wi("local.get $bp")
    wi("i32.const 32")
    wi("i32.add")
    wi("local.set $bp")
    wi("local.get $nn")
    wi("i32.const 8")
    wi("i32.sub")
    wi("local.set $nn")
    wi("br $vec")
    wi("end")
    wi("end")
    // Horizontal sum: extract all 4 lanes of acc.
    wi("local.get $acc")
    wi("i32x4.extract_lane 0")
    wi("local.get $acc")
    wi("i32x4.extract_lane 1")
    wi("i32.add")
    wi("local.get $acc")
    wi("i32x4.extract_lane 2")
    wi("i32.add")
    wi("local.get $acc")
    wi("i32x4.extract_lane 3")
    wi("i32.add")
    wi("local.set $sum")
    // Scalar tail (n % 8).
    wi("block $tail_done")
    wi("loop $tail")
    wi("local.get $nn")
    wi("i32.eqz")
    wi("br_if $tail_done")
    wi("local.get $ap")
    wi("i32.load")
    wi("local.get $bp")
    wi("i32.load")
    wi("i32.sub")
    wi("local.set $diff")
    wi("local.get $diff")
    wi("i32.const 31")
    wi("i32.shr_s")
    wi("local.set $sign")
    wi("local.get $sum")
    wi("local.get $diff")
    wi("local.get $sign")
    wi("i32.xor")
    wi("local.get $sign")
    wi("i32.sub")
    wi("i32.add")
    wi("local.set $sum")
    wi("local.get $ap")
    wi("i32.const 4")
    wi("i32.add")
    wi("local.set $ap")
    wi("local.get $bp")
    wi("i32.const 4")
    wi("i32.add")
    wi("local.set $bp")
    wi("local.get $nn")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $nn")
    wi("br $tail")
    wi("end")
    wi("end")
    wi("local.get $sum")
    wi("i64.extend_i32_s")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- simd_sad_u8(a, b, n_bytes) -> sum(abs(a[i]-b[i])) for n u8 lanes ----
    //
    // WAT shape:
    //   acc = i32x4.splat(0)
    //   while n >= 16:                     ;; 16 bytes per iter, 1 v128
    //     va = v128.load a
    //     vb = v128.load b
    //     d  = i8x16.sub_sat_u(a,b) | i8x16.sub_sat_u(b,a)   ;; unsigned abs diff
    //     w  = i16x8.extadd_pairwise_i8x16_u(d)   ;; 8 lanes of i16 partial
    //     i32w = i32x4.extadd_pairwise_i16x8_u(w) ;; 4 lanes of i32 partial
    //     acc = acc + i32w
    //     a += 16; b += 16; n -= 16
    //   sum = extract_lane(acc, 0) + ... + extract_lane(acc, 3)
    //   while n > 0:                       ;; scalar byte tail
    //     sum += abs((u8)a - (u8)b)
    //     a += 1; b += 1; n -= 1
    //   return sum
    //
    // The abs-diff via `sub_sat_u | sub_sat_u(swapped)` is the standard
    // unsigned-byte absolute-difference idiom in v128 (no direct uabd
    // op). saturate ensures (a-b) when b>a is zero, and the OR collects
    // both halves into the unsigned magnitude.
    wi("(func $simd_sad_u8 (param $a i64) (param $b i64) (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ap i32)")
    wi("(local $bp i32)")
    wi("(local $nn i32)")
    wi("(local $sum i32)")
    wi("(local $acc v128)")
    wi("(local $va v128)")
    wi("(local $vb v128)")
    wi("(local $diff i32)")
    wi("(local $sign i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.set $ap")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.set $bp")
    wi("local.get $n")
    wi("i32.wrap_i64")
    wi("local.set $nn")
    wi("i32.const 0")
    wi("i32x4.splat")
    wi("local.set $acc")
    // Vector loop: 16 bytes per iter.
    wi("block $vec_done_u8")
    wi("loop $vec_u8")
    wi("local.get $nn")
    wi("i32.const 16")
    wi("i32.lt_s")
    wi("br_if $vec_done_u8")
    wi("local.get $ap")
    wi("v128.load")
    wi("local.set $va")
    wi("local.get $bp")
    wi("v128.load")
    wi("local.set $vb")
    wi("local.get $acc")
    // (va - vb) saturated to 0 for negative + (vb - va) saturated = abs diff.
    wi("local.get $va")
    wi("local.get $vb")
    wi("i8x16.sub_sat_u")
    wi("local.get $vb")
    wi("local.get $va")
    wi("i8x16.sub_sat_u")
    wi("v128.or")
    // i8x16 -> i16x8 pairwise add (each i16 lane = u8 + u8).
    wi("i16x8.extadd_pairwise_i8x16_u")
    // i16x8 -> i32x4 pairwise add (each i32 lane = u16 + u16).
    wi("i32x4.extadd_pairwise_i16x8_u")
    wi("i32x4.add")
    wi("local.set $acc")
    wi("local.get $ap")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.set $ap")
    wi("local.get $bp")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.set $bp")
    wi("local.get $nn")
    wi("i32.const 16")
    wi("i32.sub")
    wi("local.set $nn")
    wi("br $vec_u8")
    wi("end")
    wi("end")
    // Horizontal sum.
    wi("local.get $acc")
    wi("i32x4.extract_lane 0")
    wi("local.get $acc")
    wi("i32x4.extract_lane 1")
    wi("i32.add")
    wi("local.get $acc")
    wi("i32x4.extract_lane 2")
    wi("i32.add")
    wi("local.get $acc")
    wi("i32x4.extract_lane 3")
    wi("i32.add")
    wi("local.set $sum")
    // Scalar tail (n % 16).
    wi("block $tail_done_u8")
    wi("loop $tail_u8")
    wi("local.get $nn")
    wi("i32.eqz")
    wi("br_if $tail_done_u8")
    wi("local.get $ap")
    wi("i32.load8_u")
    wi("local.get $bp")
    wi("i32.load8_u")
    wi("i32.sub")
    wi("local.set $diff")
    // abs(diff) without branches: (diff ^ sign) - sign, where sign = diff >> 31.
    wi("local.get $diff")
    wi("i32.const 31")
    wi("i32.shr_s")
    wi("local.set $sign")
    wi("local.get $sum")
    wi("local.get $diff")
    wi("local.get $sign")
    wi("i32.xor")
    wi("local.get $sign")
    wi("i32.sub")
    wi("i32.add")
    wi("local.set $sum")
    wi("local.get $ap")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ap")
    wi("local.get $bp")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $bp")
    wi("local.get $nn")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $nn")
    wi("br $tail_u8")
    wi("end")
    wi("end")
    wi("local.get $sum")
    wi("i64.extend_i32_s")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- simd_mul_acc_byte_signed_byte(a, b, n) -> Sum a[i]*b[i] ----
    // R18A: byte mul-acc primitive on WASM v128 (Phase 4 SIMD).
    //
    // Lowering: 16 bytes per iter. Load 16 a-bytes + 16 b-bytes via
    // v128.load (each). Widen each half:
    //   a_lo = i16x8.extend_low_i8x16_u  (u8 -> u16, 8 lanes)
    //   b_lo = i16x8.extend_low_i8x16_s  (i8 -> i16, 8 lanes)
    //   a_hi = i16x8.extend_high_i8x16_u
    //   b_hi = i16x8.extend_high_i8x16_s
    // Then i32x4.dot_i16x8_s computes 4 i32 lanes of (i16*i16 + i16*i16),
    // accumulated into a v128 i32x4 accumulator. Horizontal-sum at end.
    // Tail (n % 16) is scalar: load u8 a + signed i8 b, multiply, add.
    wi("(func $simd_mul_acc_byte_signed_byte (param $a i64) (param $b i64) (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ap i32)")
    wi("(local $bp i32)")
    wi("(local $nn i32)")
    wi("(local $sum i32)")
    wi("(local $acc v128)")
    wi("(local $va v128)")
    wi("(local $vb v128)")
    wi("(local $byte_b i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.set $ap")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.set $bp")
    wi("local.get $n")
    wi("i32.wrap_i64")
    wi("local.set $nn")
    wi("i32.const 0")
    wi("i32x4.splat")
    wi("local.set $acc")
    // Vector loop: 16 bytes per iter.
    wi("block $vec_done_us")
    wi("loop $vec_us")
    wi("local.get $nn")
    wi("i32.const 16")
    wi("i32.lt_s")
    wi("br_if $vec_done_us")
    wi("local.get $ap")
    wi("v128.load")
    wi("local.set $va")
    wi("local.get $bp")
    wi("v128.load")
    wi("local.set $vb")
    // Low half: a zero-extend, b sign-extend, dot, accumulate.
    wi("local.get $acc")
    wi("local.get $va")
    wi("i16x8.extend_low_i8x16_u")
    wi("local.get $vb")
    wi("i16x8.extend_low_i8x16_s")
    wi("i32x4.dot_i16x8_s")
    wi("i32x4.add")
    // High half: a zero-extend, b sign-extend, dot, accumulate.
    wi("local.get $va")
    wi("i16x8.extend_high_i8x16_u")
    wi("local.get $vb")
    wi("i16x8.extend_high_i8x16_s")
    wi("i32x4.dot_i16x8_s")
    wi("i32x4.add")
    wi("local.set $acc")
    wi("local.get $ap")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.set $ap")
    wi("local.get $bp")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.set $bp")
    wi("local.get $nn")
    wi("i32.const 16")
    wi("i32.sub")
    wi("local.set $nn")
    wi("br $vec_us")
    wi("end")
    wi("end")
    // Horizontal sum of acc (4 i32 lanes) -> scalar sum.
    wi("local.get $acc")
    wi("i32x4.extract_lane 0")
    wi("local.get $acc")
    wi("i32x4.extract_lane 1")
    wi("i32.add")
    wi("local.get $acc")
    wi("i32x4.extract_lane 2")
    wi("i32.add")
    wi("local.get $acc")
    wi("i32x4.extract_lane 3")
    wi("i32.add")
    wi("local.set $sum")
    // Scalar tail (n % 16). a is u8 (zero-ext), b is i8 (sign-ext).
    wi("block $tail_done_us")
    wi("loop $tail_us")
    wi("local.get $nn")
    wi("i32.eqz")
    wi("br_if $tail_done_us")
    wi("local.get $bp")
    wi("i32.load8_s")
    wi("local.set $byte_b")
    wi("local.get $sum")
    wi("local.get $ap")
    wi("i32.load8_u")
    wi("local.get $byte_b")
    wi("i32.mul")
    wi("i32.add")
    wi("local.set $sum")
    wi("local.get $ap")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ap")
    wi("local.get $bp")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $bp")
    wi("local.get $nn")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $nn")
    wi("br $tail_us")
    wi("end")
    wi("end")
    wi("local.get $sum")
    wi("i64.extend_i32_s")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // ---- simd_mul_acc_signed_signed_byte(a, b, n) -> Sum a[i]*b[i] ----
    // R18A: byte mul-acc primitive, both args signed i8 (LK gradients).
    // Same shape as byte_signed_byte but uses extend_low/high_i8x16_s
    // for both operands, and i32.load8_s for both bytes in the tail.
    wi("(func $simd_mul_acc_signed_signed_byte (param $a i64) (param $b i64) (param $n i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $ap i32)")
    wi("(local $bp i32)")
    wi("(local $nn i32)")
    wi("(local $sum i32)")
    wi("(local $acc v128)")
    wi("(local $va v128)")
    wi("(local $vb v128)")
    wi("(local $byte_b i32)")
    wi("local.get $a")
    wi("i32.wrap_i64")
    wi("local.set $ap")
    wi("local.get $b")
    wi("i32.wrap_i64")
    wi("local.set $bp")
    wi("local.get $n")
    wi("i32.wrap_i64")
    wi("local.set $nn")
    wi("i32.const 0")
    wi("i32x4.splat")
    wi("local.set $acc")
    wi("block $vec_done_ss")
    wi("loop $vec_ss")
    wi("local.get $nn")
    wi("i32.const 16")
    wi("i32.lt_s")
    wi("br_if $vec_done_ss")
    wi("local.get $ap")
    wi("v128.load")
    wi("local.set $va")
    wi("local.get $bp")
    wi("v128.load")
    wi("local.set $vb")
    wi("local.get $acc")
    wi("local.get $va")
    wi("i16x8.extend_low_i8x16_s")
    wi("local.get $vb")
    wi("i16x8.extend_low_i8x16_s")
    wi("i32x4.dot_i16x8_s")
    wi("i32x4.add")
    wi("local.get $va")
    wi("i16x8.extend_high_i8x16_s")
    wi("local.get $vb")
    wi("i16x8.extend_high_i8x16_s")
    wi("i32x4.dot_i16x8_s")
    wi("i32x4.add")
    wi("local.set $acc")
    wi("local.get $ap")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.set $ap")
    wi("local.get $bp")
    wi("i32.const 16")
    wi("i32.add")
    wi("local.set $bp")
    wi("local.get $nn")
    wi("i32.const 16")
    wi("i32.sub")
    wi("local.set $nn")
    wi("br $vec_ss")
    wi("end")
    wi("end")
    wi("local.get $acc")
    wi("i32x4.extract_lane 0")
    wi("local.get $acc")
    wi("i32x4.extract_lane 1")
    wi("i32.add")
    wi("local.get $acc")
    wi("i32x4.extract_lane 2")
    wi("i32.add")
    wi("local.get $acc")
    wi("i32x4.extract_lane 3")
    wi("i32.add")
    wi("local.set $sum")
    wi("block $tail_done_ss")
    wi("loop $tail_ss")
    wi("local.get $nn")
    wi("i32.eqz")
    wi("br_if $tail_done_ss")
    wi("local.get $bp")
    wi("i32.load8_s")
    wi("local.set $byte_b")
    wi("local.get $sum")
    wi("local.get $ap")
    wi("i32.load8_s")
    wi("local.get $byte_b")
    wi("i32.mul")
    wi("i32.add")
    wi("local.set $sum")
    wi("local.get $ap")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $ap")
    wi("local.get $bp")
    wi("i32.const 1")
    wi("i32.add")
    wi("local.set $bp")
    wi("local.get $nn")
    wi("i32.const 1")
    wi("i32.sub")
    wi("local.set $nn")
    wi("br $tail_ss")
    wi("end")
    wi("end")
    wi("local.get $sum")
    wi("i64.extend_i32_s")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

fn wasm_gen_program(program) {
    let decls = program[1]
    wasm_strs = list_new()
    wasm_str_offset = 8192
    wasm_data_entries = list_new()
    wasm_indent = 0
    wasm_fn_names = list_new()
    wasm_block_depth = 0

    // R19B: register enum declarations so the R17A enum codegen can
    // resolve `enum_variant_index` etc. Globals are collected separately
    // below.
    // R25A: also register struct declarations so cg_reorder_struct_init
    // (called from wasm_gen_expr's AST_STRUCT_INIT handler) can find
    // the field-declaration order.
    let i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_ENUM_DECL {
            let entry = list_new()
            push(entry, d[1])
            push(entry, d[2])
            push(cg_enums, entry)
            cg_enum_count = cg_enum_count + 1
        }
        if ast_tag(d) == AST_STRUCT_DECL {
            let s_entry = list_new()
            push(s_entry, d[1])
            push(s_entry, d[2])
            push(cg_structs, s_entry)
            cg_struct_count = cg_struct_count + 1
        }
        i = i + 1
    }

    // Collect globals
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_LET_STMT {
            add_global(d[1])
        }
        // R32D: top-level AST_BLOCK (struct / enum destructure lowering).
        if ast_tag(d) == AST_BLOCK {
            cg_collect_block_globals(d)
        }
        i = i + 1
    }

    // Collect function names
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            push(cg_fns, d[1])
            _cg_ht_add(cg_fns_ht, d[1])
            _cg_ht_set(cg_fn_modules, d[1], cg_source_file)
            push(wasm_fn_names, d[1])
        }
        i = i + 1
    }

    let Q = chr(34)

    // Module header.
    //
    // WASI snapshot_preview1 import surface (R8A: serverless preopens).
    // The full set lets a NOVA program touch the host filesystem under
    // wasmtime/wasmer/Cloudflare-Workers-style runtimes that grant the
    // sandbox `--dir=` or `--mapdir=` preopens. Earlier rounds wired up
    // {fd_write, fd_read, fd_close, fd_seek, path_open, random_get,
    //  proc_exit}; R8A adds {path_filestat_get, args_get, args_sizes_get,
    // environ_get, environ_sizes_get} so file metadata + argv + envp
    // become callable from NOVA. All imports are always emitted (vs.
    // conditional) -- WASI hosts don't penalise unused imports, and a
    // fixed import surface keeps the module header bit-stable so the
    // self-host diff stays clean.
    out("(module")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "fd_write" + Q + " (func $fd_write (param i32 i32 i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "fd_read" + Q + " (func $fd_read (param i32 i32 i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "fd_close" + Q + " (func $fd_close (param i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "fd_seek" + Q + " (func $fd_seek (param i32 i64 i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "path_open" + Q + " (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "path_filestat_get" + Q + " (func $path_filestat_get (param i32 i32 i32 i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "args_sizes_get" + Q + " (func $args_sizes_get (param i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "args_get" + Q + " (func $args_get (param i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "environ_sizes_get" + Q + " (func $environ_sizes_get (param i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "environ_get" + Q + " (func $environ_get (param i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "random_get" + Q + " (func $random_get (param i32 i32) (result i32)))")
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "proc_exit" + Q + " (func $proc_exit (param i32)))")
    // R30D: poll_oneoff for the WASM sys_poll translation shim. The
    // signature mirrors the witx-defined contract --
    //   poll_oneoff(in: *const subscription, out: *mut event,
    //               nsubscriptions: size, nevents_out: *mut size) -> errno
    // -- where size + errno are u32 in preview1. Subscriptions and
    // events are caller-allocated linear-memory arrays; the host fills
    // `out` and writes the produced event count to `nevents_out`.
    out("  (import " + Q + "wasi_snapshot_preview1" + Q + " " + Q + "poll_oneoff" + Q + " (func $poll_oneoff (param i32 i32 i32 i32) (result i32)))")
    out("  (memory (export " + Q + "memory" + Q + ") 256)")
    // Heap base lives above 1 MiB so heap-allocated objects pass the
    // pointer/int classifier in rt_eq / len / type_of (which use the
    // < 1048576 magnitude heuristic inherited from the native target).
    // R8A: required for wasi_args_get / wasi_environ_get to return a
    // working NOVA list. String literals at 8192..1MB are still
    // misclassified by len() / rt_eq() -- a separate WASM rt limitation
    // tracked in WASM_AUDIT.md; existing wasm tests work around it by
    // not calling len() on strings.
    out("  (global $heap_ptr (mut i64) (i64.const 1114112))")
    out("  (global $g__wasm_list_tmp (mut i64) (i64.const 0))")
    // R19B: scratch for the AST_MATCH_STMT discriminant (R17A.2 enum
    // codegen). Each match nests reads/writes only inside one arm chain.
    out("  (global $g__wasm_match_disc (mut i64) (i64.const 0))")
    // R20A: scratch for the AST_TRY_PROPAGATE inner value while we tag
    // check + decide Ok-unwrap vs Err-return.
    out("  (global $g__wasm_q_tmp (mut i64) (i64.const 0))")
    i = 0
    while i < cg_global_count {
        out("  (global $g_" + cg_globals[i] + " (mut i64) (i64.const 0))")
        i = i + 1
    }
    out("")

    // Runtime functions
    wasm_indent = 1
    wasm_gen_rt_core()
    wasm_gen_rt_io()
    wasm_gen_rt_extra()
    wasm_gen_rt_simd()

    // User functions
    i = 0
    while i < len(decls) {
        let d = decls[i]
        if ast_tag(d) == AST_FN_DECL {
            wasm_gen_function(d)
        }
        i = i + 1
    }

    // _start entry point
    out("  (func (export " + Q + "_start" + Q + ")")
    wasm_indent = 2

    // Collect top-level locals
    //
    // R19B: also walk top-level AST_MATCH_STMT / AST_LET_STMT bodies so
    // AST_ENUM_PATTERN binders inside top-level match arms get registered
    // as locals. Top-level `let` names are still globals (set above by
    // add_global), but binders introduced by `match` aren't, so they need
    // a slot in the start function.
    wasm_local_map = list_new()
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dtag = ast_tag(d)
        if dtag == AST_IF_STMT { wasm_collect_locals(d) }
        if dtag == AST_WHILE_STMT { wasm_collect_locals(d) }
        if dtag == AST_FOR_STMT { wasm_collect_locals(d) }
        if dtag == AST_DO_WHILE { wasm_collect_locals(d) }
        if dtag == AST_FOR_INDEXED { wasm_collect_locals(d) }
        if dtag == AST_EXPR_STMT { wasm_collect_locals(d) }
        if dtag == AST_MATCH_STMT { wasm_collect_locals(d) }
        // R25A: top-level AST_BLOCK appears when parse_let lowers a
        // struct destructure pattern (`let Point { x, y } = p`) into a
        // block of plain lets. wasm_collect_locals already handles
        // AST_BLOCK recursively; just need to dispatch it here.
        if dtag == AST_BLOCK { wasm_collect_locals(d) }
        if dtag == AST_LET_STMT { wasm_collect_locals(d[2]) }
        if dtag == AST_ASSIGN_STMT { wasm_collect_locals(d[2]) }
        i = i + 1
    }

    let li = 0
    while li < len(wasm_local_map) {
        wi("(local $" + wasm_local_map[li] + " i64)")
        li = li + 1
    }
    wi("(local $_for_iter i64)")
    wi("(local $_for_idx i64)")

    // Generate top-level statements
    i = 0
    while i < len(decls) {
        let d = decls[i]
        let dtag2 = ast_tag(d)
        let skip = 0
        if dtag2 == AST_FN_DECL { skip = 1 }
        if dtag2 == AST_METHOD_DECL { skip = 1 }
        if dtag2 == AST_STRUCT_DECL { skip = 1 }
        if dtag2 == AST_ENUM_DECL { skip = 1 }
        if skip == 0 {
            wasm_gen_stmt(d)
        }
        i = i + 1
    }

    out("  )")
    out("")

    // Data section for strings
    i = 0
    while i < len(wasm_data_entries) {
        let doff = wasm_data_entries[i]
        let dstr = wasm_data_entries[i + 1]
        out("  (data (i32.const " + int_to_str(doff) + ") " + Q + wasm_escape_str(dstr) + chr(92) + "00" + Q + ")")
        i = i + 2
    }

    out(")")

    return join(cg_output, chr(10))
}

fn peephole_optimize() {
    let n = len(cg_output)
    let i = 0
    // Pass 1: push/pop elimination
    while i < n - 1 {
        let cur = cg_output[i]
        let nxt = cg_output[i + 1]
        if cur == "    push rax" {
            if nxt == "    pop rax" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "")
            }
            if nxt == "    pop rcx" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "    mov rcx, rax")
            }
            if nxt == "    pop rdi" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "    mov rdi, rax")
            }
            if nxt == "    pop rsi" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "    mov rsi, rax")
            }
        }
        if cur == "    push rcx" {
            if nxt == "    pop rcx" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "")
            }
        }
        if cur == "    push rdi" {
            if nxt == "    pop rdi" {
                list_set(cg_output, i, "")
                list_set(cg_output, i + 1, "")
            }
        }
        i = i + 1
    }
    // Pass 2: mov rax,0 → xor eax,eax; redundant movs
    i = 0
    while i < n {
        let cur = cg_output[i]
        if cur == "    mov rax, 0" {
            list_set(cg_output, i, "    xor eax, eax")
        }
        if cur == "    mov rdi, 0" {
            list_set(cg_output, i, "    xor edi, edi")
        }
        if cur == "    mov rsi, 0" {
            list_set(cg_output, i, "    xor esi, esi")
        }
        if cur == "    mov rcx, 0" {
            list_set(cg_output, i, "    xor ecx, ecx")
        }
        i = i + 1
    }
    // Pass 3: jmp-to-next-label elimination
    i = 0
    while i < n - 1 {
        let cur = cg_output[i]
        let nxt = cg_output[i + 1]
        if starts_with(cur, "    jmp ") == 1 {
            let target = substr(cur, 8, len(cur) - 8)
            if nxt == target + ":" {
                list_set(cg_output, i, "")
            }
        }
        i = i + 1
    }
    // Pass 4: redundant mov to same reg when second doesn't read that reg
    i = 0
    while i < n - 1 {
        let cur = cg_output[i]
        let nxt = cg_output[i + 1]
        if starts_with(cur, "    mov rax, ") == 1 {
            if starts_with(nxt, "    mov rax, ") == 1 {
                if contains(nxt, "rax]") == 0 {
                    if contains(nxt, "rax +") == 0 {
                        if contains(nxt, "rax*") == 0 {
                            list_set(cg_output, i, "")
                        }
                    }
                }
            }
        }
        i = i + 1
    }
}

fn gen_runtime() {
    // --- Pointer classification (root fix for PTR_THRESHOLD heuristic) ---
    //
    // A NOVA value is a pointer iff its address lies in one of two ranges:
    //   1. String literal range: [_strlit_start, _strlit_end)   — link-time fixed
    //   2. Heap range:           [_heap_base,    _heap_end)     — runtime
    // Anything else is an integer (including 0, negatives, and any value
    // outside the above ranges, no matter how large).
    //
    // Each helper preserves all GPRs except rax and flags. The result is
    // signalled via ZF: ZF=1 means "integer" (jz takes the int branch);
    // ZF=0 means "pointer" (jnz takes the pointer branch). This keeps the
    // call-site sequence to exactly two instructions per check, the same
    // as the legacy "cmp rdi, 0x100000; jl .X" pair it replaces.
    out_label("_nova_check_rdi")
    // Pointer-tagging classifier: bit 0 = 1 -> integer; bit 0 = 0 -> pointer.
    // Contract preserved: ZF=1 (rax=0) means integer; ZF=0 (rax=1) pointer.
    out("    test rdi, 1")
    out("    jz .ccr_yes")
    out("    xor eax, eax")
    out("    ret")
    // --- legacy range classifier below is now unreachable (kept for ref) ---
    out("    test rdi, rdi")
    out("    js .ccr_no")
    // Range 1: string literals (link-time fixed, low addresses).
    out("    lea rax, [rip + _strlit_start]")
    out("    cmp rdi, rax")
    out("    jb .ccr_after_strlit")
    out("    lea rax, [rip + _strlit_end]")
    out("    cmp rdi, rax")
    out("    jb .ccr_yes")
    out(".ccr_after_strlit:")
    // Range 2: NOVA heap (runtime, set by first _nova_alloc call).
    out("    mov rax, [rip + _heap_base]")
    out("    test rax, rax")
    out("    jz .ccr_after_heap")
    out("    cmp rdi, rax")
    out("    jb .ccr_after_heap")
    out("    mov rax, [rip + _heap_end]")
    out("    cmp rdi, rax")
    out("    jb .ccr_yes")
    out(".ccr_after_heap:")
    // Range 3: kernel-area high addresses (argv, env, stack, mmap'd heap on
    // non-brk targets). Anything >= 16 GiB is treated as a pointer. Real
    // integer values rarely reach this range; nanotimes and other huge
    // ints can still be operated on via int_* (kept as no-op wrappers).
    out("    mov rax, 0x400000000")
    out("    cmp rdi, rax")
    out("    jae .ccr_yes")
    out(".ccr_no:")
    out("    xor eax, eax")           // ZF=1, rax=0 → integer
    out("    ret")
    out(".ccr_yes:")
    out("    mov eax, 1")             // ZF=0, rax=1 → pointer
    out("    test eax, eax")          // re-establish ZF (mov does not set flags)
    out("    ret")

    out("")
    out_label("_nova_check_rsi")
    out("    test rsi, 1")
    out("    jz .ccs_yes")
    out("    xor eax, eax")
    out("    ret")
    out("    test rsi, rsi")
    out("    js .ccs_no")
    out("    lea rax, [rip + _strlit_start]")
    out("    cmp rsi, rax")
    out("    jb .ccs_after_strlit")
    out("    lea rax, [rip + _strlit_end]")
    out("    cmp rsi, rax")
    out("    jb .ccs_yes")
    out(".ccs_after_strlit:")
    out("    mov rax, [rip + _heap_base]")
    out("    test rax, rax")
    out("    jz .ccs_after_heap")
    out("    cmp rsi, rax")
    out("    jb .ccs_after_heap")
    out("    mov rax, [rip + _heap_end]")
    out("    cmp rsi, rax")
    out("    jb .ccs_yes")
    out(".ccs_after_heap:")
    out("    mov rax, 0x400000000")
    out("    cmp rsi, rax")
    out("    jae .ccs_yes")
    out(".ccs_no:")
    out("    xor eax, eax")
    out("    ret")
    out(".ccs_yes:")
    out("    mov eax, 1")
    out("    test eax, eax")
    out("    ret")

    // --- Smart add: integer add or string concat ---
    out("")
    out_label("_nova_add")
    out("    call _nova_check_rdi")
    out("    jz .add_int")
    out("    call _nova_check_rsi")
    out("    jz .add_int")
    out("    jmp _nova_concat")
    out(".add_int:")
    out("    lea rax, [rdi + rsi]")
    out("    dec rax")                 // tagged add: a + b - 1
    out("    ret")

    // --- Smart multiply: integer mul, string repeat, or list repeat ---
    out("")
    out_label("_nova_mul")
    out("    call _nova_check_rdi")
    out("    jnz .mul_ptr")
    out("    call _nova_check_rsi")
    out("    jnz .mul_ptr_swap")
    out("    lea rax, [rdi - 1]")       // a-1 = x<<1
    out("    mov rcx, rsi")
    out("    sar rcx, 1")               // b>>1 = y
    out("    imul rax, rcx")            // (x<<1)*y = (x*y)<<1
    out("    inc rax")                  // retag -> tagged(x*y)
    out("    ret")
    out(".mul_ptr_swap:")
    out("    xchg rdi, rsi")
    out(".mul_ptr:")
    out("    cmp qword ptr [rdi], -1")
    out("    je .mul_list")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call str_repeat")
    out("    pop rbp")
    out("    ret")
    out(".mul_list:")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_list_repeat")
    out("    pop rbp")
    out("    ret")

    // --- Power: rdi ** rsi (integer exponentiation) ---
    out("")
    out_label("_nova_pow")
    out("    mov rax, 1")
    out("    test rsi, rsi")
    out("    jz .pow_done")
    out(".pow_loop:")
    out("    imul rax, rdi")
    out("    dec rsi")
    out("    jnz .pow_loop")
    out(".pow_done:")
    out("    ret")

    // --- List repeat: rdi=list, rsi=count ---
    out("")
    out_label("_nova_list_repeat")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    push r15")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    sar r13, 1")                 // untag repeat count
    out("    call _nova_list_new")
    out("    mov r14, rax")
    out("    xor r15, r15")
    out(".listrep_outer:")
    out("    cmp r15, r13")
    out("    jge .listrep_done")
    out("    mov rax, [r12 + 8]")
    out("    xor rcx, rcx")
    out(".listrep_inner:")
    out("    cmp rcx, rax")
    out("    jge .listrep_next")
    out("    push rax")
    out("    push rcx")
    out("    mov rdx, [r12 + 24]")
    out("    mov rsi, [rdx + rcx*8]")
    out("    mov rdi, r14")
    out("    call _nova_push")
    out("    pop rcx")
    out("    pop rax")
    out("    inc rcx")
    out("    jmp .listrep_inner")
    out(".listrep_next:")
    out("    inc r15")
    out("    jmp .listrep_outer")
    out(".listrep_done:")
    out("    mov rax, r14")
    out("    pop r15")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- Smart equality: integer or string ---
    out("")
    out_label("_nova_eq")
    out("    cmp rdi, rsi")
    out("    je .eq_true")
    out("    call _nova_check_rdi")
    out("    jz .eq_false")
    out("    call _nova_check_rsi")
    out("    jz .eq_false")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_str_eq")
    out("    lea rax, [rax + rax + 1]")    // tag 0/1 result
    out("    pop rbp")
    out("    ret")
    out(".eq_true:")
    out("    mov eax, 3")                  // tagged true
    out("    ret")
    out(".eq_false:")
    out("    mov eax, 1")                  // tagged false
    out("    ret")

    // --- Smart not-equal ---
    out("")
    out_label("_nova_neq")
    out("    cmp rdi, rsi")
    out("    je .neq_false")
    out("    call _nova_check_rdi")
    out("    jz .neq_true")
    out("    call _nova_check_rsi")
    out("    jz .neq_true")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_str_eq")
    out("    xor eax, 1")
    out("    lea rax, [rax + rax + 1]")    // tag 0/1 result
    out("    pop rbp")
    out("    ret")
    out(".neq_true:")
    out("    mov eax, 3")                  // tagged true
    out("    ret")
    out(".neq_false:")
    out("    mov eax, 1")                  // tagged false
    out("    ret")

    // --- Smart less-than: int or string comparison ---
    out("")
    out_label("_nova_lt")
    out("    call _nova_check_rdi")
    out("    jz .lt_int")
    out("    call _nova_check_rsi")
    out("    jz .lt_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_strcmp")
    out("    pop rbp")
    out("    test rax, rax")
    out("    setl al")
    out("    movzx rax, al")
    out("    ret")
    out(".lt_int:")
    out("    cmp rdi, rsi")
    out("    setl al")
    out("    movzx rax, al")
    out("    ret")

    // --- Smart greater-than ---
    out("")
    out_label("_nova_gt")
    out("    call _nova_check_rdi")
    out("    jz .gt_int")
    out("    call _nova_check_rsi")
    out("    jz .gt_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_strcmp")
    out("    pop rbp")
    out("    test rax, rax")
    out("    setg al")
    out("    movzx rax, al")
    out("    ret")
    out(".gt_int:")
    out("    cmp rdi, rsi")
    out("    setg al")
    out("    movzx rax, al")
    out("    ret")

    // --- Smart less-equal ---
    out("")
    out_label("_nova_le")
    out("    call _nova_check_rdi")
    out("    jz .le_int")
    out("    call _nova_check_rsi")
    out("    jz .le_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_strcmp")
    out("    pop rbp")
    out("    test rax, rax")
    out("    setle al")
    out("    movzx rax, al")
    out("    ret")
    out(".le_int:")
    out("    cmp rdi, rsi")
    out("    setle al")
    out("    movzx rax, al")
    out("    ret")

    // --- Smart greater-equal ---
    out("")
    out_label("_nova_ge")
    out("    call _nova_check_rdi")
    out("    jz .ge_int")
    out("    call _nova_check_rsi")
    out("    jz .ge_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    call _nova_strcmp")
    out("    pop rbp")
    out("    test rax, rax")
    out("    setge al")
    out("    movzx rax, al")
    out("    ret")
    out(".ge_int:")
    out("    cmp rdi, rsi")
    out("    setge al")
    out("    movzx rax, al")
    out("    ret")

    // --- String compare: returns -1, 0, or 1 ---
    out("")
    out_label("_nova_strcmp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out(".strcmp_loop:")
    out("    movzx eax, byte ptr [r12]")
    out("    movzx ecx, byte ptr [r13]")
    out("    test al, al")
    out("    jz .strcmp_end")
    out("    test cl, cl")
    out("    jz .strcmp_end")
    out("    cmp al, cl")
    out("    jne .strcmp_diff")
    out("    inc r12")
    out("    inc r13")
    out("    jmp .strcmp_loop")
    out(".strcmp_diff:")
    out("    sub rax, rcx")
    out("    pop r13")
    out("    pop r12")
    out("    ret")
    out(".strcmp_end:")
    out("    sub rax, rcx")
    out("    pop r13")
    out("    pop r12")
    out("    ret")

    // --- print_int ---
    out("")
    out_label("_nova_print_int")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rsi, rdi")
    out("    sar rsi, 1")                 // untag tagged integer argument
    out("    test rsi, rsi")
    out("    jnz .pi_nonzero")
    out("    mov byte ptr [rbp-1], 48")
    out("    lea rsi, [rbp-1]")
    out("    mov rdx, 1")
    out("    jmp .pi_write")
    out(".pi_nonzero:")
    out("    lea rdi, [rbp-1]")
    out("    xor ecx, ecx")
    out("    mov rax, rsi")
    out("    test rax, rax")
    out("    jns .pi_pos")
    out("    neg rax")
    out("    mov cl, 1")
    out(".pi_pos:")
    out(".pi_loop:")
    out("    test rax, rax")
    out("    jz .pi_done_digits")
    out("    xor edx, edx")
    out("    mov r8, 10")
    out("    div r8")
    out("    add dl, 48")
    out("    mov [rdi], dl")
    out("    dec rdi")
    out("    jmp .pi_loop")
    out(".pi_done_digits:")
    out("    test cl, cl")
    out("    jz .pi_no_sign")
    out("    mov byte ptr [rdi], 45")
    out("    dec rdi")
    out(".pi_no_sign:")
    out("    inc rdi")
    out("    lea rdx, [rbp-1]")
    out("    sub rdx, rdi")
    out("    inc rdx")
    out("    mov rsi, rdi")
    out(".pi_write:")
    if cg_target == 3 {
        // PROVES alignment: entry %16==8; push rbp -> %16==0;
        // sub rsp,32 -> %16==0; push rdx + push rsi -> %16==0; win_call adds
        // 32 keeping it aligned. After pops, %16==0. We then sub rsp,48
        // (mult of 16) to fit shadow (32) + 5th arg (8) + 8 padding, keeping
        // %16==0 at the WriteFile call.
        out("    push rdx")
        out("    push rsi")
        out("    mov ecx, -11")
        win_call("GetStdHandle")
        out("    pop rsi")
        out("    pop rdx")
        out("    mov rcx, rax")
        out("    mov r8, rdx")
        out("    mov rdx, rsi")
        out("    lea r9, [rbp - 32]")
        out("    sub rsp, 48")
        out("    mov qword ptr [rsp + 32], 0")
        out("    call [rip + __imp_WriteFile]")
        out("    add rsp, 48")
    } else {
        out("    mov rdi, 1")
        emit_syscall(1)
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- print_str ---
    out("")
    out_label("_nova_print_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rsi, rdi")
    out("    xor edx, edx")
    out(".ps_len:")
    out("    cmp byte ptr [rsi + rdx], 0")
    out("    je .ps_write")
    out("    inc edx")
    out("    jmp .ps_len")
    out(".ps_write:")
    if cg_target == 3 {
        // PROVES alignment: entry %16==8; push rbp -> %16==0; the win_call
        // wrap is balanced. After the 2 pops we're at %16==0. We then
        // sub rsp, 48 (mult of 16): 16 for BytesWritten slot at rsp+40,
        // 32 shadow, with 5th arg at rsp+32 also zero. Alignment: rsp%16==0
        // at the call.
        out("    push rdx")
        out("    push rsi")
        out("    mov ecx, -11")
        win_call("GetStdHandle")
        out("    pop rsi")
        out("    pop rdx")
        out("    sub rsp, 48")
        out("    mov rcx, rax")
        out("    mov r8, rdx")
        out("    mov rdx, rsi")
        out("    lea r9, [rsp + 40]")
        out("    mov qword ptr [rsp + 40], 0")
        out("    mov qword ptr [rsp + 32], 0")
        out("    call [rip + __imp_WriteFile]")
        out("    add rsp, 48")
    } else {
        out("    mov rdi, 1")
        emit_syscall(1)
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- println (print string + newline) ---
    out("")
    out_label("_nova_println")
    if cg_target == 3 {
        // Layout: [rbp-8]=saved rdi; [rbp-16]=\n byte; [rbp-24]=BytesWritten.
        // PROVES alignment: entry %16==8; push rbp -> %16==0;
        // sub rsp,48 (mult 16) -> %16==0; win_call shadow keeps it; WriteFile
        // call site: sub rsp,48 keeps %16==0.
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 48")
        out("    mov [rbp - 8], rdi")
        out("    call _nova_print_str")
        out("    mov byte ptr [rbp - 16], 10")
        out("    lea rsi, [rbp - 16]")
        out("    mov rdx, 1")
        out("    push rdx")
        out("    push rsi")
        out("    mov ecx, -11")
        win_call("GetStdHandle")
        out("    pop rsi")
        out("    pop rdx")
        out("    mov rcx, rax")
        out("    mov r8, rdx")
        out("    mov rdx, rsi")
        out("    lea r9, [rbp - 24]")
        out("    mov qword ptr [rbp - 24], 0")
        out("    sub rsp, 48")
        out("    mov qword ptr [rsp + 32], 0")
        out("    call [rip + __imp_WriteFile]")
        out("    add rsp, 48")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    push rdi")
        out("    call _nova_print_str")
        out("    sub rsp, 8")
        out("    mov byte ptr [rsp], 10")
        out("    mov rsi, rsp")
        out("    mov rdx, 1")
        out("    mov rdi, 1")
        emit_syscall(1)
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
    }

    // --- Heap allocator (brk-based bump allocator) ---
    out("")
    out_label("_nova_alloc")
    out("    push rbx")
    out("    mov rbx, rdi")
    out("    add rbx, 7")
    out("    and rbx, -8")
    out("    mov rax, [rip + _heap_ptr]")
    out("    test rax, rax")
    out("    jnz .alloc_have_heap")
    if cg_target == 3 {
        out("    xor ecx, ecx")
        out("    mov edx, 1048576")
        out("    mov r8d, 12288")
        out("    mov r9d, 4")
        win_call("VirtualAlloc")
    } else {
        if cg_target == 1 {
            out("    xor edi, edi")
            out("    mov rsi, 1048576")
            out("    mov rdx, 3")
            out("    mov r10, 4098")
            out("    mov r8, -1")
            out("    xor r9d, r9d")
            emit_syscall(9)
        } else {
            out("    mov rdi, 0")
            emit_syscall(12)
        }
    }
    out("    mov [rip + _heap_base], rax")
    out("    mov [rip + _heap_ptr], rax")
    if cg_target == 3 {
        out("    lea rax, [rax + 1048576]")
    } else {
        if cg_target == 1 {
            out("    lea rax, [rax + 1048576]")
        } else {
            out("    lea rdi, [rax + 1048576]")
            emit_syscall(12)
        }
    }
    out("    mov [rip + _heap_end], rax")
    out("    mov rax, [rip + _heap_ptr]")
    out(".alloc_have_heap:")
    out("    mov rcx, rax")
    out("    add rcx, rbx")
    out("    cmp rcx, [rip + _heap_end]")
    out("    jle .alloc_ok")
    if cg_target == 3 {
        out("    xor ecx, ecx")
        out("    mov edx, 1048576")
        out("    mov r8d, 12288")
        out("    mov r9d, 4")
        win_call("VirtualAlloc")
        out("    mov [rip + _heap_end], rax")
        out("    add qword ptr [rip + _heap_end], 1048576")
        out("    mov rax, [rip + _heap_ptr]")
    } else {
        if cg_target == 1 {
            out("    xor edi, edi")
            out("    mov rsi, 1048576")
            out("    mov rdx, 3")
            out("    mov r10, 4098")
            out("    mov r8, -1")
            out("    xor r9d, r9d")
            emit_syscall(9)
            out("    mov [rip + _heap_end], rax")
            out("    add qword ptr [rip + _heap_end], 1048576")
            out("    mov rax, [rip + _heap_ptr]")
        } else {
            out("    lea rdi, [rcx + 1048576]")
            emit_syscall(12)
            out("    mov [rip + _heap_end], rax")
            out("    mov rax, [rip + _heap_ptr]")
        }
    }
    out("    mov rcx, rax")
    out("    add rcx, rbx")
    out(".alloc_ok:")
    out("    mov [rip + _heap_ptr], rcx")
    out("    pop rbx")
    out("    ret")

    // --- strlen ---
    out("")
    out_label("_nova_strlen")
    out("    xor eax, eax")
    out("    test rdi, rdi")
    out("    jz .sl_done")
    out(".sl_loop:")
    out("    cmp byte ptr [rdi + rax], 0")
    out("    je .sl_done")
    out("    inc rax")
    out("    jmp .sl_loop")
    out(".sl_done:")
    out("    ret")

    // --- concat(a, b) -> new string ---
    out("")
    out_label("_nova_concat")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov r14, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    add r14, rax")
    out("    inc r14")
    out("    mov rdi, r14")
    out("    call _nova_alloc")
    out("    mov r14, rax")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out(".cc_copy1:")
    out("    lodsb")
    out("    test al, al")
    out("    jz .cc_copy2")
    out("    stosb")
    out("    jmp .cc_copy1")
    out(".cc_copy2:")
    out("    mov rsi, r13")
    out(".cc_copy2_loop:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .cc_copy2_loop")
    out("    mov rax, r14")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- int_to_str(n) -> string ---
    out("")
    out_label("_nova_int_to_str")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    out("    mov rax, rdi")
    out("    sar rax, 1")                 // untag tagged integer argument
    out("    lea rsi, [rbp-1]")
    out("    mov byte ptr [rsi], 0")
    out("    xor ecx, ecx")
    out("    test rax, rax")
    out("    jnz .its_nonzero")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 48")
    out("    jmp .its_copy")
    out(".its_nonzero:")
    out("    jns .its_pos")
    out("    neg rax")
    out("    mov cl, 1")
    out(".its_pos:")
    out(".its_digit_loop:")
    out("    test rax, rax")
    out("    jz .its_sign")
    out("    xor edx, edx")
    out("    mov r8, 10")
    out("    div r8")
    out("    add dl, 48")
    out("    dec rsi")
    out("    mov [rsi], dl")
    out("    jmp .its_digit_loop")
    out(".its_sign:")
    out("    test cl, cl")
    out("    jz .its_copy")
    out("    dec rsi")
    out("    mov byte ptr [rsi], 45")
    out(".its_copy:")
    out("    mov rdi, rsi")
    out("    call _nova_strlen")
    out("    inc rax")
    out("    mov r12, rdi")
    out("    mov rdi, rax")
    out("    push r12")
    out("    call _nova_alloc")
    out("    pop rsi")
    out("    mov rdi, rax")
    out("    push rax")
    out(".its_cp:")
    out("    lodsb")
    out("    stosb")
    out("    test al, al")
    out("    jnz .its_cp")
    out("    pop rax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- str_eq(a, b) -> 1 or 0 ---
    out("")
    out_label("_nova_str_eq")
    out("    xor eax, eax")
    out(".se_loop:")
    out("    mov cl, [rdi]")
    out("    cmp cl, [rsi]")
    out("    jne .se_done")
    out("    test cl, cl")
    out("    jz .se_equal")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .se_loop")
    out(".se_equal:")
    out("    mov eax, 1")
    out(".se_done:")
    out("    ret")

    // --- list_new() -> ptr to [count, cap, items_ptr] ---
    out("")
    // List layout: [MAGIC=-1, count, cap, items_ptr] (32 bytes)
    out_label("_nova_list_new")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rdi, 32")
    out("    call _nova_alloc")
    out("    mov qword ptr [rax], -1")
    out("    mov qword ptr [rax+8], 0")
    out("    mov qword ptr [rax+16], 16")
    out("    push rax")
    out("    mov rdi, 128")
    out("    call _nova_alloc")
    out("    pop rcx")
    out("    mov [rcx+24], rax")
    out("    mov rax, rcx")
    out("    pop rbp")
    out("    ret")

    // --- push(list, val) --- list=[magic, count, cap, items]
    out("")
    out_label("_nova_push")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    mov rax, [rdi+8]")
    out("    cmp rax, [rdi+16]")
    out("    jl .push_ok")
    out("    push rdi")
    out("    push rsi")
    out("    mov rcx, [rdi+16]")
    out("    shl rcx, 1")
    out("    mov [rdi+16], rcx")
    out("    shl rcx, 3")
    out("    push rdi")
    out("    mov rdi, rcx")
    out("    call _nova_alloc")
    out("    pop rdi")
    out("    mov rcx, rax")
    out("    mov r8, [rdi+24]")
    out("    mov r9, [rdi+8]")
    out("    xor r10d, r10d")
    out(".push_copy:")
    out("    cmp r10, r9")
    out("    jge .push_copy_done")
    out("    mov r11, [r8+r10*8]")
    out("    mov [rcx+r10*8], r11")
    out("    inc r10")
    out("    jmp .push_copy")
    out(".push_copy_done:")
    out("    mov [rdi+24], rcx")
    out("    pop rsi")
    out("    pop rdi")
    out(".push_ok:")
    out("    mov rax, [rdi+8]")
    out("    mov rcx, [rdi+24]")
    out("    mov [rcx+rax*8], rsi")
    out("    inc qword ptr [rdi+8]")
    out("    pop rbp")
    out("    ret")

    // --- len(list_or_str) -> count ---
    out("")
    out_label("_nova_len")
    out("    test rdi, rdi")
    out("    jz .len_zero")
    out("    cmp qword ptr [rdi], -1")
    out("    je .len_list")
    out("    xor eax, eax")
    out(".len_str_loop:")
    out("    cmp byte ptr [rdi + rax], 0")
    out("    je .len_done")
    out("    inc rax")
    out("    jmp .len_str_loop")
    out(".len_list:")
    out("    mov rax, [rdi+8]")
    out(".len_done:")
    out("    lea rax, [rax + rax + 1]")    // tag length result
    out("    ret")
    out(".len_zero:")
    out("    mov eax, 1")                  // tagged 0
    out("    ret")

    // --- str_len(ptr): count bytes until null ---
    out("")
    out_label("_nova_str_len")
    out("    xor eax, eax")
    out(".strlen_loop:")
    out("    cmp byte ptr [rdi + rax], 0")
    out("    je .strlen_done")
    out("    inc rax")
    out("    jmp .strlen_loop")
    out(".strlen_done:")
    out("    ret")

    // --- exit(code) ---
    out("")
    out_label("_nova_exit")
    if cg_target == 3 {
        // PROVES alignment:
        //   entry %16==8 (return addr from caller). win_call wraps with
        //   sub rsp,32 which yields %16==8 -- MISALIGNED for Win64 ABI.
        //   Bump to 40 so we land at %16==0 right before the call. The
        //   tail-call shape (no frame, no caller-saves, no return) means
        //   we don't need to undo the sub. Without this fix, an explicit
        //   exit(0) from user code (e.g. chat /quit handler) trips an
        //   SEH invalid-frame error inside Wine ExitProcess unwind,
        //   leaving the process exit code at 5 instead of 0.
        out("    mov ecx, edi")
        out("    sub rsp, 40")
        out("    call [rip + __imp_ExitProcess]")
        // No need to restore rsp -- ExitProcess never returns.
    } else {
        if cg_link_libc == 1 {
            out("    and rsp, -16")
            out("    call exit")
        } else {
            emit_syscall(60)
        }
    }

    // --- read_file(path) -> string ptr or 0 ---
    out("")
    out_label("_nova_read_file")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    if cg_target == 3 {
        // PROVES alignment:
        //   entry %16==8; push rbp -> 0; push r12 -> 8; sub rsp,80 -> 8.
        //   Hmm: 8 not aligned. Need 80 to make %16==0.
        //   8 + sub 80 = 88 % 16 == 8. Still 8. Use sub 88 (mult of 8 not 16).
        //   Better: change to sub rsp,72 -> 8 + 72 = 80 % 16 == 0 ✓.
        //   Layout (rsp+0..rsp+71):
        //     rsp+0..31  shadow space
        //     rsp+32     5th arg (dwCreationDisposition=3 for OPEN_EXISTING)
        //     rsp+40     6th arg (dwFlagsAndAttributes=128)
        //     rsp+48     7th arg (hTemplateFile=0)
        //     rsp+56     BytesRead scratch
        //     rsp+64     allocated buffer ptr
        out("    sub rsp, 72")
        out("    mov rcx, rdi")
        out("    mov edx, -2147483648")
        out("    xor r8d, r8d")
        out("    xor r9d, r9d")
        out("    mov qword ptr [rsp + 32], 3")
        out("    mov qword ptr [rsp + 40], 128")
        out("    mov qword ptr [rsp + 48], 0")
        out("    call [rip + __imp_CreateFileA]")
        out("    cmp rax, -1")
        out("    je .rf_fail")
        out("    mov r12, rax")
        out("    mov rdi, 4194304")
        out("    call _nova_alloc")
        out("    mov [rsp + 64], rax")
        out("    mov rcx, r12")
        out("    mov rdx, rax")
        out("    mov r8d, 4194303")
        out("    lea r9, [rsp + 56]")
        out("    mov qword ptr [rsp + 56], 0")
        out("    mov qword ptr [rsp + 32], 0")
        out("    call [rip + __imp_ReadFile]")
        out("    mov rsi, [rsp + 64]")
        out("    mov eax, [rsp + 56]")
        out("    mov byte ptr [rsi + rax], 0")
        out("    mov rcx, r12")
        out("    call [rip + __imp_CloseHandle]")
        out("    mov rax, [rsp + 64]")
        out("    add rsp, 72")
    } else {
        out("    mov rsi, 0")
        emit_syscall(2)
        out("    cmp rax, 0")
        out("    jl .rf_fail")
        out("    mov r12, rax")
        out("    mov rdi, 4194304")
        out("    call _nova_alloc")
        out("    push rax")
        out("    mov rdi, r12")
        out("    mov rsi, rax")
        out("    mov rdx, 4194303")
        emit_syscall(0)
        out("    pop rsi")
        out("    mov byte ptr [rsi+rax], 0")
        out("    mov rdi, r12")
        out("    push rsi")
        emit_syscall(3)
        out("    pop rax")
    }
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".rf_fail:")
    out("    mov eax, 1")                 // tagged 0 (so NOVA `== 0` / falsy detects failure)
    out("    lea rsp, [rbp - 8]")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- write_file(path, data) -> 1 or 0 ---
    out("")
    out_label("_nova_write_file")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r13, rsi")
    if cg_target == 3 {
        // PROVES alignment:
        //   entry %16==8; push rbp -> 0; push r12 -> 8; push r13 -> 0;
        //   sub rsp,80 -> 0. Each call uses sub rsp,80 frame with shadow
        //   in lower 32, 5th-7th args at [rsp+32..56], BytesWritten at
        //   [rsp+64], handle/scratch at [rsp+72].
        out("    sub rsp, 80")
        out("    mov rcx, rdi")
        out("    mov edx, 1073741824")
        out("    xor r8d, r8d")
        out("    xor r9d, r9d")
        out("    mov qword ptr [rsp + 32], 2")
        out("    mov qword ptr [rsp + 40], 128")
        out("    mov qword ptr [rsp + 48], 0")
        out("    call [rip + __imp_CreateFileA]")
        out("    cmp rax, -1")
        out("    je .wf_fail")
        out("    mov r12, rax")
        out("    mov rdi, r13")
        out("    call _nova_strlen")
        out("    mov rcx, r12")
        out("    mov rdx, r13")
        out("    mov r8, rax")
        out("    lea r9, [rsp + 64]")
        out("    mov qword ptr [rsp + 64], 0")
        out("    mov qword ptr [rsp + 32], 0")
        out("    call [rip + __imp_WriteFile]")
        out("    mov rcx, r12")
        out("    call [rip + __imp_CloseHandle]")
        out("    add rsp, 80")
        out("    mov rax, 1")
    } else {
        out("    mov rsi, 577")
        out("    mov rdx, 420")
        emit_syscall(2)
        out("    cmp rax, 0")
        out("    jl .wf_fail")
        out("    mov r12, rax")
        out("    mov rdi, r13")
        out("    call _nova_strlen")
        out("    mov rdx, rax")
        out("    mov rdi, r12")
        out("    mov rsi, r13")
        emit_syscall(1)
        out("    mov rdi, r12")
        emit_syscall(3)
        out("    mov rax, 3")              // tagged true
    }
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".wf_fail:")
    out("    mov eax, 1")                  // tagged false
    out("    lea rsp, [rbp - 16]")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- index(obj, idx): list[idx] or str[idx] -> char code ---
    out("")
    out_label("_nova_index")
    out("    sar rsi, 1")                 // untag NOVA index -> raw
    out("    test rdi, rdi")
    out("    jz .idx_null")
    out("    cmp qword ptr [rdi], -1")
    out("    je .idx_list")
    out("    test rsi, rsi")
    out("    jns .idx_str_positive")
    out("    push rdi")
    out("    push rsi")
    out("    call _nova_strlen")
    out("    pop rsi")
    out("    pop rdi")
    out("    add rsi, rax")
    out("    test rsi, rsi")
    out("    jl .idx_oob")
    out(".idx_str_positive:")
    out("    movzx eax, byte ptr [rdi + rsi]")
    out("    lea rax, [rax + rax + 1]")    // tag char-code result
    out("    ret")
    out(".idx_list:")
    out("    // Handle negative index")
    out("    test rsi, rsi")
    out("    jns .idx_list_positive")
    out("    add rsi, [rdi + 8]")
    out("    test rsi, rsi")
    out("    jl .idx_oob")
    out(".idx_list_positive:")
    out("    cmp rsi, [rdi + 8]")
    out("    jge .idx_oob")
    out("    mov rax, [rdi + 24]")
    out("    mov rax, [rax + rsi*8]")
    out("    ret")
    out(".idx_null:")
    out("    lea rdi, [rip + _err_null_access]")
    out("    call _nova_println")
    out("    mov rdi, 1")
    out("    call _nova_exit")
    out(".idx_oob:")
    out("    push rsi")
    out("    lea rdi, [rip + _err_index_oob]")
    out("    call _nova_print_str")
    out("    pop rdi")
    out("    call _nova_print_int")
    out("    lea rdi, [rip + _err_newline]")
    out("    call _nova_print_str")
    out("    mov rdi, 1")
    out("    call _nova_exit")

    // --- chr(code) -> 1-char string ---
    out("")
    out_label("_nova_chr")
    out("    push rdi")
    out("    mov rdi, 2")
    out("    call _nova_alloc")
    out("    pop rcx")
    out("    sar rcx, 1")                  // untag char code
    out("    mov [rax], cl")
    out("    mov byte ptr [rax+1], 0")
    out("    ret")

    // --- char_at(str, idx) -> char code ---
    out("")
    out_label("_nova_char_at")
    out("    sar rsi, 1")                  // untag index
    out("    movzx eax, byte ptr [rdi + rsi]")
    out("    lea rax, [rax + rax + 1]")    // tag char-code result
    out("    ret")

    // --- substr(str, start, len) -> new string ---
    out("")
    out_label("_nova_substr")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    sar rsi, 1")                 // untag start
    out("    sar rdx, 1")                 // untag len
    out("    lea r12, [rdi + rsi]")
    out("    mov r13, rdx")
    out("    lea rdi, [rdx + 1]")
    out("    call _nova_alloc")
    out("    mov rdi, rax")
    out("    mov rsi, r12")
    out("    mov rcx, r13")
    out("    rep movsb")
    out("    mov byte ptr [rdi], 0")
    out("    sub rdi, r13")
    out("    mov rax, rdi")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_to_int(str) -> int ---
    out("")
    out_label("_nova_str_to_int")
    out("    xor eax, eax")
    out("    xor ecx, ecx")
    out("    cmp byte ptr [rdi], 45")
    out("    jne .sti_loop")
    out("    mov cl, 1")
    out("    inc rdi")
    out(".sti_loop:")
    out("    movzx edx, byte ptr [rdi]")
    out("    sub edx, 48")
    out("    cmp edx, 9")
    out("    ja .sti_done")
    out("    imul rax, 10")
    out("    add rax, rdx")
    out("    inc rdi")
    out("    jmp .sti_loop")
    out(".sti_done:")
    out("    test cl, cl")
    out("    jz .sti_ret")
    out("    neg rax")
    out(".sti_ret:")
    out("    lea rax, [rax + rax + 1]")    // tag integer result
    out("    ret")

    // --- __arg(n) -> string or "" ---
    out("")
    out_label("_nova___arg")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sar rdi, 1")                  // untag n -> raw
    out("    inc rdi")                      // skip argv[0]
    out("    mov rcx, [rip + _g___argc]")
    out("    sar rcx, 1")                  // untag argc -> raw
    out("    cmp rdi, rcx")
    out("    jge .arg_empty")
    out("    mov rax, [rip + _g___argv]")
    out("    mov rdi, [rax + rdi*8]")       // raw argv string (may be odd-aligned)
    out("    lea rsi, [rip + _empty_str]")
    out("    call _nova_concat")            // aligned heap copy (bit0=0)
    out("    pop rbp")
    out("    ret")
    out(".arg_empty:")
    out("    lea rax, [rip + _empty_str]")
    out("    pop rbp")
    out("    ret")

    // --- pop(list) -> removes and returns last element ---
    out("")
    out_label("_nova_pop")
    out("    mov rax, [rdi+8]")
    out("    test rax, rax")
    out("    jz .pop_empty")
    out("    dec rax")
    out("    mov [rdi+8], rax")
    out("    mov rcx, [rdi+24]")
    out("    mov rax, [rcx+rax*8]")
    out("    ret")
    out(".pop_empty:")
    out("    mov eax, 1")                  // tagged 0 / None
    out("    ret")

    // --- list_set(list, idx, val) -> sets list[idx] = val ---
    out("")
    out_label("_nova_list_set")
    out("    sar rsi, 1")                  // untag index
    out("    mov rax, [rdi+24]")
    out("    mov [rax+rsi*8], rdx")
    out("    ret")

    // --- contains(list_or_str, val) -> 1 if found, 0 if not ---
    out("")
    out_label("_nova_contains")
    out("    cmp qword ptr [rdi], -2")
    out("    je .contains_is_map")
    out("    cmp qword ptr [rdi], -1")
    out("    je .contains_is_list")
    out("    call _nova_str_find")
    out("    cmp rax, 0")
    out("    jl .contains_str_no")
    out("    mov eax, 3")                 // tagged true
    out("    ret")
    out(".contains_str_no:")
    out("    mov eax, 1")                 // tagged false
    out("    ret")
    out(".contains_is_map:")
    out("    jmp _nova_map_has")
    out(".contains_is_list:")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    mov r14, [rdi+8]")
    out("    xor ecx, ecx")
    out(".contains_loop:")
    out("    cmp rcx, r14")
    out("    jge .contains_not_found")
    out("    mov rax, [r12+24]")
    out("    mov rdi, [rax+rcx*8]")
    out("    mov rsi, r13")
    out("    push rcx")
    out("    call _nova_eq")
    out("    pop rcx")
    out("    cmp rax, 1")
    out("    jne .contains_found")
    out("    inc rcx")
    out("    jmp .contains_loop")
    out(".contains_found:")
    out("    mov eax, 3")                 // tagged true
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".contains_not_found:")
    out("    mov eax, 1")                 // tagged false
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- list_remove(list, idx) -> removes element at idx, shifts remaining left ---
    out("")
    out_label("_nova_list_remove")
    out("    mov rax, [rdi+8]")
    out("    mov rcx, [rdi+24]")
    out("    mov r8, rsi")
    out(".lr_shift:")
    out("    lea r9, [r8+1]")
    out("    cmp r9, rax")
    out("    jge .lr_done")
    out("    mov r10, [rcx+r9*8]")
    out("    mov [rcx+r8*8], r10")
    out("    inc r8")
    out("    jmp .lr_shift")
    out(".lr_done:")
    out("    dec qword ptr [rdi+8]")
    out("    ret")

    // --- starts_with(str, prefix) -> 1 or 0 ---
    out("")
    out_label("_nova_starts_with")
    out("    mov eax, 1")                 // tagged false (default)
    out(".sw_loop:")
    out("    mov cl, [rsi]")
    out("    test cl, cl")
    out("    jz .sw_yes")
    out("    cmp cl, [rdi]")
    out("    jne .sw_no")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .sw_loop")
    out(".sw_yes:")
    out("    mov eax, 3")                 // tagged true
    out(".sw_no:")
    out("    ret")

    // --- ends_with(str, suffix) -> 1 or 0 ---
    out("")
    out_label("_nova_ends_with")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov rcx, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    cmp rax, rcx")
    out("    ja .ew_no")
    out("    lea rdi, [r12+rcx]")
    out("    sub rdi, rax")
    out("    mov rsi, r13")
    out(".ew_loop:")
    out("    mov cl, [rsi]")
    out("    test cl, cl")
    out("    jz .ew_yes")
    out("    cmp cl, [rdi]")
    out("    jne .ew_no")
    out("    inc rdi")
    out("    inc rsi")
    out("    jmp .ew_loop")
    out(".ew_yes:")
    out("    mov eax, 3")                 // tagged true
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".ew_no:")
    out("    mov eax, 1")                 // tagged false
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- str_find(haystack, needle) -> index or -1 ---
    out("")
    out_label("_nova_str_find")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    push r12")
    out("    push r13")
    out("    push r14")
    out("    mov r12, rdi")
    out("    mov r13, rsi")
    out("    call _nova_strlen")
    out("    mov r14, rax")
    out("    mov rdi, r13")
    out("    call _nova_strlen")
    out("    mov rcx, rax")
    out("    test rcx, rcx")
    out("    jz .sf_found_zero")
    out("    xor r8d, r8d")
    out(".sf_outer:")
    out("    lea rax, [r8+rcx]")
    out("    cmp rax, r14")
    out("    ja .sf_not_found")
    out("    xor r9d, r9d")
    out(".sf_inner:")
    out("    cmp r9, rcx")
    out("    jge .sf_found")
    out("    lea rax, [r12+r8]")
    out("    movzx edx, byte ptr [rax+r9]")
    out("    cmp dl, [r13+r9]")
    out("    jne .sf_next")
    out("    inc r9")
    out("    jmp .sf_inner")
    out(".sf_next:")
    out("    inc r8")
    out("    jmp .sf_outer")
    out(".sf_found:")
    out("    mov rax, r8")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".sf_found_zero:")
    out("    xor eax, eax")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")
    out(".sf_not_found:")
    out("    mov rax, -1")
    out("    pop r14")
    out("    pop r13")
    out("    pop r12")
    out("    pop rbp")
    out("    ret")

    // --- abs(n) -> absolute value ---
    out("")
    out_label("_nova_abs")
    out("    mov rax, rdi")
    out("    test rdi, rdi")
    out("    jns .abs_done")
    out("    neg rax")
    out("    add rax, 2")                  // tagged negate
    out(".abs_done:")
    out("    ret")

    // --- min(a, b) -> smaller value ---
    out("")
    out_label("_nova_min")
    out("    cmp rdi, rsi")
    out("    cmovle rax, rdi")
    out("    cmovg rax, rsi")
    out("    ret")

    // --- max(a, b) -> larger value ---
    out("")
    out_label("_nova_max")
    out("    cmp rdi, rsi")
    out("    cmovge rax, rdi")
    out("    cmovl rax, rsi")
    out("    ret")

    // --- time() -> current epoch seconds ---
    out("")
    out_label("_nova_time")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 16")
    if cg_target == 3 {
        out("    lea rcx, [rbp - 16]")
        win_call("GetSystemTimeAsFileTime")
        out("    mov rax, [rbp - 16]")
        out("    mov rcx, 10000000")
        out("    xor edx, edx")
        out("    div rcx")
        out("    mov rcx, 11644473600")
        out("    sub rax, rcx")
    } else {
        out("    xor edi, edi")
        out("    lea rsi, [rbp - 16]")
        emit_syscall(228)
        out("    mov rax, [rbp - 16]")
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- sleep_ms(milliseconds) -> 0 ---
    out("")
    out_label("_nova_sleep_ms")
    out("    push rbp")
    out("    mov rbp, rsp")
    out("    sub rsp, 32")
    if cg_target == 3 {
        out("    mov rcx, rdi")
        win_call("Sleep")
    } else {
        out("    mov rax, rdi")
        out("    xor edx, edx")
        out("    mov rcx, 1000")
        out("    div rcx")
        if cg_target == 1 {
            out("    mov [rbp - 16], rax")
            out("    imul rdx, rdx, 1000")
            out("    mov [rbp - 8], rdx")
            out("    xor edi, edi")
            out("    xor esi, esi")
            out("    xor edx, edx")
            out("    xor r10d, r10d")
            out("    lea r8, [rbp - 16]")
            emit_syscall(93)
        } else {
            out("    mov [rbp - 16], rax")
            out("    imul rdx, rdx, 1000000")
            out("    mov [rbp - 8], rdx")
            out("    lea rdi, [rbp - 16]")
            out("    xor esi, esi")
            emit_syscall(35)
        }
    }
    out("    xor eax, eax")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // --- mkdir(path) -> 0 on success, -1 on error ---
    out("")
    out_label("_nova_mkdir")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov rcx, rdi")
        out("    xor edx, edx")
        win_call("CreateDirectoryA")
        out("    test eax, eax")
        out("    jz .mkdir_fail")
        out("    xor eax, eax")
        out("    pop rbp")
        out("    ret")
        out(".mkdir_fail:")
        out("    mov rax, -1")
        out("    pop rbp")
        out("    ret")
    } else {
        out("    mov rsi, 493")
        emit_syscall(83)
        out("    ret")
    }

    // --- unlink(path) -> 0 on success, -1 on error ---
    out("")
    out_label("_nova_unlink")
    if cg_target == 3 {
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    mov rcx, rdi")
        win_call("DeleteFileA")
        out("    test eax, eax")
        out("    jz .unlink_fail")
        out("    xor eax, eax")
        out("    pop rbp")
        out("    ret")
        out(".unlink_fail:")
        out("    mov rax, -1")
        out("    pop rbp")
        out("    ret")
    } else {
        emit_syscall(87)
        out("    ret")
    }

    // --- file_size(path) -> size in bytes or -1 ---
    out("")
    out_label("_nova_file_size")
    out("    push rbp")
    out("    mov rbp, rsp")
    if cg_target == 3 {
        // PROVES alignment:
        //   entry %16==8; push rbp -> 0; sub rsp,80 -> 0 ✓.
        //   Layout (rsp+0..rsp+79):
        //     rsp+0..31  shadow space
        //     rsp+32..48 5th-7th args
        //     rsp+56     handle slot
        //     rsp+64     FileSizeEx output (8 bytes)
        //     rsp+72     unused/padding
        out("    sub rsp, 80")
        out("    mov rcx, rdi")
        out("    mov edx, -2147483648")
        out("    xor r8d, r8d")
        out("    xor r9d, r9d")
        out("    mov qword ptr [rsp + 32], 3")
        out("    mov qword ptr [rsp + 40], 128")
        out("    mov qword ptr [rsp + 48], 0")
        out("    call [rip + __imp_CreateFileA]")
        out("    cmp rax, -1")
        out("    je .fs_fail")
        out("    mov [rsp + 56], rax")
        out("    mov rcx, rax")
        out("    lea rdx, [rsp + 64]")
        out("    call [rip + __imp_GetFileSizeEx]")
        out("    mov rcx, [rsp + 56]")
        out("    call [rip + __imp_CloseHandle]")
        out("    mov rax, [rsp + 64]")
        out("    add rsp, 80")
    } else {
        out("    sub rsp, 160")
        out("    lea rsi, [rbp - 160]")
        emit_syscall(4)
        out("    cmp rax, 0")
        out("    jl .fs_fail")
        if cg_target == 1 {
            out("    mov rax, [rbp - 160 + 96]")
        } else {
            out("    mov rax, [rbp - 160 + 48]")
        }
    }
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")
    out(".fs_fail:")
    out("    mov rax, -1")
    out("    mov rsp, rbp")
    out("    pop rbp")
    out("    ret")

    // ================================================================
    // Windows-only init helpers (argv/envp/WSAStartup).
    // ================================================================
    if cg_target == 3 {
        out("")
        out_label("_nova_win_init_args")
        out("    push rbp")
        out("    mov rbp, rsp")
        out("    sub rsp, 32")
        out("    call [rip + __imp_GetCommandLineA]")
        out("    add rsp, 32")
        out("    mov r12, rax")
        out("    test r12, r12")
        out("    jnz .wia_have")
        out("    mov qword ptr [rip + _g___argc], 0")
        out("    mov qword ptr [rip + _g___argv], 0")
        out("    mov rsp, rbp")
        out("    pop rbp")
        out("    ret")
        out(".wia_have:")
        out("    push rbx")
        out("    push r13")
        out("    push r14")
        out("    sub rsp, 8")
        out("    mov r13, r12")
        out("    xor ebx, ebx")
        out(".wia_count_loop:")
        out("    movzx eax, byte ptr [r13]")
        out("    test al, al")
        out("    jz .wia_count_done")
        out("    cmp al, 32")
        out("    je .wia_count_skip_ws")
        out("    cmp al, 9")
        out("    je .wia_count_skip_ws")
        out("    inc rbx")
        out("    cmp al, 34")
        out("    jne .wia_count_unq")
        out("    inc r13")
        out(".wia_count_q_loop:")
        out("    movzx eax, byte ptr [r13]")
        out("    test al, al")
        out("    jz .wia_count_done")
        out("    cmp al, 34")
        out("    je .wia_count_q_end")
        out("    inc r13")
        out("    jmp .wia_count_q_loop")
        out(".wia_count_q_end:")
        out("    inc r13")
        out("    jmp .wia_count_loop")
        out(".wia_count_unq:")
        out(".wia_count_u_loop:")
        out("    movzx eax, byte ptr [r13]")
        out("    test al, al")
        out("    jz .wia_count_done")
        out("    cmp al, 32")
        out("    je .wia_count_loop")
        out("    cmp al, 9")
        out("    je .wia_count_loop")
        out("    inc r13")
        out("    jmp .wia_count_u_loop")
        out(".wia_count_skip_ws:")
        out("    inc r13")
        out("    jmp .wia_count_loop")
        out(".wia_count_done:")
        out("    mov rax, rbx")
        out("    inc rax")
        out("    shl rax, 3")
        out("    mov rdi, rax")
        out("    call _nova_alloc")
        out("    mov r14, rax")
        out("    mov [rip + _g___argc], rbx")
        out("    mov [rip + _g___argv], r14")
        out("    mov r13, r12")
        out("    xor ebx, ebx")
        out(".wia_emit_loop:")
        out("    movzx eax, byte ptr [r13]")
        out("    test al, al")
        out("    jz .wia_emit_done")
        out("    cmp al, 32")
        out("    je .wia_emit_skip_ws")
        out("    cmp al, 9")
        out("    je .wia_emit_skip_ws")
        out("    xor ecx, ecx")
        out("    cmp al, 34")
        out("    jne .wia_emit_unq")
        out("    inc r13")
        out("    mov rsi, r13")
        out(".wia_emit_q_loop:")
        out("    movzx eax, byte ptr [r13 + rcx]")
        out("    test al, al")
        out("    jz .wia_emit_alloc")
        out("    cmp al, 34")
        out("    je .wia_emit_alloc")
        out("    inc rcx")
        out("    jmp .wia_emit_q_loop")
        out(".wia_emit_unq:")
        out("    mov rsi, r13")
        out(".wia_emit_u_loop:")
        out("    movzx eax, byte ptr [r13 + rcx]")
        out("    test al, al")
        out("    jz .wia_emit_alloc")
        out("    cmp al, 32")
        out("    je .wia_emit_alloc")
        out("    cmp al, 9")
        out("    je .wia_emit_alloc")
        out("    inc rcx")
        out("    jmp .wia_emit_u_loop")
        out(".wia_emit_alloc:")
        out("    push rsi")
        out("    push rcx")
        out("    mov rdi, rcx")
        out("    inc rdi")
        out("    call _nova_alloc")
        out("    pop rcx")
        out("    pop rsi")
        out("    mov rdi, rax")
        out("    xor edx, edx")
        out(".wia_emit_copy:")
        out("    cmp rdx, rcx")
        out("    jge .wia_emit_copy_end")
        out("    movzx r9d, byte ptr [rsi + rdx]")
        out("    mov [rdi + rdx], r9b")
        out("    inc rdx")
        out("    jmp .wia_emit_copy")
        out(".wia_emit_copy_end:")
        out("    mov byte ptr [rdi + rcx], 0")
        out("    mov [r14 + rbx*8], rdi")
        out("    inc rbx")
        out("    add r13, rcx")
        out("    movzx eax, byte ptr [r13]")
        out("    cmp al, 34")
        out("    jne .wia_emit_loop")
        out("    inc r13")
