    wi("local.get $list")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")

    // list_set — alias for rt_index_set
    wi("(func $list_set (param $list i64) (param $idx i64) (param $val i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("local.get $list")
    wi("local.get $idx")
    wi("local.get $val")
    wi("call $rt_index_set")
    wasm_indent = wasm_indent - 1
    wi(")")
    wi("")
}

fn wasm_gen_rt_extra() {
    // pop — remove and return last element
    wi("(func $pop (param $list i64) (result i64)")
    wasm_indent = wasm_indent + 1
    wi("(local $hdr i32)")
    wi("(local $cnt i64)")
