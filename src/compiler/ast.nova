fn ast_confidence(expr, level) {
    let n = list_new()
    push(n, AST_CONFIDENCE)
    push(n, expr)
    push(n, level)
    return n
}

// R17A: sum-type variant construction. `enum_name` and `variant_name`
// are the dotted-path components; `args` is the list of payload exprs
// (empty list for nullary variants like `Option::None`). Lowered by
// codegen to a fresh list whose first slot is the variant tag.
fn ast_enum_ctor(enum_name, variant_name, args) {
    let n = list_new()
    push(n, AST_ENUM_CTOR)
    push(n, enum_name)
    push(n, variant_name)
    push(n, args)
    return n
}

// R17A: `match` arm pattern matching a sum-type variant. `binders` is
// the list of identifier names introduced by destructuring the variant
// payload (e.g. `Option::Some(n)` -> binders=["n"]). Bindings are
// installed in the arm body's scope; the discriminant is matched by
// comparing `value[0]` against the variant's tag.
fn ast_enum_pattern(enum_name, variant_name, binders) {
    let n = list_new()
    push(n, AST_ENUM_PATTERN)
    push(n, enum_name)
    push(n, variant_name)
    push(n, binders)
    return n
}

// R32D: nested variant pattern. `sub_patterns` is a list where each entry
// is itself a pattern node (AST_IDENT for a binder, AST_WILDCARD for `_`,
// or AST_ENUM_PATTERN / AST_NESTED_VARIANT_PATTERN / AST_STRUCT_PATTERN
// for a sub-pattern that recursively destructures the corresponding
// payload slot). Lowered by parse_match into a wildcard arm with a guard
// chain + per-binder prep `let` stmts referencing the cached scrutinee
// temp; codegen never sees this node directly.
fn ast_nested_variant_pattern(enum_name, variant_name, sub_patterns) {
    let n = list_new()
    push(n, AST_NESTED_VARIANT_PATTERN)
    push(n, enum_name)
    push(n, variant_name)
    push(n, sub_patterns)
    return n
}

// R20A: postfix `?` Result-propagation. Wraps an expression whose value
// is a Result-shaped tagged tuple. Codegen lowers to: evaluate inner;
// if `value[0] == 0` (Ok) replace with `value[1]`; otherwise return the
// whole `value` from the enclosing function (it IS the Err Result).
fn ast_try_propagate(inner) {
    let n = list_new()
    push(n, AST_TRY_PROPAGATE)
    push(n, inner)
    return n
}

// R25A: brace-init struct construction `Foo { field: val, ... }`. Wire
// representation matches the existing positional ctor (`Foo(val)`): a
// struct value is `[v0, v1, ...]` in declaration order. The parser-emitted
// node carries values in source order plus the parallel list of field
// names; codegen reorders to declaration order using cg_structs.
//   nd[0] = AST_STRUCT_INIT (tag 27)
//   nd[1] = struct_name (string)
//   nd[2] = source-order value expressions (list)
//   nd[3] = source-order field names (list, parallel to nd[2])
//   nd[4] = optional base expression for R26A spread `..base` (0 if none)
//          When non-zero, codegen fills any field not present in nd[3]
//          by emitting `base.field` (AST_FIELD_ACCESS) — i.e. functional
//          update-syntax `Point { x: 10, ..p }`. Parser ensures `base`
//          is always an AST_IDENT (wrapping non-trivial exprs in a
//          do-expr that caches them in a fresh temp) so codegen only
//          ever sees a cheap identifier reference.
fn ast_struct_init(name, values, names) {
    let n = list_new()
    push(n, AST_STRUCT_INIT)
    push(n, name)
    push(n, values)
    push(n, names)
    push(n, 0)
    return n
}

// R36C: tuple literal `(a, b, c)`. Carries the element list; codegen
// lowers identically to AST_LIST_LIT (tuples are tagged lists in the
// shallow R36C implementation — no distinct runtime representation).
fn ast_tuple_lit(elements) {
    let n = list_new()
    push(n, AST_TUPLE_LIT)
    push(n, elements)
    return n
}

// R36C: tuple type annotation `(int, str)`. `slot_types` is a list of
// `[base, [type_args]]` pairs as returned by par_collect_type. Codegen
// never reads this; the type-check pass uses it only for documentation
// today (a future round could enforce per-slot discipline).
fn ast_tuple_type(slot_types) {
    let n = list_new()
    push(n, AST_TUPLE_TYPE)
    push(n, slot_types)
    return n
}

// R36C: tuple match pattern `(0, _, x)`. `sub_patterns` is the list of
// per-slot sub-patterns — binders, wildcards, nested tuples, or literal
// expression nodes. parse_match lowers AST_TUPLE_PATTERN arms into a
// wildcard arm with guard chain + per-binder prep stmts referencing the
// cached scrutinee temp; codegen never sees this tag directly.
fn ast_tuple_pattern(sub_patterns) {
    let n = list_new()
    push(n, AST_TUPLE_PATTERN)
    push(n, sub_patterns)
    return n
}

// --- Accessor helpers ---
fn ast_tag(nd) {
    return nd[0]
}
