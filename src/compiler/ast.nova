// Nova Compiler: AST Node Types
// AST nodes are represented as lists: [tag, field1, field2, ...]
// This keeps the bootstrap interpreter happy (no struct support needed).

// --- AST Node Tags ---
let AST_PROGRAM = 1
let AST_FN_DECL = 2
let AST_LET_STMT = 3
let AST_IF_STMT = 4
let AST_WHILE_STMT = 5
let AST_FOR_STMT = 6
let AST_RETURN_STMT = 7
let AST_BLOCK = 8
let AST_BIN_OP = 9
let AST_UNARY_OP = 10
let AST_CALL = 11
let AST_IDENT = 12
let AST_INT_LIT = 13
let AST_STR_LIT = 14
let AST_BOOL_LIT = 15
let AST_NONE_LIT = 16
let AST_LIST_LIT = 17
let AST_INDEX_EXPR = 18
let AST_ASSIGN_STMT = 19
let AST_EXPR_STMT = 20
let AST_BREAK_STMT = 21
let AST_CONTINUE_STMT = 22
let AST_AND_EXPR = 23
let AST_OR_EXPR = 24
let AST_INDEX_ASSIGN = 25
let AST_STRUCT_DECL = 26
let AST_STRUCT_INIT = 27
let AST_FIELD_ACCESS = 28
let AST_FIELD_ASSIGN = 29
let AST_FLOAT_LIT = 30
let AST_MATCH_STMT = 32
let AST_MATCH_ARM = 33
let AST_WILDCARD = 34
let AST_TRY_CATCH = 35
let AST_THROW = 36
let AST_LAMBDA = 37
let AST_ENUM_DECL = 38
let AST_TERNARY = 39
let AST_DO_WHILE = 40
let AST_DESTRUCTURE = 41
let AST_FOR_INDEXED = 42
let AST_PIPE = 43
let AST_NULL_ACCESS = 44
let AST_SLICE = 45
let AST_DEFAULT_PARAM = 46
let AST_LIST_COMP = 47
let AST_MAP_LIT = 48
let AST_SPREAD = 49
let AST_METHOD_DECL = 50
let AST_ASM = 51
let AST_CONST_STMT = 52
let AST_EXTERN_FN = 53
let AST_DEFER_STMT = 54
let AST_NULLISH = 55
let AST_DO_EXPR = 56
let AST_MAP_COMP = 57
let AST_TYPE_PATTERN = 58
let AST_FLOW = 59
let AST_MIND = 60
let AST_SOUL = 61
let AST_SYSTEM = 62
let AST_CONFIDENCE = 63
let AST_IMPL_BLOCK = 64
// R17A: sum-type variant construction (`Option::Some(42)`) and
// variant patterns inside `match` arms (`Option::Some(n) => ...`).
// Wire representation: each variant value is a tagged tuple
//   `[tag_int, field0, field1, ...]`
// where `tag_int` is the declaration-order index of the variant.
let AST_ENUM_CTOR = 65
let AST_ENUM_PATTERN = 66
// R20A: postfix `?` Result propagation. `expr?` evaluates `expr` to a
// tagged tuple `[tag, ...payload]`; when `tag == 0` (Ok) the node's
// value is `payload[0]`, otherwise the enclosing function returns
// `expr` unchanged (which IS the Err Result). The single child is the
// inner expression being unwrapped.
let AST_TRY_PROPAGATE = 67
// R25A: struct field-pattern used in match arms only
// (`Point { x: 0, y: a } => ...`). Wire shape:
//   [tag, struct_name, field_names, sub_patterns, has_rest]
// where each sub_patterns[i] is either AST_IDENT (binder), AST_WILDCARD
// (skip), or a literal expression node tested for equality at the arm's
// dispatch site. parse_match rewrites the surrounding `match` into a
// block `{ let _struct_match_N = expr; match _struct_match_N { ... } }`
// where each AST_STRUCT_PATTERN arm becomes a guarded wildcard arm —
// codegen never sees AST_STRUCT_PATTERN directly.
let AST_STRUCT_PATTERN = 68
// R32D: nested variant pattern (e.g. `Some(Some(v))` or `Ok(Point { x, y })`).
// The single-level `Some(v)` form continues to emit AST_ENUM_PATTERN
// (preserving R31D's tag-compare + binder-bind codegen path byte-for-byte).
// AST_NESTED_VARIANT_PATTERN fires ONLY when at least one payload slot is
// itself a sub-pattern (another AST_NESTED_VARIANT_PATTERN, AST_ENUM_PATTERN,
// or AST_STRUCT_PATTERN). Wire shape:
//   [tag, enum_name, variant_name, sub_patterns]
// where each sub_patterns[i] is one of:
//   * a string (legacy binder name carried through)  — never used in the
//     wrapper-emitting path; included for shape uniformity if needed.
//   * AST_IDENT (binder)
//   * AST_WILDCARD (skip)
//   * AST_ENUM_PATTERN (single-level inner variant pattern)
//   * AST_NESTED_VARIANT_PATTERN (deeper nesting)
//   * AST_STRUCT_PATTERN (struct destructure within the variant payload)
// parse_match rewrites the entire match into a wildcard arm with a guard
// chain `tmp[0] == outer_tag && tmp[1][0] == inner_tag && ...` plus a
// `let v = tmp[1][...]` prep stmt for every binder. The wrapping AST_DO_EXPR
// is reused from the AST_STRUCT_PATTERN codepath so codegen never sees a
// new pattern shape.
let AST_NESTED_VARIANT_PATTERN = 69
// R36C: tuple literal `(a, b, c)`. NOVA does NOT add a distinct runtime
// representation for tuples — they lower to lists at codegen (the path of
// least resistance: `[a, b, c]`). The node carries an `elements` list of
// expression nodes; the parser only emits AST_TUPLE_LIT when at least
// two expressions are present (`(x)` stays a parenthesized expression).
// Wire shape: [tag, elements].
//
// Why a distinct AST tag if we lower to AST_LIST_LIT anyway? Two reasons:
//   (1) keeps the parser's intent visible for future passes that may want
//       to enforce per-slot type discipline (currently AST-level only —
//       see par_collect_type's tuple-type branch).
//   (2) tooling (nova-lsp / tree-sitter) can distinguish tuples from
//       lists without re-parsing — once those modules add tuple support
//       in a future round, the AST tag tells them which surface form to
//       suggest in completions / hover.
// Codegen treats AST_TUPLE_LIT identically to AST_LIST_LIT (one branch
// near the AST_LIST_LIT cases per pass — see cg gen_expr / tc_walk_expr /
// collect_comp_vars / cg_fold_constants / cg_dce_expr / etc.).
let AST_TUPLE_LIT = 70
// R36C: tuple type annotation `(int, str)`. Captured by par_collect_type
// for the lightweight type-check pass; codegen never reads it. Wire shape:
// [tag, slot_types] where slot_types is a list of `[base, [type_args]]`
// pairs (the par_collect_type shape). The empty-tuple type `()` is NOT
// modelled (NOVA has no unit type; deferred to a future round).
let AST_TUPLE_TYPE = 71
// R36C: tuple match pattern `(0, _) => ...`. Parser-time lowering: each
// arm with an AST_TUPLE_PATTERN is rewritten into a wildcard arm with a
// guard chain `tmp[0] == lit0 && tmp[1] == lit1 && ...` plus a per-binder
// `let name = tmp[i]` prep stmt — mirrors the R32D nested-variant lowering
// so codegen never sees AST_TUPLE_PATTERN directly. Wire shape:
// [tag, sub_patterns] where each sub_patterns[i] is one of:
//   * AST_IDENT (binder name)
//   * AST_WILDCARD (skip)
//   * AST_TUPLE_PATTERN (nested tuple)
//   * any expression node (literal value; compared by equality at the
//     dispatch site).
let AST_TUPLE_PATTERN = 72
// --- AST Constructors ---
// Each returns a list: [tag, ...fields]

fn ast_program(decls) {
    let n = list_new()
    push(n, AST_PROGRAM)
    push(n, decls)
    return n
}

fn ast_fn_decl(name, params, body) {
    let n = list_new()
    push(n, AST_FN_DECL)
    push(n, name)
    push(n, params)
    push(n, body)
    return n
}

fn ast_let(name, value) {
    let n = list_new()
    push(n, AST_LET_STMT)
    push(n, name)
    push(n, value)
    return n
}

