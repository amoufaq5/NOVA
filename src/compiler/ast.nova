fn ast_block(stmts) {
    let n = list_new()
    push(n, AST_BLOCK)
    push(n, stmts)
    return n
}

fn ast_block_single(stmt) {
    let stmts = list_new()
    push(stmts, stmt)
    return ast_block(stmts)
}

