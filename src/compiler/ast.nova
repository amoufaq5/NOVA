// Flow type constants
let FLOW_FWD = 1
let FLOW_BWD = 2
let FLOW_BROADCAST = 3
let FLOW_ENRICH = 4
let FLOW_TENTATIVE = 5
let FLOW_RESONATE = 6
let FLOW_FILTER = 7

fn ast_mind(name, nodes, channels, scaling, persist) {
    let n = list_new()
    push(n, AST_MIND)
    push(n, name)
    push(n, nodes)
    push(n, channels)
    push(n, scaling)
    push(n, persist)
    // security stored as n[7]
    push(n, list_new())
    return n
}

fn ast_soul(name, identity, values, drives, feelings, phases, reactions) {
    let n = list_new()
    push(n, AST_SOUL)
