// Nova Compiler: AST Node Types
// AST nodes are represented as lists: [tag, field1, field2, ...]
// This keeps the bootstrap interpreter happy (no struct support needed).

// --- AST Node Tags ---
let AST_PROGRAM = 1
let AST_FN_DECL = 2
let AST_LET_STMT = 3
let AST_IF_STMT = 4
let AST_WHILE_STMT = 5
let AST_FOR_STMT = 6
let AST_RETURN_STMT = 7
let AST_BLOCK = 8
let AST_BIN_OP = 9
let AST_UNARY_OP = 10
let AST_CALL = 11
let AST_IDENT = 12
let AST_INT_LIT = 13
let AST_STR_LIT = 14
let AST_BOOL_LIT = 15
let AST_NONE_LIT = 16
let AST_LIST_LIT = 17
let AST_INDEX_EXPR = 18
let AST_ASSIGN_STMT = 19
let AST_EXPR_STMT = 20
let AST_BREAK_STMT = 21
let AST_CONTINUE_STMT = 22
let AST_AND_EXPR = 23
let AST_OR_EXPR = 24
let AST_INDEX_ASSIGN = 25
let AST_STRUCT_DECL = 26
let AST_STRUCT_INIT = 27
let AST_FIELD_ACCESS = 28
let AST_FIELD_ASSIGN = 29
let AST_FLOAT_LIT = 30
let AST_MATCH_STMT = 32
let AST_MATCH_ARM = 33
let AST_WILDCARD = 34
let AST_TRY_CATCH = 35
let AST_THROW = 36
let AST_LAMBDA = 37
let AST_ENUM_DECL = 38
let AST_TERNARY = 39
let AST_DO_WHILE = 40
let AST_DESTRUCTURE = 41
let AST_FOR_INDEXED = 42
let AST_PIPE = 43
let AST_NULL_ACCESS = 44
let AST_SLICE = 45
let AST_DEFAULT_PARAM = 46
let AST_LIST_COMP = 47
let AST_MAP_LIT = 48
let AST_SPREAD = 49
let AST_METHOD_DECL = 50
let AST_ASM = 51
let AST_CONST_STMT = 52
let AST_EXTERN_FN = 53
let AST_DEFER_STMT = 54
let AST_NULLISH = 55
// --- AST Constructors ---
// Each returns a list: [tag, ...fields]

fn ast_program(decls) {
    let n = list_new()
    push(n, AST_PROGRAM)
    push(n, decls)
    return n
}

fn ast_fn_decl(name, params, body) {
    let n = list_new()
    push(n, AST_FN_DECL)
    push(n, name)
    push(n, params)
    push(n, body)
    return n
}

fn ast_let(name, value) {
    let n = list_new()
    push(n, AST_LET_STMT)
    push(n, name)
    push(n, value)
    return n
}

fn ast_if(cond, then_body, else_body) {
    let n = list_new()
    push(n, AST_IF_STMT)
    push(n, cond)
    push(n, then_body)
    push(n, else_body)
    return n
}

fn ast_while(cond, body) {
    let n = list_new()
    push(n, AST_WHILE_STMT)
    push(n, cond)
    push(n, body)
    return n
}

fn ast_for(var_name, iter, body) {
    let n = list_new()
    push(n, AST_FOR_STMT)
    push(n, var_name)
    push(n, iter)
    push(n, body)
    return n
}

fn ast_return(value) {
    let n = list_new()
    push(n, AST_RETURN_STMT)
    push(n, value)
    return n
}

fn ast_block(stmts) {
    let n = list_new()
    push(n, AST_BLOCK)
    push(n, stmts)
    return n
}

fn ast_block_single(stmt) {
    let stmts = list_new()
    push(stmts, stmt)
    return ast_block(stmts)
}

fn ast_binop(op, left, right) {
    let n = list_new()
    push(n, AST_BIN_OP)
    push(n, op)
    push(n, left)
    push(n, right)
    return n
}

fn ast_unary(op, operand) {
    let n = list_new()
    push(n, AST_UNARY_OP)
    push(n, op)
    push(n, operand)
    return n
}

fn ast_call(callee, args) {
    let n = list_new()
    push(n, AST_CALL)
    push(n, callee)
    push(n, args)
    return n
}

fn ast_ident(name) {
    let n = list_new()
    push(n, AST_IDENT)
    push(n, name)
    return n
}

fn ast_int(value) {
    let n = list_new()
    push(n, AST_INT_LIT)
    push(n, value)
    return n
}

fn ast_float(value) {
    let n = list_new()
    push(n, AST_FLOAT_LIT)
    push(n, value)
    return n
}

fn ast_str(value) {
    let n = list_new()
    push(n, AST_STR_LIT)
    push(n, value)
    return n
}

fn ast_bool(value) {
    let n = list_new()
    push(n, AST_BOOL_LIT)
    push(n, value)
    return n
}

fn ast_none() {
    let n = list_new()
    push(n, AST_NONE_LIT)
    return n
}

fn ast_list(elements) {
    let n = list_new()
    push(n, AST_LIST_LIT)
    push(n, elements)
    return n
}

fn ast_index(base, idx) {
    let n = list_new()
    push(n, AST_INDEX_EXPR)
    push(n, base)
    push(n, idx)
    return n
}

fn ast_assign(name, value) {
    let n = list_new()
    push(n, AST_ASSIGN_STMT)
    push(n, name)
    push(n, value)
    return n
}

fn ast_expr_stmt(expr) {
    let n = list_new()
    push(n, AST_EXPR_STMT)
    push(n, expr)
    return n
}

fn ast_break() {
    let n = list_new()
    push(n, AST_BREAK_STMT)
    return n
}

fn ast_continue() {
    let n = list_new()
    push(n, AST_CONTINUE_STMT)
    return n
}

fn ast_and(left, right) {
    let n = list_new()
    push(n, AST_AND_EXPR)
    push(n, left)
    push(n, right)
    return n
}

fn ast_or(left, right) {
    let n = list_new()
    push(n, AST_OR_EXPR)
    push(n, left)
    push(n, right)
    return n
}

fn ast_index_assign(base, idx, value) {
    let n = list_new()
    push(n, AST_INDEX_ASSIGN)
    push(n, base)
    push(n, idx)
    push(n, value)
    return n
}

fn ast_struct_decl(name, fields) {
    let n = list_new()
    push(n, AST_STRUCT_DECL)
    push(n, name)
    push(n, fields)
    return n
}

fn ast_field_access(base, field) {
    let n = list_new()
    push(n, AST_FIELD_ACCESS)
    push(n, base)
    push(n, field)
    return n
}

fn ast_field_assign(base, field, value) {
    let n = list_new()
    push(n, AST_FIELD_ASSIGN)
    push(n, base)
    push(n, field)
    push(n, value)
    return n
}

fn ast_match(expr, arms) {
    let n = list_new()
    push(n, AST_MATCH_STMT)
    push(n, expr)
    push(n, arms)
    return n
}

fn ast_match_arm(pattern, body) {
    let n = list_new()
    push(n, AST_MATCH_ARM)
    push(n, pattern)
    push(n, body)
    return n
}

fn ast_wildcard() {
    let n = list_new()
    push(n, AST_WILDCARD)
    return n
}

fn ast_try_catch(try_body, catch_body) {
    let n = list_new()
    push(n, AST_TRY_CATCH)
    push(n, try_body)
    push(n, catch_body)
    return n
}

fn ast_throw(value) {
    let n = list_new()
    push(n, AST_THROW)
    push(n, value)
    return n
}

fn ast_lambda(name, params, body) {
    let n = list_new()
    push(n, AST_LAMBDA)
    push(n, name)
    push(n, params)
    push(n, body)
    return n
}

fn ast_enum_decl(name, variants) {
    let n = list_new()
    push(n, AST_ENUM_DECL)
    push(n, name)
    push(n, variants)
    return n
}

fn ast_ternary(cond, then_val, else_val) {
    let n = list_new()
    push(n, AST_TERNARY)
    push(n, cond)
    push(n, then_val)
    push(n, else_val)
    return n
}

fn ast_do_while(body, cond) {
    let n = list_new()
    push(n, AST_DO_WHILE)
    push(n, body)
    push(n, cond)
    return n
}

fn ast_destructure(names, value) {
    let n = list_new()
    push(n, AST_DESTRUCTURE)
    push(n, names)
    push(n, value)
    return n
}

fn ast_for_indexed(idx_name, val_name, iter, body) {
    let n = list_new()
    push(n, AST_FOR_INDEXED)
    push(n, idx_name)
    push(n, val_name)
    push(n, iter)
    push(n, body)
    return n
}

fn ast_pipe(left, right) {
    let n = list_new()
    push(n, AST_PIPE)
    push(n, left)
    push(n, right)
    return n
}

fn ast_null_access(base, name) {
    let n = list_new()
    push(n, AST_NULL_ACCESS)
    push(n, base)
    push(n, name)
    return n
}

fn ast_slice(base, start_expr, end_expr) {
    let n = list_new()
    push(n, AST_SLICE)
    push(n, base)
    push(n, start_expr)
    push(n, end_expr)
    return n
}

fn ast_list_comp(expr, var_name, iter, cond) {
    let n = list_new()
    push(n, AST_LIST_COMP)
    push(n, expr)
    push(n, var_name)
    push(n, iter)
    push(n, cond)
    return n
}

fn ast_map_lit(ks, vs) {
    let n = list_new()
    push(n, AST_MAP_LIT)
    push(n, ks)
    push(n, vs)
    return n
}

fn ast_spread(name) {
    let n = list_new()
    push(n, AST_SPREAD)
    push(n, name)
    return n
}

fn ast_method_decl(sname, mname, params, body) {
    let n = list_new()
    push(n, AST_METHOD_DECL)
    push(n, sname)
    push(n, mname)
    push(n, params)
    push(n, body)
    return n
}

fn ast_extern_fn(name, param_count) {
    let n = list_new()
    push(n, AST_EXTERN_FN)
    push(n, name)
    push(n, param_count)
    return n
}

fn ast_defer(body) {
    let n = list_new()
    push(n, AST_DEFER_STMT)
    push(n, body)
    return n
}

fn ast_nullish(left, right) {
    let n = list_new()
    push(n, AST_NULLISH)
    push(n, left)
    push(n, right)
    return n
}

fn ast_asm(lines) {
    let n = list_new()
    push(n, AST_ASM)
    push(n, lines)
    return n
}

// --- Accessor helpers ---
fn ast_tag(nd) {
    return nd[0]
}
