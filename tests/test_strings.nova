fn greet(name) {
    println("Hello, ")
    println(name)
    println("!")
}

fn fizzbuzz(n) {
    let i = 1
    while i <= n {
        if i % 15 == 0 {
            println("FizzBuzz")
        } else {
            if i % 3 == 0 {
                println("Fizz")
            } else {
                if i % 5 == 0 {
                    println("Buzz")
                } else {
                    print_int(i)
                    println("")
                }
            }
        }
        i = i + 1
    }
}

fn main() {
    greet("Nova")
    println("---")
    fizzbuzz(15)
}

main()
