// Test: Lambda expressions and higher-order functions

// Lambda basics
let add = fn(a, b) { return a + b }
let result = add(3, 4)
assert(result == 7, "lambda call")

let double = fn(x) { return x * 2 }
assert(double(5) == 10, "lambda single arg")

// Higher-order: map_list
let nums = [1, 2, 3, 4, 5]
let doubled = map_list(nums, fn(x) { return x * 2 })
assert(doubled[0] == 2, "map_list first")
assert(doubled[2] == 6, "map_list mid")
assert(doubled[4] == 10, "map_list last")
assert(len(doubled) == 5, "map_list length")

// Higher-order: filter
let evens = filter(nums, fn(x) { return x % 2 == 0 })
assert(len(evens) == 2, "filter count")
assert(evens[0] == 2, "filter first")
assert(evens[1] == 4, "filter second")

// Higher-order: reduce
let sum = reduce(nums, fn(acc, x) { return acc + x }, 0)
assert(sum == 15, "reduce sum")

let product = reduce(nums, fn(acc, x) { return acc * x }, 1)
assert(product == 120, "reduce product")

// Higher-order: foreach
let count = 0
foreach(nums, fn(x) { return x })
// foreach just calls fn, doesn't accumulate

// Passing named functions
fn square(x) {
    return x * x
}
let squares = map_list(nums, square)
assert(squares[0] == 1, "map named fn")
assert(squares[2] == 9, "map named fn 2")
assert(squares[4] == 25, "map named fn 3")

println("All lambda tests passed!")
