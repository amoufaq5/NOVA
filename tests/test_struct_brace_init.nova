// R25A: brace-init struct construction `Foo { field: val, ... }`.
// Wire-shape identical to R23A positional ctor — a struct value is a
// list `[v0, v1, ...]` in field declaration order. Source-order field
// names get reordered to declaration order by codegen via cg_structs.
//
// This test covers ~20 assertions across:
//   * single-field brace-init equivalence with positional ctor
//   * multi-field brace-init
//   * field-order swap (declaration order wins at runtime)
//   * generic struct brace-init with optional `<TypeArgs>` between
//     the name and the brace
//   * methods on brace-init values
//   * R20A `?` propagation interaction (Result::Ok via positional
//     ctor still works alongside brace-init)
//   * nested brace-init in lists / inside other brace-inits

// --- Single-field brace-init ---

struct Box<T> {
    value: T
}

let b_pos = Box(42)
let b_brace = Box { value: 42 }
assert(b_brace.value == 42, "Box { value: 42 }.value == 42")
assert(b_pos.value == b_brace.value, "positional == brace-init: value")

let b_str = Box { value: "hello" }
assert(b_str.value == "hello", "Box { value: \"hello\" }.value")

// --- Multi-field ---

struct Point {
    x: int,
    y: int
}

let p = Point { x: 10, y: 20 }
assert(p.x == 10, "Point { x: 10, y: 20 }.x == 10")
assert(p.y == 20, "Point { x: 10, y: 20 }.y == 20")

// --- Field order can be swapped ---
// Source has `y` first, then `x`. Codegen must reorder to declaration
// order (x first, then y) — the runtime list is the same as the
// non-swapped version.

let p_swap = Point { y: 20, x: 10 }
assert(p_swap.x == 10, "swap: x == 10")
assert(p_swap.y == 20, "swap: y == 20")

// Both spellings produce identical underlying lists.
assert(p.x == p_swap.x, "swap parity: x")
assert(p.y == p_swap.y, "swap parity: y")

// --- Generic brace-init with explicit `<TypeArgs>` ---

let bg = Box<int> { value: 99 }
assert(bg.value == 99, "Box<int> { value: 99 }.value")

let bgs = Box<str> { value: "world" }
assert(bgs.value == "world", "Box<str> { value: \"world\" }.value")

// --- Methods on brace-init values ---

struct Vec2 {
    x: int,
    y: int
}

fn Vec2.add(self, other) {
    return Vec2 { x: self.x + other.x, y: self.y + other.y }
}

fn Vec2.dot(self, other) {
    return self.x * other.x + self.y * other.y
}

let v1 = Vec2 { x: 3, y: 4 }
let v2 = Vec2 { x: 5, y: 6 }
let vsum = v1.add(v2)
assert(vsum.x == 8, "Vec2.add: x")
assert(vsum.y == 10, "Vec2.add: y")
assert(v1.dot(v2) == 39, "Vec2.dot == 15 + 24 == 39")

// --- Brace-init nested in expressions ---

let pts = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
assert(pts[0].x == 1, "list of brace-init: [0].x")
assert(pts[1].y == 4, "list of brace-init: [1].y")

// --- Brace-init inside a brace-init ---

struct Wrap<T> {
    inner: T
}

let wp = Wrap { inner: Point { x: 7, y: 8 } }
assert(wp.inner.x == 7, "nested brace-init: outer.inner.x")
assert(wp.inner.y == 8, "nested brace-init: outer.inner.y")

// --- Three-field struct ---

struct Triple {
    a: int,
    b: int,
    c: int
}

let t1 = Triple { a: 1, b: 2, c: 3 }
let t2 = Triple { c: 3, a: 1, b: 2 }
let t3 = Triple { b: 2, c: 3, a: 1 }
assert(t1.a == t2.a, "triple swap a")
assert(t1.b == t2.b, "triple swap b")
assert(t1.c == t2.c, "triple swap c")
assert(t1.a == t3.a, "triple swap2 a")
assert(t1.b == t3.b, "triple swap2 b")
assert(t1.c == t3.c, "triple swap2 c")

// --- Interaction with R20A Result + `?` ---
// Brace-init is for structs, not tuple-style enum variants — Result::Ok
// stays positional. But brace-init values should compose freely with
// Result-returning functions.

enum Result {
    Ok(int)
    Err(str)
}

fn make_point_ok() {
    let pp = Point { x: 100, y: 200 }
    return Result::Ok(pp.x + pp.y)
}

let r = make_point_ok()
assert(r[0] == 0, "Result::Ok tag for brace-init result")
assert(r[1] == 300, "Result::Ok payload for brace-init result")

println("test_struct_brace_init.nova: all brace-init assertions passed")
