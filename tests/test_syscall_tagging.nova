// Every syscall wrapper in src/runtime/syscall.nova must untag its NOVA
// arguments and tag its non-negative result (see the convention at the top
// of that file). Before, sys_read / sys_write returned raw counts and
// mkdir / unlink / lseek / pread / pwrite / ftruncate / getcwd passed
// tagged values to the kernel.
//
// Exit-code checks (exit N on the first failure) so the test can fail on
// its own. Uses a computed path (a tagged NOVA string), which is what
// broke sys_mkdir in practice.

fn main() {
    let base = "/tmp/nova_systag_" + int_to_str(getpid())
    // mkdir with a computed (tagged) path and a tagged mode.
    if sys_mkdir(base, 448) != 0 { println("mkdir failed") exit(1) }
    let fd0 = sys_open(base, 0, 0)
    if fd0 < 0 { println("mkdir did not create the directory") exit(2) }
    sys_close(fd0)

    let path = base + "/f.dat"
    let fd = sys_open(path, 577, 420)          // O_WRONLY|O_CREAT|O_TRUNC, 0644
    if fd < 0 { exit(3) }
    let msg = "hello-syscall-tagging"
    let n = str_len(msg)
    let w = sys_write(fd, msg, n)
    if w != n { print("write returned ") print_int(w) println("") exit(4) }
    sys_close(fd)

    let rfd = sys_open(path, 2, 0)              // O_RDWR
    if rfd < 0 { exit(5) }
    let buf = alloc(64)
    let r = sys_read(rfd, buf, 63)
    if r != n { print("read returned ") print_int(r) println("") exit(6) }
    if load8(buf + 6) != char_at(msg, 6) { exit(7) }
    if sys_read(rfd, buf, 63) != 0 { println("EOF read should return 0") exit(8) }

    // lseek with a tagged offset; returns the new offset.
    if sys_lseek(rfd, 6, 0) != 6 { println("lseek") exit(9) }
    let b1 = alloc(8)
    if sys_read(rfd, b1, 7) != 7 { exit(10) }
    if load8(b1) != char_at(msg, 6) { println("lseek offset wrong") exit(11) }

    // pread / pwrite at an offset.
    let b2 = alloc(8)
    if sys_pread(rfd, b2, 5, 0) != 5 { println("pread") exit(12) }
    if load8(b2 + 4) != char_at(msg, 4) { exit(13) }
    if sys_pwrite(rfd, "XY", 2, 0) != 2 { println("pwrite") exit(14) }
    if sys_pread(rfd, b2, 2, 0) != 2 { exit(15) }
    if load8(b2) != 88 { println("pwrite content") exit(16) }

    // ftruncate to a tagged length; size checked via lseek to end.
    if sys_ftruncate(rfd, 5) != 0 { println("ftruncate") exit(17) }
    if sys_lseek(rfd, 0, 2) != 5 { println("size after ftruncate") exit(18) }
    sys_close(rfd)

    // errors stay negative
    if sys_read(-1, buf, 4) >= 0 { exit(19) }
    if sys_unlink("/nonexistent/nova/systag") >= 0 { exit(20) }

    // getcwd fills a buffer and returns its length (>0).
    let cwd = alloc(512)
    if sys_getcwd(cwd, 511) <= 0 { println("getcwd") exit(21) }
    if load8(cwd) != 47 { exit(22) }            // starts with '/'

    if sys_unlink(path) != 0 { println("unlink") exit(23) }
    // rmdir via unlink isn't possible; leave the empty dir (named by pid).
    println("PASS test_syscall_tagging")
}

main()
