// Test: Compound assignment operators

let x = 10
x += 5
assert(x == 15, "+= works")

x -= 3
assert(x == 12, "-= works")

x *= 2
assert(x == 24, "*= works")

x /= 4
assert(x == 6, "/= works")

x %= 4
assert(x == 2, "%= works")

// Compound assign on list elements
let arr = [10, 20, 30]
arr[0] += 5
assert(arr[0] == 15, "index +=")

arr[1] -= 5
assert(arr[1] == 15, "index -=")

arr[2] *= 2
assert(arr[2] == 60, "index *=")

// Compound assign in loop
let total = 0
for i in range(5) {
    total += i
}
assert(total == 10, "loop +=")

println("All compound assignment tests passed!")
