// Test: Confidence Annotations (@)

fn main() {
    println("=== Confidence Tests ===")

    // Test 1: Basic confidence annotation
    println("--- Basic annotation ---")
    let x = 42 @ 0.95
    print("value: ") ; print_int(x[0]) ; println("")
    print("confidence: ") ; println(float_to_str(x[1]))

    // Test 2: Confidence with float value
    println("--- Float value ---")
    let pi = 3.14159 @ 0.99
    print("value: ") ; println(float_to_str(pi[0]))
    print("confidence: ") ; println(float_to_str(pi[1]))

    // Test 3: String confidence
    println("--- String value ---")
    let name = "Alice" @ 0.87
    print("value: ") ; println(name[0])
    print("confidence: ") ; println(float_to_str(name[1]))

    // Test 4: Confidence helpers (manual since confidence.nova not included)
    println("--- Helpers ---")
    let a = 100 @ 0.9
    let b = 200 @ 0.7
    // conf_value / conf_level
    print("a value: ") ; print_int(a[0]) ; println("")
    print("b value: ") ; print_int(b[0]) ; println("")

    // Manual merge: min confidence
    let a_conf = a[1]
    let b_conf = b[1]
    let min_conf = a_conf
    if float_cmp(b_conf, a_conf) < 0 {
        min_conf = b_conf
    }
    print("min confidence: ") ; println(float_to_str(min_conf))

    // Test 5: Expression confidence
    println("--- Expression ---")
    let sum = (10 + 20) @ 0.85
    print("sum: ") ; print_int(sum[0]) ; println("")
    print("conf: ") ; println(float_to_str(sum[1]))

    println("")
    println("=== All confidence tests passed! ===")
}

main()
