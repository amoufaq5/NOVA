fn main() {
    # range with step: 0..10..2 -> [0, 2, 4, 6, 8]
    let evens = 0..10..2
    assert(len(evens) == 5)
    assert(evens[0] == 0)
    assert(evens[1] == 2)
    assert(evens[2] == 4)
    assert(evens[3] == 6)
    assert(evens[4] == 8)

    # range with step 3: 1..13..3 -> [1, 4, 7, 10]
    let r = 1..13..3
    assert(len(r) == 4)
    assert(r[0] == 1)
    assert(r[3] == 10)

    # range with step in for loop
    let sum = 0
    for x in 0..20..5 {
        sum = sum + x
    }
    assert(sum == 30)

    # range with negative step: 10..0..(0-2) -> [10, 8, 6, 4, 2]
    let desc = range_step(10, 0, 0 - 2)
    assert(len(desc) == 5)
    assert(desc[0] == 10)
    assert(desc[4] == 2)

    # basic range still works
    let basic = 0..5
    assert(len(basic) == 5)

    print("PASS")
}
main()
