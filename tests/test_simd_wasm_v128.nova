// R15B — WASM v128 SIMD intrinsics correctness test.
//
// Compiles to ALL targets (native + WASM); when targeted at WASM the
// 6 SIMD builtins lower to the WebAssembly v128 SIMD proposal (the
// `0xfd` opcode prefix range — see
// https://webassembly.github.io/spec/core/binary/instructions.html).
//
// Builtin -> WASM v128 lowering:
//   simd_load_i32x8  -> 2x v128.load + 2x v128.store
//   simd_store_i32x8 -> arg-mirror of load (dst, src)
//   simd_add_i32x8   -> 2x (v128.load a + v128.load b + i32x4.add + v128.store dst)
//   simd_sub_i32x8   -> 2x (v128.load a + v128.load b + i32x4.sub + v128.store dst)
//   simd_sum_abs_diff-> loop n>=8: 2x (i32x4.sub + i32x4.abs + acc i32x4.add)
//                       horizontal sum via i32x4.extract_lane 0..3; scalar tail
//   simd_sad_u8      -> loop n>=16: i8x16.sub_sat_u | i8x16.sub_sat_u (swapped)
//                       + i16x8.extadd_pairwise_i8x16_u + i32x4.extadd_pairwise_i16x8_u
//                       + acc i32x4.add; horizontal sum; scalar tail
//
// WASM v128 is 128-bit (4 i32 lanes / 16 u8 lanes) — half of AVX2's
// 256-bit ymm registers. Each NOVA `simd_*_i32x8` therefore emits TWO
// v128 ops per call. WASM SIMD is enabled by default in wasmtime 0.27+
// (current is 45), wasmer always, Chrome 91+, Firefox 89+, Safari 16+.
//
// The test is run by tests/run_tests.sh under the NATIVE target (so it
// also re-verifies the AVX2 / NEON paths are unbroken). For the WASM
// path: `bash tests/test_simd_wasm_v128.sh` compiles --target=wasm,
// runs wat2wasm + wasmtime, and confirms identical results.

// ---------- int32 LE buffer helpers ------------------------------------------

fn store_i32(buf, idx, v) {
    let off = int_mul(idx, 4)
    let u = v
    if v < 0 { u = 4294967296 - (0 - v) }
    store8(int_add(buf, off),                  u % 256)
    store8(int_add(buf, int_add(off, 1)),      int_div(u, 256) % 256)
    store8(int_add(buf, int_add(off, 2)),      int_div(u, 65536) % 256)
    store8(int_add(buf, int_add(off, 3)),      int_div(u, 16777216) % 256)
}

fn load_i32(buf, idx) {
    let off = int_mul(idx, 4)
    let b0 = load8(int_add(buf, off))
    let b1 = load8(int_add(buf, int_add(off, 1)))
    let b2 = load8(int_add(buf, int_add(off, 2)))
    let b3 = load8(int_add(buf, int_add(off, 3)))
    let u = b0 + int_mul(b1, 256) + int_mul(b2, 65536) + int_mul(b3, 16777216)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn fill_buf(buf, v0, v1, v2, v3, v4, v5, v6, v7) {
    store_i32(buf, 0, v0)
    store_i32(buf, 1, v1)
    store_i32(buf, 2, v2)
    store_i32(buf, 3, v3)
    store_i32(buf, 4, v4)
    store_i32(buf, 5, v5)
    store_i32(buf, 6, v6)
    store_i32(buf, 7, v7)
}

// ---------- minimal test framework ------------------------------------------

let pass = 0
let fail = 0

fn check(label, got, want) {
    if got == want {
        pass = pass + 1
    } else {
        fail = fail + 1
        print("  FAIL ")
        print(label)
        print(": got ")
        print_int(got)
        print(", want ")
        print_int(want)
        println("")
    }
}

// ---------- tests -----------------------------------------------------------

// 1. simd_add_i32x8 -> 2x v128.load + i32x4.add + v128.store.
fn test_add() {
    let a = alloc(32)
    let b = alloc(32)
    let dst = alloc(32)
    fill_buf(a, 1, 2, 3, 4, 5, 6, 7, 8)
    fill_buf(b, 10, 20, 30, 40, 50, 60, 70, 80)
    simd_add_i32x8(a, b, dst)
    // Spec parity: [11, 22, 33, 44, 55, 66, 77, 88] on every target.
    check("add lane 0 (lower v128)",  load_i32(dst, 0), 11)
    check("add lane 3 (lower v128)",  load_i32(dst, 3), 44)
    check("add lane 4 (upper v128)",  load_i32(dst, 4), 55)
    check("add lane 7 (upper v128)",  load_i32(dst, 7), 88)
}

// 2. simd_sub_i32x8 -> i32x4.sub mirror of add.
fn test_sub() {
    let a = alloc(32)
    let b = alloc(32)
    let dst = alloc(32)
    fill_buf(a, 100, 200, 300, 400, 500, 600, 700, 800)
    fill_buf(b, 1, 2, 3, 4, 5, 6, 7, 8)
    simd_sub_i32x8(a, b, dst)
    check("sub lane 0",  load_i32(dst, 0), 99)
    check("sub lane 3",  load_i32(dst, 3), 396)
    check("sub lane 7",  load_i32(dst, 7), 792)
}

// 3. simd_load_i32x8 + simd_store_i32x8 -> 2x v128.load + v128.store pair.
fn test_load_store() {
    let src = alloc(32)
    let dst1 = alloc(32)
    let dst2 = alloc(32)
    fill_buf(src, 7, 14, 21, 28, 35, 42, 49, 56)
    simd_load_i32x8(src, dst1)
    check("load lane 0", load_i32(dst1, 0), 7)
    check("load lane 7", load_i32(dst1, 7), 56)
    // store is arg-swapped (dst, src).
    simd_store_i32x8(dst2, src)
    check("store lane 0", load_i32(dst2, 0), 7)
    check("store lane 7", load_i32(dst2, 7), 56)
}

// 4. simd_sum_abs_diff -> i32x4.sub + i32x4.abs + extract_lane horizontal sum.
fn test_sum_abs_diff() {
    let a = alloc(32)
    let b = alloc(32)
    fill_buf(a, 1, 2, 3, 4, 5, 6, 7, 8)
    fill_buf(b, 10, 12, 14, 16, 18, 20, 22, 24)
    // 9+10+11+12+13+14+15+16 = 100 (headline R11D assertion).
    check("sad headline n=8",        simd_sum_abs_diff(a, b, 8), 100)
    fill_buf(a, 0, 0, 0, 0, 0, 0, 0, 0)
    fill_buf(b, 0, 0, 0, 0, 0, 0, 0, 0)
    check("sad zero n=8",            simd_sum_abs_diff(a, b, 8), 0)
    fill_buf(a, 1, 2, 3, 4, 5, 6, 7, 8)
    fill_buf(b, 8, 7, 6, 5, 4, 3, 2, 1)
    // |1-8|+|2-7|+|3-6|+|4-5|+|5-4|+|6-3|+|7-2|+|8-1| = 7+5+3+1+1+3+5+7 = 32.
    check("sad mixed signs n=8",     simd_sum_abs_diff(a, b, 8), 32)
    // Tail-only path (n<8): scalar loop after the vector loop.
    let aT = alloc(16)
    let bT = alloc(16)
    store_i32(aT, 0, 10)
    store_i32(aT, 1, 20)
    store_i32(aT, 2, 30)
    store_i32(bT, 0, 1)
    store_i32(bT, 1, 4)
    store_i32(bT, 2, 9)
    // 9 + 16 + 21 = 46.
    check("sad tail-only n=3",       simd_sum_abs_diff(aT, bT, 3), 46)
}

// 5. simd_sad_u8 -> i8x16.sub_sat_u | i8x16.sub_sat_u (swapped)
//                + i16x8.extadd_pairwise + i32x4.extadd_pairwise + extract.
fn test_sad_u8() {
    let a = alloc(64)
    let b = alloc(64)
    let i = 0
    while i < 32 {
        store8(int_add(a, i), 7)
        store8(int_add(b, i), 7)
        i = i + 1
    }
    check("sad_u8 identical 32B",    simd_sad_u8(a, b, 32), 0)

    // a=[1..32], b=[33..64]; each diff=32; total = 32*32 = 1024.
    i = 0
    while i < 32 {
        store8(int_add(a, i), i + 1)
        store8(int_add(b, i), i + 33)
        i = i + 1
    }
    check("sad_u8 known diff 32B",   simd_sad_u8(a, b, 32), 1024)

    // n=0 must return 0 without segfault.
    check("sad_u8 zero length",      simd_sad_u8(a, b, 0), 0)

    // Tail-only (n<16) path on WASM (vector loop is 16B per iter).
    i = 0
    while i < 8 {
        store8(int_add(a, i), 10)
        store8(int_add(b, i), 2)
        i = i + 1
    }
    // 8 lanes * 8 = 64.
    check("sad_u8 tail-only n=8",    simd_sad_u8(a, b, 8), 64)

    // Asymmetric: half a > b, half b > a (test unsigned abs).
    i = 0
    while i < 16 {
        store8(int_add(a, i), 200)
        store8(int_add(b, i), 50)
        i = i + 1
    }
    while i < 32 {
        store8(int_add(a, i), 30)
        store8(int_add(b, i), 90)
        i = i + 1
    }
    // 16 * 150 + 16 * 60 = 2400 + 960 = 3360.
    check("sad_u8 asymmetric 32B",   simd_sad_u8(a, b, 32), 3360)
}

// 6. Chained ops: dst1 = a+b, dst2 = dst1-a, expect dst2 == b.
fn test_chained() {
    let a = alloc(32)
    let b = alloc(32)
    let dst1 = alloc(32)
    let dst2 = alloc(32)
    fill_buf(a, 1, 2, 3, 4, 5, 6, 7, 8)
    fill_buf(b, 100, 200, 300, 400, 500, 600, 700, 800)
    simd_add_i32x8(a, b, dst1)
    simd_sub_i32x8(dst1, a, dst2)
    check("chained lane 0", load_i32(dst2, 0), 100)
    check("chained lane 7", load_i32(dst2, 7), 800)
}

fn main() {
    println("=== R15B WASM v128 SIMD intrinsics ===")
    test_add()
    test_sub()
    test_load_store()
    test_sum_abs_diff()
    test_sad_u8()
    test_chained()
    print("  passed: ")
    print_int(pass)
    print("/")
    print_int(pass + fail)
    println("")
    if fail > 0 {
        println("FAIL: WASM v128 SIMD produced wrong results")
        exit(1)
    }
    println("ALL WASM V128 SIMD TESTS PASSED")
}

main()
