fn main() {
    # Multi-assignment with let
    let a, b = 1, 2
    assert(a == 1)
    assert(b == 2)

    # Multi-assignment with let, 3 vars
    let x, y, z = 10, 20, 30
    assert(x == 10)
    assert(y == 20)
    assert(z == 30)

    # Re-assignment
    a, b = 100, 200
    assert(a == 100)
    assert(b == 200)

    # Swap via multi-assign
    a, b = b, a
    assert(a == 200)
    assert(b == 100)

    # Three-way rotation
    x, y, z = z, x, y
    assert(x == 30)
    assert(y == 10)
    assert(z == 20)

    print("PASS")
}
main()
