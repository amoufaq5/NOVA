// Test tail call optimization

// Tail-recursive factorial using int_mul to avoid large-int pointer confusion
fn factorial(n, acc) {
    if n <= 1 {
        return acc
    }
    return factorial(n - 1, int_mul(n, acc))
}

// Test basic TCO
let r = factorial(20, 1)
print("factorial(20) = ")
println(int_to_str(r))

// Test with a value that would overflow the stack without TCO
fn count_down(n) {
    if n <= 0 {
        return 0
    }
    return count_down(n - 1)
}

count_down(100000)
println("PASS: count_down(100000) completed (TCO working)")

// Test sum with accumulator using int_add
fn sum_to(n, acc) {
    if n <= 0 {
        return acc
    }
    return sum_to(n - 1, int_add(acc, n))
}

let s = sum_to(1000000, 0)
print("sum(1..1000000) = ")
println(int_to_str(s))

println("All TCO tests passed")
