// N3 (F-13): bounds and type checks on writes and string helpers.
//   * xs[i] = v and list_set check the index (negative counts from the end)
//     and abort with status 1 when it is out of range, instead of writing
//     past the list's storage.
//   * Index assignment on a non-list (int, string) aborts; on a map it is
//     map_set.
//   * char_at with a negative index is 0 instead of the byte before the
//     string.
//   * substr with a negative start or length is ""; copying stops at the
//     string's end.

fn _n3_child_status(which) {
    let pid = fork_process()
    if pid == 0 {
        let xs = [1, 2, 3]
        if which == 1 { xs[3] = 9 }
        if which == 2 { xs[0 - 4] = 9 }
        if which == 3 { list_set(xs, 100, 9) }
        if which == 4 {
            let s = "abc"
            s[0] = 65
        }
        if which == 5 {
            let n = 7
            n[0] = 1
        }
        exit(0)
    }
    return waitpid(pid)
}

fn _n3_main() {
    let xs = [1, 2, 3]
    xs[0] = 10
    xs[2] = 30
    xs[0 - 1] = 33
    list_set(xs, 1, 20)
    assert(xs[0] == 10, "in-range write")
    assert(xs[1] == 20, "list_set write")
    assert(xs[2] == 33, "negative index write")
    assert(len(xs) == 3, "length unchanged")

    let m = map_new()
    m["k"] = 5
    assert(map_get(m, "k") == 5, "map index assignment is map_set")

    assert(_n3_child_status(1) == 1, "xs[len] = v aborts")
    assert(_n3_child_status(2) == 1, "xs[-len-1] = v aborts")
    assert(_n3_child_status(3) == 1, "list_set out of range aborts")
    assert(_n3_child_status(4) == 1, "string index assignment aborts")
    assert(_n3_child_status(5) == 1, "int index assignment aborts")
    assert(_n3_child_status(0) == 0, "control child exits 0")

    let s = "hello"
    assert(char_at(s, 0) == 104, "char_at 0")
    assert(char_at(s, 0 - 1) == 0, "char_at negative is 0")
    assert(len(substr(s, 0 - 1, 3)) == 0, "substr negative start")
    assert(len(substr(s, 1, 0 - 2)) == 0, "substr negative length")
    assert(len(substr(s, 3, 100)) == 2, "substr stops at the end")
    assert(substr(s, 1, 3) == "ell", "substr in range")
    // An alloc()'d buffer may hold NUL bytes: substr copies all `len` bytes.
    let buf = alloc(4)
    store8(buf, 97)
    store8(buf + 1, 0)
    store8(buf + 2, 98)
    store8(buf + 3, 99)
    let cp = substr(buf, 0, 4)
    assert(char_at(cp, 2) == 98, "substr of a buffer copies past a NUL")
    assert(char_at(cp, 3) == 99, "substr of a buffer copies all len bytes")
    println("PASS")
}

_n3_main()
