    println("=== Security Primitives Tests ===")
    println("")

    test_sha256()
    println("")
    test_checksum()
    println("")
    test_xor()
    println("")
    test_validation()
    println("")
    test_sanitize()
    println("")
    test_ratelimit()
    println("")
    test_securemem()
    println("")
    test_sbuf()
    println("")
    test_token()
    println("")
    test_scheduler_sec()
    println("")

    print("Passed: ")
    print_int(tests_passed)
    println("")
    print("Failed: ")
    print_int(tests_failed)
    println("")
    if tests_failed == 0 {
        println("All security tests passed!")
    }
}

main()
