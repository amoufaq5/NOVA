fn add(a, b,) {
    return a + b
}

fn main() {
    # Trailing comma in function calls
    let r1 = add(1, 2,)
    assert(r1 == 3)

    # Trailing comma in list literals
    let lst = [10, 20, 30,]
    assert(len(lst) == 3)
    assert(lst[2] == 30)

    # Single element with trailing comma
    let lst2 = [42,]
    assert(len(lst2) == 1)

    # No trailing comma still works
    let lst3 = [1, 2, 3]
    assert(len(lst3) == 3)

    # Function definition with trailing comma
    assert(add(10, 20,) == 30)

    print("PASS")
}
main()
