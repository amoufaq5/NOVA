let _test_pass = 0
let _test_fail = 0

fn assert_test(cond, name) {
    if cond {
        println("  PASS: " + name)
        _test_pass = _test_pass + 1
    } else {
        println("  FAIL: " + name)
        _test_fail = _test_fail + 1
    }
}

fn main() {
    println("=== Time Machine Tests ===")

    let tm = tm_new(10)
    assert_test(tm_tick_count(tm) == 0, "empty time machine")

    let snap1 = list_new()
    let e1 = list_new()
    push(e1, "node_a")
    push(e1, 500)
    push(snap1, e1)
    let e2 = list_new()
    push(e2, "node_b")
    push(e2, 300)
    push(snap1, e2)
    tm_record_tick(tm, 1, snap1)
    assert_test(tm_tick_count(tm) == 1, "1 tick recorded")

    let snap2 = list_new()
    let e3 = list_new()
    push(e3, "node_a")
    push(e3, 600)
    push(snap2, e3)
    let e4 = list_new()
    push(e4, "node_b")
    push(e4, 400)
    push(snap2, e4)
    tm_record_tick(tm, 2, snap2)

    let snap3 = list_new()
    let e5 = list_new()
    push(e5, "node_a")
    push(e5, 700)
    push(snap3, e5)
    let e6 = list_new()
    push(e6, "node_b")
    push(e6, 200)
    push(snap3, e6)
    tm_record_tick(tm, 3, snap3)
    assert_test(tm_tick_count(tm) == 3, "3 ticks recorded")

    let range = tm_get_tick_range(tm)
    assert_test(range[0] == 1, "oldest tick = 1")
    assert_test(range[1] == 3, "newest tick = 3")

    let rewound = tm_rewind_to(tm, 2)
    assert_test(rewound != 0, "rewind to tick 2 succeeds")
    assert_test(len(rewound) == 2, "snapshot has 2 node entries")

    let act = tm_snapshot_at(tm, 2, "node_a")
    assert_test(act == 600, "node_a at tick 2 = 600")

    let not_found = tm_rewind_to(tm, 99)
    assert_test(not_found == 0, "rewind to nonexistent tick returns 0")

    let mods = list_new()
    let mod1 = list_new()
    push(mod1, 2)
    push(mod1, "node_a")
    push(mod1, 999)
    push(mods, mod1)
    let replay = tm_replay_from(tm, 2, mods)
    assert_test(len(replay) > 0, "replay produces trajectory")

    tm_clear(tm)
    assert_test(tm_tick_count(tm) == 0, "clear resets time machine")

    println("")
    println("Passed: " + int_to_str(_test_pass) + "/" + int_to_str(_test_pass + _test_fail))
    if _test_fail > 0 { exit(1) }
}

main()
