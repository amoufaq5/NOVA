fn main() {
    let nums = list_new()
    push(nums, 10)
    push(nums, 20)
    push(nums, 30)
    push(nums, 40)
    push(nums, 50)

    // Slice: nums[1:3] => [20, 30]
    let s = nums[1:3]
    print("slice len = ")
    print_int(len(s))
    println("")
    print("slice[0] = ")
    print_int(s[0])
    println("")
    print("slice[1] = ")
    print_int(s[1])
    println("")

    // Slice: nums[0:2] => [10, 20]
    let s2 = nums[0:2]
    print("s2[0] = ")
    print_int(s2[0])
    println("")
    print("s2[1] = ")
    print_int(s2[1])
    println("")

    println("All slice tests passed!")
}

main()
