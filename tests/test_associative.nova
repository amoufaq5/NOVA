let _test_pass = 0
let _test_fail = 0

fn assert_test(cond, name) {
    if cond {
        println("  PASS: " + name)
        _test_pass = _test_pass + 1
    } else {
        println("  FAIL: " + name)
        _test_fail = _test_fail + 1
    }
}

fn main() {
    println("=== Associative Memory Tests ===")

    let mem = associative_new(10, 8)
    assert_test(associative_capacity_used(mem) == 0, "empty memory has 0 patterns")

    let p1 = list_new()
    push(p1, 1)
    push(p1, 0)
    push(p1, 1)
    push(p1, 0)
    push(p1, 1)
    push(p1, 0)
    push(p1, 1)
    push(p1, 0)
    let id1 = associative_store(mem, p1)
    assert_test(id1 == 0, "first pattern gets id 0")
    assert_test(associative_capacity_used(mem) == 1, "one pattern stored")

    let p2 = list_new()
    push(p2, 0)
    push(p2, 1)
    push(p2, 0)
    push(p2, 1)
    push(p2, 0)
    push(p2, 1)
    push(p2, 0)
    push(p2, 1)
    let id2 = associative_store(mem, p2)
    assert_test(id2 == 1, "second pattern gets id 1")

    let partial = list_new()
    push(partial, 1)
    push(partial, 0)
    push(partial, 1)
    push(partial, 0)
    push(partial, -1)
    push(partial, -1)
    push(partial, -1)
    push(partial, -1)
    let result = associative_recall(mem, partial)
    let recalled = result[0]
    let conf = result[1]
    assert_test(recalled[0] == 1, "recall recovers bit 0")
    assert_test(recalled[2] == 1, "recall recovers bit 2")
    assert_test(conf > 0, "confidence is positive")

    let full_recall = associative_recall(mem, p1)
    let full_conf = full_recall[1]
    assert_test(full_conf >= 500, "full pattern recall has high confidence")

    let nearest = associative_nearest(mem, p1)
    assert_test(nearest == 0, "nearest to p1 is pattern 0")

    associative_clear(mem)
    assert_test(associative_capacity_used(mem) == 0, "clear resets to 0 patterns")

    println("")
    println("Passed: " + int_to_str(_test_pass) + "/" + int_to_str(_test_pass + _test_fail))
    if _test_fail > 0 { exit(1) }
}

main()
