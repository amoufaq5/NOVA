    println("============================================================")
    println("")

    test_perception_to_memory()
    println("")
    test_learning_tracks()
    println("")
    test_emotion_appraisal()
    println("")
    test_reasoning_engine()
    println("")
    test_signal_flow()
    println("")
    test_similarity_scoring()
    println("")
    test_path_execution()
    println("")
    test_full_cognitive_cycle()
    println("")
    test_cross_system_integration()
    println("")

    println("============================================================")
    println("  M9 full system verification PASSED")
    println("  All cognitive subsystems operational in native binary")
    println("============================================================")
}

main()
