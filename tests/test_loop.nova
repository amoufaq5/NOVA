fn main() {
    # Basic loop with break
    let count = 0
    loop {
        count = count + 1
        if count == 5 { break }
    }
    assert(count == 5)

    # Loop with return
    let r = find_first_even([1, 3, 5, 8, 11])
    assert(r == 8)

    # Nested loops with break
    let total = 0
    let i = 0
    loop {
        let j = 0
        loop {
            total = total + 1
            j = j + 1
            if j >= 3 { break }
        }
        i = i + 1
        if i >= 4 { break }
    }
    assert(total == 12)

    print("PASS")
}

fn find_first_even(lst) {
    let i = 0
    loop {
        if i >= len(lst) { return -1 }
        if lst[i] % 2 == 0 { return lst[i] }
        i = i + 1
    }
}

main()
