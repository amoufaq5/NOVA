// R38A: IEEE 754 double-precision float arithmetic + helpers.
//
// Lives under tests/unit/ so the tests/run_tests.sh glob doesn't pick
// it up — invoke directly via `bin/nova tests/unit/test_floats.nova`
// (the file is self-contained: the stdlib helpers it exercises are all
// either built-in trampolines or derived helpers concatenated into this
// test's invocation; see below for the cat-based invocation idiom).
//
// To exercise stdlib helpers like f_clamp / f_lerp / f_distance, run as:
//
//   cat src/stdlib/float.nova tests/unit/test_floats.nova \
//       > /tmp/_t.nova && bin/nova /tmp/_t.nova -o /tmp/_t.s \
//       && as -o /tmp/_t.o /tmp/_t.s && ld -o /tmp/_t /tmp/_t.o \
//       && /tmp/_t
//
// Direct invocation `bin/nova tests/unit/test_floats.nova` exercises
// the builtin-only subset (which is the bulk of the test count).
//
// R38A ships:
//   1. Float literals: 3.14, 0.5, 1.0e-3, 5E10, 1.5e+2, 1e6 (no dot).
//   2. Float arithmetic: + - * / via the AST_BIN_OP/SSE2 codegen path.
//   3. Float comparison: == != < > <= >= (each returns 0/1 as an int).
//   4. Conversions: int_to_f / f_to_int (legacy: to_float / from_float).
//   5. Builtin helpers: f_abs / f_neg / f_sqrt / f_floor / f_ceil /
//      f_round / f_min / f_max. f_round uses BANKERS' rounding —
//      ties-to-even.
//   6. SysV ABI: float args flow through rdi/rsi/etc. as 64-bit IEEE 754
//      bits (NOT through xmm0..7 like canonical SysV). This is an
//      INTENTIONAL deviation from the SysV float-arg convention —
//      NOVA's calling-convention is integer-shaped and adding xmm
//      register allocation would be a much larger codegen change.
//      Documented as a known restriction for R38A: external C
//      interop via --link-libc + ffi_callf* uses the proper xmm
//      convention via the FFI shim; NOVA-to-NOVA calls do not.
//
// R38A scope reductions (documented):
//   * `.5` (leading dot) NOT accepted — require explicit `0.5`.
//   * Implicit int->float coercion NOT modelled — `3 + 3.14` does
//     NOT auto-convert; use `int_to_f(3) + 3.14`.
//   * Transcendentals (sin, cos, log, exp, pow) deferred to R38A.3.
//   * Mixed-arg SysV calling convention NOT modelled — fn parameters
//     have no type-driven calling-convention choice (everything flows
//     through rdi/rsi/etc as integer-shaped IEEE 754 bits). The
//     `: float` annotation IS parsed but has no codegen effect today.
//     Documented as a known gap for R38A.2.

let ok_count = 0
let fail_count = 0

fn check(cond, label) {
    if cond == 1 {
        ok_count = ok_count + 1
        print("OK ")
        println(label)
    } else {
        fail_count = fail_count + 1
        print("FAIL ")
        println(label)
    }
    return 0
}

fn run_tests() {
    // =============== 1. Literal forms ===========================

    let l1 = 3.14
    check(float_cmp(l1, 3.14) == 0, "3.14 literal: self-equal under float_cmp")

    let l2 = 0.5
    check(float_cmp(l2, 0.5) == 0, "0.5 literal: leading-zero accepted")

    let l3 = 2.0
    check(float_cmp(l3, 2.0) == 0, "2.0 literal")

    // Scientific notation
    let s1 = 1.0e-3
    check(float_cmp(s1, 0.001) == 0, "1.0e-3 == 0.001")

    let s3 = 1.5e+2
    check(float_cmp(s3, 150.0) == 0, "1.5e+2 == 150.0")

    let s4 = 1e6
    check(float_cmp(s4, 1000000.0) == 0, "1e6 (no dot, with exponent) == 1000000.0")

    let s5 = 2e0
    check(float_cmp(s5, 2.0) == 0, "2e0 == 2.0 (zero exponent)")

    let s7 = 1.0e3
    check(float_cmp(s7, 1000.0) == 0, "1.0e3 == 1000.0")

    let s8 = 2.5E2
    check(float_cmp(s8, 250.0) == 0, "2.5E2 == 250.0 (capital E)")

    let s9 = 1e-2
    check(float_cmp(s9, 0.01) == 0, "1e-2 == 0.01")

    // =============== 2. Negative literals =======================

    let n1 = 0 - 2.5
    check(float_cmp(n1, 0 - 2.5) == 0, "negation via (0 - 2.5)")

    let n2 = -3.5
    check(float_cmp(n2, 0 - 3.5) == 0, "unary minus on float literal -3.5")

    // =============== 3. Arithmetic ==============================

    let a1 = 1.0 + 2.0
    check(float_cmp(a1, 3.0) == 0, "1.0 + 2.0 == 3.0")

    let a2 = 5.0 / 2.0
    check(float_cmp(a2, 2.5) == 0, "5.0 / 2.0 == 2.5")

    let a3 = 10.5 - 3.5
    check(float_cmp(a3, 7.0) == 0, "10.5 - 3.5 == 7.0")

    let a4 = 2.5 * 4.0
    check(float_cmp(a4, 10.0) == 0, "2.5 * 4.0 == 10.0")

    // Classic float-precision example: 0.1 + 0.2 != 0.3 by literal compare
    let a5 = 0.1 + 0.2
    check(float_cmp(a5, 0.3) != 0, "0.1 + 0.2 != 0.3 (classic float precision)")

    // But the difference IS less than 1e-9 — useful for tolerance compare
    let a5_diff = f_abs(a5 - 0.3)
    check(float_cmp(a5_diff, 1e-9) == 0 - 1, "|0.1+0.2 - 0.3| < 1e-9")

    // =============== 4. Comparison ==============================
    //
    // Comparisons of floats lower to ucomisd + setb/seta/sete (the
    // existing gen_float_binop machinery picked the right code when
    // either operand is float). Comparison results are int 0/1.
    //
    // NOTE: a known R38A.2 caveat — `let cmp = 3.0 > 2.0` marks
    // `cmp` as a float var (because is_float_expr conservatively
    // returns 1 for a binop with float operands), so subsequent
    // `cmp == 1` compares IEEE 754 bits and gives the wrong answer.
    // Workaround: use the comparison directly as a condition
    // (`if 3.0 > 2.0 { ... }`) rather than storing the boolean.
    // The is_float_typed predicate fixes this but breaks self-host
    // bootstrapping in a way we haven't root-caused yet — tracked
    // as R38A.2. The tests below use the if-condition form which
    // always works.

    if 3.0 > 2.0 {
        check(1 == 1, "3.0 > 2.0 (in if-condition)")
    } else {
        check(0 == 1, "3.0 > 2.0 (in if-condition) [unreachable]")
    }
    if 2.0 > 3.0 {
        check(0 == 1, "2.0 > 3.0 expected false [unreachable]")
    } else {
        check(1 == 1, "2.0 > 3.0 (false) (in if-condition)")
    }
    if 1.0 == 1.0 {
        check(1 == 1, "1.0 == 1.0 (in if-condition)")
    } else {
        check(0 == 1, "1.0 == 1.0 [unreachable]")
    }
    if 1.0 != 2.0 {
        check(1 == 1, "1.0 != 2.0 (in if-condition)")
    } else {
        check(0 == 1, "1.0 != 2.0 [unreachable]")
    }
    if 1.0 < 2.0 {
        check(1 == 1, "1.0 < 2.0 (in if-condition)")
    } else {
        check(0 == 1, "1.0 < 2.0 [unreachable]")
    }
    if 2.0 <= 2.0 {
        check(1 == 1, "2.0 <= 2.0 (in if-condition)")
    } else {
        check(0 == 1, "2.0 <= 2.0 [unreachable]")
    }
    if 3.0 >= 2.0 {
        check(1 == 1, "3.0 >= 2.0 (in if-condition)")
    } else {
        check(0 == 1, "3.0 >= 2.0 [unreachable]")
    }
    if 1.0 >= 1.0 {
        check(1 == 1, "1.0 >= 1.0 (in if-condition)")
    } else {
        check(0 == 1, "1.0 >= 1.0 [unreachable]")
    }

    // =============== 5. Conversions =============================

    check(float_cmp(int_to_f(5), 5.0) == 0, "int_to_f(5) == 5.0")
    check(float_cmp(int_to_f(0), 0.0) == 0, "int_to_f(0) == 0.0")
    check(float_cmp(int_to_f(0 - 7), 0 - 7.0) == 0, "int_to_f(-7) == -7.0")

    check(f_to_int(3.7) == 3, "f_to_int(3.7) == 3 (truncation toward zero)")
    check(f_to_int(0 - 3.7) == 0 - 3, "f_to_int(-3.7) == -3 (toward zero, NOT -4)")
    check(f_to_int(5.0) == 5, "f_to_int(5.0) == 5")
    check(f_to_int(0.99) == 0, "f_to_int(0.99) == 0")

    // Legacy spellings still work
    check(float_cmp(to_float(5), 5.0) == 0, "to_float(5) == 5.0 (legacy alias)")
    check(from_float(7.85) == 7, "from_float(7.85) == 7 (legacy alias)")

    // =============== 6. f_abs ===================================

    check(float_cmp(f_abs(0 - 3.5), 3.5) == 0, "f_abs(-3.5) == 3.5")
    check(float_cmp(f_abs(3.5), 3.5) == 0, "f_abs(3.5) == 3.5")
    check(float_cmp(f_abs(0.0), 0.0) == 0, "f_abs(0.0) == 0.0")

    // =============== 7. f_neg ===================================

    check(float_cmp(f_neg(3.5), 0 - 3.5) == 0, "f_neg(3.5) == -3.5")
    check(float_cmp(f_neg(0 - 3.5), 3.5) == 0, "f_neg(-3.5) == 3.5")

    // =============== 8. f_sqrt ==================================

    check(float_cmp(f_sqrt(16.0), 4.0) == 0, "f_sqrt(16.0) == 4.0")
    check(float_cmp(f_sqrt(0.0), 0.0) == 0, "f_sqrt(0.0) == 0.0")
    check(float_cmp(f_sqrt(1.0), 1.0) == 0, "f_sqrt(1.0) == 1.0")

    // Tolerance check for irrational sqrt
    let sqrt2 = f_sqrt(2.0)
    let sqrt2_err = f_abs(sqrt2 - 1.4142135)
    check(float_cmp(sqrt2_err, 0.001) == 0 - 1, "f_sqrt(2.0) ~= 1.4142135 (within 0.001)")

    // =============== 9. Rounding ================================

    check(float_cmp(f_floor(3.7), 3.0) == 0, "f_floor(3.7) == 3.0")
    check(float_cmp(f_floor(0 - 3.2), 0 - 4.0) == 0, "f_floor(-3.2) == -4.0 (toward -inf)")
    check(float_cmp(f_floor(5.0), 5.0) == 0, "f_floor(5.0) == 5.0")

    check(float_cmp(f_ceil(3.2), 4.0) == 0, "f_ceil(3.2) == 4.0")
    check(float_cmp(f_ceil(0 - 3.7), 0 - 3.0) == 0, "f_ceil(-3.7) == -3.0 (toward +inf)")
    check(float_cmp(f_ceil(5.0), 5.0) == 0, "f_ceil(5.0) == 5.0")

    check(float_cmp(f_round(3.7), 4.0) == 0, "f_round(3.7) == 4.0")
    check(float_cmp(f_round(3.2), 3.0) == 0, "f_round(3.2) == 3.0")
    // Banker's rounding (ties to even):
    check(float_cmp(f_round(0.5), 0.0) == 0, "f_round(0.5) == 0.0 (banker's: tie to even)")
    check(float_cmp(f_round(1.5), 2.0) == 0, "f_round(1.5) == 2.0 (banker's)")
    check(float_cmp(f_round(2.5), 2.0) == 0, "f_round(2.5) == 2.0 (banker's: tie to even)")
    check(float_cmp(f_round(3.5), 4.0) == 0, "f_round(3.5) == 4.0 (banker's)")

    // =============== 10. f_min / f_max ==========================

    check(float_cmp(f_min(1.0, 2.0), 1.0) == 0, "f_min(1.0, 2.0) == 1.0")
    check(float_cmp(f_min(0 - 5.0, 3.0), 0 - 5.0) == 0, "f_min(-5.0, 3.0) == -5.0")
    check(float_cmp(f_max(1.0, 2.0), 2.0) == 0, "f_max(1.0, 2.0) == 2.0")
    check(float_cmp(f_max(0 - 5.0, 3.0), 3.0) == 0, "f_max(-5.0, 3.0) == 3.0")

    // =============== 11. Float-typed bindings ===================
    //
    // `let x: float = ...` parses as an opt-in annotation today;
    // codegen detects float locals via is_float_expr at the value
    // site, so a let binding to a float-literal RHS marks the local
    // for SSE2 codegen on later arithmetic. The annotation itself is
    // purely documentation in this round (the lightweight type-check
    // pass doesn't enforce it).

    let typed: float = 3.14
    check(float_cmp(typed, 3.14) == 0, "let x: float = 3.14 type-annotation parses + stores")

    let typed2: float = int_to_f(7)
    check(float_cmp(typed2, 7.0) == 0, "let x: float = int_to_f(7)")

    // =============== 12. Function returning a float =============
    //
    // A fn whose return value is built from float literals or builtin
    // float helpers carries the float-ness back to the call site;
    // is_float_expr's call-name list ensures e.g. `int_to_f(x)`'s
    // result is treated as float in the caller's scope.

    let mixed = float_add(int_to_f(3), 0.14)
    check(float_cmp(mixed, 3.14) == 0, "float_add(int_to_f(3), 0.14) == 3.14")

    // =============== 13. Float in a tuple =======================
    //
    // Tuples are R36C lists at runtime; floats fit fine because they
    // flow through the integer-shaped 8-byte box. Indexing a tuple
    // slot returns the IEEE 754 bits unmodified.

    let p = (3.0, 4.0)
    let p0 = p[0]
    let p1 = p[1]
    let p_sum = float_add(float_mul(p0, p0), float_mul(p1, p1))
    let h_sqrt = f_sqrt(p_sum)
    check(float_cmp(h_sqrt, 5.0) == 0, "(3.0, 4.0) Pythagorean: f_sqrt(3^2 + 4^2) == 5.0")

    // =============== 14. Float in a closure capture =============
    //
    // DEFERRED to R38A.2 per the brief: NOVA's closure lowering (R37A)
    // boxes captures via a heap-allocated `[value]` list whose codegen
    // assumes integer-shaped values. A float captured by a closure
    // flows through the box's slot[0] as IEEE 754 bits but the
    // arithmetic inside the closure body (`x + k`) sees `k` as an
    // AST_IDENT whose is_float_var status is determined at codegen
    // time by the enclosing scope's float-var tracker — which is
    // scoped per-function. The lambda body's gen_function resets
    // cg_float_vars on entry, so the capture's float-ness is lost.
    //
    // Workaround for users today: explicit `float_add(x, k)` calls
    // (which always route through SSE2 regardless of var tracking).
    // R38A.2 will plumb capture types through the closure lowering.

    // Multi-capture INT closure still works (a sanity check that the
    // closure-capture machinery itself is unchanged):
    let nk = 7
    let f_int = |x| x + nk
    check(f_int(3) == 10, "int-only closure capture still works")

    // =============== 15. Float comparison after binding =========
    //
    // Compare two float-typed locals directly in an if-condition
    // (see section 4 for why we don't store the boolean result).

    let cmp_a = 1.0
    let cmp_b = 1.0
    if cmp_a == cmp_b {
        check(1 == 1, "ident-bound float == comparison (if-condition)")
    } else {
        check(0 == 1, "ident-bound == [unreachable]")
    }
    if cmp_a != 2.0 {
        check(1 == 1, "ident-bound float != comparison (if-condition)")
    } else {
        check(0 == 1, "ident-bound != [unreachable]")
    }

    // =============== 16. Reassignment of float local ============

    let mut_f = 1.0
    check(float_cmp(mut_f, 1.0) == 0, "float local initial value")
    mut_f = 2.5
    check(float_cmp(mut_f, 2.5) == 0, "float local after reassignment")
    mut_f = mut_f + 0.5
    check(float_cmp(mut_f, 3.0) == 0, "float local after self-update")

    // =============== 17. Edge cases =============================

    // Very small float (denormal-adjacent)
    let tiny = 1e-10
    check(float_cmp(tiny, 0.0) > 0, "1e-10 is positive (greater than 0)")

    // Very large float
    let big = 1e10
    check(float_cmp(big, 1.0) > 0, "1e10 is much greater than 1")

    // Float "boolean" via comparison (in if-condition; storing
    // would trip the let-stmt float-var caveat documented above).
    if 1.0 > 0.0 {
        check(1 == 1, "1.0 > 0.0 (in if-condition)")
    } else {
        check(0 == 1, "1.0 > 0.0 [unreachable]")
    }

    // Float in an arithmetic chain (left-to-right precedence)
    let chain = 1.0 + 2.0 * 3.0
    check(float_cmp(chain, 7.0) == 0, "1.0 + 2.0 * 3.0 == 7.0 (precedence)")

    // Parens overriding precedence
    let parens = (1.0 + 2.0) * 3.0
    check(float_cmp(parens, 9.0) == 0, "(1.0 + 2.0) * 3.0 == 9.0")

    // f_abs of result of subtraction
    let dx = f_abs(1.0 - 2.0)
    check(float_cmp(dx, 1.0) == 0, "f_abs(1.0 - 2.0) == 1.0")

    return 0
}

run_tests()

// =============== Summary ============================================

print("Total assertions: ")
print_int(ok_count + fail_count)
println("")
print("Passed: ")
print_int(ok_count)
println("")
print("Failed: ")
print_int(fail_count)
println("")
if fail_count == 0 {
    println("ALL FLOAT TESTS PASSED")
} else {
    println("SOME FLOAT TESTS FAILED")
}
