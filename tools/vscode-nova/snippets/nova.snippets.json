{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}) {",
      "    $0",
      "}"
    ],
    "description": "Define a NOVA function."
  },
  "Main function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "    $0",
      "}",
      "",
      "main()"
    ],
    "description": "Define a NOVA main() entry point and call it."
  },
  "Let binding": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${2:value}"
    ],
    "description": "Bind a value to a name."
  },
  "If block": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "    $0",
      "}"
    ],
    "description": "Conditional block."
  },
  "If/else block": {
    "prefix": "ifelse",
    "body": [
      "if ${1:cond} {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Conditional / alternative block."
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:cond} {",
      "    $0",
      "}"
    ],
    "description": "While loop."
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:iter} {",
      "    $0",
      "}"
    ],
    "description": "For-in loop."
  },
  "Match expression": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:pattern} => ${3:result},",
      "    _ => $0,",
      "}"
    ],
    "description": "Match expression with default arm."
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import ${1:module}"
    ],
    "description": "Import a NOVA module."
  },
  "println call": {
    "prefix": "println",
    "body": [
      "println(\"${1:msg}\")"
    ],
    "description": "Print a line to stdout."
  },
  "print_int call": {
    "prefix": "print_int",
    "body": [
      "print_int(${1:n})"
    ],
    "description": "Print an integer to stdout."
  },
  "Return": {
    "prefix": "return",
    "body": [
      "return ${1:value}"
    ],
    "description": "Return a value from a function."
  },
  "Struct declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:type},$0",
      "}"
    ],
    "description": "Declare a struct."
  }
}
