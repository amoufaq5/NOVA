// Smoke test for the ARM64 codegen path (cg_target == 4).
//
// Compile (when la_lower_function is fully wired):
//     bin/nova examples/hello_arm64.nova --target=arm64 -o /tmp/hello_arm64.s
//
// Assemble for Android NDK (ARM64 ELF object):
//     clang -target aarch64-linux-android30 -c /tmp/hello_arm64.s \
//         -o bin/hello_android.o
//     file bin/hello_android.o   # => ELF 64-bit LSB relocatable, ARM aarch64
//
// Assemble for iOS (ARM64 Mach-O object):
//     clang -target arm64-apple-ios13.0 -c /tmp/hello_arm64.s \
//         -o bin/hello_ios.o
//     file bin/hello_ios.o       # => Mach-O 64-bit arm64 object
//
// The .o files don't run as bare binaries on their respective platforms.
// They link into Xcode app bundles (iOS) or NDK shared libraries (Android),
// which Gradle/Xcode package into the final APK/IPA. See MOBILE_AUDIT.md.
//
// Status: cg_target == 4 is currently a single-stub `_start: exit` and
// crashes on any real input. The la_lower_function ARM64 lowering is the
// next NOVA codegen task. This file documents what the codegen SHOULD do
// once that work lands, and is used by `make smoke-mobile-*` for the
// toolchain-only smoke (the hand-written reference assembly lives at
// `examples/hello_arm64_reference.s` and `examples/hello_ios_reference.s`).

fn main() {
    println("hello from NOVA on ARM64")
}

main()
