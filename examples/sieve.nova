// Sieve of Eratosthenes

fn sieve(limit) {
    let is_prime = list_new()
    let i = 0
    while i <= limit {
        push(is_prime, 1)
        i = i + 1
    }

    // 0 and 1 are not prime
    list_set(is_prime, 0, 0)
    list_set(is_prime, 1, 0)

    i = 2
    while i * i <= limit {
        if is_prime[i] == 1 {
            let j = i * i
            while j <= limit {
                list_set(is_prime, j, 0)
                j = j + i
            }
        }
        i = i + 1
    }

    // Collect primes
    let primes = list_new()
    i = 2
    while i <= limit {
        if is_prime[i] == 1 {
            push(primes, i)
        }
        i = i + 1
    }
    return primes
}

fn main() {
    println("=== Sieve of Eratosthenes ===")
    let primes = sieve(100)
    print("Primes up to 100: ")
    print_int(len(primes))
    println(" found")

    let i = 0
    while i < len(primes) {
        print_int(primes[i])
        print(" ")
        i = i + 1
    }
    println("")
}

main()
