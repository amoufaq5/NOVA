-- Nova: Testing cognitive features end-to-end

mind Brain {
    memory working(capacity: 5)
    memory episodic(max_episodes: 1000)
    memory semantic(structure: "graph")
    memory procedural(structure: "rules")

    perceive(input) {
        store(input, in: "working")
        return input
    }

    think(goal) {
        let knowledge = recall(goal, from: "semantic", limit: 5)
        return knowledge
    }

    imagine(scenario) {
        let result = simulate(scenario, steps: 3)
        return result
    }

    learn(event) {
        store(event, in: "episodic")
    }

    act(action) {
        let result = predict(action)
        return result
    }
}

-- Test basic mind access
print(Brain.name)
print(Brain.state)

-- Test perceive
let perceived = Brain.perceive("hello world")
print(perceived)

-- Test think
let thought = Brain.think("what is life")
print(thought)

-- Test imagine
let imagined = Brain.imagine("future scenario")
print(imagined)

-- Test believe
Brain.believe("the sky is blue", 0.95)

-- Test know
Brain.know("Earth", "orbits", "Sun")

-- Test add_goal
Brain.add_goal("learn Nova", 0.8)

-- Test recall
let memories = Brain.recall("Earth")
print(memories)

-- Test status
let status = Brain.status()
print(status)

-- Test standard features
let items = [1, 2, 3, 4, 5]
let doubled = items.map(fn(x) { return x * 2 })
print(doubled)

let evens = items.filter(fn(x) { return x % 2 == 0 })
print(evens)

-- Control flow
for i in range(3) {
    print("step " + str(i))
}

-- Pattern matching
let value = Ok(42)
match value {
    Ok(n) => print("got: " + str(n))
    Err(e) => print("error: " + str(e))
}

print("All cognitive tests passed!")
