-- Nova: Model and Agent test suite

-- Model declarations (top-level, since parser requires it)

model SimpleNet(in_dim: int, out_dim: int) {
    w = tensor[f32, 4, 2].ones()

    forward(x) {
        return x @ w
    }
}

model Linear(in_dim: int, out_dim: int) {
    w = tensor[f32, 3, 2].ones()

    forward(x) {
        return x @ w
    }
}

model TinyNet() {
    w1 = tensor[f32, 2, 3].ones()
    w2 = tensor[f32, 3, 1].ones()

    forward(x) {
        return x @ w1 @ w2
    }
}

model NetWithLayers() {
    weights = tensor[f32, 4, 4].ones()

    forward(x) {
        return x @ weights
    }
}

-- Agent declarations (top-level)

agent SimpleAgent(name: str = "bot") {
    tools {
        search = "web_search"
    }

    memory {
        log: [str] = []
    }

    plan(goal: str) {
        return ["step1", "step2"]
    }

    act(step: str) {
        return Ok("done: " + step)
    }
}

agent Planner() {
    tools {
        noop = "noop"
    }

    memory {
        count: int = 0
    }

    plan(goal: str) {
        return ["analyze", "execute", "report"]
    }

    act(step: str) {
        return Ok(step)
    }
}

agent Worker() {
    tools {
        tool1 = "hammer"
    }

    memory {
        done: [str] = []
    }

    plan(goal: str) {
        return [goal]
    }

    act(step: str) {
        return Ok("completed: " + step)
    }
}

-- Model tests

fn test_model_creation() {
    let net = SimpleNet(in_dim=4, out_dim=2)
    assert_true(type_of(net) == "model")
}

fn test_model_forward() {
    let layer = Linear(in_dim=3, out_dim=2)
    let input = tensor[f32, 1, 3].ones()
    let output = layer(input)
    assert_true(type_of(output) == "tensor")
}

fn test_model_parameters() {
    let net = TinyNet()
    let params = net.parameters()
    assert_eq(len(params), 2)
}

fn test_model_layer_access() {
    let net = NetWithLayers()
    let w = net.weights
    assert_true(type_of(w) == "tensor")
    assert_eq(w.shape[0], 4)
    assert_eq(w.shape[1], 4)
}

-- Tensor operation tests

fn test_tensor_zeros() {
    let t = tensor[f32, 3, 3].zeros()
    assert_eq(t.shape[0], 3)
    assert_eq(t.shape[1], 3)
    assert_eq(t.dtype, "f32")
    assert_eq(t.ndim, 2)
    assert_eq(t.size, 9)
}

fn test_tensor_ones() {
    let t = tensor[f32, 2, 4].ones()
    assert_eq(t.shape[0], 2)
    assert_eq(t.shape[1], 4)
    assert_eq(t.sum(), 8.0)
}

fn test_tensor_scalar_arithmetic() {
    let t = tensor[f32, 2, 2].ones()
    let doubled = t * 2.0
    assert_eq(doubled.sum(), 8.0)
    let added = t + t
    assert_eq(added.sum(), 8.0)
}

fn test_tensor_matmul() {
    let a = tensor[f32, 2, 3].ones()
    let b = tensor[f32, 3, 2].ones()
    let c = a @ b
    assert_eq(c.shape[0], 2)
    assert_eq(c.shape[1], 2)
}

fn test_tensor_properties() {
    let t = tensor[f32, 5].ones()
    assert_eq(t.ndim, 1)
    assert_eq(t.size, 5)
    assert_eq(t.device, "cpu")
    assert_eq(t.dtype, "f32")
}

-- Agent tests

fn test_agent_creation() {
    let bot = SimpleAgent(name="test_bot")
    assert_true(type_of(bot) == "agent")
}

fn test_agent_plan() {
    let p = Planner()
    let steps = p.plan("test goal")
    assert_eq(len(steps), 3)
    assert_eq(steps[0], "analyze")
    assert_eq(steps[1], "execute")
    assert_eq(steps[2], "report")
}

fn test_agent_act() {
    let w = Worker()
    let result = w.act("build")
    assert_true(result.is_ok)
    assert_eq(result.unwrap(), "completed: build")
}

-- Result type tests

fn test_result_ok() {
    let r = Ok(42)
    assert_true(r.is_ok)
    assert_eq(r.unwrap(), 42)
    assert_eq(r.value, 42)
}

fn test_result_err() {
    let r = Err("something went wrong")
    assert_true(r.is_err)
    assert_eq(r.error, "something went wrong")
}

fn test_result_match() {
    fn try_parse(s) {
        if s == "42" {
            return Ok(42)
        }
        return Err("parse error")
    }

    let r1 = try_parse("42")
    match r1 {
        Ok(val) => assert_eq(val, 42),
        Err(e) => assert_true(false),
    }

    let r2 = try_parse("abc")
    match r2 {
        Ok(val) => assert_true(false),
        Err(e) => assert_eq(e, "parse error"),
    }
}

-- Autograd test

fn test_grad_basic() {
    fn f(x) {
        return (x * x).sum()
    }
    let df = grad(f)
    let input = tensor[f32, 3].ones()
    let gradient = df(input)
    assert_true(type_of(gradient) == "tensor")
    assert_eq(gradient.size, 3)
}
