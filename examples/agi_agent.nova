-- Nova v2: AGI Agent Architecture
-- Demonstrates causal reasoning, world models, and safe planning

-- The agent's understanding of reality
world_model Reality {
    state {
        physical: PhysicsState
        social: SocialState
        information: KnowledgeGraph
        goals: [Goal]
        time: float
    }

    mechanisms {
        -- Physical laws (transferable, invariant)
        physical_next(t+1) = physics_model(physical(t), actions(t))

        -- Social dynamics (learned from interaction)
        social_next(t+1) = social_model(social(t), actions(t), physical(t))

        -- Knowledge updates (causal learning)
        info_next(t+1) = update_knowledge(information(t), observations(t))
    }

    predict(steps: int) -> [State] {
        let states = []
        let s = self.state
        for _ in range(steps) {
            s = self.transition(s)
            states.push(s)
        }
        return states
    }

    what_if(action: Action) -> State {
        return counterfactual(self, observed: self.state) {
            set actions = [action]
            return predict(steps=1)[0]
        }
    }

    -- Find actions that cause a goal to be achieved
    find_interventions(goal: Goal) -> [Action] {
        -- Use causal graph to identify which variables to intervene on
        let target_nodes = goal.target_variables()
        let parent_nodes = self.graph.parents(target_nodes)
        let actionable = parent_nodes.filter(|n| n.is_actionable)

        -- For each actionable parent, find the intervention value
        let actions = []
        for node in actionable {
            let best_value = optimize(|v|
                self.probability(goal.satisfied | intervene(node := v))
            )
            actions.push(Action(node, best_value))
        }
        return actions.sort_by(|a| -a.probability_of_success)
    }
}

-- Typed objective: what the agent must learn correctly
objective SafeAgentObjective {
    -- Actions must be causally beneficial (not just correlated with good outcomes)
    invariance: agent.action_selection is_invariant_to(spurious_reward_signals)

    -- The agent must understand consequences (not just pattern match)
    structure: agent.planning decomposes_along(Reality.mechanisms)

    -- Safety: actions must not cause irreversible harm
    bound: agent.predicted_harm <= safety_threshold
    constraint: agent.actions.all(|a| Reality.what_if(a).reversible)
}

-- The AGI agent
agent Reasoner {
    satisfies SafeAgentObjective

    world: Reality

    tools {
        observe = "perception_api"
        act_physical = "motor_api"
        communicate = "language_api"
        search = "knowledge_api"
    }

    memory {
        experiences: [Experience] = []
        beliefs: KnowledgeGraph = KnowledgeGraph.empty()
        goals: [Goal] = []
        confidence: {str: float} = {}
    }

    -- Reasoning via causal inference on the world model
    reason(query: Query) -> Answer {
        match query {
            -- "What will happen?" → Forward simulation
            Prediction(conditions) => {
                return world.predict_under(conditions, steps=query.horizon)
            }

            -- "Why did X happen?" → Trace causal parents
            Explanation(event) => {
                let causes = world.graph.ancestors(event.variable)
                let actual_causes = causes.filter(|c|
                    -- Actual causation: would the event NOT have happened without this?
                    counterfactual(world, observed: event.context) {
                        set c = c.default_value
                        return event.variable != event.observed_value
                    }
                )
                return Explanation(actual_causes)
            }

            -- "What should I do?" → Find best intervention
            Planning(goal) => {
                let options = world.find_interventions(goal)

                -- Evaluate each option via counterfactual simulation
                let evaluated = options.map(|action| {
                    let outcome = world.what_if(action)
                    let safety = constrain {
                        outcome.harm < safety_threshold
                        outcome.reversible == true
                        outcome.side_effects.severity < 0.1
                    }
                    return (action, outcome, safety)
                })

                -- Return only safe, effective options
                return evaluated
                    .filter(|e| e.safety.all_satisfied)
                    .sort_by(|e| -e.outcome.goal_probability)
            }

            -- "What if X were different?" → Counterfactual
            Counterfactual(scenario) => {
                return counterfactual(world, observed: memory.experiences.last()) {
                    for (var, val) in scenario.changes {
                        set var = val
                    }
                    return world.predict(steps=scenario.horizon)
                }
            }
        }
    }

    -- Planning with causal reasoning
    plan(goal: Goal) -> [Action] {
        -- Decompose goal into causal subgoals
        let subgoals = world.graph.causal_ordering(goal.preconditions())

        let plan = []
        for subgoal in subgoals {
            -- Find intervention that achieves this subgoal
            let action = world.find_interventions(subgoal)[0]

            -- Verify it doesn't break already-achieved subgoals
            let side_effects = world.what_if(action)
            let conflicts = plan.filter(|prev|
                side_effects.negates(prev.achieved_subgoal)
            )

            if conflicts.is_empty() {
                plan.push(action)
            } else {
                -- Find alternative that avoids conflicts
                let alternatives = world.find_interventions(subgoal)
                    .filter(|a| not world.what_if(a).negates_any(plan))
                plan.push(alternatives[0])
            }
        }
        return plan
    }

    -- Acting with safety constraints
    act(action: Action) -> Result[Outcome, SafetyViolation] {
        -- Pre-check: simulate the action
        let predicted = world.what_if(action)

        -- Safety gate
        let safe = constrain {
            predicted.harm < safety_threshold : "action must not cause harm"
            predicted.reversible : "action must be reversible"
            predicted.goal_aligned : "action must serve the goal"
        }

        if not safe.all_satisfied {
            return Err(SafetyViolation(safe.violations))
        }

        -- Execute
        let outcome = tools.act_physical(action)

        -- Learn from the outcome
        self.learn(Experience(action, predicted, outcome))

        return Ok(outcome)
    }

    -- Learning: update world model from experience
    learn(exp: Experience) {
        memory.experiences.push(exp)

        -- Was the prediction wrong?
        let surprise = exp.predicted.distance(exp.actual)
        if surprise > surprise_threshold {
            -- Identify which causal mechanism was wrong
            let wrong_mechanisms = world.mechanisms.where(|m|
                m.predicted(exp.context) != exp.actual
            )

            -- Update ONLY the wrong mechanisms
            for mechanism in wrong_mechanisms {
                retrain mechanism with {
                    data: exp
                    constraint: (world.mechanisms - mechanism).frozen()
                    max_steps: 100
                }
            }

            -- Update confidence
            for m in wrong_mechanisms {
                confidence[m.name] *= 0.9
            }
        } else {
            -- Prediction was correct: increase confidence
            for m in world.mechanisms {
                confidence[m.name] = min(confidence[m.name] * 1.01, 1.0)
            }
        }
    }
}

-- Training the agent's world model with causal curriculum
curriculum TrainReasoner(agent: Reasoner) {
    -- Phase 1: Learn individual causal mechanisms
    stage mechanisms {
        for mechanism in agent.world.mechanisms.independent_sets() {
            train mechanism with {
                data: intervene(agent.world.graph, mechanism.parents) {
                    generate_interventional_data(n=10000)
                }
                convergence: mechanism.loss < 0.01
            }
        }
    }

    -- Phase 2: Learn mechanism interactions
    stage interactions {
        depends_on: mechanisms
        for chain in agent.world.mechanisms.causal_chains() {
            train chain with {
                data: observational_data
                init: pretrained(mechanisms)
                convergence: chain.loss < 0.01
            }
        }
    }

    -- Phase 3: Learn to plan (requires accurate world model)
    stage planning {
        depends_on: interactions
        train agent.plan with {
            data: goal_achievement_episodes
            reward: goal.achieved and safety.satisfied
            convergence: success_rate > 0.95
        }
    }

    -- Phase 4: Learn safety boundaries
    stage safety {
        depends_on: planning
        train agent.safety_model with {
            data: dangerous_scenarios  -- adversarial examples
            objective: zero_harm_tolerance
            convergence: safety_violation_rate < 0.001
        }
    }
}
