-- Nova: Model and Agent definitions

-- Define a simple model
model MLP(input_dim: int, hidden_dim: int, output_dim: int) {
    w1 = tensor[f32, 4, 8].randn()
    w2 = tensor[f32, 8, 2].randn()

    forward(x) {
        let h = x @ w1
        let out = h @ w2
        return out
    }
}

-- Instantiate
let net = MLP(input_dim=4, hidden_dim=8, output_dim=2)
print("Model: " + net)
print("Parameters: " + net.parameters())

-- Forward pass
let input = tensor[f32, 1, 4].ones()
let output = net(input)
print("Output: " + output)

-- Agent definition
agent Researcher(max_steps: int = 5) {
    tools {
        search = "web_search"
        calc   = "calculator"
    }

    memory {
        findings: [str] = []
        step_count: int = 0
    }

    plan(goal: str) {
        print("Planning for goal: " + goal)
        return ["search for info", "analyze results", "summarize"]
    }

    act(step: str) {
        print("Executing step: " + step)
        return Ok("completed: " + step)
    }
}

let researcher = Researcher(max_steps=3)
print("Agent: " + researcher)

-- Run the agent's plan
let steps = researcher.plan("Learn about Nova language")
for step in steps {
    let result = researcher.act(step)
    match result {
        Ok(msg) => print("  -> " + msg),
        Err(e)  => print("  -> FAILED: " + e),
    }
}
