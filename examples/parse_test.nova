// Simple test for parser

moment Hello {
    what_happened: "greeting"
    who: entity Person { name: "Bob" }
    felt: warmth 0.8
}

fn greet(name) {
    let msg = "hello"
    if name == "Alice" {
        return "special hello"
    }
}

path SimpleFlow {
    signal arrives at perceiver
        ~> rememberer enriches with context
        ~> actor decides response
}
