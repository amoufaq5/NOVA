-- Nova: Hello World and basic features

-- Variables and printing
let name = "Nova"
let version = 1
print("Hello from " + name + "!")

-- Functions
fn square(x) {
    return x * x
}

fn factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

print("5 squared = " + square(5))
print("10! = " + factorial(10))

-- Lists and iteration
let numbers = [1, 2, 3, 4, 5]
let total = 0
for n in numbers {
    total += n
}
print("Sum of 1..5 = " + total)

-- Pattern matching with Result types
fn safe_divide(a, b) {
    if b == 0 {
        return Err("division by zero")
    }
    return Ok(a / b)
}

let result = safe_divide(10, 3)
match result {
    Ok(val) => print("10 / 3 = " + val),
    Err(msg) => print("Error: " + msg),
}

let result2 = safe_divide(10, 0)
match result2 {
    Ok(val) => print("10 / 0 = " + val),
    Err(msg) => print("Error: " + msg),
}

-- Pipeline operator
fn double(x) { return x * 2 }
fn add_one(x) { return x + 1 }
let piped = 5 |> double |> add_one
print("5 |> double |> add_one = " + piped)

-- Lambda
let nums = [3, 1, 4, 1, 5]
let mapped = []
for n in nums {
    mapped = mapped + [n * n]
}
print("Squared: " + mapped)
