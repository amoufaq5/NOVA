// Conway's Game of Life (simple terminal version)

let WIDTH = 20
let HEIGHT = 10

fn cell_idx(x, y) {
    return y * WIDTH + x
}

fn get_cell(grid, x, y) {
    if x < 0 { return 0 }
    if y < 0 { return 0 }
    if x >= WIDTH { return 0 }
    if y >= HEIGHT { return 0 }
    return grid[cell_idx(x, y)]
}

fn count_neighbors(grid, x, y) {
    let count = 0
    count = count + get_cell(grid, x-1, y-1)
    count = count + get_cell(grid, x, y-1)
    count = count + get_cell(grid, x+1, y-1)
    count = count + get_cell(grid, x-1, y)
    count = count + get_cell(grid, x+1, y)
    count = count + get_cell(grid, x-1, y+1)
    count = count + get_cell(grid, x, y+1)
    count = count + get_cell(grid, x+1, y+1)
    return count
}

fn next_gen(grid) {
    let new_grid = list_new()
    let y = 0
    while y < HEIGHT {
        let x = 0
        while x < WIDTH {
            let alive = get_cell(grid, x, y)
            let neighbors = count_neighbors(grid, x, y)
            if alive == 1 {
                if neighbors < 2 {
                    push(new_grid, 0)
                } else {
                    if neighbors > 3 {
                        push(new_grid, 0)
                    } else {
                        push(new_grid, 1)
                    }
                }
            } else {
                if neighbors == 3 {
                    push(new_grid, 1)
                } else {
                    push(new_grid, 0)
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    return new_grid
}

fn print_grid(grid) {
    let y = 0
    while y < HEIGHT {
        let x = 0
        while x < WIDTH {
            if get_cell(grid, x, y) == 1 {
                print("#")
            } else {
                print(".")
            }
            x = x + 1
        }
        println("")
        y = y + 1
    }
}

fn main() {
    println("=== Game of Life ===")

    // Initialize grid
    let grid = list_new()
    let i = 0
    while i < WIDTH * HEIGHT {
        push(grid, 0)
        i = i + 1
    }

    // Glider
    list_set(grid, cell_idx(1, 0), 1)
    list_set(grid, cell_idx(2, 1), 1)
    list_set(grid, cell_idx(0, 2), 1)
    list_set(grid, cell_idx(1, 2), 1)
    list_set(grid, cell_idx(2, 2), 1)

    // Blinker
    list_set(grid, cell_idx(10, 4), 1)
    list_set(grid, cell_idx(11, 4), 1)
    list_set(grid, cell_idx(12, 4), 1)

    // Run 10 generations
    let gen = 0
    while gen < 10 {
        print("Generation ")
        print_int(gen)
        println(":")
        print_grid(grid)
        println("")
        grid = next_gen(grid)
        gen = gen + 1
    }
}

main()
