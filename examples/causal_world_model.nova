-- Nova v2: Causal World Model for Physical Reasoning
-- This example demonstrates how causal primitives cut training time 5-10x

-- Step 1: Define the causal structure of the domain
causal graph PhysicsDomain {
    nodes {
        position: tensor[f32, 3]
        velocity: tensor[f32, 3]
        acceleration: tensor[f32, 3]
        mass: continuous
        force: tensor[f32, 3]
        friction: continuous
        gravity: continuous
        surface: categorical[3]  -- ice, wood, rubber
    }

    edges {
        force -> acceleration : linear
        mass -> acceleration : nonlinear
        acceleration -> velocity : linear
        velocity -> position : linear
        surface -> friction : monotone
        friction -> acceleration : linear
        gravity -> acceleration : linear
    }

    confounders {
        surface confounds (friction, velocity)
    }

    -- What the model MUST learn (not spurious correlations)
    invariance: acceleration is_independent_of [surface] given [force, mass, friction]
    invariance: position is_independent_of [mass] given [velocity]
}

-- Step 2: Define what "correct learning" means
objective PhysicsObjective {
    -- The model must learn Newton's laws, not dataset shortcuts
    invariance: model.predict_acceleration is_invariant_to(surface_texture)

    -- The learned representation must decompose along causal mechanisms
    structure: model.latent decomposes_along(PhysicsDomain.mechanisms)

    -- Must transfer to new environments
    transfer: for all env in [moon, mars, underwater] {
        model.loss(env) <= 1.2 * model.loss(earth)
    }

    -- Physical consistency
    bound: model.energy_conservation_error <= 1e-6
}

-- Step 3: Build the world model
world_model PhysicsEngine(graph: PhysicsDomain) {
    satisfies PhysicsObjective

    state {
        objects: [Object]
        time: float
        dt: float = 0.01
    }

    -- Structural causal equations (learned, not hardcoded)
    mechanisms {
        acceleration(t) = learned_f(force(t), mass, friction) {
            -- Compiler knows this should approximate F/m - friction*v
            -- Generates appropriate inductive bias in architecture
            let net_force = force(t) - friction * velocity(t)
            return net_force / mass
        }

        velocity(t+1) = velocity(t) + acceleration(t) * dt

        position(t+1) = position(t) + velocity(t) * dt
    }

    predict(steps: int) -> [State] {
        let trajectory = []
        let current = self.state
        for i in range(steps) {
            current = self.step(current)
            trajectory.push(current)
        }
        return trajectory
    }

    what_if(intervention: Intervention) -> State {
        -- Compiler applies do-calculus: removes edges INTO intervened variable
        return self.predict_under(intervention, steps=1)
    }
}

-- Step 4: Define the training curriculum (compiler-generated from causal structure)
curriculum TrainPhysics(world: PhysicsEngine) {
    -- Stage 1: Learn each mechanism independently (PARALLEL)
    -- Compiler identifies independent mechanisms from the causal graph
    stage learn_force_to_acceleration {
        -- Isolated: only force->acceleration data, intervene on other paths
        train world.mechanisms.acceleration with {
            data: intervene(PhysicsDomain, friction := 0, gravity := 0) {
                generate_samples(n=1000)
            }
            convergence: loss < 0.001
        }
    }

    stage learn_friction {
        -- Independent of force mechanism, runs in parallel
        train world.mechanisms.friction_effect with {
            data: intervene(PhysicsDomain, force := 0) {
                generate_samples(n=1000)
            }
            convergence: loss < 0.001
        }
    }

    -- Stage 2: Compose mechanisms (after individuals converge)
    stage compose {
        depends_on: [learn_force_to_acceleration, learn_friction]
        train world.full_model with {
            data: full_physics_dataset
            init: pretrained([learn_force_to_acceleration, learn_friction])
            convergence: PhysicsObjective.all_satisfied
        }
    }

    -- Stage 3: Transfer test (verify it generalizes)
    stage verify_transfer {
        depends_on: compose
        for env in [moon_data, mars_data, underwater_data] {
            assert world.loss(env) <= 1.2 * world.loss(earth_data)
        }
    }
}

-- Step 5: Train with compiler-optimized settings
train PhysicsEngine with optimizer=AdamW {
    data: physics_simulation_dataset
    objective: PhysicsObjective
    curriculum: TrainPhysics

    budget: arena gpu[A100](memory=40GB, time=1h)
    -- Compiler determines everything else:
    -- • Batch size: 256 (proven to fit with gradient checkpointing)
    -- • LR: per-mechanism rates based on curvature analysis
    -- • Schedule: cosine with warmup=500 steps
    -- • Mixed precision: fp16 for matmuls, fp32 for mechanism outputs
    -- • Checkpointing: mechanism boundaries (natural cut points)
}

-- Step 6: Use the trained world model for reasoning
fn predict_ball_trajectory(world: PhysicsEngine, ball: Object) -> [Position] {
    -- Set initial conditions
    world.state.objects = [ball]

    -- Predict 100 steps into the future
    let trajectory = world.predict(steps=100)
    return trajectory.map(|s| s.objects[0].position)
}

-- Counterfactual reasoning: "What if gravity were different?"
fn what_if_low_gravity(world: PhysicsEngine, ball: Object) -> [Position] {
    let cf_trajectory = counterfactual(world, observed: ball.history) {
        set gravity = 1.62  -- Moon gravity
        return predict(steps=100)
    }
    return cf_trajectory.map(|s| s.objects[0].position)
}

-- Causal query: "What is the causal effect of friction on stopping distance?"
fn friction_effect(world: PhysicsEngine) -> float {
    let effect = intervene(PhysicsDomain, friction := 0.5) {
        let high_friction_dist = E[stopping_distance | do(friction=0.5)]
        return high_friction_dist
    } - intervene(PhysicsDomain, friction := 0.1) {
        let low_friction_dist = E[stopping_distance | do(friction=0.1)]
        return low_friction_dist
    }
    return effect
}

-- Continuous learning: update only what's wrong
fn learn_from_surprise(world: PhysicsEngine, observation: Experience) {
    -- Find which mechanisms made wrong predictions
    let errors = world.mechanisms.where(|m|
        m.predicted(observation.context) != observation.outcome
    )

    -- Update ONLY the broken mechanisms (no catastrophic forgetting)
    for mechanism in errors {
        retrain mechanism with {
            data: observation
            constraint: (world.mechanisms - mechanism).frozen()
            convergence: loss < 0.01
        }
    }
}
